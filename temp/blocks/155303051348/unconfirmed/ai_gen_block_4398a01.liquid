{% doc %}
  @prompt
    Create a new section named “Performance Snapshot” and place it directly after “Services Plan” and before “Service Testimonial”.
    
    Match the current page UI exactly:
    - premium black background
    - subtle borders
    - same card style as pricing and use case cards
    - white headings
    - muted gray text
    - no bright redesign
    - mobile friendly
    
    Layout:
    - small label
    - strong headline
    - short supporting sentence
    - desktop: large image upload field on the left and 3 KPI cards on the right
    - mobile: image first, KPI cards stacked below
    - one CTA button at the bottom
    
    Use this copy:
    
    Label: PERFORMANCE SNAPSHOT
    Headline: What the account should prove
    Supporting text: Once the flows are live, this section is meant to show whether retention and revenue contribution are actually improving.
    
    Image field label: Upload Klaviyo dashboard or analytics image
    
    KPI 1 value: $0k
    KPI 1 title: Flow revenue
    KPI 1 body: Revenue contribution from automated email sequences.
    
    KPI 2 value: 00%
    KPI 2 title: Open rate lift
    KPI 2 body: Improvement in engagement across the highest-impact flows.
    
    KPI 3 value: 00%
    KPI 3 title: Recovery or retention lift
    KPI 3 body: Improvement in cart recovery, repeat purchase support, or post-purchase performance.
    
    CTA text: Book a Consultation
    
    Important:
    - use placeholder values only
    - keep the tone premium, strategic, and ecommerce-focused
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-performance-snapshot-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    padding: 80px 20px;
    width: 100%;
  }

  .ai-performance-snapshot__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-performance-snapshot__header-{{ ai_gen_id }} {
    margin-bottom: 60px;
  }

  .ai-performance-snapshot__label-{{ ai_gen_id }} {
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ block.settings.label_color }};
    margin-bottom: 16px;
    font-weight: 500;
  }

  .ai-performance-snapshot__headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    color: {{ block.settings.headline_color }};
    margin: 0 0 16px 0;
    font-weight: 600;
    line-height: 1.2;
  }

  .ai-performance-snapshot__supporting-{{ ai_gen_id }} {
    font-size: {{ block.settings.supporting_text_size }}px;
    color: {{ block.settings.supporting_text_color }};
    line-height: 1.6;
    max-width: 600px;
  }

  .ai-performance-snapshot__content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-bottom: 40px;
  }

  .ai-performance-snapshot__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.card_background }};
  }

  .ai-performance-snapshot__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-performance-snapshot__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.card_background }};
    position: relative;
  }

  .ai-performance-snapshot__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
    opacity: 0.3;
  }

  .ai-performance-snapshot__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 13px;
    color: {{ block.settings.supporting_text_color }};
    text-align: center;
    pointer-events: none;
  }

  .ai-performance-snapshot__kpis-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-performance-snapshot__kpi-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: 24px;
    transition: border-color 0.3s ease;
  }

  .ai-performance-snapshot__kpi-card-{{ ai_gen_id }}:hover {
    border-color: {{ block.settings.border_hover_color }};
  }

  .ai-performance-snapshot__kpi-value-{{ ai_gen_id }} {
    font-size: {{ block.settings.kpi_value_size }}px;
    color: {{ block.settings.headline_color }};
    font-weight: 600;
    margin-bottom: 8px;
    line-height: 1;
  }

  .ai-performance-snapshot__kpi-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.kpi_title_size }}px;
    color: {{ block.settings.headline_color }};
    font-weight: 500;
    margin-bottom: 8px;
  }

  .ai-performance-snapshot__kpi-body-{{ ai_gen_id }} {
    font-size: {{ block.settings.kpi_body_size }}px;
    color: {{ block.settings.supporting_text_color }};
    line-height: 1.5;
  }

  .ai-performance-snapshot__cta-wrapper-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-performance-snapshot__cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 32px;
    background-color: {{ block.settings.cta_background }};
    color: {{ block.settings.cta_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.cta_border_radius }}px;
    font-size: {{ block.settings.cta_text_size }}px;
    font-weight: 500;
    transition: background-color 0.3s ease;
    border: 1px solid {{ block.settings.cta_border_color }};
  }

  .ai-performance-snapshot__cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_hover_background }};
    border-color: {{ block.settings.cta_hover_border }};
  }

  @media screen and (max-width: 768px) {
    .ai-performance-snapshot-{{ ai_gen_id }} {
      padding: 60px 20px;
    }

    .ai-performance-snapshot__header-{{ ai_gen_id }} {
      margin-bottom: 40px;
    }

    .ai-performance-snapshot__headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.7 }}px;
    }

    .ai-performance-snapshot__content-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .ai-performance-snapshot__image-placeholder-{{ ai_gen_id }} {
      min-height: 300px;
    }

    .ai-performance-snapshot__kpi-value-{{ ai_gen_id }} {
      font-size: {{ block.settings.kpi_value_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<performance-snapshot-{{ ai_gen_id }}
  class="ai-performance-snapshot-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-performance-snapshot__container-{{ ai_gen_id }}">
    <div class="ai-performance-snapshot__header-{{ ai_gen_id }}">
      {% if block.settings.label != blank %}
        <div class="ai-performance-snapshot__label-{{ ai_gen_id }}">
          {{ block.settings.label }}
        </div>
      {% endif %}
      
      {% if block.settings.headline != blank %}
        <h2 class="ai-performance-snapshot__headline-{{ ai_gen_id }}">
          {{ block.settings.headline }}
        </h2>
      {% endif %}
      
      {% if block.settings.supporting_text != blank %}
        <div class="ai-performance-snapshot__supporting-{{ ai_gen_id }}">
          {{ block.settings.supporting_text }}
        </div>
      {% endif %}
    </div>

    <div class="ai-performance-snapshot__content-{{ ai_gen_id }}">
      <div class="ai-performance-snapshot__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.dashboard_image %}
          <img
            src="{{ block.settings.dashboard_image | image_url: width: 1200 }}"
            alt="{{ block.settings.dashboard_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.dashboard_image.width }}"
            height="{{ block.settings.dashboard_image.height }}"
            class="ai-performance-snapshot__image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-performance-snapshot__image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-performance-snapshot__empty-state-{{ ai_gen_id }}">
              Upload Klaviyo dashboard or analytics image
            </div>
          </div>
        {% endif %}
      </div>

      <div class="ai-performance-snapshot__kpis-{{ ai_gen_id }}">
        <div class="ai-performance-snapshot__kpi-card-{{ ai_gen_id }}">
          <div class="ai-performance-snapshot__kpi-value-{{ ai_gen_id }}">
            {{ block.settings.kpi_1_value }}
          </div>
          <div class="ai-performance-snapshot__kpi-title-{{ ai_gen_id }}">
            {{ block.settings.kpi_1_title }}
          </div>
          <div class="ai-performance-snapshot__kpi-body-{{ ai_gen_id }}">
            {{ block.settings.kpi_1_body }}
          </div>
        </div>

        <div class="ai-performance-snapshot__kpi-card-{{ ai_gen_id }}">
          <div class="ai-performance-snapshot__kpi-value-{{ ai_gen_id }}">
            {{ block.settings.kpi_2_value }}
          </div>
          <div class="ai-performance-snapshot__kpi-title-{{ ai_gen_id }}">
            {{ block.settings.kpi_2_title }}
          </div>
          <div class="ai-performance-snapshot__kpi-body-{{ ai_gen_id }}">
            {{ block.settings.kpi_2_body }}
          </div>
        </div>

        <div class="ai-performance-snapshot__kpi-card-{{ ai_gen_id }}">
          <div class="ai-performance-snapshot__kpi-value-{{ ai_gen_id }}">
            {{ block.settings.kpi_3_value }}
          </div>
          <div class="ai-performance-snapshot__kpi-title-{{ ai_gen_id }}">
            {{ block.settings.kpi_3_title }}
          </div>
          <div class="ai-performance-snapshot__kpi-body-{{ ai_gen_id }}">
            {{ block.settings.kpi_3_body }}
          </div>
        </div>
      </div>
    </div>

    {% if block.settings.cta_text != blank %}
      <div class="ai-performance-snapshot__cta-wrapper-{{ ai_gen_id }}">
        <a
          href="{{ block.settings.cta_link }}"
          class="ai-performance-snapshot__cta-{{ ai_gen_id }}"
        >
          {{ block.settings.cta_text }}
        </a>
      </div>
    {% endif %}
  </div>
</performance-snapshot-{{ ai_gen_id }}>

<script>
  (function() {
    class PerformanceSnapshot{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.init();
      }

      init() {
        const kpiCards = this.querySelectorAll('.ai-performance-snapshot__kpi-card-{{ ai_gen_id }}');
        kpiCards.forEach((card, index) => {
          card.style.animationDelay = `${index * 0.1}s`;
        });
      }
    }

    customElements.define('performance-snapshot-{{ ai_gen_id }}', PerformanceSnapshot{{ ai_gen_id }});
  })();
</script>

