      "label": "Intro text",
      "default": "Add a client story, Loom walkthrough, or account review video here once the file is ready."
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "video",
      "id": "client_video",
      "label": "Upload client video or retention walkthrough"
    },
    {
      "type": "header",
      "content": "Quote"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote text",
      "default": "Once the flows were set up properly, email stopped being background noise and started contributing real value."
    },
    {
      "type": "text",
      "id": "speaker",
      "label": "Speaker",
      "default": "Client name / role"
    },
    {
      "type": "header",
      "content": "Outcomes"
    },
    {
      "type": "text",
      "id": "outcome_1",
      "label": "Outcome 1",
      "default": "More revenue from automated email flows"
    },
    {
      "type": "text",
      "id": "outcome_2",
      "label": "Outcome 2",
      "default": "Better retention after the first purchase"
    },
    {
      "type": "text",
      "id": "outcome_3",
      "label": "Outcome 3",
      "default": "Stronger customer journey from first touch to repeat order"
    }
  ],
  "presets": [
    {
      "name": "Client video"
    }
  ]
}
{% endschema %}
