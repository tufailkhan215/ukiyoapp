{% doc %}
  @prompt
    Create a new compact section for this page and place it directly after the section titled “Inside our Company Agent Builder” and before the pricing section.
    
    Match the current UI exactly: premium dark background, subtle borders, rounded cards, white text, muted gray supporting text, no bright colors, no redesign, mobile friendly, concise copy.
    
    The new section should be called “Proof in Practice”.
    
    Structure:
    - small label
    - one headline
    - one short supporting sentence
    - first row: 3 analytics cards
    - second row: 4 sample implementation cards
    - one CTA button at the bottom
    
    Important:
    - Do not use fake case-study numbers
    - Frame the analytics row as “what we track and optimize”
    - Do not require images or videos
    - Use text-only cards with simple icons if needed
    
    Analytics row title: “What we track first”
    Use these 3 cards:
    1. Response speed — how quickly inbound leads or support questions get handled
    2. Qualification quality — how well the agent filters and routes the right conversations
    3. Coverage without extra headcount — how much routine inquiry volume can be handled automatically
    
    Sample row title: “What your agent can handle”
    Use these 4 cards:
    1. Lead qualification assistant — asks the right questions and routes qualified leads
    2. FAQ and support agent — answers repeat questions instantly and consistently
    3. CRM handoff workflow — passes conversations into the right pipeline or owner
    4. Follow-up and booking flow — keeps leads warm and nudges them toward the next step
    
    CTA button text: “Book a Consultation”
    
    Tone:
    confident, premium, practical, not hype-heavy
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-proof-practice-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_desktop }}px 20px;
  }

  .ai-proof-practice-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-proof-practice-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 48px;
  }

  .ai-proof-practice-label-{{ ai_gen_id }} {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: {{ block.settings.label_color }};
    margin-bottom: 16px;
    font-weight: 500;
  }

  .ai-proof-practice-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px 0;
    line-height: 1.2;
  }

  .ai-proof-practice-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.muted_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-proof-practice-section-{{ ai_gen_id }} {
    margin-bottom: 48px;
  }

  .ai-proof-practice-section-title-{{ ai_gen_id }} {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: {{ block.settings.label_color }};
    margin-bottom: 24px;
    font-weight: 500;
  }

  .ai-proof-practice-analytics-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 48px;
  }

  .ai-proof-practice-samples-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 48px;
  }

  .ai-proof-practice-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 24px;
    transition: border-color 0.3s ease;
  }

  .ai-proof-practice-card-{{ ai_gen_id }}:hover {
    border-color: {{ block.settings.border_hover_color }};
  }

  .ai-proof-practice-card-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .ai-proof-practice-card-description-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.muted_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-proof-practice-cta-wrapper-{{ ai_gen_id }} {
    text-align: center;
    margin-top: 48px;
  }

  .ai-proof-practice-cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 32px;
    background-color: {{ block.settings.cta_background }};
    color: {{ block.settings.cta_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.cta_border_radius }}px;
    font-size: 16px;
    font-weight: 500;
    border: 1px solid {{ block.settings.cta_border_color }};
    transition: all 0.3s ease;
  }

  .ai-proof-practice-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_hover_background }};
    border-color: {{ block.settings.cta_hover_border }};
  }

  @media screen and (max-width: 990px) {
    .ai-proof-practice-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_mobile }}px 16px;
    }

    .ai-proof-practice-analytics-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .ai-proof-practice-samples-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .ai-proof-practice-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.75 }}px;
    }

    .ai-proof-practice-header-{{ ai_gen_id }} {
      margin-bottom: 32px;
    }

    .ai-proof-practice-section-{{ ai_gen_id }} {
      margin-bottom: 32px;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 990px) {
    .ai-proof-practice-analytics-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }

    .ai-proof-practice-samples-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstyle %}

<proof-practice-{{ ai_gen_id }} class="ai-proof-practice-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-proof-practice-container-{{ ai_gen_id }}">
    <div class="ai-proof-practice-header-{{ ai_gen_id }}">
      {% if block.settings.label != blank %}
        <div class="ai-proof-practice-label-{{ ai_gen_id }}">{{ block.settings.label }}</div>
      {% endif %}
      {% if block.settings.headline != blank %}
        <h2 class="ai-proof-practice-headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
      {% endif %}
      {% if block.settings.subtext != blank %}
        <p class="ai-proof-practice-subtext-{{ ai_gen_id }}">{{ block.settings.subtext }}</p>
      {% endif %}
    </div>

    <div class="ai-proof-practice-section-{{ ai_gen_id }}">
      {% if block.settings.analytics_title != blank %}
        <div class="ai-proof-practice-section-title-{{ ai_gen_id }}">{{ block.settings.analytics_title }}</div>
      {% endif %}
      <div class="ai-proof-practice-analytics-grid-{{ ai_gen_id }}">
        <div class="ai-proof-practice-card-{{ ai_gen_id }}">
          <h3 class="ai-proof-practice-card-title-{{ ai_gen_id }}">{{ block.settings.analytics_1_title }}</h3>
          <p class="ai-proof-practice-card-description-{{ ai_gen_id }}">{{ block.settings.analytics_1_description }}</p>
        </div>
        <div class="ai-proof-practice-card-{{ ai_gen_id }}">
          <h3 class="ai-proof-practice-card-title-{{ ai_gen_id }}">{{ block.settings.analytics_2_title }}</h3>
          <p class="ai-proof-practice-card-description-{{ ai_gen_id }}">{{ block.settings.analytics_2_description }}</p>
        </div>
        <div class="ai-proof-practice-card-{{ ai_gen_id }}">
          <h3 class="ai-proof-practice-card-title-{{ ai_gen_id }}">{{ block.settings.analytics_3_title }}</h3>
          <p class="ai-proof-practice-card-description-{{ ai_gen_id }}">{{ block.settings.analytics_3_description }}</p>
        </div>
      </div>
    </div>

    <div class="ai-proof-practice-section-{{ ai_gen_id }}">
      {% if block.settings.samples_title != blank %}
        <div class="ai-proof-practice-section-title-{{ ai_gen_id }}">{{ block.settings.samples_title }}</div>
      {% endif %}
      <div class="ai-proof-practice-samples-grid-{{ ai_gen_id }}">
        <div class="ai-proof-practice-card-{{ ai_gen_id }}">
          <h3 class="ai-proof-practice-card-title-{{ ai_gen_id }}">{{ block.settings.sample_1_title }}</h3>
          <p class="ai-proof-practice-card-description-{{ ai_gen_id }}">{{ block.settings.sample_1_description }}</p>
        </div>
        <div class="ai-proof-practice-card-{{ ai_gen_id }}">
          <h3 class="ai-proof-practice-card-title-{{ ai_gen_id }}">{{ block.settings.sample_2_title }}</h3>
          <p class="ai-proof-practice-card-description-{{ ai_gen_id }}">{{ block.settings.sample_2_description }}</p>
        </div>
        <div class="ai-proof-practice-card-{{ ai_gen_id }}">
          <h3 class="ai-proof-practice-card-title-{{ ai_gen_id }}">{{ block.settings.sample_3_title }}</h3>
          <p class="ai-proof-practice-card-description-{{ ai_gen_id }}">{{ block.settings.sample_3_description }}</p>
        </div>
        <div class="ai-proof-practice-card-{{ ai_gen_id }}">
          <h3 class="ai-proof-practice-card-title-{{ ai_gen_id }}">{{ block.settings.sample_4_title }}</h3>
          <p class="ai-proof-practice-card-description-{{ ai_gen_id }}">{{ block.settings.sample_4_description }}</p>
        </div>
      </div>
    </div>

    {% if block.settings.cta_text != blank %}
      <div class="ai-proof-practice-cta-wrapper-{{ ai_gen_id }}">
        <a href="{{ block.settings.cta_link }}" class="ai-proof-practice-cta-{{ ai_gen_id }}">
          {{ block.settings.cta_text }}
        </a>
      </div>
    {% endif %}
  </div>
</proof-practice-{{ ai_gen_id }}>

<script>
  (function() {
    class ProofPractice{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const cards = this.querySelectorAll('.ai-proof-practice-card-{{ ai_gen_id }}');
        cards.forEach(card => {
          card.setAttribute('role', 'article');
        });
      }
    }

    customElements.define('proof-practice-{{ ai_gen_id }}', ProofPractice{{ ai_gen_id }});
  })();
</script>

