{% doc %}
  @prompt
    Create the schema markup text section where i can paste schema tag. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-schema-markup-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-schema-markup__container-{{ ai_gen_id }} {
    padding: 20px;
    background-color: {{ block.settings.background_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-schema-markup__label-{{ ai_gen_id }} {
    display: block;
    margin-bottom: 8px;
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.label_color }};
  }

  .ai-schema-markup__textarea-{{ ai_gen_id }} {
    width: 100%;
    min-height: {{ block.settings.textarea_height }}px;
    padding: 12px;
    font-family: 'Courier New', monospace;
    font-size: 13px;
    line-height: 1.5;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: 4px;
    background-color: {{ block.settings.input_background }};
    color: {{ block.settings.input_text_color }};
    resize: vertical;
  }

  .ai-schema-markup__textarea-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.focus_color }};
    outline-offset: 2px;
  }

  .ai-schema-markup__help-text-{{ ai_gen_id }} {
    margin-top: 8px;
    font-size: 12px;
    color: {{ block.settings.help_text_color }};
  }

  .ai-schema-markup__output-{{ ai_gen_id }} {
    display: none;
  }
{% endstyle %}

<div class="ai-schema-markup-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_editor %}
    <div class="ai-schema-markup__container-{{ ai_gen_id }}">
      {% if block.settings.label != blank %}
        <label class="ai-schema-markup__label-{{ ai_gen_id }}">
          {{ block.settings.label }}
        </label>
      {% endif %}
      
      <textarea 
        class="ai-schema-markup__textarea-{{ ai_gen_id }}"
        placeholder="{{ block.settings.placeholder }}"
        readonly
      >{{ block.settings.schema_code }}</textarea>
      
      {% if block.settings.help_text != blank %}
        <div class="ai-schema-markup__help-text-{{ ai_gen_id }}">
          {{ block.settings.help_text }}
        </div>
      {% endif %}
    </div>
  {% endif %}

  {% if block.settings.schema_code != blank %}
    <div class="ai-schema-markup__output-{{ ai_gen_id }}">
      {{ block.settings.schema_code }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Schema markup",
  "settings": [
    {
      "type": "header",
      "content": "Schema code"
    },
    {
      "type": "html",
      "id": "schema_code",
      "label": "Schema markup code"
    },
    {
      "type": "checkbox",
      "id": "show_editor",
      "label": "Show editor preview",
      "default": false
    },
    {
      "type": "header",
      "content": "Editor display"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Schema Markup Code"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder text",
      "default": "Paste your schema markup here..."
    },
    {
      "type": "text",
      "id": "help_text",
      "label": "Help text",
      "default": "Add JSON-LD structured data for SEO"
    },
    {
      "type": "range",
      "id": "textarea_height",
      "label": "Editor height",
      "min": 100,
      "max": 500,
      "step": 50,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f9f9f9"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label text",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "input_background",
      "label": "Input background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Input border",
      "default": "#cccccc"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "Input text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "focus_color",
      "label": "Focus outline",
      "default": "#000f9f"
    },
    {
      "type": "color",
      "id": "help_text_color",
      "label": "Help text",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Schema markup"
    }
  ]
}
{% endschema %}
