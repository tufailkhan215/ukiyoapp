{% doc %}
  @prompt
    Create a merch page make it align with the theme and our current website design. Also make it highly engaging. And keep option to add merch product. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-merch-page-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-merch-page-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-merch-page-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-merch-page-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    color: {{ block.settings.eyebrow_color }};
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
    font-weight: 500;
  }

  .ai-merch-page-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 20px;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-merch-page-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.muted_color }};
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .ai-merch-page-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.grid_spacing }}px;
  }

  .ai-merch-page-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
  }

  .ai-merch-page-card-{{ ai_gen_id }}:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 40px rgba(255, 255, 255, 0.1);
  }

  .ai-merch-page-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: {{ block.settings.image_background }};
  }

  .ai-merch-page-card-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .ai-merch-page-card-{{ ai_gen_id }}:hover .ai-merch-page-card-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-merch-page-card-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 16px;
    right: 16px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    z-index: 2;
  }

  .ai-merch-page-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-merch-page-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 8px;
    font-weight: 600;
  }

  .ai-merch-page-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_description_size }}px;
    color: {{ block.settings.muted_color }};
    margin: 0 0 16px;
    line-height: 1.5;
  }

  .ai-merch-page-card-footer-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 16px;
  }

  .ai-merch-page-card-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: 700;
  }

  .ai-merch-page-card-button-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    padding: 10px 20px;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
    text-decoration: none;
    display: inline-block;
  }

  .ai-merch-page-card-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    transform: scale(1.05);
  }

  .ai-merch-page-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 80px 20px;
    background-color: {{ block.settings.card_background }};
    border: 2px dashed {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
  }

  .ai-merch-page-empty-icon-{{ ai_gen_id }} {
    width: 80px;
    height: 80px;
    margin: 0 auto 20px;
    opacity: 0.3;
  }

  .ai-merch-page-empty-title-{{ ai_gen_id }} {
    font-size: 24px;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px;
    font-weight: 600;
  }

  .ai-merch-page-empty-text-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.muted_color }};
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-merch-page-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-merch-page-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-merch-page-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-merch-page-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px 16px;
    }

    .ai-merch-page-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.5);
    }
  }
{% endstyle %}

<merch-page-{{ ai_gen_id }} class="ai-merch-page-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-merch-page-container-{{ ai_gen_id }}">
    <div class="ai-merch-page-header-{{ ai_gen_id }}">
      {% if block.settings.eyebrow_text != blank %}
        <div class="ai-merch-page-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow_text }}</div>
      {% endif %}
      
      {% if block.settings.title != blank %}
        <h1 class="ai-merch-page-title-{{ ai_gen_id }}">{{ block.settings.title }}</h1>
      {% endif %}
      
      {% if block.settings.description != blank %}
        <div class="ai-merch-page-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
    </div>

    {% assign has_products = false %}
    {% for i in (1..6) %}
      {% assign product_key = 'product_' | append: i %}
      {% if block.settings[product_key] != blank %}
        {% assign has_products = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_products %}
      <div class="ai-merch-page-grid-{{ ai_gen_id }}">
        {% for i in (1..6) %}
          {% assign product_key = 'product_' | append: i %}
          {% assign badge_key = 'badge_' | append: i %}
          {% assign product = block.settings[product_key] %}
          
          {% if product != blank %}
            <div class="ai-merch-page-card-{{ ai_gen_id }}">
              <div class="ai-merch-page-card-image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 800 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-merch-page-card-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="800"
                    height="800"
                  >
                {% else %}
                  <div class="ai-merch-page-card-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
                
                {% if block.settings[badge_key] != blank %}
                  <div class="ai-merch-page-card-badge-{{ ai_gen_id }}">
                    {{ block.settings[badge_key] }}
                  </div>
                {% endif %}
              </div>
              
              <div class="ai-merch-page-card-content-{{ ai_gen_id }}">
                <h3 class="ai-merch-page-card-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                
                {% if block.settings.show_description and product.description != blank %}
                  <div class="ai-merch-page-card-description-{{ ai_gen_id }}">
                    {{ product.description | strip_html | truncate: 100 }}
                  </div>
                {% endif %}
                
                <div class="ai-merch-page-card-footer-{{ ai_gen_id }}">
                  <div class="ai-merch-page-card-price-{{ ai_gen_id }}">
                    {{ product.price | money }}
                  </div>
                  <a href="{{ product.url }}" class="ai-merch-page-card-button-{{ ai_gen_id }}">
                    {{ block.settings.button_text }}
                  </a>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-merch-page-empty-state-{{ ai_gen_id }}">
        <div class="ai-merch-page-empty-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
        </div>
        <h2 class="ai-merch-page-empty-title-{{ ai_gen_id }}">Add Your Merch Products</h2>
        <p class="ai-merch-page-empty-text-{{ ai_gen_id }}">Select products from your store to showcase your exclusive merchandise collection</p>
      </div>
    {% endif %}
  </div>
</merch-page-{{ ai_gen_id }}>

<script>
  (function() {
    class MerchPage{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initializeCards();
      }

      initializeCards() {
        const cards = this.querySelectorAll('.ai-merch-page-card-{{ ai_gen_id }}');
        
        cards.forEach((card, index) => {
          card.style.opacity = '0';
          card.style.transform = 'translateY(30px)';
          
          setTimeout(() => {
            card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            card.style.opacity = '1';
            card.style.transform = 'translateY(0)';
          }, index * 100);
        });
      }
    }

    customElements.define('merch-page-{{ ai_gen_id }}', MerchPage{{ ai_gen_id }});
  })();
</script>

