{% doc %}
  @prompt
    Generate a merch page by aligning with our theme and site design. 
    product colletion holder with 12 product in display and below option to view more 12 and go on until they can view all. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-merch-collection-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-merch-collection__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 40px;
  }

  .ai-merch-collection__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .ai-merch-collection__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-merch-collection__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: 40px;
  }

  .ai-merch-collection__product-{{ ai_gen_id }} {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .ai-merch-collection__product-{{ ai_gen_id }}.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-merch-collection__product-link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease;
  }

  .ai-merch-collection__product-link-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-merch-collection__product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    background-color: {{ block.settings.image_background }};
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    margin-bottom: 12px;
  }

  .ai-merch-collection__product-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-merch-collection__product-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-merch-collection__product-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-merch-collection__product-info-{{ ai_gen_id }} {
    padding: 0 4px;
  }

  .ai-merch-collection__product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    font-weight: 500;
    line-height: 1.3;
  }

  .ai-merch-collection__product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
    font-weight: 400;
  }

  .ai-merch-collection__product-price--sale-{{ ai_gen_id }} {
    color: {{ block.settings.sale_price_color }};
  }

  .ai-merch-collection__product-price--compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    margin-left: 8px;
  }

  .ai-merch-collection__load-more-wrapper-{{ ai_gen_id }} {
    text-align: center;
    margin-top: 40px;
  }

  .ai-merch-collection__load-more-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: {{ block.settings.button_text_transform }};
    letter-spacing: 0.05em;
  }

  .ai-merch-collection__load-more-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY(-2px);
  }

  .ai-merch-collection__load-more-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  .ai-merch-collection__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.description_color }};
  }

  .ai-merch-collection__empty-state-{{ ai_gen_id }} svg {
    width: 120px;
    height: 120px;
    margin-bottom: 20px;
    opacity: 0.3;
  }

  @media screen and (max-width: 989px) {
    .ai-merch-collection__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-merch-collection__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.7 }}px;
    }

    .ai-merch-collection__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-merch-collection__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<merch-collection-{{ ai_gen_id }}
  class="ai-merch-collection-{{ ai_gen_id }}"
  data-products-per-page="12"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank or block.settings.description != blank %}
    <div class="ai-merch-collection__header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-merch-collection__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <div class="ai-merch-collection__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
    </div>
  {% endif %}

  {% if block.settings.collection != blank %}
    {% assign collection = block.settings.collection %}
    {% assign total_products = collection.products.size %}
    
    <div class="ai-merch-collection__grid-{{ ai_gen_id }}" data-product-grid>
      {% for product in collection.products %}
        <div 
          class="ai-merch-collection__product-{{ ai_gen_id }}"
          data-product-index="{{ forloop.index }}"
          {% if forloop.index > 12 %}style="display: none;"{% endif %}
        >
          <a href="{{ product.url }}" class="ai-merch-collection__product-link-{{ ai_gen_id }}">
            <div class="ai-merch-collection__product-image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-merch-collection__product-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% else %}
                <div class="ai-merch-collection__product-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-merch-collection__product-info-{{ ai_gen_id }}">
              <h3 class="ai-merch-collection__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
              <div class="ai-merch-collection__product-price-{{ ai_gen_id }}">
                {% if product.compare_at_price > product.price %}
                  <span class="ai-merch-collection__product-price--sale-{{ ai_gen_id }}">
                    {{ product.price | money }}
                  </span>
                  <span class="ai-merch-collection__product-price--compare-{{ ai_gen_id }}">
                    {{ product.compare_at_price | money }}
                  </span>
                {% else %}
                  {{ product.price | money }}
                {% endif %}
              </div>
            </div>
          </a>
        </div>
      {% endfor %}
    </div>

    {% if total_products > 12 %}
      <div class="ai-merch-collection__load-more-wrapper-{{ ai_gen_id }}">
        <button 
          class="ai-merch-collection__load-more-{{ ai_gen_id }}"
          data-load-more-button
        >
          {{ block.settings.load_more_text }}
        </button>
      </div>
    {% endif %}
  {% else %}
    <div class="ai-merch-collection__empty-state-{{ ai_gen_id }}">
      {{ 'collection-1' | placeholder_svg_tag }}
      <p>Select a collection to display products</p>
    </div>
  {% endif %}
</merch-collection-{{ ai_gen_id }}>

<script>
  (function() {
    class MerchCollection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.productsPerPage = parseInt(this.dataset.productsPerPage) || 12;
        this.currentlyVisible = this.productsPerPage;
      }

      connectedCallback() {
        this.productGrid = this.querySelector('[data-product-grid]');
        this.loadMoreButton = this.querySelector('[data-load-more-button]');
        this.allProducts = this.querySelectorAll('[data-product-index]');
        this.totalProducts = this.allProducts.length;

        if (this.loadMoreButton) {
          this.loadMoreButton.addEventListener('click', () => this.loadMoreProducts());
        }

        this.animateVisibleProducts();
      }

      loadMoreProducts() {
        const nextBatch = this.currentlyVisible + this.productsPerPage;
        const productsToShow = Array.from(this.allProducts).slice(
          this.currentlyVisible,
          nextBatch
        );

        productsToShow.forEach((product, index) => {
          setTimeout(() => {
            product.style.display = 'block';
            requestAnimationFrame(() => {
              product.classList.add('visible');
            });
          }, index * 50);
        });

        this.currentlyVisible = nextBatch;

        if (this.currentlyVisible >= this.totalProducts) {
          this.loadMoreButton.disabled = true;
          this.loadMoreButton.textContent = this.loadMoreButton.dataset.allLoadedText || 'All products loaded';
        }
      }

      animateVisibleProducts() {
        const visibleProducts = Array.from(this.allProducts).slice(0, this.productsPerPage);
        visibleProducts.forEach((product, index) => {
          setTimeout(() => {
            product.classList.add('visible');
          }, index * 50);
        });
      }
    }

    customElements.define('merch-collection-{{ ai_gen_id }}', MerchCollection{{ ai_gen_id }});
  })();
</script>

