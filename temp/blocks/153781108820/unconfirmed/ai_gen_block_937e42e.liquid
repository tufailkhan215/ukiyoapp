{% doc %}
  @prompt
    i need to embed code 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-code-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-custom-code-container-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-custom-code-empty-state-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    border: 2px dashed #cccccc;
    border-radius: 8px;
    padding: 40px 20px;
    text-align: center;
    color: #666666;
  }

  .ai-custom-code-empty-state-{{ ai_gen_id }} svg {
    width: 48px;
    height: 48px;
    margin-bottom: 16px;
    opacity: 0.5;
  }

  .ai-custom-code-empty-state-{{ ai_gen_id }} h3 {
    margin: 0 0 8px;
    font-size: 18px;
    color: #333333;
  }

  .ai-custom-code-empty-state-{{ ai_gen_id }} p {
    margin: 0;
    font-size: 14px;
  }
{% endstyle %}

<custom-code-{{ ai_gen_id }}
  class="ai-custom-code-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.custom_html != blank or block.settings.custom_liquid != blank %}
    <div class="ai-custom-code-container-{{ ai_gen_id }}">
      {% if block.settings.custom_liquid != blank %}
        {{ block.settings.custom_liquid }}
      {% endif %}
      
      {% if block.settings.custom_html != blank %}
        {{ block.settings.custom_html }}
      {% endif %}
    </div>
  {% else %}
    <div class="ai-custom-code-empty-state-{{ ai_gen_id }}">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="16 18 22 12 16 6"></polyline>
        <polyline points="8 6 2 12 8 18"></polyline>
      </svg>
      <h3>Add your custom code</h3>
      <p>Use the settings panel to add HTML, Liquid, CSS, or JavaScript</p>
    </div>
  {% endif %}
</custom-code-{{ ai_gen_id }}>

{% if block.settings.custom_css != blank %}
  {% style %}
    {{ block.settings.custom_css }}
  {% endstyle %}
{% endif %}

{% if block.settings.custom_javascript != blank %}
  <script>
    (function() {
      {{ block.settings.custom_javascript }}
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Custom code",
  "settings": [
    {
      "type": "header",
      "content": "Code"
    },
    {
      "type": "html",
      "id": "custom_html",
      "label": "HTML"
    },
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Liquid"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "CSS"
    },
    {
      "type": "html",
      "id": "custom_javascript",
      "label": "JavaScript"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Custom code"
    }
  ]
}
{% endschema %}
