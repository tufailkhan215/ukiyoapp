{% comment %} Gallery Featured Projects: amber badge/title, filter pills (amber active), square cards with hover eye, popup modal (image + text below, prev/next). {% endcomment %}
{% assign section_id = 'gallery-featured-' | append: section.id %}
<section class="relative py-16 lg:py-24 bg-black" id="{{ section_id }}" data-section-id="{{ section.id }}">
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  <div class="max-w-[1600px] mx-auto px-6 lg:px-12 relative z-10">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mb-12">
      <div>
        {% if section.settings.badge != blank %}
          <span class="text-[10px] font-medium text-amber-400 tracking-[0.3em] uppercase block mb-2">{{ section.settings.badge }}</span>
        {% endif %}
        {% if section.settings.title != blank %}
          <h2 class="text-3xl md:text-4xl font-bold text-white">{{ section.settings.title }}</h2>
        {% endif %}
      </div>
      {% assign filter_lines = section.settings.filters_text | newline_to_br | split: '<br />' %}
      {% if filter_lines.size > 0 %}
        <div class="gallery-fp-filters flex flex-wrap gap-2" role="tablist">
          {% for line in filter_lines %}
            {% assign filter_label = line | strip %}
            {% if filter_label != '' %}
              <button type="button" class="gallery-fp-filter px-4 py-2 rounded-full text-sm font-medium transition-all {% if forloop.first %}bg-amber-500 text-black{% else %}bg-white/5 text-white/60 hover:bg-white/10{% endif %}" data-filter="{{ filter_label | escape }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
                {{ filter_label }}
              </button>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="gallery-fp-grid grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
      {% for block in section.blocks %}
        {% if block.type == 'project' %}
          {% assign category_val = block.settings.category | strip | escape %}
          {% assign gallery_count = 0 %}
          {% if block.settings.image != blank %}{% assign gallery_count = gallery_count | plus: 1 %}{% endif %}
          {% if block.settings.gallery_image_2 != blank %}{% assign gallery_count = gallery_count | plus: 1 %}{% endif %}
          {% if block.settings.gallery_image_3 != blank %}{% assign gallery_count = gallery_count | plus: 1 %}{% endif %}
          {% if block.settings.gallery_image_4 != blank %}{% assign gallery_count = gallery_count | plus: 1 %}{% endif %}
          {% if block.settings.gallery_image_5 != blank %}{% assign gallery_count = gallery_count | plus: 1 %}{% endif %}
          {% if block.settings.gallery_image_6 != blank %}{% assign gallery_count = gallery_count | plus: 1 %}{% endif %}
          {% if gallery_count == 0 %}{% assign gallery_count = 1 %}{% endif %}
          {% assign gallery_parts = '' %}
          {% if block.settings.image != blank %}
            {% assign u = block.settings.image | image_url: width: 800 %}
            {% assign gallery_parts = gallery_parts | append: '"' | append: u | append: '"' %}
          {% endif %}
          {% if block.settings.gallery_image_2 != blank %}
            {% assign u = block.settings.gallery_image_2 | image_url: width: 800 %}
            {% if gallery_parts != '' %}{% assign gallery_parts = gallery_parts | append: ',' %}{% endif %}
            {% assign gallery_parts = gallery_parts | append: '"' | append: u | append: '"' %}
          {% endif %}
          {% if block.settings.gallery_image_3 != blank %}
            {% assign u = block.settings.gallery_image_3 | image_url: width: 800 %}
            {% if gallery_parts != '' %}{% assign gallery_parts = gallery_parts | append: ',' %}{% endif %}
            {% assign gallery_parts = gallery_parts | append: '"' | append: u | append: '"' %}
          {% endif %}
          {% if block.settings.gallery_image_4 != blank %}
            {% assign u = block.settings.gallery_image_4 | image_url: width: 800 %}
            {% if gallery_parts != '' %}{% assign gallery_parts = gallery_parts | append: ',' %}{% endif %}
            {% assign gallery_parts = gallery_parts | append: '"' | append: u | append: '"' %}
          {% endif %}
          {% if block.settings.gallery_image_5 != blank %}
            {% assign u = block.settings.gallery_image_5 | image_url: width: 800 %}
            {% if gallery_parts != '' %}{% assign gallery_parts = gallery_parts | append: ',' %}{% endif %}
            {% assign gallery_parts = gallery_parts | append: '"' | append: u | append: '"' %}
          {% endif %}
          {% if block.settings.gallery_image_6 != blank %}
            {% assign u = block.settings.gallery_image_6 | image_url: width: 800 %}
            {% if gallery_parts != '' %}{% assign gallery_parts = gallery_parts | append: ',' %}{% endif %}
            {% assign gallery_parts = gallery_parts | append: '"' | append: u | append: '"' %}
          {% endif %}
          {% assign gallery_images_json = '[' | append: gallery_parts | append: ']' %}
          <button type="button" class="gallery-fp-card group relative aspect-square overflow-hidden rounded-2xl cursor-pointer" data-index="{{ forloop.index0 }}" data-category="{{ category_val }}" data-gallery-images="{{ gallery_images_json | escape }}" data-gallery-count="{{ gallery_count }}" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <img alt="{{ block.settings.title | default: 'Project' | escape }}" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" src="{{ block.settings.image | image_url: width: 800 }}" width="800" height="800" loading="lazy">
            {% else %}
              <div class="absolute inset-0 bg-white/[0.05] flex items-center justify-center"><span class="text-white/20 text-sm">Image</span></div>
            {% endif %}
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent opacity-60 group-hover:opacity-90 transition-opacity duration-500" aria-hidden="true"></div>
            {% if block.settings.category != blank %}
              <div class="absolute top-4 left-4 px-3 py-1 bg-white/10 backdrop-blur-sm rounded-full border border-white/10">
                <span class="text-xs text-white/70">{{ block.settings.category }}</span>
              </div>
            {% endif %}
            <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <div class="w-16 h-16 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center border border-white/30 scale-90 group-hover:scale-100 transition-transform duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-white" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg>
              </div>
            </div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              {% if block.settings.title != blank %}
                <h3 class="text-xl font-bold text-white mb-2">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="text-white/50 text-sm line-clamp-2">{{ block.settings.description }}</p>
              {% endif %}
            </div>
          </button>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% comment %} Popup modal: single column – image, then category, title, description, Save/Share; prev/next for gallery. {% endcomment %}
<div id="{{ section_id }}-modal-backdrop" class="fixed inset-0 bg-black/95 backdrop-blur-sm z-50 hidden" aria-hidden="true"></div>
<div id="{{ section_id }}-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center overflow-y-auto py-8" role="dialog" aria-modal="true" aria-labelledby="{{ section_id }}-modal-title" aria-hidden="true">
  <button type="button" id="{{ section_id }}-modal-close" class="absolute top-6 right-6 w-12 h-12 rounded-full bg-white/10 flex items-center justify-center text-white hover:bg-white/20 transition-colors z-10" aria-label="Close">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
  </button>
  <button type="button" id="{{ section_id }}-modal-prev" class="absolute left-6 w-12 h-12 rounded-full bg-white/10 flex items-center justify-center text-white hover:bg-white/20 transition-colors z-10 hidden" aria-label="Previous">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
  </button>
  <button type="button" id="{{ section_id }}-modal-next" class="absolute right-6 w-12 h-12 rounded-full bg-white/10 flex items-center justify-center text-white hover:bg-white/20 transition-colors z-10 hidden" aria-label="Next">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
  </button>
  <div class="max-w-5xl w-full mx-6 mt-14">
    <div class="relative rounded-2xl overflow-hidden">
      <img id="{{ section_id }}-modal-img" src="" alt="" class="w-full h-auto max-h-[70vh] object-contain">
    </div>
    <div class="mt-6 text-center">
      <div id="{{ section_id }}-modal-category" class="text-amber-400 text-sm uppercase tracking-wider"></div>
      <h3 id="{{ section_id }}-modal-title" class="text-2xl font-bold text-white mt-2"></h3>
      <p id="{{ section_id }}-modal-description" class="text-white/50 mt-2 max-w-2xl mx-auto"></p>
      <div class="flex justify-center gap-4 mt-6">
        <button type="button" class="gallery-fp-modal-save flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-heart w-4 h-4" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>
          Save
        </button>
        <button type="button" class="gallery-fp-modal-share flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-share-2 w-4 h-4" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line></svg>
          Share
        </button>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var section = document.getElementById('{{ section_id }}');
  if (!section) return;
  var backdrop = document.getElementById('{{ section_id }}-modal-backdrop');
  var modal = document.getElementById('{{ section_id }}-modal');
  var modalImg = document.getElementById('{{ section_id }}-modal-img');
  var modalCategory = document.getElementById('{{ section_id }}-modal-category');
  var modalTitle = document.getElementById('{{ section_id }}-modal-title');
  var modalDescription = document.getElementById('{{ section_id }}-modal-description');
  var modalPrev = document.getElementById('{{ section_id }}-modal-prev');
  var modalNext = document.getElementById('{{ section_id }}-modal-next');
  var modalClose = document.getElementById('{{ section_id }}-modal-close');
  var cards = section.querySelectorAll('.gallery-fp-card');
  var currentIndex = 0;
  var currentImageIndex = 0;
  var projects = [];

  cards.forEach(function(card, idx) {
    var img = card.querySelector('img');
    var category = card.getAttribute('data-category') || '';
    var title = card.querySelector('h3') ? card.querySelector('h3').textContent.trim() : '';
    var desc = card.querySelector('p') ? card.querySelector('p').textContent.trim() : '';
    var galleryImagesAttr = card.getAttribute('data-gallery-images') || '';
    var images = [];
    if (galleryImagesAttr) {
      try {
        var urls = JSON.parse(galleryImagesAttr).filter(function(u) { return u && String(u).trim(); });
        if (urls.length > 0) images = urls;
      } catch (e) { console.warn('Gallery images parse error', e); }
    }
    if (images.length === 0 && img && img.src) images = [img.src];
    var imageCount = parseInt(card.getAttribute('data-gallery-count'), 10);
    if (isNaN(imageCount) || imageCount < 1) imageCount = images.length > 0 ? images.length : 1;
    projects.push({ category: category, title: title, description: desc, images: images, imageCount: imageCount });
  });

  function openModal(index) {
    currentIndex = index;
    currentImageIndex = 0;
    var proj = projects[index];
    if (!proj) return;
    modalImg.src = proj.images[0] || '';
    modalImg.alt = proj.title || '';
    modalTitle.textContent = proj.title;
    modalDescription.textContent = proj.description;
    modalCategory.textContent = proj.category || '';
    if (proj.imageCount > 1) {
      modalPrev.classList.remove('hidden');
      modalNext.classList.remove('hidden');
    } else {
      modalPrev.classList.add('hidden');
      modalNext.classList.add('hidden');
    }
    backdrop.classList.remove('hidden');
    backdrop.setAttribute('aria-hidden', 'false');
    modal.classList.remove('hidden');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    if (modalClose) modalClose.focus();
  }

  function closeModal() {
    backdrop.classList.add('hidden');
    backdrop.setAttribute('aria-hidden', 'true');
    modal.classList.add('hidden');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    var card = cards[currentIndex];
    if (card) card.focus();
  }

  function nextImage() {
    var proj = projects[currentIndex];
    if (!proj || proj.imageCount <= 1) return;
    currentImageIndex = (currentImageIndex + 1) % proj.imageCount;
    if (modalImg && proj.images[currentImageIndex]) modalImg.src = proj.images[currentImageIndex];
  }

  function prevImage() {
    var proj = projects[currentIndex];
    if (!proj || proj.imageCount <= 1) return;
    currentImageIndex = (currentImageIndex - 1 + proj.imageCount) % proj.imageCount;
    if (modalImg && proj.images[currentImageIndex]) modalImg.src = proj.images[currentImageIndex];
  }

  cards.forEach(function(card, idx) { card.addEventListener('click', function() { openModal(idx); }); });
  if (backdrop) backdrop.addEventListener('click', closeModal);
  if (modalClose) modalClose.addEventListener('click', closeModal);
  if (modal) modal.addEventListener('click', function(e) { if (e.target === modal) closeModal(); });
  if (modalPrev) modalPrev.addEventListener('click', prevImage);
  if (modalNext) modalNext.addEventListener('click', nextImage);
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) closeModal();
    if (e.key === 'ArrowLeft' && modal && !modal.classList.contains('hidden')) prevImage();
    if (e.key === 'ArrowRight' && modal && !modal.classList.contains('hidden')) nextImage();
  });

  var filters = section.querySelectorAll('.gallery-fp-filter');
  filters.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var filter = this.getAttribute('data-filter');
      filters.forEach(function(b) {
        b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
        b.classList.remove('bg-amber-500', 'text-black');
        b.classList.add('bg-white/5', 'text-white/60');
      });
      btn.classList.add('bg-amber-500', 'text-black');
      btn.classList.remove('bg-white/5', 'text-white/60');
      cards.forEach(function(card) {
        var cat = (card.getAttribute('data-category') || '').trim();
        var show = filter === 'All' || cat.toLowerCase() === filter.toLowerCase();
        card.style.display = show ? '' : 'none';
      });
    });
  });
})();
</script>

{% schema %}
{
  "name": "Gallery Featured Projects",
  "tag": "section",
  "class": "section-gallery-featured-projects",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge (small label above title)",
      "default": "(Our Work)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Featured Projects"
    },
    {
      "type": "textarea",
      "id": "filters_text",
      "label": "Filter buttons (one per line, first = All)",
      "default": "All\nBrand partnership\nAdventure travel\nEnergy & lifestyle\nFashion & lifestyle"
    }
  ],
  "blocks": [
    {
      "type": "project",
      "name": "Project",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "category", "label": "Category (for filter)", "default": "Brand Partnership" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Short description" },
        { "type": "image_picker", "id": "gallery_image_2", "label": "Gallery image 2" },
        { "type": "image_picker", "id": "gallery_image_3", "label": "Gallery image 3" },
        { "type": "image_picker", "id": "gallery_image_4", "label": "Gallery image 4" },
        { "type": "image_picker", "id": "gallery_image_5", "label": "Gallery image 5" },
        { "type": "image_picker", "id": "gallery_image_6", "label": "Gallery image 6" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gallery Featured Projects",
      "settings": {
        "badge": "(Our Work)",
        "title": "Featured Projects",
        "filters_text": "All\nBrand partnership\nAdventure travel\nEnergy & lifestyle\nFashion & lifestyle"
