        { "type": "project", "settings": { "category": "Energy & Lifestyle", "title": "MONSTER", "description": "High-energy brand content and experiential marketing campaigns." } },
        { "type": "project", "settings": { "category": "Fashion & Lifestyle", "title": "POPPY.CALIFORNIA", "description": "California-inspired brand storytelling and visual identity development." } },
        { "type": "project", "settings": { "category": "E-commerce", "title": "FURTRADERS", "description": "Complete brand refresh with content strategy and e-commerce optimization." } },
        { "type": "project", "settings": { "category": "Lifestyle & Wellness", "title": "SUPRAMOOD", "description": "Comprehensive brand strategy with podcast series and affiliate program." } },
        { "type": "project", "settings": { "category": "Technology", "title": "DJI", "description": "Aerial photography and drone content creation partnership." } },
        { "type": "project", "settings": { "category": "Streetwear", "title": "CLSC", "description": "Urban streetwear brand activation and cultural marketing." } },
        { "type": "project", "settings": { "category": "Travel & Experience", "title": "MAVERICK HELICOPTERS", "description": "Luxury travel experience content and brand storytelling." } },
        { "type": "project", "settings": { "category": "Media & Culture", "title": "HIGHSNOBIETY", "description": "Editorial content partnership and cultural brand activation." } },
        { "type": "project", "settings": { "category": "Culinary", "title": "JI RESTAURANT | BALI INDONESIA", "description": "Balinese fine dining experience captured through visual storytelling." } },
        { "type": "project", "settings": { "category": "Hospitality", "title": "SATORI | MAUI", "description": "Hawaiian wellness retreat brand development and content creation." } }
