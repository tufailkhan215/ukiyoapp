{% comment %} Blog Intro: full-height hero with optional canvas grid, badge, two-line gradient title, subtitle. {% endcomment %}
{% capture blog_intro_bg_style %}background-color: {{ section.settings.background_color | default: '#0a0a0a' }};{% if section.settings.background_image != blank %} background-image: url({{ section.settings.background_image | image_url: width: 1920 }}); background-size: cover; background-position: center;{% endif %}{% endcapture %}
<section class="relative min-h-screen flex items-center overflow-hidden" style="{{ blog_intro_bg_style | strip }}" {{ section.shopify_attributes }}>
  {% if section.settings.show_grid %}
    <canvas id="blog-intro-canvas-{{ section.id }}" class="absolute inset-0 w-full h-full" width="1920" height="1080" aria-hidden="true"></canvas>
  {% endif %}
  <div class="relative z-10 max-w-[1400px] mx-auto px-6 lg:px-12 pt-32 pb-20 w-full">
    <div class="text-center">
      {% if section.settings.badge != blank %}
        <span class="text-[10px] font-medium text-white/40 tracking-[0.3em] uppercase block mb-6">{{ section.settings.badge }}</span>
      {% endif %}
      {% if section.settings.title_line1 != blank or section.settings.title_line2 != blank %}
        <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black text-white leading-[0.9] tracking-tight mb-8">
          {% if section.settings.title_line1 != blank %}
            <span class="block text-transparent bg-clip-text bg-gradient-to-b from-white via-gray-300 to-gray-600">{{ section.settings.title_line1 }}</span>
          {% endif %}
          {% if section.settings.title_line2 != blank %}
            <span class="block text-transparent bg-clip-text bg-gradient-to-b from-gray-200 via-gray-500 to-gray-800">{{ section.settings.title_line2 }}</span>
          {% endif %}
        </h1>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <p class="text-lg md:text-xl text-white/40 max-w-2xl mx-auto">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% if section.settings.show_grid %}
<script>
(function() {
  var canvas = document.getElementById('blog-intro-canvas-{{ section.id }}');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  function draw() {
    var w = canvas.parentElement.clientWidth;
    var h = canvas.parentElement.clientHeight;
    canvas.width = w;
    canvas.height = h;
    ctx.fillStyle = 'transparent';
    ctx.fillRect(0, 0, w, h);
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    var spacing = 48;
    for (var x = 0; x <= w + spacing; x += spacing) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, h);
      ctx.stroke();
    }
    for (var y = 0; y <= h + spacing; y += spacing) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(w, y);
      ctx.stroke();
    }
  }
  draw();
  window.addEventListener('resize', draw);
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Blog Intro",
  "tag": "section",
  "class": "section-blog-intro",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#0a0a0a"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Optional. Color shows behind or if image fails to load."
    },
    {
      "type": "checkbox",
      "id": "show_grid",
      "label": "Show grid overlay",
      "default": true,
      "info": "Draws a subtle grid pattern on the background."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "(Insights & Stories)"
    },
    {
      "type": "text",
      "id": "title_line1",
      "label": "Title (first line, gradient)",
      "default": "BLOGS &"
    },
    {
      "type": "text",
      "id": "title_line2",
      "label": "Title (second line, gradient)",
      "default": "LATEST ARTICLES"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Insights, inspiration, and innovation from the intersection of creativity, technology, and culture."
    }
  ],
  "presets": [
    {
      "name": "Blog Intro"
    }
  ]
}
{% endschema %}
