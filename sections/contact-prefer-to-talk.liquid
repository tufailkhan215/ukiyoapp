{% comment %} Prefer to Talk: calendar icon, heading, description, booking embed (TidyCal or custom). {% endcomment %}
<section class="relative py-16 lg:py-24 overflow-hidden bg-black" data-testid="booking-section" {{ section.shopify_attributes }}>
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  <div class="max-w-[1000px] mx-auto px-6 lg:px-12 relative z-10">
    <div class="text-center mb-8">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar w-12 h-12 text-white/60 mx-auto mb-6" aria-hidden="true"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path></svg>
      {% if section.settings.heading != blank %}
        <h3 class="text-3xl font-bold text-white mb-4">{{ section.settings.heading }}</h3>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="text-white/50 mb-8 max-w-lg mx-auto">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <div class="rounded-2xl overflow-hidden bg-white/[0.02] border border-white/10 p-4" data-testid="tidycal-container">
      {% if section.settings.tidycal_path != blank %}
        <div
          class="tidycal-embed"
          data-path="{{ section.settings.tidycal_path | escape }}"
          style="min-height: {{ section.settings.embed_min_height | default: 600 }}px;"
        ></div>
        {% if section.settings.tidycal_script_url != blank %}
          <script src="{{ section.settings.tidycal_script_url }}" async></script>
        {% endif %}
      {% else %}
        <div class="flex items-center justify-center text-white/30 text-sm" style="min-height: {{ section.settings.embed_min_height | default: 600 }}px;">
          {{ section.settings.placeholder_text | default: 'Set TidyCal path in section settings (e.g. salesautomateiq/consultation).' }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Prefer to Talk",
  "tag": "section",
  "class": "section-contact-prefer-to-talk",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Prefer to Talk?"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Schedule a free 30-minute consultation to discuss your project goals and how we can help bring your vision to life."
    },
    {
      "type": "header",
      "content": "Booking embed (TidyCal)"
    },
    {
      "type": "text",
      "id": "tidycal_path",
      "label": "TidyCal path",
      "info": "e.g. salesautomateiq/consultation",
      "default": "salesautomateiq/consultation"
    },
    {
      "type": "url",
      "id": "tidycal_script_url",
      "label": "TidyCal script URL (optional)",
      "info": "Add TidyCal's embed script URL if the calendar doesn't load automatically."
    },
    {
      "type": "range",
      "id": "embed_min_height",
      "label": "Embed min height (px)",
      "min": 400,
      "max": 900,
      "step": 50,
      "default": 600
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Placeholder text",
      "info": "Shown when TidyCal path is empty.",
      "default": "Set TidyCal path in section settings (e.g. salesautomateiq/consultation)."
    }
  ],
  "presets": [
    {
      "name": "Prefer to Talk"
    }
  ]
}
{% endschema %}
