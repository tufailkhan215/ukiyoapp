{% comment %} Business Statistics: brutal honesty header, WITHOUT UKIYO vs WITH UKIYO comparison, The Math Doesn't Lie. {% endcomment %}
{% assign without_blocks = section.blocks | where: 'type', 'without_item' %}
{% assign with_blocks = section.blocks | where: 'type', 'with_item' %}
{% assign math_blocks = section.blocks | where: 'type', 'math_stat' %}

<section class="relative py-28 lg:py-40 bg-black overflow-hidden" data-testid="business-statistics">
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  <div class="absolute inset-0" aria-hidden="true">
    <div class="absolute top-1/4 right-1/4 w-[500px] h-[500px] rounded-full bg-white/[0.02] blur-[120px]"></div>
  </div>

  <div class="relative z-10 max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="text-center mb-20">
      {% if section.settings.badge != blank %}
        <span class="text-[10px] font-medium text-red-400/70 tracking-[0.3em] uppercase block mb-5">{{ section.settings.badge }}</span>
      {% endif %}
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-black text-white mb-6">
        {{ section.settings.title_before }}
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-400 via-orange-400 to-yellow-400">{{ section.settings.title_gradient }}</span>
      </h2>
      {% if section.settings.subtitle != blank %}
        <p class="text-lg text-white/50 max-w-2xl mx-auto">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="grid lg:grid-cols-2 gap-8 mb-20">
      {% comment %} Left: WITHOUT UKIYO {% endcomment %}
      <div class="relative">
        <div class="absolute -top-4 -left-4 w-24 h-24 bg-red-500/10 rounded-full blur-2xl" aria-hidden="true"></div>
        <div class="relative bg-white/[0.02] border-2 border-dashed border-red-500/30 rounded-3xl p-8 overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-8 bg-[repeating-linear-gradient(45deg,#fbbf24,#fbbf24_10px,#000_10px,#000_20px)] opacity-30" aria-hidden="true"></div>
          <div class="flex items-center gap-3 mb-8 pt-4">
            <div class="w-12 h-12 rounded-full bg-red-500/20 flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert w-6 h-6 text-red-400" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-red-400">{{ section.settings.without_heading | default: 'WITHOUT UKIYO' }}</h3>
              <p class="text-white/40 text-sm">{{ section.settings.without_subtitle | default: 'The struggle is real (and expensive)' }}</p>
            </div>
          </div>
          <div class="space-y-4">
            {% for block in without_blocks %}
              <div class="flex items-start gap-4 p-4 bg-white/[0.02] rounded-xl border border-white/[0.05]" {{ block.shopify_attributes }}>
                <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 {{ block.settings.icon_bg }}">
                  {% case block.settings.icon %}
                    {% when 'clock' %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6 text-white"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    {% when 'dollar' %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6 text-white"><line x1="12" x2="12" y1="2" y2="22"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    {% when 'brain' %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6 text-white"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"></path><path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"></path><path d="M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4"></path></svg>
                    {% when 'coffee' %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6 text-white"><path d="M10 2v2"></path><path d="M14 2v2"></path><path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1"></path><path d="M6 2v2"></path></svg>
                    {% else %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6 text-white"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg>
                  {% endcase %}
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between gap-2 mb-1 flex-wrap">
                    <h4 class="font-bold text-white">{{ block.settings.title }}</h4>
                    <span class="text-lg font-black text-red-400">{{ block.settings.metric }}</span>
                  </div>
                  <p class="text-white/40 text-sm">{{ block.settings.description }}</p>
                </div>
              </div>
            {% endfor %}
          </div>
          <div class="absolute -bottom-6 -right-6 w-24 h-24 bg-red-500/10 rounded-full flex items-center justify-center pointer-events-none" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-frown w-12 h-12 text-red-400/50"><circle cx="12" cy="12" r="10"></circle><path d="M16 16s-1.5-2-4-2-4 2-4 2"></path><line x1="9" x2="9.01" y1="9" y2="9"></line><line x1="15" x2="15.01" y1="9" y2="9"></line></svg>
          </div>
        </div>
      </div>

      {% comment %} Right: WITH UKIYO {% endcomment %}
      <div class="relative">
        <div class="absolute -top-4 -right-4 w-24 h-24 bg-green-500/10 rounded-full blur-2xl" aria-hidden="true"></div>
        <div class="relative bg-white rounded-3xl p-8 text-black h-full">
          <div class="flex items-center gap-3 mb-8">
            <div class="w-12 h-12 rounded-full bg-green-500/20 flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-sparkles w-6 h-6 text-green-600"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-green-600">{{ section.settings.with_heading | default: 'WITH UKIYO' }}</h3>
              <p class="text-black/40 text-sm">{{ section.settings.with_subtitle | default: 'Let the grown-ups handle it' }}</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4 mb-8">
            {% for block in with_blocks %}
              <div class="text-center p-6 bg-black/[0.03] rounded-xl border border-black/5" {{ block.shopify_attributes }}>
                {% case block.settings.icon %}
                  {% when 'trending_down' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-trending-down w-6 h-6 text-green-600 mx-auto mb-2"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7"></polyline><polyline points="16 17 22 17 22 11"></polyline></svg>
                  {% when 'dollar' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-dollar-sign w-6 h-6 text-green-600 mx-auto mb-2"><line x1="12" x2="12" y1="2" y2="22"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                  {% when 'brain' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-brain w-6 h-6 text-green-600 mx-auto mb-2"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"></path><path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"></path><path d="M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4"></path></svg>
                  {% when 'clock' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-clock w-6 h-6 text-green-600 mx-auto mb-2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                  {% else %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6 text-green-600 mx-auto mb-2"><circle cx="12" cy="12" r="10"></circle></svg>
                {% endcase %}
                <p class="text-3xl font-black text-green-600 mb-1">{{ block.settings.metric }}</p>
                <p class="text-black/50 text-xs">{{ block.settings.subtitle }}</p>
              </div>
            {% endfor %}
          </div>
          <div class="text-center">
            {% if section.settings.testimonial != blank %}
              <p class="text-black/60 mb-6">
                {{ section.settings.testimonial }}
                {% if section.settings.testimonial_attr != blank %}<br><span class="text-black/40 text-sm">— {{ section.settings.testimonial_attr }}</span>{% endif %}
              </p>
            {% endif %}
            {% if section.settings.cta_url != blank or section.settings.cta_text != blank %}
              <a href="{{ section.settings.cta_url | default: '#' }}" class="inline-block">
                <button type="button" class="px-8 py-4 bg-black text-white rounded-full font-bold flex items-center justify-center gap-2 mx-auto">
                  {{ section.settings.cta_text | default: 'Stop Playing With Yourself' }}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-arrow-right w-5 h-5"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                </button>
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    {% comment %} The Math Doesn't Lie {% endcomment %}
    <div class="bg-white/[0.02] border border-white/[0.05] rounded-2xl p-8">
      <div class="text-center mb-8">
        <h3 class="text-2xl font-bold text-white mb-2">{{ section.settings.math_heading | default: "The Math Doesn't Lie" }}</h3>
        {% if section.settings.math_subheading != blank %}
          <p class="text-white/50">{{ section.settings.math_subheading }}</p>
        {% endif %}
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {% for block in math_blocks %}
          {% assign math_color = block.settings.color | default: 'red' %}
          {% if math_color == 'orange' %}
            <div class="text-center p-6 bg-orange-500/10 rounded-xl border border-orange-500/20" {{ block.shopify_attributes }}>
              <p class="text-5xl font-black text-orange-400 mb-2">{{ block.settings.value }}</p>
              <p class="text-orange-400/70 text-sm font-medium">{{ block.settings.label }}</p>
              {% if block.settings.sublabel != blank %}<p class="text-orange-400/40 text-xs mt-1">{{ block.settings.sublabel }}</p>{% endif %}
            </div>
          {% elsif math_color == 'yellow' %}
            <div class="text-center p-6 bg-yellow-500/10 rounded-xl border border-yellow-500/20" {{ block.shopify_attributes }}>
              <p class="text-5xl font-black text-yellow-400 mb-2">{{ block.settings.value }}</p>
              <p class="text-yellow-400/70 text-sm font-medium">{{ block.settings.label }}</p>
              {% if block.settings.sublabel != blank %}<p class="text-yellow-400/40 text-xs mt-1">{{ block.settings.sublabel }}</p>{% endif %}
            </div>
          {% else %}
            <div class="text-center p-6 bg-red-500/10 rounded-xl border border-red-500/20" {{ block.shopify_attributes }}>
              <p class="text-5xl font-black text-red-400 mb-2">{{ block.settings.value }}</p>
              <p class="text-red-400/70 text-sm font-medium">{{ block.settings.label }}</p>
              {% if block.settings.sublabel != blank %}<p class="text-red-400/40 text-xs mt-1">{{ block.settings.sublabel }}</p>{% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Business Statistics",
  "tag": "section",
  "class": "section-business-statistics",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "(Brutal Honesty Incoming)" },
    { "type": "text", "id": "title_before", "label": "Title (before gradient)", "default": "Businesses Are " },
    { "type": "text", "id": "title_gradient", "label": "Title (gradient part)", "default": "Playing With Themselves" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "...by not working with us. Here's what \"doing it yourself\" actually looks like:" },
    { "type": "text", "id": "without_heading", "label": "Left column heading", "default": "WITHOUT UKIYO" },
    { "type": "text", "id": "without_subtitle", "label": "Left column subtitle", "default": "The struggle is real (and expensive)" },
    { "type": "text", "id": "with_heading", "label": "Right column heading", "default": "WITH UKIYO" },
    { "type": "text", "id": "with_subtitle", "label": "Right column subtitle", "default": "Let the grown-ups handle it" },
    { "type": "textarea", "id": "testimonial", "label": "Testimonial quote", "default": "\"We went from chaos to clarity. Now I actually have time for hobbies.\"" },
    { "type": "text", "id": "testimonial_attr", "label": "Testimonial attribution", "default": "Every Ukiyo client ever" },
    { "type": "text", "id": "cta_url", "label": "CTA button URL", "default": "/contact" },
    { "type": "text", "id": "cta_text", "label": "CTA button text", "default": "Stop Playing With Yourself" },
    { "type": "text", "id": "math_heading", "label": "Bottom card heading", "default": "The Math Doesn't Lie" },
    { "type": "text", "id": "math_subheading", "label": "Bottom card subheading", "default": "Average business owner's time and money wasted annually" }
  ],
  "blocks": [
    {
      "type": "without_item",
      "name": "Without UKIYO item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "clock", "options": [ { "value": "clock", "label": "Clock" }, { "value": "dollar", "label": "Dollar" }, { "value": "brain", "label": "Brain" }, { "value": "coffee", "label": "Coffee" } ] },
        { "type": "text", "id": "icon_bg", "label": "Icon background (Tailwind)", "default": "bg-red-500" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "metric", "label": "Metric (e.g. 47 hours/week)" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    },
    {
      "type": "with_item",
      "name": "With UKIYO item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "trending_down", "options": [ { "value": "trending_down", "label": "Trending down" }, { "value": "dollar", "label": "Dollar" }, { "value": "brain", "label": "Brain" }, { "value": "clock", "label": "Clock" } ] },
        { "type": "text", "id": "metric", "label": "Metric (e.g. 0 hrs)" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" }
      ]
    },
    {
      "type": "math_stat",
      "name": "Math stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value (e.g. 2,080)" },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "sublabel", "label": "Sublabel" },
        { "type": "select", "id": "color", "label": "Color", "default": "red", "options": [ { "value": "red", "label": "Red" }, { "value": "orange", "label": "Orange" }, { "value": "yellow", "label": "Yellow" } ] }
      ]
    }
  ],
  "presets": [
    {
      "name": "Business Statistics",
      "settings": {},
      "blocks": [
        { "type": "without_item", "settings": { "icon": "clock", "icon_bg": "bg-red-500", "title": "DIY Design Disasters", "metric": "47 hours/week", "description": "Spent watching Canva tutorials while your competitors hire professionals" } },
        { "type": "without_item", "settings": { "icon": "dollar", "icon_bg": "bg-orange-500", "title": "Money Left on Table", "metric": "$127K/year", "description": "Revenue you're missing because your website looks like it's from 2009" } },
        { "type": "without_item", "settings": { "icon": "brain", "icon_bg": "bg-yellow-500", "title": "Mental Breakdowns", "metric": "3.7 per week", "description": "Crying over why Instagram keeps changing its algorithm" } },
        { "type": "without_item", "settings": { "icon": "coffee", "icon_bg": "bg-amber-500", "title": "Caffeine Dependency", "metric": "∞ cups", "description": "Needed to stay awake while editing that 'quick' video at 3am" } },
        { "type": "with_item", "settings": { "icon": "trending_down", "metric": "0 hrs", "subtitle": "Wasted on DIY fails" } },
        { "type": "with_item", "settings": { "icon": "dollar", "metric": "+$340%", "subtitle": "Average revenue growth" } },
        { "type": "with_item", "settings": { "icon": "brain", "metric": "100%", "subtitle": "Sanity preserved" } },
        { "type": "with_item", "settings": { "icon": "clock", "metric": "1000+ hrs", "subtitle": "Saved annually" } },
        { "type": "math_stat", "settings": { "value": "2,080", "label": "Hours lost to DIY marketing", "sublabel": "(That's 52 weeks of full-time work)", "color": "red" } },
        { "type": "math_stat", "settings": { "value": "$89K", "label": "Avg. lost revenue opportunity", "sublabel": "(From poor branding & no automation)", "color": "orange" } },
        { "type": "math_stat", "settings": { "value": "847", "label": "Gray hairs grown prematurely", "sublabel": "(Okay we made this one up, but still)", "color": "yellow" } }
      ]
    }
  ]
}
{% endschema %}
