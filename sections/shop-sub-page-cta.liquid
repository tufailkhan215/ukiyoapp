{% comment %} Shop Sub Page CTA: centered heading, description, primary button. {% endcomment %}

<section class="relative py-20 lg:py-28" {{ section.shopify_attributes }}>
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  <div class="max-w-[800px] mx-auto px-6 lg:px-12 text-center">
    {% if section.settings.heading != blank %}
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.description != blank %}
      <p class="text-white/50 mb-8">{{ section.settings.description }}</p>
    {% endif %}
    {% if section.settings.button_text != blank %}
      <a class="inline-flex items-center gap-2 px-8 py-4 bg-white text-black rounded-full font-semibold hover:bg-gray-200 transition-colors" href="{{ section.settings.button_url | default: '#' }}">
        <span>{{ section.settings.button_text }}</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right w-5 h-5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Shop Sub Page CTA",
  "tag": "section",
  "class": "section-shop-sub-page-cta",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get Unlimited Access"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Join membership and download everything for one monthly price."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "View Membership Plans"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Shop Sub Page CTA",
      "settings": {
        "heading": "Get Unlimited Access",
        "description": "Join membership and download everything for one monthly price.",
        "button_text": "View Membership Plans"
      }
    }
  ]
}
{% endschema %}
