{% comment %}
  ┌─────────────────────────────────────────────────────────────────┐
  │  MEDIA INTERACTIVE SHOWCASE — UkiyoProd                        │
  │  Bento grid layout with filter pills & hover effects           │
  │  Version: 2.0.0                                                 │
  └─────────────────────────────────────────────────────────────────┘
{% endcomment %}

{%- liquid
  assign section_id  = 'mis-' | append: section.id
  assign layout_mode = section.settings.interaction_mode
  assign kicker      = section.settings.kicker
  assign heading     = section.settings.heading
  assign subheading  = section.settings.subheading
  assign items       = section.blocks
-%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap');

  #{{ section_id }} {
    --bg:      {{ section.settings.bg_color }};
    --accent:  {{ section.settings.accent_color }};
    --card-bg: {{ section.settings.card_bg_color }};
    --text:    {{ section.settings.text_color }};
    --muted:   {{ section.settings.text_color | color_mix: section.settings.bg_color, 40 }};
    --ease:    cubic-bezier(.23,1,.32,1);
  }

  #{{ section_id }} *, #{{ section_id }} *::before, #{{ section_id }} *::after {
    box-sizing: border-box; margin: 0; padding: 0;
  }

  #{{ section_id }} {
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    padding: clamp(3rem, 8vw, 5rem) clamp(1.5rem, 5vw, 5rem);
    overflow: hidden;
  }

  /* ── HEADER ──────────────────────────────────────────────────── */
  #{{ section_id }} .mis-header {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 4rem;
  }
  @media (min-width: 768px) {
    #{{ section_id }} .mis-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  #{{ section_id }} .mis-kicker {
    color: var(--accent);
    font-weight: 800;
    font-size: .7rem;
    letter-spacing: .2em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 1rem;
  }

  #{{ section_id }} .mis-heading {
    font-size: clamp(2.8rem, 6vw, 4.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -.03em;
    margin-bottom: 1.25rem;
  }

  #{{ section_id }} .mis-heading .outline {
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255,255,255,.8);
  }

  #{{ section_id }} .mis-subheading {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 44ch;
  }

  /* ── FILTER PILLS ────────────────────────────────────────────── */
  #{{ section_id }} .mis-filters {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    align-self: flex-start;
  }

  #{{ section_id }} .mis-pill {
    background: rgba(255,255,255,.05);
    border: 1px solid rgba(255,255,255,.1);
    padding: .5rem 1.25rem;
    border-radius: 9999px;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--text);
    cursor: pointer;
    transition: all .3s var(--ease);
  }
  #{{ section_id }} .mis-pill.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: #000;
  }
  #{{ section_id }} .mis-pill:hover:not(.is-active) {
    background: rgba(255,255,255,.1);
  }

  /* ── BENTO GRID ──────────────────────────────────────────────── */
  #{{ section_id }} .mis-bento {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: minmax(150px, auto);
    gap: 1.5rem;
  }

  /* ASYMMETRIC */
  #{{ section_id }} .mis-bento.mode--asymmetric .mis-card:nth-child(1) { grid-column: span 8; grid-row: span 3; }
  #{{ section_id }} .mis-bento.mode--asymmetric .mis-card:nth-child(2) { grid-column: span 4; grid-row: span 2; }
  #{{ section_id }} .mis-bento.mode--asymmetric .mis-card:nth-child(3) { grid-column: span 4; grid-row: span 1; }
  #{{ section_id }} .mis-bento.mode--asymmetric .mis-card:nth-child(4) { grid-column: span 6; grid-row: span 2; }
  #{{ section_id }} .mis-bento.mode--asymmetric .mis-card:nth-child(5) { grid-column: span 6; grid-row: span 2; }
  #{{ section_id }} .mis-bento.mode--asymmetric .mis-card:nth-child(n+6) { grid-column: span 4; grid-row: span 2; }

  /* GRID */
  #{{ section_id }} .mis-bento.mode--grid .mis-card { grid-column: span 4; grid-row: span 2; }

  /* SPOTLIGHT */
  #{{ section_id }} .mis-bento.mode--spotlight .mis-card:nth-child(1) { grid-column: span 8; grid-row: span 4; }
  #{{ section_id }} .mis-bento.mode--spotlight .mis-card:nth-child(n+2) { grid-column: span 4; grid-row: span 2; }

  /* MASONRY */
  #{{ section_id }} .mis-bento.mode--masonry .mis-card:nth-child(1) { grid-column: span 4; grid-row: span 3; }
  #{{ section_id }} .mis-bento.mode--masonry .mis-card:nth-child(2) { grid-column: span 4; grid-row: span 2; }
  #{{ section_id }} .mis-bento.mode--masonry .mis-card:nth-child(3) { grid-column: span 4; grid-row: span 2; }
  #{{ section_id }} .mis-bento.mode--masonry .mis-card:nth-child(4) { grid-column: span 6; grid-row: span 2; }
  #{{ section_id }} .mis-bento.mode--masonry .mis-card:nth-child(5) { grid-column: span 6; grid-row: span 1; }
  #{{ section_id }} .mis-bento.mode--masonry .mis-card:nth-child(n+6) { grid-column: span 4; grid-row: span 2; }

  /* Responsive */
  @media (max-width: 1024px) {
    #{{ section_id }} .mis-bento .mis-card { grid-column: span 6 !important; grid-row: span 2 !important; }
  }
  @media (max-width: 640px) {
    #{{ section_id }} .mis-bento .mis-card { grid-column: span 12 !important; grid-row: span 2 !important; }
  }

  /* ── CARD ────────────────────────────────────────────────────── */
  #{{ section_id }} .mis-card {
    position: relative;
    background: var(--card-bg);
    border-radius: 1.5rem;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.05);
    transition: border-color .5s var(--ease), transform .5s var(--ease);
    cursor: pointer;
    min-height: 200px;
  }
  #{{ section_id }} .mis-card:hover {
    border-color: rgba(255,255,255,.2);
    transform: translateY(-5px);
  }

  #{{ section_id }} .mis-card-img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: .7;
    transition: transform .7s var(--ease), opacity .7s var(--ease);
  }
  #{{ section_id }} .mis-card:hover .mis-card-img {
    transform: scale(1.08);
    opacity: 1;
  }

  #{{ section_id }} .mis-card-placeholder {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, #111 0%, #1a1a2e 100%);
  }

  #{{ section_id }} .mis-card-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,.9) 0%, rgba(0,0,0,0) 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2rem;
    pointer-events: none;
    z-index: 1;
  }

  #{{ section_id }} .mis-card-tag {
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: .5rem;
    display: block;
  }

  #{{ section_id }} .mis-card-title {
    font-size: clamp(1rem, 2vw, 1.4rem);
    font-weight: 700;
    line-height: 1.2;
    color: #fff;
  }

  #{{ section_id }} .mis-card-desc {
    font-size: .82rem;
    color: rgba(255,255,255,.5);
    line-height: 1.55;
    margin-top: .4rem;
    max-width: 36ch;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity .4s var(--ease), transform .4s var(--ease);
  }
  #{{ section_id }} .mis-card:hover .mis-card-desc {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── FOOTER ──────────────────────────────────────────────────── */
  #{{ section_id }} .mis-footer {
    margin-top: 5rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(255,255,255,.08);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--muted);
    flex-wrap: wrap;
    gap: 1rem;
  }
  #{{ section_id }} .mis-footer a { color: var(--muted); text-decoration: none; transition: color .2s; }
  #{{ section_id }} .mis-footer a:hover { color: var(--text); }

  /* ── REVEAL ──────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: no-preference) {
    .mis-reveal { opacity: 0; transform: translateY(24px); }
    .mis-reveal.is-in { animation: mis-fadein .8s cubic-bezier(.16,1,.3,1) forwards; }
    .mis-reveal.d1 { animation-delay: .1s; }
    .mis-reveal.d2 { animation-delay: .2s; }
    .mis-reveal.d3 { animation-delay: .3s; }
    @keyframes mis-fadein { to { opacity: 1; transform: none; } }

    #{{ section_id }} .mis-card {
      opacity: 0; transform: translateY(20px) scale(.98);
      transition: opacity .6s var(--ease), transform .6s var(--ease),
                  border-color .5s var(--ease);
    }
    #{{ section_id }} .mis-card.is-in { opacity: 1; transform: translateY(0) scale(1); }
    {% for i in (1..12) %}
    #{{ section_id }} .mis-card:nth-child({{ i }}) { transition-delay: {{ i | times: 0.06 }}s; }
    {% endfor %}
  }
</style>

<section id="{{ section_id }}" class="media-interactive-showcase" data-section-id="{{ section.id }}">
  <div style="max-width:{{ section.settings.max_width }}px;margin:0 auto;">

    <header class="mis-header">
      <div style="max-width:36rem;">
        {%- if kicker != blank -%}
          <span class="mis-kicker mis-reveal">• {{ kicker }}</span>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 class="mis-heading mis-reveal d1">{{ heading }}</h2>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="mis-subheading mis-reveal d2">{{ subheading }}</p>
        {%- endif -%}
      </div>

      <nav class="mis-filters mis-reveal d3" data-mis-filters>
        <button class="mis-pill {% if layout_mode == 'asymmetric' %}is-active{% endif %}" data-mode="asymmetric">Asymmetric</button>
        <button class="mis-pill {% if layout_mode == 'grid' %}is-active{% endif %}" data-mode="grid">Grid</button>
        <button class="mis-pill {% if layout_mode == 'spotlight' %}is-active{% endif %}" data-mode="spotlight">Spotlight</button>
        <button class="mis-pill {% if layout_mode == 'masonry' %}is-active{% endif %}" data-mode="masonry">Masonry</button>
      </nav>
    </header>

    <main class="mis-bento mode--{{ layout_mode }}" data-mis-grid>
      {%- for block in items -%}
        <div
          class="mis-card"
          {{ block.shopify_attributes }}
          {% if block.settings.link != blank %}onclick="window.location='{{ block.settings.link }}'" role="link" tabindex="0"{% endif %}
        >
          {%- if block.settings.image -%}
            <img class="mis-card-img" src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
          {%- else -%}
            <div class="mis-card-placeholder"></div>
          {%- endif -%}
          <div class="mis-card-overlay">
            {%- if block.settings.tag != blank -%}<span class="mis-card-tag">{{ block.settings.tag }}</span>{%- endif -%}
            {%- if block.settings.title != blank -%}<h3 class="mis-card-title">{{ block.settings.title }}</h3>{%- endif -%}
            {%- if block.settings.description != blank -%}<p class="mis-card-desc">{{ block.settings.description }}</p>{%- endif -%}
          </div>
        </div>
      {%- else -%}
        {%- assign demo_titles = 'Brand Identity System,Campaign Film,Digital Experience,Growth Framework,Visual Systems' | split: ',' -%}
        {%- assign demo_tags   = 'Branding,Motion,UX/UI,Strategy,Design' | split: ',' -%}
        {%- for i in (1..5) -%}
          {%- assign idx = forloop.index0 -%}
          <div class="mis-card">
            <div class="mis-card-placeholder"></div>
            <div class="mis-card-overlay">
              <span class="mis-card-tag">{{ demo_tags[idx] }}</span>
              <h3 class="mis-card-title">{{ demo_titles[idx] }}</h3>
            </div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </main>

    {%- if section.settings.show_footer -%}
      <footer class="mis-footer">
        <div>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.footer_brand }}</div>
        <div style="display:flex;gap:1.5rem;">
          {%- if section.settings.footer_link_1_label != blank -%}
            <a href="{{ section.settings.footer_link_1 }}">{{ section.settings.footer_link_1_label }}</a>
          {%- endif -%}
          {%- if section.settings.footer_link_2_label != blank -%}
            <a href="{{ section.settings.footer_link_2 }}">{{ section.settings.footer_link_2_label }}</a>
          {%- endif -%}
        </div>
      </footer>
    {%- endif -%}

  </div>
</section>

<script>
(function() {
  var sec  = document.getElementById('{{ section_id }}');
  if (!sec) return;
  var grid  = sec.querySelector('[data-mis-grid]');
  var pills = sec.querySelectorAll('[data-mis-filters] .mis-pill');
  var cards = sec.querySelectorAll('.mis-card');

  pills.forEach(function(pill) {
    pill.addEventListener('click', function() {
      pills.forEach(function(p) { p.classList.remove('is-active'); });
      pill.classList.add('is-active');
      grid.className = 'mis-bento mode--' + pill.dataset.mode;
      cards.forEach(function(c) {
        c.classList.remove('is-in');
        requestAnimationFrame(function() { c.classList.add('is-in'); });
      });
    });
  });

  var obs = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) { e.target.classList.add('is-in'); obs.unobserve(e.target); }
    });
  }, { threshold: .08 });

  sec.querySelectorAll('.mis-reveal, .mis-card').forEach(function(el) { obs.observe(el); });
})();
</script>

{% schema %}
{
  "name": "Media Showcase",
  "tag": "section",
  "class": "media-showcase-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "interaction_mode",
      "label": "Default layout",
      "options": [
        { "value": "asymmetric", "label": "Asymmetric" },
        { "value": "grid",       "label": "Grid" },
        { "value": "spotlight",  "label": "Spotlight" },
        { "value": "masonry",    "label": "Masonry" }
      ],
      "default": "asymmetric"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width (px)",
      "min": 800, "max": 1800, "step": 40, "default": 1400
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Our Work"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stories that move people"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A curated showcase of projects built at the intersection of craft and strategy."
    },
    {
      "type": "header",
      "content": "Footer"
    },
    {
      "type": "checkbox",
      "id": "show_footer",
      "label": "Show footer",
      "default": true
    },
    {
      "type": "text",
      "id": "footer_brand",
      "label": "Brand name",
      "default": "Design Collective"
    },
    {
      "type": "text",
      "id": "footer_link_1_label",
      "label": "Link 1 label",
      "default": "Instagram"
    },
    {
      "type": "url",
      "id": "footer_link_1",
      "label": "Link 1 URL"
    },
    {
      "type": "text",
      "id": "footer_link_2_label",
      "label": "Link 2 label",
      "default": "LinkedIn"
    },
    {
      "type": "url",
      "id": "footer_link_2",
      "label": "Link 2 URL"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#080808"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#00e5ff"
    }
  ],
  "blocks": [
    {
      "type": "showcase_item",
      "name": "Showcase item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Branding"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Project Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media Showcase",
      "blocks": [
        { "type": "showcase_item", "settings": { "tag": "Branding", "title": "Brand Identity System" } },
        { "type": "showcase_item", "settings": { "tag": "Fashion", "title": "Modern Textile Design" } },
        { "type": "showcase_item", "settings": { "tag": "UX/UI", "title": "Digital Experience" } },
        { "type": "showcase_item", "settings": { "tag": "Strategy", "title": "Growth Framework" } },
        { "type": "showcase_item", "settings": { "tag": "Motion", "title": "Visual Systems" } }
      ]
    }
  ]
}
{% endschema %}
