{% comment %} Account dashboard: orders, addresses link, logout. Theme styling: cards, list same as cart. {% endcomment %}
<section class="relative z-10 py-16 lg:py-24" {{ section.shopify_attributes }}>
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="flex flex-wrap items-center justify-between gap-6 mb-8">
      <div>
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-1">{{ section.settings.heading | default: 'Account' }}</h1>
        <p class="text-white/50">{{ section.settings.subheading | default: 'Manage your orders and account details.' }}</p>
      </div>
      <a href="{{ routes.account_logout_url }}" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-white/20 text-white/70 hover:text-white hover:bg-white/10 transition-colors font-medium text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
        {{ section.settings.logout_label | default: 'Log out' }}
      </a>
    </div>

    <div class="grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-6">
        <h2 class="text-xl font-semibold text-white">{{ section.settings.orders_heading | default: 'Order history' }}</h2>
        {% if customer.orders.size > 0 %}
          <ul class="space-y-4">
            {% for order in customer.orders %}
              <li class="flex flex-wrap items-center gap-4 p-4 rounded-2xl bg-white/[0.02] border border-white/10">
                <div class="flex-1 min-w-0">
                  <a href="{{ order.customer_url }}" class="text-white font-medium hover:underline">{{ section.settings.order_name_label | default: 'Order' }} {{ order.name }}</a>
                  <p class="text-white/40 text-sm mt-0.5">{{ order.created_at | date: format: 'date' }} · {{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</p>
                </div>
                <div class="text-white/60 text-sm">{{ order.total_price | money }}</div>
                <a href="{{ order.customer_url }}" class="px-4 py-2 rounded-full border border-white/20 text-white hover:bg-white/10 transition-colors text-sm font-medium">
                  {{ section.settings.view_order_label | default: 'View' }}
                </a>
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <div class="p-8 rounded-2xl bg-white/[0.02] border border-white/10 text-center">
            <p class="text-white/50 mb-4">{{ section.settings.no_orders | default: "You haven't placed any orders yet." }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-semibold border border-white/20 text-white hover:bg-white/10 transition-colors">{{ section.settings.shop_link | default: 'Continue shopping' }}</a>
          </div>
        {% endif %}
      </div>

      <div class="space-y-6">
        <h2 class="text-xl font-semibold text-white">{{ section.settings.details_heading | default: 'Account details' }}</h2>
        <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/10 space-y-4">
          <p class="text-white font-medium">{{ customer.name }}</p>
          <p class="text-white/60 text-sm">{{ customer.email }}</p>
          <a href="{{ routes.account_addresses_url }}" class="inline-flex items-center gap-2 text-white/70 hover:text-white text-sm font-medium">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/></svg>
            {{ section.settings.addresses_label | default: 'View addresses' }}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer account",
  "tag": "section",
  "class": "section-main-customer-account",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Account" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Manage your orders and account details." },
    { "type": "text", "id": "logout_label", "label": "Log out button", "default": "Log out" },
    { "type": "text", "id": "orders_heading", "label": "Orders heading", "default": "Order history" },
    { "type": "text", "id": "order_name_label", "label": "Order name label", "default": "Order" },
    { "type": "text", "id": "view_order_label", "label": "View order button", "default": "View" },
    { "type": "text", "id": "no_orders", "label": "No orders message", "default": "You haven't placed any orders yet." },
    { "type": "text", "id": "shop_link", "label": "Continue shopping text", "default": "Continue shopping" },
    { "type": "text", "id": "details_heading", "label": "Details heading", "default": "Account details" },
    { "type": "text", "id": "addresses_label", "label": "Addresses link", "default": "View addresses" }
  ],
  "presets": [{ "name": "Customer account" }]
}
{% endschema %}
