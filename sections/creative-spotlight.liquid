{% comment %}
  Section: Creative Spotlight
  Place in: sections/creative-spotlight.liquid
  Use on:  A page template (templates/page.creative-spotlight.json)
           OR add via Theme Editor on any page
{% endcomment %}

{%- assign blog_handle = section.settings.blog -%}
{%- assign current_blog = blogs[blog_handle] -%}
{%- assign active_tag = request.param_value['tag'] | default: '' -%}

<style>
  /* ── Reset & Tokens ───────────────────────────────────────── */
  .cs-section *,
  .cs-section *::before,
  .cs-section *::after { box-sizing: border-box; }

  .cs-section {
    --cs-bg-dark:   #050505;
    --cs-bg-card:   #0b0b0b;
    --cs-border:    rgba(255,255,255,0.08);
    --cs-muted:     #a1a1aa;
    --cs-radius:    28px;
    background-color: var(--cs-bg-dark);
    color: #fff;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    overflow-x: hidden;
    position: relative;
  }

  /* ── Grid overlay ─────────────────────────────────────────── */
  .cs-grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--cs-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--cs-border) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
    opacity: 0.3;
    z-index: 0;
  }

  .cs-wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
    z-index: 1;
  }

  /* ── Pill badge ───────────────────────────────────────────── */
  .cs-pill {
    display: inline-block;
    background: rgba(255,255,255,0.1);
    border: 1px solid var(--cs-border);
    padding: 4px 14px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  /* ── Hero ─────────────────────────────────────────────────── */
  .cs-hero {
    min-height: 52vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6rem 0 4rem;
  }

  .cs-hero .cs-pill { margin-bottom: 1.5rem; opacity: 0.8; }

  .cs-hero h1 {
    font-size: clamp(2.8rem, 8vw, 6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0 0 1.5rem;
  }

  .cs-hero p {
    max-width: 36rem;
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: var(--cs-muted);
    line-height: 1.7;
    margin: 0 auto;
  }

  .cs-divider {
    width: 100%;
    max-width: 56rem;
    height: 1px;
    background: linear-gradient(to right, transparent, #3f3f46, transparent);
    margin: 4rem auto 0;
  }

  /* ── Card base ────────────────────────────────────────────── */
  .cs-card {
    background: var(--cs-bg-card);
    border: 1px solid var(--cs-border);
    border-radius: var(--cs-radius);
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(.165,.84,.44,1),
                border-color 0.4s,
                box-shadow 0.4s;
  }

  .cs-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255,255,255,0.2);
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
  }

  .cs-img-wrap {
    overflow: hidden;
    position: relative;
  }

  .cs-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(.165,.84,.44,1);
  }

  .cs-card:hover .cs-img-wrap img { transform: scale(1.05); }

  .cs-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent, rgba(0,0,0,0.7));
    transition: background 0.4s;
  }

  .cs-card:hover .cs-overlay {
    background: linear-gradient(to bottom, transparent, rgba(0,0,0,0.88));
  }

  /* ── Featured article ─────────────────────────────────────── */
  .cs-featured-wrap { margin: 0 0 5rem; }

  .cs-featured {
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 1024px) {
    .cs-featured { flex-direction: row; height: 500px; }
  }

  .cs-featured-img {
    height: 300px;
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .cs-featured-img { width: 55%; height: 100%; }
  }

  .cs-featured-body {
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media (min-width: 768px) { .cs-featured-body { padding: 3rem; } }

  .cs-featured-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #71717a;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 1rem;
  }

  .cs-featured-label span.dot {
    width: 8px; height: 8px;
    background: #fff;
    border-radius: 50%;
    display: inline-block;
  }

  .cs-featured-body h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 1.25rem;
  }

  .cs-featured-body p {
    color: var(--cs-muted);
    line-height: 1.7;
    margin: 0 0 1.5rem;
  }

  .cs-meta {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #71717a;
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .cs-read-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: #fff;
    text-decoration: none;
    border-bottom: 1px solid #3f3f46;
    padding-bottom: 2px;
    transition: border-color 0.3s;
    display: inline-block;
  }

  .cs-read-link:hover { border-color: #fff; }

  /* ── Filter chips ─────────────────────────────────────────── */
  .cs-filters-wrap {
    overflow-x: auto;
    -ms-overflow-style: none;
    scrollbar-width: none;
    margin-bottom: 3rem;
    padding: 0.5rem 0;
  }

  .cs-filters-wrap::-webkit-scrollbar { display: none; }

  .cs-filters {
    display: flex;
    gap: 0.75rem;
    min-width: max-content;
  }

  .cs-chip {
    padding: 8px 20px;
    border-radius: 999px;
    background: transparent;
    border: 1px solid var(--cs-border);
    white-space: nowrap;
    font-weight: 500;
    font-size: 0.85rem;
    color: var(--cs-muted);
    cursor: pointer;
    text-decoration: none;
    transition: border-color 0.3s, color 0.3s, background 0.3s, box-shadow 0.3s;
    display: inline-block;
  }

  .cs-chip:hover { border-color: rgba(255,255,255,0.4); color: #fff; }

  .cs-chip.active {
    background: #fff;
    color: #000;
    border-color: #fff;
    box-shadow: 0 0 15px rgba(255,255,255,0.25);
  }

  /* ── Articles grid ────────────────────────────────────────── */
  .cs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 5rem;
  }

  @media (min-width: 768px)  { .cs-grid { grid-template-columns: repeat(2,1fr); } }
  @media (min-width: 1024px) { .cs-grid { grid-template-columns: repeat(3,1fr); } }

  .cs-article-img {
    aspect-ratio: 4 / 3;
  }

  .cs-tag-pill {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .cs-article-body { padding: 1.5rem; }

  .cs-article-body h3 {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 0.75rem;
  }

  .cs-article-body p {
    font-size: 0.875rem;
    color: var(--cs-muted);
    line-height: 1.6;
    margin: 0 0 1.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cs-article-meta {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #52525b;
    display: flex;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  /* ── Newsletter ───────────────────────────────────────────── */
  .cs-newsletter {
    margin-bottom: 5rem;
  }

  .cs-newsletter .cs-card {
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    background: rgba(9,9,11,0.5);
    backdrop-filter: blur(20px);
  }

  @media (min-width: 768px) {
    .cs-newsletter .cs-card {
      flex-direction: row;
      justify-content: space-between;
      padding: 4rem;
    }
  }

  .cs-newsletter-text { max-width: 28rem; }

  .cs-newsletter-text h2 {
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    font-weight: 700;
    margin: 0 0 0.75rem;
  }

  .cs-newsletter-text p { color: var(--cs-muted); margin: 0; }

  .cs-newsletter-form {
    display: flex;
    gap: 0.75rem;
    width: 100%;
  }

  @media (min-width: 768px) { .cs-newsletter-form { width: auto; } }

  .cs-newsletter-form input[type="email"] {
    flex: 1;
    min-width: 0;
    padding: 1rem 1.5rem;
    border-radius: 999px;
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--cs-border);
    color: #fff;
    font-size: 0.875rem;
    outline: none;
    transition: border-color 0.3s;
  }

  @media (min-width: 768px) { .cs-newsletter-form input[type="email"] { width: 16rem; } }

  .cs-newsletter-form input[type="email"]:focus { border-color: rgba(255,255,255,0.3); }
  .cs-newsletter-form input[type="email"]::placeholder { color: #52525b; }

  .cs-newsletter-form button {
    padding: 1rem 2rem;
    border-radius: 999px;
    background: #fff;
    color: #000;
    font-weight: 700;
    font-size: 0.875rem;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.3s;
  }

  .cs-newsletter-form button:hover { background: #e4e4e7; }

  /* ── Pagination ───────────────────────────────────────────── */
  .cs-pagination {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 4rem;
  }

  .cs-pagination a,
  .cs-pagination span {
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--cs-border);
    font-size: 0.85rem;
    color: var(--cs-muted);
    text-decoration: none;
    transition: all 0.3s;
  }

  .cs-pagination a:hover { color: #fff; border-color: rgba(255,255,255,0.4); }
  .cs-pagination span.current { background: #fff; color: #000; border-color: #fff; }

  /* ── No-articles message ──────────────────────────────────── */
  .cs-empty {
    text-align: center;
    padding: 5rem 0;
    color: var(--cs-muted);
  }
</style>

<div class="cs-section">
  <div class="cs-grid-overlay"></div>

  <!-- ── Hero ─────────────────────────────────────────────── -->
  <div class="cs-wrap">
    <div class="cs-hero">
      <span class="cs-pill">{{ section.settings.hero_pill | default: '(CREATIVE SPOTLIGHT)' }}</span>
      <h1>{{ section.settings.hero_heading | default: 'Creative Spotlight' }}</h1>
      <p>{{ section.settings.hero_subheading | default: 'Highlighting the incredible talents of artists, innovators, and creators—stories, processes, and ideas behind exceptional work.' }}</p>
      <div class="cs-divider"></div>
    </div>
  </div>

  <div class="cs-wrap">

    {% if current_blog != blank %}

      {%- assign all_articles = current_blog.articles -%}

      {%- comment -%} Collect unique tags {%- endcomment -%}
      {%- assign all_tags = '' -%}
      {% for article in all_articles %}
        {% for tag in article.tags %}
          {%- assign all_tags = all_tags | append: tag | append: '|' -%}
        {% endfor %}
      {% endfor %}
      {%- assign tag_list = all_tags | split: '|' | uniq | sort -%}
      {%- assign tag_list = tag_list | where: 'size', '> 0' -%}

      {%- comment -%} Filter articles by tag if active {%- endcomment -%}
      {% if active_tag != '' %}
        {%- assign filtered_articles = current_blog.articles | where: 'tags', active_tag -%}
      {% else %}
        {%- assign filtered_articles = current_blog.articles -%}
      {% endif %}

      {%- assign limit = section.settings.articles_per_page | default: 6 -%}
      {%- assign featured_article = filtered_articles.first -%}

      <!-- ── Featured Article ─────────────────────────────── -->
      {% if section.settings.show_featured and featured_article != blank %}
        <div class="cs-featured-wrap">
          <div class="cs-card cs-featured">
            <div class="cs-img-wrap cs-featured-img">
              {% if featured_article.image %}
                <img
                  src="{{ featured_article.image | img_url: '1200x' }}"
                  alt="{{ featured_article.image.alt | escape }}"
                  loading="eager"
                  width="1200"
                  height="800">
              {% else %}
                <img
                  src="{{ 'collection-1' | placeholder_svg_tag }}"
                  alt="{{ featured_article.title | escape }}"
                  loading="eager">
              {% endif %}
              <div class="cs-overlay"></div>
            </div>
            <div class="cs-featured-body">
              <p class="cs-featured-label">
                <span class="dot"></span> FEATURED
              </p>
              <h2>{{ featured_article.title }}</h2>
              <p>{{ featured_article.excerpt | strip_html | truncate: 160 }}</p>
              <div class="cs-meta">
                <span>{{ featured_article.published_at | date: '%b %d, %Y' | upcase }}</span>
                <span>{{ featured_article.content | strip_html | split: ' ' | size | divided_by: 200 | plus: 1 }} MIN READ</span>
              </div>
              <a href="{{ featured_article.url }}" class="cs-read-link">Read Article &rarr;</a>
            </div>
          </div>
        </div>
      {% endif %}

      <!-- ── Filter Chips ─────────────────────────────────── -->
      {% if tag_list.size > 0 and section.settings.show_filters %}
        <div class="cs-filters-wrap">
          <div class="cs-filters">
            <a
              href="{{ current_blog.url }}"
              class="cs-chip{% if active_tag == '' %} active{% endif %}">
              All
            </a>
            {% for tag in tag_list %}
              {% unless tag == '' %}
                <a
                  href="{{ current_blog.url }}/tagged/{{ tag | handleize }}"
                  class="cs-chip{% if active_tag == tag %} active{% endif %}">
                  {{ tag }}
                </a>
              {% endunless %}
            {% endfor %}
          </div>
        </div>
      {% endif %}

      <!-- ── Articles Grid ────────────────────────────────── -->
      {%- assign grid_articles = filtered_articles -%}
      {%- if section.settings.show_featured -%}
        {%- assign grid_articles = filtered_articles | where: 'id', '!= ' | shift -%}
        {%- comment -%}
          Liquid doesn't have shift, so we'll slice from index 1
        {%- endcomment -%}
      {%- endif -%}

      {% paginate current_blog.articles by limit %}

        <div class="cs-grid">
          {% assign start_index = 0 %}
          {% if section.settings.show_featured %}
            {% assign start_index = 1 %}
          {% endif %}

          {% for article in current_blog.articles %}
            {% unless forloop.index0 == 0 and section.settings.show_featured %}
              <article class="cs-card">
                <div class="cs-img-wrap cs-article-img">
                  {% if article.image %}
                    <img
                      src="{{ article.image | img_url: '600x' }}"
                      alt="{{ article.image.alt | escape }}"
                      loading="lazy"
                      width="600"
                      height="450">
                  {% else %}
                    <img
                      src="{{ 'image' | placeholder_svg_tag }}"
                      alt="{{ article.title | escape }}"
                      loading="lazy">
                  {% endif %}
                  <div class="cs-overlay"></div>
                  {% if article.tags.first %}
                    <span class="cs-pill cs-tag-pill">{{ article.tags.first }}</span>
                  {% endif %}
                </div>
                <div class="cs-article-body">
                  <h3>{{ article.title }}</h3>
                  <p>{{ article.excerpt | strip_html | truncate: 120 }}</p>
                  <div class="cs-article-meta">
                    <span>{{ article.published_at | date: '%b %d, %Y' | upcase }}</span>
                    <span>{{ article.content | strip_html | split: ' ' | size | divided_by: 200 | plus: 1 }} MIN READ</span>
                  </div>
                  <a href="{{ article.url }}" class="cs-read-link" style="font-size:0.75rem;">Read more &rarr;</a>
                </div>
              </article>
            {% endunless %}
          {% else %}
            <div class="cs-empty" style="grid-column: 1/-1;">
              <p>No articles found{% if active_tag != '' %} for "{{ active_tag }}"{% endif %}.</p>
            </div>
          {% endfor %}
        </div>

        <!-- ── Pagination ───────────────────────────────── -->
        {% if paginate.pages > 1 %}
          <div class="cs-pagination">
            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}">&larr; Prev</a>
            {% endif %}
            {% for part in paginate.parts %}
              {% if part.is_link %}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {% else %}
                <span class="current">{{ part.title }}</span>
              {% endif %}
            {% endfor %}
            {% if paginate.next %}
              <a href="{{ paginate.next.url }}">Next &rarr;</a>
            {% endif %}
          </div>
        {% endif %}

      {% endpaginate %}

    {% else %}
      <!-- No blog selected in theme editor -->
      <div class="cs-empty">
        <p>Select a blog in the Theme Editor to display articles here.</p>
      </div>
    {% endif %}

    <!-- ── Newsletter ───────────────────────────────────── -->
    {% if section.settings.show_newsletter %}
      <div class="cs-newsletter">
        <div class="cs-card">
          <div class="cs-newsletter-text">
            <h2>{{ section.settings.newsletter_heading | default: 'Stay Inspired.' }}</h2>
            <p>{{ section.settings.newsletter_subheading | default: 'Get Creative Spotlight updates weekly. The best of design, art, and innovation, curated for your inbox.' }}</p>
          </div>
          {% form 'customer', class: 'cs-newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter,creative-spotlight">
            <input
              type="email"
              name="contact[email]"
              placeholder="{{ section.settings.newsletter_placeholder | default: 'email@address.com' }}"
              autocomplete="email"
              required>
            <button type="submit">
              {{ section.settings.newsletter_cta | default: 'Subscribe' }}
            </button>
            {% if form.posted_successfully? %}
              <p style="color:#4ade80;margin:0.5rem 0 0;font-size:0.85rem;">✓ You're subscribed!</p>
            {% endif %}
          {% endform %}
        </div>
      </div>
    {% endif %}

  </div><!-- /cs-wrap -->
</div><!-- /cs-section -->

{% schema %}
{
  "name": "Creative Spotlight",
  "tag": "section",
  "class": "cs-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "hero_pill",
      "label": "Pill label",
      "default": "(CREATIVE SPOTLIGHT)"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Heading",
      "default": "Creative Spotlight"
    },
    {
      "type": "textarea",
      "id": "hero_subheading",
      "label": "Subheading",
      "default": "Highlighting the incredible talents of artists, innovators, and creators—stories, processes, and ideas behind exceptional work."
    },
    {
      "type": "header",
      "content": "Blog"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog to display"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 6
    },
    {
      "type": "header",
      "content": "Featured Article"
    },
    {
      "type": "checkbox",
      "id": "show_featured",
      "label": "Show featured article (latest post)",
      "default": true
    },
    {
      "type": "header",
      "content": "Filter Chips"
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show tag filters",
      "default": true
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter section",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Stay Inspired."
    },
    {
      "type": "textarea",
      "id": "newsletter_subheading",
      "label": "Newsletter subheading",
      "default": "Get Creative Spotlight updates weekly. The best of design, art, and innovation, curated for your inbox."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email placeholder",
      "default": "email@address.com"
    },
    {
      "type": "text",
      "id": "newsletter_cta",
      "label": "Button label",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "Creative Spotlight"
    }
  ]
}
{% endschema %}
