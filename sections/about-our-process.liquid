{% comment %} About Our Process: header, left column = numbered steps with icon/title/description and vertical connector, right column = image with overlay. {% endcomment %}
{% assign step_blocks = section.blocks | where: 'type', 'step' %}
<section class="relative py-24 lg:py-32 bg-black">
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  <div class="max-w-[1200px] mx-auto px-6 lg:px-12 relative z-10">
    <div class="text-center mb-16">
      {% if section.settings.badge != blank %}
        <span class="text-[10px] font-medium text-white/40 tracking-[0.3em] uppercase block mb-4">{{ section.settings.badge }}</span>
      {% endif %}
      {% if section.settings.title_before != blank or section.settings.title_gradient != blank %}
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
          {{ section.settings.title_before }}
          {% if section.settings.title_gradient != blank %}
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400">{{ section.settings.title_gradient }}</span>
          {% endif %}
        </h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <p class="text-white/50 max-w-xl mx-auto">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="grid lg:grid-cols-2 gap-12">
      <div>
        {% for block in step_blocks %}
          <div class="relative flex gap-6" {{ block.shopify_attributes }}>
            <div class="flex flex-col items-center">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-white to-gray-400 flex items-center justify-center text-black font-bold text-xl flex-shrink-0">{{ forloop.index }}</div>
              {% unless forloop.last %}
                <div class="w-px flex-1 min-h-[4rem] bg-gradient-to-b from-white/50 to-transparent my-4" aria-hidden="true"></div>
              {% endunless %}
            </div>
            <div class="pb-12 min-w-0">
              <div class="flex items-center gap-3 mb-2">
                {% case block.settings.icon %}
                  {% when 'target' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-white/60 flex-shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
                  {% when 'layers' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-white/60 flex-shrink-0" aria-hidden="true"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path></svg>
                  {% when 'sparkles' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-white/60 flex-shrink-0" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg>
                  {% when 'trending_up' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-white/60 flex-shrink-0" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
                  {% else %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-white/60 flex-shrink-0"><circle cx="12" cy="12" r="10"></circle></svg>
                {% endcase %}
                {% if block.settings.title != blank %}
                  <h4 class="text-xl font-bold text-white">{{ block.settings.title }}</h4>
                {% endif %}
              </div>
              {% if block.settings.description != blank %}
                <p class="text-white/50 leading-relaxed">{{ block.settings.description }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="relative rounded-3xl overflow-hidden h-[500px] lg:h-auto lg:min-h-[400px]">
        <div class="absolute inset-0 bg-gradient-to-br from-white/10 to-gray-500/10" aria-hidden="true"></div>
        {% if section.settings.image != blank %}
          <img alt="{{ section.settings.image.alt | default: 'Process' | escape }}" class="w-full h-full object-cover grayscale" src="{{ section.settings.image | image_url: width: 800 }}" width="800" height="500" loading="lazy">
        {% else %}
          <div class="w-full h-full bg-white/5 flex items-center justify-center">
            <span class="text-white/30 text-sm">Image</span>
          </div>
        {% endif %}
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent" aria-hidden="true"></div>
        <div class="absolute bottom-8 left-8 right-8">
          {% if section.settings.overlay_number != blank %}
            <div class="text-5xl font-black text-white mb-2">{{ section.settings.overlay_number }}</div>
          {% endif %}
          {% if section.settings.overlay_text != blank %}
            <div class="text-white/50">{{ section.settings.overlay_text }}</div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Our Process",
  "tag": "section",
  "class": "section-about-our-process",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge (small label above title)",
      "default": "(Our Process)"
    },
    {
      "type": "text",
      "id": "title_before",
      "label": "Title (before gradient word)",
      "default": "How We "
    },
    {
      "type": "text",
      "id": "title_gradient",
      "label": "Title (gradient word)",
      "default": "Deliver"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "A proven methodology that transforms ideas into impactful results."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right column image"
    },
    {
      "type": "text",
      "id": "overlay_number",
      "label": "Overlay number (on image)",
      "default": "4"
    },
    {
      "type": "text",
      "id": "overlay_text",
      "label": "Overlay text (on image)",
      "default": "Step process to success"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "target", "label": "Target" },
            { "value": "layers", "label": "Layers" },
            { "value": "sparkles", "label": "Sparkles" },
            { "value": "trending_up", "label": "Trending up" }
          ],
          "default": "target"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step title",
          "default": "Discovery"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "We dive deep into your brand, audience, and goals to understand exactly what success looks like for you."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Our Process",
      "settings": {
        "badge": "(Our Process)",
        "title_before": "How We ",
        "title_gradient": "Deliver",
        "subtitle": "A proven methodology that transforms ideas into impactful results.",
        "overlay_number": "4",
        "overlay_text": "Step process to success"
      },
      "blocks": [
        { "type": "step", "settings": { "icon": "target", "title": "Discovery", "description": "We dive deep into your brand, audience, and goals to understand exactly what success looks like for you." } },
        { "type": "step", "settings": { "icon": "layers", "title": "Strategy", "description": "Our team crafts a custom roadmap combining creative vision with data-driven tactics." } },
        { "type": "step", "settings": { "icon": "sparkles", "title": "Creation", "description": "We bring your vision to life with stunning visuals, compelling content, and seamless experiences." } },
        { "type": "step", "settings": { "icon": "trending_up", "title": "Launch & Iterate", "description": "We deploy, measure, and continuously optimize to maximize your ROI." } }
      ]
    }
  ]
}
{% endschema %}
