{% comment %} Social Proof: badge + heading, stats row (icon + value + label), testimonial carousel (quote, author, stars, prev/dots/next). {% endcomment %}
{% assign stat_blocks = section.blocks | where: 'type', 'stat' %}
{% assign testimonial_blocks = section.blocks | where: 'type', 'testimonial' %}
<section class="relative py-24 lg:py-32 bg-black" {{ section.shopify_attributes }}>
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  <div class="max-w-[1200px] mx-auto px-6 lg:px-12">
    <div class="text-center mb-12">
      {% if section.settings.badge != blank %}
        <span class="text-[10px] font-medium text-white/40 tracking-[0.3em] uppercase block mb-4">{{ section.settings.badge }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-8">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if stat_blocks.size > 0 %}
        <div class="flex flex-wrap justify-center gap-8 mb-12">
          {% for block in stat_blocks %}
            <div class="text-center" {{ block.shopify_attributes }}>
              <div class="flex items-center justify-center gap-2 mb-2">
                {% case block.settings.icon %}
                  {% when 'users' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/40" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg>
                  {% when 'download' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/40" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg>
                  {% when 'trending_up' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/40" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
                  {% else %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/40" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg>
                {% endcase %}
                <span class="text-2xl font-bold text-white">{{ block.settings.value | default: '—' }}</span>
              </div>
              {% if block.settings.label != blank %}
                <div class="text-white/40 text-sm">{{ block.settings.label }}</div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% if testimonial_blocks.size > 0 %}
      <div class="relative" data-social-proof-carousel="{{ section.id }}">
        <div class="max-w-3xl mx-auto">
          {% for block in testimonial_blocks %}
            <div class="social-proof-slide text-center {% unless forloop.first %}hidden{% endunless %}" data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-quote w-10 h-10 text-white/20 mx-auto mb-6" aria-hidden="true"><path d="M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"></path><path d="M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"></path></svg>
              {% if block.settings.quote != blank %}
                <p class="text-xl md:text-2xl text-white/90 font-medium leading-relaxed mb-8">"{{ block.settings.quote }}"</p>
              {% endif %}
              <div class="flex items-center justify-center gap-4">
                {% if block.settings.image != blank %}
                  <img alt="{{ block.settings.author_name | default: 'Author' | escape }}" class="w-12 h-12 rounded-full object-cover border-2 border-white/10" src="{{ block.settings.image | image_url: width: 100 }}" width="48" height="48" loading="lazy">
                {% else %}
                  <div class="w-12 h-12 rounded-full bg-white/10 border-2 border-white/10 flex items-center justify-center text-white/40 text-sm" aria-hidden="true">?</div>
                {% endif %}
                <div class="text-left">
                  {% if block.settings.author_name != blank %}
                    <div class="font-semibold text-white">{{ block.settings.author_name }}</div>
                  {% endif %}
                  {% if block.settings.author_title != blank %}
                    <div class="text-white/50 text-sm">{{ block.settings.author_title }}</div>
                  {% endif %}
                </div>
              </div>
              {% assign stars = block.settings.rating | default: 5 | at_most: 5 | at_least: 0 %}
              <div class="flex justify-center gap-1 mt-4" aria-label="Rating: {{ stars }} out of 5 stars">
                {% for i in (1..5) %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 {% if i <= stars %}text-amber-400 fill-amber-400{% else %}text-white/20{% endif %}" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path></svg>
                {% endfor %}
              </div>
            </div>
          {% endfor %}

          <div class="flex justify-center gap-4 mt-8">
            <button type="button" class="social-proof-prev w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-white/50 hover:bg-white/10 hover:text-white transition-colors" aria-label="Previous testimonial">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
            </button>
            <div class="flex items-center gap-2">
              {% for block in testimonial_blocks %}
                <button type="button" class="social-proof-dot h-2 rounded-full transition-all hover:bg-white/50 {% if forloop.first %}w-6 bg-white{% else %}w-2 bg-white/30{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Go to testimonial {{ forloop.index }}" {% if forloop.first %}aria-current="true"{% endif %}></button>
              {% endfor %}
            </div>
            <button type="button" class="social-proof-next w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-white/50 hover:bg-white/10 hover:text-white transition-colors" aria-label="Next testimonial">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
            </button>
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</section>

<script>
(function() {
  var section = document.querySelector('[data-social-proof-carousel="{{ section.id }}"]');
  if (!section) return;
  var slides = section.querySelectorAll('.social-proof-slide');
  var dots = section.querySelectorAll('.social-proof-dot');
  var prevBtn = section.querySelector('.social-proof-prev');
  var nextBtn = section.querySelector('.social-proof-next');
  if (slides.length === 0) return;
  var current = 0;
  function goTo(i) {
    current = (i + slides.length) % slides.length;
    slides.forEach(function(s, idx) {
      s.classList.toggle('hidden', idx !== current);
    });
    dots.forEach(function(d, idx) {
      if (idx === current) {
        d.classList.remove('bg-white/30', 'w-2');
        d.classList.add('bg-white', 'w-6');
      } else {
        d.classList.remove('bg-white', 'w-6');
        d.classList.add('bg-white/30', 'w-2');
      }
      d.setAttribute('aria-current', idx === current ? 'true' : 'false');
    });
  }
  if (prevBtn) prevBtn.addEventListener('click', function() { goTo(current - 1); });
  if (nextBtn) nextBtn.addEventListener('click', function() { goTo(current + 1); });
  dots.forEach(function(dot, idx) {
    dot.addEventListener('click', function() { goTo(idx); });
  });
  goTo(0);
})();
</script>

{% schema %}
{
  "name": "Social Proof",
  "tag": "section",
  "class": "section-social-proof",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "(Social Proof)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Members Say"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "users", "label": "Users" },
            { "value": "download", "label": "Download" },
            { "value": "trending_up", "label": "Trending up" }
          ],
          "default": "users"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "2847+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Happy Customers"
        }
      ]
    },
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Absolutely incredible quality. We've tried many solutions but nothing comes close to this level of polish."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Author image"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author name",
          "default": "Michael Torres"
        },
        {
          "type": "text",
          "id": "author_title",
          "label": "Author title / company",
          "default": "Marketing Director, GrowthCo"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social Proof",
      "blocks": [
        { "type": "stat", "settings": { "icon": "users", "value": "2847+", "label": "Happy Customers" } },
        { "type": "stat", "settings": { "icon": "download", "value": "15234+", "label": "Downloads" } },
        { "type": "stat", "settings": { "icon": "trending_up", "value": "98%", "label": "Satisfaction Rate" } },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Absolutely incredible quality. We've tried many solutions but nothing comes close to this level of polish.",
            "author_name": "Michael Torres",
            "author_title": "Marketing Director, GrowthCo",
            "rating": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}
