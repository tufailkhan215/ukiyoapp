{%- comment -%}
  ============================================================
  UKIYO — SELECTED WORK / EDITORIAL 2.0
  ============================================================

  SAVE AS:
  sections/ukiyo-selected-work.liquid

  Desktop:
  - Oversized editorial intro
  - Alternating cinematic featured projects
  - Huge project numerals
  - Split-screen media / narrative
  - Scroll reveal + restrained parallax
  - Large impact statistics
  - More-work visual grid
  - Premium closing CTA

  Mobile:
  - Purpose-built vertical composition
  - Strong image-first storytelling
  - Compact metadata
  - Full-width touch CTAs
  - Swipeable secondary projects

  Shopify:
  - Native section
  - Local case-study blocks
  - Image or native Shopify video
  - No unsupported schema attributes
{%- endcomment -%}


{%- liquid
  assign uid = section.id | replace: '_', '' | replace: '-', '' | downcase

  assign project_count = 0
  assign featured_count = 0
  assign compact_count = 0

  for block in section.blocks
    if block.type == 'case_study'
      assign project_count = project_count | plus: 1

      if block.settings.layout == 'featured'
        assign featured_count = featured_count | plus: 1
      else
        assign compact_count = compact_count | plus: 1
      endif
    endif
  endfor

  assign giant_word = section.settings.background_word

  if giant_word == blank
    assign giant_word = 'WORK'
  endif
-%}


<section
  id="UkiyoWork-{{ uid }}"
  class="uw2 uw2--{{ uid }}"
  data-uw2-root
  style="
    --uw2-bg: {{ section.settings.background_color }};
    --uw2-surface: {{ section.settings.surface_color }};
    --uw2-ink: {{ section.settings.text_color }};
    --uw2-muted: {{ section.settings.muted_color }};
    --uw2-line: {{ section.settings.line_color }};
    --uw2-accent: {{ section.settings.accent_color }};
    --uw2-overlay: {{ section.settings.image_overlay | divided_by: 100.0 }};
    --uw2-radius: {{ section.settings.card_radius }}px;
    --uw2-top: {{ section.settings.padding_top }}px;
    --uw2-bottom: {{ section.settings.padding_bottom }}px;
  "
>

  <div
    class="uw2__noise"
    aria-hidden="true"
  ></div>


  <div
    class="uw2__giant"
    aria-hidden="true"
  >
    {{ giant_word }}
  </div>


  <div class="uw2__shell">

    {%- comment -%}
      ============================================================
      INTRO
      ============================================================
    {%- endcomment -%}

    <header class="uw2__intro">

      <div class="uw2__intro-top">

        <p class="uw2__eyebrow">

          <span aria-hidden="true"></span>

          {{ section.settings.strap }}

        </p>


        <div class="uw2__count">

          <span>
            {{ project_count | prepend: '0' | slice: -2, 2 }}
          </span>

          <small>
            Selected<br>Projects
          </small>

        </div>

      </div>


      <div class="uw2__intro-grid">

        <h2 class="uw2__heading">

          <span>
            {{ section.settings.title_line1 }}
          </span>

          <em>
            {{ section.settings.title_line2 }}
          </em>

        </h2>


        <div class="uw2__intro-copy">

          {%- if section.settings.intro != blank -%}

            <p>
              {{ section.settings.intro }}
            </p>

          {%- endif -%}


          <div class="uw2__intro-meta">

            <span>
              Brand
            </span>

            <span>
              Digital
            </span>

            <span>
              Growth
            </span>

            <span>
              Technology
            </span>

          </div>


          {%- if section.settings.view_all_text != blank and section.settings.view_all_url != blank -%}

            <a
              class="uw2__arrow-link"
              href="{{ section.settings.view_all_url }}"
            >

              <span>
                {{ section.settings.view_all_text }}
              </span>

              <span class="uw2__arrow-circle">

                <svg
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 19 19 5"/>
                  <path d="M9 5h10v10"/>
                </svg>

              </span>

            </a>

          {%- endif -%}

        </div>

      </div>

    </header>



    {%- comment -%}
      ============================================================
      FEATURED CASE STUDIES
      ============================================================
    {%- endcomment -%}

    {%- if featured_count > 0 -%}

      <div class="uw2__featured">

        {%- assign featured_index = 0 -%}

        {%- for block in section.blocks -%}

          {%- if block.type == 'case_study' and block.settings.layout == 'featured' -%}

            {%- assign featured_index = featured_index | plus: 1 -%}

            {%- assign project_num = featured_index | prepend: '0' | slice: -2, 2 -%}

            {%- assign even = featured_index | modulo: 2 -%}

            {%- assign project_link = block.settings.link -%}

            {%- if project_link == blank -%}
              {%- assign project_link = section.settings.view_all_url -%}
            {%- endif -%}


            <article
              class="
                uw2__feature
                {% if even == 0 %}
                  uw2__feature--reverse
                {% endif %}
              "
              data-uw2-reveal
              {{ block.shopify_attributes }}
            >

              <a
                class="uw2__feature-link"
                href="{{ project_link | default: '#' }}"
              >

                <div class="uw2__feature-media">

                  <div
                    class="uw2__feature-media-inner"
                    data-uw2-parallax
                  >

                    {%- if block.settings.video != blank -%}

                      {{
                        block.settings.video
                        | video_tag:
                          autoplay: true,
                          loop: true,
                          muted: true,
                          controls: false,
                          playsinline: true,
                          preload: 'metadata',
                          class: 'uw2__feature-image'
                      }}


                    {%- elsif block.settings.image != blank -%}

                      <img
                        class="uw2__feature-image"
                        src="{{ block.settings.image | image_url: width: 1800 }}"
                        srcset="
                          {{ block.settings.image | image_url: width: 700 }} 700w,
                          {{ block.settings.image | image_url: width: 1100 }} 1100w,
                          {{ block.settings.image | image_url: width: 1500 }} 1500w,
                          {{ block.settings.image | image_url: width: 1800 }} 1800w
                        "
                        sizes="(max-width: 899px) 100vw, 63vw"
                        width="{{ block.settings.image.width }}"
                        height="{{ block.settings.image.height }}"
                        alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                        loading="lazy"
                      >


                    {%- else -%}

                      <div class="uw2__feature-placeholder">

                        <span>
                          {{ project_num }}
                        </span>

                        <small>
                          Add project image or video
                        </small>

                      </div>

                    {%- endif -%}


                    <span
                      class="uw2__feature-wash"
                      aria-hidden="true"
                    ></span>


                    <div
                      class="uw2__feature-index"
                      aria-hidden="true"
                    >

                      <span>
                        {{ project_num }}
                      </span>

                      <small>
                        / {{ featured_count | prepend: '0' | slice: -2, 2 }}
                      </small>

                    </div>


                    <div
                      class="uw2__feature-cursor"
                      aria-hidden="true"
                    >

                      <span>
                        View
                      </span>

                      <svg
                        viewBox="0 0 24 24"
                        width="18"
                        height="18"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M5 19 19 5"/>
                        <path d="M9 5h10v10"/>
                      </svg>

                    </div>

                  </div>

                </div>



                <div class="uw2__feature-info">

                  <div class="uw2__feature-top">

                    <div>

                      {%- if block.settings.category != blank -%}

                        <span class="uw2__category">
                          {{ block.settings.category }}
                        </span>

                      {%- endif -%}


                      {%- if block.settings.client != blank -%}

                        <p class="uw2__client">
                          {{ block.settings.client }}
                        </p>

                      {%- endif -%}

                    </div>


                    {%- if block.settings.year != blank -%}

                      <span class="uw2__year">
                        {{ block.settings.year }}
                      </span>

                    {%- endif -%}

                  </div>



                  <div class="uw2__feature-middle">

                    <h3 class="uw2__feature-title">
                      {{ block.settings.title }}
                    </h3>


                    {%- if block.settings.description != blank -%}

                      <p class="uw2__feature-description">
                        {{ block.settings.description }}
                      </p>

                    {%- endif -%}


                    {%- if block.settings.services != blank -%}

                      <div class="uw2__services">

                        <span>
                          Scope
                        </span>

                        <p>
                          {{ block.settings.services }}
                        </p>

                      </div>

                    {%- endif -%}

                  </div>



                  <div class="uw2__feature-bottom">

                    {%- if block.settings.result_1 != blank or block.settings.result_2 != blank or block.settings.result_3 != blank -%}

                      <div class="uw2__metrics">

                        {%- if block.settings.result_1 != blank -%}

                          <div class="uw2__metric">

                            <strong>
                              {{ block.settings.result_1 }}
                            </strong>

                          </div>

                        {%- endif -%}


                        {%- if block.settings.result_2 != blank -%}

                          <div class="uw2__metric">

                            <strong>
                              {{ block.settings.result_2 }}
                            </strong>

                          </div>

                        {%- endif -%}


                        {%- if block.settings.result_3 != blank -%}

                          <div class="uw2__metric">

                            <strong>
                              {{ block.settings.result_3 }}
                            </strong>

                          </div>

                        {%- endif -%}

                      </div>

                    {%- endif -%}


                    <span class="uw2__case-link">

                      <span>
                        {{ block.settings.cta_text | default: 'View case study' }}
                      </span>

                      <svg
                        viewBox="0 0 24 24"
                        width="18"
                        height="18"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M5 12h14"/>
                        <path d="m13 6 6 6-6 6"/>
                      </svg>

                    </span>

                  </div>

                </div>

              </a>

            </article>

          {%- endif -%}

        {%- endfor -%}

      </div>

    {%- endif -%}



    {%- comment -%}
      ============================================================
      MORE SELECTED WORK
      ============================================================
    {%- endcomment -%}

    {%- if compact_count > 0 -%}

      <section class="uw2__more">

        <header class="uw2__more-heading">

          <div>

            <span>
              03
            </span>

            <p>
              {{ section.settings.compact_label }}
            </p>

          </div>


          <span class="uw2__more-direction">
            Explore →
          </span>

        </header>


        <div class="uw2__compact-grid">

          {%- assign compact_index = 0 -%}

          {%- for block in section.blocks -%}

            {%- if block.type == 'case_study' and block.settings.layout == 'compact' -%}

              {%- assign compact_index = compact_index | plus: 1 -%}

              {%- assign compact_num = compact_index | prepend: '0' | slice: -2, 2 -%}


              {%- assign project_link = block.settings.link -%}

              {%- if project_link == blank -%}
                {%- assign project_link = section.settings.view_all_url -%}
              {%- endif -%}


              <article
                class="uw2__compact"
                data-uw2-reveal
                {{ block.shopify_attributes }}
              >

                <a
                  href="{{ project_link | default: '#' }}"
                  class="uw2__compact-link"
                >

                  <div class="uw2__compact-media">

                    {%- if block.settings.video != blank -%}

                      {{
                        block.settings.video
                        | video_tag:
                          autoplay: true,
                          loop: true,
                          muted: true,
                          controls: false,
                          playsinline: true,
                          preload: 'metadata',
                          class: 'uw2__compact-image'
                      }}


                    {%- elsif block.settings.image != blank -%}

                      <img
                        class="uw2__compact-image"
                        src="{{ block.settings.image | image_url: width: 1200 }}"
                        srcset="
                          {{ block.settings.image | image_url: width: 500 }} 500w,
                          {{ block.settings.image | image_url: width: 800 }} 800w,
                          {{ block.settings.image | image_url: width: 1200 }} 1200w
                        "
                        sizes="(max-width: 749px) 82vw, 50vw"
                        width="{{ block.settings.image.width }}"
                        height="{{ block.settings.image.height }}"
                        alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                        loading="lazy"
                      >


                    {%- else -%}

                      <div class="uw2__compact-placeholder">

                        <span>
                          {{ compact_num }}
                        </span>

                      </div>

                    {%- endif -%}


                    <span
                      class="uw2__compact-wash"
                      aria-hidden="true"
                    ></span>


                    <div class="uw2__compact-top">

                      <span>
                        {{ compact_num }}
                      </span>


                      <span class="uw2__compact-arrow">

                        <svg
                          viewBox="0 0 24 24"
                          width="18"
                          height="18"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M5 19 19 5"/>
                          <path d="M9 5h10v10"/>
                        </svg>

                      </span>

                    </div>

                  </div>


                  <div class="uw2__compact-copy">

                    <div class="uw2__compact-meta">

                      <span>
                        {{ block.settings.category }}
                      </span>

                      <span>
                        {{ block.settings.year }}
                      </span>

                    </div>


                    <h3>
                      {{ block.settings.title }}
                    </h3>


                    {%- if block.settings.client != blank -%}

                      <p>
                        {{ block.settings.client }}
                      </p>

                    {%- endif -%}

                  </div>

                </a>

              </article>

            {%- endif -%}

          {%- endfor -%}

        </div>

      </section>

    {%- endif -%}



    {%- comment -%}
      ============================================================
      END CTA
      ============================================================
    {%- endcomment -%}

    {%- if section.settings.show_footer_cta -%}

      <footer
        class="uw2__footer"
        data-uw2-reveal
      >

        <div class="uw2__footer-top">

          <span>
            04 / Next
          </span>

          <span>
            Start a project
          </span>

        </div>


        <div class="uw2__footer-main">

          <div>

            <p>
              {{ section.settings.footer_eyebrow }}
            </p>

            <h3>
              {{ section.settings.footer_title }}
            </h3>

          </div>


          {%- if section.settings.footer_button_text != blank and section.settings.footer_button_url != blank -%}

            <a
              href="{{ section.settings.footer_button_url }}"
              class="uw2__footer-button"
            >

              <span>
                {{ section.settings.footer_button_text }}
              </span>

              <span class="uw2__footer-button-arrow">

                <svg
                  viewBox="0 0 24 24"
                  width="24"
                  height="24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 19 19 5"/>
                  <path d="M9 5h10v10"/>
                </svg>

              </span>

            </a>

          {%- endif -%}

        </div>

      </footer>

    {%- endif -%}

  </div>

</section>



{% style %}

/* ============================================================
   SHOPIFY WRAPPER
   ============================================================ */

#shopify-section-{{ section.id }} {
  position: relative;

  width: 100%;
  max-width: none;

  margin: 0;
  padding: 0;
}


/* ============================================================
   ROOT
   ============================================================ */

.uw2--{{ uid }} {
  position: relative;
  isolation: isolate;

  width: 100%;

  overflow: hidden;

  padding:
    var(--uw2-top)
    0
    var(--uw2-bottom);

  color: var(--uw2-ink);
  background: var(--uw2-bg);

  font-family:
    'Inter Tight',
    -apple-system,
    BlinkMacSystemFont,
    'Helvetica Neue',
    Arial,
    sans-serif;

  -webkit-font-smoothing:
    antialiased;

  text-rendering:
    geometricPrecision;
}


.uw2--{{ uid }} *,
.uw2--{{ uid }} *::before,
.uw2--{{ uid }} *::after {
  box-sizing: border-box;
}


.uw2--{{ uid }} a {
  color: inherit;
  text-decoration: none;
}


.uw2--{{ uid }} :focus-visible {
  outline:
    1px
    solid
    var(--uw2-ink);

  outline-offset:
    5px;
}


/* ============================================================
   AMBIENCE
   ============================================================ */

.uw2--{{ uid }} .uw2__noise {
  position: absolute;
  inset: 0;
  z-index: 0;

  pointer-events: none;

  opacity: .24;

  background-image:
    radial-gradient(
      rgba(
        255,
        255,
        255,
        .025
      )
      1px,
      transparent
      1px
    );

  background-size:
    4px
    4px;

  mask-image:
    linear-gradient(
      black,
      transparent
      85%
    );

  -webkit-mask-image:
    linear-gradient(
      black,
      transparent
      85%
    );
}


.uw2--{{ uid }} .uw2__giant {
  position: absolute;
  top: 2.5%;
  left: -3%;
  z-index: 0;

  color:
    rgba(
      255,
      255,
      255,
      .017
    );

  font-size:
    clamp(
      180px,
      28vw,
      560px
    );

  font-weight: 700;
  line-height: .72;
  letter-spacing: -.085em;

  text-transform: uppercase;

  white-space: nowrap;

  pointer-events: none;
  user-select: none;
}


/* ============================================================
   SHELL
   ============================================================ */

.uw2--{{ uid }} .uw2__shell {
  position: relative;
  z-index: 2;

  width:
    min(
      calc(
        100% -
        64px
      ),
      1580px
    );

  margin:
    0
    auto;
}


/* ============================================================
   INTRO
   ============================================================ */

.uw2--{{ uid }} .uw2__intro {
  margin-bottom:
    clamp(
      100px,
      12vw,
      190px
    );
}


.uw2--{{ uid }} .uw2__intro-top {
  margin-bottom:
    clamp(
      38px,
      5vw,
      80px
    );

  display: flex;
  justify-content: space-between;
  align-items: flex-start;

  gap: 30px;
}


.uw2--{{ uid }} .uw2__eyebrow {
  margin: 0;

  display: flex;
  align-items: center;

  gap: 12px;

  color: var(--uw2-muted);

  font-size: 10px;
  font-weight: 600;
  letter-spacing: .18em;

  text-transform: uppercase;
}


.uw2--{{ uid }} .uw2__eyebrow span {
  width: 32px;
  height: 1px;

  background:
    currentColor;
}


.uw2--{{ uid }} .uw2__count {
  display: flex;
  align-items: flex-start;

  gap: 12px;
}


.uw2--{{ uid }} .uw2__count > span {
  color: var(--uw2-ink);

  font-size:
    clamp(
      32px,
      3.2vw,
      54px
    );

  font-weight: 500;
  line-height: .8;
  letter-spacing: -.05em;
}


.uw2--{{ uid }} .uw2__count small {
  color: var(--uw2-muted);

  font-size: 8px;
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: .12em;

  text-transform: uppercase;
}


.uw2--{{ uid }} .uw2__intro-grid {
  display: grid;

  grid-template-columns:
    minmax(0, 1.45fr)
    minmax(320px, .55fr);

  align-items: end;

  gap:
    clamp(
      60px,
      9vw,
      160px
    );
}


.uw2--{{ uid }} .uw2__heading {
  margin: 0;

  color: var(--uw2-ink);

  font-size:
    clamp(
      74px,
      11vw,
      190px
    );

  font-weight: 650;
  line-height: .76;
  letter-spacing: -.072em;

  text-transform: uppercase;
}


.uw2--{{ uid }} .uw2__heading span,
.uw2--{{ uid }} .uw2__heading em {
  display: block;
}


.uw2--{{ uid }} .uw2__heading em {
  color: var(--uw2-muted);

  font-weight: 400;
  font-style: normal;
}


.uw2--{{ uid }} .uw2__intro-copy {
  padding-bottom: 5px;
}


.uw2--{{ uid }} .uw2__intro-copy > p {
  max-width: 37ch;

  margin:
    0
    0
    34px;

  color: var(--uw2-muted);

  font-size:
    clamp(
      14px,
      1.15vw,
      17px
    );

  line-height: 1.62;
}


.uw2--{{ uid }} .uw2__intro-meta {
  padding:
    14px
    0;

  display: grid;

  grid-template-columns:
    1fr
    1fr;

  gap:
    10px
    20px;

  border-top:
    1px
    solid
    var(--uw2-line);

  border-bottom:
    1px
    solid
    var(--uw2-line);

  color: var(--uw2-muted);

  font-size: 9px;
  font-weight: 600;
  letter-spacing: .12em;

  text-transform: uppercase;
}


.uw2--{{ uid }} .uw2__arrow-link {
  margin-top: 28px;

  display: inline-flex;
  align-items: center;

  gap: 18px;

  font-size: 12px;
  font-weight: 600;
}


.uw2--{{ uid }} .uw2__arrow-circle {
  width: 42px;
  height: 42px;

  display: grid;
  place-items: center;

  border:
    1px
    solid
    var(--uw2-line);

  border-radius: 50%;

  transition:
    color
    .3s
    ease,

    background
    .3s
    ease,

    transform
    .4s
    cubic-bezier(
      .16,
      1,
      .3,
      1
    );
}


.uw2--{{ uid }} .uw2__arrow-link:hover .uw2__arrow-circle {
  color: var(--uw2-bg);
  background: var(--uw2-ink);

  transform:
    rotate(45deg);
}


/* ============================================================
   FEATURED WRAPPER
   ============================================================ */

.uw2--{{ uid }} .uw2__featured {
  display: flex;
  flex-direction: column;

  gap:
    clamp(
      130px,
      16vw,
      260px
    );
}


/* ============================================================
   FEATURED PROJECT
   ============================================================ */

.uw2--{{ uid }} .uw2__feature {
  opacity: 0;

  filter:
    blur(12px);

  transform:
    translateY(70px);

  transition:
    opacity
    1s
    cubic-bezier(
      .16,
      1,
      .3,
      1
    ),

    filter
    1s
    cubic-bezier(
      .16,
      1,
      .3,
      1
    ),

    transform
    1s
    cubic-bezier(
      .16,
      1,
      .3,
      1
    );
}


.uw2--{{ uid }} .uw2__feature.is-visible {
  opacity: 1;

  filter:
    blur(0);

  transform:
    translateY(0);
}


.uw2--{{ uid }} .uw2__feature-link {
  display: grid;

  grid-template-columns:
    minmax(0, 1.38fr)
    minmax(340px, .62fr);

  min-height:
    min(
      780px,
      78vh
    );

  overflow: hidden;

  border-top:
    1px
    solid
