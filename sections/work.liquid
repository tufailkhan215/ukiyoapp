                !entry.isIntersecting
              ) {
                return;
              }


              entry.target.classList.add(
                'is-visible'
              );


              observer.unobserve(
                entry.target
              );
            }
          );
        },
        {
          rootMargin:
            '0px 0px -8% 0px',

          threshold:
            0.10
        }
      );


    revealElements.forEach(
      function (element) {
        observer.observe(
          element
        );
      }
    );
  }


  function updateParallax() {
    scrollTicking = false;


    if (
      destroyed ||
      reduceMotion ||
      window.innerWidth <
      990
    ) {
      return;
    }


    var viewportHeight =
      window.innerHeight;


    parallaxElements.forEach(
      function (element) {
        var rect =
          element.getBoundingClientRect();


        if (
          rect.bottom < 0 ||
          rect.top >
          viewportHeight
        ) {
          return;
        }


        var center =
          rect.top +
          (
            rect.height /
            2
          );


        var distance =
          center -
          (
            viewportHeight /
            2
          );


        var movement =
          Math.max(
            -24,
            Math.min(
              24,
              distance *
              -0.035
            )
          );


        element.style.setProperty(
          '--uw-parallax',
          movement.toFixed(2) +
          'px'
        );
      }
    );
  }


  function requestParallax() {
    if (scrollTicking) {
      return;
    }


    scrollTicking = true;


    scrollFrame =
      window.requestAnimationFrame(
        updateParallax
      );
  }


  function initializeVideos() {
    root
      .querySelectorAll('video')
      .forEach(
        function (video) {
          video.muted = true;
          video.defaultMuted = true;

          video.setAttribute(
            'muted',
            ''
          );

          video.setAttribute(
            'playsinline',
            ''
          );


          var promise =
            video.play();


          if (
            promise &&
            typeof promise.catch ===
            'function'
          ) {
            promise.catch(
              function () {}
            );
          }
        }
      );
  }


  function cleanup() {
    destroyed = true;


    if (observer) {
      observer.disconnect();
    }


    window.removeEventListener(
      'scroll',
      requestParallax
    );


    window.removeEventListener(
      'resize',
      requestParallax
    );


    window.cancelAnimationFrame(
      scrollFrame
    );


    root.removeAttribute(
      'data-ukiyo-work-ready'
    );
  }


  root.__ukiyoWorkCleanup =
    cleanup;


  root.setAttribute(
    'data-ukiyo-work-ready',
    'true'
  );


  initializeReveal();
  initializeVideos();
  updateParallax();


  window.addEventListener(
    'scroll',
    requestParallax,
    {
      passive: true
    }
  );


  window.addEventListener(
    'resize',
    requestParallax
  );


  document.addEventListener(
    'shopify:section:unload',
    function onUkiyoWorkUnload(event) {
      if (
        !event.target ||
        !event.target.contains(root)
      ) {
        return;
      }


      cleanup();


      document.removeEventListener(
        'shopify:section:unload',
        onUkiyoWorkUnload
      );
    }
  );
})();
</script>



