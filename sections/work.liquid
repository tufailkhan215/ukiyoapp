{%- comment -%}
  ============================================================
  UKIYO — SELECTED WORK
  Premium editorial case-study section
  ============================================================

  SAVE IN:
  sections/ukiyo-selected-work.liquid

  FEATURES
  - Native Shopify SECTION
  - Editable case-study blocks
  - Featured + compact layouts
  - Optional Shopify video or image per project
  - Alternating editorial compositions
  - Oversized background typography
  - Sticky project index on desktop
  - Scroll reveal animation
  - Subtle image parallax
  - Premium metrics / result chips
  - Mobile horizontal swipe rail for compact projects
  - Section-specific color controls
  - Mobile controls
  - No max_blocks
  - No enabled_on
{%- endcomment -%}


{%- liquid
  assign uid = section.id | replace: '_', '' | replace: '-', '' | downcase

  assign featured_count = 0
  assign compact_count = 0
  assign project_count = 0

  for block in section.blocks
    if block.type == 'case_study'
      assign project_count = project_count | plus: 1

      if block.settings.layout == 'featured'
        assign featured_count = featured_count | plus: 1
      else
        assign compact_count = compact_count | plus: 1
      endif
    endif
  endfor

  assign display_text = section.settings.background_word

  if display_text == blank
    assign display_text = 'SELECTED WORK'
  endif
-%}


<section
  id="UkiyoWork-{{ uid }}"
  class="ukiyo-work ukiyo-work--{{ uid }}"
  data-ukiyo-work
  style="
    --uw-bg: {{ section.settings.background_color }};
    --uw-text: {{ section.settings.text_color }};
    --uw-muted: {{ section.settings.muted_color }};
    --uw-line: {{ section.settings.line_color }};
    --uw-card: {{ section.settings.card_color }};
    --uw-accent: {{ section.settings.accent_color }};
    --uw-image-overlay: {{ section.settings.image_overlay | divided_by: 100.0 }};
    --uw-top-space: {{ section.settings.padding_top }}px;
    --uw-bottom-space: {{ section.settings.padding_bottom }}px;
    --uw-radius: {{ section.settings.card_radius }}px;
  "
>

  {%- comment -%}
    ============================================================
    ATMOSPHERE
    ============================================================
  {%- endcomment -%}

  <div
    class="ukiyo-work__display"
    aria-hidden="true"
  >
    <span>
      {{ display_text }}
    </span>
  </div>


  <div
    class="ukiyo-work__grid-texture"
    aria-hidden="true"
  ></div>


  <div
    class="ukiyo-work__top-rule"
    aria-hidden="true"
  ></div>



  <div class="ukiyo-work__container">

    {%- comment -%}
      ============================================================
      HEADER
      ============================================================
    {%- endcomment -%}

    <header class="ukiyo-work__header">

      <div class="ukiyo-work__header-main">

        <div>

          {%- if section.settings.strap != blank -%}

            <p class="ukiyo-work__eyebrow">

              <span
                class="ukiyo-work__eyebrow-line"
                aria-hidden="true"
              ></span>

              {{ section.settings.strap }}

            </p>

          {%- endif -%}


          <h2 class="ukiyo-work__title">

            <span>
              {{ section.settings.title_line1 }}
            </span>

            <em>
              {{ section.settings.title_line2 }}
            </em>

          </h2>

        </div>


        <div class="ukiyo-work__header-aside">

          {%- if section.settings.intro != blank -%}

            <p class="ukiyo-work__intro">
              {{ section.settings.intro }}
            </p>

          {%- endif -%}


          <div class="ukiyo-work__header-meta">

            <span>
              {{ project_count | prepend: '0' | slice: -2, 2 }}
              projects
            </span>

            <span>
              Strategy · Creative · Build
            </span>

          </div>


          {%- if section.settings.view_all_text != blank and section.settings.view_all_url != blank -%}

            <a
              class="ukiyo-work__text-link"
              href="{{ section.settings.view_all_url }}"
            >

              <span>
                {{ section.settings.view_all_text }}
              </span>

              <svg
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14"/>
                <path d="m13 6 6 6-6 6"/>
              </svg>

            </a>

          {%- endif -%}

        </div>

      </div>

    </header>



    {%- comment -%}
      ============================================================
      FEATURED PROJECTS
      ============================================================
    {%- endcomment -%}

    {%- if featured_count > 0 -%}

      <div class="ukiyo-work__featured">

        {%- assign featured_index = 0 -%}

        {%- for block in section.blocks -%}

          {%- if block.type == 'case_study' and block.settings.layout == 'featured' -%}

            {%- assign featured_index = featured_index | plus: 1 -%}
            {%- assign project_number = featured_index | prepend: '0' | slice: -2, 2 -%}
            {%- assign is_even = featured_index | modulo: 2 -%}

            {%- assign project_link = block.settings.link -%}

            {%- if project_link == blank -%}
              {%- assign project_link = section.settings.view_all_url -%}
            {%- endif -%}


            <article
              id="UkiyoProject-{{ block.id }}"
              class="
                ukiyo-work__project
                {% if is_even == 0 %}
                  ukiyo-work__project--reverse
                {% endif %}
              "
              data-ukiyo-reveal
              {{ block.shopify_attributes }}
            >

              <a
                class="ukiyo-work__project-link"
                href="{{ project_link | default: '#' }}"
              >

                <div class="ukiyo-work__project-media">

                  <div
                    class="ukiyo-work__project-image-wrap"
                    data-ukiyo-parallax
                  >

                    {%- if block.settings.video != blank -%}

                      {{
                        block.settings.video
                        | video_tag:
                          autoplay: true,
                          loop: true,
                          muted: true,
                          controls: false,
                          playsinline: true,
                          preload: 'metadata',
                          class: 'ukiyo-work__project-image'
                      }}


                    {%- elsif block.settings.image != blank -%}

                      <img
                        class="ukiyo-work__project-image"
                        src="{{ block.settings.image | image_url: width: 1800 }}"
                        srcset="
                          {{ block.settings.image | image_url: width: 700 }} 700w,
                          {{ block.settings.image | image_url: width: 1100 }} 1100w,
                          {{ block.settings.image | image_url: width: 1500 }} 1500w,
                          {{ block.settings.image | image_url: width: 1800 }} 1800w
                        "
                        sizes="(max-width: 899px) 100vw, 58vw"
                        width="{{ block.settings.image.width }}"
                        height="{{ block.settings.image.height }}"
                        alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                        loading="lazy"
                      >


                    {%- else -%}

                      <div class="ukiyo-work__media-placeholder">

                        <span>
                          {{ project_number }}
                        </span>

                        <small>
                          Add project media
                        </small>

                      </div>

                    {%- endif -%}


                    <span
                      class="ukiyo-work__media-overlay"
                      aria-hidden="true"
                    ></span>


                    <span
                      class="ukiyo-work__project-number"
                      aria-hidden="true"
                    >
                      {{ project_number }}
                    </span>


                    <span
                      class="ukiyo-work__media-arrow"
                      aria-hidden="true"
                    >

                      <svg
                        viewBox="0 0 24 24"
                        width="24"
                        height="24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M5 19 19 5"/>
                        <path d="M9 5h10v10"/>
                      </svg>

                    </span>

                  </div>

                </div>


                <div class="ukiyo-work__project-copy">

                  <div class="ukiyo-work__project-copy-top">

                    <div class="ukiyo-work__project-ident">

                      {%- if block.settings.category != blank -%}

                        <span class="ukiyo-work__project-category">
                          {{ block.settings.category }}
                        </span>

                      {%- endif -%}


                      {%- if block.settings.year != blank -%}

                        <span class="ukiyo-work__project-year">
                          {{ block.settings.year }}
                        </span>

                      {%- endif -%}

                    </div>


                    {%- if block.settings.client != blank -%}

                      <p class="ukiyo-work__client">
                        {{ block.settings.client }}
                      </p>

                    {%- endif -%}

                  </div>


                  <div class="ukiyo-work__project-copy-main">

                    <h3 class="ukiyo-work__project-title">
                      {{ block.settings.title }}
                    </h3>


                    {%- if block.settings.description != blank -%}

                      <p class="ukiyo-work__project-description">
                        {{ block.settings.description }}
                      </p>

                    {%- endif -%}


                    {%- if block.settings.services != blank -%}

                      <p class="ukiyo-work__services">
                        {{ block.settings.services }}
                      </p>

                    {%- endif -%}

                  </div>


                  <div class="ukiyo-work__project-copy-bottom">

                    {%- if block.settings.result_1 != blank or block.settings.result_2 != blank or block.settings.result_3 != blank -%}

                      <div class="ukiyo-work__results">

                        {%- if block.settings.result_1 != blank -%}

                          <span class="ukiyo-work__result">
                            {{ block.settings.result_1 }}
                          </span>

                        {%- endif -%}


                        {%- if block.settings.result_2 != blank -%}

                          <span class="ukiyo-work__result">
                            {{ block.settings.result_2 }}
                          </span>

                        {%- endif -%}


                        {%- if block.settings.result_3 != blank -%}

                          <span class="ukiyo-work__result">
                            {{ block.settings.result_3 }}
                          </span>

                        {%- endif -%}

                      </div>

                    {%- endif -%}


                    <span class="ukiyo-work__project-cta">

                      <span>
                        {{ block.settings.cta_text | default: 'View case study' }}
                      </span>

                      <svg
                        viewBox="0 0 24 24"
                        width="17"
                        height="17"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M5 12h14"/>
                        <path d="m13 6 6 6-6 6"/>
                      </svg>

                    </span>

                  </div>

                </div>

              </a>

            </article>

          {%- endif -%}

        {%- endfor -%}

      </div>

    {%- endif -%}



    {%- comment -%}
      ============================================================
      COMPACT PROJECTS
      ============================================================
    {%- endcomment -%}

    {%- if compact_count > 0 -%}

      <section class="ukiyo-work__more">

        <header class="ukiyo-work__more-header">

          <p>
            {{ section.settings.compact_label }}
          </p>


          <span>
            Swipe / Explore
          </span>

        </header>


        <div class="ukiyo-work__compact-grid">

          {%- assign compact_index = 0 -%}

          {%- for block in section.blocks -%}

            {%- if block.type == 'case_study' and block.settings.layout == 'compact' -%}

              {%- assign compact_index = compact_index | plus: 1 -%}

              {%- assign project_link = block.settings.link -%}

              {%- if project_link == blank -%}
                {%- assign project_link = section.settings.view_all_url -%}
              {%- endif -%}


              <article
                class="ukiyo-work__compact"
                data-ukiyo-reveal
                {{ block.shopify_attributes }}
              >

                <a
                  class="ukiyo-work__compact-link"
                  href="{{ project_link | default: '#' }}"
                >

                  <div class="ukiyo-work__compact-media">

                    {%- if block.settings.video != blank -%}

                      {{
                        block.settings.video
                        | video_tag:
                          autoplay: true,
                          loop: true,
                          muted: true,
                          controls: false,
                          playsinline: true,
                          preload: 'metadata',
                          class: 'ukiyo-work__compact-image'
                      }}


                    {%- elsif block.settings.image != blank -%}

                      <img
                        class="ukiyo-work__compact-image"
                        src="{{ block.settings.image | image_url: width: 1200 }}"
                        srcset="
                          {{ block.settings.image | image_url: width: 500 }} 500w,
                          {{ block.settings.image | image_url: width: 800 }} 800w,
                          {{ block.settings.image | image_url: width: 1200 }} 1200w
                        "
                        sizes="(max-width: 749px) 82vw, 50vw"
                        width="{{ block.settings.image.width }}"
                        height="{{ block.settings.image.height }}"
                        alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                        loading="lazy"
                      >


                    {%- else -%}

                      <div class="ukiyo-work__compact-placeholder">
                        {{ compact_index | prepend: '0' | slice: -2, 2 }}
                      </div>

                    {%- endif -%}


                    <span
                      class="ukiyo-work__compact-overlay"
                      aria-hidden="true"
                    ></span>


                    <span
                      class="ukiyo-work__compact-arrow"
                      aria-hidden="true"
                    >

                      <svg
                        viewBox="0 0 24 24"
                        width="20"
                        height="20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M5 19 19 5"/>
                        <path d="M9 5h10v10"/>
                      </svg>

                    </span>

                  </div>


                  <div class="ukiyo-work__compact-copy">

                    <div class="ukiyo-work__compact-meta">

                      {%- if block.settings.category != blank -%}

                        <span>
                          {{ block.settings.category }}
                        </span>

                      {%- endif -%}


                      {%- if block.settings.year != blank -%}

                        <span>
                          {{ block.settings.year }}
                        </span>

                      {%- endif -%}

                    </div>


                    <h3>
                      {{ block.settings.title }}
                    </h3>


                    {%- if block.settings.client != blank -%}

                      <p>
                        {{ block.settings.client }}
                      </p>

                    {%- endif -%}

                  </div>

                </a>

              </article>

            {%- endif -%}

          {%- endfor -%}

        </div>

      </section>

    {%- endif -%}



    {%- comment -%}
      ============================================================
      BOTTOM CTA
      ============================================================
    {%- endcomment -%}

    {%- if section.settings.show_footer_cta -%}

      <footer
        class="ukiyo-work__footer"
        data-ukiyo-reveal
      >

        <div>

          <p class="ukiyo-work__footer-eyebrow">
            {{ section.settings.footer_eyebrow }}
          </p>


          <h3>
            {{ section.settings.footer_title }}
          </h3>

        </div>


        {%- if section.settings.footer_button_text != blank and section.settings.footer_button_url != blank -%}

          <a
            class="ukiyo-work__footer-button"
            href="{{ section.settings.footer_button_url }}"
          >

            <span>
              {{ section.settings.footer_button_text }}
            </span>

            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14"/>
              <path d="m13 6 6 6-6 6"/>
            </svg>

          </a>

        {%- endif -%}

      </footer>

    {%- endif -%}

  </div>

</section>



{% style %}

/* ============================================================
   SHOPIFY WRAPPER
   ============================================================ */

#shopify-section-{{ section.id }} {
  position: relative;

  width: 100%;
  max-width: none;

  margin: 0;
  padding: 0;
}


/* ============================================================
   SECTION ROOT
   ============================================================ */

.ukiyo-work--{{ uid }} {
  position: relative;
  isolation: isolate;

  width: 100%;
  overflow: hidden;

  padding:
    var(--uw-top-space)
    0
    var(--uw-bottom-space);

  color: var(--uw-text);
  background: var(--uw-bg);

  font-family:
    'Inter Tight',
    -apple-system,
    BlinkMacSystemFont,
    'Helvetica Neue',
    Arial,
    sans-serif;

  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}


.ukiyo-work--{{ uid }} *,
.ukiyo-work--{{ uid }} *::before,
.ukiyo-work--{{ uid }} *::after {
  box-sizing: border-box;
}


.ukiyo-work--{{ uid }} a {
  color: inherit;
  text-decoration: none;
}


.ukiyo-work--{{ uid }} :focus-visible {
  outline:
    1px
    solid
    var(--uw-text);

  outline-offset: 5px;
}


/* ============================================================
   CONTAINER
   ============================================================ */

.ukiyo-work--{{ uid }} .ukiyo-work__container {
  position: relative;
  z-index: 3;

  width:
    min(
      calc(100% - 48px),
      1540px
    );

  margin:
    0
    auto;
}


/* ============================================================
   AMBIENT BACKGROUND
   ============================================================ */

.ukiyo-work--{{ uid }} .ukiyo-work__display {
  position: absolute;
  top: 6%;
  left: -1%;
  z-index: 0;

  width: 110%;

  overflow: hidden;

  pointer-events: none;
  user-select: none;
}


.ukiyo-work--{{ uid }} .ukiyo-work__display span {
  display: block;

  color:
    color-mix(
      in srgb,
      var(--uw-text) 2.2%,
      transparent
    );

  font-size:
    clamp(
      130px,
      19vw,
      370px
    );

  font-weight: 700;
  line-height: .76;
  letter-spacing: -.075em;

  text-transform: uppercase;
  white-space: nowrap;
}


.ukiyo-work--{{ uid }} .ukiyo-work__grid-texture {
  position: absolute;
  inset: 0;
  z-index: 0;

  opacity: .28;

  pointer-events: none;

  background-image:
    linear-gradient(
      rgba(255,255,255,.022)
      1px,
      transparent
      1px
    ),

    linear-gradient(
      90deg,
      rgba(255,255,255,.022)
      1px,
      transparent
      1px
    );

  background-size:
    88px
    88px;

  mask-image:
    linear-gradient(
      to bottom,
      black,
      transparent 72%
    );

  -webkit-mask-image:
    linear-gradient(
      to bottom,
      black,
      transparent 72%
    );
}


.ukiyo-work--{{ uid }} .ukiyo-work__top-rule {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;

  height: 1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      var(--uw-line),
      transparent
    );
}


/* ============================================================
   HEADER
   ============================================================ */

.ukiyo-work--{{ uid }} .ukiyo-work__header {
  position: relative;

  margin-bottom:
    clamp(
      70px,
      9vw,
      145px
    );
}


.ukiyo-work--{{ uid }} .ukiyo-work__header-main {
  display: grid;

  grid-template-columns:
    minmax(0, 1.35fr)
    minmax(280px, .65fr);

  gap:
    clamp(
      50px,
      8vw,
      130px
    );

  align-items: end;
}


.ukiyo-work--{{ uid }} .ukiyo-work__eyebrow {
  margin:
    0
    0
    22px;

  display: flex;
  align-items: center;

  gap: 12px;

  color: var(--uw-muted);

  font-size: 10px;
  font-weight: 600;
  letter-spacing: .22em;

  text-transform: uppercase;
}


.ukiyo-work--{{ uid }} .ukiyo-work__eyebrow-line {
  width: 34px;
  height: 1px;

  background:
    currentColor;
}


.ukiyo-work--{{ uid }} .ukiyo-work__title {
  margin: 0;

  color: var(--uw-text);

  font-size:
    clamp(
      58px,
      8.8vw,
      154px
    );

  font-weight: 650;
  line-height: .82;
  letter-spacing: -.065em;

  text-transform: uppercase;
}


.ukiyo-work--{{ uid }} .ukiyo-work__title span,
.ukiyo-work--{{ uid }} .ukiyo-work__title em {
  display: block;
}


.ukiyo-work--{{ uid }} .ukiyo-work__title em {
  color: var(--uw-muted);

  font-weight: 400;
  font-style: normal;
}


.ukiyo-work--{{ uid }} .ukiyo-work__header-aside {
  padding-bottom: 4px;
}


.ukiyo-work--{{ uid }} .ukiyo-work__intro {
  max-width: 39ch;

  margin:
    0
    0
    30px;

  color: var(--uw-muted);

  font-size:
    clamp(
      14px,
      1.1vw,
      17px
    );

  font-weight: 400;
  line-height: 1.6;
}


.ukiyo-work--{{ uid }} .ukiyo-work__header-meta {
  margin-bottom: 30px;

  padding:
    15px
    0;

  display: flex;
  justify-content: space-between;
  gap: 20px;

  border-top:
    1px
    solid
    var(--uw-line);

  border-bottom:
    1px
    solid
    var(--uw-line);

  color: var(--uw-muted);

  font-size: 10px;
  font-weight: 600;
  letter-spacing: .12em;

  text-transform: uppercase;
}


.ukiyo-work--{{ uid }} .ukiyo-work__text-link {
  display: inline-flex;
  align-items: center;

  gap: 12px;

  font-size: 13px;
  font-weight: 600;
  letter-spacing: .04em;

  transition:
    opacity
    .22s
    ease;
}


.ukiyo-work--{{ uid }} .ukiyo-work__text-link svg {
  transition:
    transform
    .35s
    cubic-bezier(
      .16,
      1,
      .3,
      1
    );
}


.ukiyo-work--{{ uid }} .ukiyo-work__text-link:hover {
  opacity: .64;
}


.ukiyo-work--{{ uid }} .ukiyo-work__text-link:hover svg {
  transform:
    translateX(4px);
}


/* ============================================================
   FEATURED PROJECTS
   ============================================================ */

.ukiyo-work--{{ uid }} .ukiyo-work__featured {
  display: flex;
  flex-direction: column;

  gap:
    clamp(
      90px,
      12vw,
      185px
    );
}


.ukiyo-work--{{ uid }} .ukiyo-work__project {
  position: relative;

  opacity: 0;

  filter:
    blur(10px);

  transform:
    translateY(54px);

  transition:
    opacity
    .9s
    cubic-bezier(
      .16,
      1,
      .3,
      1
    ),

    filter
    .9s
    cubic-bezier(
      .16,
      1,
      .3,
      1
    ),

    transform
    .9s
    cubic-bezier(
      .16,
      1,
      .3,
      1
    );
}


.ukiyo-work--{{ uid }} .ukiyo-work__project.is-visible {
  opacity: 1;

  filter:
    blur(0);

  transform:
    translateY(0);
}


.ukiyo-work--{{ uid }} .ukiyo-work__project-link {
  display: grid;

  grid-template-columns:
    minmax(0, 1.2fr)
    minmax(340px, .8fr);

  min-height:
    min(
      720px,
      72vh
    );

  overflow: hidden;

  border:
    1px
    solid
    var(--uw-line);

  border-radius:
    var(--uw-radius);

  background:
    var(--uw-card);
}


.ukiyo-work--{{ uid }}
.ukiyo-work__project--reverse
.ukiyo-work__project-media {
  order: 2;
}


.ukiyo-work--{{ uid }}
.ukiyo-work__project--reverse
.ukiyo-work__project-copy {
  order: 1;
}


.ukiyo-work--{{ uid }} .ukiyo-work__project-media {
  position: relative;

  min-height: 560px;
}


.ukiyo-work--{{ uid }} .ukiyo-work__project-image-wrap {
  position: absolute;
  inset: 0;

  overflow: hidden;
}


