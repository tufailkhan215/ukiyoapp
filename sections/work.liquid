<script>
(function () {
  var root =
    document.getElementById(
      'UkiyoWork-{{ uid }}'
    );

  if (!root) {
    return;
  }


  if (
    root.__uw2Cleanup &&
    typeof root.__uw2Cleanup === 'function'
  ) {
    root.__uw2Cleanup();
  }


  var reveals =
    Array.prototype.slice.call(
      root.querySelectorAll(
        '[data-uw2-reveal]'
      )
    );


  var parallaxItems =
    Array.prototype.slice.call(
      root.querySelectorAll(
        '[data-uw2-parallax]'
      )
    );


  var reduceMotion =
    window.matchMedia &&
    window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;


  var observer = null;

  var frame = 0;

  var ticking = false;

  var destroyed = false;


  function showEverything() {
    reveals.forEach(
      function (element) {
        element.classList.add(
          'is-visible'
        );
      }
    );
  }


  function initReveal() {
    if (
      reduceMotion ||
      !(
        'IntersectionObserver'
        in window
      )
    ) {
      showEverything();

      return;
    }


    observer =
      new IntersectionObserver(
        function (entries) {
          entries.forEach(
            function (entry) {
              if (
                !entry.isIntersecting
              ) {
                return;
              }


              entry.target.classList.add(
                'is-visible'
              );


              observer.unobserve(
                entry.target
              );
            }
          );
        },
        {
          threshold: .10,

          rootMargin:
            '0px 0px -7% 0px'
        }
      );


    reveals.forEach(
      function (element) {
        observer.observe(
          element
        );
      }
    );
  }


  function updateParallax() {
    ticking = false;


    if (
      destroyed ||
      reduceMotion ||
      window.innerWidth < 990
    ) {
      return;
    }


    var viewportHeight =
      window.innerHeight;


    parallaxItems.forEach(
      function (item) {
        var rect =
          item.getBoundingClientRect();


        if (
          rect.bottom < 0 ||
          rect.top > viewportHeight
        ) {
          return;
        }


        var center =
          rect.top +
          (
            rect.height /
            2
          );


        var delta =
          center -
          (
            viewportHeight /
            2
          );


        var shift =
          Math.max(
            -28,
            Math.min(
              28,
              delta *
              -.04
            )
          );


        item.style.setProperty(
          '--uw2-parallax',
          shift.toFixed(2) +
          'px'
        );
      }
    );
  }


  function requestParallax() {
    if (ticking) {
      return;
    }


    ticking = true;


    frame =
      window.requestAnimationFrame(
        updateParallax
      );
  }


  function initVideos() {
    root
      .querySelectorAll(
        'video'
      )
      .forEach(
        function (video) {
          video.muted = true;

          video.defaultMuted = true;


          video.setAttribute(
            'muted',
            ''
          );


          video.setAttribute(
            'playsinline',
            ''
          );


          var promise =
            video.play();


          if (
            promise &&
            typeof promise.catch ===
            'function'
          ) {
            promise.catch(
              function () {}
            );
          }
        }
      );
  }


  function cleanup() {
    destroyed = true;


    if (observer) {
      observer.disconnect();
    }


    window.removeEventListener(
      'scroll',
      requestParallax
    );


    window.removeEventListener(
      'resize',
      requestParallax
    );


    window.cancelAnimationFrame(
      frame
    );


    root.removeAttribute(
      'data-uw2-ready'
    );
  }


  root.__uw2Cleanup =
    cleanup;


  root.setAttribute(
    'data-uw2-ready',
    'true'
  );


  initReveal();

  initVideos();

  updateParallax();


  window.addEventListener(
    'scroll',
    requestParallax,
    {
      passive: true
    }
  );


  window.addEventListener(
    'resize',
    requestParallax
  );


  document.addEventListener(
    'shopify:section:unload',
    function onUnload(event) {
      if (
        !event.target ||
        !event.target.contains(root)
      ) {
        return;
      }


      cleanup();


      document.removeEventListener(
        'shopify:section:unload',
        onUnload
      );
    }
  );
})();
</script>



