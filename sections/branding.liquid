{% comment %}
  Section: Branding Activations
  File: sections/branding-activations.liquid
{% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap');

  #ba-{{ section.id }} {
    --bg:        #000;
    --surface:   #0a0a0a;
    --border:    rgba(255,255,255,0.07);
    --muted:     rgba(255,255,255,0.45);
    --faint:     rgba(255,255,255,0.18);
    --r:         20px;
    background:  var(--bg);
    color:       #fff;
    padding:     5rem 1.5rem 6rem;
    position:    relative;
    overflow:    hidden;
  }

  @media (min-width: 768px) { #ba-{{ section.id }} { padding: 6rem 3rem 8rem; } }
  @media (min-width: 1280px) { #ba-{{ section.id }} { padding: 7rem 5rem 9rem; } }

  #ba-{{ section.id }} * { box-sizing: border-box; }
  #ba-{{ section.id }} img { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* Noise grain texture */
  #ba-{{ section.id }}::after {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 99;
    opacity: 0.5;
  }

  #ba-{{ section.id }} .ba-inner { max-width: 1400px; margin: 0 auto; position: relative; z-index: 1; }

  /* ── Section Header ───────────────────────────────── */
  .ba-header { margin-bottom: 4rem; }

  .ba-eyebrow {
    display: inline-flex; align-items: center; gap: .55rem;
    font-family: 'DM Sans', sans-serif;
    font-size: .65rem; font-weight: 500; letter-spacing: .22em;
    text-transform: uppercase; color: var(--faint);
    margin-bottom: 1.5rem;
  }
  .ba-eyebrow::before {
    content: '';
    display: block; width: 28px; height: 1px;
    background: var(--faint);
  }

  .ba-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(4rem, 10vw, 9rem);
    line-height: .9;
    letter-spacing: .01em;
    color: #fff;
    margin: 0 0 1.5rem;
  }

  .ba-title span {
    display: block;
    -webkit-text-stroke: 1px rgba(255,255,255,0.22);
    color: transparent;
  }

  .ba-desc {
    font-family: 'DM Sans', sans-serif;
    font-size: clamp(.9rem, 1.5vw, 1.05rem);
    font-weight: 300;
    line-height: 1.8;
    color: var(--muted);
    max-width: 44rem;
    border-left: 1.5px solid rgba(255,255,255,0.12);
    padding-left: 1.25rem;
  }

  /* ── Bento Grid ───────────────────────────────────── */
  .ba-grid {
    display: grid;
    gap: .75rem;
    grid-template-columns: 1fr;
    margin-bottom: .75rem;
  }

  @media (min-width: 768px)  { .ba-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1024px) {
    .ba-grid--main  { grid-template-columns: repeat(12, 1fr); }
    .ba-grid--lower { grid-template-columns: repeat(12, 1fr); }
  }

  /* Card base */
  .ba-card {
    position: relative;
    overflow: hidden;
    border-radius: var(--r);
    border: 1px solid var(--border);
    background: var(--surface);
    cursor: pointer;
    transition: border-color .5s, box-shadow .5s;
  }

  .ba-card:hover {
    border-color: rgba(255,255,255,0.18);
    box-shadow: 0 24px 60px rgba(0,0,0,.6);
  }

  .ba-card-img {
    position: absolute; inset: 0;
    transition: transform .8s cubic-bezier(.165,.84,.44,1), opacity .6s, filter .6s;
    filter: saturate(0.1) brightness(0.55);
    opacity: 1;
  }

  .ba-card:hover .ba-card-img {
    transform: scale(1.07);
    filter: saturate(0.9) brightness(0.7);
    opacity: 1;
  }

  .ba-card-grad {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(to top, rgba(0,0,0,.85) 0%, rgba(0,0,0,.2) 55%, transparent 100%);
  }

  .ba-card-body {
    position: relative; z-index: 2;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: 1.5rem;
    height: 100%;
  }

  .ba-card-tag {
    position: absolute; top: 1.1rem; left: 1.1rem; z-index: 3;
    font-family: 'DM Sans', sans-serif;
    font-size: .58rem; font-weight: 500; letter-spacing: .2em; text-transform: uppercase;
    color: rgba(255,255,255,.4);
    background: rgba(0,0,0,.35);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: .3rem .75rem;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,.08);
  }

  .ba-card-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(1.4rem, 3vw, 2rem);
    letter-spacing: .04em;
    line-height: 1;
    color: #fff;
    margin: 0 0 .3rem;
  }

  .ba-card-sub {
    font-family: 'DM Sans', sans-serif;
    font-size: .72rem; font-weight: 300; letter-spacing: .08em;
    color: rgba(255,255,255,.38);
    text-transform: uppercase;
  }

  /* Grid span helpers */
  @media (min-width: 1024px) {
    .ba-span-5  { grid-column: span 5; }
    .ba-span-4  { grid-column: span 4; }
    .ba-span-3  { grid-column: span 3; }
    .ba-span-7  { grid-column: span 7; }
    .ba-span-6  { grid-column: span 6; }
  }

  /* Heights */
  .ba-h-tall   { min-height: 380px; }
  .ba-h-mid    { min-height: 280px; }
  .ba-h-short  { min-height: 200px; }

  @media (min-width: 1024px) {
    .ba-h-tall   { min-height: 460px; }
    .ba-h-mid    { min-height: 340px; }
    .ba-h-short  { min-height: 240px; }
  }

  /* ── Full-width Feature Strip ─────────────────────── */
  .ba-strip {
    position: relative;
    overflow: hidden;
    border-radius: var(--r);
    border: 1px solid var(--border);
    height: 420px;
    margin: .75rem 0;
    cursor: pointer;
  }

  @media (min-width: 1024px) { .ba-strip { height: 540px; } }

  .ba-strip-img {
    position: absolute; inset: 0;
    transition: transform 1.2s cubic-bezier(.165,.84,.44,1), filter 1s;
    filter: saturate(0.2) brightness(0.5);
  }

  .ba-strip:hover .ba-strip-img {
    transform: scale(1.04);
    filter: saturate(0.7) brightness(0.65);
  }

  .ba-strip-grad {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(
      160deg,
      rgba(0,0,0,.6) 0%,
      rgba(0,0,0,.1) 50%,
      rgba(0,0,0,.7) 100%
    );
  }

  .ba-strip-body {
    position: relative; z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2.5rem 3rem;
  }

  .ba-strip-label {
    font-family: 'DM Sans', sans-serif;
    font-size: .62rem; font-weight: 500; letter-spacing: .28em; text-transform: uppercase;
    color: rgba(255,255,255,.35);
    margin-bottom: 1rem;
    display: flex; align-items: center; gap: .65rem;
  }

  .ba-strip-label::before {
    content: ''; display: block;
    width: 22px; height: 1px; background: rgba(255,255,255,.25);
  }

  .ba-strip-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.8rem, 6vw, 5.5rem);
    letter-spacing: .02em;
    line-height: .92;
    margin: 0 0 1.25rem;
    color: #fff;
  }

  .ba-strip-desc {
    font-family: 'DM Sans', sans-serif;
    font-size: .88rem; font-weight: 300; line-height: 1.7;
    color: rgba(255,255,255,.45);
    max-width: 32rem;
  }

  /* Play button */
  .ba-play {
    position: absolute; z-index: 3;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 56px; height: 56px;
    border-radius: 50%;
    background: rgba(255,255,255,.08);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,.18);
    display: flex; align-items: center; justify-content: center;
    transition: background .4s, transform .4s;
  }

  .ba-strip:hover .ba-play {
    background: rgba(255,255,255,.18);
    transform: translate(-50%, -50%) scale(1.1);
  }

  /* ── Section divider label ────────────────────────── */
  .ba-section-label {
    display: flex; align-items: center; gap: 1rem;
    margin: 3.5rem 0 1.5rem;
    font-family: 'DM Sans', sans-serif;
    font-size: .6rem; font-weight: 500; letter-spacing: .28em;
    text-transform: uppercase; color: rgba(255,255,255,.22);
  }

  .ba-section-label::after {
    content: ''; flex: 1; height: 1px;
    background: rgba(255,255,255,.06);
  }

  /* ── Scroll reveal ────────────────────────────────── */
  #ba-{{ section.id }} .rv {
    opacity: 0; transform: translateY(22px);
    transition: opacity .75s cubic-bezier(.4,0,.2,1), transform .75s cubic-bezier(.4,0,.2,1);
  }
  #ba-{{ section.id }} .rv.in { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    #ba-{{ section.id }} .rv { opacity: 1 !important; transform: none !important; transition: none !important; }
  }
</style>

<div id="ba-{{ section.id }}">
  <div class="ba-inner">

    <!-- Header -->
    <div class="ba-header rv">
      <p class="ba-eyebrow">{{ section.settings.eyebrow | default: 'Services' }}</p>
      <h2 class="ba-title">
        {{ section.settings.title_line1 | default: 'BRANDING' }}
        <span>{{ section.settings.title_line2 | default: '& CONTENT' }}</span>
        {{ section.settings.title_line3 | default: 'ACTIVATIONS' }}
      </h2>
      {%- if section.settings.description != blank -%}
        <p class="ba-desc">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    <!-- Brand Showcase label -->
    <div class="ba-section-label rv">{{ section.settings.grid1_label | default: 'Brand Showcase' }}</div>

    <!-- Main Bento Grid Row 1 -->
    <div class="ba-grid ba-grid--main rv">
      {%- for block in section.blocks -%}
        {%- if block.type == 'brand_card' and block.settings.row == '1' -%}
          <div class="ba-card
            {%- if block.settings.span == 'wide' %} ba-span-5{%- elsif block.settings.span == 'medium' %} ba-span-4{%- else %} ba-span-3{%- endif %}
            {%- if block.settings.height == 'tall' %} ba-h-tall{%- elsif block.settings.height == 'mid' %} ba-h-mid{%- else %} ba-h-short{%- endif %}"
            {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              <img class="ba-card-img" src="{{ block.settings.image | img_url: '900x' }}" alt="{{ block.settings.name }}" loading="lazy">
            {%- endif -%}
            <div class="ba-card-grad"></div>
            {%- if block.settings.tag != blank -%}
              <span class="ba-card-tag">{{ block.settings.tag }}</span>
            {%- endif -%}
            <div class="ba-card-body">
              <p class="ba-card-name">{{ block.settings.name }}</p>
              {%- if block.settings.subtitle != blank -%}
                <p class="ba-card-sub">{{ block.settings.subtitle }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Main Bento Grid Row 2 -->
    <div class="ba-grid ba-grid--lower rv">
      {%- for block in section.blocks -%}
        {%- if block.type == 'brand_card' and block.settings.row == '2' -%}
          <div class="ba-card
            {%- if block.settings.span == 'wide' %} ba-span-5{%- elsif block.settings.span == 'medium' %} ba-span-4{%- else %} ba-span-3{%- endif %}
            {%- if block.settings.height == 'tall' %} ba-h-tall{%- elsif block.settings.height == 'mid' %} ba-h-mid{%- else %} ba-h-short{%- endif %}"
            {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              <img class="ba-card-img" src="{{ block.settings.image | img_url: '900x' }}" alt="{{ block.settings.name }}" loading="lazy">
            {%- endif -%}
            <div class="ba-card-grad"></div>
            {%- if block.settings.tag != blank -%}
              <span class="ba-card-tag">{{ block.settings.tag }}</span>
            {%- endif -%}
            <div class="ba-card-body">
              <p class="ba-card-name">{{ block.settings.name }}</p>
              {%- if block.settings.subtitle != blank -%}
                <p class="ba-card-sub">{{ block.settings.subtitle }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Feature Strip 1 -->
    {%- if section.settings.strip1_image != blank or section.settings.strip1_title != blank -%}
      <div class="ba-strip rv">
        {%- if section.settings.strip1_image -%}
          <img class="ba-strip-img" src="{{ section.settings.strip1_image | img_url: '2000x' }}" alt="{{ section.settings.strip1_title }}" loading="lazy">
        {%- endif -%}
        <div class="ba-strip-grad"></div>
        {%- if section.settings.strip1_playable -%}
          <div class="ba-play">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff"><polygon points="5 3 19 12 5 21"/></svg>
          </div>
        {%- endif -%}
        <div class="ba-strip-body">
          {%- if section.settings.strip1_label != blank -%}
            <p class="ba-strip-label">{{ section.settings.strip1_label }}</p>
          {%- endif -%}
          {%- if section.settings.strip1_title != blank -%}
            <h3 class="ba-strip-title">{{ section.settings.strip1_title }}</h3>
          {%- endif -%}
          {%- if section.settings.strip1_desc != blank -%}
            <p class="ba-strip-desc">{{ section.settings.strip1_desc }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <!-- Travel & Experience label -->
    <div class="ba-section-label rv">{{ section.settings.grid2_label | default: 'Travel & Experience Brands' }}</div>

    <!-- Travel Grid -->
    <div class="ba-grid ba-grid--lower rv">
      {%- for block in section.blocks -%}
        {%- if block.type == 'brand_card' and block.settings.row == '3' -%}
          <div class="ba-card
            {%- if block.settings.span == 'wide' %} ba-span-5{%- elsif block.settings.span == 'medium' %} ba-span-4{%- else %} ba-span-3{%- endif %}
            {%- if block.settings.height == 'tall' %} ba-h-tall{%- elsif block.settings.height == 'mid' %} ba-h-mid{%- else %} ba-h-short{%- endif %}"
            {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              <img class="ba-card-img" src="{{ block.settings.image | img_url: '900x' }}" alt="{{ block.settings.name }}" loading="lazy">
            {%- endif -%}
            <div class="ba-card-grad"></div>
            {%- if block.settings.tag != blank -%}
              <span class="ba-card-tag">{{ block.settings.tag }}</span>
            {%- endif -%}
            <div class="ba-card-body">
              <p class="ba-card-name">{{ block.settings.name }}</p>
              {%- if block.settings.subtitle != blank -%}
                <p class="ba-card-sub">{{ block.settings.subtitle }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Feature Strip 2 -->
    {%- if section.settings.strip2_image != blank or section.settings.strip2_title != blank -%}
      <div class="ba-strip rv">
        {%- if section.settings.strip2_image -%}
          <img class="ba-strip-img" src="{{ section.settings.strip2_image | img_url: '2000x' }}" alt="{{ section.settings.strip2_title }}" loading="lazy">
        {%- endif -%}
        <div class="ba-strip-grad"></div>
        {%- if section.settings.strip2_playable -%}
          <div class="ba-play">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff"><polygon points="5 3 19 12 5 21"/></svg>
          </div>
        {%- endif -%}
        <div class="ba-strip-body">
          {%- if section.settings.strip2_label != blank -%}
            <p class="ba-strip-label">{{ section.settings.strip2_label }}</p>
          {%- endif -%}
          {%- if section.settings.strip2_title != blank -%}
            <h3 class="ba-strip-title">{{ section.settings.strip2_title }}</h3>
          {%- endif -%}
          {%- if section.settings.strip2_desc != blank -%}
            <p class="ba-strip-desc">{{ section.settings.strip2_desc }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</div>

<script>
(function(){
  var root = document.getElementById('ba-{{ section.id }}');
  if (!root) return;
  var els = root.querySelectorAll('.rv');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.08 });
    els.forEach(function(el, i){
      el.style.transitionDelay = Math.min(i * 0.04, 0.3) + 's';
      io.observe(el);
    });
  } else {
    els.forEach(function(el){ el.classList.add('in'); });
  }
})();
</script>

{% schema %}
{
  "name": "Branding Activations",
  "tag": "section",
  "settings": [
    { "type": "header",   "content": "Header" },
    { "type": "text",     "id": "eyebrow",      "label": "Eyebrow text",   "default": "Services" },
    { "type": "text",     "id": "title_line1",  "label": "Title line 1",   "default": "BRANDING" },
    { "type": "text",     "id": "title_line2",  "label": "Title line 2 (outlined)", "default": "& CONTENT" },
    { "type": "text",     "id": "title_line3",  "label": "Title line 3",   "default": "ACTIVATIONS" },
    { "type": "textarea", "id": "description",  "label": "Description",    "default": "Branding is crucial for establishing a unique identity and ensuring a company's success. We offer branding services that include social media content, partnerships, and written articles." },

    { "type": "header",      "content": "Brand Showcase Label" },
    { "type": "text",        "id": "grid1_label", "label": "Label",         "default": "Brand Showcase" },

    { "type": "header",      "content": "Feature Strip 1" },
    { "type": "image_picker","id": "strip1_image",    "label": "Image" },
    { "type": "text",        "id": "strip1_label",    "label": "Kicker label" },
    { "type": "text",        "id": "strip1_title",    "label": "Title" },
    { "type": "textarea",    "id": "strip1_desc",     "label": "Description" },
    { "type": "checkbox",    "id": "strip1_playable", "label": "Show play button", "default": false },

    { "type": "header",      "content": "Travel & Experience Label" },
    { "type": "text",        "id": "grid2_label", "label": "Label",         "default": "Travel & Experience Brands" },

    { "type": "header",      "content": "Feature Strip 2" },
    { "type": "image_picker","id": "strip2_image",    "label": "Image" },
    { "type": "text",        "id": "strip2_label",    "label": "Kicker label" },
    { "type": "text",        "id": "strip2_title",    "label": "Title" },
    { "type": "textarea",    "id": "strip2_desc",     "label": "Description" },
    { "type": "checkbox",    "id": "strip2_playable", "label": "Show play button", "default": false }
  ],
  "blocks": [
    {
      "type": "brand_card",
      "name": "Brand Card",
      "settings": [
        { "type": "image_picker", "id": "image",    "label": "Image" },
        { "type": "text",         "id": "name",     "label": "Brand name",   "default": "POLAROID" },
        { "type": "text",         "id": "subtitle", "label": "Subtitle" },
        { "type": "text",         "id": "tag",      "label": "Tag pill" },
        { "type": "select",       "id": "row",      "label": "Grid row",
          "options": [
            { "value": "1", "label": "Row 1 — Brand Showcase" },
            { "value": "2", "label": "Row 2 — Brand Showcase" },
            { "value": "3", "label": "Row 3 — Travel & Experience" }
          ],
          "default": "1"
        },
        { "type": "select", "id": "span", "label": "Column width",
          "options": [
            { "value": "wide",   "label": "Wide (5 cols)" },
            { "value": "medium", "label": "Medium (4 cols)" },
            { "value": "narrow", "label": "Narrow (3 cols)" }
          ],
          "default": "medium"
        },
        { "type": "select", "id": "height", "label": "Height",
          "options": [
            { "value": "tall",  "label": "Tall" },
            { "value": "mid",   "label": "Mid" },
            { "value": "short", "label": "Short" }
          ],
          "default": "mid"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Branding Activations",
      "blocks": [
        { "type": "brand_card", "settings": { "name": "POLAROID",   "tag": "Photography",  "row": "1", "span": "medium", "height": "tall" } },
        { "type": "brand_card", "settings": { "name": "WANDRD",     "tag": "Gear",         "row": "1", "span": "wide",   "height": "tall" } },
        { "type": "brand_card", "settings": { "name": "MONSTER",    "tag": "Lifestyle",    "row": "1", "span": "narrow", "height": "tall" } },
        { "type": "brand_card", "settings": { "name": "POPPY.CA",   "tag": "Wellness",     "row": "2", "span": "narrow", "height": "mid"  } },
        { "type": "brand_card", "settings": { "name": "FURTRADERS", "tag": "Fashion",      "row": "2", "span": "medium", "height": "mid"  } },
        { "type": "brand_card", "settings": { "name": "SUPRAMOOD",  "tag": "Wellness",     "row": "2", "span": "medium", "height": "mid"  } },
        { "type": "brand_card", "settings": { "name": "DJI",        "tag": "Tech",         "row": "2", "span": "narrow", "height": "mid"  } },
