                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-red-400" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg>
                            <span class="text-white font-medium">{{ section.settings.benefits_without_label | default: "Without This Course" }}</span>
                          </div>
                          <div class="space-y-3">
                            {% for item in without_items %}{% assign line = item | strip %}{% if line != blank %}
                            <div class="flex items-start gap-2">
                              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-red-400 mt-0.5 flex-shrink-0" aria-hidden="true"><path d="M5 12h14"></path></svg>
                              <span class="text-white/50 text-sm">{{ line }}</span>
                            </div>
                            {% endif %}{% endfor %}
                          </div>
                        </div>
                        <div class="p-6 rounded-2xl border {% if color_theme == 'purple' %}border-purple-500/30 bg-purple-500/10{% elsif color_theme == 'emerald' %}border-emerald-500/30 bg-emerald-500/10{% elsif color_theme == 'amber' %}border-amber-500/30 bg-amber-500/10{% else %}border-blue-500/30 bg-blue-500/10{% endif %}">
                          <div class="flex items-center gap-2 mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-emerald-400" aria-hidden="true"><path d="M21.801 10A10 10 0 1 1 17 3.335"></path><path d="m9 11 3 3L22 4"></path></svg>
                            <span class="text-white font-medium">{{ section.settings.benefits_with_label | default: "With This Course" }}</span>
                          </div>
                          <div class="space-y-3">
                            {% for item in with_items %}{% assign line = item | strip %}{% if line != blank %}
