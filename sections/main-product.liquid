                            {% for i in (0..3) %}
                              {% assign prog_idx = i | times: 2 %}
                              {% assign prog_idx_pct = prog_idx | plus: 1 %}
                              {% assign plabel = prog_parts[prog_idx] | strip %}
                              {% assign pct = prog_parts[prog_idx_pct] | strip %}
                              <div class="space-y-1">
                                <div class="flex justify-between text-sm"><span class="text-white/70">{{ plabel }}</span><span class="text-white font-medium">{{ pct }}%</span></div>
                                <div class="h-2 bg-white/10 rounded-full overflow-hidden">
                                  <div class="h-full rounded-full {% if color_theme == 'purple' %}bg-gradient-to-r from-purple-500 to-pink-500{% elsif color_theme == 'emerald' %}bg-gradient-to-r from-emerald-500 to-teal-500{% elsif color_theme == 'amber' %}bg-gradient-to-r from-amber-500 to-orange-500{% else %}bg-gradient-to-r from-blue-500 to-cyan-500{% endif %}" style="width: {{ pct }}%;"></div>
                                </div>
                              </div>
                            {% endfor %}
                          </div>
                        </div>
                      {% endif %}
                    {% endif %}
                    {% if benefits_without_list_str != blank or benefits_with_list_str != blank %}
                      {% assign without_items = benefits_without_list_str | split: '|' %}
                      {% assign with_items = benefits_with_list_str | split: '|' %}
