{% comment %}
  Product detail: dark layout, color theme from product/collection metafield or section default.
  Tabs (Overview, Benefits, Features, FAQ) use product METAFIELDS only — no snippets, no section blocks.
  See docs/IMPLEMENTATION-PRODUCT-PAGE.md for metafield setup.
{% endcomment %}
{% assign first_collection = product.collections.first %}
{% assign color_theme = product.metafields.custom.color_theme.value | default: first_collection.metafields.custom.color_theme.value | default: section.settings.default_color_theme | default: 'blue' %}
{% assign badge_label = product.metafields.custom.badge_label.value | default: product.type | default: section.settings.default_badge_label %}
{% assign overview_content = product.metafields.custom.overview | default: nil %}
{% assign benefits_content = product.metafields.custom.benefits | default: nil %}
{% assign features_content = product.metafields.custom.features | default: nil %}
{% assign faqs_content = product.metafields.custom.faqs | default: nil %}
{% assign has_overview = overview_content != blank or product.description != blank %}
{% assign has_benefits = benefits_content != blank %}
{% assign has_features = features_content != blank %}
{% assign has_faqs = faqs_content != blank %}
{% assign product_category = product.metafields.custom.category.value | default: product.type | default: section.settings.default_category %}
{% assign product_version = product.metafields.custom.version.value | default: section.settings.default_version %}
{% assign product_last_updated = product.metafields.custom.last_updated.value | default: section.settings.default_last_updated %}
{% assign product_license = product.metafields.custom.license.value | default: section.settings.default_license %}
{% assign whats_included_str = product.metafields.custom.whats_included.value | default: section.settings.default_whats_included %}
{% assign whats_included_items = whats_included_str | split: '|' %}
{% assign shop_url = section.settings.shop_url | default: routes.root_url %}
{% assign collection_for_breadcrumb = product.collections.first %}


<main class="bg-black min-h-screen relative" data-testid="product-detail-page" {{ section.shopify_attributes }}>
  <div class="fixed inset-0 overflow-hidden pointer-events-none z-0" aria-hidden="true">
    {% if color_theme == 'purple' %}
      <div class="absolute rounded-full blur-3xl w-[600px] h-[600px] left-[10%] top-[20%]" style="background: radial-gradient(circle, rgba(139, 92, 246, 0.082), transparent 70%);"></div>
      <div class="absolute rounded-full blur-3xl w-[500px] h-[500px] right-[10%] bottom-[20%]" style="background: radial-gradient(circle, rgba(236, 72, 153, 0.063), transparent 70%);"></div>
    {% elsif color_theme == 'emerald' %}
      <div class="absolute rounded-full blur-3xl w-[600px] h-[600px] left-[10%] top-[20%]" style="background: radial-gradient(circle, rgba(16, 185, 129, 0.08), transparent 70%);"></div>
      <div class="absolute rounded-full blur-3xl w-[500px] h-[500px] right-[10%] bottom-[20%]" style="background: radial-gradient(circle, rgba(20, 184, 166, 0.06), transparent 70%);"></div>
    {% elsif color_theme == 'amber' %}
      <div class="absolute rounded-full blur-3xl w-[600px] h-[600px] left-[10%] top-[20%]" style="background: radial-gradient(circle, rgba(245, 158, 11, 0.08), transparent 70%);"></div>
      <div class="absolute rounded-full blur-3xl w-[500px] h-[500px] right-[10%] bottom-[20%]" style="background: radial-gradient(circle, rgba(249, 115, 22, 0.06), transparent 70%);"></div>
    {% else %}
      <div class="absolute rounded-full blur-3xl w-[600px] h-[600px] left-[10%] top-[20%]" style="background: radial-gradient(circle, rgba(59, 130, 246, 0.08), transparent 70%);"></div>
      <div class="absolute rounded-full blur-3xl w-[500px] h-[500px] right-[10%] bottom-[20%]" style="background: radial-gradient(circle, rgba(6, 182, 212, 0.06), transparent 70%);"></div>
    {% endif %}
  </div>

  <div class="relative z-10 pt-28 pb-8">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
      <nav class="flex items-center gap-2 text-sm" aria-label="Breadcrumb">
        <a class="text-white/40 hover:text-white transition-colors" href="{{ shop_url }}">{{ section.settings.breadcrumb_shop | default: 'Shop' }}</a>
        <span class="text-white/20" aria-hidden="true">/</span>
        {% if collection_for_breadcrumb %}
          <a class="text-white/40 hover:text-white transition-colors capitalize" href="{{ collection_for_breadcrumb.url }}">{{ collection_for_breadcrumb.title }}</a>
          <span class="text-white/20" aria-hidden="true">/</span>
        {% endif %}
        <span class="text-white/60 truncate max-w-[200px]" aria-current="page">{{ product.title }}</span>
      </nav>
    </div>
  </div>

  <section class="relative z-10 pb-16">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
        <div class="relative">
          {% if color_theme == 'purple' %}
            <div class="absolute -inset-4 bg-gradient-to-r from-purple-500 to-pink-500 opacity-10 blur-3xl rounded-3xl" aria-hidden="true"></div>
          {% elsif color_theme == 'emerald' %}
            <div class="absolute -inset-4 bg-gradient-to-r from-emerald-500 to-teal-500 opacity-10 blur-3xl rounded-3xl" aria-hidden="true"></div>
          {% elsif color_theme == 'amber' %}
            <div class="absolute -inset-4 bg-gradient-to-r from-amber-500 to-orange-500 opacity-10 blur-3xl rounded-3xl" aria-hidden="true"></div>
          {% else %}
            <div class="absolute -inset-4 bg-gradient-to-r from-blue-500 to-cyan-500 opacity-10 blur-3xl rounded-3xl" aria-hidden="true"></div>
          {% endif %}
          <div class="relative aspect-[4/3] rounded-2xl overflow-hidden bg-white/[0.02] border border-white/10">
            {% if product.featured_image %}
              <img
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                class="w-full h-full object-cover"
                src="{{ product.featured_image | image_url: width: 800 }}"
                width="800"
                height="600"
                loading="eager"
              >
            {% else %}
              <div class="w-full h-full flex items-center justify-center text-white/30">No image</div>
            {% endif %}
            {% if badge_label != blank %}
              <div class="absolute top-4 left-4">
                <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-white text-xs font-medium {% if color_theme == 'purple' %}bg-gradient-to-r from-purple-500 to-pink-500{% elsif color_theme == 'emerald' %}bg-gradient-to-r from-emerald-500 to-teal-500{% elsif color_theme == 'amber' %}bg-gradient-to-r from-amber-500 to-orange-500{% else %}bg-gradient-to-r from-blue-500 to-cyan-500{% endif %}">
                  {% if section.settings.badge_icon == 'graduation_cap' %}<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5" aria-hidden="true"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"></path><path d="M22 10v6"></path><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"></path></svg>{% elsif section.settings.badge_icon == 'bot' %}<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5" aria-hidden="true"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path></svg>{% elsif section.settings.badge_icon == 'layout' %}<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M3 9h18"></path><path d="M9 21V9"></path></svg>{% endif %}
                  {{ badge_label }}
                </span>
              </div>
            {% endif %}
          </div>
          <div class="flex gap-3 mt-4">
            {% for image in product.images limit: 3 %}
              <div class="w-20 h-20 rounded-lg bg-white/[0.02] border border-white/10 overflow-hidden {% if forloop.first %}border-2 border-white/20{% endif %}">
                <img src="{{ image | image_url: width: 160 }}" alt="{{ image.alt | escape }}" width="80" height="80" class="w-full h-full object-cover" loading="lazy">
              </div>
            {% endfor %}
            {% if product.images.size == 0 %}
              <div class="w-20 h-20 rounded-lg bg-white/[0.02] border-2 border-white/20"></div>
              <div class="w-20 h-20 rounded-lg bg-white/[0.02] border border-white/10"></div>
              <div class="w-20 h-20 rounded-lg bg-white/[0.02] border border-white/10"></div>
            {% endif %}
          </div>
        </div>

        <div>
          {% if section.settings.show_rating %}
            <div class="flex items-center gap-3 mb-4">
              <div class="flex items-center gap-1" aria-hidden="true">
                {% for i in (1..5) %}<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-yellow-400" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path></svg>{% endfor %}
              </div>
              <span class="text-white/40 text-sm">{{ section.settings.rating_text | default: '5.0 (24 reviews)' }}</span>
            </div>
          {% endif %}
          <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">{{ product.title }}</h1>
          <p class="text-lg text-white/60 mb-6 leading-relaxed">{{ product.description | strip_html | truncate: 200 }}</p>
          {% if product.tags.size > 0 %}
            <div class="mb-8">
              <div class="grid grid-cols-2 gap-3">
                {% for tag in product.tags limit: 6 %}
                  <div class="flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-emerald-400 flex-shrink-0" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
                    <span class="text-white/70 text-sm">{{ tag }}</span>
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endif %}
          <div class="flex items-baseline gap-3 mb-6">
            <span class="text-4xl font-black text-white">{{ product.price | money }}</span>
            {% if product.compare_at_price > product.price %}
              <span class="text-white/40 line-through">{{ product.compare_at_price | money }}</span>
            {% endif %}
          </div>
          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <form action="{{ routes.cart_add_url }}" method="post" class="flex-1">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" name="add" class="w-full flex items-center justify-center gap-2 px-8 py-4 rounded-full font-semibold text-lg text-white {% if color_theme == 'purple' %}bg-gradient-to-r from-purple-500 to-pink-500{% elsif color_theme == 'emerald' %}bg-gradient-to-r from-emerald-500 to-teal-500{% elsif color_theme == 'amber' %}bg-gradient-to-r from-amber-500 to-orange-500{% else %}bg-gradient-to-r from-blue-500 to-cyan-500{% endif %}">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5" aria-hidden="true"><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path></svg>
                {{ section.settings.buy_button_text | default: 'Buy Now' }}
              </button>
            </form>
            {% if section.settings.show_wishlist %}
              <button type="button" class="flex items-center justify-center gap-2 px-6 py-4 rounded-full font-semibold border border-white/20 text-white hover:bg-white/10 transition-colors" aria-label="Save"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg></button>
            {% endif %}
            <button type="button" class="flex items-center justify-center w-14 h-14 rounded-full border border-white/20 text-white/60 hover:bg-white/10 transition-colors" aria-label="Share"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line></svg></button>
          </div>
          <div class="flex flex-wrap gap-4 p-4 rounded-xl bg-white/[0.02] border border-white/10">
            <div class="flex items-center gap-2 text-sm text-white/50"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg><span>{{ section.settings.guarantee_1 | default: 'Instant Download' }}</span></div>
            <div class="flex items-center gap-2 text-sm text-white/50"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path></svg><span>{{ section.settings.guarantee_2 | default: '14-Day Guarantee' }}</span></div>
            <div class="flex items-center gap-2 text-sm text-white/50"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path></svg><span>{{ section.settings.guarantee_3 | default: 'Lifetime Access' }}</span></div>
          </div>
          {% if section.settings.show_downloads_placeholder %}
            <div class="mt-6">
              <div class="flex items-center gap-4 p-4 rounded-2xl bg-white/[0.02] border border-white/10">
                <div class="w-12 h-12 rounded-xl bg-emerald-500/20 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6 text-emerald-400"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg>
                </div>
                <div>
                  <div class="text-2xl font-bold text-white">{{ product.metafields.custom.downloads_count.value | default: section.settings.downloads_placeholder }}{% if section.settings.downloads_placeholder != blank %}+{% endif %}</div>
                  <div class="text-white/50 text-sm">{{ section.settings.downloads_label | default: 'Downloads' }}</div>
                </div>
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  {% if section.settings.banner_text != blank %}
    <div class="relative z-10 py-4 border-y border-white/5 bg-white/[0.01]">
      <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
        <div class="flex items-center justify-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-emerald-400"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg>
          <span class="text-white/70 text-sm">{{ section.settings.banner_text }}</span>
        </div>
      </div>
    </div>
  {% endif %}

  {% comment %} Tab content from product metafields (custom.overview, .benefits, .features, .faqs) only; no snippet. {% endcomment %}
  {% if has_overview or has_benefits or has_features or has_faqs %}
    <section class="relative z-10 border-t border-white/10" id="product-tabs">
      <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
        <div class="flex gap-8 overflow-x-auto border-b border-white/10" role="tablist" aria-label="Product details">
          {% if has_overview %}<button type="button" class="product-tab py-5 text-sm font-medium border-b-2 transition-colors whitespace-nowrap border-white text-white" role="tab" aria-selected="true" data-tab="overview">Overview</button>{% endif %}
          {% if has_benefits %}<button type="button" class="product-tab py-5 text-sm font-medium border-b-2 transition-colors whitespace-nowrap border-transparent text-white/40 hover:text-white" role="tab" aria-selected="false" data-tab="benefits">Benefits</button>{% endif %}
          {% if has_features %}<button type="button" class="product-tab py-5 text-sm font-medium border-b-2 transition-colors whitespace-nowrap border-transparent text-white/40 hover:text-white" role="tab" aria-selected="false" data-tab="features">Features</button>{% endif %}
          {% if has_faqs %}<button type="button" class="product-tab py-5 text-sm font-medium border-b-2 transition-colors whitespace-nowrap border-transparent text-white/40 hover:text-white" role="tab" aria-selected="false" data-tab="faqs">FAQs</button>{% endif %}
        </div>
      </div>
    </section>

    <section class="relative z-10 py-16 lg:py-24">
      <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-3 gap-12">
          <div class="lg:col-span-2">
            <div id="tab-overview" class="product-tab-panel" role="tabpanel" aria-labelledby="tab-overview" {% unless has_overview %}hidden{% endunless %}>
              {% if has_overview %}
                <h2 class="text-2xl font-bold text-white mb-6">About This Product</h2>
                <div class="prose prose-invert max-w-none">
                  {% if overview_content != blank %}
                    <div class="text-white/60 leading-relaxed mb-6">{{ overview_content }}</div>
                  {% else %}
                    <div class="text-white/60 leading-relaxed mb-6">{{ product.description }}</div>
                  {% endif %}
                  {% if whats_included_items.size > 0 %}
                    <h3 class="text-xl font-bold text-white mt-8 mb-4">What's Included</h3>
                    <ul class="space-y-3 list-none p-0 m-0">
                      {% for item in whats_included_items %}
                        {% assign line = item | strip %}
                        {% if line != blank %}
                          <li class="flex items-start gap-3 text-white/60">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0"><path d="M20 6 9 17l-5-5"></path></svg>
                            <span>{{ line }}</span>
                          </li>
                        {% endif %}
                      {% endfor %}
                    </ul>
                  {% endif %}
                </div>
              {% endif %}
            </div>
            <div id="tab-benefits" class="product-tab-panel" role="tabpanel" {% unless has_benefits %}hidden{% endunless %} {% if has_benefits %}aria-labelledby="tab-benefits"{% endif %}>
              {% if has_benefits %}
                <h2 class="text-2xl font-bold text-white mb-6">Benefits</h2>
                <div class="prose prose-invert max-w-none text-white/60">{{ benefits_content }}</div>
              {% endif %}
            </div>
            <div id="tab-features" class="product-tab-panel" role="tabpanel" {% unless has_features %}hidden{% endunless %} {% if has_features %}aria-labelledby="tab-features"{% endif %}>
              {% if has_features %}
                <h2 class="text-2xl font-bold text-white mb-6">Features</h2>
                <div class="prose prose-invert max-w-none text-white/60">{{ features_content }}</div>
              {% endif %}
            </div>
            <div id="tab-faqs" class="product-tab-panel" role="tabpanel" {% unless has_faqs %}hidden{% endunless %} {% if has_faqs %}aria-labelledby="tab-faqs"{% endif %}>
              {% if has_faqs %}
                <h2 class="text-2xl font-bold text-white mb-6">FAQs</h2>
                <div class="prose prose-invert max-w-none text-white/60">{{ faqs_content }}</div>
              {% endif %}
            </div>
          </div>
          <div>
            <h3 class="text-lg font-bold text-white mb-4">Product Details</h3>
            <div class="space-y-4">
              <div class="flex justify-between py-3 border-b border-white/10"><span class="text-white/40">Category</span><span class="text-white">{{ product_category }}</span></div>
              <div class="flex justify-between py-3 border-b border-white/10"><span class="text-white/40">Version</span><span class="text-white">{{ product_version }}</span></div>
              <div class="flex justify-between py-3 border-b border-white/10"><span class="text-white/40">Last Updated</span><span class="text-white">{{ product_last_updated }}</span></div>
              <div class="flex justify-between py-3 border-b border-white/10"><span class="text-white/40">License</span><span class="text-white">{{ product_license }}</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>
  {% else %}
    {% comment %} No tabs: still show description and product details if useful {% endcomment %}
    <section class="relative z-10 py-16 lg:py-24 border-t border-white/10">
      <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-3 gap-12">
          <div class="lg:col-span-2">
            <h2 class="text-2xl font-bold text-white mb-6">About This Product</h2>
            <div class="prose prose-invert max-w-none text-white/60">{{ product.description }}</div>
          </div>
          <div>
            <h3 class="text-lg font-bold text-white mb-4">Product Details</h3>
            <div class="space-y-4">
              <div class="flex justify-between py-3 border-b border-white/10"><span class="text-white/40">Category</span><span class="text-white">{{ product_category }}</span></div>
              <div class="flex justify-between py-3 border-b border-white/10"><span class="text-white/40">Version</span><span class="text-white">{{ product_version }}</span></div>
              <div class="flex justify-between py-3 border-b border-white/10"><span class="text-white/40">Last Updated</span><span class="text-white">{{ product_last_updated }}</span></div>
              <div class="flex justify-between py-3 border-b border-white/10"><span class="text-white/40">License</span><span class="text-white">{{ product_license }}</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>
  {% endif %}

  <section class="relative z-10 py-16 lg:py-24 border-t border-white/10">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
      <div class="relative rounded-3xl overflow-hidden">
        <div class="absolute inset-0 opacity-10 {% if color_theme == 'purple' %}bg-gradient-to-r from-purple-500 to-pink-500{% elsif color_theme == 'emerald' %}bg-gradient-to-r from-emerald-500 to-teal-500{% elsif color_theme == 'amber' %}bg-gradient-to-r from-amber-500 to-orange-500{% else %}bg-gradient-to-r from-blue-500 to-cyan-500{% endif %}"></div>
        <div class="relative p-8 md:p-12 lg:p-16">
          <div class="max-w-2xl">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{{ section.settings.cta_heading | default: 'Get Unlimited Access' }}</h2>
            <p class="text-lg text-white/60 mb-8">{{ section.settings.cta_text }}</p>
            <div class="flex flex-col sm:flex-row gap-4">
              {% if section.settings.cta_primary_label != blank %}
                <a class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white text-black rounded-full font-semibold hover:bg-gray-200 transition-colors" href="{{ section.settings.cta_primary_url | default: shop_url }}">{{ section.settings.cta_primary_label }}<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a>
              {% endif %}
              {% if section.settings.cta_secondary_label != blank and section.settings.cta_secondary_url != blank %}
                <a class="inline-flex items-center justify-center gap-2 px-8 py-4 border border-white/20 text-white rounded-full font-semibold hover:bg-white/10 transition-colors" href="{{ section.settings.cta_secondary_url }}">{{ section.settings.cta_secondary_label }}</a>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<script>
(function() {
  var tabs = document.querySelectorAll('.product-tab');
  var panels = document.querySelectorAll('.product-tab-panel');
  tabs.forEach(function(t) {
    t.addEventListener('click', function() {
      var id = this.getAttribute('data-tab');
      tabs.forEach(function(tab) {
        tab.setAttribute('aria-selected', tab.getAttribute('data-tab') === id ? 'true' : 'false');
        tab.classList.toggle('border-white', tab.getAttribute('data-tab') === id);
        tab.classList.toggle('text-white', tab.getAttribute('data-tab') === id);
        tab.classList.toggle('border-transparent', tab.getAttribute('data-tab') !== id);
        tab.classList.toggle('text-white/40', tab.getAttribute('data-tab') !== id);
      });
      panels.forEach(function(p) {
        p.hidden = p.id !== 'tab-' + id;
      });
    });
  });
})();
</script>

{% schema %}
