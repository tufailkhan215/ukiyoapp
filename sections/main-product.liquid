    </div>
  </section>
</main>

<script>
(function() {
  var tabs = document.querySelectorAll('.product-tab');
  var panels = document.querySelectorAll('.product-tab-panel');
  tabs.forEach(function(t) {
    t.addEventListener('click', function() {
      var id = this.getAttribute('data-tab');
      tabs.forEach(function(tab) {
        tab.setAttribute('aria-selected', tab.getAttribute('data-tab') === id ? 'true' : 'false');
        tab.classList.toggle('border-white', tab.getAttribute('data-tab') === id);
        tab.classList.toggle('text-white', tab.getAttribute('data-tab') === id);
        tab.classList.toggle('border-transparent', tab.getAttribute('data-tab') !== id);
        tab.classList.toggle('text-white/40', tab.getAttribute('data-tab') !== id);
      });
      panels.forEach(function(p) {
        p.hidden = p.id !== 'tab-' + id;
      });
    });
  });

  var faqTriggers = document.querySelectorAll('.product-faq-accordion [data-faq-trigger]');
  faqTriggers.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var item = this.closest('.product-faq-accordion-item');
      var content = item.querySelector('.product-faq-accordion-content');
      var isOpen = this.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll('.product-faq-accordion-item').forEach(function(other) {
        var oBtn = other.querySelector('[data-faq-trigger]');
        var oContent = other.querySelector('.product-faq-accordion-content');
        if (other !== item) {
          oBtn.setAttribute('aria-expanded', 'false');
          oContent.style.maxHeight = '0';
          oContent.style.opacity = '0';
        }
      });
      if (!isOpen) {
        this.setAttribute('aria-expanded', 'true');
        content.style.maxHeight = content.scrollHeight + 'px';
        content.style.opacity = '1';
      } else {
        this.setAttribute('aria-expanded', 'false');
        content.style.maxHeight = '0';
        content.style.opacity = '0';
      }
    });
  });

  var bannerStrip = document.querySelector('.product-banner-strip');
  if (bannerStrip) {
    var slides = bannerStrip.querySelectorAll('.product-banner-slide');
    var duration = parseInt(bannerStrip.getAttribute('data-slide-duration'), 10) || 4;
    if (slides.length > 1) {
      var current = 0;
      setInterval(function() {
        var next = (current + 1) % slides.length;
        var currentEl = slides[current];
        var nextEl = slides[next];
        currentEl.classList.add('product-banner-slide-out');
        currentEl.classList.remove('product-banner-slide-active');
        currentEl.setAttribute('aria-hidden', 'true');
        nextEl.classList.add('product-banner-slide-in');
        nextEl.setAttribute('aria-hidden', 'false');
        setTimeout(function() {
          currentEl.classList.remove('product-banner-slide-out');
          nextEl.classList.remove('product-banner-slide-in');
          nextEl.classList.add('product-banner-slide-active');
          current = next;
        }, 300);
      }, duration * 1000);
    }
  }

  var wishlistBtn = document.querySelector('.product-wishlist-btn');
  if (wishlistBtn) {
    var productId = wishlistBtn.getAttribute('data-product-id');
    var productData = {
      id: productId,
      title: wishlistBtn.getAttribute('data-product-title'),
      price: wishlistBtn.getAttribute('data-product-price'),
      url: wishlistBtn.getAttribute('data-product-url'),
      handle: wishlistBtn.getAttribute('data-product-handle'),
      image: wishlistBtn.getAttribute('data-product-image') || ''
    };
    var wishlistKey = 'ukiyo_wishlist';
    var icon = wishlistBtn.querySelector('.product-wishlist-icon');
    var text = wishlistBtn.querySelector('.product-wishlist-text');
    
    function getWishlist() {
      try {
        var stored = localStorage.getItem(wishlistKey);
        return stored ? JSON.parse(stored) : [];
      } catch (e) {
        return [];
      }
    }
    
    function saveWishlist(items) {
      try {
        localStorage.setItem(wishlistKey, JSON.stringify(items));
        if (typeof window.updateWishlistPage === 'function') {
          window.updateWishlistPage();
        }
      } catch (e) {
        console.warn('Could not save wishlist:', e);
      }
    }
    
    function isSaved() {
      var wishlist = getWishlist();
      return wishlist.some(function(item) { return item.id === productId; });
    }
    
    function updateButtonState(saved) {
      if (saved) {
        wishlistBtn.classList.add('product-wishlist-saved');
        wishlistBtn.classList.remove('border-white/20');
        wishlistBtn.classList.add('border-red-500/50', 'bg-red-500/10');
        if (icon) {
          icon.style.fill = 'currentColor';
          icon.style.stroke = 'currentColor';
        }
        if (text) text.textContent = 'Saved';
        wishlistBtn.setAttribute('aria-label', 'Remove from wishlist');
      } else {
        wishlistBtn.classList.remove('product-wishlist-saved', 'border-red-500/50', 'bg-red-500/10');
        wishlistBtn.classList.add('border-white/20');
        if (icon) {
          icon.style.fill = 'none';
          icon.style.stroke = 'currentColor';
        }
        if (text) text.textContent = 'Save';
        wishlistBtn.setAttribute('aria-label', 'Save to wishlist');
      }
    }
    
    function toggleWishlist() {
      var wishlist = getWishlist();
      var index = wishlist.findIndex(function(item) { return item.id === productId; });
      if (index === -1) {
        wishlist.push(productData);
        updateButtonState(true);
      } else {
        wishlist.splice(index, 1);
        updateButtonState(false);
      }
      saveWishlist(wishlist);
      wishlistBtn.classList.add('product-wishlist-animating');
      setTimeout(function() {
        wishlistBtn.classList.remove('product-wishlist-animating');
      }, 300);
    }
    
    wishlistBtn.addEventListener('click', toggleWishlist);
    updateButtonState(isSaved());
  }

  // Product Share Functionality
  var shareBtn = document.querySelector('.product-share-btn');
  var shareDropdown = document.querySelector('.product-share-dropdown');
  var shareLinks = document.querySelectorAll('.product-share-link');
  
  if (shareBtn && shareDropdown) {
    var productTitle = shareBtn.getAttribute('data-product-title');
    var productUrl = shareBtn.getAttribute('data-product-url');
    var productImage = shareBtn.getAttribute('data-product-image');
    
    function toggleShareDropdown() {
      var isExpanded = shareBtn.getAttribute('aria-expanded') === 'true';
      shareBtn.setAttribute('aria-expanded', !isExpanded);
      if (!isExpanded) {
        shareDropdown.classList.remove('opacity-0', 'invisible');
        shareDropdown.classList.add('opacity-100', 'visible');
      } else {
        shareDropdown.classList.remove('opacity-100', 'visible');
        shareDropdown.classList.add('opacity-0', 'invisible');
      }
    }
    
    function closeShareDropdown() {
      shareBtn.setAttribute('aria-expanded', 'false');
      shareDropdown.classList.remove('opacity-100', 'visible');
      shareDropdown.classList.add('opacity-0', 'invisible');
    }
    
    shareBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      toggleShareDropdown();
    });
    
    shareLinks.forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        var platform = this.getAttribute('data-platform');
        var shareText = productTitle + ' - ' + productUrl;
        
        if (platform === 'facebook') {
          window.open('https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(productUrl), '_blank', 'width=600,height=400');
        } else if (platform === 'twitter') {
          window.open('https://twitter.com/intent/tweet?text=' + encodeURIComponent(productTitle) + '&url=' + encodeURIComponent(productUrl), '_blank', 'width=600,height=400');
        } else if (platform === 'linkedin') {
          window.open('https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(productUrl), '_blank', 'width=600,height=400');
        } else if (platform === 'pinterest') {
          var pinterestUrl = 'https://pinterest.com/pin/create/button/?url=' + encodeURIComponent(productUrl) + '&description=' + encodeURIComponent(productTitle);
          if (productImage) {
            pinterestUrl += '&media=' + encodeURIComponent(productImage);
          }
          window.open(pinterestUrl, '_blank', 'width=600,height=400');
        } else if (platform === 'email') {
          window.location.href = 'mailto:?subject=' + encodeURIComponent(productTitle) + '&body=' + encodeURIComponent(productUrl);
        } else if (platform === 'copy') {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(productUrl).then(function() {
              var originalText = link.querySelector('span').textContent;
              link.querySelector('span').textContent = 'Copied!';
              setTimeout(function() {
                link.querySelector('span').textContent = originalText;
              }, 2000);
            }).catch(function() {
              fallbackCopy(productUrl, link);
            });
          } else {
            fallbackCopy(productUrl, link);
          }
        }
        
        closeShareDropdown();
      });
    });
    
    function fallbackCopy(text, linkElement) {
      var textArea = document.createElement('textarea');
      textArea.value = text;
      textArea.style.position = 'fixed';
      textArea.style.left = '-999999px';
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();
      try {
        document.execCommand('copy');
        var originalText = linkElement.querySelector('span').textContent;
        linkElement.querySelector('span').textContent = 'Copied!';
        setTimeout(function() {
          linkElement.querySelector('span').textContent = originalText;
        }, 2000);
      } catch (err) {
        console.warn('Failed to copy:', err);
      }
      document.body.removeChild(textArea);
    }
    
    document.addEventListener('click', function(e) {
      if (!shareBtn.contains(e.target) && !shareDropdown.contains(e.target)) {
        closeShareDropdown();
      }
    });
  }
})();
</script>
<style>
  .product-wishlist-icon {
    transition: all 0.2s ease;
  }
  .product-wishlist-saved .product-wishlist-icon {
    fill: currentColor;
    stroke: currentColor;
  }
  .product-wishlist-animating .product-wishlist-icon {
    transform: scale(1.2);
  }
  
  .product-share-wrapper {
    position: relative;
  }
  
  .product-share-dropdown {
    transform-origin: top right;
    transform: translateY(-8px) scale(0.95);
  }
  
  .product-share-dropdown.opacity-100.visible {
    transform: translateY(0) scale(1);
  }
  
  @media (prefers-reduced-motion: reduce) {
    .product-share-dropdown {
      transition: opacity 0.1s, visibility 0.1s;
      transform: none !important;
    }
  }
</style>

