                              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-emerald-400 mt-0.5 flex-shrink-0" aria-hidden="true"><path d="M21.801 10A10 10 0 1 1 17 3.335"></path><path d="m9 11 3 3L22 4"></path></svg>
                              <span class="text-white/70 text-sm">{{ line }}</span>
                            </div>
                            {% endif %}{% endfor %}
                          </div>
                        </div>
                      </div>
                    {% endif %}
                    {% endif %}
                  </div>
                {% else %}
                  {% comment %} Simple Benefits: list or rich text {% endcomment %}
                  {% assign benefits_heading = section.settings.benefits_heading | default: "Benefits" %}
                  {% if benefits_heading != blank %}<h2 class="text-2xl font-bold text-white mb-6">{{ benefits_heading }}</h2>{% endif %}
