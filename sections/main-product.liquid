                                    <circle cx="50" cy="50" r="40" fill="none" stroke="{% if color_theme == 'purple' %}#8B5CF6{% elsif color_theme == 'emerald' %}#10B981{% elsif color_theme == 'amber' %}#F59E0B{% else %}#3B82F6{% endif %}" stroke-width="8" stroke-linecap="round" stroke-dasharray="251.33" stroke-dashoffset="{{ offset_show }}"></circle>
                                  </svg>
                                  <div class="absolute inset-0 flex items-center justify-center"><span class="text-xl font-bold text-white">{{ v }}%</span></div>
                                </div>
                                <span class="text-white/50 text-sm mt-2 text-center">{{ lbl }}</span>
                              </div>
                            {% endfor %}
                          </div>
                        </div>
                      {% endif %}
                    {% endif %}
                    {% if benefits_progress_str != blank %}
                      {% assign prog_parts = benefits_progress_str | split: '|' %}
                      {% if prog_parts.size >= 8 %}
