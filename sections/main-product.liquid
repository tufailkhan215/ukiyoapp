{% comment %}
  Single product page: dark layout, color theme per product/collection, tabs (Overview, Benefits, Features, FAQs).
  Color theme: product.metafields.custom.color_theme > first collection's custom.color_theme > section setting.
  Tab content: product description + metafields (whats_included, benefits, features, faqs).
{% endcomment %}
{% assign color_theme = product.metafields.custom.color_theme | default: product.collections.first.metafields.custom.color_theme | default: section.settings.color_theme | default: 'blue' %}
{% assign type_badge = product.metafields.custom.type_badge | default: section.settings.default_type_badge %}
{% assign short_desc = product.metafields.custom.short_description | default: product.description | strip_html | truncate: 200 %}
{% assign feature_tags = product.metafields.custom.feature_tags.value | default: product.metafields.custom.feature_tags %}
{% assign whats_included = product.metafields.custom.whats_included.value | default: product.metafields.custom.whats_included %}
{% assign benefits_content = product.metafields.custom.benefits %}
{% assign features_content = product.metafields.custom.features %}
{% assign faq_list = product.metafields.custom.faqs.value | default: product.metafields.custom.faqs %}
{% assign faq_questions = product.metafields.custom.faq_questions.value %}
{% assign faq_answers = product.metafields.custom.faq_answers.value %}
{% assign product_version = product.metafields.custom.version | default: section.settings.default_version %}
{% assign product_license = product.metafields.custom.license | default: section.settings.default_license %}
{% assign downloads_text = product.metafields.custom.downloads_count | default: section.settings.downloads_placeholder %}

{% capture gradient_class %}
  {% if color_theme == 'amber' %}from-amber-500 to-orange-500
  {% elsif color_theme == 'emerald' %}from-emerald-500 to-teal-500
  {% elsif color_theme == 'purple' %}from-purple-500 to-pink-500
  {% else %}from-blue-500 to-cyan-500{% endif %}
{% endcapture %}
{% capture gradient_class_light %}
  {% if color_theme == 'amber' %}from-amber-400 to-orange-400
  {% elsif color_theme == 'emerald' %}from-emerald-400 to-teal-400
  {% elsif color_theme == 'purple' %}from-purple-400 to-pink-400
  {% else %}from-blue-400 to-cyan-400{% endif %}
{% endcapture %}
{% capture accent_text_class %}
  {% if color_theme == 'amber' %}text-amber-400
  {% elsif color_theme == 'emerald' %}text-emerald-400
  {% elsif color_theme == 'purple' %}text-purple-400
  {% else %}text-blue-400{% endif %}
{% endcapture %}

<main class="bg-black min-h-screen relative section-main-product" {{ section.shopify_attributes }}>
  <div class="fixed inset-0 overflow-hidden pointer-events-none z-0" aria-hidden="true">
    <div class="absolute rounded-full blur-3xl w-[600px] h-[600px] left-[10%] top-[20%] bg-gradient-to-r {{ gradient_class | strip }} opacity-[0.08]"></div>
    <div class="absolute rounded-full blur-3xl w-[500px] h-[500px] right-[10%] bottom-[20%] bg-gradient-to-r {{ gradient_class | strip }} opacity-[0.06]"></div>
  </div>

  <div class="relative z-10 pt-28 pb-8">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
      <nav class="flex items-center gap-2 text-sm" aria-label="Breadcrumb">
        <a class="text-white/40 hover:text-white transition-colors" href="{{ section.settings.shop_link | default: routes.root_url }}">{{ section.settings.breadcrumb_shop | default: 'Shop' }}</a>
        <span class="text-white/20">/</span>
        {% if product.collections.first %}
          <a class="text-white/40 hover:text-white transition-colors capitalize" href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
          <span class="text-white/20">/</span>
        {% endif %}
        <span class="text-white/60 truncate max-w-[200px]" aria-current="page">{{ product.title }}</span>
      </nav>
    </div>
  </div>

  <section class="relative z-10 pb-16">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
        <div class="relative">
          <div class="absolute -inset-4 bg-gradient-to-r {{ gradient_class | strip }} opacity-10 blur-3xl rounded-3xl" aria-hidden="true"></div>
          <div class="relative aspect-[4/3] rounded-2xl overflow-hidden bg-white/[0.02] border border-white/10">
            {% if product.featured_image %}
              <img
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                class="w-full h-full object-cover"
                src="{{ product.featured_image | image_url: width: 800 }}"
                width="800"
                height="600"
                loading="eager"
              >
            {% else %}
              <div class="w-full h-full flex items-center justify-center text-white/20">No image</div>
            {% endif %}
            {% if type_badge != blank %}
              <div class="absolute top-4 left-4">
                <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-gradient-to-r {{ gradient_class | strip }} text-white text-xs font-medium">
                  {{ type_badge }}
                </span>
              </div>
            {% endif %}
          </div>
          {% if product.images.size > 1 %}
            <div class="flex gap-3 mt-4">
              {% for image in product.images limit: 4 %}
                <button type="button" class="product-thumb w-20 h-20 rounded-lg bg-white/[0.02] border border-white/10 overflow-hidden focus:border-white/20 focus:ring-1 focus:ring-white/20" data-index="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}">
                  <img src="{{ image | image_url: width: 160 }}" alt="{{ image.alt | escape }}" class="w-full h-full object-cover" width="80" height="80" loading="lazy">
                </button>
              {% endfor %}
            </div>
          {% endif %}
        </div>

        <div class="product-info">
          {% if section.settings.show_rating %}
            <div class="flex items-center gap-3 mb-4">
              <div class="flex items-center gap-1" aria-hidden="true">
                {% for i in (1..5) %}<span class="w-4 h-4 text-yellow-400">★</span>{% endfor %}
              </div>
              <span class="text-white/40 text-sm">{{ product.metafields.reviews.rating.value.rating | default: '5.0' }} ({{ product.metafields.reviews.rating_count.value | default: 24 }} reviews)</span>
            </div>
          {% endif %}
          <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">{{ product.title }}</h1>
          <p class="text-lg text-white/60 mb-6 leading-relaxed">{{ short_desc }}</p>
          {% if feature_tags != blank and feature_tags.size > 0 %}
            <div class="mb-8">
              <div class="grid grid-cols-2 gap-3">
                {% for tag in feature_tags %}
                  <div class="flex items-center gap-2">
                    <span class="w-4 h-4 {{ accent_text_class }} flex-shrink-0" aria-hidden="true">✓</span>
                    <span class="text-white/70 text-sm">{{ tag }}</span>
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endif %}
          <div class="flex items-baseline gap-3 mb-6">
            <span class="text-4xl font-black text-white">{{ product.price | money }}</span>
            {% if product.compare_at_price > product.price %}
              <span class="text-white/40 line-through">{{ product.compare_at_price | money }}</span>
            {% endif %}
          </div>
          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <form action="{{ routes.cart_add_url }}" method="post" class="flex-1">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" name="add" class="w-full flex items-center justify-center gap-2 px-8 py-4 rounded-full font-semibold text-lg bg-gradient-to-r {{ gradient_class | strip }} text-white hover:opacity-90 transition-opacity">
                <span aria-hidden="true">🛒</span> {{ section.settings.buy_button_text | default: 'Buy Now' }}
              </button>
            </form>
            {% if section.settings.show_wishlist %}
              <button type="button" class="flex items-center justify-center gap-2 px-6 py-4 rounded-full font-semibold border border-white/20 text-white hover:bg-white/10 transition-colors" aria-label="Save">
                ♥ {{ section.settings.save_button_text | default: 'Save' }}
              </button>
            {% endif %}
            {% if section.settings.show_share %}
              <button type="button" class="flex items-center justify-center w-14 h-14 rounded-full border border-white/20 text-white/60 hover:bg-white/10 transition-colors flex-shrink-0" aria-label="Share">⎘</button>
            {% endif %}
          </div>
          <div class="flex flex-wrap gap-4 p-4 rounded-xl bg-white/[0.02] border border-white/10 mb-6">
            {% if section.settings.trust_instant %}<div class="flex items-center gap-2 text-sm text-white/50">⬇ <span>{{ section.settings.trust_instant | default: 'Instant Download' }}</span></div>{% endif %}
            {% if section.settings.trust_guarantee %}<div class="flex items-center gap-2 text-sm text-white/50">🛡 <span>{{ section.settings.trust_guarantee | default: '14-Day Guarantee' }}</span></div>{% endif %}
            {% if section.settings.trust_access %}<div class="flex items-center gap-2 text-sm text-white/50">⚡ <span>{{ section.settings.trust_access | default: 'Lifetime Access' }}</span></div>{% endif %}
          </div>
          {% if downloads_text != blank %}
            <div class="flex items-center gap-4 p-4 rounded-2xl bg-white/[0.02] border border-white/10">
              <div class="w-12 h-12 rounded-xl bg-emerald-500/20 flex items-center justify-center">
                <span class="text-emerald-400 text-xl" aria-hidden="true">⬇</span>
              </div>
              <div>
                <div class="text-2xl font-bold text-white">{{ downloads_text }}</div>
                <div class="text-white/50 text-sm">{{ section.settings.downloads_label | default: 'Downloads' }}</div>
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  {% if section.settings.show_download_banner and section.settings.download_banner_text != blank %}
    <div class="relative z-10 py-4 border-y border-white/5 bg-white/[0.01]">
      <div class="max-w-[1400px] mx-auto px-6 lg:px-12 text-center">
        <span class="text-white/70 text-sm">⬇ {{ section.settings.download_banner_text }}</span>
      </div>
    </div>
  {% endif %}

  {% assign has_overview = product.description != blank or whats_included != blank %}
  {% assign has_benefits = benefits_content != blank %}
  {% assign has_features = features_content != blank %}
  {% assign has_faqs = faq_list != blank or faq_questions != blank %}
  {% if has_overview %}{% assign first_tab = 'overview' %}
  {% elsif has_benefits %}{% assign first_tab = 'benefits' %}
  {% elsif has_features %}{% assign first_tab = 'features' %}
  {% else %}{% assign first_tab = 'faqs' %}{% endif %}

  {% if has_overview or has_benefits or has_features or has_faqs %}
    <section class="relative z-10 border-t border-white/10">
      <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
        <div class="flex gap-8 overflow-x-auto product-tabs" role="tablist" aria-label="Product details">
          {% if has_overview %}
            <button type="button" class="product-tab py-5 text-sm font-medium border-b-2 whitespace-nowrap {% if first_tab == 'overview' %}border-white text-white{% else %}border-transparent text-white/40 hover:text-white{% endif %}" role="tab" aria-selected="{% if first_tab == 'overview' %}true{% else %}false{% endif %}" data-tab="overview">{{ section.settings.tab_overview | default: 'Overview' }}</button>
          {% endif %}
          {% if has_benefits %}
            <button type="button" class="product-tab py-5 text-sm font-medium border-b-2 whitespace-nowrap {% if first_tab == 'benefits' %}border-white text-white{% else %}border-transparent text-white/40 hover:text-white{% endif %}" role="tab" aria-selected="{% if first_tab == 'benefits' %}true{% else %}false{% endif %}" data-tab="benefits">{{ section.settings.tab_benefits | default: 'Benefits' }}</button>
          {% endif %}
          {% if has_features %}
            <button type="button" class="product-tab py-5 text-sm font-medium border-b-2 whitespace-nowrap {% if first_tab == 'features' %}border-white text-white{% else %}border-transparent text-white/40 hover:text-white{% endif %}" role="tab" aria-selected="{% if first_tab == 'features' %}true{% else %}false{% endif %}" data-tab="features">{{ section.settings.tab_features | default: 'Features' }}</button>
          {% endif %}
          {% if has_faqs %}
            <button type="button" class="product-tab py-5 text-sm font-medium border-b-2 whitespace-nowrap {% if first_tab == 'faqs' %}border-white text-white{% else %}border-transparent text-white/40 hover:text-white{% endif %}" role="tab" aria-selected="{% if first_tab == 'faqs' %}true{% else %}false{% endif %}" data-tab="faqs">{{ section.settings.tab_faqs | default: 'FAQs' }}</button>
          {% endif %}
        </div>
      </div>
    </section>

    <section class="relative z-10 py-16 lg:py-24">
      <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-3 gap-12">
          <div class="lg:col-span-2">
            <div id="tab-overview" class="product-tab-panel {% if first_tab != 'overview' %}hidden{% endif %}" role="tabpanel" aria-labelledby="tab-overview">
              <h2 class="text-2xl font-bold text-white mb-6">{{ section.settings.overview_heading | default: 'About This Product' }}</h2>
              <div class="prose prose-invert max-w-none">
                {% if product.description != blank %}
                  <div class="text-white/60 leading-relaxed mb-6">{{ product.description }}</div>
                {% endif %}
                {% if whats_included != blank %}
                  <h3 class="text-xl font-bold text-white mt-8 mb-4">{{ section.settings.whats_included_heading | default: "What's Included" }}</h3>
                  <ul class="space-y-3">
                    {% for item in whats_included %}
                      <li class="flex items-start gap-3 text-white/60">
                        <span class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0">✓</span>
                        <span>{{ item }}</span>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            </div>
            <div id="tab-benefits" class="product-tab-panel {% if first_tab != 'benefits' %}hidden{% endif %}" role="tabpanel">
              <h2 class="text-2xl font-bold text-white mb-6">{{ section.settings.benefits_heading | default: 'Benefits' }}</h2>
              <div class="prose prose-invert max-w-none text-white/60">{% if benefits_content != blank %}{{ benefits_content }}{% else %}—{% endif %}</div>
            </div>
            <div id="tab-features" class="product-tab-panel {% if first_tab != 'features' %}hidden{% endif %}" role="tabpanel">
              <h2 class="text-2xl font-bold text-white mb-6">{{ section.settings.features_heading | default: 'Features' }}</h2>
              <div class="prose prose-invert max-w-none text-white/60">{% if features_content != blank %}{{ features_content }}{% else %}—{% endif %}</div>
            </div>
            <div id="tab-faqs" class="product-tab-panel {% if first_tab != 'faqs' %}hidden{% endif %}" role="tabpanel">
              <h2 class="text-2xl font-bold text-white mb-6">{{ section.settings.faqs_heading | default: 'FAQs' }}</h2>
              <div class="space-y-6">
                {% if faq_list != blank %}
                  {% for faq in faq_list %}
                    <div class="border-b border-white/10 pb-4">
                      <h4 class="text-white font-semibold mb-2">{{ faq.question | default: faq.title }}</h4>
                      <div class="text-white/60">{{ faq.answer | default: faq.body }}</div>
                    </div>
                  {% endfor %}
                {% elsif faq_questions != blank and faq_answers != blank %}
                  {% for q in faq_questions %}
                    <div class="border-b border-white/10 pb-4">
                      <h4 class="text-white font-semibold mb-2">{{ q }}</h4>
                      <div class="text-white/60">{{ faq_answers[forloop.index0] }}</div>
                    </div>
                  {% endfor %}
                {% endif %}
              </div>
            </div>
          </div>
          <div>
            <h3 class="text-lg font-bold text-white mb-4">{{ section.settings.details_heading | default: 'Product Details' }}</h3>
            <div class="space-y-4">
              <div class="flex justify-between py-3 border-b border-white/10"><span class="text-white/40">Category</span><span class="text-white">{{ product.type | default: '—' }}</span></div>
              <div class="flex justify-between py-3 border-b border-white/10"><span class="text-white/40">Version</span><span class="text-white">{{ product_version }}</span></div>
              <div class="flex justify-between py-3 border-b border-white/10"><span class="text-white/40">Last Updated</span><span class="text-white">{{ product.updated_at | date: '%b %Y' }}</span></div>
              <div class="flex justify-between py-3 border-b border-white/10"><span class="text-white/40">License</span><span class="text-white">{{ product_license }}</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>
  {% endif %}

  {% if section.settings.show_membership_cta and section.settings.membership_heading != blank %}
    <section class="relative z-10 py-16 lg:py-24 border-t border-white/10">
      <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
        <div class="relative rounded-3xl overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-r {{ gradient_class | strip }} opacity-10" aria-hidden="true"></div>
          <div class="relative p-8 md:p-12 lg:p-16">
            <div class="max-w-2xl">
              <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{{ section.settings.membership_heading }}</h2>
              <p class="text-lg text-white/60 mb-8">{{ section.settings.membership_subtext }}</p>
              <div class="flex flex-col sm:flex-row gap-4">
                {% if section.settings.membership_primary_url != blank %}
                  <a href="{{ section.settings.membership_primary_url }}" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white text-black rounded-full font-semibold hover:bg-gray-200 transition-colors">{{ section.settings.membership_primary_text | default: 'View Membership Plans' }}</a>
                {% endif %}
                {% if product.collections.first and section.settings.membership_secondary_use_collection %}
                  <a href="{{ product.collections.first.url }}" class="inline-flex items-center justify-center gap-2 px-8 py-4 border border-white/20 text-white rounded-full font-semibold hover:bg-white/10 transition-colors">{{ section.settings.membership_secondary_text | default: 'Browse More' }}</a>
                {% elsif section.settings.membership_secondary_url != blank %}
                  <a href="{{ section.settings.membership_secondary_url }}" class="inline-flex items-center justify-center gap-2 px-8 py-4 border border-white/20 text-white rounded-full font-semibold hover:bg-white/10 transition-colors">{{ section.settings.membership_secondary_text | default: 'Browse More' }}</a>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  {% endif %}
</main>

<script>
(function() {
  var tabs = document.querySelectorAll('.product-tab');
  var panels = document.querySelectorAll('.product-tab-panel');
  tabs.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var id = this.getAttribute('data-tab');
      tabs.forEach(function(t) { t.setAttribute('aria-selected', 'false'); t.classList.remove('border-white', 'text-white'); t.classList.add('border-transparent', 'text-white/40'); });
      panels.forEach(function(p) { p.classList.add('hidden'); });
      this.setAttribute('aria-selected', 'true'); this.classList.add('border-white', 'text-white'); this.classList.remove('border-transparent', 'text-white/40');
      var panel = document.getElementById('tab-' + id);
      if (panel) panel.classList.remove('hidden');
    });
  });
  var thumbs = document.querySelectorAll('.product-thumb');
  var mainImg = document.querySelector('.product-info').closest('section').querySelector('.aspect-[4/3] img');
  if (mainImg && thumbs.length) {
    thumbs.forEach(function(t, i) { t.addEventListener('click', function() { var src = this.querySelector('img').src.replace(/_\d+x\d+/, '_800x'); mainImg.src = src; thumbs.forEach(function(x) { x.classList.remove('border-2', 'border-white/20'); x.classList.add('border'); }); this.classList.add('border-2', 'border-white/20'); this.classList.remove('border'); }); });
  }
})();
</script>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    {
      "type": "select",
      "id": "color_theme",
      "label": "Default color theme",
      "info": "Overridden by product or collection metafield custom.color_theme (blue, purple, emerald, amber).",
      "options": [
        { "value": "blue", "label": "Blue / Cyan" },
        { "value": "purple", "label": "Purple / Pink" },
        { "value": "emerald", "label": "Emerald / Teal" },
        { "value": "amber", "label": "Amber / Orange" }
      ],
      "default": "blue"
    },
    {
      "type": "header",
      "content": "Breadcrumb"
    },
    { "type": "text", "id": "breadcrumb_shop", "label": "Shop link text", "default": "Shop" },
    { "type": "url", "id": "shop_link", "label": "Shop URL", "info": "Breadcrumb first link. Leave blank for home." },
    {
      "type": "header",
      "content": "Product badge & copy"
    },
    { "type": "text", "id": "default_type_badge", "label": "Default type badge", "default": "Product", "info": "e.g. Course, Section, Template. Override per product: metafield custom.type_badge." },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating", "default": true },
    { "type": "text", "id": "buy_button_text", "label": "Buy button text", "default": "Buy Now" },
    { "type": "checkbox", "id": "show_wishlist", "label": "Show Save button", "default": true },
    { "type": "text", "id": "save_button_text", "label": "Save button text", "default": "Save" },
    { "type": "checkbox", "id": "show_share", "label": "Show Share button", "default": true },
    { "type": "text", "id": "trust_instant", "label": "Trust: Instant", "default": "Instant Download" },
    { "type": "text", "id": "trust_guarantee", "label": "Trust: Guarantee", "default": "14-Day Guarantee" },
    { "type": "text", "id": "trust_access", "label": "Trust: Access", "default": "Lifetime Access" },
    { "type": "text", "id": "downloads_placeholder", "label": "Downloads fallback", "default": "—", "info": "Shown when product.metafields.custom.downloads_count is blank." },
    { "type": "text", "id": "downloads_label", "label": "Downloads label", "default": "Downloads" },
    { "type": "checkbox", "id": "show_download_banner", "label": "Show download banner", "default": true },
    { "type": "text", "id": "download_banner_text", "label": "Download banner text", "default": "15,000+ downloads this month" },
    {
      "type": "header",
      "content": "Tabs (product metafields)"
    },
    { "type": "text", "id": "tab_overview", "label": "Tab: Overview", "default": "Overview" },
    { "type": "text", "id": "tab_benefits", "label": "Tab: Benefits", "default": "Benefits" },
    { "type": "text", "id": "tab_features", "label": "Tab: Features", "default": "Features" },
    { "type": "text", "id": "tab_faqs", "label": "Tab: FAQs", "default": "FAQs" },
    { "type": "text", "id": "overview_heading", "label": "Overview heading", "default": "About This Product" },
    { "type": "text", "id": "whats_included_heading", "label": "What's Included heading", "default": "What's Included" },
    { "type": "text", "id": "benefits_heading", "label": "Benefits heading", "default": "Benefits" },
    { "type": "text", "id": "features_heading", "label": "Features heading", "default": "Features" },
    { "type": "text", "id": "faqs_heading", "label": "FAQs heading", "default": "FAQs" },
    { "type": "text", "id": "details_heading", "label": "Sidebar: Product Details", "default": "Product Details" },
    { "type": "text", "id": "default_version", "label": "Default version", "default": "1.0" },
    { "type": "text", "id": "default_license", "label": "Default license", "default": "Commercial" },
    {
      "type": "header",
      "content": "Membership CTA"
    },
    { "type": "checkbox", "id": "show_membership_cta", "label": "Show membership CTA block", "default": true },
