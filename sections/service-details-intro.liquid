{% comment %} Service detail page intro: back link, category tag, gradient title, subtitle, description, CTAs. {% endcomment %}
<section class="relative min-h-screen flex items-center overflow-hidden bg-black" data-testid="service-details-intro">
  {% if section.settings.background_image != blank %}
    <div class="absolute inset-0 w-full h-full">
      <img
        src="{{ section.settings.background_image | image_url: width: 2400 }}"
        alt=""
        class="absolute inset-0 w-full h-full object-cover"
        width="{{ section.settings.background_image.width }}"
        height="{{ section.settings.background_image.height }}"
        loading="eager"
        fetchpriority="high"
      >
    </div>
  {% endif %}
  <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-transparent to-black" aria-hidden="true"></div>

  <div class="relative z-10 max-w-[1400px] mx-auto px-6 lg:px-12 py-32 w-full">
    {% if section.settings.back_link_text != blank and section.settings.back_link_url != blank %}
      <div class="mb-10">
        <a class="inline-flex items-center gap-2 text-white/40 hover:text-white transition-colors group" href="{{ section.settings.back_link_url }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 transition-transform group-hover:-translate-x-1" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
          <span class="text-sm">{{ section.settings.back_link_text }}</span>
        </a>
      </div>
    {% endif %}

    {% if section.settings.category_label != blank %}
      <div class="mb-6">
        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/10 bg-white/[0.02]">
          {% if section.settings.category_icon != 'none' %}
            {% case section.settings.category_icon %}
              {% when 'sparkles' %}
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-white/60 flex-shrink-0" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/></svg>
              {% when 'zap' %}
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-white/60 flex-shrink-0" aria-hidden="true"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>
              {% when 'palette' %}
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-white/60 flex-shrink-0" aria-hidden="true"><path d="M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z"/><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/></svg>
              {% when 'globe' %}
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-white/60 flex-shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
              {% when 'film' %}
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-white/60 flex-shrink-0" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg>
              {% when 'trending-up' %}
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-white/60 flex-shrink-0" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
              {% else %}
            {% endcase %}
          {% endif %}
          <span class="text-sm text-white/60">{{ section.settings.category_label }}</span>
        </span>
      </div>
    {% endif %}

    {% if section.settings.title != blank %}
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-white leading-[0.95] tracking-tight mb-6">
        <span class="text-transparent bg-clip-text bg-gradient-to-b from-white via-gray-300 to-gray-600">{{ section.settings.title }}</span>
      </h1>
    {% endif %}

    {% if section.settings.subtitle != blank %}
      <p class="text-xl md:text-2xl text-white/50 font-light mb-4 max-w-2xl">{{ section.settings.subtitle }}</p>
    {% endif %}

    {% if section.settings.description != blank %}
      <p class="text-lg text-white/40 mb-10 max-w-xl">{{ section.settings.description }}</p>
    {% endif %}

    <div class="flex flex-wrap gap-4">
      {% if section.settings.cta_primary_text != blank and section.settings.cta_primary_url != blank %}
        <a href="{{ section.settings.cta_primary_url }}" class="group inline-flex items-center gap-2 px-8 py-4 bg-white text-black rounded-full font-semibold" {% if section.settings.cta_primary_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
          {{ section.settings.cta_primary_text }}
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 flex-shrink-0 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
        </a>
      {% endif %}
      {% if section.settings.cta_secondary_text != blank and section.settings.cta_secondary_url != blank %}
        <a href="{{ section.settings.cta_secondary_url }}" class="inline-block px-8 py-4 border border-white/20 text-white rounded-full font-semibold hover:bg-white/5 transition-all">
          {{ section.settings.cta_secondary_text }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Service Details Intro",
  "tag": "section",
  "class": "section-service-details-intro",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Optional. Leave blank for solid dark gradient."
    },
    {
      "type": "header",
      "content": "Back link"
    },
    {
      "type": "text",
      "id": "back_link_text",
      "label": "Back link text",
      "default": "Back to Services"
    },
    {
      "type": "text",
      "id": "back_link_url",
      "label": "Back link URL",
      "default": "/services"
    },
    {
      "type": "header",
      "content": "Category tag"
    },
    {
      "type": "text",
      "id": "category_label",
      "label": "Category label",
      "default": "Brand Strategy"
    },
    {
      "type": "select",
      "id": "category_icon",
      "label": "Category icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "sparkles", "label": "Sparkles" },
        { "value": "zap", "label": "Zap" },
        { "value": "palette", "label": "Palette" },
        { "value": "globe", "label": "Globe" },
        { "value": "film", "label": "Film" },
        { "value": "trending-up", "label": "Trending up" }
      ],
      "default": "sparkles"
    },
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Service title",
      "default": "Company Agent Builder"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Your Brand's AI-Powered Strategic Partner"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Build intelligent agents that embody your brand values and work 24/7"
    },
    {
      "type": "header",
      "content": "Primary CTA"
    },
    {
      "type": "text",
      "id": "cta_primary_text",
      "label": "Primary button text",
      "default": "Book Free Consultation"
    },
    {
      "type": "text",
      "id": "cta_primary_url",
      "label": "Primary button URL"
    },
    {
      "type": "checkbox",
      "id": "cta_primary_new_tab",
      "label": "Open primary link in new tab",
      "default": true
    },
    {
      "type": "header",
      "content": "Secondary CTA"
    },
    {
      "type": "text",
      "id": "cta_secondary_text",
      "label": "Secondary button text",
      "default": "View Case Studies"
    },
    {
      "type": "text",
      "id": "cta_secondary_url",
      "label": "Secondary button URL",
      "default": "/work"
    }
  ],
  "presets": [
    {
      "name": "Service Details Intro",
      "settings": {
        "back_link_text": "Back to Services",
        "back_link_url": "/services",
        "category_label": "Brand Strategy",
        "category_icon": "sparkles",
        "title": "Company Agent Builder",
        "subtitle": "Your Brand's AI-Powered Strategic Partner",
        "description": "Build intelligent agents that embody your brand values and work 24/7",
        "cta_primary_text": "Book Free Consultation",
        "cta_primary_new_tab": true,
        "cta_secondary_text": "View Case Studies",
        "cta_secondary_url": "/work"
      }
    }
  ]
}
{% endschema %}
