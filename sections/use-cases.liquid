{% comment %} Use cases grid: strap + gradient title, 4-col cards with sparkle icon, title, tagline, Explore CTA. {% endcomment %}
<section class="relative py-28 lg:py-40 bg-black overflow-hidden" data-testid="use-cases-section" id="use-cases">
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(255,255,255,0.02),transparent_70%)]" aria-hidden="true"></div>
  <div class="relative z-10 max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="text-center mb-16">
      {% if section.settings.strap != blank %}
        <span class="text-[10px] font-medium text-white/40 tracking-[0.3em] uppercase block mb-5">{{ section.settings.strap }}</span>
      {% endif %}
      {% if section.settings.title_before != blank or section.settings.title_gradient != blank %}
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4">
          {{ section.settings.title_before }}
          {% if section.settings.title_gradient != blank %}
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-gray-400 to-gray-600">{{ section.settings.title_gradient }}</span>
          {% endif %}
        </h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="text-white/40 max-w-xl mx-auto text-lg">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {% for block in section.blocks %}
        {% if block.type == 'use_case' %}
          {% assign card_url = block.settings.url | default: '#' %}
          <div class="group cursor-pointer relative" {{ block.shopify_attributes }}>
            <div class="absolute -inset-0.5 rounded-2xl bg-gradient-to-r from-white/10 to-white/5 opacity-0 group-hover:opacity-100 blur-md transition-opacity" aria-hidden="true"></div>
            <a href="{{ card_url }}" class="relative block bg-white/[0.02] border border-white/[0.08] rounded-2xl p-6 hover:bg-white/[0.04] hover:border-white/20 transition-all" {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
              <div class="absolute -top-3 -right-2 w-10 h-10 rounded-xl bg-black border border-white/20 flex items-center justify-center" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-white/60"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/></svg>
              </div>
              {% if block.settings.title != blank %}
                <h4 class="text-white font-semibold mb-2 pr-8">{{ block.settings.title }}</h4>
              {% endif %}
              {% if block.settings.tagline != blank %}
                <p class="text-white/40 text-sm mb-4">{{ block.settings.tagline }}</p>
              {% endif %}
              <div class="flex items-center gap-2 text-white/30 group-hover:text-white/60 transition-colors">
                <span class="text-xs uppercase tracking-wider">{{ block.settings.cta_text | default: 'Explore' }}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </div>
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Use Cases",
  "tag": "section",
  "class": "section-use-cases",
  "settings": [
    {
      "type": "text",
      "id": "strap",
      "label": "Strap (small label above title)",
      "default": "(Perfect For)"
    },
    {
      "type": "text",
      "id": "title_before",
      "label": "Title (before gradient part)",
      "default": "Use "
    },
    {
      "type": "text",
      "id": "title_gradient",
      "label": "Title (gradient part)",
      "default": "Cases"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description below title",
      "default": "Click any use case to see how it transforms your business"
    }
  ],
  "blocks": [
    {
      "type": "use_case",
      "name": "Use case",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Tagline"
        },
        {
          "type": "text",
          "id": "url",
          "label": "Link URL"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA text",
          "default": "Explore"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Use Cases",
      "settings": {
        "strap": "(Perfect For)",
        "title_before": "Use ",
        "title_gradient": "Cases",
        "description": "Click any use case to see how it transforms your business"
      },
      "blocks": [
        { "type": "use_case", "settings": { "title": "Customer Support Automation", "tagline": "Never Miss a Customer Question Again", "cta_text": "Explore" } },
        { "type": "use_case", "settings": { "title": "Sales Lead Qualification", "tagline": "Only Talk to Ready-to-Buy Prospects", "cta_text": "Explore" } },
        { "type": "use_case", "settings": { "title": "Product Recommendations", "tagline": "Show Customers Exactly What They Want", "cta_text": "Explore" } },
        { "type": "use_case", "settings": { "title": "Appointment Scheduling", "tagline": "Fill Your Calendar on Autopilot", "cta_text": "Explore" } },
        { "type": "use_case", "settings": { "title": "FAQ & Knowledge Base", "tagline": "Instant Answers, Zero Wait Time", "cta_text": "Explore" } },
        { "type": "use_case", "settings": { "title": "Onboarding Assistance", "tagline": "Guide Every Customer to Success", "cta_text": "Explore" } },
        { "type": "use_case", "settings": { "title": "Order Status Updates", "tagline": "Proactive Communication, Happy Customers", "cta_text": "Explore" } },
        { "type": "use_case", "settings": { "title": "Feedback Collection", "tagline": "Capture Insights at the Perfect Moment", "cta_text": "Explore" } }
      ]
    }
  ]
}
{% endschema %}
