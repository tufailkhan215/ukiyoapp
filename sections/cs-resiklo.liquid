     * Find a minimally changed row order that avoids adjacent
     * photographs of the same profile when possible.
     */
    rowOrder(poses) {
      const sorted = poses
        .map((_, i) => i)
        .sort((a, b) => poses[a].x - poses[b].x);

      let best = sorted;
      let score = Infinity;

      const walk = (j, swaps) => {
        if (j < this.cards.length - 1) {
          walk(j + 1, swaps);
          walk(j + 2, [...swaps, j]);
