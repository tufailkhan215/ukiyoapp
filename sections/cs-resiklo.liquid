        const wp = clamp(front / 2);
        const fill = clamp((front - 2) / 3);

        el.style.setProperty(
          '--wp',
          wp.toFixed(3)
        );

        el.style.setProperty(
          '--fill',
          fill.toFixed(3)
        );

        el.style.filter =
          wp > 0 && wp < 1
            ? `blur(${(1 - wp) * 8}px)`
            : 'none';
