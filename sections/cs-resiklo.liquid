        ? Math.min((time - this.lastTime) / 1000, .05)
        : 0;

      this.lastTime = time;

      const speed =
        4 * (1 - smooth(seg(p, 2.2, 2.45)));

      if (
        p > .45 &&
        p < 2.45 &&
        !this.dialog.open
      ) {
        this.spin += dt * speed;
      }

      const grow = mix(
        .5,
        1,
        seg(p, .45, 2.45)
      );

      const fold = seg(p, 2.45, 3.25);

      const e = ease(fold);
      const ex = ease(seg(fold, 0, .6));
      const ey = ease(seg(fold, .4, 1));

      const shift = clamp(
        (p - 3.25) * g.H,
        0,
        g.travel
      );

      const poses = this.cards.map((card, i) => {
        const angle =
          i * (360 / this.cards.length) +
          this.spin;

        return {
          x:
            g.W / 2 +
            Math.cos(rad(angle)) * .6 * g.B * grow,

          y:
            g.H / 2 +
            Math.sin(rad(angle)) * .6 * g.B * grow,

          r: angle + 90,

          s: .146 * g.B * grow / g.cw
        };
      });

      if (fold === 0 || !this.hasOrder) {
        const sorted = this.rowOrder(poses);

        sorted.forEach((i, slot) => {
          this.slots[i] = slot;
        });

        this.unwrap = poses.map(v => {
          return 360 * Math.round(v.r / 360);
        });

        this.hasOrder = true;
      }

      this.cards.forEach((card, i) => {
        const v = poses[i];

        const rotation = mix(
          v.r - this.unwrap[i],
          0,
          ex
        );

        const scale = mix(v.s, 1, e);

        const inset =
          (g.ch - g.cw) * (1 - e);

        const focus =
          Number(card.dataset.focus) || 0;

        const cutTop = inset * focus;
        const cutBottom = inset - cutTop;

        const off =
          (cutTop - cutBottom) / 2 * scale;

        const ox =
          -off * Math.sin(rad(rotation));

        const oy =
          off * Math.cos(rad(rotation));

        const x = mix(
          v.x,
          16 +
            this.slots[i] * (g.cw + 16) +
            g.cw / 2 -
            shift,
          ex
        ) - ox - g.cw / 2;

        const y = mix(
          v.y,
          g.H / 2,
          ey
        ) - oy - g.ch / 2;

        card.style.transform =
          `translate3d(${x.toFixed(2)}px,` +
          `${y.toFixed(2)}px,0) ` +
          `rotate(${rotation.toFixed(3)}deg) ` +
          `scale(${scale.toFixed(4)})`;

        card.style.opacity = String(
          Math.max(
            seg(p, .45, .65),
            e
          )
        );

        card.style.zIndex = String(
          20 - this.slots[i]
        );

        card.querySelector(
          '.sf-card-image'
        ).style.clipPath =
          `inset(${cutTop.toFixed(2)}px 0 ` +
          `${cutBottom.toFixed(2)}px)`;

        card.tabIndex =
          fold >= .98 ? 0 : -1;
      });

      const row = fold >= .98;

      this.toggleAttribute('data-row', row);
      this.board.inert = !row;

      this.boardTitle.style.opacity = String(
        seg(fold, .9, 1)
      );

      if (
        p > .45 &&
        p < 2.45 &&
        this.visible !== false &&
        !this.dialog.open
      ) {
        this.schedule();
      }
    }

    jump(target) {
      const g = this.geo;

      if (!this.cinematic) {
        const el =
          target === 'board'
            ? this.board
            : target === 'statement'
              ? this.statement
              : this;

        el.scrollIntoView({
          block: 'start',
          behavior: this.reduced.matches
            ? 'instant'
            : 'smooth'
        });

        return;
      }

      const start =
        scrollY +
        this.runway.getBoundingClientRect().top -
        g.top;

      const y = target === 'top'
        ? start
        : start +
          (
            g.hero +
            (target === 'statement' ? 1.95 : 3.26)
          ) * g.H;

      scrollTo({
        top: y,
        behavior: this.reduced.matches
          ? 'instant'
          : 'smooth'
      });
    }

    syncSaved() {
      this.querySelectorAll(
        '[data-count]'
      ).forEach(el => {
        el.textContent = String(this.saved.size);
      });

      this.querySelectorAll(
        '[data-save]'
      ).forEach(button => {
        const on = this.saved.has(
          button.dataset.save
        );

        button.setAttribute(
          'aria-pressed',
          String(on)
        );

        button.textContent = on
          ? 'In your shortlist'
          : 'Add to shortlist';
      });
    }

    openCard(card) {
      if (
        !card ||
        typeof this.dialog.showModal !== 'function'
      ) {
        return;
      }

      const template = [
        ...this.querySelectorAll('template[data-template]')
      ].find(t => {
        return t.dataset.template === card.dataset.block;
      });

      if (!template) return;

      this.animations.forEach(a => a.cancel());
      this.animations.clear();
      this.closing = false;

      this.opener = card;

      const from = card.querySelector(
        '.sf-card-image'
      ).getBoundingClientRect();

      this.profile.replaceChildren(
        template.content.cloneNode(true)
      );

      this.dialog.setAttribute(
        'aria-label',
        card.dataset.name + ' profile'
      );

      if (!this.dialog.open) {
        this.dialog.showModal();
      }

      this.profile.scrollTop = 0;
      this.syncSaved();

      const image = this.profile.querySelector(
        '.sf-frame'
      );

      if (
        image &&
        !this.reduced.matches &&
        image.animate
      ) {
        const to = image.getBoundingClientRect();

        if (
          from.bottom > 0 &&
          from.top < innerHeight &&
          to.width &&
          from.width
        ) {
          const animation = image.animate(
            [
              {
                transformOrigin: '0 0',
                transform:
                  `translate(${from.left - to.left}px,` +
                  `${from.top - to.top}px) ` +
                  `scale(${from.width / to.width},` +
                  `${from.height / to.height})`,
                opacity: .75
              },
              {
                transformOrigin: '0 0',
                transform: 'none',
                opacity: 1
              }
            ],
            {
              duration: 800,
              easing: 'cubic-bezier(.77,0,.175,1)'
            }
          );

          this.animations.add(animation);
        }
      }
    }

    closeProfile() {
      if (
        !this.dialog.open ||
        this.closing
      ) {
        return;
      }

      this.closing = true;

      if (
        this.reduced.matches ||
        !this.profile.animate
      ) {
        this.dialog.close();
        return;
      }

      const animation = this.profile.animate(
        [
          { opacity: 1 },
          { opacity: 0 }
        ],
        { duration: 180 }
      );

      this.animations.add(animation);

      animation.finished.then(
        () => {
          if (this.dialog.open) {
            this.dialog.close();
          }
        },
        () => {}
      );
    }

    openShortlist() {
      if (
        typeof this.dialog.showModal !== 'function'
      ) {
        return;
      }

      this.opener = this.querySelector(
        '[data-shortlist]'
      );

      const box = document.createElement('section');
      box.className = 'sf-shortlist';

      const heading = document.createElement('h2');
      heading.textContent =
        `Shortlist (${this.saved.size})`;

      box.append(heading);

      const grid = document.createElement('div');
      grid.className = 'sf-saved-grid';

      for (const key of this.saved) {
        const card = this.cards.find(c => {
          return c.dataset.person === key;
        });

        if (!card) continue;

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'sf-saved';
        button.dataset.openSaved = card.dataset.block;

        const image = card.querySelector('img');

        if (image) {
          button.append(image.cloneNode(true));
        }

        const name = document.createElement('span');
        name.textContent = card.dataset.name;

        button.append(name);
        grid.append(button);
      }

      if (!grid.children.length) {
        const p = document.createElement('p');
        p.textContent = 'Your shortlist is empty.';
        box.append(p);
      } else {
        box.append(grid);
      }

      this.profile.replaceChildren(box);
      this.dialog.setAttribute('aria-label', 'Shortlist');

      if (!this.dialog.open) {
        this.dialog.showModal();
      }

      this.profile.scrollTop = 0;
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.boot);
      cancelAnimationFrame(this.frame);
      cancelAnimationFrame(this.measureFrame);

      this.frame = 0;
      this.measureFrame = 0;
      this.seqGeneration++;

      this.events?.abort();
      this.resize?.disconnect();
      this.observer?.disconnect();

      this.animations?.forEach(a => {
        a.cancel();
      });

      if (this.dialog?.open) {
        this.dialog.close();
      }

      this.events = null;
    }
  });
})();
