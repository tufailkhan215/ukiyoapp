{% comment %} Browse Library / What's Included: badge + heading, grid of category cards with gradient icon, title, description, item count, arrow link. {% endcomment %}
{% assign library_blocks = section.blocks | where: 'type', 'category' %}
<section class="relative py-24 lg:py-32 bg-black" {{ section.shopify_attributes }}>
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="text-center mb-16">
      {% if section.settings.badge != blank %}
        <span class="text-[10px] font-medium text-white/40 tracking-[0.3em] uppercase block mb-4">{{ section.settings.badge }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="text-4xl md:text-5xl font-bold text-white">{{ section.settings.heading }}</h2>
      {% endif %}
    </div>

    {% if library_blocks.size > 0 %}
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {% for block in library_blocks %}
          {% assign card_url = block.settings.url | default: '#' %}
          <div {{ block.shopify_attributes }}>
            <a href="{{ card_url }}" class="group block relative">
              <div class="relative p-6 rounded-2xl bg-white/[0.02] border border-white/10 group-hover:bg-white/[0.04] transition-all duration-300">
                {% case block.settings.icon %}
                  {% when 'workflow' %}
                    <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-blue-500 to-cyan-500 flex items-center justify-center mb-4">
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white" aria-hidden="true"><rect width="8" height="8" x="3" y="3" rx="2"></rect><path d="M7 11v4a2 2 0 0 0 2 2h4"></path><rect width="8" height="8" x="13" y="13" rx="2"></rect></svg>
                    </div>
                  {% when 'graduation_cap' %}
                    <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center mb-4">
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white" aria-hidden="true"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"></path><path d="M22 10v6"></path><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"></path></svg>
                    </div>
                  {% when 'bot' %}
                    <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-500 flex items-center justify-center mb-4">
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white" aria-hidden="true"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path></svg>
                    </div>
                  {% when 'panels_top_left' %}
                    <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-amber-500 to-orange-500 flex items-center justify-center mb-4">
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M3 9h18"></path><path d="M9 21V9"></path></svg>
                    </div>
                  {% when 'cpu' %}
                    <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-violet-500 to-purple-600 flex items-center justify-center mb-4">
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white" aria-hidden="true"><rect width="16" height="16" x="4" y="4" rx="2"></rect><rect width="6" height="6" x="9" y="9" rx="1"></rect><path d="M15 2v2"></path><path d="M15 20v2"></path><path d="M2 15h2"></path><path d="M2 9h2"></path><path d="M20 15h2"></path><path d="M20 9h2"></path><path d="M9 2v2"></path><path d="M9 20v2"></path></svg>
                    </div>
                  {% when 'package' %}
                    <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-emerald-500 to-green-600 flex items-center justify-center mb-4">
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white" aria-hidden="true"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"></path><path d="M12 22V12"></path><path d="m3.3 7 7.703 4.734a2 2 0 0 0 1.994 0L20.7 7"></path><path d="m7.5 4.27 9 5.15"></path></svg>
                    </div>
                  {% when 'library' %}
                    <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-cyan-500 to-sky-600 flex items-center justify-center mb-4">
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white" aria-hidden="true"><path d="m16 6 4 14"></path><path d="M12 6v14"></path><path d="M8 8v12"></path><path d="M4 4v16"></path></svg>
                    </div>
                  {% when 'palette' %}
                    <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-rose-500 to-pink-600 flex items-center justify-center mb-4">
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white" aria-hidden="true"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"></path></svg>
                    </div>
                  {% when 'git_branch' %}
                    <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-amber-500 to-yellow-500 flex items-center justify-center mb-4">
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white" aria-hidden="true"><line x1="6" x2="6" y1="3" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path></svg>
                    </div>
                  {% when 'claude' %}
                    <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-emerald-400 to-teal-600 flex items-center justify-center mb-4">
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white" aria-hidden="true"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path></svg>
                    </div>
                  {% else %}
                    <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-blue-500 to-cyan-500 flex items-center justify-center mb-4">
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white" aria-hidden="true"><rect width="8" height="8" x="3" y="3" rx="2"></rect><path d="M7 11v4a2 2 0 0 0 2 2h4"></path><rect width="8" height="8" x="13" y="13" rx="2"></rect></svg>
                    </div>
                  {% endcase %}
                {% if block.settings.title != blank %}
                  <h3 class="text-xl font-bold text-white mb-2 group-hover:text-white transition-colors">{{ block.settings.title }}</h3>
                {% endif %}
                {% if block.settings.description != blank %}
                  <p class="text-white/50 text-sm mb-4 line-clamp-2">{{ block.settings.description }}</p>
                {% endif %}
                <div class="flex items-center justify-between">
                  {% if block.settings.item_count != blank %}
                    <span class="text-white/40 text-sm">{{ block.settings.item_count }}</span>
                  {% endif %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right text-white/30 group-hover:text-white transition-colors shrink-0 ml-2" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                </div>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

{% schema %}
{
  "name": "Browse Library",
  "tag": "section",
  "class": "section-membership-browse-library",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "(Browse Library)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What's Included"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Library category",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon style",
          "options": [
            { "value": "workflow",        "label": "Workflow (blue–cyan)" },
            { "value": "graduation_cap",  "label": "Courses (purple–pink)" },
            { "value": "bot",             "label": "AI / Bot (emerald–teal)" },
            { "value": "panels_top_left", "label": "Sections (amber–orange)" },
            { "value": "cpu",             "label": "GPT Models (violet–purple)" },
            { "value": "package",         "label": "Bundles (emerald–green)" },
            { "value": "library",         "label": "Prompt Library (cyan–sky)" },
            { "value": "palette",         "label": "Content & Visual (rose–pink)" },
            { "value": "git_branch",      "label": "Make Templates (amber–yellow)" },
            { "value": "claude",          "label": "Claude Skills (emerald–teal)" }
          ],
          "default": "workflow"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Automation Templates"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Pre-built automation systems for Make.com. Download once, open START_HERE, and start generating assets today."
        },
        {
          "type": "text",
          "id": "item_count",
          "label": "Item count (e.g. 8+ items)",
          "default": "8+ items"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Browse Library",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "icon": "workflow",
            "title": "Automation Templates",
            "description": "Pre-built automation systems for Make.com. Download once, open START_HERE, and start generating assets today.",
            "item_count": "8+ items",
            "url": "/shop/automation-templates"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "graduation_cap",
            "title": "Courses",
            "description": "Practical, on-demand courses with structured learning paths. Learn proven frameworks and skills you can apply immediately.",
            "item_count": "15+ items",
            "url": "/shop/courses"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "bot",
            "title": "AI Agents",
            "description": "Purpose-built agents focused on doing one thing really well. Click once, get clear results—no setup required.",
            "item_count": "10+ items",
            "url": "/shop/ai-agents"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "panels_top_left",
            "title": "Shopify Sections",
            "description": "Ready-to-install Shopify sections built for real storefront needs. Download and add them to your theme fast.",
            "item_count": "100+ items",
            "url": "/shop/shopify-sections"
          }
        }
      ]
    }
  ]
}
{% endschema %}
