{% comment %}
  ┌─────────────────────────────────────────────────────────────────┐
  │  MEDIA VISUAL EXPERIENCE — UkiyoProd                           │
  │  Scroll-driven sticky media with layered card compositions     │
  │  Version: 2.0.0                                                 │
  └─────────────────────────────────────────────────────────────────┘
{% endcomment %}

{%- liquid
  assign section_id  = 'vx-' | append: section.id
  assign layout_mode = section.settings.layout_mode
  assign steps       = section.blocks | where: 'type', 'step'
-%}

<style>
  #{{ section_id }} {
    --vx-bg:      {{ section.settings.bg_color }};
    --vx-ink:     {{ section.settings.text_color }};
    --vx-muted:   {{ section.settings.text_color | color_modify: 'alpha', 0.62 }};
    --vx-border:  {{ section.settings.text_color | color_modify: 'alpha', 0.12 }};
    --vx-surface: {{ section.settings.text_color | color_modify: 'alpha', 0.04 }};
    --vx-accent:  {{ section.settings.accent_color }};
    --vx-radius:  18px;
    --vx-shadow:  0 18px 40px rgba(0,0,0,0.10);
    --vx-max:     {{ section.settings.max_width }}px;
  }

  #{{ section_id }} *, #{{ section_id }} *::before, #{{ section_id }} *::after {
    box-sizing: border-box; margin: 0; padding: 0;
  }

  #{{ section_id }} {
    padding: clamp(54px,7vw,110px) 0;
    background: var(--vx-bg);
    color: var(--vx-ink);
    font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }

  #{{ section_id }} .vx-container {
    width: min(var(--vx-max), calc(100% - 40px));
    margin: 0 auto;
  }

  /* ── HEADER ──────────────────────────────────────────────── */
  #{{ section_id }} .vx-header {
    display: grid;
    gap: 10px;
    margin-bottom: clamp(18px, 3vw, 34px);
    max-width: 72ch;
  }

  #{{ section_id }} .vx-eyebrow {
    letter-spacing: .12em;
    text-transform: uppercase;
    font-size: 12px;
    color: var(--vx-muted);
  }

  #{{ section_id }} .vx-title {
    font-size: clamp(28px, 3.3vw, 44px);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -.02em;
  }

  #{{ section_id }} .vx-subtitle {
    color: var(--vx-muted);
    font-size: 15px;
    line-height: 1.65;
  }

  /* ── GRID ────────────────────────────────────────────────── */
  #{{ section_id }} .vx-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(18px, 4vw, 60px);
    align-items: start;
  }

  /* layout modes */
  #{{ section_id }}.vx-layout-invert .vx-grid {
    grid-template-columns: 1.05fr 0.95fr;
  }
  #{{ section_id }}.vx-layout-invert .vx-sticky {
    order: -1;
  }
  #{{ section_id }}.vx-layout-centered .vx-grid {
    grid-template-columns: 1fr;
  }
  #{{ section_id }}.vx-layout-centered .vx-sticky {
    position: relative;
    top: 0;
    height: auto;
  }

  /* ── STEPS ───────────────────────────────────────────────── */
  #{{ section_id }} .vx-steps {
    display: grid;
    gap: 16px;
  }

  #{{ section_id }} .vx-step {
    min-height: min(72vh, 620px);
    display: grid;
    align-content: center;
    gap: 14px;
    padding: clamp(18px, 2.4vw, 24px);
    border: 1px solid var(--vx-border);
    border-radius: var(--vx-radius);
    background: var(--vx-bg);
    box-shadow: 0 0 0 rgba(0,0,0,0);
    transition: box-shadow 220ms ease, transform 220ms ease, border-color 220ms ease;
  }

  #{{ section_id }} .vx-step.is-active {
    border-color: {{ section.settings.accent_color | color_modify: 'alpha', 0.25 }};
    box-shadow: var(--vx-shadow);
    transform: translateY(-2px);
  }

  #{{ section_id }} .vx-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    padding: 6px 10px;
    border-radius: 999px;
    border: 1px solid var(--vx-border);
    background: var(--vx-surface);
    color: var(--vx-muted);
    font-size: 12px;
    letter-spacing: .02em;
  }
  #{{ section_id }} .vx-kicker-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--vx-accent);
    box-shadow: 0 0 0 4px {{ section.settings.accent_color | color_modify: 'alpha', 0.12 }};
    flex-shrink: 0;
  }

  #{{ section_id }} .vx-step h3 {
    font-size: 22px;
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -.01em;
  }

  #{{ section_id }} .vx-step p {
    color: var(--vx-muted);
    line-height: 1.65;
    max-width: 56ch;
    font-size: 15px;
  }

  #{{ section_id }} .vx-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
  }

  #{{ section_id }} .vx-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid var(--vx-border);
    background: var(--vx-bg);
    color: var(--vx-ink);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }
  #{{ section_id }} .vx-btn:hover {
    transform: translateY(-1px);
    border-color: {{ section.settings.text_color | color_modify: 'alpha', 0.2 }};
    box-shadow: 0 10px 22px rgba(0,0,0,0.08);
  }
  #{{ section_id }} .vx-btn.primary {
    background: {{ section.settings.accent_color | color_modify: 'alpha', 0.10 }};
    border-color: {{ section.settings.accent_color | color_modify: 'alpha', 0.25 }};
  }
  #{{ section_id }} .vx-btn.primary:hover {
    box-shadow: 0 12px 26px {{ section.settings.accent_color | color_modify: 'alpha', 0.14 }};
  }

  /* ── STICKY MEDIA ────────────────────────────────────────── */
  #{{ section_id }} .vx-sticky {
    position: sticky;
    top: 18px;
    height: calc(100vh - 36px);
    display: grid;
    align-content: center;
  }

  #{{ section_id }} .vx-frame {
    border-radius: 22px;
    border: 1px solid var(--vx-border);
    background: linear-gradient(180deg, var(--vx-surface), {{ section.settings.text_color | color_modify: 'alpha', 0.01 }});
    padding: clamp(14px, 2vw, 18px);
    box-shadow: 0 24px 55px rgba(0,0,0,0.12);
    overflow: hidden;
  }

  #{{ section_id }} .vx-stage {
    position: relative;
    border-radius: 18px;
    background: var(--vx-bg);
    border: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.10 }};
    overflow: hidden;
    padding: clamp(14px, 2vw, 18px);
    min-height: clamp(320px, 45vh, 520px);
  }

  /* chip row */
  #{{ section_id }} .vx-chiprow {
    position: absolute;
    left: 18px; top: 18px;
    display: flex;
    gap: 8px;
    z-index: 3;
  }
  #{{ section_id }} .vx-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border-radius: 999px;
    background: rgba(255,255,255,.92);
    border: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.10 }};
    color: var(--vx-muted);
    font-size: 12px;
    backdrop-filter: blur(8px);
  }
  #{{ section_id }} .vx-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--vx-accent);
    box-shadow: 0 0 0 4px {{ section.settings.accent_color | color_modify: 'alpha', 0.12 }};
  }

  /* ── MEDIA LAYERS ────────────────────────────────────────── */
  #{{ section_id }} .vx-media {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(10px) scale(.99);
    transition: opacity 420ms ease, transform 520ms cubic-bezier(.2,.7,.1,1);
    pointer-events: none;
  }
  #{{ section_id }} .vx-media.is-active {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  #{{ section_id }} .vx-layer {
    position: absolute;
    border-radius: 18px;
    border: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.12 }};
    overflow: hidden;
    box-shadow: 0 18px 40px rgba(0,0,0,0.14);
    background: #0b0d10;
  }
  #{{ section_id }} .vx-layer img,
  #{{ section_id }} .vx-layer .vx-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1);
    transition: transform 520ms cubic-bezier(.2,.7,.1,1);
    display: block;
  }
  #{{ section_id }} .vx-layer .vx-placeholder {
    background: linear-gradient(135deg, #1a1a2e, #16213e, #0f3460);
  }
  #{{ section_id }} .vx-stage:hover .vx-layer img { transform: scale(1.04); }

  /* Layer positions per step index */
  #{{ section_id }} .vx-media:nth-child(odd) .vx-layer.big {
    right: 16px; top: 18px;
    width: min(520px, 70%); height: min(340px, 55%);
  }
  #{{ section_id }} .vx-media:nth-child(odd) .vx-layer.small {
    left: 16px; bottom: 18px;
    width: min(320px, 46%); height: min(220px, 38%);
  }
  #{{ section_id }} .vx-media:nth-child(even) .vx-layer.big {
    left: 16px; top: 18px;
    width: min(520px, 72%); height: min(360px, 58%);
  }
  #{{ section_id }} .vx-media:nth-child(even) .vx-layer.small {
    right: 16px; bottom: 18px;
    width: min(300px, 44%); height: min(220px, 38%);
  }

  /* ── LAYOUT SWITCHER ─────────────────────────────────────── */
  #{{ section_id }} .vx-controls {
    margin-top: 18px;
    padding: 14px;
    border-radius: 14px;
    border: 1px solid var(--vx-border);
    background: var(--vx-surface);
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
  #{{ section_id }} .vx-pill-label {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid var(--vx-border);
    background: rgba(255,255,255,.6);
    color: var(--vx-muted);
    font-size: 12px;
  }

  /* ── RESPONSIVE ──────────────────────────────────────────── */
  @media (max-width: 960px) {
    #{{ section_id }} .vx-grid { grid-template-columns: 1fr !important; }
    #{{ section_id }} .vx-sticky { position: relative; height: auto; top: 0; order: -1; }
    #{{ section_id }} .vx-step { min-height: auto; }
    #{{ section_id }} .vx-stage { min-height: 360px; }
  }

  @media (max-width: 520px) {
    #{{ section_id }} .vx-layer.big,
    #{{ section_id }} .vx-layer.small {
      width: calc(100% - 32px) !important;
      left: 16px !important; right: 16px !important;
    }
    #{{ section_id }} .vx-layer.big  { height: 56% !important; top: 18px !important; bottom: auto !important; }
    #{{ section_id }} .vx-layer.small { height: 34% !important; bottom: 18px !important; top: auto !important; }
  }
</style>

<section
  id="{{ section_id }}"
  class="media-visual-experience vx-layout-{{ layout_mode }}"
  data-section-id="{{ section.id }}"
>
  <div class="vx-container">

    <!-- HEADER -->
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <header class="vx-header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="vx-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="vx-title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="vx-subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <!-- GRID -->
    <div class="vx-grid" data-vx>

      <!-- LEFT: scrolling steps -->
      <div class="vx-steps" aria-label="Visual experience steps">
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            <article
              class="vx-step {% if forloop.first %}is-active{% endif %}"
              data-media="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.kicker != blank -%}
                <span class="vx-kicker">
                  <span class="vx-kicker-dot"></span>
                  {{ block.settings.kicker }}
                </span>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h3>{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p>{{ block.settings.description }}</p>
              {%- endif -%}
              {%- if block.settings.btn_primary_label != blank or block.settings.btn_ghost_label != blank -%}
                <div class="vx-actions">
                  {%- if block.settings.btn_primary_label != blank -%}
                    <a class="vx-btn primary" href="{{ block.settings.btn_primary_url | default: '#' }}">
                      {{ block.settings.btn_primary_label }}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.btn_ghost_label != blank -%}
                    <a class="vx-btn" href="{{ block.settings.btn_ghost_url | default: '#' }}">
                      {{ block.settings.btn_ghost_label }}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- else -%}
          {%- assign demo_kickers = 'Immersive visual layout,Strong visual hierarchy,Interactive elements' | split: ',' -%}
          {%- assign demo_heads   = 'Layered visuals that feel premium,Guide the eye with contrast,Micro-interactions that engage' | split: ',' -%}
          {%- assign demo_descs   = 'Use asymmetry and editorial spacing to make the product feel high-value. The sticky media area keeps attention while the content explains key benefits.,Headlines, short copy, and focused CTAs keep the message clear. The media swaps on scroll so the section stays dynamic without feeling busy.,Subtle hover zoom and layered cards create depth. This builds an immersive feel while keeping the layout clean and conversion-focused.' | split: ',' -%}
          {%- for i in (1..3) -%}
            {%- assign idx = forloop.index0 -%}
            <article class="vx-step {% if forloop.first %}is-active{% endif %}" data-media="{{ idx }}">
              <span class="vx-kicker"><span class="vx-kicker-dot"></span>{{ demo_kickers[idx] }}</span>
              <h3>{{ demo_heads[idx] }}</h3>
              <p>{{ demo_descs[idx] }}</p>
              <div class="vx-actions">
                <a class="vx-btn primary" href="#">Explore details</a>
                <a class="vx-btn" href="#">View gallery</a>
              </div>
            </article>
          {%- endfor -%}
        {%- endfor -%}
      </div>

      <!-- RIGHT: sticky media -->
      <aside class="vx-sticky" aria-label="Sticky media">
        <div class="vx-frame">
          <div class="vx-stage">
            <div class="vx-chiprow" aria-hidden="true">
              <span class="vx-chip"><span class="vx-dot"></span> Scroll-driven</span>
              <span class="vx-chip">Layered media</span>
            </div>

            {%- for block in section.blocks -%}
              {%- if block.type == 'step' -%}
                <div
                  class="vx-media {% if forloop.first %}is-active{% endif %}"
                  aria-hidden="{{ forloop.first | default: 'false' | unless: forloop.first }}{{ forloop.first | default: '' }}"
                >
                  <div class="vx-layer big">
                    {%- if block.settings.image_big -%}
                      <img src="{{ block.settings.image_big | image_url: width: 1200 }}" alt="{{ block.settings.heading | escape }}" loading="lazy">
                    {%- else -%}
                      <div class="vx-placeholder"></div>
                    {%- endif -%}
                  </div>
                  <div class="vx-layer small">
                    {%- if block.settings.image_small -%}
                      <img src="{{ block.settings.image_small | image_url: width: 800 }}" alt="{{ block.settings.heading | escape }}" loading="lazy">
                    {%- else -%}
                      <div class="vx-placeholder"></div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- else -%}
              {%- for i in (1..3) -%}
                <div class="vx-media {% if forloop.first %}is-active{% endif %}">
                  <div class="vx-layer big"><div class="vx-placeholder"></div></div>
                  <div class="vx-layer small"><div class="vx-placeholder"></div></div>
                </div>
              {%- endfor -%}
            {%- endfor -%}
          </div>
        </div>
      </aside>

    </div><!-- /vx-grid -->

    <!-- Layout switcher -->
    <div class="vx-controls" data-vx-controls>
      <span class="vx-pill-label">Layout modes</span>
      <button class="vx-btn {% if layout_mode == 'default' %}primary{% endif %}" type="button" data-layout="default">Default</button>
      <button class="vx-btn {% if layout_mode == 'invert' %}primary{% endif %}" type="button" data-layout="invert">Invert</button>
      <button class="vx-btn {% if layout_mode == 'centered' %}primary{% endif %}" type="button" data-layout="centered">Centered</button>
    </div>

  </div>
</section>

<script>
(function() {
  var sec = document.getElementById('{{ section_id }}');
  if (!sec) return;

  var root   = sec.querySelector('[data-vx]');
  var steps  = root ? Array.from(root.querySelectorAll('.vx-step'))  : [];
  var medias = sec.querySelectorAll ? Array.from(sec.querySelectorAll('.vx-media')) : [];

  /* ── Scroll-driven media swap ────────────────────────────── */
  function setActive(idx) {
    steps.forEach(function(s, i) { s.classList.toggle('is-active', i === idx); });
    medias.forEach(function(m, i) {
      var on = i === idx;
      m.classList.toggle('is-active', on);
      m.setAttribute('aria-hidden', String(!on));
    });
  }

  if (steps.length && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries) {
      var visible = entries
        .filter(function(e) { return e.isIntersecting; })
        .sort(function(a, b) { return b.intersectionRatio - a.intersectionRatio; })[0];
      if (!visible) return;
      var idx = parseInt(visible.target.getAttribute('data-media') || '0', 10);
      setActive(idx);
    }, {
      root: null,
      threshold: [0.25, 0.45, 0.6],
      rootMargin: '-20% 0px -45% 0px'
    });
    steps.forEach(function(s) { io.observe(s); });
  }

  /* ── Layout switcher ─────────────────────────────────────── */
  var btns = Array.from(sec.querySelectorAll('[data-vx-controls] button[data-layout]'));
  btns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var layout = btn.getAttribute('data-layout');
      sec.className = sec.className.replace(/vx-layout-\w+/g, '').trim();
      sec.classList.add('vx-layout-' + layout);
      btns.forEach(function(b) { b.classList.remove('primary'); });
      btn.classList.add('primary');
    });
  });
})();
</script>

{% schema %}
{
  "name": "Media Visual Exp",
  "tag": "section",
  "class": "media-visual-exp-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Default layout",
      "options": [
        { "value": "default",  "label": "Default (steps left)" },
        { "value": "invert",   "label": "Invert (media left)" },
        { "value": "centered", "label": "Centered (stacked)" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width (px)",
      "min": 800, "max": 1400, "step": 40, "default": 1200
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "About This Product"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Visual experience media section"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Asymmetrical visual experience with immersive layout — create engaging, premium content showcases."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#0b0d10"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#2f6bff"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker",
          "default": "Feature"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Step heading"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Describe this feature or benefit in a compelling way."
        },
        {
          "type": "image_picker",
          "id": "image_big",
          "label": "Main image (large card)"
        },
        {
          "type": "image_picker",
          "id": "image_small",
          "label": "Secondary image (small card)"
        },
        {
          "type": "text",
          "id": "btn_primary_label",
          "label": "Primary button",
          "default": "Explore details"
        },
        {
          "type": "url",
          "id": "btn_primary_url",
          "label": "Primary button URL"
        },
        {
          "type": "text",
          "id": "btn_ghost_label",
          "label": "Ghost button",
          "default": "View gallery"
        },
        {
          "type": "url",
          "id": "btn_ghost_url",
          "label": "Ghost button URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media Visual Exp",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "kicker": "Immersive visual layout",
            "heading": "Layered visuals that feel premium",
            "description": "Use asymmetry and editorial spacing to make the product feel high-value. The sticky media area keeps attention while the content explains key benefits.",
            "btn_primary_label": "Explore details",
            "btn_ghost_label": "View gallery"
          }
        },
        {
          "type": "step",
          "settings": {
            "kicker": "Strong visual hierarchy",
            "heading": "Guide the eye with contrast",
            "description": "Headlines, short copy, and focused CTAs keep the message clear. The media swaps on scroll so the section stays dynamic without feeling busy.",
            "btn_primary_label": "See features",
            "btn_ghost_label": "How it works"
          }
        },
        {
          "type": "step",
          "settings": {
            "kicker": "Interactive elements",
            "heading": "Micro-interactions that engage",
