<script>
(function () {
  var root =
    document.getElementById(
      'UkiyoImpact-{{ uid }}'
    );

  if (!root) {
    return;
  }


  if (
    root.__ukiyoImpactCleanup &&
    typeof root.__ukiyoImpactCleanup === 'function'
  ) {
    root.__ukiyoImpactCleanup();
  }


  var revealItems =
    Array.prototype.slice.call(
      root.querySelectorAll(
        '[data-ui-reveal]'
      )
    );


  var cards =
    Array.prototype.slice.call(
      root.querySelectorAll(
        '[data-ui-card]'
      )
    );


  var metrics =
    Array.prototype.slice.call(
      root.querySelectorAll(
        '[data-ui-metric]'
      )
    );


  var reduceMotion =
    window.matchMedia &&
    window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;


  var revealObserver = null;
  var metricObserver = null;

  var metricFrames = [];

  var cardListeners = [];

  var destroyed = false;


  /* ============================================================
     REVEAL
     ============================================================ */

  function revealEverything() {
    revealItems.forEach(
      function (item) {
        item.classList.add(
          'is-visible'
        );
      }
    );
  }


  function initializeReveal() {
    if (
      reduceMotion ||
      !(
        'IntersectionObserver'
        in window
      )
    ) {
      revealEverything();

      return;
    }


    revealObserver =
      new IntersectionObserver(
        function (entries) {
          entries.forEach(
            function (entry) {
              if (
                !entry.isIntersecting
              ) {
                return;
              }


              entry.target.classList.add(
                'is-visible'
              );


              revealObserver.unobserve(
                entry.target
              );
            }
          );
        },
        {
          threshold: .12,

          rootMargin:
            '0px 0px -7% 0px'
        }
      );


    revealItems.forEach(
      function (item) {
        revealObserver.observe(
          item
        );
      }
    );
  }


  /* ============================================================
     METRIC PARSER
     Automatically handles:
     $100K+
     1000hrs
     +30%
     50+
     10x
     3x
     etc.
     ============================================================ */

  function parseMetric(value) {
    var match =
      String(value)
      .trim()
      .match(
        /^([^0-9]*)([\d,.]+)(.*)$/
      );


    if (!match) {
      return null;
    }


    var prefix =
      match[1] || '';


    var rawNumber =
      match[2] || '0';


    var suffix =
      match[3] || '';


    var numericValue =
      parseFloat(
        rawNumber.replace(
          /,/g,
          ''
        )
      );


    if (!Number.isFinite(numericValue)) {
      return null;
    }


    var decimals = 0;


    if (rawNumber.indexOf('.') !== -1) {
      decimals =
        rawNumber.split('.')[1].length;
    }


    return {
      prefix: prefix,
      value: numericValue,
      suffix: suffix,
      decimals: decimals
    };
  }


  function formatNumber(
    value,
    decimals
  ) {
    if (decimals > 0) {
      return value.toFixed(
        decimals
      );
    }


    return Math.round(value)
      .toLocaleString(
        'en-US'
      );
  }


  function animateMetric(element) {
    if (
      !element ||
      element.getAttribute(
        'data-ui-counted'
      ) === 'true'
    ) {
      return;
    }


    element.setAttribute(
      'data-ui-counted',
      'true'
    );


    var original =
      element.getAttribute(
        'data-ui-metric'
      ) || '';


    var parsed =
      parseMetric(
        original
      );


    if (
      !parsed ||
      reduceMotion
    ) {
      element.textContent =
        original;

      return;
    }


    var startTime = null;

    var duration = 1500;


    function frame(timestamp) {
      if (destroyed) {
        return;
      }


      if (startTime === null) {
        startTime =
          timestamp;
      }


      var progress =
        Math.min(
          1,
          (
            timestamp -
            startTime
          ) /
          duration
        );


      var eased =
        1 -
        Math.pow(
          1 -
          progress,
          4
        );


      var current =
        parsed.value *
        eased;


      element.textContent =
        parsed.prefix +
        formatNumber(
          current,
          parsed.decimals
        ) +
        parsed.suffix;


      if (progress < 1) {
        var frameId =
          window.requestAnimationFrame(
            frame
          );


        metricFrames.push(
          frameId
        );
      } else {
        element.textContent =
          original;
      }
    }


    var firstFrame =
      window.requestAnimationFrame(
        frame
      );


    metricFrames.push(
      firstFrame
    );
  }


  function initializeMetrics() {
    if (
      reduceMotion ||
      !(
        'IntersectionObserver'
        in window
      )
    ) {
      metrics.forEach(
        function (metric) {
          metric.textContent =
            metric.getAttribute(
              'data-ui-metric'
            ) || '';
        }
      );

      return;
    }


    metricObserver =
      new IntersectionObserver(
        function (entries) {
          entries.forEach(
            function (entry) {
              if (
                !entry.isIntersecting
              ) {
                return;
              }


              animateMetric(
                entry.target
              );


              metricObserver.unobserve(
                entry.target
              );
            }
          );
        },
        {
          threshold: .55
        }
      );


    metrics.forEach(
      function (metric) {
        metricObserver.observe(
          metric
        );
      }
    );
  }


  /* ============================================================
     POINTER SPOTLIGHT + SUBTLE TILT
     ============================================================ */

  function initializeCards() {
    if (
      reduceMotion ||
      !window.matchMedia ||
      !window.matchMedia(
        '(hover: hover) and (pointer: fine)'
      ).matches
    ) {
      return;
    }


    cards.forEach(
      function (card) {

        function move(event) {
          var rect =
            card.getBoundingClientRect();


          var x =
            event.clientX -
            rect.left;


          var y =
            event.clientY -
            rect.top;


          var xPercent =
            (
              x /
              rect.width
            ) *
            100;


          var yPercent =
            (
              y /
              rect.height
            ) *
            100;


          var rotateY =
            (
              (
                x /
                rect.width
              ) -
              .5
            ) *
            2.2;


          var rotateX =
            (
              .5 -
              (
                y /
                rect.height
              )
            ) *
            2.2;


          card.style.setProperty(
            '--ui-card-x',
            xPercent.toFixed(2) +
            '%'
          );


          card.style.setProperty(
            '--ui-card-y',
            yPercent.toFixed(2) +
            '%'
          );


          card.style.setProperty(
            '--ui-tilt-x',
            rotateX.toFixed(2) +
            'deg'
          );


          card.style.setProperty(
            '--ui-tilt-y',
            rotateY.toFixed(2) +
            'deg'
          );
        }


        function leave() {
          card.style.setProperty(
            '--ui-tilt-x',
            '0deg'
          );


          card.style.setProperty(
            '--ui-tilt-y',
            '0deg'
          );
        }


        card.addEventListener(
          'pointermove',
          move
        );


        card.addEventListener(
          'pointerleave',
          leave
        );


        cardListeners.push({
          card: card,
          move: move,
          leave: leave
        });
      }
    );
  }


  /* ============================================================
     CLEANUP
     ============================================================ */

  function cleanup() {
    destroyed = true;


    if (revealObserver) {
      revealObserver.disconnect();
    }


    if (metricObserver) {
      metricObserver.disconnect();
    }


    metricFrames.forEach(
      function (frame) {
        window.cancelAnimationFrame(
          frame
        );
      }
    );


    cardListeners.forEach(
      function (entry) {
        entry.card.removeEventListener(
          'pointermove',
          entry.move
        );


        entry.card.removeEventListener(
          'pointerleave',
          entry.leave
        );
      }
    );


    root.removeAttribute(
      'data-ui-ready'
    );
  }


  root.__ukiyoImpactCleanup =
    cleanup;


  root.setAttribute(
    'data-ui-ready',
    'true'
  );


  initializeReveal();
  initializeMetrics();
  initializeCards();


  document.addEventListener(
    'shopify:section:unload',
    function onSectionUnload(event) {
      if (
        !event.target ||
        !event.target.contains(root)
      ) {
        return;
      }


      cleanup();


      document.removeEventListener(
        'shopify:section:unload',
        onSectionUnload
      );
    }
  );
})();
</script>



