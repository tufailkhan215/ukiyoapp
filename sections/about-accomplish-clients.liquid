{%- comment -%}
  ============================================================
  UKIYO — CLIENT IMPACT / OUTCOMES
  Animated editorial bento section
  ============================================================

  SAVE IN:
  sections/about-accomplish-clients.liquid

  FEATURES
  - Asymmetric bento layout
  - Animated metric count-up
  - Scroll reveal animation
  - Pointer-reactive card spotlight
  - Subtle desktop tilt
  - Animated icon system
  - Oversized ambient typography
  - Moving capability marquee
  - Mobile-specific layout
  - Editable colors, spacing, copy and blocks
{%- endcomment -%}


{%- liquid
  assign uid = section.id | replace: '_', '' | replace: '-', '' | downcase
  assign card_blocks = section.blocks | where: 'type', 'card'
  assign card_count = card_blocks.size

  assign background_word = section.settings.background_word

  if background_word == blank
    assign background_word = 'IMPACT'
  endif
-%}


<section
  id="UkiyoImpact-{{ uid }}"
  class="ukiyo-impact ukiyo-impact--{{ uid }}"
  data-ukiyo-impact
  style="
    --ui-bg: {{ section.settings.background_color }};
    --ui-surface: {{ section.settings.card_color }};
    --ui-surface-hover: {{ section.settings.card_hover_color }};
    --ui-text: {{ section.settings.text_color }};
    --ui-muted: {{ section.settings.muted_color }};
    --ui-line: {{ section.settings.line_color }};
    --ui-accent: {{ section.settings.accent_color }};
    --ui-accent-soft: {{ section.settings.accent_soft }};
    --ui-radius: {{ section.settings.card_radius }}px;
    --ui-top: {{ section.settings.padding_top }}px;
    --ui-bottom: {{ section.settings.padding_bottom }}px;
  "
>

  {%- comment -%}
    ============================================================
    AMBIENT BACKGROUND
    ============================================================
  {%- endcomment -%}

  <div
    class="ukiyo-impact__grid"
    aria-hidden="true"
  ></div>


  <div
    class="ukiyo-impact__glow ukiyo-impact__glow--one"
    aria-hidden="true"
  ></div>


  <div
    class="ukiyo-impact__glow ukiyo-impact__glow--two"
    aria-hidden="true"
  ></div>


  <div
    class="ukiyo-impact__background-word"
    aria-hidden="true"
  >
    {{ background_word }}
  </div>


  <div
    class="ukiyo-impact__line"
    aria-hidden="true"
  ></div>



  <div class="ukiyo-impact__shell">

    {%- comment -%}
      ============================================================
      INTRO
      ============================================================
    {%- endcomment -%}

    <header
      class="ukiyo-impact__header"
      data-ui-reveal
    >

      <div class="ukiyo-impact__header-top">

        {%- if section.settings.badge != blank -%}

          <p class="ukiyo-impact__eyebrow">

            <span class="ukiyo-impact__eyebrow-dot"></span>

            {{ section.settings.badge }}

          </p>

        {%- endif -%}


        <div class="ukiyo-impact__header-index">

          <span>
            {{ card_count | prepend: '0' | slice: -2, 2 }}
          </span>

          <small>
            Areas of<br>Impact
          </small>

        </div>

      </div>


      <div class="ukiyo-impact__header-grid">

        <h2 class="ukiyo-impact__title">

          {%- if section.settings.title_before != blank -%}

            <span>
              {{ section.settings.title_before }}
            </span>

          {%- endif -%}


          {%- if section.settings.title_gradient != blank -%}

            <em>
              {{ section.settings.title_gradient }}
            </em>

          {%- endif -%}

        </h2>


        <div class="ukiyo-impact__intro">

          {%- if section.settings.intro_text != blank -%}

            <p>
              {{ section.settings.intro_text }}
            </p>

          {%- endif -%}


          <div class="ukiyo-impact__intro-rule">

            <span>
              Strategy
            </span>

            <span>
              Creative
            </span>

            <span>
              Technology
            </span>

            <span>
              Growth
            </span>

          </div>

        </div>

      </div>

    </header>



    {%- comment -%}
      ============================================================
      IMPACT BENTO
      ============================================================
    {%- endcomment -%}

    <div class="ukiyo-impact__bento">

      {%- for block in card_blocks -%}

        {%- assign card_index = forloop.index -%}
        {%- assign card_number = card_index | prepend: '0' | slice: -2, 2 -%}

        <article
          class="ukiyo-impact__card ukiyo-impact__card--{{ card_index }}"
          data-ui-card
          data-ui-reveal
          style="--ui-delay: {{ forloop.index0 | times: 75 }}ms;"
          {{ block.shopify_attributes }}
        >

          <div
            class="ukiyo-impact__spotlight"
            aria-hidden="true"
          ></div>


          <div
            class="ukiyo-impact__card-grid"
            aria-hidden="true"
          ></div>


          <div class="ukiyo-impact__card-top">

            <div class="ukiyo-impact__icon">

              <span class="ukiyo-impact__icon-ring"></span>

              <span class="ukiyo-impact__icon-core">

                {% case block.settings.icon %}

                  {% when 'trending_up' %}

                    <svg
                      viewBox="0 0 24 24"
                      width="25"
                      height="25"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
                      <polyline points="16 7 22 7 22 13"/>
                    </svg>


                  {% when 'workflow' %}

                    <svg
                      viewBox="0 0 24 24"
                      width="25"
                      height="25"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <rect width="8" height="8" x="3" y="3" rx="2"/>
                      <path d="M7 11v4a2 2 0 0 0 2 2h4"/>
                      <rect width="8" height="8" x="13" y="13" rx="2"/>
                    </svg>


                  {% when 'target' %}

                    <svg
                      viewBox="0 0 24 24"
                      width="25"
                      height="25"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="12" r="9"/>
                      <circle cx="12" cy="12" r="5"/>
                      <circle cx="12" cy="12" r="1.5"/>
                    </svg>


                  {% when 'globe' %}

                    <svg
                      viewBox="0 0 24 24"
                      width="25"
                      height="25"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="12" r="9"/>
                      <path d="M12 3a14 14 0 0 0 0 18a14 14 0 0 0 0-18"/>
                      <path d="M3 12h18"/>
                    </svg>


                  {% when 'bot' %}

                    <svg
                      viewBox="0 0 24 24"
                      width="25"
                      height="25"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M12 8V4H8"/>
                      <rect width="16" height="12" x="4" y="8" rx="2"/>
                      <path d="M2 14h2"/>
                      <path d="M20 14h2"/>
                      <path d="M15 13v2"/>
                      <path d="M9 13v2"/>
                    </svg>


                  {% when 'users' %}

                    <svg
                      viewBox="0 0 24 24"
                      width="25"
                      height="25"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                      <path d="M16 3a4 4 0 0 1 0 8"/>
                      <path d="M22 21v-2a4 4 0 0 0-3-4"/>
                      <circle cx="9" cy="7" r="4"/>
                    </svg>


                  {% else %}

                    <svg
                      viewBox="0 0 24 24"
                      width="25"
                      height="25"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="12" r="9"/>
                    </svg>

                {% endcase %}

              </span>

            </div>


            <div class="ukiyo-impact__number">
              {{ card_number }}
            </div>

          </div>



          <div class="ukiyo-impact__card-content">

            {%- if block.settings.metric != blank -%}

              <div
                class="ukiyo-impact__metric"
                data-ui-metric="{{ block.settings.metric | escape }}"
              >
                {{ block.settings.metric }}
              </div>

            {%- endif -%}


            {%- if block.settings.card_title != blank -%}

              <h3>
                {{ block.settings.card_title }}
              </h3>

            {%- endif -%}


            {%- if block.settings.description != blank -%}

              <p>
                {{ block.settings.description }}
              </p>

            {%- endif -%}

          </div>



          <div class="ukiyo-impact__card-footer">

            <span>
              Outcome
            </span>

            <span class="ukiyo-impact__pulse">
              <i></i>
              Active
            </span>

          </div>

        </article>

      {%- endfor -%}

    </div>

  </div>



  {%- comment -%}
    ============================================================
    MOVING CAPABILITY RAIL
    ============================================================
  {%- endcomment -%}

  {%- if section.settings.show_marquee -%}

    <div
      class="ukiyo-impact__marquee"
      aria-hidden="true"
    >

      <div class="ukiyo-impact__marquee-track">

        {%- for copy in (1..2) -%}

          <div class="ukiyo-impact__marquee-set">

            <span>
              Strategy
            </span>

            <i>✦</i>

            <span>
              Creative
            </span>

            <i>✦</i>

            <span>
              Technology
            </span>

            <i>✦</i>

            <span>
              Automation
            </span>

            <i>✦</i>

            <span>
              Growth
            </span>

            <i>✦</i>

            <span>
              Transformation
            </span>

            <i>✦</i>

          </div>

        {%- endfor -%}

      </div>

    </div>

  {%- endif -%}

</section>



{% style %}

/* ============================================================
   SHOPIFY WRAPPER
   ============================================================ */

#shopify-section-{{ section.id }} {
  width: 100%;
  max-width: none;

  margin: 0;
  padding: 0;
}


/* ============================================================
   ROOT
   ============================================================ */

.ukiyo-impact--{{ uid }} {
  position: relative;
  isolation: isolate;

  width: 100%;
  overflow: hidden;

  padding:
    var(--ui-top)
    0
    var(--ui-bottom);

  color: var(--ui-text);
  background: var(--ui-bg);

  font-family:
    'Inter Tight',
    -apple-system,
    BlinkMacSystemFont,
    'Helvetica Neue',
    Arial,
    sans-serif;

  -webkit-font-smoothing:
    antialiased;

  text-rendering:
    geometricPrecision;
}


.ukiyo-impact--{{ uid }} *,
.ukiyo-impact--{{ uid }} *::before,
.ukiyo-impact--{{ uid }} *::after {
  box-sizing: border-box;
}


.ukiyo-impact--{{ uid }} ::selection {
  color: var(--ui-bg);
  background: var(--ui-text);
}


/* ============================================================
   AMBIENT BACKGROUND
   ============================================================ */

.ukiyo-impact--{{ uid }} .ukiyo-impact__grid {
  position: absolute;
  inset: 0;
  z-index: 0;

  pointer-events: none;

  opacity: .34;

  background-image:
    linear-gradient(
      rgba(255,255,255,.025)
      1px,
      transparent
      1px
    ),

    linear-gradient(
      90deg,
      rgba(255,255,255,.025)
      1px,
      transparent
      1px
    );

  background-size:
    80px
    80px;

  mask-image:
    linear-gradient(
      to bottom,
      black,
      transparent 78%
    );

  -webkit-mask-image:
    linear-gradient(
      to bottom,
      black,
      transparent 78%
    );
}


.ukiyo-impact--{{ uid }} .ukiyo-impact__glow {
  position: absolute;
  z-index: 0;

  width: 700px;
  height: 700px;

  border-radius: 50%;

  pointer-events: none;

  filter:
    blur(130px);

  opacity: .12;
}


.ukiyo-impact--{{ uid }} .ukiyo-impact__glow--one {
  top: -260px;
  right: -190px;

  background:
    var(--ui-accent);
}


.ukiyo-impact--{{ uid }} .ukiyo-impact__glow--two {
  bottom: 5%;
  left: -340px;

  background:
    var(--ui-accent-soft);
}


.ukiyo-impact--{{ uid }} .ukiyo-impact__background-word {
  position: absolute;
  top: 4%;
  left: -3%;
  z-index: 0;

  color:
    rgba(
      255,
      255,
      255,
      .018
    );

  font-size:
    clamp(
      180px,
      27vw,
      520px
    );

  font-weight: 700;
  line-height: .72;
  letter-spacing: -.08em;

  text-transform: uppercase;
  white-space: nowrap;

  user-select: none;
  pointer-events: none;

  animation:
    ukiyo-impact-drift-{{ uid }}
    18s
    ease-in-out
    infinite
    alternate;
}


@keyframes ukiyo-impact-drift-{{ uid }} {

  from {
    transform:
      translateX(0);
  }

  to {
    transform:
      translateX(-4vw);
  }

}


.ukiyo-impact--{{ uid }} .ukiyo-impact__line {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;

  height: 1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      var(--ui-line),
      transparent
    );
}


/* ============================================================
   SHELL
   ============================================================ */

.ukiyo-impact--{{ uid }} .ukiyo-impact__shell {
  position: relative;
  z-index: 2;

  width:
    min(
      calc(
        100% -
        64px
      ),
      1500px
    );

  margin:
    0
    auto;
}


/* ============================================================
   HEADER
   ============================================================ */

.ukiyo-impact--{{ uid }} .ukiyo-impact__header {
  margin-bottom:
    clamp(
      76px,
      10vw,
      150px
    );

  opacity: 0;

  filter:
    blur(12px);

  transform:
    translateY(50px);

  transition:
    opacity
    1s
    cubic-bezier(.16,1,.3,1),

    filter
    1s
    cubic-bezier(.16,1,.3,1),

    transform
    1s
    cubic-bezier(.16,1,.3,1);
}


.ukiyo-impact--{{ uid }} .ukiyo-impact__header.is-visible {
  opacity: 1;

  filter:
    blur(0);

  transform:
    translateY(0);
}


.ukiyo-impact--{{ uid }} .ukiyo-impact__header-top {
  margin-bottom:
    clamp(
      36px,
      5vw,
      72px
    );

  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 30px;
}


.ukiyo-impact--{{ uid }} .ukiyo-impact__eyebrow {
  margin: 0;

  display: inline-flex;
  align-items: center;

  gap: 11px;

  color: var(--ui-muted);

  font-size: 10px;
  font-weight: 600;
  letter-spacing: .20em;

  text-transform: uppercase;
}


.ukiyo-impact--{{ uid }} .ukiyo-impact__eyebrow-dot {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background:
    var(--ui-accent);

  box-shadow:
    0 0
    0
    5px
    rgba(255,255,255,.04);

  animation:
    ukiyo-impact-pulse-dot-{{ uid }}
    2.2s
    ease-in-out
    infinite;
}


@keyframes ukiyo-impact-pulse-dot-{{ uid }} {

  0%,
  100% {
    opacity: .45;
    transform: scale(.8);
  }

  50% {
    opacity: 1;
    transform: scale(1);
  }

}


.ukiyo-impact--{{ uid }} .ukiyo-impact__header-index {
  display: flex;
  align-items: flex-start;

  gap: 12px;
}


.ukiyo-impact--{{ uid }} .ukiyo-impact__header-index > span {
  font-size:
    clamp(
      30px,
      3vw,
      48px
    );

  font-weight: 500;
  line-height: .8;
  letter-spacing: -.05em;
}


.ukiyo-impact--{{ uid }} .ukiyo-impact__header-index small {
  color: var(--ui-muted);

  font-size: 8px;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: .12em;

  text-transform: uppercase;
}


.ukiyo-impact--{{ uid }} .ukiyo-impact__header-grid {
  display: grid;

  grid-template-columns:
    minmax(0, 1.4fr)
    minmax(300px, .6fr);

  align-items: end;

  gap:
    clamp(
      60px,
      9vw,
      150px
    );
}


.ukiyo-impact--{{ uid }} .ukiyo-impact__title {
  margin: 0;

  color: var(--ui-text);

  font-size:
    clamp(
      70px,
      10vw,
      170px
    );

  font-weight: 650;
  line-height: .79;
  letter-spacing: -.068em;

  text-transform: uppercase;
}


.ukiyo-impact--{{ uid }} .ukiyo-impact__title span,
.ukiyo-impact--{{ uid }} .ukiyo-impact__title em {
  display: block;
}


.ukiyo-impact--{{ uid }} .ukiyo-impact__title em {
  color:
    transparent;

  background:
    linear-gradient(
      95deg,
      var(--ui-text) 0%,
      var(--ui-muted) 48%,
      var(--ui-text) 100%
    );

  background-size:
    220%
    100%;

  -webkit-background-clip:
    text;

  background-clip:
    text;

  font-weight: 400;
  font-style: normal;

  animation:
    ukiyo-impact-title-shimmer-{{ uid }}
    7s
    linear
    infinite;
}


@keyframes ukiyo-impact-title-shimmer-{{ uid }} {

  from {
    background-position:
      100%
      0;
  }

  to {
    background-position:
      -120%
      0;
  }

}


.ukiyo-impact--{{ uid }} .ukiyo-impact__intro > p {
  max-width: 36ch;

  margin:
    0
    0
    30px;

  color: var(--ui-muted);

  font-size:
    clamp(
      14px,
      1.15vw,
      17px
    );

  line-height: 1.62;
}


.ukiyo-impact--{{ uid }} .ukiyo-impact__intro-rule {
  padding:
    15px
    0;

  display: grid;

  grid-template-columns:
    1fr
    1fr;

  gap:
    9px
    20px;

  border-top:
    1px
    solid
    var(--ui-line);

  border-bottom:
    1px
    solid
    var(--ui-line);

  color: var(--ui-muted);

  font-size: 9px;
  font-weight: 600;
  letter-spacing: .12em;

  text-transform: uppercase;
}


/* ============================================================
   BENTO GRID
   ============================================================ */

.ukiyo-impact--{{ uid }} .ukiyo-impact__bento {
  display: grid;

  grid-template-columns:
    repeat(
      12,
      minmax(0, 1fr)
    );

  gap: 14px;
}


.ukiyo-impact--{{ uid }} .ukiyo-impact__card {
  --ui-card-x: 50%;
  --ui-card-y: 50%;
  --ui-tilt-x: 0deg;
  --ui-tilt-y: 0deg;

  position: relative;
  isolation: isolate;

  min-height: 410px;

  padding:
    clamp(
      24px,
      2.6vw,
      40px
    );

  display: flex;
  flex-direction: column;

  overflow: hidden;

  border:
    1px
    solid
    var(--ui-line);

  border-radius:
    var(--ui-radius);

  color: var(--ui-text);
  background: var(--ui-surface);

  opacity: 0;

  filter:
    blur(12px);

  transform:
    perspective(1000px)
    rotateX(var(--ui-tilt-x))
    rotateY(var(--ui-tilt-y))
    translateY(46px);

  transform-style:
    preserve-3d;

  transition:
    opacity
    .8s
    cubic-bezier(.16,1,.3,1)
    var(--ui-delay),

    filter
    .8s
    cubic-bezier(.16,1,.3,1)
    var(--ui-delay),

    transform
    .55s
    cubic-bezier(.16,1,.3,1),

    border-color
    .4s
    ease,

    background
    .4s
    ease;
}


.ukiyo-impact--{{ uid }} .ukiyo-impact__card.is-visible {
  opacity: 1;

  filter:
    blur(0);

  transform:
    perspective(1000px)
    rotateX(var(--ui-tilt-x))
    rotateY(var(--ui-tilt-y))
    translateY(0);
}


.ukiyo-impact--{{ uid }} .ukiyo-impact__card:hover {
  border-color:
    rgba(
      255,
      255,
      255,
      .24
    );

  background:
    var(--ui-surface-hover);
}


/* Asymmetric editorial pattern */

.ukiyo-impact--{{ uid }}
.ukiyo-impact__card:nth-child(6n + 1) {
  grid-column:
    span 7;

  min-height: 500px;
}


.ukiyo-impact--{{ uid }}
.ukiyo-impact__card:nth-child(6n + 2) {
  grid-column:
    span 5;

  min-height: 500px;
}


.ukiyo-impact--{{ uid }}
.ukiyo-impact__card:nth-child(6n + 3) {
  grid-column:
    span 4;
}


.ukiyo-impact--{{ uid }}
.ukiyo-impact__card:nth-child(6n + 4) {
  grid-column:
    span 8;
}


.ukiyo-impact--{{ uid }}
.ukiyo-impact__card:nth-child(6n + 5) {
  grid-column:
    span 5;
}


.ukiyo-impact--{{ uid }}
.ukiyo-impact__card:nth-child(6n + 6) {
  grid-column:
    span 7;
}


/* ============================================================
   CARD ATMOSPHERE
   ============================================================ */

.ukiyo-impact--{{ uid }} .ukiyo-impact__spotlight {
  position: absolute;
  inset: 0;
  z-index: -1;

  opacity: 0;

  background:
    radial-gradient(
      430px
      circle
      at
      var(--ui-card-x)
      var(--ui-card-y),

      rgba(
        255,
        255,
        255,
        .105
      ),

      transparent
      56%
    );

  transition:
    opacity
    .35s
    ease;
}


.ukiyo-impact--{{ uid }} .ukiyo-impact__card:hover .ukiyo-impact__spotlight {
  opacity: 1;
}


.ukiyo-impact--{{ uid }} .ukiyo-impact__card-grid {
  position: absolute;
  inset: 0;
  z-index: -2;

  opacity: .24;

  background-image:
    linear-gradient(
      rgba(255,255,255,.025)
      1px,
      transparent
      1px
    ),

    linear-gradient(
      90deg,
      rgba(255,255,255,.025)
      1px,
      transparent
      1px
    );

  background-size:
    42px
    42px;

  mask-image:
    linear-gradient(
      135deg,
      black,
      transparent 70%
    );

  -webkit-mask-image:
    linear-gradient(
      135deg,
      black,
      transparent 70%
    );
}


/* ============================================================
   CARD TOP
