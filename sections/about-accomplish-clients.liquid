{% comment %}
  UKIYO — Services Experience
  Scroll-controlled video, service pillars, and process.
  Existing Services Hero setting IDs are preserved.
{% endcomment %}

{% assign buttons = section.blocks | where: 'type', 'button' %}

{% capture arrow %}
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M4 12h15M13 5l7 7-7 7"/>
  </svg>
{% endcapture %}

<div
  id="UkiyoServices-{{ section.id }}"
  class="us"
  data-services-experience
>
  <div class="us__backdrop" aria-hidden="true">
    {% if section.settings.poster != blank %}
      {{
        section.settings.poster
        | image_url: width: 2400
        | image_tag:
          class: 'us__poster',
          widths: '750, 1100, 1600, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: ''
      }}
    {% endif %}

    {% if section.settings.video_url != blank %}
      <video
        class="us__video"
        muted
        playsinline
        preload="metadata"
        tabindex="-1"
        {% if section.settings.poster != blank %}
          poster="{{ section.settings.poster | image_url: width: 2400 }}"
        {% endif %}
        data-us-video
      >
        <source
          src="{{ section.settings.video_url | escape }}"
          type="video/mp4"
        >
      </video>
    {% endif %}

    <div class="us__shade"></div>
  </div>

  <div class="us__content">
    <section
      class="us__hero us__container"
      data-testid="services-hero"
      aria-labelledby="US-Title-{{ section.id }}"
    >
      <div class="us__masthead" data-us-reveal>
        <span class="us__brand">UKIYO</span>

        {% if section.settings.strap != blank %}
          <span class="us__mono us__masthead-label">
            {{ section.settings.strap | escape }}
          </span>
        {% endif %}

        <button
          class="us__motion"
          type="button"
          aria-pressed="false"
          data-us-motion
          hidden
        >
          Pause motion
        </button>
      </div>

      <div class="us__hero-grid">
        {% if section.settings.description != blank %}
          <p class="us__description" data-us-reveal>
            {{ section.settings.description | escape }}
          </p>
        {% endif %}

        <h1
          id="US-Title-{{ section.id }}"
          class="us__title"
          data-us-reveal
        >
          <span>{{ section.settings.title_line1 | escape }}</span>
          <span>{{ section.settings.title_line2 | escape }}</span>
        </h1>

        <div class="us__hero-actions">
          {% for block in buttons %}
            {% if block.settings.placement == 'hero' %}
              {% if block.settings.label != blank and block.settings.link != blank %}
                <a
                  class="us__button"
                  href="{{ block.settings.link | escape }}"
                  {{ block.shopify_attributes }}
                >
                  <span>{{ block.settings.label | escape }}</span>
                  <i>{{ arrow }}</i>
                </a>
              {% endif %}
            {% endif %}
          {% endfor %}

          {% if section.settings.scroll_text != blank %}
            <a
              class="us__scroll us__mono"
              href="#US-Services-{{ section.id }}"
              data-us-scroll
            >
              {{ section.settings.scroll_text | escape }}
              <span aria-hidden="true">↓</span>
            </a>
          {% endif %}
        </div>
      </div>

      {% if section.settings.watermark != blank %}
        <span class="us__watermark" aria-hidden="true">
          {{ section.settings.watermark | escape }}
        </span>
      {% endif %}
    </section>

    <section
      id="US-Services-{{ section.id }}"
      class="us__services us__container"
      aria-labelledby="US-Overview-{{ section.id }}"
    >
      <div class="us__section-meta us__mono" data-us-reveal>
        <span>01 / Our expertise</span>
        <span>Strategy meets execution</span>
      </div>

      <h2
        id="US-Overview-{{ section.id }}"
        class="us__overview"
        data-us-words
      >
        {{ section.settings.overview | escape }}
      </h2>

      <div class="us__pillars">
        <article class="us__pillar" data-us-reveal>
          <div class="us__pillar-top us__mono">
            <span>{{ section.settings.brand_label | escape }}</span>
            <span aria-hidden="true">01</span>
          </div>

          <div class="us__pillar-icon" aria-hidden="true">
            <svg viewBox="0 0 64 64">
              <circle cx="32" cy="32" r="25"/>
              <ellipse cx="32" cy="32" rx="12" ry="25"/>
              <path d="M7 32h50M11 18h42M11 46h42"/>
            </svg>
          </div>

          <h3>{{ section.settings.brand_title | escape }}</h3>

          <div class="us__body">
            {{ section.settings.brand_body }}
          </div>

          {% if section.settings.brand_tags != blank %}
            <ul class="us__tags us__mono" role="list">
              {% assign brand_tags = section.settings.brand_tags | split: ',' %}
              {% for tag in brand_tags %}
                <li>{{ tag | strip | escape }}</li>
              {% endfor %}
            </ul>
          {% endif %}

          <div class="us__pillar-actions">
            {% for block in buttons %}
              {% if block.settings.placement == 'brand' %}
                {% if block.settings.label != blank and block.settings.link != blank %}
                  <a
                    class="us__button"
                    href="{{ block.settings.link | escape }}"
                    {{ block.shopify_attributes }}
                  >
                    <span>{{ block.settings.label | escape }}</span>
                    <i>{{ arrow }}</i>
                  </a>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
        </article>

        <article class="us__pillar" data-us-reveal>
          <div class="us__pillar-top us__mono">
            <span>{{ section.settings.ai_label | escape }}</span>
            <span aria-hidden="true">02</span>
          </div>

          <div class="us__pillar-icon" aria-hidden="true">
            <svg viewBox="0 0 64 64">
              <rect x="23" y="23" width="18" height="18" rx="3"/>
              <path d="M32 23V9M32 41v14M23 32H9M41 32h14"/>
              <path d="M23 23 13 13M41 23l10-10M23 41 13 51M41 41l10 10"/>
              <circle cx="32" cy="7" r="2"/>
              <circle cx="32" cy="57" r="2"/>
              <circle cx="7" cy="32" r="2"/>
              <circle cx="57" cy="32" r="2"/>
            </svg>
          </div>

          <h3>{{ section.settings.ai_title | escape }}</h3>

          <div class="us__body">
            {{ section.settings.ai_body }}
          </div>

          {% if section.settings.ai_tags != blank %}
            <ul class="us__tags us__mono" role="list">
              {% assign ai_tags = section.settings.ai_tags | split: ',' %}
              {% for tag in ai_tags %}
                <li>{{ tag | strip | escape }}</li>
              {% endfor %}
            </ul>
          {% endif %}

          <div class="us__pillar-actions">
            {% for block in buttons %}
              {% if block.settings.placement == 'ai' %}
                {% if block.settings.label != blank and block.settings.link != blank %}
                  <a
                    class="us__button"
                    href="{{ block.settings.link | escape }}"
                    {{ block.shopify_attributes }}
                  >
                    <span>{{ block.settings.label | escape }}</span>
                    <i>{{ arrow }}</i>
                  </a>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
        </article>
      </div>
    </section>

    <section
      class="us__process-wrap us__container"
      aria-labelledby="US-Process-{{ section.id }}"
      data-us-endpoint
    >
      <div class="us__glass">
        <div class="us__process-heading">
          <div data-us-reveal>
            <span class="us__mono us__kicker">02 / Our process</span>
            <h2 id="US-Process-{{ section.id }}">
              {{ section.settings.process_title | escape }}
            </h2>
          </div>

          <p data-us-reveal>
            {{ section.settings.process_intro | escape }}
          </p>
        </div>

        <ol class="us__steps" role="list">
          {% for index in (1..4) %}
            {% assign title_key = 'step_' | append: index | append: '_title' %}
            {% assign body_key = 'step_' | append: index | append: '_body' %}

            <li class="us__step" data-us-reveal>
              <span class="us__step-number us__mono">
                0{{ index }}
              </span>
              <h3>{{ section.settings[title_key] | escape }}</h3>
              <p>{{ section.settings[body_key] | escape }}</p>
            </li>
          {% endfor %}
        </ol>

        <div class="us__closing">
          <h2 data-us-reveal>
            {{ section.settings.closing_title | escape }}
          </h2>

          <div class="us__closing-actions">
            {% for block in buttons %}
              {% if block.settings.placement == 'process' %}
                {% if block.settings.label != blank and block.settings.link != blank %}
                  <a
                    class="us__button us__button--white"
                    href="{{ block.settings.link | escape }}"
                    {{ block.shopify_attributes }}
                  >
                    <span>{{ block.settings.label | escape }}</span>
                    <i>{{ arrow }}</i>
                  </a>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&display=swap');

  .us {
    display: grid;
    position: relative;
    isolation: isolate;
    background: #050606;
    color: #fff;
    font-family: "Manrope", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .us *,
  .us *::before,
  .us *::after {
    box-sizing: border-box;
  }

  .us .us__backdrop {
    grid-area: 1 / 1;
    position: sticky;
    top: 0;
    align-self: start;
    width: 100%;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 65% 25%, #394644, #101918 55%, #050606);
  }

  .us .us__poster,
  .us .us__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .us .us__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, #0005, #0002 28%, #0009 100%),
      linear-gradient(90deg, #0006, #0003);
  }

  .us .us__content {
    grid-area: 1 / 1;
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .us .us__container {
    width: min(1440px, 90%);
    margin-inline: auto;
  }

  .us .us__mono {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .us .us__hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 760px;
    min-height: max(700px, 100svh);
    padding-block: clamp(28px, 4vw, 64px) 54px;
  }

  .us .us__masthead {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  .us .us__brand {
    font-size: 30px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -.065em;
  }

  .us .us__masthead-label {
    padding-left: 24px;
    border-left: 1px solid #ffffff55;
    color: #e4e8e2;
  }

  .us .us__motion {
    min-height: 44px;
    padding: 8px 0 8px 12px;
    margin-left: auto;
    border: 0;
    background: transparent;
    color: #d5dad4;
    font-family: inherit;
    font-size: 10px;
    cursor: pointer;
  }

  .us .us__motion[hidden] {
    display: none;
  }

  .us .us__hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    grid-template-rows: minmax(240px, 1fr) auto;
    grid-template-areas:
      ". description"
      "title actions";
    align-items: end;
    gap: 44px;
    flex: 1;
    padding-top: 80px;
  }

  .us .us__title {
    grid-area: title;
    margin: 0;
    color: #fff;
    font-family: inherit;
    font-size: clamp(48px, 6.3vw, 94px);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -.055em;
    text-transform: none;
    overflow-wrap: break-word;
  }

  .us .us__title span {
    display: block;
    text-wrap: balance;
  }

  .us .us__title span + span {
    color: #e1e7df;
  }

  .us .us__description {
    grid-area: description;
    align-self: center;
    max-width: 460px;
    margin: 0 0 0 auto;
    color: #ecefe9;
    font-size: clamp(17px, 1.65vw, 22px);
    font-weight: 400;
    line-height: 1.55;
    text-align: right;
    text-wrap: pretty;
  }

  .us .us__hero-actions {
    grid-area: actions;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 18px;
  }

  .us .us__button {
    display: inline-flex;
    align-items: stretch;
    gap: 3px;
    max-width: 100%;
    color: #fff;
    text-decoration: none;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: .015em;
    text-transform: uppercase;
  }

  .us .us__button > span,
  .us .us__button > i {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    background: #ffffff15;
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    transition: background .3s, color .3s;
  }

  .us .us__button > span {
    padding: 17px 24px;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .us .us__button > i {
    position: relative;
    flex: 0 0 56px;
    width: 56px;
    overflow: hidden;
    font-style: normal;
  }

  .us .us__button svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .us .us__button--white {
    color: #101410;
  }

  .us .us__button--white > span,
  .us .us__button--white > i {
    background: #f3f5ef;
  }

  .us .us__scroll {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 44px;
    color: #d5ddd2;
    text-decoration: none;
  }

  .us .us__scroll > span {
    font-size: 20px;
  }

  .us .us__watermark {
    position: absolute;
    bottom: 20%;
    left: 0;
    max-width: 100%;
    overflow: hidden;
    color: #ffffff04;
    font-size: 15vw;
    line-height: 1;
    font-weight: 700;
    letter-spacing: -.07em;
    pointer-events: none;
    white-space: nowrap;
  }

  .us .us__services {
    padding-block: clamp(100px, 13vw, 200px);
    scroll-margin-top: 40px;
  }

  .us .us__section-meta {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 36px;
    color: #e0e7dd;
  }

  .us .us__overview {
    max-width: 1200px;
    margin: 0;
    color: #fff;
    font-family: inherit;
    font-size: clamp(30px, 4.5vw, 64px);
    font-weight: 500;
    line-height: 1.16;
    letter-spacing: -.045em;
    text-transform: none;
    text-wrap: pretty;
  }

  .us .us__word {
    display: inline-block;
  }

  .us .us__pillars {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(32px, 7vw, 110px);
    margin-top: clamp(54px, 8vw, 112px);
  }

  .us .us__pillar {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding-top: 24px;
    border-top: 1px solid #ffffff50;
  }

  .us .us__pillar-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    color: #d7e0d3;
  }

  .us .us__pillar-icon {
    margin-block: 34px 24px;
  }

  .us .us__pillar-icon svg {
    display: block;
    width: 58px;
    height: 58px;
    fill: none;
    stroke: #e5ecdf;
    stroke-width: 1.1;
  }

  .us .us__pillar h3 {
    margin: 0 0 24px;
    color: #fff;
    font-family: inherit;
    font-size: clamp(24px, 2.5vw, 36px);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -.035em;
    overflow-wrap: break-word;
  }

  .us .us__body {
    max-width: 560px;
    color: #e1e6dd;
    font-size: 15px;
    line-height: 1.8;
  }

  .us .us__body p {
    margin: 0 0 18px;
  }

  .us .us__body strong {
    color: #fff;
    font-weight: 600;
  }

  .us .us__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: auto 0 0;
    padding: 20px 0 0;
  }

  .us .us__tags li {
    padding: 7px 12px;
    border: 1px solid #ffffff38;
    color: #e7ede3;
    background: #00000020;
    font-size: 9px;
  }

  .us .us__pillar-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 25px;
  }

  .us .us__pillar-actions:empty {
    display: none;
  }

  .us .us__process-wrap {
    padding-bottom: clamp(32px, 5vw, 80px);
  }

  .us .us__glass {
    padding: clamp(28px, 4.5vw, 68px);
    background: rgba(20, 24, 22, .8);
    border: 1px solid #ffffff28;
    backdrop-filter: blur(36px);
    -webkit-backdrop-filter: blur(36px);
  }

  .us .us__process-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: end;
    gap: 36px;
    padding-bottom: 48px;
    border-bottom: 1px solid #ffffff28;
  }

  .us .us__kicker {
    display: block;
    color: #c6d1c1;
    margin-bottom: 18px;
  }

  .us .us__process-heading h2,
  .us .us__closing h2 {
    margin: 0;
    color: #fff;
    font-family: inherit;
    font-size: clamp(30px, 3.7vw, 52px);
    font-weight: 500;
    letter-spacing: -.045em;
    line-height: 1.1;
    text-transform: none;
    text-wrap: balance;
  }

  .us .us__process-heading > p {
    max-width: 350px;
    margin: 0;
    color: #d1d8cc;
    font-size: 15px;
    line-height: 1.7;
  }

  .us .us__steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 48px 0;
  }

  .us .us__step {
    min-width: 0;
  }

  .us .us__step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    margin-bottom: 24px;
    border: 1px solid #ffffff40;
    color: #e2ebdc;
  }

  .us .us__step h3 {
    margin: 0 0 14px;
    color: #fff;
    font-family: inherit;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -.02em;
  }

  .us .us__step p {
    margin: 0;
    color: #c9d1c4;
    font-size: 13px;
    line-height: 1.8;
  }

  .us .us__closing {
    display: flex;
    align-items: end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 32px;
    padding-top: 42px;
    border-top: 1px solid #ffffff28;
  }

  .us .us__closing h2 {
    max-width: 600px;
    font-size: clamp(28px, 3.2vw, 44px);
  }

  .us .us__closing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .us .us__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .us a:focus-visible,
  .us button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 5px;
  }

  @media (hover: hover) and (pointer: fine) {
    .us .us__button:hover > span,
    .us .us__button:hover > i {
      background: #fff;
      color: #111;
    }

    .us .us__button:hover svg {
      animation: us-arrow .45s ease both;
    }
  }

  @keyframes us-arrow {
    0% { transform: translateX(0); opacity: 1; }
    45% { transform: translateX(32px); opacity: 0; }
    46% { transform: translateX(-32px); opacity: 0; }
    100% { transform: translateX(0); opacity: 1; }
  }

  @media (max-width: 1000px) {
    .us .us__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 36px;
    }

    .us .us__hero-grid {
      gap: 30px;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    }

    .us .us__button > span {
      padding-inline: 18px;
    }
  }

  @media (max-width: 700px) {
    .us .us__container {
      width: calc(100% - 40px);
    }

    .us .us__hero {
      min-height: 100svh;
      padding-block: 24px 36px;
    }

    .us .us__masthead {
      gap: 16px;
      flex-wrap: wrap;
    }

    .us .us__brand {
      font-size: 27px;
    }

    .us .us__masthead-label {
      font-size: 8px;
      padding-left: 16px;
    }

    .us .us__hero-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(90px, 1fr) auto auto auto;
      grid-template-areas: "." "title" "description" "actions";
      gap: 26px;
      padding-top: 20px;
    }

    .us .us__title {
      font-size: clamp(42px, 11vw, 68px);
      line-height: 1.06;
    }

    .us .us__description {
      align-self: start;
      max-width: 38ch;
      margin: 0;
      font-size: 15px;
      line-height: 1.7;
      text-align: left;
    }

    .us .us__hero-actions {
      align-items: stretch;
      gap: 12px;
    }

    .us .us__button {
      width: 100%;
    }

    .us .us__button > span {
      justify-content: flex-start;
      flex: 1;
    }

    .us .us__scroll {
      justify-content: flex-start;
    }

    .us .us__shade {
      background: linear-gradient(180deg, #0006, #0005 20%, #000b 65%, #000d);
    }

    .us .us__services {
      padding-block: 80px;
    }

    .us .us__section-meta {
      margin-bottom: 26px;
      font-size: 8px;
    }

    .us .us__section-meta > span:last-child {
      display: none;
    }

    .us .us__overview {
      font-size: clamp(29px, 7.5vw, 42px);
      line-height: 1.2;
    }

    .us .us__pillars {
      grid-template-columns: minmax(0, 1fr);
      gap: 54px;
      margin-top: 48px;
    }

    .us .us__body {
      font-size: 14px;
    }

    .us .us__glass {
      padding: 28px 22px;
    }

    .us .us__process-heading {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
      padding-bottom: 32px;
    }

    .us .us__steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding-block: 12px;
    }

    .us .us__step {
      display: grid;
      grid-template-columns: 42px minmax(0, 1fr);
      gap: 8px 18px;
      padding-block: 25px;
      border-bottom: 1px solid #ffffff18;
    }

    .us .us__step:last-child {
      border-bottom: 0;
    }

    .us .us__step-number {
      grid-row: span 2;
      margin: 0;
    }

    .us .us__step h3 {
      margin: 0;
    }

    .us .us__step p {
      grid-column: 2;
    }

    .us .us__closing-actions {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .us *,
    .us *::before,
    .us *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }

    .us .us__motion {
      display: none;
    }
  }
</style>

<script>
(function () {
  const rootId = 'UkiyoServices-{{ section.id }}';
  const wrapperId = 'shopify-section-{{ section.id }}';

  window.__ukiyoServices = window.__ukiyoServices || {};

  if (window.__ukiyoServices[rootId]) {
    window.__ukiyoServices[rootId]();
  }

  const lifecycle = new AbortController();
  let cleanup = null;

  function init() {
    const root = document.getElementById(rootId);
    if (!root) return;
    if (cleanup) cleanup();

    const events = new AbortController();
    const signal = events.signal;
    const video = root.querySelector('[data-us-video]');
    const endpoint = root.querySelector('[data-us-endpoint]');
    const motionButton = root.querySelector('[data-us-motion]');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const revealElements = [...root.querySelectorAll('[data-us-reveal]')];

    let paused = false;
    let destroyed = false;
    let frame = null;
    let targetTime = 0;
    let words = [];
    let originalText = '';

    const revealed = new Set();
    const animations = new Set();
    const wordHeading = root.querySelector('[data-us-words]');

    /*
      Keep one accessible copy of the heading.
      Animate a separate visual copy word by word.
    */
    if (wordHeading) {
      originalText = wordHeading.textContent.trim();
      wordHeading.textContent = '';

      const accessible = document.createElement('span');
      accessible.className = 'us__sr';
      accessible.textContent = originalText;

      const visual = document.createElement('span');
      visual.setAttribute('aria-hidden', 'true');

      originalText.split(/\s+/).filter(Boolean).forEach((word, index) => {
        if (index) visual.appendChild(document.createTextNode(' '));

        const span = document.createElement('span');
        span.className = 'us__word';
        span.textContent = word;
        visual.appendChild(span);
      });

      wordHeading.append(accessible, visual);
      words = [...visual.querySelectorAll('.us__word')];
    }

    function allowed() {
      return !paused && !reduced.matches;
    }

    function updateButton() {
      if (!motionButton) return;
      motionButton.hidden = reduced.matches;
      motionButton.setAttribute('aria-pressed', String(paused));
      motionButton.textContent = paused ? 'Enable motion' : 'Pause motion';
    }

    function seekVideo() {
      if (
        destroyed ||
        !video ||
        !allowed() ||
        document.hidden ||
        video.seeking ||
        video.readyState < 1 ||
        !Number.isFinite(video.duration)
      ) return;

      const safeTime = Math.max(
        0,
        Math.min(targetTime, Math.max(0, video.duration - .05))
      );

      if (Math.abs(video.currentTime - safeTime) < .04) return;

      try {
        video.currentTime = safeTime;
      } catch (error) {
        /* Keep the poster or last decoded frame while media loads. */
      }
    }

    function reveal(element, delay) {
      if (!element.animate || revealed.has(element)) return;
      revealed.add(element);

      const animation = element.animate(
        [
          { opacity: 0, transform: 'translateY(25px)' },
          { opacity: 1, transform: 'translateY(0)' }
        ],
        {
          duration: 850,
          delay,
          fill: 'backwards',
          easing: 'cubic-bezier(.16,1,.3,1)'
        }
      );

      animations.add(animation);
      animation.finished
        .then(() => animations.delete(animation))
        .catch(() => animations.delete(animation));
    }

    function updateWords() {
      if (!wordHeading || !words.length) return;

      if (!allowed()) {
        words.forEach(word => {
          word.style.opacity = '1';
          word.style.filter = 'none';
        });
        return;
      }

      const rect = wordHeading.getBoundingClientRect();
      const viewport = window.innerHeight;
      const range = Math.max(viewport * .55, rect.height);

      const progress = Math.max(
        0,
        Math.min(1, (viewport * .9 - rect.top) / range)
      );

      words.forEach((word, index) => {
        const start = (index / words.length) * .65;
        const amount = Math.max(0, Math.min(1, (progress - start) / .35));

        word.style.opacity = String(.3 + amount * .7);
        word.style.filter = `blur(${(1 - amount) * 2}px)`;
      });
    }

    function update() {
      frame = null;
      if (destroyed || !root.isConnected) return;

      const rect = root.getBoundingClientRect();
      const visible = rect.bottom > 0 && rect.top < innerHeight;

      if (!visible) return;

      if (allowed()) {
        let index = 0;

        revealElements.forEach(element => {
          const bounds = element.getBoundingClientRect();

          if (bounds.top < innerHeight * .96 && bounds.bottom > 0) {
            reveal(element, Math.min(index++, 4) * 80);
          }
        });

        if (video && endpoint && Number.isFinite(video.duration)) {
          const endpointRect = endpoint.getBoundingClientRect();
          const endpointWithinRoot = endpointRect.top - rect.top;
          const travel = Math.max(1, endpointWithinRoot - innerHeight * .2);
          const progress = Math.max(0, Math.min(1, -rect.top / travel));

          targetTime = progress * video.duration;
          seekVideo();
        }
      }

      updateWords();
    }

    function schedule() {
      if (frame !== null || destroyed) return;
      frame = requestAnimationFrame(update);
    }

    function stopAnimations() {
      animations.forEach(animation => animation.cancel());
      animations.clear();
    }

    motionButton?.addEventListener('click', () => {
      paused = !paused;
      if (paused) stopAnimations();
      updateButton();
      updateWords();
      schedule();
    }, { signal });

    reduced.addEventListener('change', () => {
      if (reduced.matches) stopAnimations();
      updateButton();
      updateWords();
      schedule();
    }, { signal });

    root.querySelector('[data-us-scroll]')?.addEventListener('click', event => {
      event.preventDefault();
      root.querySelector('.us__services').scrollIntoView({
        behavior: reduced.matches ? 'auto' : 'smooth',
        block: 'start'
      });
    }, { signal });

    if (video) {
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;
      video.pause();

      video.addEventListener('loadedmetadata', schedule, { signal });
      video.addEventListener('loadeddata', schedule, { signal });

      /*
        Once the current seek finishes, apply the latest target.
        This avoids losing the final scroll position during a seek.
      */
      video.addEventListener('seeked', seekVideo, { signal });
    }

    document.addEventListener('scroll', schedule, {
      passive: true,
      capture: true,
      signal
    });

    window.addEventListener('resize', schedule, { passive: true, signal });
    document.addEventListener('visibilitychange', schedule, { signal });

    let resizeObserver = null;

    if ('ResizeObserver' in window) {
      resizeObserver = new ResizeObserver(schedule);
      resizeObserver.observe(root);
    }

    updateButton();
    schedule();

    cleanup = function () {
      destroyed = true;
      events.abort();
      resizeObserver?.disconnect();
      if (frame !== null) cancelAnimationFrame(frame);
      stopAnimations();
      video?.pause();

      if (wordHeading) {
        wordHeading.textContent = originalText;
      }
    };
  }

  document.addEventListener('shopify:section:load', event => {
    if (event.target.id === wrapperId) init();
  }, { signal: lifecycle.signal });

  document.addEventListener('shopify:section:unload', event => {
    if (event.target.id === wrapperId && cleanup) {
      cleanup();
      cleanup = null;
    }
  }, { signal: lifecycle.signal });

  window.__ukiyoServices[rootId] = function () {
    lifecycle.abort();
    if (cleanup) cleanup();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, {
      once: true,
      signal: lifecycle.signal
    });
  } else {
    init();
  }
})();
</script>

