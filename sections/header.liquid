{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "UKIYO" },
    { "type": "text", "id": "logo_subtext", "label": "Logo subtext", "default": "PRODUCTIONS" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "dropdown_handles", "label": "Link handles that show mega dropdown (comma-separated)", "default": "services, shop" },
    { "type": "header", "content": "Header icons" },
    { "type": "checkbox", "id": "show_wishlist_icon", "label": "Show wishlist icon", "default": true },
    { "type": "url", "id": "wishlist_page_url", "label": "Wishlist page URL", "info": "Used when wishlist icon is shown. Defaults to /pages/wishlist if empty." },
    { "type": "checkbox", "id": "show_account_icon", "label": "Show account icon", "default": true },
    { "type": "checkbox", "id": "show_cart_icon", "label": "Show cart icon", "default": true },
    { "type": "header", "content": "CTA" },
    { "type": "text", "id": "cta_text", "label": "Header CTA text", "default": "Start Project" },
    { "type": "url", "id": "cta_link", "label": "Header CTA link" }
  ],
  "blocks": [
    {
      "type": "dropdown_category",
      "name": "Dropdown category",
      "settings": [
        {
          "type": "text",
          "id": "parent_handle",
          "label": "Parent menu link handle",
          "info": "Must match the menu link handle (e.g. services, shop).",
          "default": "services"
        },
        {
          "type": "text",
          "id": "category_title",
          "label": "Category title"
        },
        {
          "type": "textarea",
          "id": "links_text",
          "label": "Links (one per line)",
          "info": "Format: Label|URL (e.g. Company Agent Builder|/services/company-agent-builder)"
        }
      ]
    },
    {
      "type": "dropdown_compact",
      "name": "Dropdown (compact)",
      "settings": [
        {
          "type": "text",
          "id": "parent_handle",
          "label": "Parent menu link handle",
          "info": "Must match the menu link handle (e.g. shop, membership).",
          "default": "shop"
        },
        {
          "type": "text",
          "id": "header_title",
          "label": "Header link title",
          "info": "Optional. Single prominent link at top (e.g. Membership Overview)."
        },
        {
          "type": "url",
          "id": "header_url",
          "label": "Header link URL"
        },
        {
          "type": "text",
          "id": "section_label",
          "label": "Section label",
          "info": "Optional. Small uppercase label above the link list (e.g. Categories).",
          "default": "Categories"
        },
        {
          "type": "textarea",
          "id": "links_text",
          "label": "Links (one per line)",
          "info": "Format: Label|URL (e.g. Automation Templates|/shop/automation-templates)"
        }
      ]
    }
  ]
}
{% endschema %}
