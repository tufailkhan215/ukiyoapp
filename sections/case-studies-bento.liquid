{% comment %}
  Section: Case Studies Bento Grid
  File: sections/case-studies-bento.liquid
{% endcomment %}

<style>
  #csb-{{ section.id }} {
    --accent: {{ section.settings.accent_color | default: '#a78bfa' }};
    --bg:     #000;
    --border: rgba(255,255,255,0.07);
    --gap:    10px;
    --r:      16px;
    background: var(--bg);
    position:   relative;
    overflow:   hidden;
  }
  #csb-{{ section.id }} * { box-sizing: border-box; }

  #csb-{{ section.id }} .rule {
    position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
  }

  /* Wrap */
  #csb-{{ section.id }} .wrap {
    max-width: 1400px; margin: 0 auto;
    padding: 5rem 1.5rem 6rem; position: relative; z-index: 1;
  }

  /* Header */
  #csb-{{ section.id }} .hdr {
    display: flex; flex-direction: column; align-items: flex-start;
    gap: 1.25rem; margin-bottom: 2.5rem;
  }
  @media (min-width: 768px) {
    #csb-{{ section.id }} .hdr { flex-direction: row; align-items: flex-end; justify-content: space-between; }
  }

  #csb-{{ section.id }} .eyebrow {
    font-size: 0.6rem; font-weight: 700; letter-spacing: 0.28em;
    text-transform: uppercase; color: rgba(255,255,255,0.35);
    display: block; margin-bottom: 0.6rem;
  }
  #csb-{{ section.id }} h2 {
    font-size: clamp(1.9rem, 4vw, 3rem); font-weight: 900;
    letter-spacing: -0.03em; line-height: 1; margin: 0; color: #fff;
  }
  #csb-{{ section.id }} h2 em {
    font-style: normal;
    background: linear-gradient(90deg, #fff 0%, #6b7280 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }

  /* Filters */
  #csb-{{ section.id }} .filters {
    display: flex; align-items: center; gap: 0.4rem;
    overflow-x: auto; padding-bottom: 2px; scrollbar-width: none; flex-wrap: nowrap;
  }
  #csb-{{ section.id }} .filters::-webkit-scrollbar { display: none; }
  #csb-{{ section.id }} .fi { color: rgba(255,255,255,0.3); flex-shrink: 0; font-size: 0.8rem; }
  #csb-{{ section.id }} .chip {
    flex-shrink: 0; padding: 0.38rem 0.9rem; border-radius: 999px;
    font-size: 0.76rem; font-weight: 600; white-space: nowrap; cursor: pointer;
    border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.04);
    color: rgba(255,255,255,0.5); transition: background .2s, color .2s, border-color .2s;
  }
  #csb-{{ section.id }} .chip:hover  { background: rgba(255,255,255,0.08); color: rgba(255,255,255,.85); }
  #csb-{{ section.id }} .chip.on     { background: #fff; color: #000; border-color: #fff; }

  /* ── BENTO GRID ── */
  #csb-{{ section.id }} .grid {
    display: grid; gap: var(--gap); grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    #csb-{{ section.id }} .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    #csb-{{ section.id }} .grid {
      grid-template-columns: repeat(10, 1fr);
      grid-auto-rows: 240px;
    }
    /* Row A: large hero (6/10) + tall right (4/10) — each 2 rows */
    #csb-{{ section.id }} .grid .c:nth-child(5n+1) { grid-column: span 6; grid-row: span 2; }
    #csb-{{ section.id }} .grid .c:nth-child(5n+2) { grid-column: span 4; grid-row: span 2; }
    /* Row B: 3 equal cards */
    #csb-{{ section.id }} .grid .c:nth-child(5n+3) { grid-column: span 3; }
    #csb-{{ section.id }} .grid .c:nth-child(5n+4) { grid-column: span 4; }
    #csb-{{ section.id }} .grid .c:nth-child(5n+5) { grid-column: span 3; }
  }

  /* Card */
  #csb-{{ section.id }} .c {
    position: relative; overflow: hidden; border-radius: var(--r);
    border: 1px solid var(--border); display: block;
    text-decoration: none; color: #fff; min-height: 260px;
    opacity: 0; transform: translateY(20px);
    transition: opacity .65s cubic-bezier(.4,0,.2,1), transform .65s cubic-bezier(.4,0,.2,1), border-color .3s;
  }
  #csb-{{ section.id }} .c.on    { opacity: 1; transform: translateY(0); }
  #csb-{{ section.id }} .c.hide  { display: none; }
  #csb-{{ section.id }} .c:hover { border-color: rgba(255,255,255,0.2); }

  /* Image */
  #csb-{{ section.id }} .c img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; transition: transform .75s cubic-bezier(.165,.84,.44,1);
  }
  #csb-{{ section.id }} .c:hover img { transform: scale(1.07); }
  #csb-{{ section.id }} .no-img {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, #0e0e0e 0%, #1c1c1c 100%);
  }

  /* Overlays */
  #csb-{{ section.id }} .grad {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.55) 35%, rgba(0,0,0,0.08) 65%, transparent 100%);
  }
  #csb-{{ section.id }} .tint {
    position: absolute; inset: 0;
    background: rgba(109,40,217,0); transition: background .5s;
  }
  #csb-{{ section.id }} .c:hover .tint { background: rgba(109,40,217,0.13); }

  /* Badge */
  #csb-{{ section.id }} .badge {
    position: absolute; top: 1rem; left: 1rem; z-index: 4;
    font-size: 0.56rem; font-weight: 800; letter-spacing: 0.16em;
    text-transform: uppercase; color: rgba(255,255,255,0.8);
    background: rgba(0,0,0,0.55); backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.1); padding: 0.22rem 0.65rem; border-radius: 6px;
  }

  /* Arrow */
  #csb-{{ section.id }} .arr {
    position: absolute; top: 1rem; right: 1rem; z-index: 4;
    width: 36px; height: 36px; border-radius: 50%;
    background: rgba(255,255,255,0.07); backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.1);
    display: flex; align-items: center; justify-content: center;
    font-size: .9rem; opacity: 0;
    transform: scale(0.75) rotate(-45deg);
    transition: opacity .3s, transform .3s, background .3s;
  }
  #csb-{{ section.id }} .c:hover .arr { opacity: 1; transform: scale(1) rotate(0); background: rgba(255,255,255,0.15); }

  /* Body */
  #csb-{{ section.id }} .body {
    position: absolute; bottom: 0; left: 0; right: 0;
    padding: 1.5rem; z-index: 4;
  }
  @media (min-width: 1024px) {
    #csb-{{ section.id }} .grid .c:nth-child(5n+1) .body,
    #csb-{{ section.id }} .grid .c:nth-child(5n+2) .body { padding: 2rem; }
  }

  #csb-{{ section.id }} .cl {
    font-size: .7rem; font-weight: 500; color: rgba(255,255,255,0.4);
    margin: 0 0 .25rem; opacity: 0; transform: translateY(6px);
    transition: opacity .3s, transform .3s;
  }
  #csb-{{ section.id }} .c:hover .cl { opacity: 1; transform: translateY(0); }

  #csb-{{ section.id }} .ttl {
    font-size: clamp(1rem, 1.8vw, 1.35rem); font-weight: 900;
    line-height: 1.18; letter-spacing: -.015em; color: #fff;
    margin: 0 0 .55rem; transition: color .3s;
  }
  @media (min-width: 1024px) {
    #csb-{{ section.id }} .grid .c:nth-child(5n+1) .ttl { font-size: clamp(1.35rem, 2.2vw, 1.95rem); }
  }
  #csb-{{ section.id }} .c:hover .ttl { color: var(--accent); }

  #csb-{{ section.id }} .dsc {
    font-size: .8rem; color: rgba(255,255,255,0.48); line-height: 1.55;
    margin: 0 0 .75rem; overflow: hidden; display: -webkit-box;
    -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    opacity: 0; transform: translateY(6px);
    transition: opacity .3s .04s, transform .3s .04s;
  }
  #csb-{{ section.id }} .c:hover .dsc { opacity: 1; transform: translateY(0); }

  #csb-{{ section.id }} .res {
    display: flex; flex-wrap: wrap; gap: .3rem;
    opacity: 0; transform: translateY(6px);
    transition: opacity .3s .08s, transform .3s .08s;
  }
  #csb-{{ section.id }} .c:hover .res { opacity: 1; transform: translateY(0); }
  #csb-{{ section.id }} .rc {
    font-size: .65rem; font-weight: 700; padding: .18rem .6rem;
    border-radius: 5px; color: rgba(255,255,255,0.65);
    background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.07); white-space: nowrap;
  }

  #csb-{{ section.id }} .vcs {
    display: inline-block; margin-top: .55rem;
    font-size: .65rem; font-weight: 800; letter-spacing: .1em;
    text-transform: uppercase; color: var(--accent);
    opacity: 0; transition: opacity .3s .12s;
  }
  #csb-{{ section.id }} .c:hover .vcs { opacity: 1; }

  /* Empty */
  #csb-{{ section.id }} .mt { display:none; grid-column:1/-1; padding:5rem; text-align:center; color:rgba(255,255,255,.3); }
  #csb-{{ section.id }} .mt.show { display: block; }

  @media (prefers-reduced-motion: reduce) {
    #csb-{{ section.id }} .c,
    #csb-{{ section.id }} .c img,
    #csb-{{ section.id }} .cl, #csb-{{ section.id }} .dsc,
    #csb-{{ section.id }} .res, #csb-{{ section.id }} .arr,
    #csb-{{ section.id }} .vcs, #csb-{{ section.id }} .tint {
      transition: none !important; opacity: 1 !important; transform: none !important;
    }
  }
</style>

<div id="csb-{{ section.id }}">
  <div class="rule"></div>
  <div class="wrap">

    <div class="hdr">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          {%- assign hw = section.settings.heading | split: ' ' -%}
          <h2>{{ hw | first }} <em>{{ hw | shift | join: ' ' }}</em></h2>
        {%- endif -%}
      </div>

      {%- assign cr = '' -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.category != blank -%}
          {%- unless cr contains block.settings.category -%}
            {%- assign cr = cr | append: block.settings.category | append: '~~~' -%}
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign cats = cr | split: '~~~' -%}

      <div class="filters">
        <span class="fi">▾</span>
        <button class="chip on" data-f="All">All</button>
        {%- for cat in cats -%}
          {%- if cat != blank -%}
            <button class="chip" data-f="{{ cat | escape }}">{{ cat }}</button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="grid" id="g-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- assign rs = block.settings.results | split: '|' -%}
        <a class="c" href="{{ block.settings.link | default: '#' }}"
           data-cat="{{ block.settings.category | escape }}"
           aria-label="{{ block.settings.title | escape }}"
           {{ block.shopify_attributes }}>

          {%- if block.settings.image -%}
            <img src="{{ block.settings.image | img_url: '1400x' }}"
                 alt="{{ block.settings.title | escape }}" loading="lazy" width="1400" height="900">
          {%- else -%}
            <div class="no-img"></div>
          {%- endif -%}

          <div class="grad"></div>
          <div class="tint"></div>

          {%- if block.settings.category != blank -%}
            <span class="badge">{{ block.settings.category }}</span>
          {%- endif -%}
          <span class="arr" aria-hidden="true">↗</span>

          <div class="body">
            {%- if block.settings.client != blank -%}
              <p class="cl">{{ block.settings.client }}</p>
            {%- endif -%}
            <h3 class="ttl">{{ block.settings.title }}</h3>
            {%- if block.settings.description != blank -%}
              <p class="dsc">{{ block.settings.description }}</p>
            {%- endif -%}
            {%- if rs.size > 0 -%}
              <div class="res">
                {%- for r in rs -%}
                  {%- if r != blank -%}<span class="rc">{{ r | strip }}</span>{%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              <span class="vcs">View Case Study →</span>
            {%- endif -%}
          </div>
        </a>
      {%- else -%}
        <p style="grid-column:1/-1;padding:4rem;text-align:center;color:rgba(255,255,255,0.3);">
          Add case study cards in the Theme Editor.
        </p>
      {%- endfor -%}
      <div class="mt" id="mt-{{ section.id }}">No projects in this category.</div>
    </div>

  </div>
</div>

<script>
(function(){
  var id    = '{{ section.id }}';
  var root  = document.getElementById('csb-' + id);
  var grid  = document.getElementById('g-'   + id);
  var empty = document.getElementById('mt-'  + id);
  if (!root || !grid) return;

  var cards = [].slice.call(grid.querySelectorAll('.c'));
  var chips = [].slice.call(root.querySelectorAll('.chip'));

  /* Reveal */
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(es) {
      es.forEach(function(e) {
        if (e.isIntersecting) { e.target.classList.add('on'); io.unobserve(e.target); }
      });
    }, { threshold: 0.07 });
    cards.forEach(function(c,i){ c.style.transitionDelay = Math.min(i*0.06,0.42)+'s'; io.observe(c); });
  } else { cards.forEach(function(c){ c.classList.add('on'); }); }

  /* Filter */
  chips.forEach(function(chip){
    chip.addEventListener('click', function(){
      chips.forEach(function(c){ c.classList.remove('on'); });
      chip.classList.add('on');
      var f = chip.dataset.f; var n = 0;
      cards.forEach(function(card){
        var m = f==='All' || card.dataset.cat===f;
        card.classList.toggle('hide', !m);
        if (m) n++;
      });
      if (empty) empty.classList.toggle('show', n===0);
    });
  });
})();
</script>

{% schema %}
{
  "name": "Case Studies Bento",
  "tag": "section",
  "settings": [
    { "type": "text",  "id": "eyebrow",       "label": "Eyebrow",  "default": "[Case Studies]" },
    { "type": "text",  "id": "heading",        "label": "Heading",  "info": "First word white, rest fades to gray", "default": "Featured Projects" },
    { "type": "color", "id": "accent_color",   "label": "Accent",   "default": "#a78bfa" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Case Study Card",
      "settings": [
        { "type": "image_picker", "id": "image",       "label": "Image" },
        { "type": "text",         "id": "client",      "label": "Client",      "default": "Resiklo" },
        { "type": "text",         "id": "category",    "label": "Category",    "default": "E-commerce" },
        { "type": "text",         "id": "title",       "label": "Title",       "default": "E-commerce Redesign & UI/UX Improvements" },
        { "type": "textarea",     "id": "description", "label": "Description", "default": "Complete platform migration with automation integration." },
        { "type": "text",         "id": "results",     "label": "Results (pipe-separated)", "info": "e.g. 340% Conversion | 85% Saved", "default": "340% Conversion | 85% Time Saved" },
        { "type": "url",          "id": "link",        "label": "Case study link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Case Studies Bento",
      "blocks": [
        { "type": "card", "settings": { "client": "Resiklo",               "category": "E-commerce",  "title": "E-commerce Website Redesign & UI/UX Improvements",       "description": "Complete platform migration with automation integration that increased conversion by 340%.", "results": "340% Conversion | 85% Time Saved | 4x Email" } },
        { "type": "card", "settings": { "client": "The Place on South Pine","category": "Hospitality", "title": "Website Design & Content Strategy",                       "description": "Digital footprint refresh with visual storytelling and automated marketing.",              "results": "3x Reservations | 200% Social Growth" } },
        { "type": "card", "settings": { "client": "Supramood",              "category": "Branding",    "title": "SEO Optimization & Digital Content Creation",             "description": "Comprehensive brand strategy with podcast series and affiliate program.",                "results": "10K+ Downloads | $200K+ Affiliate" } },
        { "type": "card", "settings": { "client": "Dynamic Autoworks",      "category": "E-commerce",  "title": "Premier Automotive Parts E-commerce Platform",            "description": "Large-scale catalog with nationwide shipping supporting 1.5M+ products.",               "results": "1.5M+ Products | <2s Search" } },
        { "type": "card", "settings": { "client": "Fur Traders",            "category": "E-commerce",  "title": "E-commerce Website Design & SEO Optimization",            "description": "Complete brand refresh with content strategy and e-commerce optimization.",             "results": "500% Traffic | 280% Revenue" } }
      ]
    }
  ]
}
{% endschema %}
