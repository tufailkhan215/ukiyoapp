{% comment %} About Team: "Meet the Visionaries" (gradient), grid of team cards with avatar/initials, name, role, description, social links. {% endcomment %}
{% assign member_blocks = section.blocks | where: 'type', 'member' %}
<section class="relative py-24 lg:py-32 overflow-hidden bg-black">
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12 relative z-10">
    <div class="text-center mb-16">
      {% if section.settings.badge != blank %}
        <span class="text-[10px] font-medium text-white/40 tracking-[0.3em] uppercase block mb-4">{{ section.settings.badge }}</span>
      {% endif %}
      {% if section.settings.title_before != blank or section.settings.title_gradient != blank %}
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
          {{ section.settings.title_before }}
          {% if section.settings.title_gradient != blank %}
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400">{{ section.settings.title_gradient }}</span>
          {% endif %}
        </h2>
      {% endif %}
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-12">
      {% for block in member_blocks %}
        <div class="group relative" {{ block.shopify_attributes }}>
          <div class="absolute -inset-2 rounded-2xl bg-gradient-to-r from-white/10 to-gray-500/10 blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>
          <div class="relative p-8 rounded-2xl bg-white/[0.02] border border-white/10 group-hover:border-white/20 transition-all duration-300">
            <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-white/20 to-gray-500/20 flex items-center justify-center mb-6 mx-auto overflow-hidden">
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 160 }}"
                  alt="{{ block.settings.name | escape }}"
                  width="80"
                  height="80"
                  class="w-full h-full object-cover"
                  loading="lazy"
                >
              {% elsif block.settings.initials != blank %}
                <span class="text-2xl font-bold text-white">{{ block.settings.initials }}</span>
              {% endif %}
            </div>
            <div class="text-center">
              {% if block.settings.name != blank %}
                <h3 class="text-xl font-bold text-white mb-1">{{ block.settings.name }}</h3>
              {% endif %}
              {% if block.settings.role != blank %}
                <p class="text-white/60 text-sm mb-4">{{ block.settings.role }}</p>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="text-white/50 text-sm leading-relaxed mb-6">{{ block.settings.description }}</p>
              {% endif %}
              <div class="flex justify-center gap-3">
                {% if block.settings.instagram_url != blank %}
                  <a href="{{ block.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-white/50 hover:text-white hover:bg-white/10 transition-colors" aria-label="Instagram">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-instagram w-4 h-4" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg>
                  </a>
                {% endif %}
                {% if block.settings.email != blank %}
                  <a href="mailto:{{ block.settings.email | escape }}" class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-white/50 hover:text-white hover:bg-white/10 transition-colors" aria-label="Email">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail w-4 h-4" aria-hidden="true"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg>
                  </a>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Team",
  "tag": "section",
  "class": "section-about-team",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "(The Team)"
    },
    {
      "type": "text",
      "id": "title_before",
      "label": "Title (before gradient)",
      "default": "Meet the "
    },
    {
