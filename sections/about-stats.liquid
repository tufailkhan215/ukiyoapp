{% comment %} About Stats: badge + "Numbers That Matter" (gradient), grid of stat cards with white/gray icon gradients and hover glow. {% endcomment %}
{% assign stat_blocks = section.blocks | where: 'type', 'stat' %}
{% capture about_stats_bg_style %}background-color: {{ section.settings.background_color | default: '#000000' }};{% if section.settings.background_image != blank %} background-image: url({{ section.settings.background_image | image_url: width: 1920 }}); background-size: cover; background-position: center;{% endif %}{% endcapture %}
<section class="relative py-24 lg:py-32 overflow-hidden" style="{{ about_stats_bg_style | strip }}">
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/20 to-transparent" aria-hidden="true"></div>
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12 relative z-10">
    <div class="text-center mb-16">
      {% if section.settings.badge != blank %}
        <span class="text-[10px] font-medium text-white/40 tracking-[0.3em] uppercase block mb-4">{{ section.settings.badge }}</span>
      {% endif %}
      {% if section.settings.title_before != blank or section.settings.title_gradient != blank %}
        <h2 class="text-4xl md:text-5xl font-bold text-white">
          {{ section.settings.title_before }}
          {% if section.settings.title_gradient != blank %}
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400">{{ section.settings.title_gradient }}</span>
          {% endif %}
        </h2>
      {% endif %}
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
      {% for block in stat_blocks %}
        {% assign g = block.settings.gradient %}
        <div class="group relative" {{ block.shopify_attributes }}>
          {% if g == 'white_gray4' %}
            <div class="absolute -inset-0.5 rounded-2xl bg-gradient-to-r from-white to-gray-400 opacity-0 group-hover:opacity-20 blur-xl transition-opacity duration-500" aria-hidden="true"></div>
          {% elsif g == 'gray3_gray5' %}
            <div class="absolute -inset-0.5 rounded-2xl bg-gradient-to-r from-gray-300 to-gray-500 opacity-0 group-hover:opacity-20 blur-xl transition-opacity duration-500" aria-hidden="true"></div>
          {% elsif g == 'gray2_gray4' %}
            <div class="absolute -inset-0.5 rounded-2xl bg-gradient-to-r from-gray-200 to-gray-400 opacity-0 group-hover:opacity-20 blur-xl transition-opacity duration-500" aria-hidden="true"></div>
          {% elsif g == 'white_gray3' %}
            <div class="absolute -inset-0.5 rounded-2xl bg-gradient-to-r from-white to-gray-300 opacity-0 group-hover:opacity-20 blur-xl transition-opacity duration-500" aria-hidden="true"></div>
          {% elsif g == 'gray1_gray4' %}
            <div class="absolute -inset-0.5 rounded-2xl bg-gradient-to-r from-gray-100 to-gray-400 opacity-0 group-hover:opacity-20 blur-xl transition-opacity duration-500" aria-hidden="true"></div>
          {% else %}
            <div class="absolute -inset-0.5 rounded-2xl bg-gradient-to-r from-white to-gray-400 opacity-0 group-hover:opacity-20 blur-xl transition-opacity duration-500" aria-hidden="true"></div>
          {% endif %}
          <div class="relative p-6 rounded-2xl bg-white/[0.02] border border-white/10 group-hover:border-white/20 transition-all duration-300">
            {% if g == 'white_gray4' %}
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-white to-gray-400 flex items-center justify-center mb-4">
            {% elsif g == 'gray3_gray5' %}
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-gray-300 to-gray-500 flex items-center justify-center mb-4">
            {% elsif g == 'gray2_gray4' %}
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-gray-200 to-gray-400 flex items-center justify-center mb-4">
            {% elsif g == 'white_gray3' %}
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-white to-gray-300 flex items-center justify-center mb-4">
            {% elsif g == 'gray1_gray4' %}
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-gray-100 to-gray-400 flex items-center justify-center mb-4">
            {% else %}
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-white to-gray-400 flex items-center justify-center mb-4">
            {% endif %}
              {% case block.settings.icon %}
                {% when 'trending_up' %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-white" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
                {% when 'zap' %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-white" aria-hidden="true"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path></svg>
                {% when 'users' %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-white" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg>
                {% when 'target' %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-white" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
                {% when 'award' %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-white" aria-hidden="true"><path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"></path><circle cx="12" cy="8" r="6"></circle></svg>
                {% else %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6 text-white"><circle cx="12" cy="12" r="10"></circle></svg>
              {% endcase %}
            </div>
            {% if block.settings.stat != blank %}
              <div class="text-4xl md:text-5xl font-black text-white mb-2"><span>{{ block.settings.stat }}</span></div>
            {% endif %}
            {% if block.settings.label != blank %}
              <p class="text-white/50 text-sm">{{ block.settings.label }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Stats",
  "tag": "section",
  "class": "section-about-stats",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Optional. Used with cover; color shows behind or if image fails to load."
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge (small label above title)",
      "default": "(Our Impact)"
    },
    {
      "type": "text",
      "id": "title_before",
      "label": "Title (before gradient word)",
      "default": "Numbers That "
    },
    {
      "type": "text",
      "id": "title_gradient",
      "label": "Title (gradient word)",
      "default": "Matter"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "gradient",
          "label": "Card & icon gradient",
          "options": [
            { "value": "white_gray4", "label": "White / Gray 400" },
            { "value": "gray3_gray5", "label": "Gray 300 / Gray 500" },
            { "value": "gray2_gray4", "label": "Gray 200 / Gray 400" },
            { "value": "white_gray3", "label": "White / Gray 300" },
            { "value": "gray1_gray4", "label": "Gray 100 / Gray 400" }
          ],
          "default": "white_gray4"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "trending_up", "label": "Trending up" },
            { "value": "zap", "label": "Zap" },
            { "value": "users", "label": "Users" },
            { "value": "target", "label": "Target" },
            { "value": "award", "label": "Award" }
          ],
          "default": "trending_up"
        },
        {
          "type": "text",
          "id": "stat",
          "label": "Statistic (number or text)",
          "default": "500K+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Description",
          "default": "Average yearly savings"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Stats",
      "settings": {
        "badge": "(Our Impact)",
        "title_before": "Numbers That ",
        "title_gradient": "Matter"
      },
      "blocks": [
        { "type": "stat", "settings": { "gradient": "white_gray4", "icon": "trending_up", "stat": "500K+", "label": "Average yearly savings" } },
        { "type": "stat", "settings": { "gradient": "gray3_gray5", "icon": "zap", "stat": "340%", "label": "Revenue growth" } },
        { "type": "stat", "settings": { "gradient": "gray2_gray4", "icon": "users", "stat": "98%", "label": "Client retention" } },
        { "type": "stat", "settings": { "gradient": "white_gray3", "icon": "target", "stat": "50M+", "label": "Revenue generated" } },
        { "type": "stat", "settings": { "gradient": "gray1_gray4", "icon": "award", "stat": "85%", "label": "Productivity boost" } }
      ]
    }
  ]
}
{% endschema %}
