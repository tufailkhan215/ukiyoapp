{% comment %} About Culture Code: "What We Stand For" (gradient), list of principles with large gradient numbers, icons, titles, descriptions. {% endcomment %}
{% assign principle_blocks = section.blocks | where: 'type', 'principle' %}
<section class="relative py-24 lg:py-32 bg-black">
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  <div class="max-w-[1200px] mx-auto px-6 lg:px-12 relative z-10">
    <div class="mb-16">
      {% if section.settings.badge != blank %}
        <span class="text-[10px] font-medium text-white/40 tracking-[0.3em] uppercase block mb-4">{{ section.settings.badge }}</span>
      {% endif %}
      {% if section.settings.title_before != blank or section.settings.title_gradient != blank %}
        <h2 class="text-4xl md:text-5xl font-bold text-white">
          {{ section.settings.title_before }}
          {% if section.settings.title_gradient != blank %}
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400">{{ section.settings.title_gradient }}</span>
          {% endif %}
        </h2>
      {% endif %}
    </div>

    <div>
      {% for block in principle_blocks %}
        <div class="group flex gap-8 py-8 {% unless forloop.last %}border-b border-white/5{% endunless %}" {{ block.shopify_attributes }}>
          <div class="flex-shrink-0 relative">
            <span class="text-6xl font-black text-transparent bg-clip-text bg-gradient-to-b from-white/10 to-white/5">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-2">
              {% case block.settings.icon %}
                {% when 'target' %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-target w-5 h-5 text-white/60" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
                {% when 'zap' %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap w-5 h-5 text-white/60" aria-hidden="true"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path></svg>
                {% when 'users' %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users w-5 h-5 text-white/60" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg>
                {% when 'brain' %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-brain w-5 h-5 text-white/60" aria-hidden="true"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"></path><path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"></path><path d="M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4"></path><path d="M17.599 6.5a3 3 0 0 0 .399-1.375"></path><path d="M6.003 5.125A3 3 0 0 0 6.401 6.5"></path><path d="M3.477 10.896a4 4 0 0 1 .585-.396"></path><path d="M19.938 10.5a4 4 0 0 1 .585.396"></path><path d="M6 18a4 4 0 0 1-1.967-.516"></path><path d="M19.967 17.484A4 4 0 0 1 18 18"></path></svg>
                {% when 'award' %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-award w-5 h-5 text-white/60" aria-hidden="true"><path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"></path><circle cx="12" cy="8" r="6"></circle></svg>
                {% when 'sparkles' %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles w-5 h-5 text-white/60" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg>
                {% else %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-white/60"><circle cx="12" cy="12" r="10"></circle></svg>
              {% endcase %}
              {% if block.settings.title != blank %}
                <h3 class="text-xl font-bold text-white group-hover:text-white/80 transition-colors">{{ block.settings.title }}</h3>
              {% endif %}
            </div>
            {% if block.settings.description != blank %}
              <p class="text-white/50 leading-relaxed">{{ block.settings.description }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Culture Code",
  "tag": "section",
  "class": "section-about-culture-code",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "(Culture Code)"
    },
    {
      "type": "text",
      "id": "title_before",
      "label": "Title (before gradient)",
      "default": "What We "
    },
    {
      "type": "text",
      "id": "title_gradient",
      "label": "Title (gradient words)",
      "default": "Stand For"
    }
  ],
  "blocks": [
    {
      "type": "principle",
      "name": "Principle",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "target", "label": "Target" },
            { "value": "zap", "label": "Zap" },
            { "value": "users", "label": "Users" },
            { "value": "brain", "label": "Brain" },
            { "value": "award", "label": "Award" },
            { "value": "sparkles", "label": "Sparkles" }
          ],
          "default": "target"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Results, Not Vanity"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "We focus on content that converts—not likes for likes' sake."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Culture Code",
      "blocks": [
        {
          "type": "principle",
          "settings": {
            "icon": "target",
            "title": "Results, Not Vanity",
            "description": "We focus on content that converts—not likes for likes' sake."
          }
        },
        {
          "type": "principle",
          "settings": {
            "icon": "zap",
            "title": "Do Big Things",
            "description": "We dare to create big ideas and take big risks that transform businesses."
          }
        },
        {
          "type": "principle",
          "settings": {
            "icon": "users",
            "title": "Community First",
            "description": "Rooted in Nevada County, we blend local heart with global expertise."
          }
        },
        {
          "type": "principle",
          "settings": {
            "icon": "brain",
            "title": "Work Smarter",
            "description": "We leverage AI-driven automation to help brands work smarter and faster."
          }
        },
        {
          "type": "principle",
          "settings": {
            "icon": "award",
            "title": "Excellence Always",
            "description": "We are obsessed with excellence and refuse mediocrity."
          }
        },
        {
          "type": "principle",
          "settings": {
            "icon": "sparkles",
            "title": "Radical Innovation",
            "description": "Our technology adapts to the market, keeping you ahead."
          }
        }
      ]
    }
  ]
}
{% endschema %}
