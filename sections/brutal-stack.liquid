{% comment %} Pick Your Power Stack: service bundle selector, discount pills, Your Bundle summary, ROI calculator. {% endcomment %}
{% assign service_blocks = section.blocks | where: 'type', 'service' %}
{% assign discount_tiers = "2,20|3,35|4,50|5,60|6,70" | split: "|" %}

<section class="relative py-28 lg:py-40 bg-black overflow-hidden" data-testid="brutal-stack" data-brutal-stack data-discount-tiers='{"2":20,"3":35,"4":50,"5":60,"6":70}'>
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  <div class="absolute inset-0" aria-hidden="true">
    <div class="absolute top-1/3 left-1/4 w-[600px] h-[600px] rounded-full bg-white/[0.02] blur-[150px]"></div>
    <div class="absolute bottom-1/3 right-1/4 w-[500px] h-[500px] rounded-full bg-white/[0.015] blur-[120px]"></div>
  </div>

  <div class="relative z-10 max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="text-center mb-16">
      <span class="text-[10px] font-medium text-white/40 tracking-[0.3em] uppercase block mb-5">{{ section.settings.badge | default: '(Build Your Bundle)' }}</span>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
        {{ section.settings.title_before | default: 'Pick Your ' }}
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-gray-400 to-gray-600">{{ section.settings.title_gradient | default: 'Power Stack' }}</span>
      </h2>
      <p class="text-lg text-white/50 max-w-2xl mx-auto mb-8">
        {{ section.settings.subtitle | default: "Select the services you need. The more you bundle, the more you save—up to " }}
        <span class="text-white font-bold">{{ section.settings.save_line | default: '70% OFF!' }}</span>
      </p>
      <div class="flex justify-center gap-2 flex-wrap brutal-stack-pills">
        {% for tier in discount_tiers %}
          {% assign parts = tier | split: "," %}
          {% assign count = parts[0] | plus: 0 %}
          {% assign pct = parts[1] | plus: 0 %}
          <div class="brutal-stack-pill px-4 py-2 rounded-full text-sm font-medium transition-all bg-white/[0.03] text-white/40 border border-white/10" data-count="{{ count }}" data-pct="{{ pct }}">
            {{ count }} services = {{ pct }}% off
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 items-start">
      <div>
        <div class="flex items-center justify-between mb-6">
          <h3 class="text-xl font-bold text-white">{{ section.settings.services_heading | default: 'Select Services' }}</h3>
          <button type="button" class="brutal-stack-select-all text-sm text-white/50 hover:text-white underline underline-offset-4 transition-colors">{{ section.settings.select_all_text | default: 'Select All (70% OFF!)' }}</button>
        </div>
        <div class="space-y-3 brutal-stack-list">
          {% for block in service_blocks %}
            {% assign price_num = block.settings.price | replace: '$', '' | replace: ',', '' | plus: 0 %}
            {% assign roi_num = block.settings.roi | replace: '+', '' | replace: '%', '' | replace: ' ROI', '' | strip | plus: 0 %}
            <button type="button" class="brutal-stack-service w-full flex items-center justify-between p-5 border rounded-xl transition-all duration-300 border-white/[0.05] bg-white/[0.02] hover:bg-white/[0.04] hover:border-white/20" data-index="{{ forloop.index0 }}" data-price="{{ price_num }}" data-roi="{{ roi_num }}" data-title="{{ block.settings.title | escape }}" {{ block.shopify_attributes }}>
              <div class="flex items-center gap-4">
                <div class="brutal-stack-check w-6 h-6 rounded-md flex items-center justify-center transition-all bg-white/10 flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check w-4 h-4 text-black hidden" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
                </div>
                <div class="text-left">
                  <p class="brutal-stack-title font-semibold transition-colors text-white/70">{{ block.settings.title }}</p>
                  <p class="text-white/40 text-sm">{{ block.settings.description | default: '' }}</p>
                </div>
              </div>
              <div class="text-right flex-shrink-0 ml-4">
                <p class="brutal-stack-price font-bold text-white/50">{{ block.settings.price }}</p>
                <p class="text-green-400 text-xs">{{ block.settings.roi | default: '+0% ROI' }}</p>
              </div>
            </button>
          {% endfor %}
        </div>
      </div>

      <div class="lg:sticky lg:top-32">
        <div class="bg-white/[0.02] border border-white/[0.05] p-8 mb-6">
          <div class="flex items-center gap-3 mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles w-6 h-6 text-white/60" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg>
            <h3 class="text-2xl font-bold text-white">{{ section.settings.bundle_heading | default: 'Your Bundle' }}</h3>
          </div>
          <div class="brutal-stack-bundle-placeholder text-white/40 text-center py-6" data-empty="true">
            {{ section.settings.bundle_placeholder | default: 'Select services to build your bundle' }}
          </div>
          <div class="brutal-stack-bundle-content hidden space-y-3 mb-6" data-empty="false">
            <div class="brutal-stack-bundle-items"></div>
            <div class="border-t border-white/10 pt-4 space-y-3">
              <div class="flex justify-between">
                <span class="text-white/60">Subtotal:</span>
                <span class="brutal-stack-subtotal text-white/40 line-through">$0</span>
              </div>
              <div class="flex justify-between brutal-stack-discount-line">
                <span class="text-green-400 font-medium">Bundle Discount (<span class="brutal-stack-discount-pct">0</span>%):</span>
                <span class="text-green-400 font-bold brutal-stack-discount-amount">-$0</span>
              </div>
              <div class="flex justify-between items-center pt-4 border-t border-white/10">
                <span class="text-white font-semibold text-lg">Your Investment:</span>
                <div class="text-right">
                  <span class="brutal-stack-total text-4xl font-bold text-white">$0</span>
                  <p class="text-green-400 text-sm font-medium brutal-stack-savings">You save $0</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white text-black p-8 brutal-stack-roi-card">
          <div class="flex items-center gap-3 mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calculator w-6 h-6 text-black/60" aria-hidden="true"><rect width="16" height="20" x="4" y="2" rx="2"></rect><line x1="8" x2="16" y1="6" y2="6"></line><line x1="16" x2="16" y1="14" y2="18"></line><path d="M16 10h.01"></path><path d="M12 10h.01"></path><path d="M8 10h.01"></path><path d="M12 14h.01"></path><path d="M8 14h.01"></path><path d="M12 18h.01"></path><path d="M8 18h.01"></path></svg>
            <h3 class="text-xl font-bold">{{ section.settings.roi_heading | default: 'ROI Calculator' }}</h3>
          </div>
          <div class="mb-6">
            <label class="text-black/60 text-sm block mb-2">{{ section.settings.roi_revenue_label | default: 'Your Current Monthly Revenue' }}</label>
            <div class="relative">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-dollar-sign absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-black/40" aria-hidden="true"><line x1="12" x2="12" y1="2" y2="22"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
              <input type="number" class="brutal-stack-revenue w-full bg-black/5 border border-black/10 rounded-lg px-12 py-4 text-black text-2xl font-semibold focus:outline-none focus:border-black/30" value="50000" min="0" step="1000">
            </div>
          </div>
          <div class="space-y-3 mb-6 brutal-stack-roi-list">
            <p class="text-black/40 text-xs uppercase tracking-wider">{{ section.settings.roi_boost_label | default: 'Selected Services ROI Boost' }}</p>
            <div class="brutal-stack-roi-items"></div>
          </div>
          <div class="border-t border-black/10 pt-6">
            <div class="flex justify-between items-center">
              <span class="text-black/60">{{ section.settings.roi_increase_label | default: 'Potential Monthly Increase:' }}</span>
              <span class="brutal-stack-increase text-3xl font-bold text-green-600">+$0</span>
            </div>
            <p class="text-black/30 text-sm mt-2 brutal-stack-roi-total">Total ROI boost: +0%</p>
          </div>
          {% if section.settings.cta_url != blank %}
            <a href="{{ section.settings.cta_url }}" target="_blank" rel="noopener noreferrer" class="block mt-6">
              <button type="button" class="w-full py-4 bg-black text-white rounded-lg font-bold text-lg hover:bg-black/80 transition-colors flex items-center justify-center gap-2">
                {{ section.settings.cta_text | default: 'Lock In This Bundle' }}
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right w-5 h-5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </button>
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brutal Stack",
  "tag": "section",
  "class": "section-brutal-stack",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "(Build Your Bundle)" },
    { "type": "text", "id": "title_before", "label": "Title (before gradient)", "default": "Pick Your " },
    { "type": "text", "id": "title_gradient", "label": "Title (gradient part)", "default": "Power Stack" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Select the services you need. The more you bundle, the more you save—up to " },
    { "type": "text", "id": "save_line", "label": "Save line (bold)", "default": "70% OFF!" },
    { "type": "text", "id": "services_heading", "label": "Services column heading", "default": "Select Services" },
    { "type": "text", "id": "select_all_text", "label": "Select All button text", "default": "Select All (70% OFF!)" },
    { "type": "text", "id": "bundle_heading", "label": "Bundle card heading", "default": "Your Bundle" },
    { "type": "text", "id": "bundle_placeholder", "label": "Bundle empty placeholder", "default": "Select services to build your bundle" },
    { "type": "text", "id": "roi_heading", "label": "ROI card heading", "default": "ROI Calculator" },
    { "type": "text", "id": "roi_revenue_label", "label": "Revenue input label", "default": "Your Current Monthly Revenue" },
    { "type": "text", "id": "roi_boost_label", "label": "ROI boost list label", "default": "Selected Services ROI Boost" },
    { "type": "text", "id": "roi_increase_label", "label": "Potential increase label", "default": "Potential Monthly Increase:" },
    { "type": "url", "id": "cta_url", "label": "CTA button URL" },
    { "type": "text", "id": "cta_text", "label": "CTA button text", "default": "Lock In This Bundle" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "title", "label": "Service title" },
        { "type": "text", "id": "description", "label": "Short description" },
        { "type": "text", "id": "price", "label": "Price (e.g. $15,000)" },
        { "type": "text", "id": "roi", "label": "ROI (e.g. +35% ROI)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brutal Stack",
      "settings": {},
      "blocks": [
        { "type": "service", "settings": { "title": "AI Revenue Concierge Chatbot", "description": "Captures leads 24/7, converts DMs to sales", "price": "$15,000", "roi": "+35% ROI" } },
        { "type": "service", "settings": { "title": "Complete Brand Identity System", "description": "Logo, colors, typography, guidelines", "price": "$25,000", "roi": "+20% ROI" } },
        { "type": "service", "settings": { "title": "High-Converting Website", "description": "Custom design, SEO optimized", "price": "$35,000", "roi": "+25% ROI" } },
        { "type": "service", "settings": { "title": "Email Automation Flows", "description": "Welcome, abandoned cart, win-back", "price": "$12,000", "roi": "+25% ROI" } },
        { "type": "service", "settings": { "title": "Content Strategy + Calendar", "description": "90-day content plan with templates", "price": "$8,000", "roi": "+15% ROI" } },
        { "type": "service", "settings": { "title": "1:1 Strategy Sessions", "description": "Monthly calls with our strategists", "price": "$5,000", "roi": "+10% ROI" } }
      ]
    }
  ]
}
{% endschema %}
