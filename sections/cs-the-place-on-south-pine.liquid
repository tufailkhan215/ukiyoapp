{% comment %}
  Section: cs-the-place-on-south-pine
  Case Study — The Place on South Pine | Website Design & Content Strategy
  
  HOW TO USE:
  1. Upload this file to Shopify > Online Store > Themes > Edit Code > Sections
  2. Upload the template file (templates/page.the-place-on-south-pine.json) to Templates
  3. Create a page with handle "the-place-on-south-pine" and assign template "page.the-place-on-south-pine"
  4. All content is editable in the Theme Customizer
{% endcomment %}

{% render 'case-study-styles' %}

<div class="cs-page">

  {%- comment -%} BACK BUTTON {%- endcomment -%}
  <div class="cs-back">
    <a href="{{ section.settings.back_url | default: '/pages/work' }}">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      {{ section.settings.back_label | default: 'Back' }}
    </a>
  </div>

  {%- comment -%} TOP GALLERY — 4 IMAGES {%- endcomment -%}
  <div class="cs-gallery-top">
    <div class="cs-gallery-top__grid">
      <div class="cs-gallery-top__item">
        <img src="{{ section.settings.gallery_image_1 }}" alt="{{ section.settings.client }} project 1" loading="eager" />
      </div>
      <div class="cs-gallery-top__item">
        <img src="{{ section.settings.gallery_image_2 }}" alt="{{ section.settings.client }} project 2" loading="eager" />
      </div>
      <div class="cs-gallery-top__item">
        <img src="{{ section.settings.gallery_image_3 }}" alt="{{ section.settings.client }} project 3" loading="lazy" />
      </div>
      <div class="cs-gallery-top__item">
        <img src="{{ section.settings.gallery_image_4 }}" alt="{{ section.settings.client }} project 4" loading="lazy" />
      </div>
    </div>
  </div>

  {%- comment -%} PAGE HEADER {%- endcomment -%}
  <div class="cs-header">
    <span class="cs-badge">{{ section.settings.category }}</span>
    <h1 class="cs-title">{{ section.settings.title }}</h1>
    <p class="cs-subtitle">{{ section.settings.subtitle }}</p>
  </div>

  {%- comment -%} WHAT WE DID {%- endcomment -%}
  <section class="cs-what">
    <h2 class="cs-what__heading">What we did</h2>
    <div class="cs-what__grid">
      <div class="cs-what__col">
        <h3>Client expectations</h3>
        <p>{{ section.settings.challenge }}</p>
        <h3>Expected outcomes</h3>
        <ul class="cs-what__list">
          {%- for i in (1..6) -%}
            {%- assign exp_key = 'expectation_' | append: i -%}
            {%- if section.settings[exp_key] != blank -%}
              <li>{{ section.settings[exp_key] }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
      <div class="cs-what__col">
        <h3>How we did it</h3>
        <p>{{ section.settings.solution }}</p>
        <h3>Delivered results</h3>
        <ul class="cs-what__list">
          {%- for i in (1..6) -%}
            {%- assign out_key = 'outcome_' | append: i -%}
            {%- if section.settings[out_key] != blank -%}
              <li>{{ section.settings[out_key] }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </section>

  {%- comment -%} SERVICES BLOCKS {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'service' -%}
      <div class="cs-service {% if forloop.index0 == 1 or forloop.index0 == 3 %}cs-service--reverse{% endif %}" {{ block.shopify_attributes }}>
        <div class="cs-service__inner">
          {%- if block.settings.service_image != blank -%}
            <div class="cs-service__image">
              <img src="{{ block.settings.service_image }}" alt="{{ block.settings.service_title }}" loading="lazy" />
            </div>
          {%- endif -%}
          <div class="cs-service__content">
            <h3>{{ block.settings.service_title }}</h3>
            <p>{{ block.settings.service_description }}</p>
            {%- if block.settings.service_features != blank -%}
              <ul class="cs-service__features">
                {%- assign features = block.settings.service_features | split: '|' -%}
                {%- for feature in features -%}
                  {%- assign parts = feature | split: ':' -%}
                  <li>
                    {%- if parts.size > 1 -%}
                      <strong>{{ parts[0] }}:</strong>{{ parts[1] }}
                    {%- else -%}
                      {{ feature }}
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%} BOTTOM GALLERY — 3 IMAGES {%- endcomment -%}
  <div class="cs-gallery-bottom">
    <div class="cs-gallery-bottom__grid">
      <div class="cs-gallery-bottom__item">
        <img src="{{ section.settings.gallery_image_2 }}" alt="{{ section.settings.client }} gallery 1" loading="lazy" />
      </div>
      <div class="cs-gallery-bottom__item">
        <img src="{{ section.settings.gallery_image_3 }}" alt="{{ section.settings.client }} gallery 2" loading="lazy" />
      </div>
      <div class="cs-gallery-bottom__item">
        <img src="{{ section.settings.gallery_image_4 }}" alt="{{ section.settings.client }} gallery 3" loading="lazy" />
      </div>
    </div>
  </div>

  {%- comment -%} STATS {%- endcomment -%}
  <div class="cs-stats">
    <div class="cs-stats__grid">
      {%- for i in (1..4) -%}
        {%- assign val_key = 'stat_value_' | append: i -%}
        {%- assign lbl_key = 'stat_label_' | append: i -%}
        {%- assign dsc_key = 'stat_desc_' | append: i -%}
        {%- if section.settings[val_key] != blank -%}
          <div class="cs-stat">
            <span class="cs-stat__value">{{ section.settings[val_key] }}</span>
            <span class="cs-stat__label">{{ section.settings[lbl_key] }}</span>
            <span class="cs-stat__desc">{{ section.settings[dsc_key] }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} TESTIMONIAL {%- endcomment -%}
  {%- if section.settings.testimonial_quote != blank -%}
    <div class="cs-testimonial">
      <div class="cs-testimonial__inner">
        <p class="cs-testimonial__quote">"{{ section.settings.testimonial_quote }}"</p>
        <div class="cs-testimonial__author">
          {%- if section.settings.testimonial_photo != blank -%}
            <img class="cs-testimonial__photo" src="{{ section.settings.testimonial_photo }}" alt="{{ section.settings.testimonial_author }}" loading="lazy" />
          {%- endif -%}
          <div class="cs-testimonial__info">
            <span class="cs-testimonial__name">{{ section.settings.testimonial_author }}</span>
            <span class="cs-testimonial__role">{{ section.settings.testimonial_role }}, {{ section.settings.testimonial_company }}</span>
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} CTA {%- endcomment -%}
  <div class="cs-cta">
    <div class="cs-cta__inner">
      <h2 class="cs-cta__heading">{{ section.settings.cta_heading }}</h2>
      <p class="cs-cta__subtext">{{ section.settings.cta_subtext }}</p>
      <div class="cs-cta__buttons">
        <a href="{{ section.settings.cta_primary_url }}" class="cs-btn cs-btn--primary">
          {{ section.settings.cta_primary_label }}
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7v10"/>
          </svg>
        </a>
        <a href="{{ section.settings.cta_secondary_url }}" class="cs-btn cs-btn--secondary">
          {{ section.settings.cta_secondary_label }}
        </a>
      </div>
    </div>
  </div>

</div>

