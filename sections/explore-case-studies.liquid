    #TruthLanding-{{ section.id }} .ct-circle {
      width: 60px; height: 60px; right: 14px; bottom: -30px;
    }
    #TruthLanding-{{ section.id }} .ct-features { grid-template-columns: 1fr; padding-block: 50px; }
    #TruthLanding-{{ section.id }} .ct-feature { min-height: 300px; gap: 42px; }
    #TruthLanding-{{ section.id }} .ct-finale-card { padding: 30px 24px; }
    #TruthLanding-{{ section.id }} .ct-button { width: 100%; }
    #TruthLanding-{{ section.id }}.ct-animated .ct-scroll-note { display: none; }
    #TruthLanding-{{ section.id }}.ct-animated .ct-intro { padding-bottom: 105px; }
    #TruthLanding-{{ section.id }}.ct-animated .ct-feature {
      position: absolute; left: var(--ct-pad); right: var(--ct-pad);
      top: 50%; min-height: 320px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #TruthLanding-{{ section.id }} *,
    #TruthLanding-{{ section.id }} *::before,
    #TruthLanding-{{ section.id }} *::after {
      animation: none !important; transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>

<script>
(function () {
  const id = 'TruthLanding-{{ section.id }}';
  const wrapperId = 'shopify-section-{{ section.id }}';

  window.__truthLanding = window.__truthLanding || {};
  window.__truthLanding[id]?.();

  const lifecycle = new AbortController();
  let dispose = () => {};

  function initialize() {
    dispose();

    const root = document.getElementById(id);
    if (!root) return;

    const events = new AbortController();
    const signal = events.signal;
    const header = root.querySelector('[data-ct-header]');
    const dialog = root.querySelector('[data-ct-dialog]');
    const openButton = root.querySelector('[data-ct-open]');
    const closeButton = root.querySelector('[data-ct-close]');
    const runway = root.querySelector('[data-ct-runway]');
    const stage = root.querySelector('[data-ct-stage]');
    const modeButton = root.querySelector('[data-ct-mode]');
    const progressBar = root.querySelector('[data-ct-progress]');
    const intro = root.querySelector('[data-ct-scene="intro"]');
    const features = root.querySelector('[data-ct-scene="features"]');
    const finale = root.querySelector('[data-ct-scene="finale"]');
    const cards = [...root.querySelectorAll('[data-ct-card]')];
    const missions = [...root.querySelectorAll('[data-ct-mission]')];
    const scenes = [intro, features, finale, ...cards, ...missions].filter(Boolean);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const shortScreen = matchMedia('(max-height: 560px)');
    const mobile = matchMedia('(max-width: 760px)');

    let destroyed = false;
    let animated = false;
    let staticRequested = false;
    let raf = null;
    let lockedOverflow = null;
    let menuAnimation = null;

    const clamp = n => Math.max(0, Math.min(1, n));
    const range = (p, a, b) => clamp((p - a) / (b - a));
    const ease = t => t * t * (3 - 2 * t);

    function listen(target, type, handler, options = {}) {
      target?.addEventListener(type, handler, { ...options, signal });
    }

    function setScene(element, opacity, x = 0, y = 0, blur = 0, center = false) {
      if (!element) return;
      const visible = opacity > .015;
      element.style.visibility = visible ? 'visible' : 'hidden';
      element.style.opacity = opacity.toFixed(3);
      element.style.transform =
        `${center ? 'translateY(-50%) ' : ''}translate3d(${x}px,${y}px,0)`;
      element.style.filter = blur > .1 ? `blur(${blur}px)` : 'none';
      element.inert = !visible;
      if (visible) element.removeAttribute('aria-hidden');
      else element.setAttribute('aria-hidden', 'true');
    }

    function envelope(p, inStart, inEnd, outStart, outEnd) {
      const arriving = ease(range(p, inStart, inEnd));
      const leaving = ease(range(p, outStart, outEnd));
      return { opacity: arriving * (1 - leaving), arriving, leaving };
    }

    function resetScenes() {
      scenes.forEach(element => {
        ['visibility','opacity','transform','filter'].forEach(
          property => element.style.removeProperty(property)
        );
        element.inert = false;
        element.removeAttribute('aria-hidden');
      });
    }

    const clips = [...root.querySelectorAll('[data-ct-video]')].map(video => {
      const clip = {
        video,
        index: Number(video.dataset.ctVideo),
        target: 0,
        loaded: false,
        failed: false,
        visible: false
      };

      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;

      clip.seek = () => {
        if (
          destroyed || !animated || document.hidden ||
          !clip.visible || clip.failed || video.seeking ||
          video.readyState < 1 ||
          !Number.isFinite(video.duration) || video.duration <= 0
        ) return;

        const time = Math.max(0, Math.min(
          clip.target,
          Math.max(0, video.duration - .05)
        ));

        if (Math.abs(video.currentTime - time) < .04) return;

        try {
          video.currentTime = time;
        } catch (_) {}
      };

      ['loadedmetadata','loadeddata','canplay'].forEach(name => {
        listen(video, name, () => {
          video.pause();
          clip.seek();
          schedule();
        });
      });

      listen(video, 'seeked', clip.seek);

      listen(video, 'error', () => {
        clip.failed = true;
        video.style.opacity = '0';
      });

      return clip;
    });

    function loadClip(clip) {
      if (clip.loaded || clip.failed) return;
      clip.loaded = true;
      clip.video.src = clip.video.dataset.src;
      clip.video.load();
    }

    function render() {
      raf = null;
      if (destroyed) return;

      header.dataset.scrolled = String(window.scrollY > 12);

      if (!animated || !runway || document.hidden) return;

      const bounds = runway.getBoundingClientRect();
      if (bounds.bottom <= 0 || bounds.top >= window.innerHeight) return;

      const travel = Math.max(1, runway.offsetHeight - stage.offsetHeight);
      const p = clamp(-bounds.top / travel);
      progressBar.style.transform = `scaleX(${p})`;

      const introOut = ease(range(p, .015, .145));
      setScene(intro, 1 - introOut, -introOut * 30, introOut * 30, introOut * 10);

      if (mobile.matches) {
        setScene(features, p > .13 && p < .455 ? 1 : 0);

        cards.forEach((card, index) => {
          const start = .135 + index * .10;
          const motion = envelope(p, start, start + .025, start + .075, start + .10);
          setScene(
            card,
            motion.opacity,
            0,
            (1 - motion.arriving) * 35 - motion.leaving * 35,
            (1 - motion.opacity) * 8,
            true
          );
        });
      } else {
        setScene(features, p > .13 && p < .46 ? 1 : 0);

        cards.forEach((card, index) => {
          const motion = envelope(
            p,
            .14 + index * .025,
            .23 + index * .025,
            .345 + index * .012,
            .425 + index * .012
          );
          const direction = index - 1;
          setScene(
            card,
            motion.opacity,
            direction * (1 - motion.opacity) * 35,
            (1 - motion.opacity) * 30,
            (1 - motion.opacity) * 10
          );
        });
      }

      missions.forEach((mission, index) => {
        const start = .46 + index * .145;
        const motion = envelope(p, start, start + .035, start + .105, start + .14);

        setScene(
          mission,
          motion.opacity,
          0,
          (1 - motion.arriving) * 70 - motion.leaving * 70,
          (1 - motion.opacity) * 9
        );
      });

      const finish = ease(range(p, .905, .97));
      setScene(finale, finish, 0, (1 - finish) * 55, (1 - finish) * 8);

      clips.forEach(clip => {
        const index = clip.index;
        const local = clamp(p * 3 - index);

        const opacity = index === 0
          ? 1 - range(p, .325, .345)
          : index === 1
            ? range(p, .325, .345) * (1 - range(p, .655, .675))
            : range(p, .655, .675);

        clip.visible = opacity > .001;

        if (
          index === 0 ||
          (index === 1 && p > .26) ||
          (index === 2 && p > .59)
        ) loadClip(clip);

        clip.video.style.opacity = clip.failed ? '0' : String(opacity);

        if (Number.isFinite(clip.video.duration)) {
          clip.target = local * Math.max(0, clip.video.duration - .05);
          clip.seek();
        }
      });
    }

    function schedule() {
      if (raf === null && !destroyed) raf = requestAnimationFrame(render);
    }

    function setMode(restorePosition = false) {
      if (!runway) return;
      const top = runway.getBoundingClientRect().top + window.scrollY;

      animated = !staticRequested && !reduced.matches && !shortScreen.matches;
      root.classList.toggle('ct-animated', animated);

      if (!animated) {
        resetScenes();
        clips.forEach(clip => {
          clip.video.pause();
          clip.video.style.opacity = '0';
        });
      }

      modeButton.hidden = reduced.matches || shortScreen.matches;
      modeButton.textContent = animated ? 'View all content' : 'Enable animation';
      modeButton.setAttribute('aria-pressed', String(!animated));

      if (restorePosition) {
        window.scrollTo({ top: Math.max(0, top - 90), behavior: 'instant' });
      }

      render();
    }

    function unlockPage() {
      if (lockedOverflow !== null) {
        document.documentElement.style.overflow = lockedOverflow;
        lockedOverflow = null;
      }
      openButton.setAttribute('aria-expanded', 'false');
    }

    if (typeof dialog.showModal === 'function') {
      openButton.hidden = false;

      listen(openButton, 'click', () => {
        if (dialog.open) return;
        dialog.showModal();
        lockedOverflow = document.documentElement.style.overflow;
        document.documentElement.style.overflow = 'hidden';
        openButton.setAttribute('aria-expanded', 'true');

        if (!reduced.matches && dialog.animate) {
          menuAnimation?.cancel();
          menuAnimation = dialog.animate(
            [
              { opacity: 0, transform: 'translateY(-18px)' },
              { opacity: 1, transform: 'translateY(0)' }
            ],
            { duration: 350, easing: 'cubic-bezier(.16,1,.3,1)' }
          );
        }
      });

      listen(closeButton, 'click', () => dialog.close());
      listen(dialog, 'close', unlockPage);

      dialog.querySelectorAll('a').forEach(link => {
        listen(link, 'click', () => dialog.close());
      });
    }

    listen(modeButton, 'click', () => {
      staticRequested = !staticRequested;
      setMode(true);
    });

    listen(root.querySelector('[data-ct-explore]'), 'click', event => {
      if (!animated) return;
      event.preventDefault();

      const top = runway.getBoundingClientRect().top + window.scrollY;
      const travel = Math.max(1, runway.offsetHeight - stage.offsetHeight);

      window.scrollTo({
        top: top + travel * (mobile.matches ? .18 : .29),
        behavior: reduced.matches ? 'auto' : 'smooth'
      });
    });

    listen(window, 'scroll', schedule, { passive: true });
    listen(window, 'resize', schedule, { passive: true });
    listen(window, 'pageshow', schedule);
    listen(document, 'visibilitychange', schedule);
    listen(reduced, 'change', () => setMode(true));
    listen(shortScreen, 'change', () => setMode(true));
    listen(mobile, 'change', schedule);

    const observer = typeof ResizeObserver !== 'undefined'
      ? new ResizeObserver(schedule)
      : null;

    if (stage) observer?.observe(stage);

    document.fonts?.ready.then(() => {
      if (!destroyed) schedule();
    });

    if (runway) setMode();
    else render();

    dispose = () => {
      destroyed = true;
      events.abort();
      observer?.disconnect();
      menuAnimation?.cancel();
      if (raf !== null) cancelAnimationFrame(raf);
      if (dialog.open) dialog.close();
      unlockPage();

      clips.forEach(clip => {
        clip.video.pause();
        clip.video.removeAttribute('src');
        clip.video.load();
      });

      resetScenes();
      root.classList.remove('ct-animated');
    };
  }

  document.addEventListener('shopify:section:load', event => {
    if (event.target.id === wrapperId) initialize();
  }, { signal: lifecycle.signal });

  document.addEventListener('shopify:section:unload', event => {
    if (event.target.id === wrapperId) dispose();
  }, { signal: lifecycle.signal });

  window.__truthLanding[id] = () => {
    dispose();
    lifecycle.abort();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize, {
      once: true,
      signal: lifecycle.signal
    });
  } else {
    initialize();
  }
})();
</script>

