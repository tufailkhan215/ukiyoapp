{% comment %}
  Explore Case Studies — corrected scroll version.
  Existing setting IDs and project blocks are preserved.
{% endcomment %}

{% liquid
  assign projects = section.blocks | where: 'type', 'case_study'
  assign accent = section.settings.accent | default: '#e8472a'
  assign end_color = section.settings.end_color | default: '#a82d22'
  assign pin_offset = section.settings.pin_offset | default: 0

  assign video_url = section.settings.video_url | default: 'https://d2ol7oe51mr4n9.cloudfront.net/user_3GJaYKPxdnQG0Q9O26lu6DPmcHu/3abfc4bb-a49d-4a22-93e6-3ebb0f7fa9ac.mp4'

  assign poster_url = 'https://d2ol7oe51mr4n9.cloudfront.net/user_3GJaYKPxdnQG0Q9O26lu6DPmcHu/c34fa15e-fad4-4c37-a7a0-1a325b39e8bf.jpg'

  if section.settings.cover_image != blank
    assign poster_url = section.settings.cover_image | image_url: width: 2400
  endif

  assign title_words = section.settings.title | split: ' '
  assign title_first = title_words | first
  assign title_rest = section.settings.title | remove_first: title_first | strip
%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&display=swap');

  #ecs-{{ section.id }} {
    --bg: #0d0e10;
    --ink: #f4f4f2;
    --accent: {{ accent }};
    --dial-ink: {{ accent }};
    --pad: clamp(20px, 4vw, 72px);
    --pin: {{ pin_offset }}px;
    display: block;
    position: relative;
    isolation: isolate;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Inter Tight', Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  #ecs-{{ section.id }} *,
  #ecs-{{ section.id }} *::before,
  #ecs-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #ecs-{{ section.id }} :is(h2, h3, p) {
    margin: 0;
    font-family: inherit;
    color: inherit;
  }

  #ecs-{{ section.id }} a {
    color: inherit;
    text-decoration: none;
  }

  #ecs-{{ section.id }} :is(a, button):focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 6px;
  }

  /* PINNED VIDEO INTRODUCTION */

  #ecs-{{ section.id }} .ecs-runway {
    position: relative;
  }

  #ecs-{{ section.id }}[data-enhanced]:not([data-static]) .ecs-runway {
    height: 280svh;
  }

  #ecs-{{ section.id }} .ecs-stage {
    position: relative;
    min-height: calc(100svh - var(--pin));
    overflow: hidden;
    background: #0d0e10;
  }

  #ecs-{{ section.id }}[data-enhanced]:not([data-static]) .ecs-stage {
    position: sticky;
    top: var(--pin);
  }

  #ecs-{{ section.id }} .ecs-scene {
    position: absolute;
    inset: 0;
    transform: scale(var(--scene-scale, 1));
    opacity: var(--scene-opacity, 1);
  }

  #ecs-{{ section.id }} .ecs-poster,
  #ecs-{{ section.id }} .ecs-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    filter: saturate(.3) brightness(.75);
  }

  #ecs-{{ section.id }} .ecs-video {
    opacity: 0;
  }

  #ecs-{{ section.id }}[data-video-ready] .ecs-video {
    opacity: 1;
  }

  #ecs-{{ section.id }} .ecs-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(0,0,0,.25),
      transparent 35%,
      rgba(0,0,0,.75)
    );
  }

  #ecs-{{ section.id }} .ecs-chrome {
    position: relative;
    z-index: 2;
    min-height: calc(100svh - var(--pin));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 36px;
    padding: clamp(28px, 4vw, 60px) var(--pad);
  }

  #ecs-{{ section.id }} .ecs-topline {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    opacity: var(--chrome-opacity, 1);
  }

  #ecs-{{ section.id }} .ecs-eyebrow {
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  #ecs-{{ section.id }} .ecs-eyebrow::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 12px;
    background: var(--accent);
  }

  #ecs-{{ section.id }} .ecs-hero-count {
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    opacity: .65;
    white-space: nowrap;
  }

  #ecs-{{ section.id }} .ecs-title {
    display: flex;
    flex-direction: column;
    color: var(--accent);
    font-size: clamp(64px, 14vw, 220px);
    font-weight: 400;
    line-height: .9;
    letter-spacing: -.065em;
  }

  #ecs-{{ section.id }} .ecs-title-line {
    display: block;
    overflow-wrap: anywhere;
  }

  #ecs-{{ section.id }} .ecs-title-first {
    transform: translate3d(var(--title-left, 0%), 0, 0);
  }

  #ecs-{{ section.id }} .ecs-title-last {
    text-align: right;
    transform: translate3d(var(--title-right, 0%), 0, 0);
  }

  #ecs-{{ section.id }} .ecs-title-rule {
    height: clamp(3px, .4vw, 7px);
    margin-top: 24px;
    background: var(--accent);
    transform: scaleX(var(--rule-scale, 1));
    transform-origin: left;
  }

  #ecs-{{ section.id }} .ecs-bottom {
    display: grid;
    grid-template-columns: 1fr minmax(0, 560px);
    gap: 32px;
    align-items: end;
    opacity: var(--chrome-opacity, 1);
  }

  #ecs-{{ section.id }} .ecs-description {
    font-size: clamp(19px, 2vw, 30px);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -.02em;
    text-wrap: pretty;
  }

  #ecs-{{ section.id }} .ecs-scroll {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    width: fit-content;
    min-height: 48px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  #ecs-{{ section.id }} .ecs-scroll-icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid #ffffff66;
    border-radius: 50%;
    font-size: 20px;
  }

  #ecs-{{ section.id }} .ecs-film-progress {
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: #ffffff22;
    z-index: 3;
  }

  #ecs-{{ section.id }} .ecs-film-progress::after {
    content: '';
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(var(--film-progress, 0));
    transform-origin: left;
  }

  #ecs-{{ section.id }} .ecs-video-help {
    position: absolute;
    z-index: 4;
    right: var(--pad);
    bottom: 8px;
    padding: 8px 12px;
    border: 1px solid #ffffff66;
    border-radius: 24px;
    background: #000c;
    color: white;
    font: inherit;
    font-size: 11px;
    cursor: pointer;
  }

  #ecs-{{ section.id }} .ecs-video-help[hidden] {
    display: none;
  }

  /* PROJECT GALLERY + DIAL */

  #ecs-{{ section.id }} .ecs-gallery {
    display: grid;
    position: relative;
    scroll-margin-top: var(--pin);
  }

  #ecs-{{ section.id }} .ecs-dial,
  #ecs-{{ section.id }} .ecs-projects {
    grid-area: 1 / 1;
    min-width: 0;
  }

  #ecs-{{ section.id }} .ecs-dial {
    position: sticky;
    top: var(--pin);
    height: calc(100svh - var(--pin));
    align-self: start;
    overflow: hidden;
    pointer-events: none;
    visibility: hidden;
    z-index: 0;
  }

  #ecs-{{ section.id }}[data-enhanced] .ecs-dial {
    visibility: visible;
  }

  #ecs-{{ section.id }} .ecs-dial svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #ecs-{{ section.id }} .ecs-rail,
  #ecs-{{ section.id }} .ecs-inner,
  #ecs-{{ section.id }} .ecs-arc {
    fill: none;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  #ecs-{{ section.id }} .ecs-rail {
    stroke: #f4f4f230;
  }

  #ecs-{{ section.id }} .ecs-inner {
    stroke: #f4f4f212;
  }

  #ecs-{{ section.id }} .ecs-arc {
    stroke: var(--dial-ink);
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    stroke-width: 1.5;
  }

  #ecs-{{ section.id }} .ecs-tick {
    stroke: #f4f4f233;
    vector-effect: non-scaling-stroke;
  }

  #ecs-{{ section.id }} .ecs-tick.is-active {
    stroke: var(--dial-ink);
  }

  #ecs-{{ section.id }} .ecs-needle {
    fill: var(--dial-ink);
    opacity: .4;
  }

  #ecs-{{ section.id }} .ecs-dot {
    fill: var(--dial-ink);
  }

  #ecs-{{ section.id }} .ecs-readout {
    position: absolute;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-variant-numeric: tabular-nums;
  }

  #ecs-{{ section.id }} .ecs-current {
    font-size: 36px;
    line-height: 1;
    letter-spacing: -.05em;
  }

  #ecs-{{ section.id }} .ecs-total {
    font-size: 11px;
    opacity: .6;
  }

  #ecs-{{ section.id }} .ecs-projects {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(16, minmax(0, 1fr));
    gap: clamp(90px, 13vw, 200px) 20px;
    padding: 100px var(--pad) 140px;
  }

  #ecs-{{ section.id }} .ecs-project {
    position: relative;
    min-width: 0;
    grid-row: var(--row);
    grid-column: 2 / span 7;
  }

  #ecs-{{ section.id }} .ecs-project:nth-child(4n + 2) {
    grid-column: 10 / span 6;
  }

  #ecs-{{ section.id }} .ecs-project:nth-child(4n + 3) {
    grid-column: 3 / span 8;
  }

  #ecs-{{ section.id }} .ecs-project:nth-child(4n + 4) {
    grid-column: 10 / span 5;
  }

  #ecs-{{ section.id }} .ecs-card {
    display: block;
  }

  #ecs-{{ section.id }} .ecs-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #17191c;
    clip-path: inset(0);
    transition: clip-path .65s cubic-bezier(.22,1,.36,1);
  }

  #ecs-{{ section.id }} .ecs-project:nth-child(even) .ecs-media {
    aspect-ratio: 3 / 4;
  }

  #ecs-{{ section.id }} .ecs-image {
    position: absolute;
    inset: -8% 0;
    width: 100%;
    height: 116%;
    object-fit: cover;
    display: block;
    filter: grayscale(1) brightness(.85);
    transform: translate3d(0, var(--image-y, 0px), 0);
    transition: filter .6s;
  }

  #ecs-{{ section.id }} .ecs-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #ffffff22;
    font-size: clamp(80px, 13vw, 220px);
  }

  #ecs-{{ section.id }} .ecs-card-body {
    padding-top: 22px;
  }

  #ecs-{{ section.id }} .ecs-meta {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 14px;
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  #ecs-{{ section.id }} .ecs-number {
    color: var(--dial-ink);
    flex-shrink: 0;
  }

  #ecs-{{ section.id }} .ecs-category {
    opacity: .8;
  }

  #ecs-{{ section.id }} .ecs-name-row {
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }

  #ecs-{{ section.id }} .ecs-name {
    flex: 1;
    min-width: 0;
    font-size: clamp(28px, 3.3vw, 58px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -.045em;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  #ecs-{{ section.id }} .ecs-arrow {
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    display: grid;
    place-items: center;
    border: 1px solid #ffffff55;
    border-radius: 50%;
    font-size: 23px;
  }

  @media (hover: hover) and (pointer: fine) {
    #ecs-{{ section.id }} a.ecs-card:hover .ecs-media {
      clip-path: inset(3%);
    }

    #ecs-{{ section.id }} a.ecs-card:hover .ecs-image {
      filter: grayscale(0) brightness(1);
    }

    #ecs-{{ section.id }} a.ecs-card:hover .ecs-arrow {
      background: var(--ink);
      color: #0d0e10;
    }
  }

  #ecs-{{ section.id }} a:focus-visible .ecs-image {
    filter: grayscale(0);
  }

  @media (max-width: 767px) {
    #ecs-{{ section.id }}[data-enhanced]:not([data-static]) .ecs-runway {
      height: 230svh;
    }

    #ecs-{{ section.id }} .ecs-title {
      font-size: clamp(58px, 17vw, 130px);
      line-height: .95;
    }

    #ecs-{{ section.id }} .ecs-bottom {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
    }

    #ecs-{{ section.id }} .ecs-description {
      grid-row: 1;
      font-size: clamp(20px, 5.3vw, 26px);
    }

    #ecs-{{ section.id }} .ecs-projects {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 76px;
      padding-top: 48px;
      padding-bottom: 120px;
    }

    #ecs-{{ section.id }} .ecs-project:nth-child(n) {
      grid-column: 1;
    }

    #ecs-{{ section.id }} .ecs-project:nth-child(n) .ecs-media {
      aspect-ratio: 4 / 3;
    }

    #ecs-{{ section.id }} .ecs-name {
      font-size: clamp(28px, 7vw, 42px);
    }

    #ecs-{{ section.id }} .ecs-dial {
      opacity: .65;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ecs-{{ section.id }} *,
    #ecs-{{ section.id }} *::before,
    #ecs-{{ section.id }} *::after {
      animation: none !important;
      transition: none !important;
    }

    #ecs-{{ section.id }} .ecs-dial {
      display: none;
    }
  }
</style>

<ukiyo-scroll-cases-v4
  id="ecs-{{ section.id }}"
  data-accent="{{ accent }}"
  data-end="{{ end_color }}"
  data-color-scroll="{{ section.settings.scroll_color }}"
  data-pin="{{ pin_offset }}"
>
  <div class="ecs-runway">
    <header class="ecs-stage">
      <div class="ecs-scene" aria-hidden="true">
        <img
          class="ecs-poster"
          src="{{ poster_url | escape }}"
          alt=""
          width="1920"
          height="1080"
          loading="eager"
        >

        <video
          class="ecs-video"
          muted
          playsinline
          preload="auto"
          poster="{{ poster_url | escape }}"
          tabindex="-1"
        >
          <source
            src="{{ video_url | escape }}"
            type="video/mp4"
          >
        </video>

        <div class="ecs-shade"></div>
      </div>

      <div class="ecs-chrome">
        <div class="ecs-topline">
          {% if section.settings.eyebrow != blank %}
            <p class="ecs-eyebrow">
              {{ section.settings.eyebrow | escape }}
            </p>
          {% endif %}

          {% if projects.size > 0 %}
            <span class="ecs-hero-count" aria-hidden="true">
              01 / {% if projects.size < 10 %}0{% endif %}{{ projects.size }}
            </span>
          {% endif %}
        </div>

        {% if section.settings.title != blank %}
          <div>
            <h2 class="ecs-title">
              <span class="ecs-title-line ecs-title-first">
                {{ title_first | escape }}
              </span>

              {% if title_rest != blank %}
                <span class="ecs-title-line ecs-title-last">
                  {{ title_rest | escape }}
                </span>
              {% endif %}
            </h2>

            <div class="ecs-title-rule" aria-hidden="true"></div>
          </div>
        {% endif %}

        <div class="ecs-bottom">
          {% if projects.size > 0 %}
            <a
              class="ecs-scroll"
              href="#ecs-gallery-{{ section.id }}"
              data-explore
            >
              <span class="ecs-scroll-icon" aria-hidden="true">↓</span>
              Explore projects
            </a>
          {% endif %}

          {% if section.settings.description != blank %}
            <p class="ecs-description">
              {{ section.settings.description | escape | newline_to_br }}
            </p>
          {% endif %}
        </div>
      </div>

      <div class="ecs-film-progress" aria-hidden="true"></div>

      <button
        class="ecs-video-help"
        type="button"
        hidden
      >
        Enable video motion
      </button>
    </header>
  </div>

  {% if projects.size > 0 %}
    <div
      class="ecs-gallery"
      id="ecs-gallery-{{ section.id }}"
    >
      {% if section.settings.show_dial %}
        <div class="ecs-dial" aria-hidden="true">
          <svg focusable="false">
            <path class="ecs-rail"></path>
            <path class="ecs-inner"></path>
            <path class="ecs-arc" pathLength="1"></path>
            <g class="ecs-ticks"></g>
            <polygon class="ecs-needle"></polygon>
            <circle class="ecs-dot ecs-hub" r="3"></circle>
            <circle class="ecs-dot ecs-tip" r="4"></circle>
          </svg>

          <div class="ecs-readout">
            <span class="ecs-current">01</span>
            <span class="ecs-total">
              / {% if projects.size < 10 %}0{% endif %}{{ projects.size }}
            </span>
          </div>
        </div>
      {% endif %}

      <div class="ecs-projects">
        {% for block in projects %}
          {% liquid
            assign card_tag = 'div'
            if block.settings.url != blank
              assign card_tag = 'a'
            endif

            assign image_alt = block.settings.image.alt | default: block.settings.name
          %}

          <article
            class="ecs-project"
            style="--row: {{ forloop.index }};"
            {{ block.shopify_attributes }}
          >
            <{{ card_tag }}
              class="ecs-card"
              {% if block.settings.url != blank %}
                href="{{ block.settings.url | escape }}"
              {% endif %}
            >
              <div class="ecs-media">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 1600
                    | image_tag:
                      class: 'ecs-image',
                      widths: '400, 600, 800, 1000, 1200, 1600',
                      sizes: '(min-width: 768px) 50vw, 100vw',
                      loading: 'lazy',
                      alt: image_alt
                  }}
                {% else %}
                  <div class="ecs-placeholder" aria-hidden="true">
                    {% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}
                  </div>
                {% endif %}
              </div>

              <div class="ecs-card-body">
                <div class="ecs-meta">
                  <span class="ecs-number" aria-hidden="true">
                    {% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}
                  </span>

                  {% if block.settings.tag != blank %}
                    <span class="ecs-category">
                      {{ block.settings.tag | escape }}
                    </span>
                  {% endif %}
                </div>

                <div class="ecs-name-row">
                  <h3 class="ecs-name">
                    {{ block.settings.name | escape }}
                  </h3>

                  {% if block.settings.url != blank %}
                    <span class="ecs-arrow" aria-hidden="true">↗</span>
                  {% endif %}
                </div>
              </div>
            </{{ card_tag }}>
          </article>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</ukiyo-scroll-cases-v4>

<script>
(() => {
  const tag = 'ukiyo-scroll-cases-v4';
  if (customElements.get(tag)) return;

  class Cases extends HTMLElement {
    connectedCallback() {
      this.boot = requestAnimationFrame(() => {
        if (this.isConnected) this.init();
      });
    }

    init() {
      if (this.abort) return;

      this.abort = new AbortController();
      const signal = this.abort.signal;

      this.mediaQuery = matchMedia(
        '(prefers-reduced-motion: reduce)'
      );

      this.runway = this.querySelector('.ecs-runway');
      this.stage = this.querySelector('.ecs-stage');
      this.video = this.querySelector('video');
      this.help = this.querySelector('.ecs-video-help');
      this.gallery = this.querySelector('.ecs-gallery');
      this.dial = this.querySelector('.ecs-dial');
      this.svg = this.querySelector('.ecs-dial svg');
      this.counter = this.querySelector('.ecs-current');
      this.chrome = this.querySelector('.ecs-chrome');

      this.pin = Number(this.dataset.pin) || 0;
      this.items = [...this.querySelectorAll('.ecs-project')];
      this.animations = new Set();
      this.pending = 0;
      this.ticks = [];

      this.clamp = n => Math.max(0, Math.min(1, n));

      this.mix = (a, b, t) => a.map(
        (v, i) => Math.round(v + (b[i] - v) * t)
      );

      this.rgb = value => {
        let v = String(value).replace('#', '');

        if (v.length === 3) {
          v = [...v].map(c => c + c).join('');
        }

        return /^[0-9a-f]{6}$/i.test(v)
          ? [0, 2, 4].map(i => parseInt(v.slice(i, i + 2), 16))
          : [232, 71, 42];
      };

      this.schedule = () => {
        if (this.frame) return;

        this.frame = requestAnimationFrame(() => {
          this.frame = 0;
          if (this.isConnected) this.update();
        });
      };

      this.resize = () => {
        this.toggleAttribute(
          'data-static',
          this.mediaQuery.matches || innerHeight - this.pin < 600
        );

        this.measure();
        this.schedule();
      };

      window.addEventListener('scroll', this.schedule, {
        passive: true,
        signal
      });

      window.addEventListener('resize', this.resize, {
        passive: true,
        signal
      });

      this.mediaQuery.addEventListener('change', () => {
        this.animations.forEach(a => a.cancel());
        this.video.pause();
        this.resize();
      }, { signal });

      this.querySelector('[data-explore]')?.addEventListener(
        'click',
        e => {
          if (
            e.metaKey || e.ctrlKey ||
            e.shiftKey || e.altKey
          ) return;

          e.preventDefault();

          this.gallery?.scrollIntoView({
            block: 'start',
            behavior: this.mediaQuery.matches ? 'auto' : 'smooth'
          });
        },
        { signal }
      );

      this.addEventListener('shopify:block:select', e => {
        this.animations.forEach(a => a.cancel());

        e.target.closest('.ecs-project')?.scrollIntoView({
          block: 'center',
          behavior: 'auto'
        });
      }, { signal });

      this.setupVideo(signal);
      this.setupReveals();
      this.setAttribute('data-enhanced', '');
      this.resize();

      if ('ResizeObserver' in window) {
        this.ro = new ResizeObserver(this.resize);
        this.ro.observe(this);
        this.ro.observe(this.stage);
      }
    }

    setupVideo(signal) {
      const v = this.video;

      v.muted = true;
      v.defaultMuted = true;
      v.playsInline = true;
      v.pause();

      const ready = () => {
        if (v.readyState >= 2) {
          this.setAttribute('data-video-ready', '');
          this.help.hidden = true;
        }

        this.schedule();
      };

      ['loadedmetadata', 'durationchange', 'progress'].forEach(name => {
        v.addEventListener(name, this.schedule, { signal });
      });

      ['loadeddata', 'canplay', 'seeked'].forEach(name => {
        v.addEventListener(name, ready, { signal });
      });

      v.addEventListener('error', () => {
        this.removeAttribute('data-video-ready');
        this.help.hidden = false;
        this.help.textContent = 'Retry video';
      }, { signal });

      this.help.addEventListener('click', async () => {
        if (this.unlocking) return;

        this.unlocking = true;

        if (v.error) v.load();

        try {
          await v.play();

          if (this.isConnected) {
            this.help.hidden = true;
            this.schedule();
          }
        } catch (_) {
          if (this.isConnected) {
            this.help.textContent = 'Retry video';
          }
        } finally {
          v.pause();
          this.unlocking = false;
          this.schedule();
        }
      }, { signal });

      this.timer = setTimeout(() => {
        if (
          this.isConnected &&
          !this.hasAttribute('data-video-ready') &&
          !this.mediaQuery.matches
        ) {
          this.help.hidden = false;
        }
      }, 6000);

      if (v.readyState >= 2) ready();
    }

    seek(progress) {
      const v = this.video;

      if (
        this.mediaQuery.matches ||
        this.unlocking ||
        v.readyState < 1 ||
        !Number.isFinite(v.duration) ||
        v.duration <= 0
      ) return;

      this.pending = progress * Math.max(0, v.duration - .05);

      /*
        Wait for the current seek to finish.
        The latest scroll position is applied on the seeked event.
      */
      if (
        v.seeking ||
        Math.abs(v.currentTime - this.pending) < .025
      ) return;

      try {
        v.currentTime = this.pending;
      } catch (_) {
        /* Retain the current frame while media becomes available. */
      }
    }

    setupReveals() {
      if (!('IntersectionObserver' in window)) return;

      this.io = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (!e.isIntersecting) return;

          this.io.unobserve(e.target);

          if (this.mediaQuery.matches) return;

          const media = e.target.querySelector('.ecs-media');
          if (!media.animate) return;

          const animation = media.animate([
            { clipPath: 'inset(0 0 100% 0)' },
            { clipPath: 'inset(0)' }
          ], {
            duration: 950,
            easing: 'cubic-bezier(.22,1,.36,1)'
          });

          this.animations.add(animation);

          animation.finished
            .catch(() => {})
            .finally(() => {
              this.animations.delete(animation);
            });
        });
      }, { threshold: .04 });

      this.items.forEach(el => this.io.observe(el));
    }

    measure() {
      if (!this.svg) return;

      const width = this.dial.clientWidth;
      const height = this.dial.clientHeight;

      if (!width || !height) return;

      this.cx = width / 2;
      this.cy = height - 72;

      this.r = Math.max(
        1,
        Math.min(width / 2 - 24, height - 116)
      );

      this.svg.setAttribute(
        'viewBox',
        `0 0 ${width} ${height}`
      );

      const path = radius =>
        `M ${this.cx - radius} ${this.cy} A ${radius} ${radius} 0 0 1 ${this.cx + radius} ${this.cy}`;

      this.svg.querySelector('.ecs-rail').setAttribute(
        'd',
        path(this.r)
      );

      this.svg.querySelector('.ecs-inner').setAttribute(
        'd',
        path(Math.max(1, this.r - 30))
      );

      this.arc = this.svg.querySelector('.ecs-arc');
      this.arc.setAttribute('d', path(this.r));

      this.needle = this.svg.querySelector('.ecs-needle');

      this.needle.setAttribute('points', [
        `${this.cx},${this.cy - 1.2}`,
        `${this.cx + this.r - 40},${this.cy}`,
        `${this.cx},${this.cy + 1.2}`
      ].join(' '));

      this.tip = this.svg.querySelector('.ecs-tip');

      const hub = this.svg.querySelector('.ecs-hub');
      hub.setAttribute('cx', this.cx);
      hub.setAttribute('cy', this.cy);

      const holder = this.svg.querySelector('.ecs-ticks');
      holder.replaceChildren();
      this.ticks = [];

      for (let i = 0; i <= 60; i++) {
        const angle = Math.PI + i / 60 * Math.PI;
        const outer = this.r - 8;
        const inner = outer - (i % 5 === 0 ? 16 : 6);

        const tick = document.createElementNS(
          'http://www.w3.org/2000/svg',
          'line'
        );

        tick.setAttribute('class', 'ecs-tick');

        Object.entries({
          x1: this.cx + Math.cos(angle) * inner,
          y1: this.cy + Math.sin(angle) * inner,
          x2: this.cx + Math.cos(angle) * outer,
          y2: this.cy + Math.sin(angle) * outer
        }).forEach(([key, value]) => {
          tick.setAttribute(key, value);
        });

        holder.appendChild(tick);
        this.ticks.push(tick);
      }
    }

    update() {
      const reduced = this.mediaQuery.matches;
      const viewportHeight = innerHeight;
      const rect = this.runway.getBoundingClientRect();

      const travel = this.hasAttribute('data-static')
        ? rect.height
        : Math.max(1, rect.height - this.stage.offsetHeight);

      const heroProgress = reduced
        ? 0
        : this.clamp((this.pin - rect.top) / travel);

      const textProgress = this.clamp(heroProgress / .68);
      const sceneOpacity = 1 - this.clamp(
        (heroProgress - .78) / .22
      );

      const variables = {
        '--title-left': `${-112 * textProgress}%`,
        '--title-right': `${112 * textProgress}%`,
        '--rule-scale': 1 - textProgress,
        '--chrome-opacity': 1 - this.clamp(heroProgress / .42),
        '--scene-scale': 1 + heroProgress * .1,
        '--scene-opacity': sceneOpacity,
        '--film-progress': heroProgress
      };

      Object.entries(variables).forEach(([key, value]) => {
        this.style.setProperty(key, String(value));
      });

      /*
        Prevent invisible opening links receiving keyboard focus
        once the opening typography has moved out of view.
      */
      this.chrome.inert = heroProgress > .46;
      this.chrome.style.visibility =
        heroProgress > .72 ? 'hidden' : 'visible';

      this.seek(heroProgress);

      const centers = [];
      let nearest = 0;
      let distance = Infinity;

      this.items.forEach((element, index) => {
        const r = element.getBoundingClientRect();
        const center = r.top + r.height / 2;

        centers.push(center);

        const difference = Math.abs(
          center - viewportHeight / 2
        );

        if (difference < distance) {
          distance = difference;
          nearest = index;
        }

        if (reduced) {
          element.style.setProperty('--image-y', '0px');
        } else if (
          r.bottom >= 0 &&
          r.top <= viewportHeight
        ) {
          const progress = this.clamp(
            (viewportHeight - r.top) /
            (viewportHeight + r.height)
          );

          const offset =
            (progress - .5) * Math.min(40, r.height * .07);

          element.style.setProperty(
            '--image-y',
            `${offset.toFixed(2)}px`
          );
        }
      });

      let galleryProgress = 0;

      if (centers.length > 1) {
        if (viewportHeight / 2 >= centers.at(-1)) {
          galleryProgress = 1;
        } else {
          for (let i = 0; i < centers.length - 1; i++) {
            if (
              viewportHeight / 2 >= centers[i] &&
              viewportHeight / 2 < centers[i + 1]
            ) {
              const local =
                (viewportHeight / 2 - centers[i]) /
                Math.max(1, centers[i + 1] - centers[i]);

              galleryProgress =
                (i + local) / (centers.length - 1);

              break;
            }
          }
        }
      } else if (this.gallery) {
        const r = this.gallery.getBoundingClientRect();

        galleryProgress = this.clamp(
          (viewportHeight / 2 - r.top) /
          Math.max(1, r.height)
        );
      }

      if (this.counter) {
        this.counter.textContent = String(
          nearest + 1
        ).padStart(2, '0');
      }

      if (this.arc && !reduced) {
        this.arc.style.strokeDashoffset = String(
          1 - galleryProgress
        );

        this.needle.setAttribute(
          'transform',
          `rotate(${-180 + galleryProgress * 180} ${this.cx} ${this.cy})`
        );

        const angle = Math.PI + galleryProgress * Math.PI;

        this.tip.setAttribute(
          'cx',
          this.cx + Math.cos(angle) * this.r
        );

        this.tip.setAttribute(
          'cy',
          this.cy + Math.sin(angle) * this.r
        );

        this.ticks.forEach((element, index) => {
          element.classList.toggle(
            'is-active',
            index / 60 <= galleryProgress
          );
        });
      }

      let background = [13, 14, 16];
      let dialColor = this.rgb(this.dataset.accent);

      if (
        this.dataset.colorScroll !== 'false' &&
        !reduced
      ) {
        const stops = [
          [13, 14, 16],
          [23, 20, 27],
          [53, 19, 29],
          [88, 25, 31],
          this.rgb(this.dataset.end)
        ];

        const scaled = galleryProgress * 4;
        const index = Math.min(3, Math.floor(scaled));
        const fraction = scaled - index;
        const eased =
          fraction * fraction * (3 - 2 * fraction);

        background = this.mix(
          stops[index],
          stops[index + 1],
          eased
        );

        dialColor = this.mix(
          dialColor,
          [244, 244, 242],
          this.clamp((galleryProgress - .2) / .6)
        );
      }

      this.style.setProperty(
        '--bg',
        `rgb(${background.join(',')})`
      );

      this.style.setProperty(
        '--dial-ink',
        `rgb(${dialColor.join(',')})`
      );
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.boot);
      cancelAnimationFrame(this.frame);
      clearTimeout(this.timer);

      this.frame = 0;
      this.abort?.abort();
      this.abort = null;
      this.ro?.disconnect();
      this.io?.disconnect();
      this.animations?.forEach(a => a.cancel());
      this.video?.pause();
      this.removeAttribute('data-enhanced');
    }
  }

  customElements.define(tag, Cases);
})();
</script>

