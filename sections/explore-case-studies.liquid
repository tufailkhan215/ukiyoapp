{% comment %}
  Church of Truth — cinematic landing and navigation.
  Preserves the original header setting IDs.
  Includes three scroll-controlled videos, glass cards,
  mission transitions, accessible navigation, and Shopify signup.
{% endcomment %}

{% liquid
  assign selected_menu = section.settings.menu
  if selected_menu == blank
    assign selected_menu = 'gl-main-nav'
  endif
  assign navigation = linklists[selected_menu]

  assign conversation_url = section.settings.apply_link
  if conversation_url == blank
    assign conversation_url = pages['conversation'].url | default: '/pages/conversation'
  endif

  assign show_landing = false
  if request.page_type == 'index' or section.settings.show_on_all_pages
    assign show_landing = true
  endif

  assign screens = section.settings.scroll_length | divided_by: 100.0
  assign signup_id = 'CT-Signup-' | append: section.id
%}

{% capture arrow %}
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M5 12h14m-6-6 6 6-6 6"/>
  </svg>
{% endcapture %}

{% capture brand %}
  {% if section.settings.show_logo and section.settings.logo_url != blank %}
    <img
      class="ct-logo"
      src="{{ section.settings.logo_url | escape }}"
      alt=""
      width="48"
      height="48"
      loading="eager"
    >
  {% endif %}
  <span class="ct-brand-copy">
    <span class="ct-brand-name">{{ section.settings.brand_name | escape }}</span>
    {% if section.settings.brand_tagline != blank %}
      <span class="ct-brand-tag">{{ section.settings.brand_tagline | escape }}</span>
    {% endif %}
  </span>
{% endcapture %}

<div
  id="TruthLanding-{{ section.id }}"
  class="ct"
  style="
    --ct-accent: {{ section.settings.accent }};
    --ct-screens: {{ screens }};
  "
>
  <header class="ct-header" data-ct-header>
    <a class="ct-brand" href="{{ routes.root_url }}">
      {{ brand }}
    </a>

    <div class="ct-header-right">
      <nav class="ct-desktop-nav" aria-label="Primary navigation">
        {% for link in navigation.links limit: 4 %}
          <a
            href="{{ link.url | escape }}"
            {% if link.current %}aria-current="page"{% endif %}
          >
            {{ link.title | escape }}
          </a>
        {% endfor %}
      </nav>

      {% if section.settings.show_header_cta and section.settings.apply_label != blank %}
        <a class="ct-header-cta" href="{{ conversation_url | escape }}">
          {{ section.settings.apply_label | escape }}
        </a>
      {% endif %}

      <button
        class="ct-menu-button"
        type="button"
        data-ct-open
        aria-label="Open navigation"
        aria-controls="CT-Menu-{{ section.id }}"
        aria-expanded="false"
        hidden
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </header>

  <dialog
    id="CT-Menu-{{ section.id }}"
    class="ct-dialog"
    data-ct-dialog
    aria-label="Navigation"
  >
    <div class="ct-dialog-top">
      <a class="ct-brand" href="{{ routes.root_url }}">
        {{ brand }}
      </a>
      <button class="ct-close" type="button" data-ct-close autofocus>
        Close <span aria-hidden="true">×</span>
      </button>
    </div>

    <nav class="ct-menu-content" aria-label="All navigation">
      {% for link in navigation.links %}
        <div class="ct-menu-group">
          {% if link.links.size > 0 %}
            <details>
              <summary>
                {{ link.title | escape }}
                <span aria-hidden="true">+</span>
              </summary>

              <div class="ct-submenu">
                <a href="{{ link.url | escape }}">
                  {{ link.title | escape }} — Overview
                </a>

                {% for child in link.links %}
                  <a
                    href="{{ child.url | escape }}"
                    {% if child.current %}aria-current="page"{% endif %}
                  >
                    {{ child.title | escape }}
                  </a>

                  {% if child.links.size > 0 %}
                    <div class="ct-grandchildren">
                      {% for grandchild in child.links %}
                        <a
                          href="{{ grandchild.url | escape }}"
                          {% if grandchild.current %}aria-current="page"{% endif %}
                        >
                          {{ grandchild.title | escape }}
                        </a>
                      {% endfor %}
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </details>
          {% else %}
            <a
              class="ct-menu-main-link"
              href="{{ link.url | escape }}"
              {% if link.current %}aria-current="page"{% endif %}
            >
              {{ link.title | escape }}
              <span aria-hidden="true">↗</span>
            </a>
          {% endif %}
        </div>
      {% endfor %}

      {% if section.settings.apply_label != blank %}
        <a class="ct-button" href="{{ conversation_url | escape }}">
          {{ section.settings.apply_label | escape }}
          {{ arrow }}
        </a>
      {% endif %}

      {% if section.settings.show_signin and shop.customer_accounts_enabled %}
        <a class="ct-signin" href="{{ routes.account_login_url }}">
          {{ section.settings.signin_label | escape }}
        </a>
      {% endif %}
    </nav>
  </dialog>

  <noscript>
    <nav class="ct-noscript-nav" aria-label="Navigation">
      {% for link in navigation.links %}
        <a href="{{ link.url | escape }}">{{ link.title | escape }}</a>
        {% for child in link.links %}
          <a href="{{ child.url | escape }}">{{ child.title | escape }}</a>
          {% for grandchild in child.links %}
            <a href="{{ grandchild.url | escape }}">{{ grandchild.title | escape }}</a>
          {% endfor %}
        {% endfor %}
      {% endfor %}
      <a href="{{ conversation_url | escape }}">
        {{ section.settings.apply_label | escape }}
      </a>
    </nav>
  </noscript>

  {% if show_landing %}
    <div class="ct-runway" data-ct-runway>
      <div class="ct-stage" data-ct-stage>
        <div class="ct-background" aria-hidden="true">
          {% if section.settings.poster != blank %}
            {{
              section.settings.poster
              | image_url: width: 2400
              | image_tag:
                class: 'ct-poster',
                loading: 'eager',
                fetchpriority: 'high',
                widths: '750, 1100, 1600, 2400',
                sizes: '100vw',
                alt: ''
            }}
          {% endif %}

          {% for i in (1..3) %}
            {% assign video_key = 'video_' | append: i %}
            {% if section.settings[video_key] != blank %}
              <video
                class="ct-video"
                data-ct-video="{{ forloop.index0 }}"
                data-src="{{ section.settings[video_key] | escape }}"
                muted
                playsinline
                preload="none"
                tabindex="-1"
                {% if section.settings.poster != blank %}
                  poster="{{ section.settings.poster | image_url: width: 2000 }}"
                {% endif %}
              ></video>
            {% endif %}
          {% endfor %}
          <div class="ct-background-shade"></div>
        </div>

        <div class="ct-intro" data-ct-scene="intro">
          <div class="ct-glass ct-intro-card">
            <p class="ct-eyebrow">
              {{ section.settings.intro_label | escape }}
            </p>
            <h1>
              {{ section.settings.hero_title | escape | newline_to_br }}
            </h1>
            <p class="ct-intro-copy">
              {{ section.settings.hero_description | escape }}
            </p>

            <a
              class="ct-circle"
              href="#CT-Pillars-{{ section.id }}"
              data-ct-explore
              aria-label="Explore our approach"
            >
              {{ arrow }}
            </a>
          </div>

          <span class="ct-scroll-note" aria-hidden="true">
            Scroll to explore <span>↓</span>
          </span>
        </div>

        <section
          id="CT-Pillars-{{ section.id }}"
          class="ct-features"
          data-ct-scene="features"
          aria-label="Spirituality, technology, and science"
        >
          {% for i in (1..3) %}
            {% liquid
              assign title_key = 'pillar_title_' | append: i
              assign body_key = 'pillar_body_' | append: i
            %}
            <article class="ct-glass ct-feature" data-ct-card>
              <div class="ct-feature-top">
                <span class="ct-feature-number">0{{ i }}</span>

                <svg class="ct-feature-symbol" viewBox="0 0 48 48" aria-hidden="true">
                  {% case i %}
                    {% when 1 %}
                      <circle cx="24" cy="24" r="15"/>
                      <path d="M24 3v10m0 22v10M3 24h10m22 0h10"/>
                      <circle cx="24" cy="24" r="4"/>
                    {% when 2 %}
                      <path d="M24 5 43 24 24 43 5 24Z"/>
                      <path d="M24 13 35 24 24 35 13 24Z"/>
                      <path d="M5 24h8m22 0h8M24 5v8m0 22v8"/>
                    {% when 3 %}
                      <ellipse cx="24" cy="24" rx="20" ry="8"/>
                      <ellipse cx="24" cy="24" rx="20" ry="8" transform="rotate(60 24 24)"/>
                      <ellipse cx="24" cy="24" rx="20" ry="8" transform="rotate(120 24 24)"/>
                      <circle cx="24" cy="24" r="2"/>
                  {% endcase %}
                </svg>
              </div>

              <div>
                <h2>{{ section.settings[title_key] | escape }}</h2>
                <p>{{ section.settings[body_key] | escape }}</p>
              </div>
            </article>
          {% endfor %}
        </section>

        <section class="ct-mission" aria-label="Our approach">
          {% for i in (1..3) %}
            {% assign mission_key = 'mission_' | append: i %}
            <div class="ct-mission-text" data-ct-mission>
              <p class="ct-eyebrow">
                {{ section.settings.brand_name | escape }} / 0{{ i }}
              </p>
              <h2>{{ section.settings[mission_key] | escape }}</h2>
            </div>
          {% endfor %}
        </section>

        <div class="ct-finale" data-ct-scene="finale">
          <div class="ct-glass ct-finale-card">
            <p class="ct-eyebrow">The conversation continues</p>
            <h2>{{ section.settings.closing_title | escape }}</h2>
            <p>{{ section.settings.closing_description | escape }}</p>

            {% if section.settings.apply_label != blank %}
              <a class="ct-button" href="{{ conversation_url | escape }}">
                {{ section.settings.apply_label | escape }}
                {{ arrow }}
              </a>
            {% endif %}

            {% if section.settings.show_signup %}
              <a class="ct-text-link" href="#{{ signup_id }}">
                Stay connected <span aria-hidden="true">↓</span>
              </a>
            {% endif %}
          </div>
        </div>

        <button
          type="button"
          class="ct-mode"
          data-ct-mode
          aria-pressed="false"
          hidden
        >
          View all content
        </button>

        <div class="ct-progress" aria-hidden="true">
          <span data-ct-progress></span>
        </div>
      </div>
    </div>

    {% if section.settings.show_signup %}
      <section class="ct-signup" aria-labelledby="CT-SignupTitle-{{ section.id }}">
        <div class="ct-signup-card">
          <p class="ct-eyebrow">
            {{ section.settings.brand_name | escape }}
          </p>
          <h2 id="CT-SignupTitle-{{ section.id }}">
            {{ section.settings.signup_title | escape }}
          </h2>
          <p>{{ section.settings.signup_description | escape }}</p>

          {% form 'customer', id: signup_id, class: 'ct-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">

            {% if form.posted_successfully? %}
              <p class="ct-form-success" role="status">
                Thank you. Your signup has been received.
              </p>
            {% else %}
              {% if form.errors %}
                <div class="ct-form-errors" role="alert">
                  {{ form.errors | default_errors }}
                </div>
              {% endif %}

              <label for="CT-Email-{{ section.id }}">Email address</label>
              <input
                id="CT-Email-{{ section.id }}"
                type="email"
                name="contact[email]"
                value="{{ form.email | escape }}"
                placeholder="Your email address"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                required
              >
              <p class="ct-consent">
                Subscribe to receive our newsletter and updates by email.
                You can unsubscribe at any time.
              </p>
              <button type="submit" class="ct-button">
                {{ section.settings.signup_button | escape }}
                {{ arrow }}
              </button>
            {% endif %}
          {% endform %}
        </div>
      </section>
    {% endif %}
  {% endif %}
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600&display=swap');

  #TruthLanding-{{ section.id }} {
    --ct-pad: clamp(20px, 3.5vw, 56px);
    --ct-serif: "Instrument Serif", Georgia, serif;
    --ct-sans: "Manrope", Arial, sans-serif;
    color: #fff;
    background: #080a09;
    font-family: var(--ct-sans);
    -webkit-font-smoothing: antialiased;
  }

  #TruthLanding-{{ section.id }} *,
  #TruthLanding-{{ section.id }} *::before,
  #TruthLanding-{{ section.id }} *::after { box-sizing: border-box; }

  #TruthLanding-{{ section.id }} :is(h1,h2,p) { margin: 0; color: inherit; }
  #TruthLanding-{{ section.id }} a { color: inherit; text-decoration: none; }
  #TruthLanding-{{ section.id }} button { font: inherit; cursor: pointer; }
  #TruthLanding-{{ section.id }} [hidden] { display: none !important; }

  #TruthLanding-{{ section.id }} :is(a,button,input,summary):focus-visible {
    outline: 2px solid var(--ct-accent);
    outline-offset: 5px;
  }

  #TruthLanding-{{ section.id }} svg {
    width: 24px; height: 24px;
    fill: none; stroke: currentColor; stroke-width: 1.5;
    stroke-linecap: round; stroke-linejoin: round;
    flex-shrink: 0;
  }

  #TruthLanding-{{ section.id }} .ct-header {
    position: fixed; inset: 0 0 auto; z-index: 50;
    display: flex; align-items: center; justify-content: space-between;
    gap: 24px; padding: 24px var(--ct-pad);
    color: #fff;
    transition: background .3s, padding .3s;
  }

  #TruthLanding-{{ section.id }} .ct-header[data-scrolled="true"] {
    background: rgba(8,10,9,.9);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding-block: 15px;
    border-bottom: 1px solid #ffffff18;
  }

  #TruthLanding-{{ section.id }} .ct-brand {
    display: flex; align-items: center; gap: 12px;
    min-width: 0; color: #fff;
  }

  #TruthLanding-{{ section.id }} .ct-logo {
    width: 44px; height: 44px; object-fit: contain; flex-shrink: 0;
  }

  #TruthLanding-{{ section.id }} .ct-brand-copy {
    display: flex; flex-direction: column; gap: 5px; min-width: 0;
  }

  #TruthLanding-{{ section.id }} .ct-brand-name {
    font-family: var(--ct-serif);
    font-size: clamp(24px, 2.1vw, 34px);
    line-height: 1; letter-spacing: -.025em;
  }

  #TruthLanding-{{ section.id }} .ct-brand-tag {
    font-size: 8px; line-height: 1.5;
    letter-spacing: .13em; opacity: .8;
  }

  #TruthLanding-{{ section.id }} .ct-header-right {
    display: flex; align-items: center; justify-content: flex-end;
    gap: 10px;
  }

  #TruthLanding-{{ section.id }} .ct-desktop-nav {
    display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 3px;
  }

  #TruthLanding-{{ section.id }} .ct-desktop-nav a,
  #TruthLanding-{{ section.id }} .ct-header-cta {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 44px; padding: 10px 15px;
    border-radius: 8px; background: #fff; color: #151715;
    font-size: 11px; line-height: 1.4;
    transition: background .2s, transform .2s;
  }

  #TruthLanding-{{ section.id }} .ct-header-cta {
    background: var(--ct-accent);
  }

  #TruthLanding-{{ section.id }} .ct-menu-button {
    display: flex; flex-direction: column; justify-content: center;
    align-items: center; gap: 5px;
    width: 46px; height: 46px; flex-shrink: 0;
    color: #fff; background: #ffffff16;
    border: 1px solid #ffffff35; border-radius: 10px;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  #TruthLanding-{{ section.id }} .ct-menu-button span {
    display: block; width: 20px; height: 1px; background: currentColor;
  }

  #TruthLanding-{{ section.id }} .ct-dialog {
    position: fixed; inset: 0; margin: 0;
    width: 100%; height: 100%; max-width: none; max-height: none;
    padding: 0; border: 0; color: #fff;
    background: rgba(8,10,9,.97);
    font-family: var(--ct-sans);
    overscroll-behavior: contain;
  }

  #TruthLanding-{{ section.id }} .ct-dialog::backdrop {
    background: #000a;
    backdrop-filter: blur(20px);
  }

  #TruthLanding-{{ section.id }} .ct-dialog-top {
    display: flex; align-items: center; justify-content: space-between;
    gap: 24px; padding: 25px var(--ct-pad);
    border-bottom: 1px solid #ffffff20;
  }

  #TruthLanding-{{ section.id }} .ct-close {
    display: flex; align-items: center; gap: 12px;
    min-height: 44px; padding: 8px;
    border: 0; background: none; color: #fff;
    font-size: 12px;
  }

  #TruthLanding-{{ section.id }} .ct-close span { font-size: 30px; }

  #TruthLanding-{{ section.id }} .ct-menu-content {
    width: min(100%, 1000px); margin: 0 auto;
    padding: 45px var(--ct-pad) 80px;
  }

  #TruthLanding-{{ section.id }} .ct-menu-group {
    border-bottom: 1px solid #ffffff25;
  }

  #TruthLanding-{{ section.id }} .ct-menu-group summary,
  #TruthLanding-{{ section.id }} .ct-menu-main-link {
    display: flex; justify-content: space-between; align-items: center;
    gap: 20px; padding: 22px 0;
    font-family: var(--ct-serif);
    font-size: clamp(30px, 5vw, 58px); line-height: 1.1;
    cursor: pointer; list-style: none;
  }

  #TruthLanding-{{ section.id }} summary::-webkit-details-marker { display: none; }
  #TruthLanding-{{ section.id }} details[open] > summary > span { transform: rotate(45deg); }

  #TruthLanding-{{ section.id }} .ct-submenu {
    display: grid; gap: 8px; padding: 0 0 24px 12px;
  }

  #TruthLanding-{{ section.id }} .ct-submenu a {
    display: block; padding: 10px 0; font-size: 16px;
    color: #ffffffbf;
  }

  #TruthLanding-{{ section.id }} .ct-grandchildren {
    display: grid; padding-left: 20px; border-left: 1px solid #ffffff25;
  }

  #TruthLanding-{{ section.id }} .ct-menu-content > .ct-button { margin-top: 32px; }
  #TruthLanding-{{ section.id }} .ct-signin { display: block; margin-top: 24px; }

  #TruthLanding-{{ section.id }} .ct-noscript-nav {
    position: relative; padding: 120px 24px 24px;
    display: flex; flex-wrap: wrap; gap: 20px;
  }

  #TruthLanding-{{ section.id }} .ct-runway { position: relative; }
  #TruthLanding-{{ section.id }} .ct-stage { position: relative; isolation: isolate; }

  #TruthLanding-{{ section.id }} .ct-background {
    position: absolute; inset: 0; z-index: -1; overflow: hidden;
    background: radial-gradient(ellipse at 70% 20%, #354536, #101810 65%, #080a09);
  }

  #TruthLanding-{{ section.id }} .ct-poster,
  #TruthLanding-{{ section.id }} .ct-video {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover;
  }

  #TruthLanding-{{ section.id }} .ct-video { opacity: 0; }
  #TruthLanding-{{ section.id }} .ct-background-shade {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, #0005, #0001 30%, #0007 100%);
  }

  #TruthLanding-{{ section.id }} .ct-intro {
    position: relative; padding: 190px var(--ct-pad) 90px;
    min-height: 90svh; display: flex; align-items: flex-end;
  }

  #TruthLanding-{{ section.id }} .ct-glass {
    background: rgba(255,255,255,.14);
    backdrop-filter: blur(38px);
    -webkit-backdrop-filter: blur(38px);
    border: 1px solid #ffffff35;
    box-shadow: 0 25px 60px #0003;
  }

  #TruthLanding-{{ section.id }} .ct-intro-card {
    position: relative; width: min(480px, 100%);
    padding: clamp(28px, 3vw, 48px);
  }

  #TruthLanding-{{ section.id }} .ct-eyebrow {
    font-family: var(--ct-sans); font-size: 10px;
    line-height: 1.6; letter-spacing: .13em;
    text-transform: uppercase; color: #ffffffb3;
  }

  #TruthLanding-{{ section.id }} .ct-intro h1 {
    margin-top: 20px;
    font-family: var(--ct-serif); font-size: clamp(43px, 5vw, 74px);
    line-height: 1.02; font-weight: 400;
    letter-spacing: -.03em; text-wrap: balance;
  }

  #TruthLanding-{{ section.id }} .ct-intro-copy {
    margin-top: 23px; max-width: 36ch;
    font-size: 14px; line-height: 1.75; color: #ffffffc9;
  }

  #TruthLanding-{{ section.id }} .ct-circle {
    position: absolute; right: -40px; bottom: 32px;
    display: grid; place-items: center;
    width: 80px; height: 80px; border-radius: 50%;
    background: var(--ct-accent); color: #171717;
    transition: transform .25s;
  }

  #TruthLanding-{{ section.id }} .ct-circle svg { width: 32px; height: 32px; }
  #TruthLanding-{{ section.id }} .ct-circle:hover { transform: translateX(4px); }
  #TruthLanding-{{ section.id }} .ct-scroll-note {
    display: none; align-items: center; gap: 20px;
    font-size: 10px; letter-spacing: .12em; text-transform: uppercase;
  }

  #TruthLanding-{{ section.id }} .ct-features {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px; width: min(100%, 1120px);
    margin: 0 auto; padding: 80px var(--ct-pad);
  }

  #TruthLanding-{{ section.id }} .ct-feature {
    display: flex; flex-direction: column; justify-content: space-between;
    gap: 60px; min-height: 350px; padding: 28px;
  }

  #TruthLanding-{{ section.id }} .ct-feature-top {
    display: flex; align-items: flex-start; justify-content: space-between; gap: 20px;
  }

  #TruthLanding-{{ section.id }} .ct-feature-number {
    font-size: 11px; color: #ffffffa3;
  }

  #TruthLanding-{{ section.id }} .ct-feature-symbol {
    width: 48px; height: 48px; color: var(--ct-accent);
    stroke-width: 1;
  }

  #TruthLanding-{{ section.id }} .ct-feature h2 {
    font-family: var(--ct-serif); font-size: 34px;
    font-weight: 400; line-height: 1.1;
  }

  #TruthLanding-{{ section.id }} .ct-feature p {
    margin-top: 14px; font-size: 13px; line-height: 1.75;
    color: #ffffffc9;
  }

  #TruthLanding-{{ section.id }} .ct-mission-text {
    max-width: 1100px; margin: 0 auto;
    padding: 100px var(--ct-pad); text-align: center;
  }

  #TruthLanding-{{ section.id }} .ct-mission-text h2 {
    margin-top: 24px; font-family: var(--ct-serif);
    font-size: clamp(34px, 5.2vw, 76px);
    font-weight: 400; line-height: 1.15;
    letter-spacing: -.025em; text-wrap: balance;
  }

  #TruthLanding-{{ section.id }} .ct-finale {
    padding: 90px var(--ct-pad); display: grid; place-items: center;
  }

  #TruthLanding-{{ section.id }} .ct-finale-card {
