{% doc %}
  @prompt
    Premium scroll-driven case study marquee for Shopify.

    Native Liquid, CSS and vanilla JavaScript only.
    Display a large number of case studies across two horizontal rows.

    Row one moves right as the page scrolls down.
    Row two moves left.

    Optimized for desktop, tablet and mobile.
    No React, JSX, Framer Motion, GSAP or external animation libraries.
{% enddoc %}

{%- liquid
  assign ai_gen_id = block.id | replace: '_', '' | replace: '-', '' | downcase
  assign root_id = 'CaseStudyMarquee-' | append: ai_gen_id

  assign row_1_items = block.settings.row_1_items | newline_to_br | split: '<br />'
  assign row_2_items = block.settings.row_2_items | newline_to_br | split: '<br />'

  assign project_count = 0

  for item in row_1_items
    assign item_clean = item | strip
    if item_clean != blank
      assign project_count = project_count | plus: 1
    endif
  endfor

  for item in row_2_items
    assign item_clean = item | strip
    if item_clean != blank
      assign project_count = project_count | plus: 1
    endif
  endfor
-%}

<case-study-marquee-{{ ai_gen_id }}
  id="{{ root_id }}"
  class="csm-{{ ai_gen_id }}"
  data-desktop-speed-one="{{ block.settings.desktop_speed_one | divided_by: 100.0 }}"
  data-desktop-speed-two="{{ block.settings.desktop_speed_two | divided_by: 100.0 }}"
  data-mobile-speed-one="{{ block.settings.mobile_speed_one | divided_by: 100.0 }}"
  data-mobile-speed-two="{{ block.settings.mobile_speed_two | divided_by: 100.0 }}"
  data-initial-offset="{{ block.settings.initial_offset }}"
  data-motion="{{ block.settings.enable_motion }}"
  style="
    --csm-bg:{{ block.settings.background_color }};
    --csm-card-bg:{{ block.settings.card_background }};
    --csm-text:{{ block.settings.text_color }};
    --csm-muted:{{ block.settings.muted_color }};
    --csm-accent:{{ block.settings.accent_color }};
    --csm-line:{{ block.settings.line_color }};
    --csm-max:{{ block.settings.max_width }}px;
    --csm-card-width:{{ block.settings.card_width }}px;
    --csm-mobile-card-width:{{ block.settings.mobile_card_width }}px;
    --csm-gap:{{ block.settings.card_gap }}px;
    --csm-radius:{{ block.settings.card_radius }}px;
    --csm-top:{{ block.settings.padding_top }}px;
    --csm-bottom:{{ block.settings.padding_bottom }}px;
    --csm-mobile-top:{{ block.settings.mobile_padding_top }}px;
    --csm-mobile-bottom:{{ block.settings.mobile_padding_bottom }}px;
  "
  {{ block.shopify_attributes }}
>

  {% if block.settings.show_intro %}
    <header class="csm-{{ ai_gen_id }}__intro">

      <div class="csm-{{ ai_gen_id }}__intro-inner">

        <div class="csm-{{ ai_gen_id }}__intro-primary">

          {% if block.settings.eyebrow != blank %}
            <p class="csm-{{ ai_gen_id }}__eyebrow">
              <span aria-hidden="true"></span>
              {{ block.settings.eyebrow | escape }}
            </p>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h2 class="csm-{{ ai_gen_id }}__heading">
              {{ block.settings.heading | escape }}
            </h2>
          {% endif %}

        </div>

        <div class="csm-{{ ai_gen_id }}__intro-aside">

          {% if block.settings.description != blank %}
            <div class="csm-{{ ai_gen_id }}__description">
              {{ block.settings.description }}
            </div>
          {% endif %}

          {% if block.settings.show_count %}
            <div class="csm-{{ ai_gen_id }}__count">
              <strong>{{ project_count }}</strong>

              <span>
                Case
                {% if project_count == 1 %}
                  study
                {% else %}
                  studies
                {% endif %}
              </span>
            </div>
          {% endif %}

        </div>

      </div>

      <div class="csm-{{ ai_gen_id }}__intro-rule">
        <span></span>
      </div>

    </header>
  {% endif %}


  <div
    class="csm-{{ ai_gen_id }}__canvas"
    data-marquee-canvas
  >

    <div
      class="csm-{{ ai_gen_id }}__edge csm-{{ ai_gen_id }}__edge--left"
      aria-hidden="true"
    ></div>

    <div
      class="csm-{{ ai_gen_id }}__edge csm-{{ ai_gen_id }}__edge--right"
      aria-hidden="true"
    ></div>


    {% comment %}
      ============================================================
      ROW ONE
      ============================================================
    {% endcomment %}

    <div class="csm-{{ ai_gen_id }}__row-viewport">

      <div
        class="csm-{{ ai_gen_id }}__track"
        data-track="one"
      >

        {% for copy_index in (1..2) %}

          <div
            class="csm-{{ ai_gen_id }}__group"
            data-group="one"
            {% if copy_index == 2 %}
              aria-hidden="true"
            {% endif %}
          >

            {% for item in row_1_items %}

              {%- liquid
                assign item_clean = item | strip

                if item_clean == blank
                  continue
                endif

                assign fields = item_clean | split: '|'

                assign image_url = fields[0] | strip
                assign title = fields[1] | default: '' | strip
                assign project_url = fields[2] | default: '' | strip

                if title == blank
                  assign title = 'Selected work'
                endif
              -%}

              {% if project_url != blank %}

                <a
                  class="csm-{{ ai_gen_id }}__card"
                  href="{{ project_url }}"
                  aria-label="View case study: {{ title | escape }}"
                  {% if copy_index == 2 %}
                    tabindex="-1"
                  {% endif %}
                >

                  <span class="csm-{{ ai_gen_id }}__media">

                    <img
                      src="{{ image_url | escape }}"
                      alt=""
                      loading="lazy"
                      decoding="async"
                      draggable="false"
                      width="840"
                      height="540"
                    >

                    <span class="csm-{{ ai_gen_id }}__shade"></span>
                    <span class="csm-{{ ai_gen_id }}__frame"></span>

                    {% if block.settings.show_titles %}
                      <span class="csm-{{ ai_gen_id }}__card-copy">

                        <span class="csm-{{ ai_gen_id }}__project-label">
                          Case study
                        </span>

                        <strong>
                          {{ title | escape }}
                        </strong>

                        <span class="csm-{{ ai_gen_id }}__view-project">
                          View project

                          <svg
                            viewBox="0 0 24 24"
                            width="15"
                            height="15"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.7"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <path d="M5 12h14"/>
                            <path d="m13 6 6 6-6 6"/>
                          </svg>
                        </span>

                      </span>
                    {% endif %}

                  </span>

                </a>

              {% else %}

                <div class="csm-{{ ai_gen_id }}__card">

                  <span class="csm-{{ ai_gen_id }}__media">

                    <img
                      src="{{ image_url | escape }}"
                      alt=""
                      loading="lazy"
                      decoding="async"
                      draggable="false"
                      width="840"
                      height="540"
                    >

                    <span class="csm-{{ ai_gen_id }}__shade"></span>
                    <span class="csm-{{ ai_gen_id }}__frame"></span>

                    {% if block.settings.show_titles %}
                      <span class="csm-{{ ai_gen_id }}__card-copy">

                        <span class="csm-{{ ai_gen_id }}__project-label">
                          Case study
                        </span>

                        <strong>
                          {{ title | escape }}
                        </strong>

                      </span>
                    {% endif %}

                  </span>

                </div>

              {% endif %}

            {% endfor %}

          </div>

        {% endfor %}

      </div>

    </div>


    {% comment %}
      ============================================================
      ROW TWO
      ============================================================
    {% endcomment %}

    <div class="csm-{{ ai_gen_id }}__row-viewport">

      <div
        class="csm-{{ ai_gen_id }}__track"
        data-track="two"
      >

        {% for copy_index in (1..2) %}

          <div
            class="csm-{{ ai_gen_id }}__group"
            data-group="two"
            {% if copy_index == 2 %}
              aria-hidden="true"
            {% endif %}
          >

            {% for item in row_2_items %}

              {%- liquid
                assign item_clean = item | strip

                if item_clean == blank
                  continue
                endif

                assign fields = item_clean | split: '|'

                assign image_url = fields[0] | strip
                assign title = fields[1] | default: '' | strip
                assign project_url = fields[2] | default: '' | strip

                if title == blank
                  assign title = 'Selected work'
                endif
              -%}

              {% if project_url != blank %}

                <a
                  class="csm-{{ ai_gen_id }}__card"
                  href="{{ project_url }}"
                  aria-label="View case study: {{ title | escape }}"
                  {% if copy_index == 2 %}
                    tabindex="-1"
                  {% endif %}
                >

                  <span class="csm-{{ ai_gen_id }}__media">

                    <img
                      src="{{ image_url | escape }}"
                      alt=""
                      loading="lazy"
                      decoding="async"
                      draggable="false"
                      width="840"
                      height="540"
                    >

                    <span class="csm-{{ ai_gen_id }}__shade"></span>
                    <span class="csm-{{ ai_gen_id }}__frame"></span>

                    {% if block.settings.show_titles %}
                      <span class="csm-{{ ai_gen_id }}__card-copy">

                        <span class="csm-{{ ai_gen_id }}__project-label">
                          Case study
                        </span>

                        <strong>
                          {{ title | escape }}
                        </strong>

                        <span class="csm-{{ ai_gen_id }}__view-project">
                          View project

                          <svg
                            viewBox="0 0 24 24"
                            width="15"
                            height="15"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.7"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <path d="M5 12h14"/>
                            <path d="m13 6 6 6-6 6"/>
                          </svg>
                        </span>

                      </span>
                    {% endif %}

                  </span>

                </a>

              {% else %}

                <div class="csm-{{ ai_gen_id }}__card">

                  <span class="csm-{{ ai_gen_id }}__media">

                    <img
                      src="{{ image_url | escape }}"
                      alt=""
                      loading="lazy"
                      decoding="async"
                      draggable="false"
                      width="840"
                      height="540"
                    >

                    <span class="csm-{{ ai_gen_id }}__shade"></span>
                    <span class="csm-{{ ai_gen_id }}__frame"></span>

                    {% if block.settings.show_titles %}
                      <span class="csm-{{ ai_gen_id }}__card-copy">

                        <span class="csm-{{ ai_gen_id }}__project-label">
                          Case study
                        </span>

                        <strong>
                          {{ title | escape }}
                        </strong>

                      </span>
                    {% endif %}

                  </span>

                </div>

              {% endif %}

            {% endfor %}

          </div>

        {% endfor %}

      </div>

    </div>

  </div>


  {% if block.settings.show_footer %}

    <footer class="csm-{{ ai_gen_id }}__footer">

      <div class="csm-{{ ai_gen_id }}__footer-meta">
        <span>Scroll to explore</span>
        <span>Two directions / one body of work</span>
      </div>

      {% if block.settings.archive_url != blank %}

        <a href="{{ block.settings.archive_url }}">
          {{ block.settings.archive_label | escape }}

          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"/>
            <path d="m13 6 6 6-6 6"/>
          </svg>
        </a>

      {% endif %}

    </footer>

  {% endif %}

</case-study-marquee-{{ ai_gen_id }}>


{% style %}

#{{ root_id }} {
  display:block;
  position:relative;

  width:100%;
  max-width:100%;

  padding-top:var(--csm-top);
  padding-bottom:var(--csm-bottom);

  overflow:hidden;

  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(255,255,255,.035),
      transparent 32%
    ),
    var(--csm-bg);

  color:var(--csm-text);

  font-family:
    'Kanit',
    var(--font-body-family, Arial, sans-serif);

  isolation:isolate;
}

#{{ root_id }} *,
#{{ root_id }} *::before,
#{{ root_id }} *::after {
  box-sizing:border-box;
  min-width:0;
}

#{{ root_id }} a {
  color:inherit;
  text-decoration:none;
}

#{{ root_id }} img {
  display:block;
  max-width:100%;
  user-select:none;
  -webkit-user-drag:none;
}

#{{ root_id }} :where(h2,p) {
  margin:0;
}

#{{ root_id }} a:focus-visible {
  outline:2px solid var(--csm-accent);
  outline-offset:4px;
}


/* INTRO */

#{{ root_id }} .csm-{{ ai_gen_id }}__intro {
  position:relative;
  z-index:4;

  width:100%;
  max-width:var(--csm-max);

  margin:
    0 auto
    clamp(42px,5vw,70px);

  padding-inline:
    clamp(20px,4vw,52px);
}

#{{ root_id }} .csm-{{ ai_gen_id }}__intro-inner {
  display:grid;

  grid-template-columns:
    minmax(0,1fr)
    minmax(300px,.75fr);

  align-items:end;

  gap:clamp(32px,5vw,80px);
}

#{{ root_id }} .csm-{{ ai_gen_id }}__eyebrow {
  display:flex;
  align-items:center;

  gap:10px;

  margin-bottom:17px;

  color:var(--csm-muted);

  font-size:10px;
  font-weight:500;

  line-height:1.4;

  letter-spacing:.18em;
  text-transform:uppercase;
}

#{{ root_id }} .csm-{{ ai_gen_id }}__eyebrow span {
  width:6px;
  height:6px;

  border-radius:50%;

  background:var(--csm-accent);
}

#{{ root_id }} .csm-{{ ai_gen_id }}__heading {
  max-width:12ch;

  color:var(--csm-text);

  font-family:
    'Kanit',
    var(--font-heading-family, Arial, sans-serif);

  font-size:
    clamp(
      44px,
      6vw,
      88px
    );

  font-weight:400;

  line-height:.92;

  letter-spacing:-.045em;

  text-wrap:balance;
}

#{{ root_id }} .csm-{{ ai_gen_id }}__intro-aside {
  display:grid;

  grid-template-columns:
    minmax(0,1fr)
    auto;

  align-items:end;

  gap:30px;
}

#{{ root_id }} .csm-{{ ai_gen_id }}__description {
  max-width:510px;

  color:var(--csm-muted);

  font-size:14px;

  font-weight:300;

  line-height:1.75;
}

#{{ root_id }} .csm-{{ ai_gen_id }}__description p + p {
  margin-top:12px;
}

#{{ root_id }} .csm-{{ ai_gen_id }}__count {
  display:flex;

  flex-direction:column;

  align-items:flex-end;

  flex:none;
}

#{{ root_id }} .csm-{{ ai_gen_id }}__count strong {
  color:var(--csm-text);

  font-size:34px;

  font-weight:400;

  line-height:1;

  font-variant-numeric:
    tabular-nums;
}

#{{ root_id }} .csm-{{ ai_gen_id }}__count span {
  margin-top:7px;

  color:var(--csm-muted);

  font-size:9px;

  letter-spacing:.13em;

  text-transform:uppercase;
}

#{{ root_id }} .csm-{{ ai_gen_id }}__intro-rule {
  height:1px;

  margin-top:28px;

  background:var(--csm-line);
}

#{{ root_id }} .csm-{{ ai_gen_id }}__intro-rule span {
  display:block;

  width:58px;
  height:1px;

  background:var(--csm-accent);
}


/* MARQUEE */

#{{ root_id }} .csm-{{ ai_gen_id }}__canvas {
  position:relative;

  width:100%;

  overflow:hidden;
}

#{{ root_id }} .csm-{{ ai_gen_id }}__row-viewport {
  width:100%;
  overflow:hidden;
}

#{{ root_id }} .csm-{{ ai_gen_id }}__row-viewport + .csm-{{ ai_gen_id }}__row-viewport {
  margin-top:var(--csm-gap);
}

#{{ root_id }} .csm-{{ ai_gen_id }}__track {
  display:flex;

  width:max-content;

  gap:var(--csm-gap);

  will-change:transform;

  transform:translate3d(0,0,0);

  backface-visibility:hidden;
}

#{{ root_id }} .csm-{{ ai_gen_id }}__group {
  display:flex;

  flex:none;

  gap:var(--csm-gap);

  width:max-content;
}


/* CARDS */

#{{ root_id }} .csm-{{ ai_gen_id }}__card {
  display:block;

  flex:
    0 0
    var(--csm-card-width);

  width:
    var(--csm-card-width);

  aspect-ratio:14 / 9;

  overflow:hidden;

  border-radius:var(--csm-radius);

  background:var(--csm-card-bg);

  box-shadow:
    0 22px 70px
    rgba(0,0,0,.25);

  transform:translateZ(0);
}

#{{ root_id }} .csm-{{ ai_gen_id }}__media {
  display:block;

  position:relative;

  width:100%;
  height:100%;

  overflow:hidden;

  border-radius:inherit;

  background:#111;
}

#{{ root_id }} .csm-{{ ai_gen_id }}__media img {
  position:absolute;

  inset:0;

  width:100%;
  height:100%;

  object-fit:cover;

  transform:scale(1.01);

  transition:
    transform .8s
    cubic-bezier(.2,.7,.2,1),
    filter .6s ease;
}

#{{ root_id }} .csm-{{ ai_gen_id }}__shade {
  position:absolute;

  inset:0;

  z-index:2;

  background:
    linear-gradient(
      to top,
      rgba(0,0,0,.68),
      rgba(0,0,0,.04) 58%
    );

  opacity:.54;

  pointer-events:none;

  transition:opacity .45s ease;
}

#{{ root_id }} .csm-{{ ai_gen_id }}__frame {
  position:absolute;

  inset:9px;

  z-index:3;

  border:
    1px solid
    rgba(255,255,255,.11);

  border-radius:
    max(
      4px,
      calc(
        var(--csm-radius) - 7px
      )
    );

  pointer-events:none;

  transition:
    inset .35s ease,
    border-color .35s ease;
}


/* COPY */

#{{ root_id }} .csm-{{ ai_gen_id }}__card-copy {
  position:absolute;

  left:22px;
  right:22px;
  bottom:19px;

  z-index:4;

  display:grid;

  grid-template-columns:
    minmax(0,1fr)
    auto;

  align-items:end;

  gap:18px;

  color:#fff;

  pointer-events:none;
}

#{{ root_id }} .csm-{{ ai_gen_id }}__project-label {
  grid-column:1 / -1;

  margin-bottom:-7px;

  color:
    rgba(255,255,255,.58);

  font-size:8px;

  font-weight:500;

  letter-spacing:.16em;

  text-transform:uppercase;
}

#{{ root_id }} .csm-{{ ai_gen_id }}__card-copy strong {
  max-width:22ch;

  color:#fff;

  font-size:17px;

  font-weight:500;

  line-height:1.15;

  letter-spacing:-.015em;
}

#{{ root_id }} .csm-{{ ai_gen_id }}__view-project {
  display:flex;

  align-items:center;

  gap:7px;

  color:
    rgba(255,255,255,.74);

  font-size:9px;

  font-weight:500;

  letter-spacing:.09em;

  text-transform:uppercase;

  opacity:0;

  transform:
    translateY(6px);

  transition:
    opacity .3s ease,
    transform .3s ease;
}


/* HOVER */

@media (hover:hover) and (pointer:fine) {

  #{{ root_id }} .csm-{{ ai_gen_id }}__card:hover img {
    transform:
      scale(1.04)
      translateY(-2px);
  }

  #{{ root_id }} .csm-{{ ai_gen_id }}__card:hover .csm-{{ ai_gen_id }}__shade {
    opacity:.8;
  }

  #{{ root_id }} .csm-{{ ai_gen_id }}__card:hover .csm-{{ ai_gen_id }}__frame {
    inset:6px;

    border-color:
      rgba(255,255,255,.23);
  }

  #{{ root_id }} .csm-{{ ai_gen_id }}__card:hover .csm-{{ ai_gen_id }}__view-project {
    opacity:1;

    transform:
      translateY(0);
  }

}


/* EDGE FADES */

#{{ root_id }} .csm-{{ ai_gen_id }}__edge {
  position:absolute;

  top:0;
  bottom:0;

  z-index:8;

  width:
    clamp(
      28px,
      5vw,
      100px
    );

  pointer-events:none;
}

#{{ root_id }} .csm-{{ ai_gen_id }}__edge--left {
  left:0;

  background:
    linear-gradient(
      to right,
      var(--csm-bg),
      rgba(12,12,12,.7) 44%,
      transparent
    );
}

#{{ root_id }} .csm-{{ ai_gen_id }}__edge--right {
  right:0;

  background:
    linear-gradient(
      to left,
      var(--csm-bg),
      rgba(12,12,12,.7) 44%,
      transparent
    );
}


/* FOOTER */

#{{ root_id }} .csm-{{ ai_gen_id }}__footer {
  display:flex;

  align-items:center;
  justify-content:space-between;

  gap:24px;

  width:100%;
  max-width:var(--csm-max);

  margin:
    clamp(34px,4vw,55px)
    auto 0;

  padding:
    20px
    clamp(20px,4vw,52px)
    0;

  border-top:
    1px solid
    var(--csm-line);
}

#{{ root_id }} .csm-{{ ai_gen_id }}__footer-meta {
  display:flex;

  gap:18px;

  color:var(--csm-muted);

  font-size:9px;

  letter-spacing:.11em;

  text-transform:uppercase;
}

#{{ root_id }} .csm-{{ ai_gen_id }}__footer a {
  display:inline-flex;

  align-items:center;

  gap:10px;

  min-height:44px;

  color:var(--csm-text);

  font-size:10px;

  font-weight:500;

  letter-spacing:.08em;

  text-transform:uppercase;
}


/* TABLET */

@media(max-width:989px) {

  #{{ root_id }} .csm-{{ ai_gen_id }}__intro-inner {
    grid-template-columns:1fr;

    gap:28px;
  }

  #{{ root_id }} .csm-{{ ai_gen_id }}__intro-aside {
    max-width:700px;
  }

}


/* MOBILE */

@media(max-width:749px) {

  #{{ root_id }} {
    padding-top:
      var(--csm-mobile-top);

    padding-bottom:
      var(--csm-mobile-bottom);
  }

  #{{ root_id }} .csm-{{ ai_gen_id }}__intro {
    margin-bottom:32px;

    padding-inline:18px;
  }

  #{{ root_id }} .csm-{{ ai_gen_id }}__eyebrow {
    margin-bottom:13px;

    font-size:9px;
  }

