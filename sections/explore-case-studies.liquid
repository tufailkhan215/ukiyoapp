{% endstyle %}


<script>
(function() {
  'use strict';

  const root =
    document.getElementById(
      '{{ root_id }}'
    );

  if (
    !root ||
    root.dataset.initialized === 'true'
  ) {
    return;
  }

  root.dataset.initialized = 'true';


  const rowOne =
    root.querySelector(
      '[data-track="one"]'
    );

  const rowTwo =
    root.querySelector(
      '[data-track="two"]'
    );

  const groupOne =
    root.querySelector(
      '[data-group="one"]'
    );

  const groupTwo =
    root.querySelector(
      '[data-group="two"]'
    );


  if (
    !rowOne ||
    !rowTwo ||
    !groupOne ||
    !groupTwo
  ) {
    return;
  }


  const reducedMotion =
    window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

  const mobile =
    window.matchMedia(
      '(max-width: 749px)'
    );


  let sectionTop = 0;

  let spanOne = 1;
  let spanTwo = 1;

  let visible = true;

  let animationFrame = 0;

  let resizeFrame = 0;

  let destroyed = false;


  function numberFromData(
    key,
    fallback
  ) {

    const value =
      Number(
        root.dataset[key]
      );

    return Number.isFinite(value)
      ? value
      : fallback;

  }


  function getGap(track) {

    const styles =
      window.getComputedStyle(
        track
      );

    const value =
      parseFloat(
        styles.columnGap ||
        styles.gap ||
        '0'
      );

    return Number.isFinite(value)
      ? value
      : 0;

  }


  function positiveModulo(
    value,
    divisor
  ) {

    if (
      !divisor ||
      divisor <= 0
    ) {
      return 0;
    }

    return (
      (
        value %
        divisor
      ) +
      divisor
    ) % divisor;

  }


  function measure() {

    if (destroyed) {
      return;
    }

    const rect =
      root.getBoundingClientRect();

    sectionTop =
      rect.top +
      window.scrollY;


    spanOne =
      groupOne.getBoundingClientRect()
        .width +
      getGap(rowOne);


    spanTwo =
      groupTwo.getBoundingClientRect()
        .width +
      getGap(rowTwo);


    spanOne =
      Math.max(
        spanOne,
        1
      );

    spanTwo =
      Math.max(
        spanTwo,
        1
      );


    update();

  }


  function update() {

    animationFrame = 0;

    if (
      destroyed ||
      !visible
    ) {
      return;
    }


    const initialOffset =
      numberFromData(
        'initialOffset',
        200
      );


    if (
      reducedMotion.matches ||
      root.dataset.motion === 'false'
    ) {

      rowOne.style.transform =
        'translate3d(' +
        (-spanOne - 80) +
        'px,0,0)';


      rowTwo.style.transform =
        'translate3d(' +
        (-spanTwo + 80) +
        'px,0,0)';


      return;
    }


    const speedOne =
      mobile.matches
        ? numberFromData(
            'mobileSpeedOne',
            0.15
          )
        : numberFromData(
            'desktopSpeedOne',
            0.30
          );


    const speedTwo =
      mobile.matches
        ? numberFromData(
            'mobileSpeedTwo',
            0.12
          )
        : numberFromData(
            'desktopSpeedTwo',
            0.24
          );


    const scrolled =
      window.scrollY -
      sectionTop +
      window.innerHeight;


    const positiveScroll =
      Math.max(
        0,
        scrolled
      );


    const distanceOne =
      positiveScroll *
      speedOne;


    const distanceTwo =
      positiveScroll *
      speedTwo;


    const travelOne =
      positiveModulo(
        distanceOne,
        spanOne
      );


    const travelTwo =
      positiveModulo(
        distanceTwo,
        spanTwo
      );


    /*
      Track one moves toward the right.
      Track two moves toward the left.
      Both remain within duplicated
      content spans for a continuous look.
    */

    const xOne =
      -spanOne -
      initialOffset +
      travelOne;


    const xTwo =
      -initialOffset -
      travelTwo;


    rowOne.style.transform =
      'translate3d(' +
      xOne +
      'px,0,0)';


    rowTwo.style.transform =
      'translate3d(' +
      xTwo +
      'px,0,0)';

  }


  function requestUpdate() {

    if (
      animationFrame ||
      destroyed
    ) {
      return;
    }

    animationFrame =
      window.requestAnimationFrame(
        update
      );

  }


  function requestMeasure() {

    if (
      resizeFrame ||
      destroyed
    ) {
      return;
    }

    resizeFrame =
      window.requestAnimationFrame(
        function() {

          resizeFrame = 0;

          measure();

        }
      );

  }


  window.addEventListener(
    'scroll',
    requestUpdate,
    {
      passive:true
    }
  );


  window.addEventListener(
    'resize',
    requestMeasure,
    {
      passive:true
    }
  );


  let observer = null;


  if (
    'IntersectionObserver' in window
  ) {

    observer =
      new IntersectionObserver(
        function(entries) {

          entries.forEach(
            function(entry) {

              visible =
                entry.isIntersecting;

              if (visible) {
                requestUpdate();
              }

            }
          );

        },
        {
          root:null,
          rootMargin:'400px 0px',
          threshold:0
        }
      );


    observer.observe(root);

  }


  let resizeObserver = null;


  if (
    'ResizeObserver' in window
  ) {

    resizeObserver =
      new ResizeObserver(
        function() {
          requestMeasure();
        }
      );


    resizeObserver.observe(
      root
    );

  }


  function handleMotionChange() {
    requestMeasure();
  }


  if (
    reducedMotion.addEventListener
  ) {

    reducedMotion.addEventListener(
      'change',
      handleMotionChange
    );

    mobile.addEventListener(
      'change',
      handleMotionChange
    );

  } else {

    reducedMotion.addListener(
      handleMotionChange
    );

    mobile.addListener(
      handleMotionChange
    );

  }


  function destroy() {

    if (destroyed) {
      return;
    }

    destroyed = true;


    window.removeEventListener(
      'scroll',
      requestUpdate
    );


    window.removeEventListener(
      'resize',
      requestMeasure
    );


    if (
      reducedMotion.removeEventListener
    ) {

      reducedMotion.removeEventListener(
        'change',
        handleMotionChange
      );

      mobile.removeEventListener(
        'change',
        handleMotionChange
      );

    } else {

      reducedMotion.removeListener(
        handleMotionChange
      );

      mobile.removeListener(
        handleMotionChange
      );

    }


    if (observer) {
      observer.disconnect();
    }


    if (resizeObserver) {
      resizeObserver.disconnect();
    }


    if (animationFrame) {

      window.cancelAnimationFrame(
        animationFrame
      );

    }


    if (resizeFrame) {

      window.cancelAnimationFrame(
        resizeFrame
      );

    }

  }


  document.addEventListener(
    'shopify:block:unload',
    function handleBlockUnload(event) {

      if (
        event.target === root ||
        root.contains(event.target) ||
        event.target.contains(root)
      ) {

        destroy();

        document.removeEventListener(
          'shopify:block:unload',
          handleBlockUnload
        );

      }

    }
  );


  /*
    Initial layout measurement.
  */

  measure();

  window.requestAnimationFrame(
    requestMeasure
  );

})();
</script>


