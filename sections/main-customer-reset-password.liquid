{% comment %} Reset customer password (from email link). Theme styling. {% endcomment %}
<section class="relative z-10 py-16 lg:py-24" {{ section.shopify_attributes }}>
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="max-w-md mx-auto">
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-2">{{ section.settings.heading | default: 'Reset password' }}</h1>
      <p class="text-white/50 mb-8">{{ section.settings.subheading | default: 'Enter your new password below.' }}</p>

      <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/10">
        {% form 'reset_customer_password', class: 'customer-reset space-y-6' %}
          {% if form.errors %}
            <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-200 text-sm" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}
          <div>
            <label for="CustomerPassword-{{ section.id }}" class="block text-white/60 text-sm mb-2">{{ section.settings.password_label | default: 'Password' }} *</label>
            <input
              type="password"
              id="CustomerPassword-{{ section.id }}"
              name="customer[password]"
              class="w-full px-4 py-4 rounded-xl bg-white/[0.02] border border-white/10 text-white placeholder-white/30 focus:border-white/30 focus:outline-none transition-colors"
              placeholder="••••••••"
              autocomplete="new-password"
              required
              aria-required="true"
            >
          </div>
          <div>
            <label for="CustomerPasswordConfirmation-{{ section.id }}" class="block text-white/60 text-sm mb-2">{{ section.settings.password_confirm_label | default: 'Confirm password' }} *</label>
            <input
              type="password"
              id="CustomerPasswordConfirmation-{{ section.id }}"
              name="customer[password_confirmation]"
              class="w-full px-4 py-4 rounded-xl bg-white/[0.02] border border-white/10 text-white placeholder-white/30 focus:border-white/30 focus:outline-none transition-colors"
              placeholder="••••••••"
              autocomplete="new-password"
              required
              aria-required="true"
            >
          </div>
          <button type="submit" class="w-full py-4 rounded-xl bg-white text-black font-semibold hover:bg-gray-100 transition-colors disabled:opacity-50">
            {{ section.settings.submit_label | default: 'Reset password' }}
          </button>
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer reset password",
  "tag": "section",
  "class": "section-main-customer-reset-password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reset password" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Enter your new password below." },
    { "type": "text", "id": "password_label", "label": "Password label", "default": "Password" },
    { "type": "text", "id": "password_confirm_label", "label": "Confirm password label", "default": "Confirm password" },
    { "type": "text", "id": "submit_label", "label": "Submit button", "default": "Reset password" }
  ],
  "presets": [{ "name": "Customer reset password" }]
}
{% endschema %}
