{%- comment -%}
  Save as blocks/fg-case-study.liquid.
  One reusable case study.
  Its settings are separate from the parent gallery.
{%- endcomment -%}

{%- liquid
  assign cfg = block.settings
  assign cover = cfg.image
  assign project_title = cfg.title | default: 'Case study'
  assign project_url = cfg.url
  assign image_count = 0
-%}

{%- if cfg.show != false and cover != blank -%}

  {%- capture gallery_json -%}
    [
      {%- for n in (1..6) -%}
        {%- liquid
          assign gallery_image = cover

          if n > 1
            assign image_key = 'gallery_' | append: n
            assign gallery_image = cfg[image_key]
          endif
        -%}

        {%- if gallery_image != blank -%}
          {%- if image_count > 0 -%},{%- endif -%}

          {
            "src": {{ gallery_image | image_url: width: 1800 | json }},
            "thumb": {{ gallery_image | image_url: width: 180 | json }},
            "alt": {{ gallery_image.alt | default: project_title | json }},
            "width": {{ gallery_image.width | json }},
            "height": {{ gallery_image.height | json }}
          }

          {%- assign image_count = image_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    ]
  {%- endcapture -%}

  {%- liquid
    assign fallback_url = cover | image_url: width: 2000
    assign card_url = project_url | default: fallback_url
  -%}

  <article
    class="fg-item"
    role="listitem"
    data-project
    data-key="{{ block.id }}"
    data-title="{{ project_title | escape }}"
    data-category="{{ cfg.category | strip | escape }}"
    data-description="{{ cfg.description | escape }}"
    data-url="{{ project_url | escape }}"
    data-images="{{ gallery_json | escape }}"
  >
    <a
      class="fg-card"
      href="{{ card_url | escape }}"
      data-open
      aria-label="View {{ project_title | escape }}"
    >
      <div class="fg-media">

        {{
          cover
          | image_url: width: 1200
          | image_tag:
            widths: '240,360,480,640,800,1000,1200',
            sizes: '(min-width: 1800px) 360px, (min-width: 1024px) 20vw, (min-width: 768px) 33vw, 100vw',
            loading: 'lazy',
            decoding: 'async',
            alt: '',
            class: 'fg-cover'
        }}

        <span class="fg-shade" aria-hidden="true"></span>

        {% if cfg.category != blank %}
          <span class="fg-category">
            {{ cfg.category | escape }}
          </span>
        {% endif %}

        {% if image_count > 1 %}
          <span class="fg-photo-count">
            {{ image_count }} photos
          </span>
        {% endif %}

        <span class="fg-eye" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="23"
            height="23"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
        </span>

      </div>

      <div class="fg-card-copy">

        <h3>{{ project_title | escape }}</h3>

        {% if cfg.description != blank %}
          <p>{{ cfg.description | escape }}</p>
        {% endif %}

        <span class="fg-preview-label" aria-hidden="true">
          Preview project

          <svg
            viewBox="0 0 24 24"
            width="15"
            height="15"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M7 17 17 7M7 7h10v10"/>
          </svg>
        </span>

      </div>
    </a>
  </article>

{%- endif -%}

{% schema %}
{
  "name": "Case study",
  "tag": "div",
  "class": "fg-project-block",
  "settings": [
    {
      "type": "checkbox",
      "id": "show",
      "label": "Show this case study",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Project image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Project title",
      "default": "Project name"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Case study page link",
      "info": "The preview's read-more button opens this specific link."
    },
    {
      "type": "text",
      "id": "category",
      "label": "Category",
      "info": "Matching category names share the same filter pill."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Short description"
    },
    {
      "type": "image_picker",
      "id": "gallery_2",
      "label": "Gallery image 2"
    },
    {
      "type": "image_picker",
      "id": "gallery_3",
      "label": "Gallery image 3"
    },
    {
      "type": "image_picker",
      "id": "gallery_4",
      "label": "Gallery image 4"
    },
    {
      "type": "image_picker",
      "id": "gallery_5",
      "label": "Gallery image 5"
    },
    {
      "type": "image_picker",
      "id": "gallery_6",
      "label": "Gallery image 6"
    }
  ],
  "presets": [
    {
      "name": "Case study"
    }
  ]
}
{% endschema %}