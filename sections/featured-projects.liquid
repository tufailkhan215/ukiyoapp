{% comment %} Featured projects: strap + gradient title, filter pills, grid of project cards (wide/tall/default layout), grayscale images, gradient overlay, category/client/title/description/results/CTA. {% endcomment %}
<section class="relative py-32 lg:py-40 bg-black" data-testid="featured-projects" data-section-id="{{ section.id }}">
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  <div class="max-w-[1600px] mx-auto px-6 lg:px-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-12">
      <div>
        {% if section.settings.strap != blank %}
          <span class="text-[10px] font-medium text-white/40 tracking-[0.3em] uppercase block mb-4">{{ section.settings.strap }}</span>
        {% endif %}
        {% if section.settings.title_before != blank or section.settings.title_gradient != blank %}
          <h2 class="text-4xl md:text-5xl font-bold text-white">
            {{ section.settings.title_before }}
            {% if section.settings.title_gradient != blank %}
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-gray-400 to-gray-600">{{ section.settings.title_gradient }}</span>
            {% endif %}
          </h2>
        {% endif %}
      </div>
      {% assign filter_lines = section.settings.filters_text | newline_to_br | split: '<br />' %}
      {% if filter_lines.size > 0 %}
        <div class="featured-projects-filters flex items-center gap-3 overflow-x-auto pb-2 scrollbar-hide" role="tablist">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-funnel w-4 h-4 text-white/40 flex-shrink-0" aria-hidden="true"><path d="M10 20a1 1 0 0 0 .553.895l2 1A1 1 0 0 0 14 21v-7a2 2 0 0 1 .517-1.341L21.74 4.67A1 1 0 0 0 21 3H3a1 1 0 0 0-.742 1.67l7.225 7.989A2 2 0 0 1 10 14z"/></svg>
          {% for line in filter_lines %}
            {% assign filter_label = line | strip %}
            {% if filter_label != '' %}
              <button type="button" class="featured-projects-filter px-4 py-2 rounded-full text-sm font-medium whitespace-nowrap transition-all duration-300 {% if forloop.first %}bg-white text-black{% else %}bg-white/[0.03] text-white/60 border border-white/10 hover:bg-white/[0.05]{% endif %}" data-filter="{{ filter_label | escape }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
                {{ filter_label }}
              </button>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="featured-projects-grid grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {% for block in section.blocks %}
        {% if block.type == 'project' %}
          {% assign layout = block.settings.layout | default: 'default' %}
          {% assign card_url = block.settings.url | default: '#' %}
          {% assign category_val = block.settings.category | strip | escape %}
          <a href="{{ card_url }}" class="featured-project-card group relative overflow-hidden bg-white/[0.02] border border-white/[0.05] hover:border-white/10 transition-all {% if layout == 'wide' %}md:col-span-2 aspect-[16/9]{% elsif layout == 'tall' %}aspect-[3/4] md:row-span-2{% else %}aspect-[4/3]{% endif %}" data-category="{{ category_val }}" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <img
                alt="{{ block.settings.title | default: 'Project' | escape }}"
                class="absolute inset-0 w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700"
                src="{{ block.settings.image | image_url: width: 800 }}"
                width="800"
                height="600"
                loading="lazy"
              >
            {% else %}
              <div class="absolute inset-0 bg-white/[0.05] flex items-center justify-center"><span class="text-white/20 text-sm">Image</span></div>
            {% endif %}
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent opacity-60 group-hover:opacity-80 transition-opacity"></div>
            {% if block.settings.category != blank %}
              <div class="absolute top-4 left-4 px-3 py-1 bg-white/10 backdrop-blur-sm rounded-full">
                <span class="text-xs text-white uppercase tracking-wider">{{ block.settings.category }}</span>
              </div>
            {% endif %}
            <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
              {% if block.settings.client != blank %}
                <div class="mb-2"><span class="text-sm text-white/60">{{ block.settings.client }}</span></div>
              {% endif %}
              {% if block.settings.title != blank %}
                <h3 class="text-2xl md:text-3xl font-bold text-white mb-3 leading-tight group-hover:text-gray-200 transition-colors">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="text-white/50 text-sm mb-4 line-clamp-2">{{ block.settings.description }}</p>
              {% endif %}
              {% if block.settings.results_text != blank %}
                {% assign result_lines = block.settings.results_text | newline_to_br | split: '<br />' %}
                <div class="flex flex-wrap gap-2 mb-4">
                  {% for res in result_lines %}
                    {% assign res_stripped = res | strip %}
                    {% if res_stripped != '' %}
                      <span class="px-3 py-1 bg-white/10 backdrop-blur-sm rounded-full text-xs text-white/80">{{ res_stripped }}</span>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}
              <div>
                <span class="inline-flex items-center gap-2 text-white/80 group-hover:text-white transition-colors">
                  <span class="text-sm uppercase tracking-wider">View Case Study</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 flex-shrink-0" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
                </span>
              </div>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<script>
(function() {
  var section = document.querySelector('[data-section-id="{{ section.id }}"]');
  if (!section) return;
  var filters = section.querySelectorAll('.featured-projects-filter');
  var cards = section.querySelectorAll('.featured-project-card');
  filters.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var filter = this.getAttribute('data-filter');
      filters.forEach(function(b) {
        b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
        b.classList.remove('bg-white', 'text-black');
        b.classList.add('bg-white/[0.03]', 'text-white/60', 'border', 'border-white/10');
      });
      btn.classList.add('bg-white', 'text-black');
      btn.classList.remove('bg-white/[0.03]', 'text-white/60', 'border', 'border-white/10');
      cards.forEach(function(card) {
        var cat = (card.getAttribute('data-category') || '').trim();
        var show = filter === 'All' || cat === filter;
        card.style.display = show ? '' : 'none';
      });
    });
  });
})();
</script>

{% schema %}
{
  "name": "Featured Projects",
  "tag": "section",
  "class": "section-featured-projects",
  "settings": [
    {
      "type": "text",
      "id": "strap",
      "label": "Strap (small label above title)",
      "default": "(Case Studies)"
    },
    {
      "type": "text",
      "id": "title_before",
      "label": "Title (before gradient part)",
      "default": "Featured "
    },
    {
      "type": "text",
      "id": "title_gradient",
      "label": "Title (gradient part)",
      "default": "Projects"
    },
    {
      "type": "textarea",
      "id": "filters_text",
      "label": "Filter buttons (one per line, first = All)",
      "default": "All\nBranding\nAI & Automation\nWeb Development\nContent Production\nCase Studies"
    }
  ],
  "blocks": [
    {
      "type": "project",
      "name": "Project",
      "settings": [
        {
          "type": "select",
          "id": "layout",
          "label": "Card layout",
          "options": [
            { "value": "default", "label": "Default (4:3)" },
            { "value": "wide", "label": "Wide (2 cols, 16:9)" },
            { "value": "tall", "label": "Tall (2 rows, 3:4)" }
          ],
          "default": "default"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category (for filter)"
        },
        {
          "type": "text",
          "id": "client",
          "label": "Client name"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short description"
        },
        {
          "type": "textarea",
          "id": "results_text",
          "label": "Result tags (one per line)"
        },
        {
          "type": "text",
          "id": "url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Projects",
      "settings": {
        "strap": "(Case Studies)",
        "title_before": "Featured ",
        "title_gradient": "Projects",
        "filters_text": "All\nBranding\nAI & Automation\nWeb Development\nContent Production\nCase Studies"
      },
      "blocks": [
        { "type": "project", "settings": { "layout": "wide", "category": "AI & Automation", "client": "TechVenture AI", "title": "Revolutionizing Customer Experience with AI", "description": "Complete brand transformation and AI automation implementation that increased customer engagement by 340%.", "results_text": "340% engagement\n$2.4M revenue\n85% automation", "url": "/work/techventure-ai-transformation" } },
        { "type": "project", "settings": { "layout": "default", "category": "Branding", "client": "Luxe Lifestyle", "title": "Building a Premium Brand Identity", "description": "End-to-end branding and content strategy that positioned a startup as a market leader.", "results_text": "500K+ followers\nFeatured in Vogue\n12x ROI", "url": "/work/luxe-lifestyle-brand" } },
        { "type": "project", "settings": { "layout": "tall", "category": "Case Studies", "client": "GreenTech Solutions", "title": "Sustainable Growth Through Digital", "description": "Comprehensive digital transformation combining automation, content, and lead generation.", "results_text": "200% leads\nCarbon neutral\nAward-winning", "url": "/work/greentech-digital-innovation" } },
        { "type": "project", "settings": { "layout": "default", "category": "Branding", "client": "Urban Eats", "title": "From Local to National Recognition", "description": "Strategic branding and social media management that expanded a local restaurant chain nationwide.", "results_text": "50 locations\n1M+ followers\nPress coverage", "url": "/work/urban-eats-expansion" } },
        { "type": "project", "settings": { "layout": "wide", "category": "Web Development", "client": "Fintech Pro", "title": "High-Converting Financial Platform", "description": "Custom web application with AI-driven analytics that tripled lead conversion rates.", "results_text": "3x conversion\n<1.5s load\n99.9% uptime", "url": "/work/fintech-pro-website" } },
        { "type": "project", "settings": { "layout": "default", "category": "Content Production", "client": "Wandrd", "title": "Adventure Content at Scale", "description": "Multi-platform content strategy that captured the spirit of adventure travel.", "results_text": "2M+ views\n45% engagement\nGlobal reach", "url": "/work/wandrd-content-campaign" } },
        { "type": "project", "settings": { "layout": "default", "category": "Branding", "client": "Polaroid", "title": "Nostalgia Meets Modern", "description": "Brand activation campaign that bridged classic Polaroid aesthetics with contemporary audiences.", "results_text": "Viral campaign\nGen-Z reach\nBrand refresh", "url": "/work/polaroid-brand-activation" } },
        { "type": "project", "settings": { "layout": "default", "category": "Case Studies", "client": "Adidas", "title": "Streetwear Meets Performance", "description": "Collaborative campaign merging streetwear culture with athletic performance branding.", "results_text": "Limited edition\nSold out\nCultural impact", "url": "/work/adidas-collaboration" } }
