{% comment %}
  UKIYO — Animated Transformations
  Complete section replacement.
  Existing section setting IDs and transformation blocks are preserved.
  No external libraries or Tailwind required.
{% endcomment %}

{% assign cases = section.blocks | where: 'type', 'transformation' %}

<ukiyo-transformations
  id="UkiyoTransformations-{{ section.id }}"
  class="ut"
  style="--ut-accent: {{ section.settings.accent | default: '#c4e7cc' }};"
>
  <div class="ut__ambient" aria-hidden="true"></div>

  <div class="ut__container">
    <header class="ut__header">
      {% if section.settings.strap != blank %}
        <div class="ut__eyebrow" data-ut-intro>
          <span class="ut__dot" aria-hidden="true"></span>
          {{ section.settings.strap | escape }}
        </div>
      {% endif %}

      <div class="ut__heading-layout">
        <h2 class="ut__heading" data-ut-intro>
          {{ section.settings.title_before | escape }}
          <span>{{ section.settings.title_gradient | escape }}</span>
        </h2>

        {% if section.settings.subtitle != blank %}
          <p class="ut__intro" data-ut-intro>
            {{ section.settings.subtitle | escape }}
          </p>
        {% endif %}
      </div>
    </header>

    {% if cases.size > 0 %}
      <div
        class="ut__tabs"
        aria-label="Client transformations"
        data-ut-tabs
      >
        {% for block in cases %}
          <button
            type="button"
            class="ut__tab"
            id="UT-Tab-{{ section.id }}-{{ block.id }}"
            data-ut-tab="{{ forloop.index0 }}"
            data-block-id="{{ block.id }}"
            aria-controls="UT-Panel-{{ section.id }}-{{ block.id }}"
          >
            <span class="ut__tab-number" aria-hidden="true">
              {{ forloop.index | prepend: '0' }}
            </span>
            <span>
              {{ block.settings.filter_label | default: 'Client' | escape }}
            </span>
            <span class="ut__tab-arrow" aria-hidden="true">↗</span>
          </button>
        {% endfor %}
      </div>

      <div class="ut__panels">
        {% for block in cases %}
          <article
            id="UT-Panel-{{ section.id }}-{{ block.id }}"
            class="ut__panel"
            data-ut-panel="{{ forloop.index0 }}"
            data-block-id="{{ block.id }}"
            aria-labelledby="UT-Tab-{{ section.id }}-{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            <div class="ut__case-meta" data-ut-reveal>
              <span>
                {{ block.settings.filter_label | escape }}
              </span>

              {% if block.settings.timeline != blank %}
                <span class="ut__timeline">
                  <span aria-hidden="true">◷</span>
                  {{ block.settings.timeline | escape }}
                </span>
              {% endif %}
            </div>

            <div class="ut__dashboard">
              <div class="ut__revenue" data-ut-reveal>
                <div class="ut__revenue-light" aria-hidden="true"></div>

                <div class="ut__card-top">
                  <span class="ut__micro">Monthly revenue</span>
                  <span class="ut__symbol" aria-hidden="true">↗</span>
                </div>

                <div class="ut__revenue-result">
                  <span class="ut__status ut__status--after">
                    <i aria-hidden="true"></i>
                    {{ block.settings.after_heading | default: 'AFTER UKIYO' | escape }}
                  </span>

                  <strong class="ut__revenue-value">
                    <span class="ut__sr">
                      {{ block.settings.after_revenue | escape }}
                    </span>
                    <span aria-hidden="true" data-ut-count>
                      {{ block.settings.after_revenue | escape }}
                    </span>
                  </strong>
                </div>

                <div class="ut__revenue-before">
                  <span>
                    {{ block.settings.before_heading | default: 'BEFORE UKIYO' | escape }}
                  </span>
                  <strong>
                    {{ block.settings.before_revenue | escape }}
                  </strong>
                </div>

                <div class="ut__trace" aria-hidden="true">
                  <span></span>
                </div>

                {% if block.settings.timeline != blank %}
                  <p class="ut__revenue-period">
                    {{ block.settings.timeline | escape }}
                  </p>
                {% endif %}
              </div>

              <div class="ut__metrics">
                {% assign metric_keys = 'leads,conversion,hours' | split: ',' %}
                {% assign metric_labels = 'Monthly leads,Conversion rate,Work hours' | split: ',' %}

                {% for metric in metric_keys %}
                  {% assign before_key = 'before_' | append: metric %}
                  {% assign after_key = 'after_' | append: metric %}

                  <div class="ut__metric" data-ut-reveal>
                    <div class="ut__metric-heading">
                      <span class="ut__metric-index" aria-hidden="true">
                        0{{ forloop.index }}
                      </span>
                      <h3>{{ metric_labels[forloop.index0] }}</h3>
                    </div>

                    <div class="ut__comparison">
                      <div class="ut__before">
                        <span class="ut__micro">
                          {{ block.settings.before_heading | default: 'BEFORE UKIYO' | escape }}
                        </span>
                        <strong>
                          {{ block.settings[before_key] | escape }}
                        </strong>
                      </div>

                      <span class="ut__compare-arrow" aria-hidden="true">
                        →
                      </span>

                      <div class="ut__after">
                        <span class="ut__micro">
                          {{ block.settings.after_heading | default: 'AFTER UKIYO' | escape }}
                        </span>
                        <strong>
                          <span class="ut__sr">
                            {{ block.settings[after_key] | escape }}
                          </span>
                          <span aria-hidden="true" data-ut-count>
                            {{ block.settings[after_key] | escape }}
                          </span>
                        </strong>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              </div>
            </div>

            {% if block.settings.quote != blank or block.settings.attribution != blank %}
              <figure class="ut__testimonial" data-ut-reveal>
                {% if block.settings.quote != blank %}
                  <span class="ut__quote-mark" aria-hidden="true">“</span>
                  <blockquote>
                    {{ block.settings.quote | escape }}
                  </blockquote>
                {% endif %}

                {% if block.settings.attribution != blank %}
                  <figcaption>
                    <span aria-hidden="true"></span>
                    {{ block.settings.attribution | escape }}
                  </figcaption>
                {% endif %}
              </figure>
            {% endif %}

            {% if block.settings.case_link != blank %}
              <div class="ut__case-footer">
                <a href="{{ block.settings.case_link | escape }}">
                  {{ block.settings.case_link_label | default: 'Explore the project' | escape }}
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            {% endif %}
          </article>
        {% endfor %}
      </div>

    {% elsif request.design_mode %}
      <p class="ut__empty">
        Add a Client transformation block to display your results.
      </p>
    {% endif %}
  </div>
</ukiyo-transformations>

<style>
  .ut {
    --ut-bg: #080909;
    --ut-text: #f1f0ea;
    --ut-muted: #aaaead;
    --ut-line: rgba(255, 255, 255, .13);
    display: block;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--ut-bg);
    color: var(--ut-text);
    padding: clamp(64px, 8vw, 128px) 0;
    border-top: 1px solid var(--ut-line);
    font-family: var(--font-body-family, Arial, sans-serif);
    -webkit-font-smoothing: antialiased;
  }

  .ut *,
  .ut *::before,
  .ut *::after {
    box-sizing: border-box;
  }

  .ut .ut__ambient {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse at 5% 55%,
        rgba(128, 166, 139, .07),
        transparent 50%
      ),
      radial-gradient(
        ellipse at 95% 0%,
        rgba(255, 255, 255, .035),
        transparent 45%
      );
  }

  .ut .ut__container {
    width: min(1400px, calc(100% - 96px));
    margin-inline: auto;
  }

  .ut .ut__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 26px;
    color: #b9bcb7;
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: .22em;
    text-transform: uppercase;
  }

  .ut .ut__dot {
    width: 6px;
    height: 6px;
    flex: 0 0 auto;
    background: var(--ut-accent);
    border-radius: 50%;
    box-shadow: 0 0 16px rgba(196, 231, 204, .3);
  }

  .ut .ut__heading-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    gap: 60px;
    align-items: end;
    margin-bottom: 58px;
  }

  .ut .ut__heading {
    margin: 0;
    color: var(--ut-text);
    font-family: var(--font-heading-family, Arial, sans-serif);
    font-size: clamp(42px, 6vw, 88px);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -.055em;
    text-transform: none;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .ut .ut__heading > span {
    display: block;
    color: #afb7b0;
  }

  .ut .ut__intro {
    max-width: 340px;
    margin: 0 0 5px auto;
    color: var(--ut-muted);
    font-size: clamp(15px, 1.25vw, 18px);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .ut .ut__tabs {
    display: none;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 8px;
    margin-bottom: 30px;
  }

  .ut[data-enhanced] .ut__tabs {
    display: grid;
  }

  .ut .ut__tab {
    position: relative;
    display: flex;
    align-items: center;
    gap: 13px;
    min-width: 0;
    min-height: 68px;
    padding: 18px 20px;
    border: 1px solid var(--ut-line);
    border-radius: 3px;
    background: #ffffff03;
    color: #b4b9b4;
    font: inherit;
    font-size: 13px;
    line-height: 1.4;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    transition:
      color .3s,
      background .3s,
      border-color .3s;
  }

  .ut .ut__tab::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--ut-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .45s cubic-bezier(.16, 1, .3, 1);
  }

  .ut .ut__tab[aria-selected="true"] {
    background: #ffffff08;
    border-color: #ffffff35;
    color: #f5f6ef;
  }

  .ut .ut__tab[aria-selected="true"]::after {
    transform: scaleX(1);
  }

  .ut .ut__tab-number {
    font-size: 10px;
    color: #959d95;
    font-variant-numeric: tabular-nums;
  }

  .ut .ut__tab-arrow {
    margin-left: auto;
    font-size: 19px;
    color: var(--ut-accent);
    opacity: .45;
    transition: transform .3s, opacity .3s;
  }

  .ut .ut__tab[aria-selected="true"] .ut__tab-arrow {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  .ut .ut__tab:focus-visible,
  .ut .ut__panel:focus-visible,
  .ut .ut__case-footer a:focus-visible {
    outline: 2px solid var(--ut-accent);
    outline-offset: 4px;
  }

  .ut .ut__panel[hidden] {
    display: none !important;
  }

  .ut:not([data-enhanced]) .ut__panel + .ut__panel {
    margin-top: 64px;
  }

  .ut .ut__case-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 18px;
    color: #b3bab2;
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .ut .ut__timeline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-align: right;
  }

  .ut .ut__timeline > span {
    font-size: 17px;
    color: var(--ut-accent);
  }

  .ut .ut__dashboard {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 14px;
  }

  .ut .ut__revenue {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(24px, 3vw, 44px);
    border: 1px solid #ffffff25;
    border-radius: 5px;
    background:
      linear-gradient(
        145deg,
        rgba(189, 221, 195, .07),
        rgba(255, 255, 255, .015) 60%
      );
    overflow: hidden;
    isolation: isolate;
  }

  .ut .ut__revenue-light {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: .65;
    pointer-events: none;
    background:
      radial-gradient(
        circle at var(--ut-x, 20%) var(--ut-y, 30%),
        rgba(196, 231, 204, .12),
        transparent 65%
      );
    transition: opacity .4s;
  }

  .ut .ut__card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .ut .ut__micro {
    display: block;
    font-size: 9px;
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: .13em;
    text-transform: uppercase;
    color: #b7bfb5;
  }

  .ut .ut__symbol {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid #ffffff25;
    border-radius: 50%;
    color: var(--ut-accent);
    font-size: 23px;
  }

  .ut .ut__revenue-result {
    margin-block: auto;
    padding: 44px 0;
  }

  .ut .ut__status {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 10px;
    letter-spacing: .1em;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--ut-accent);
  }

  .ut .ut__status i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
  }

  .ut .ut__revenue-value {
    display: block;
    margin-top: 18px;
    font-family: var(--font-heading-family, Arial, sans-serif);
    font-size: clamp(38px, 4.25vw, 66px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -.055em;
    font-variant-numeric: tabular-nums;
    color: #f1f5eb;
    overflow-wrap: anywhere;
  }

  .ut .ut__revenue-before {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px 20px;
    padding-top: 23px;
    border-top: 1px solid var(--ut-line);
  }

  .ut .ut__revenue-before > span {
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: .12em;
    color: #acb2a9;
  }

  .ut .ut__revenue-before strong {
    color: #c3c7bf;
    font-size: 20px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  .ut .ut__trace {
    height: 1px;
    margin-top: 24px;
    background: #ffffff10;
    overflow: hidden;
  }

  .ut .ut__trace span {
    display: block;
    width: 100%;
    height: 100%;
    background:
      linear-gradient(
        to right,
        transparent,
        var(--ut-accent),
        transparent
      );
  }

  .ut .ut__revenue-period {
    margin: 12px 0 0;
    color: #abb3a8;
    font-size: 11px;
    line-height: 1.5;
  }

  .ut .ut__metrics {
    display: grid;
    gap: 10px;
    min-width: 0;
  }

  .ut .ut__metric {
    min-width: 0;
    padding: 23px 27px;
    border: 1px solid var(--ut-line);
    border-radius: 5px;
    background: #ffffff03;
    transition: background .35s, border-color .35s;
  }

  .ut .ut__metric-heading {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .ut .ut__metric-index {
    color: #929b92;
    font-size: 9px;
    letter-spacing: .08em;
  }

  .ut .ut__metric-heading h3 {
    margin: 0;
    font-family: inherit;
    font-size: 13px;
    line-height: 1.4;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: #e3e7df;
  }

  .ut .ut__comparison {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      24px
      minmax(0, 1.2fr);
    align-items: center;
    gap: 18px;
  }

  .ut .ut__comparison strong {
    display: block;
    margin-top: 7px;
    font-size: clamp(17px, 1.65vw, 24px);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -.025em;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }

  .ut .ut__before strong {
    color: #b0b4ad;
  }

  .ut .ut__after strong,
  .ut .ut__after .ut__micro {
    color: var(--ut-accent);
  }

  .ut .ut__compare-arrow {
    align-self: center;
    color: #8e9a8c;
    font-size: 22px;
  }

  .ut .ut__testimonial {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    column-gap: 18px;
    max-width: 890px;
    margin: 42px auto 0;
    padding: 30px 0 0;
    border-top: 1px solid var(--ut-line);
  }

  .ut .ut__quote-mark {
    color: var(--ut-accent);
    font-family: Georgia, serif;
    font-size: 66px;
    line-height: 1;
  }

  .ut .ut__testimonial blockquote {
    margin: 0;
    padding: 0;
    border: 0;
    color: #dedfd6;
    font-family: var(--font-heading-family, Arial, sans-serif);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(20px, 2vw, 28px);
    letter-spacing: -.02em;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .ut .ut__testimonial figcaption {
    grid-column: 2;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 19px;
    color: #a6aea3;
    font-size: 11px;
    line-height: 1.6;
  }

  .ut .ut__testimonial figcaption > span {
    width: 20px;
    height: 1px;
    flex-shrink: 0;
    background: #83937e;
  }

  .ut .ut__case-footer {
    display: flex;
    justify-content: flex-end;
    margin-top: 30px;
  }

  .ut .ut__case-footer a {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    padding: 12px 0;
    color: #e8ede2;
    font-size: 12px;
    line-height: 1.5;
    text-decoration: none;
    border-bottom: 1px solid #ffffff50;
  }

  .ut .ut__case-footer a > span {
    color: var(--ut-accent);
    font-size: 20px;
  }

  .ut .ut__empty {
    color: var(--ut-muted);
    padding: 36px;
    border: 1px dashed var(--ut-line);
  }

  .ut .ut__sr {
    position: absolute !important;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .ut .ut__tab:hover {
      background: #ffffff0a;
      color: #ffffff;
    }

    .ut .ut__metric:hover {
      background: #ffffff07;
      border-color: #ffffff30;
    }

    .ut .ut__revenue:hover .ut__revenue-light {
      opacity: 1;
    }
  }

  @media (max-width: 1000px) {
    .ut .ut__container {
      width: calc(100% - 48px);
    }

    .ut .ut__heading-layout {
      gap: 30px;
    }

    .ut .ut__dashboard {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    }

    .ut .ut__metric {
      padding: 22px 20px;
    }

    .ut .ut__comparison {
      gap: 10px;
      grid-template-columns: minmax(0, 1fr) 18px minmax(0, 1.2fr);
    }
  }

  @media (max-width: 760px) {
    .ut .ut__heading-layout {
      grid-template-columns: 1fr;
      gap: 23px;
      margin-bottom: 36px;
    }

    .ut .ut__intro {
      margin: 0;
      max-width: 42ch;
    }

    .ut .ut__dashboard {
      grid-template-columns: 1fr;
    }

    .ut .ut__revenue-result {
      padding-block: 35px;
    }

    .ut .ut__revenue-value {
      font-size: clamp(42px, 9vw, 72px);
    }

    .ut .ut__tabs {
      display: none;
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(190px, 1fr);
      overflow-x: auto;
      padding-bottom: 8px;
      scrollbar-width: thin;
      scrollbar-color: #65725f #151715;
    }

    .ut .ut__tab {
      min-height: 62px;
      padding: 14px 16px;
    }

    .ut .ut__comparison strong {
      font-size: clamp(18px, 3.5vw, 25px);
    }
  }

  @media (max-width: 420px) {
    .ut .ut__container {
      width: calc(100% - 32px);
    }

    .ut .ut__heading {
      font-size: 40px;
    }

    .ut .ut__case-meta {
      font-size: 9px;
      letter-spacing: .07em;
      gap: 12px;
    }

    .ut .ut__metric {
      padding: 20px 16px;
    }

    .ut .ut__comparison {
      gap: 8px;
      grid-template-columns: minmax(0, 1fr) 16px minmax(0, 1.15fr);
    }

    .ut .ut__micro {
      font-size: 8px;
      letter-spacing: .08em;
    }

    .ut .ut__testimonial {
      grid-template-columns: 24px minmax(0, 1fr);
      column-gap: 10px;
    }

    .ut .ut__quote-mark {
      font-size: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ut *,
    .ut *::before,
    .ut *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>

<script>
  if (!customElements.get('ukiyo-transformations')) {
    customElements.define(
      'ukiyo-transformations',
      class extends HTMLElement {
        connectedCallback() {
          if (this.initialized) return;
          this.initialized = true;

          this.abort = new AbortController();
          this.options = { signal: this.abort.signal };

          this.motion = window.matchMedia(
            '(prefers-reduced-motion: reduce)'
          );

          this.editor = Boolean(
            window.Shopify && window.Shopify.designMode
          );

          this.tabs = [...this.querySelectorAll('[data-ut-tab]')];
          this.panels = [...this.querySelectorAll('[data-ut-panel]')];
          this.animations = [];
          this.frames = new Set();
          this.played = new Set();
          this.active = 0;
          this.visible = false;

          if (!this.panels.length) return;

          this.querySelectorAll('[data-ut-count]').forEach(element => {
            element.dataset.utFinal = element.textContent.trim();
          });

          const tablist = this.querySelector('[data-ut-tabs]');
          tablist.setAttribute('role', 'tablist');

          this.tabs.forEach((tab, index) => {
            tab.setAttribute('role', 'tab');
            tab.setAttribute('aria-selected', String(index === 0));
            tab.tabIndex = index === 0 ? 0 : -1;

            tab.addEventListener(
              'click',
              () => this.select(index),
              this.options
            );

            tab.addEventListener(
              'keydown',
              event => {
                let next = index;

                if (event.key === 'ArrowRight') {
                  next = (index + 1) % this.tabs.length;
                } else if (event.key === 'ArrowLeft') {
                  next = (index - 1 + this.tabs.length) % this.tabs.length;
                } else if (event.key === 'Home') {
                  next = 0;
                } else if (event.key === 'End') {
                  next = this.tabs.length - 1;
                } else {
                  return;
                }

                event.preventDefault();
                this.select(next);
                this.tabs[next].focus({ preventScroll: true });

                if (tablist.scrollWidth > tablist.clientWidth) {
                  tablist.scrollLeft =
                    this.tabs[next].offsetLeft - this.tabs[0].offsetLeft;
                }
              },
              this.options
            );
          });

          this.panels.forEach((panel, index) => {
            panel.setAttribute('role', 'tabpanel');
            panel.tabIndex = 0;
            panel.hidden = index !== 0;
          });

          this.setAttribute('data-enhanced', '');

          this.motion.addEventListener(
            'change',
            () => {
              if (this.motion.matches) this.stopMotion();
            },
            this.options
          );

          this.addEventListener(
            'pointermove',
            event => {
              if (
                this.motion.matches ||
                event.pointerType !== 'mouse'
              ) return;

              const card = event.target.closest('.ut__revenue');
              if (!card) return;

              const bounds = card.getBoundingClientRect();

              card.style.setProperty(
                '--ut-x',
                `${event.clientX - bounds.left}px`
              );

              card.style.setProperty(
                '--ut-y',
                `${event.clientY - bounds.top}px`
              );
            },
            this.options
          );

          document.addEventListener(
            'shopify:block:select',
            event => {
              const index = this.panels.findIndex(
                panel => panel.dataset.blockId === event.detail.blockId
              );

              if (index >= 0) this.select(index);
            },
            this.options
          );

          if ('IntersectionObserver' in window) {
            this.observer = new IntersectionObserver(
              entries => {
                if (!entries[0].isIntersecting) return;

                this.visible = true;
                this.observer.disconnect();

                if (!this.motion.matches && !this.editor) {
                  this.querySelectorAll('[data-ut-intro]')
                    .forEach((element, index) => {
                      this.reveal(element, index * 90);
                    });
                }

                this.play(this.active);
              },
              { threshold: 0.08 }
            );

            this.observer.observe(this);
          } else {
            this.visible = true;
          }
        }

        select(index) {
          if (index === this.active) return;

          this.stopMotion();
          this.active = index;

          this.tabs.forEach((tab, position) => {
            const selected = position === index;
            tab.setAttribute('aria-selected', String(selected));
            tab.tabIndex = selected ? 0 : -1;
          });

          this.panels.forEach((panel, position) => {
            panel.hidden = position !== index;
          });

          if (this.visible) this.play(index);
        }

        reveal(element, delay = 0) {
          if (!element.animate) return;

          const animation = element.animate(
            [
              { opacity: 0, transform: 'translateY(18px)' },
              { opacity: 1, transform: 'translateY(0)' }
            ],
            {
              duration: 680,
              delay,
              fill: 'backwards',
              easing: 'cubic-bezier(.16,1,.3,1)'
            }
          );

          this.animations.push(animation);
        }

        play(index) {
          if (this.motion.matches || this.editor) return;

          const panel = this.panels[index];

          panel.querySelectorAll('[data-ut-reveal]')
            .forEach((element, position) => {
              this.reveal(element, position * 65);
            });

          const trace = panel.querySelector('.ut__trace span');

          if (trace && trace.animate) {
            this.animations.push(
              trace.animate(
                [
                  { transform: 'translateX(-100%)' },
                  { transform: 'translateX(0)' }
                ],
                {
                  duration: 1300,
                  easing: 'cubic-bezier(.16,1,.3,1)'
                }
              )
            );
          }

          if (!this.played.has(index)) {
            panel.querySelectorAll('[data-ut-count]')
              .forEach(element => this.count(element));

            this.played.add(index);
          }
        }

        count(element) {
          const finalText = element.dataset.utFinal;

          /*
            Animate the first numeric value only.
            Preserve currency signs, K suffixes, units, and notes.
            Finish on the exact saved text.
          */
          const match = finalText.match(
            /^([^0-9]*)(\d[\d,]*(?:\.\d+)?)(.*)$/
          );

          if (!match) return;

          const target = Number(match[2].replace(/,/g, ''));
          if (!Number.isFinite(target)) return;

          const decimals = (match[2].split('.')[1] || '').length;
          const grouping = match[2].includes(',');
          const started = performance.now();
          const duration = 1050;

          const formatter = new Intl.NumberFormat('en-US', {
            minimumFractionDigits: decimals,
            maximumFractionDigits: decimals,
            useGrouping: grouping
          });

          const tick = now => {
            const progress = Math.min((now - started) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 4);

            element.textContent = progress === 1
              ? finalText
              : match[1] + formatter.format(target * eased) + match[3];

            if (progress < 1) {
              this.schedule(tick);
            }
          };

          this.schedule(tick);
        }

        schedule(callback) {
          const id = requestAnimationFrame(time => {
            this.frames.delete(id);
            callback(time);
          });

          this.frames.add(id);
        }

        stopMotion() {
          this.animations.forEach(animation => animation.cancel());
          this.animations = [];

          this.frames.forEach(id => cancelAnimationFrame(id));
          this.frames.clear();

          this.querySelectorAll('[data-ut-count]').forEach(element => {
            element.textContent = element.dataset.utFinal;
          });
        }

        disconnectedCallback() {
          this.abort?.abort();
          this.observer?.disconnect();

          if (this.frames) this.stopMotion();

          this.initialized = false;
        }
      }
    );
  }
</script>

