{% comment %} Source structure and Tailwind classes from reference (TransformationSection) {% endcomment %}
<section class="transformation-section relative py-28 lg:py-40 bg-black overflow-hidden" data-transformation>
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom,rgba(255,255,255,0.02),transparent_60%)]" aria-hidden="true"></div>

  <div class="relative z-10 max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="text-center mb-16">
      {% if section.settings.strap != blank %}
        <span class="text-[10px] font-medium text-white/40 tracking-[0.3em] uppercase block mb-5">{{ section.settings.strap }}</span>
      {% endif %}
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
        {{ section.settings.title_before | default: 'Real' }} <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-gray-400 to-gray-600">{{ section.settings.title_gradient | default: 'Transformations' }}</span>
      </h2>
      {% if section.settings.subtitle != blank %}
        <p class="text-lg text-white/40 max-w-2xl mx-auto">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="flex justify-center gap-4 mb-12 flex-wrap">
        {% for block in section.blocks %}
          <button type="button" class="transformation-tab px-6 py-3 rounded-full text-sm font-medium transition-all {% if forloop.first %}bg-white text-black{% else %}bg-white/[0.03] text-white/60 border border-white/10 hover:bg-white/[0.05]{% endif %}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {{ block.settings.filter_label | default: 'Client type' }}
          </button>
        {% endfor %}
      </div>

      {% for block in section.blocks %}
        <div class="transformation-content {% unless forloop.first %}hidden{% endunless %}" data-index="{{ forloop.index0 }}">
          <div class="grid lg:grid-cols-3 gap-8">
            {% comment %} BEFORE column {% endcomment %}
            <div class="p-8 border border-red-500/20 bg-red-500/[0.02]">
              <h3 class="text-red-400 font-semibold mb-6 flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-red-500" aria-hidden="true"></span>
                {{ block.settings.before_heading | default: 'BEFORE UKIYO' }}
              </h3>
              <div class="flex items-center justify-between py-3 border-b border-white/[0.05] last:border-0">
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-red-400" aria-hidden="true"><line x1="12" x2="12" y1="2" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                  <span class="text-white/50 text-sm">Monthly Revenue</span>
                </div>
                <span class="font-bold text-red-400">{{ block.settings.before_revenue | default: '$12K/mo' }}</span>
              </div>
              <div class="flex items-center justify-between py-3 border-b border-white/[0.05] last:border-0">
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-red-400" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><path d="M16 3.128a4 4 0 0 1 0 7.744"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/></svg>
                  <span class="text-white/50 text-sm">Monthly Leads</span>
                </div>
                <span class="font-bold text-red-400">{{ block.settings.before_leads | default: '50/month' }}</span>
              </div>
              <div class="flex items-center justify-between py-3 border-b border-white/[0.05] last:border-0">
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-red-400" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
                  <span class="text-white/50 text-sm">Conversion Rate</span>
                </div>
                <span class="font-bold text-red-400">{{ block.settings.before_conversion | default: '1.2%' }}</span>
              </div>
              <div class="flex items-center justify-between py-3 border-b border-white/[0.05] last:border-0">
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-red-400" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  <span class="text-white/50 text-sm">Work Hours</span>
                </div>
                <span class="font-bold text-red-400">{{ block.settings.before_hours | default: '80hrs/week manual work' }}</span>
              </div>
            </div>

            {% comment %} Middle: arrow + timeline {% endcomment %}
            <div class="hidden lg:flex items-center justify-center">
              <div class="flex flex-col items-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-arrow-right w-12 h-12 text-white/20 mb-4" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                <span class="text-white/40 text-sm">{{ block.settings.timeline | default: 'In 6 months' }}</span>
              </div>
            </div>

            {% comment %} AFTER column {% endcomment %}
            <div class="p-8 border border-green-500/20 bg-green-500/[0.02]">
              <h3 class="text-green-400 font-semibold mb-6 flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-green-500" aria-hidden="true"></span>
                {{ block.settings.after_heading | default: 'AFTER UKIYO' }}
              </h3>
              <div class="flex items-center justify-between py-3 border-b border-white/[0.05] last:border-0">
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-green-400" aria-hidden="true"><line x1="12" x2="12" y1="2" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                  <span class="text-white/50 text-sm">Monthly Revenue</span>
                </div>
                <span class="font-bold text-green-400">{{ block.settings.after_revenue | default: '$147K/mo' }}</span>
              </div>
              <div class="flex items-center justify-between py-3 border-b border-white/[0.05] last:border-0">
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-green-400" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><path d="M16 3.128a4 4 0 0 1 0 7.744"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/></svg>
                  <span class="text-white/50 text-sm">Monthly Leads</span>
                </div>
                <span class="font-bold text-green-400">{{ block.settings.after_leads | default: '2,400/month' }}</span>
              </div>
              <div class="flex items-center justify-between py-3 border-b border-white/[0.05] last:border-0">
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-green-400" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
                  <span class="text-white/50 text-sm">Conversion Rate</span>
                </div>
                <span class="font-bold text-green-400">{{ block.settings.after_conversion | default: '4.8%' }}</span>
              </div>
              <div class="flex items-center justify-between py-3 border-b border-white/[0.05] last:border-0">
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-green-400" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  <span class="text-white/50 text-sm">Work Hours</span>
                </div>
                <span class="font-bold text-green-400">{{ block.settings.after_hours | default: '10hrs/week (automated)' }}</span>
              </div>
            </div>
          </div>

          <div class="mt-12 text-center">
            {% if block.settings.quote != blank %}
              <blockquote class="text-2xl text-white/60 italic max-w-2xl mx-auto">"{{ block.settings.quote }}"</blockquote>
            {% endif %}
            {% if block.settings.attribution != blank %}
              <p class="text-white/30 mt-4">{{ block.settings.attribution }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</section>

<script>
(function() {
  var section = document.querySelector('[data-transformation]');
  if (!section) return;
  var tabs = section.querySelectorAll('.transformation-tab');
  var contents = section.querySelectorAll('.transformation-content');
  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      var index = this.getAttribute('data-index');
      tabs.forEach(function(t) {
        t.classList.remove('bg-white', 'text-black');
        t.classList.add('bg-white/[0.03]', 'text-white/60', 'border', 'border-white/10');
      });
      this.classList.remove('bg-white/[0.03]', 'text-white/60', 'border', 'border-white/10');
      this.classList.add('bg-white', 'text-black');
      contents.forEach(function(c) {
        c.classList.toggle('hidden', c.getAttribute('data-index') !== index);
      });
    });
  });
})();
</script>

