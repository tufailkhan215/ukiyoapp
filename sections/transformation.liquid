{% comment %}
  ============================================================
  UKIYO — TRANSFORMATION
  Desktop preserved exactly.
  Mobile receives a dedicated responsive treatment.
  ============================================================
{% endcomment %}

<section
  id="Transformation-{{ section.id }}"
  class="transformation-section relative py-28 lg:py-40 bg-black overflow-hidden"
  data-transformation
>

  <div
    class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"
    aria-hidden="true"
  ></div>

  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom,rgba(255,255,255,0.02),transparent_60%)]"
    aria-hidden="true"
  ></div>


  <div
    class="relative z-10 max-w-[1400px] mx-auto px-6 lg:px-12"
  >

    {% comment %}
      ============================================================
      HEADER
      ============================================================
    {% endcomment %}

    <div class="text-center mb-16 transformation-heading">

      {% if section.settings.strap != blank %}

        <span
          class="text-[10px] font-medium text-white/40 tracking-[0.3em] uppercase block mb-5 transformation-strap"
        >
          {{ section.settings.strap }}
        </span>

      {% endif %}


      <h2
        class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 transformation-title"
      >

        {{ section.settings.title_before | default: 'Real' }}

        <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-white via-gray-400 to-gray-600"
        >
          {{ section.settings.title_gradient | default: 'Transformations' }}
        </span>

      </h2>


      {% if section.settings.subtitle != blank %}

        <p
          class="text-lg text-white/40 max-w-2xl mx-auto transformation-subtitle"
        >
          {{ section.settings.subtitle }}
        </p>

      {% endif %}

    </div>



    {% if section.blocks.size > 0 %}

      {% comment %}
        ============================================================
        FILTER TABS
        ============================================================
      {% endcomment %}

      <div
        class="flex justify-center gap-4 mb-12 flex-wrap transformation-tabs"
        role="tablist"
        aria-label="Client transformation examples"
      >

        {% for block in section.blocks %}

          <button
            type="button"
            class="
              transformation-tab
              px-6
              py-3
              rounded-full
              text-sm
              font-medium
              transition-all
              {% if forloop.first %}
                bg-white text-black
              {% else %}
                bg-white/[0.03]
                text-white/60
                border
                border-white/10
                hover:bg-white/[0.05]
              {% endif %}
            "
            data-index="{{ forloop.index0 }}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="TransformationPanel-{{ section.id }}-{{ forloop.index0 }}"
            id="TransformationTab-{{ section.id }}-{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.filter_label | default: 'Client type' }}
          </button>

        {% endfor %}

      </div>



      {% comment %}
        ============================================================
        TRANSFORMATION PANELS
        ============================================================
      {% endcomment %}

      {% for block in section.blocks %}

        <div
          id="TransformationPanel-{{ section.id }}-{{ forloop.index0 }}"
          class="
            transformation-content
            {% unless forloop.first %}
              hidden
            {% endunless %}
          "
          data-index="{{ forloop.index0 }}"
          role="tabpanel"
          aria-labelledby="TransformationTab-{{ section.id }}-{{ forloop.index0 }}"
        >

          <div
            class="grid lg:grid-cols-3 gap-8 transformation-comparison"
          >

            {% comment %}
              ======================================================
              BEFORE
              ======================================================
            {% endcomment %}

            <div
              class="
                p-8
                border
                border-red-500/20
                bg-red-500/[0.02]
                transformation-card
                transformation-card--before
              "
            >

              <div class="transformation-card-header">

                <h3
                  class="text-red-400 font-semibold mb-6 flex items-center gap-2"
                >

                  <span
                    class="w-3 h-3 rounded-full bg-red-500"
                    aria-hidden="true"
                  ></span>

                  {{ block.settings.before_heading | default: 'BEFORE UKIYO' }}

                </h3>

                <span class="transformation-mobile-state">
                  Starting Point
                </span>

              </div>



              <div class="transformation-metrics">

                <div
                  class="flex items-center justify-between py-3 border-b border-white/[0.05] last:border-0 transformation-metric-row"
                >

                  <div class="flex items-center gap-3 transformation-metric-label">

                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      class="w-4 h-4 text-red-400"
                      aria-hidden="true"
                    >
                      <line x1="12" x2="12" y1="2" y2="22"/>
                      <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                    </svg>

                    <span class="text-white/50 text-sm">
                      Monthly Revenue
                    </span>

                  </div>

                  <span
                    class="font-bold text-red-400 transformation-metric-value"
                  >
                    {{ block.settings.before_revenue | default: '$12K/mo' }}
                  </span>

                </div>



                <div
                  class="flex items-center justify-between py-3 border-b border-white/[0.05] last:border-0 transformation-metric-row"
                >

                  <div class="flex items-center gap-3 transformation-metric-label">

                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      class="w-4 h-4 text-red-400"
                      aria-hidden="true"
                    >
                      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                      <path d="M16 3.128a4 4 0 0 1 0 7.744"/>
                      <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                      <circle cx="9" cy="7" r="4"/>
                    </svg>

                    <span class="text-white/50 text-sm">
                      Monthly Leads
                    </span>

                  </div>

                  <span
                    class="font-bold text-red-400 transformation-metric-value"
                  >
                    {{ block.settings.before_leads | default: '50/month' }}
                  </span>

                </div>



                <div
                  class="flex items-center justify-between py-3 border-b border-white/[0.05] last:border-0 transformation-metric-row"
                >

                  <div class="flex items-center gap-3 transformation-metric-label">

                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      class="w-4 h-4 text-red-400"
                      aria-hidden="true"
                    >
                      <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
                      <polyline points="16 7 22 7 22 13"/>
                    </svg>

                    <span class="text-white/50 text-sm">
                      Conversion Rate
                    </span>

                  </div>

                  <span
                    class="font-bold text-red-400 transformation-metric-value"
                  >
                    {{ block.settings.before_conversion | default: '1.2%' }}
                  </span>

                </div>



                <div
                  class="flex items-center justify-between py-3 border-b border-white/[0.05] last:border-0 transformation-metric-row"
                >

                  <div class="flex items-center gap-3 transformation-metric-label">

                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      class="w-4 h-4 text-red-400"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="12" r="10"/>
                      <polyline points="12 6 12 12 16 14"/>
                    </svg>

                    <span class="text-white/50 text-sm">
                      Work Hours
                    </span>

                  </div>

                  <span
                    class="font-bold text-red-400 transformation-metric-value"
                  >
                    {{ block.settings.before_hours | default: '80hrs/week manual work' }}
                  </span>

                </div>

              </div>

            </div>



            {% comment %}
              ======================================================
              DESKTOP TRANSFORMATION ARROW
              ======================================================
            {% endcomment %}

            <div
              class="hidden lg:flex items-center justify-center transformation-middle"
            >

              <div class="flex flex-col items-center">

                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="lucide lucide-arrow-right w-12 h-12 text-white/20 mb-4"
                  aria-hidden="true"
                >
                  <path d="M5 12h14"/>
                  <path d="m12 5 7 7-7 7"/>
                </svg>

                <span class="text-white/40 text-sm">
                  {{ block.settings.timeline | default: 'In 6 months' }}
                </span>

              </div>

            </div>



            {% comment %}
              ======================================================
              MOBILE TRANSFORMATION CONNECTOR
              ======================================================
            {% endcomment %}

            <div
              class="transformation-mobile-connector"
              aria-hidden="true"
            >

              <div class="transformation-mobile-connector-line"></div>

              <div class="transformation-mobile-connector-center">

                <span>
                  {{ block.settings.timeline | default: 'In 6 months' }}
                </span>

                <svg
                  viewBox="0 0 24 24"
                  width="20"
                  height="20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 5v14"/>
                  <path d="m6 13 6 6 6-6"/>
                </svg>

              </div>

              <div class="transformation-mobile-connector-line"></div>

            </div>



            {% comment %}
              ======================================================
              AFTER
              ======================================================
            {% endcomment %}

            <div
              class="
                p-8
                border
                border-green-500/20
                bg-green-500/[0.02]
                transformation-card
                transformation-card--after
              "
            >

              <div class="transformation-card-header">

                <h3
                  class="text-green-400 font-semibold mb-6 flex items-center gap-2"
                >

                  <span
                    class="w-3 h-3 rounded-full bg-green-500"
                    aria-hidden="true"
                  ></span>

                  {{ block.settings.after_heading | default: 'AFTER UKIYO' }}

                </h3>

                <span class="transformation-mobile-state transformation-mobile-state--after">
                  Outcome
                </span>

              </div>



              <div class="transformation-metrics">

                <div
                  class="flex items-center justify-between py-3 border-b border-white/[0.05] last:border-0 transformation-metric-row"
                >

                  <div class="flex items-center gap-3 transformation-metric-label">

                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      class="w-4 h-4 text-green-400"
                      aria-hidden="true"
                    >
                      <line x1="12" x2="12" y1="2" y2="22"/>
                      <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                    </svg>

                    <span class="text-white/50 text-sm">
                      Monthly Revenue
                    </span>

                  </div>

                  <span
                    class="font-bold text-green-400 transformation-metric-value"
                  >
                    {{ block.settings.after_revenue | default: '$147K/mo' }}
                  </span>

                </div>



                <div
                  class="flex items-center justify-between py-3 border-b border-white/[0.05] last:border-0 transformation-metric-row"
                >

                  <div class="flex items-center gap-3 transformation-metric-label">

                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      class="w-4 h-4 text-green-400"
                      aria-hidden="true"
                    >
                      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                      <path d="M16 3.128a4 4 0 0 1 0 7.744"/>
                      <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                      <circle cx="9" cy="7" r="4"/>
                    </svg>

                    <span class="text-white/50 text-sm">
                      Monthly Leads
                    </span>

                  </div>

                  <span
                    class="font-bold text-green-400 transformation-metric-value"
                  >
                    {{ block.settings.after_leads | default: '2,400/month' }}
                  </span>

                </div>



                <div
                  class="flex items-center justify-between py-3 border-b border-white/[0.05] last:border-0 transformation-metric-row"
                >

                  <div class="flex items-center gap-3 transformation-metric-label">

                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      class="w-4 h-4 text-green-400"
                      aria-hidden="true"
                    >
                      <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
                      <polyline points="16 7 22 7 22 13"/>
                    </svg>

                    <span class="text-white/50 text-sm">
                      Conversion Rate
                    </span>

                  </div>

                  <span
                    class="font-bold text-green-400 transformation-metric-value"
                  >
                    {{ block.settings.after_conversion | default: '4.8%' }}
                  </span>

                </div>



                <div
                  class="flex items-center justify-between py-3 border-b border-white/[0.05] last:border-0 transformation-metric-row"
                >

                  <div class="flex items-center gap-3 transformation-metric-label">

                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      class="w-4 h-4 text-green-400"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="12" r="10"/>
                      <polyline points="12 6 12 12 16 14"/>
                    </svg>

                    <span class="text-white/50 text-sm">
                      Work Hours
                    </span>

                  </div>

                  <span
                    class="font-bold text-green-400 transformation-metric-value"
                  >
                    {{ block.settings.after_hours | default: '10hrs/week (automated)' }}
                  </span>

                </div>

              </div>

            </div>

          </div>



          {% comment %}
            ========================================================
            TESTIMONIAL
            ========================================================
          {% endcomment %}

          <div
            class="mt-12 text-center transformation-testimonial"
          >

            {% if block.settings.quote != blank %}

              <blockquote
                class="text-2xl text-white/60 italic max-w-2xl mx-auto"
              >
                “{{ block.settings.quote }}”
              </blockquote>

            {% endif %}


            {% if block.settings.attribution != blank %}

              <p
                class="text-white/30 mt-4 transformation-attribution"
              >
                {{ block.settings.attribution }}
              </p>

            {% endif %}

          </div>

        </div>

      {% endfor %}

    {% endif %}

  </div>

</section>



{% style %}

/* ============================================================
   DESKTOP
   No existing desktop styling is changed.
   Everything below is mobile-only unless otherwise specified.
   ============================================================ */

#Transformation-{{ section.id }}
.transformation-mobile-connector {
  display: none;
}


#Transformation-{{ section.id }}
.transformation-mobile-state {
  display: none;
}



/* ============================================================
   MOBILE
   ============================================================ */

@media screen and (max-width: 749px) {

  /*
    Section spacing:
    desktop Tailwind padding stays untouched.
    Only override the mobile presentation.
  */

  #Transformation-{{ section.id }} {
    padding-top: 72px !important;
    padding-bottom: 80px !important;
  }


  #Transformation-{{ section.id }}
  > div.relative.z-10 {
    padding-left: 16px !important;
    padding-right: 16px !important;
  }


  /* ============================================================
     HEADER
     ============================================================ */

  #Transformation-{{ section.id }}
  .transformation-heading {
    margin-bottom: 36px !important;

    text-align: left !important;
  }


  #Transformation-{{ section.id }}
  .transformation-strap {
    margin-bottom: 14px !important;

    font-size: 8px !important;
    letter-spacing: .22em !important;
  }


  #Transformation-{{ section.id }}
  .transformation-title {
    max-width: 9ch;

    margin-bottom: 16px !important;

    font-size:
      clamp(
        40px,
        12vw,
        58px
      ) !important;

    line-height: .94 !important;
    letter-spacing: -.045em !important;

    text-align: left !important;
  }


  #Transformation-{{ section.id }}
  .transformation-title > span {
    display: block;
  }


  #Transformation-{{ section.id }}
  .transformation-subtitle {
    max-width: 34ch !important;

    margin-left: 0 !important;
    margin-right: 0 !important;

    font-size: 14px !important;
    line-height: 1.55 !important;

    text-align: left !important;
  }



  /* ============================================================
     HORIZONTAL TAB RAIL
     ============================================================ */

  #Transformation-{{ section.id }}
  .transformation-tabs {
    width:
      calc(
        100% +
        16px
      );

    margin:
      0
      -16px
      32px
      0 !important;

    padding:
      0
      16px
      3px
      0;

    display: flex !important;
    flex-wrap: nowrap !important;
    justify-content: flex-start !important;

    gap: 8px !important;

    overflow-x: auto;
    overflow-y: hidden;

    scroll-snap-type: x proximity;
    scroll-padding-left: 0;

    scrollbar-width: none;

    -webkit-overflow-scrolling: touch;
  }


  #Transformation-{{ section.id }}
  .transformation-tabs::-webkit-scrollbar {
    display: none;
  }


  #Transformation-{{ section.id }}
  .transformation-tab {
    min-height: 44px;

    padding:
      0
      17px !important;

    flex:
      0
      0
      auto;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    scroll-snap-align: start;

    font-size: 11px !important;
    line-height: 1 !important;

    white-space: nowrap;
  }



  /* ============================================================
     TRANSFORMATION CONTENT
     ============================================================ */

  #Transformation-{{ section.id }}
  .transformation-content {
    animation:
      transformation-mobile-in-{{ section.id }}
      .45s
      cubic-bezier(.16,1,.3,1);
  }


  @keyframes transformation-mobile-in-{{ section.id }} {

    from {
      opacity: 0;

      transform:
        translateY(12px);
    }

    to {
      opacity: 1;

      transform:
        translateY(0);
    }

  }


  #Transformation-{{ section.id }}
  .transformation-comparison {
    display: block !important;
  }



  /* ============================================================
     BEFORE / AFTER CARDS
     ============================================================ */

  #Transformation-{{ section.id }}
  .transformation-card {
    position: relative;

    padding:
      20px
      16px
      14px !important;

    overflow: hidden;

    border-radius: 16px;

    background:
      rgba(
        255,
        255,
        255,
        .025
      ) !important;
  }


  #Transformation-{{ section.id }}
  .transformation-card::before {
    content: '';

    position: absolute;
    top: 0;
    right: 0;
    left: 0;

    height: 2px;
  }


  #Transformation-{{ section.id }}
  .transformation-card--before::before {
    background:
      linear-gradient(
        90deg,
        rgba(239,68,68,.75),
        transparent 72%
      );
  }


  #Transformation-{{ section.id }}
  .transformation-card--after::before {
    background:
      linear-gradient(
        90deg,
        rgba(74,222,128,.78),
        transparent 72%
      );
  }


  #Transformation-{{ section.id }}
  .transformation-card-header {
    margin-bottom: 11px;

    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    gap: 16px;
  }


  #Transformation-{{ section.id }}
  .transformation-card-header h3 {
    margin-bottom: 0 !important;

    font-size: 11px !important;
    line-height: 1.2 !important;
    letter-spacing: .09em;

    text-transform: uppercase;
  }


  #Transformation-{{ section.id }}
  .transformation-card-header h3 > span {
    width: 7px !important;
    height: 7px !important;

    flex: 0 0 auto;
  }


  #Transformation-{{ section.id }}
  .transformation-mobile-state {
    display: block;

    flex: 0 0 auto;

    color:
      rgba(
        248,
        113,
        113,
        .58
      );

    font-size: 7px;
    font-weight: 600;
    letter-spacing: .14em;

    text-transform: uppercase;
  }


  #Transformation-{{ section.id }}
  .transformation-mobile-state--after {
    color:
      rgba(
        74,
        222,
        128,
        .6
      );
  }



  /* ============================================================
     METRIC ROWS
     ============================================================ */

  #Transformation-{{ section.id }}
  .transformation-metrics {
    width: 100%;
  }


  #Transformation-{{ section.id }}
  .transformation-metric-row {
    min-height: 59px;

    padding:
      11px
      0 !important;

    align-items: center !important;

    gap: 12px;
  }


  #Transformation-{{ section.id }}
  .transformation-metric-label {
    min-width: 0;

    gap: 9px !important;

    flex:
      1
      1
      auto;
  }


  #Transformation-{{ section.id }}
  .transformation-metric-label svg {
    width: 15px !important;
    height: 15px !important;

    flex:
      0
      0
      15px;
  }


  #Transformation-{{ section.id }}
  .transformation-metric-label span {
    font-size: 11px !important;
    line-height: 1.25 !important;
  }


  #Transformation-{{ section.id }}
  .transformation-metric-value {
    max-width: 45%;

    flex:
      0
      1
      auto;

    font-size:
      clamp(
        13px,
        3.7vw,
        16px
      ) !important;

    line-height: 1.2 !important;

    text-align: right;

    overflow-wrap: anywhere;
  }



  /* ============================================================
     MOBILE TIMELINE CONNECTOR
     ============================================================ */

  #Transformation-{{ section.id }}
  .transformation-mobile-connector {
    min-height: 94px;

    padding:
      9px
      0;

    display: grid;

    grid-template-columns:
      1fr
      auto
      1fr;

    align-items: center;

    gap: 12px;
  }


  #Transformation-{{ section.id }}
  .transformation-mobile-connector-line {
    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(255,255,255,.14)
      );
  }


  #Transformation-{{ section.id }}
  .transformation-mobile-connector-line:last-child {
    background:
      linear-gradient(
        90deg,
        rgba(255,255,255,.14),
        transparent
      );
  }


  #Transformation-{{ section.id }}
  .transformation-mobile-connector-center {
    min-width: 94px;

    display: flex;
    flex-direction: column;
    align-items: center;

    gap: 6px;

    color:
      rgba(
        255,
        255,
        255,
        .42
      );
  }


  #Transformation-{{ section.id }}
  .transformation-mobile-connector-center span {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: .09em;

    text-transform: uppercase;
  }


  #Transformation-{{ section.id }}
  .transformation-mobile-connector-center svg {
    width: 17px;
    height: 17px;

    opacity: .65;

    animation:
      transformation-arrow-mobile-{{ section.id }}
      1.8s
      ease-in-out
      infinite;
  }


