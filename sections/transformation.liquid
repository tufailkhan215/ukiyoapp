<script>
(function() {

  var section =
    document.querySelector(
      '#Transformation-{{ section.id }}[data-transformation]'
    );

  if (!section) {
    return;
  }


  if (
    section.__transformationCleanup &&
    typeof section.__transformationCleanup === 'function'
  ) {
    section.__transformationCleanup();
  }


  var tabs =
    Array.prototype.slice.call(
      section.querySelectorAll(
        '.transformation-tab'
      )
    );


  var contents =
    Array.prototype.slice.call(
      section.querySelectorAll(
        '.transformation-content'
      )
    );


  var handlers = [];


  function activateTab(tab) {

    var index =
      tab.getAttribute(
        'data-index'
      );


    tabs.forEach(
      function(t) {

        var isActive =
          t === tab;


        t.classList.toggle(
          'bg-white',
          isActive
        );


        t.classList.toggle(
          'text-black',
          isActive
        );


        t.classList.toggle(
          'bg-white/[0.03]',
          !isActive
        );


        t.classList.toggle(
          'text-white/60',
          !isActive
        );


        t.classList.toggle(
          'border',
          !isActive
        );


        t.classList.toggle(
          'border-white/10',
          !isActive
        );


        t.setAttribute(
          'aria-selected',
          isActive
            ? 'true'
            : 'false'
        );

      }
    );


    contents.forEach(
      function(content) {

        var active =
          content.getAttribute(
            'data-index'
          ) === index;


        content.classList.toggle(
          'hidden',
          !active
        );

      }
    );


    if (
      window.matchMedia &&
      window.matchMedia(
        '(max-width: 749px)'
      ).matches
    ) {

      try {

        tab.scrollIntoView({
          behavior: 'smooth',
          block: 'nearest',
          inline: 'center'
        });

      } catch (error) {

        tab.scrollIntoView();

      }

    }

  }


  tabs.forEach(
    function(tab) {

      var handler =
        function() {
          activateTab(
            tab
          );
        };


      tab.addEventListener(
        'click',
        handler
      );


      handlers.push({
        tab: tab,
        handler: handler
      });

    }
  );


  function cleanup() {

    handlers.forEach(
      function(entry) {

        entry.tab.removeEventListener(
          'click',
          entry.handler
        );

      }
    );

  }


  section.__transformationCleanup =
    cleanup;


  document.addEventListener(
    'shopify:section:unload',
    function onUnload(event) {

      if (
        !event.target ||
        !event.target.contains(section)
      ) {
        return;
      }


      cleanup();


      document.removeEventListener(
        'shopify:section:unload',
        onUnload
      );

    }
  );

})();
</script>



