{% comment %} Source structure and Tailwind classes from reference (StatsSection) {% endcomment %}
<section class="relative py-28 lg:py-40 bg-black overflow-hidden" data-testid="stats-section">
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  <div class="stats-section-glow absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[900px] rounded-full bg-white blur-[180px]" aria-hidden="true"></div>

  <div class="relative z-10 max-w-[1600px] mx-auto px-6 lg:px-12">
    <div class="text-center mb-16">
      {% if section.settings.strap != blank %}
        <span class="text-[10px] font-medium text-white/40 tracking-[0.3em] uppercase block mb-5">{{ section.settings.strap }}</span>
      {% endif %}
      <h2 class="text-4xl md:text-5xl font-bold text-white">
        {{ section.settings.title_before | default: 'Numbers that ' }}
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-gray-400 to-gray-600">{{ section.settings.title_gradient | default: 'matter' }}</span>
      </h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-3">
      {% for block in section.blocks %}
        {% if block.type == 'stat' %}
          {% assign num = forloop.index | prepend: '0' | slice: -2, 2 %}
          <div class="group" {{ block.shopify_attributes }}>
            <div class="relative h-full bg-black p-8 lg:p-10 border border-white/[0.05] hover:bg-white/[0.02] hover:border-white/10 transition-all duration-700">
              <span class="absolute top-4 right-4 text-5xl font-bold text-white/[0.02] group-hover:text-white/[0.05] transition-colors duration-700">{{ num }}</span>
              <div class="relative z-10">
                {% if block.settings.value != blank %}
                  <div class="text-4xl lg:text-5xl font-bold text-white mb-3">
                    <span class="tabular-nums">{{ block.settings.value }}</span>
                  </div>
                {% endif %}
                {% if block.settings.label != blank %}
                  <h3 class="text-base font-semibold text-white mb-1">{{ block.settings.label }}</h3>
                {% endif %}
                {% if block.settings.desc != blank %}
                  <p class="text-sm text-white/40">{{ block.settings.desc }}</p>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
<style>
.bg-white {
    --tw-bg-opacity: 1;
    background-color: rgb(20 20 20);
}
</style>
{% schema %}
{
  "name": "Stats",
  "tag": "section",
  "class": "section-stats",
  "settings": [
    {
      "type": "text",
      "id": "strap",
      "label": "Strap (small label above title)",
      "default": "(Our Impact)"
    },
    {
      "type": "text",
      "id": "title_before",
      "label": "Title (before gradient part)",
      "default": "Numbers that "
    },
    {
      "type": "text",
      "id": "title_gradient",
      "label": "Title (gradient part)",
      "default": "matter"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value (e.g. $50M+, 340%, 98%)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label (e.g. Revenue Generated)"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stats",
      "settings": {
        "strap": "(Our Impact)",
        "title_before": "Numbers that ",
        "title_gradient": "matter"
      },
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "$50M+",
            "label": "Revenue Generated",
            "desc": "For clients through strategic campaigns"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "340%",
            "label": "Average Growth",
            "desc": "Monthly revenue increase"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "98%",
            "label": "Client Retention",
            "desc": "Long-term partnerships"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "$500K+",
            "label": "Annual Savings",
            "desc": "Through AI automation"
          }
        }
      ]
    }
  ]
}
{% endschema %}
