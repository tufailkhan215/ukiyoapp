{% comment %} Source structure and Tailwind classes from reference (BigStatement) {% endcomment %}
<section class="relative py-40 lg:py-56 bg-black overflow-hidden">
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[1000px] h-[1000px] rounded-full bg-white blur-[200px] opacity-[0.04]" aria-hidden="true"></div>

  <div class="relative z-10 max-w-[1400px] mx-auto px-6 lg:px-12 text-center">
    <div class="w-20 h-px bg-white/20 mx-auto mb-14 origin-center" aria-hidden="true"></div>

    <blockquote class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl xl:text-6xl font-medium leading-[1.2] tracking-tight">
      <span class="text-white/20">"</span><span class="text-white">{{ section.settings.quote_part1 | default: 'Brand strategy, identity, and experience' }}</span><span class="text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-500"> {{ section.settings.quote_part2 | default: 'built for growth at scale.' }}</span><span class="text-white/20">"</span>
    </blockquote>

    <div class="w-20 h-px bg-white/20 mx-auto my-14 origin-center" aria-hidden="true"></div>

    {% if section.settings.tagline != blank %}
      <p class="text-sm text-white/30 tracking-[0.3em] uppercase">{{ section.settings.tagline }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Big statement",
  "tag": "section",
  "class": "section-big-statement",
  "settings": [
    { "type": "text", "id": "quote_part1", "label": "Quote part 1 (white)", "default": "Brand strategy, identity, and experience" },
    { "type": "text", "id": "quote_part2", "label": "Quote part 2 (gradient)", "default": "built for growth at scale." },
    { "type": "text", "id": "tagline", "label": "Tagline below quote", "default": "Our Philosophy" }
  ],
  "presets": [
    { "name": "Big statement" }
  ]
}
{% endschema %}
