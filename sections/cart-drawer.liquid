{% comment %} Cart drawer: slide-over panel, content loaded via /cart.js {% endcomment %}
<div class="cart-drawer-overlay fixed inset-0 bg-black/60 z-[198] opacity-0 pointer-events-none transition-opacity duration-300" data-cart-drawer-overlay aria-hidden="true"></div>
<aside class="cart-drawer fixed top-0 right-0 w-full max-w-md h-full bg-[#0f0f10] border-l border-white/10 z-[200] flex flex-col transform translate-x-full transition-transform duration-300 ease-out overflow-hidden" data-cart-drawer role="dialog" aria-label="Cart" aria-modal="true">
  <div class="flex items-center justify-between p-6 border-b border-white/10">
    <h2 class="text-lg font-semibold text-white">Cart ({{ cart.item_count }})</h2>
    <button type="button" class="p-2 text-white/60 hover:text-white transition-colors rounded-full hover:bg-white/10" aria-label="Close cart" data-cart-drawer-close>
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>
  <div class="cart-drawer-content flex-1 overflow-y-auto p-6" data-cart-drawer-content>
    <div class="cart-drawer-empty text-center py-12 text-white/50" data-cart-drawer-empty>
      <p class="mb-4">Your cart is empty.</p>
      <a href="{{ routes.all_products_collection_url }}" class="inline-block px-6 py-3 rounded-full border border-white/20 text-white hover:bg-white/10 transition-colors">Continue shopping</a>
    </div>
    <div class="cart-drawer-items hidden" data-cart-drawer-items>
      <ul class="space-y-4" data-cart-drawer-list></ul>
      <div class="mt-6 pt-6 border-t border-white/10">
        <div class="flex justify-between text-sm text-white/60 mb-2"><span>Subtotal</span><span data-cart-drawer-subtotal></span></div>
        <p class="text-xs text-white/40 mb-4">Shipping and taxes calculated at checkout.</p>
        <a href="{{ routes.cart_url }}" class="block w-full text-center py-3 rounded-full border border-white/20 text-white hover:bg-white/10 transition-colors mb-3">View cart</a>
        <a href="/checkout" class="block w-full text-center py-3 rounded-full bg-white text-black font-semibold hover:bg-gray-200 transition-colors">Checkout</a>
      </div>
    </div>
  </div>
</aside>

<script>
(function() {
  var overlay = document.querySelector('[data-cart-drawer-overlay]');
  var drawer = document.querySelector('[data-cart-drawer]');
  var content = document.querySelector('[data-cart-drawer-content]');
  var emptyEl = document.querySelector('[data-cart-drawer-empty]');
  var itemsEl = document.querySelector('[data-cart-drawer-items]');
  var listEl = document.querySelector('[data-cart-drawer-list]');
  var subtitleEl = document.querySelector('[data-cart-drawer-subtotal]');
  var countEl = drawer ? drawer.querySelector('h2') : null;

  function openCartDrawer() {
    if (!drawer || !overlay) return;
    drawer.classList.add('cart-drawer-open');
    overlay.classList.remove('pointer-events-none');
    overlay.classList.add('pointer-events-auto', 'opacity-100');
    overlay.setAttribute('aria-hidden', 'false');
    drawer.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    fetchCart();
  }

  function closeCartDrawer() {
    if (!drawer || !overlay) return;
    drawer.classList.remove('cart-drawer-open');
    overlay.classList.add('pointer-events-none', 'opacity-0');
    overlay.classList.remove('pointer-events-auto', 'opacity-100');
    overlay.setAttribute('aria-hidden', 'true');
    drawer.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function escapeHtml(s) {
    if (!s) return '';
    var div = document.createElement('div');
    div.textContent = s;
    return div.innerHTML;
  }

  function formatMoney(cents) {
    return (cents / 100).toLocaleString(undefined, { style: 'currency', currency: window.Shopify?.currency?.active || 'USD', minimumFractionDigits: 2 });
  }

  function updateHeaderCartCount(count) {
    document.querySelectorAll('[data-header-cart-count]').forEach(function(el) {
      el.textContent = count > 0 ? (count > 99 ? '99+' : count) : '';
      el.style.display = count > 0 ? '' : 'none';
    });
  }

  function renderCart(cart) {
    if (!listEl || !itemsEl || !emptyEl || !subtitleEl) return;
    var itemCount = (cart && cart.items && cart.items.length) ? cart.item_count : 0;
    updateHeaderCartCount(itemCount);
    if (!cart || !cart.items || cart.items.length === 0) {
      emptyEl.classList.remove('hidden');
      itemsEl.classList.add('hidden');
      if (countEl) countEl.textContent = 'Cart (0)';
      return;
    }
    emptyEl.classList.add('hidden');
    itemsEl.classList.remove('hidden');
    if (countEl) countEl.textContent = 'Cart (' + cart.item_count + ')';
    subtitleEl.textContent = formatMoney(cart.total_price);
    var html = '';
    cart.items.forEach(function(item) {
      var imgUrl = (item.featured_image && item.featured_image.url) || item.image || '';
      var img = imgUrl ? '<img src="' + escapeHtml(imgUrl) + '" alt="' + escapeHtml(item.title || item.product_title) + '" class="w-16 h-16 object-cover rounded-lg flex-shrink-0" width="64" height="64" loading="lazy">' : '<div class="w-16 h-16 bg-white/5 rounded-lg flex-shrink-0"></div>';
      var url = item.url || '#';
      html += '<li class="flex gap-3" data-cart-drawer-line data-key="' + escapeHtml(item.key) + '">';
      html += '<a href="' + escapeHtml(url) + '" class="flex-shrink-0">' + img + '</a>';
      html += '<div class="flex-1 min-w-0">';
      html += '<a href="' + escapeHtml(url) + '" class="text-white font-medium text-sm hover:underline line-clamp-2">' + escapeHtml(item.product_title) + '</a>';
      if (item.variant_title && item.variant_title !== 'Default Title') html += '<p class="text-white/40 text-xs mt-0.5">' + escapeHtml(item.variant_title) + '</p>';
      html += '<p class="text-white/60 text-sm mt-1">' + formatMoney(item.final_line_price) + ' × ' + item.quantity + '</p>';
      html += '</div>';
      html += '<button type="button" class="cart-drawer-remove p-1 text-white/40 hover:text-red-400 transition-colors flex-shrink-0" data-key="' + escapeHtml(item.key) + '" aria-label="Remove">';
      html += '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>';
      html += '</button>';
      html += '</li>';
    });
    listEl.innerHTML = html;
    listEl.querySelectorAll('.cart-drawer-remove').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var key = this.getAttribute('data-key');
        if (!key) return;
        fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ id: key, quantity: 0 })
        }).then(function(r) { return r.json(); }).then(function() { fetchCart(); }).catch(function() { fetchCart(); });
      });
    });
  }

  function fetchCart() {
    fetch('/cart.js')
      .then(function(r) { return r.json(); })
      .then(renderCart)
      .catch(function() {
        if (emptyEl) emptyEl.classList.remove('hidden');
        if (itemsEl) itemsEl.classList.add('hidden');
      });
  }

  var triggers = document.querySelectorAll('[data-cart-drawer-trigger]');
  triggers.forEach(function(t) { t.addEventListener('click', openCartDrawer); });
  var closeBtn = document.querySelector('[data-cart-drawer-close]');
  if (closeBtn) closeBtn.addEventListener('click', closeCartDrawer);
  if (overlay) overlay.addEventListener('click', closeCartDrawer);

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && drawer && drawer.classList.contains('cart-drawer-open')) closeCartDrawer();
  });

  window.openCartDrawer = openCartDrawer;
  window.fetchCartDrawer = fetchCart;
  fetchCart();
})();
</script>

<style>
.cart-drawer.cart-drawer-open { transform: translateX(0); }
@media (prefers-reduced-motion: reduce) {
  .cart-drawer, .cart-drawer-overlay { transition: none; }
}
</style>

{% schema %}
{
  "name": "Cart drawer",
  "class": "section-cart-drawer",
  "settings": [],
  "presets": [{ "name": "Cart drawer" }]
}
{% endschema %}
