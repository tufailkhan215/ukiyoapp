{% comment %} Icon Boxes: Challenge (red, metric+description) or Solution (emerald, phrase). {% endcomment %}
{% assign box_blocks = section.blocks | where: 'type', 'box' %}
{% assign is_solution = false %}
{% if section.settings.variant == 'solution' %}
  {% assign is_solution = true %}
{% endif %}

<section class="relative py-12 lg:py-16 bg-black overflow-hidden" data-testid="icon-boxes">
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  {% if is_solution %}
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(16,185,129,0.05),transparent_50%)]" aria-hidden="true"></div>
  {% else %}
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,rgba(239,68,68,0.05),transparent_50%)]" aria-hidden="true"></div>
  {% endif %}
  <div class="relative z-10 max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="text-center mb-8">
      {% if section.settings.badge != blank %}
        <span class="text-[10px] font-medium text-white/40 tracking-[0.3em] uppercase block mb-2">{{ section.settings.badge }}</span>
      {% endif %}
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-2">
        {{ section.settings.title_before }}
        {% if is_solution %}
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-400">{{ section.settings.title_gradient }}</span>
        {% else %}
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-400 to-orange-400">{{ section.settings.title_gradient }}</span>
        {% endif %}
      </h2>
      {% if section.settings.subtitle != blank %}
        <p class="text-white/40 max-w-lg mx-auto text-sm">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="grid md:grid-cols-3 gap-4">
      {% for block in box_blocks %}
        <div class="relative group" {{ block.shopify_attributes }}>
          {% if is_solution %}
            <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/20 to-teal-500/10 rounded-xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500" aria-hidden="true"></div>
            <div class="relative p-5 rounded-xl bg-gradient-to-br from-emerald-500/10 to-transparent border border-emerald-500/20 hover:border-emerald-500/40 transition-all duration-500">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-500/30 to-emerald-600/10 flex items-center justify-center mb-4 scale-[1.04]">
                {% case block.settings.icon %}
                  {% when 'zap' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-zap w-6 h-6 text-emerald-400"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path></svg>
                  {% when 'message_square' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-message-square w-6 h-6 text-emerald-400"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                  {% when 'trending_up' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-trending-up w-6 h-6 text-emerald-400"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
                  {% when 'clock' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-clock w-6 h-6 text-emerald-400"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                  {% when 'users' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-users w-6 h-6 text-emerald-400"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg>
                  {% when 'trending_down' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-trending-down w-6 h-6 text-emerald-400"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7"></polyline><polyline points="16 17 22 17 22 11"></polyline></svg>
                  {% else %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-circle w-6 h-6 text-emerald-400"><circle cx="12" cy="12" r="10"></circle></svg>
                {% endcase %}
              </div>
              <h4 class="text-lg font-bold text-white mb-1">{{ block.settings.title }}</h4>
              {% if block.settings.phrase != blank %}
                <p class="text-xl font-bold bg-gradient-to-r from-emerald-400 to-teal-400 bg-clip-text text-transparent">{{ block.settings.phrase }}</p>
              {% endif %}
            </div>
          {% else %}
            <div class="absolute inset-0 bg-gradient-to-br from-red-500/20 to-orange-500/10 rounded-xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500" aria-hidden="true"></div>
            <div class="relative p-5 rounded-xl bg-gradient-to-br from-red-500/10 to-transparent border border-red-500/20 hover:border-red-500/40 transition-all duration-500">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-red-500/30 to-red-600/10 flex items-center justify-center mb-4 -rotate-[1deg]">
                {% case block.settings.icon %}
                  {% when 'clock' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-clock w-6 h-6 text-red-400"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                  {% when 'users' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-users w-6 h-6 text-red-400"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg>
                  {% when 'trending_down' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-trending-down w-6 h-6 text-red-400"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7"></polyline><polyline points="16 17 22 17 22 11"></polyline></svg>
                  {% else %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-circle w-6 h-6 text-red-400"><circle cx="12" cy="12" r="10"></circle></svg>
                {% endcase %}
              </div>
              <h4 class="text-lg font-bold text-white mb-1">{{ block.settings.title }}</h4>
              <p class="text-3xl font-black bg-gradient-to-r from-red-400 to-orange-400 bg-clip-text text-transparent mb-1">{{ block.settings.metric }}</p>
              <p class="text-xs text-white/50">{{ block.settings.description }}</p>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Icon Boxes",
  "tag": "section",
  "class": "section-icon-boxes",
  "settings": [
    { "type": "select", "id": "variant", "label": "Style", "default": "challenge", "options": [ { "value": "challenge", "label": "Challenge (red – metric + description)" }, { "value": "solution", "label": "Solution (emerald – phrase only)" } ] },
    { "type": "text", "id": "badge", "label": "Badge", "default": "(The Challenge)" },
    { "type": "text", "id": "title_before", "label": "Title (before gradient)", "default": "Problems We " },
    { "type": "text", "id": "title_gradient", "label": "Title (gradient part)", "default": "Solve" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "These common pain points are holding businesses back. We fix them." }
  ],
  "blocks": [
    {
      "type": "box",
      "name": "Box",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "clock", "options": [ { "value": "clock", "label": "Clock" }, { "value": "users", "label": "Users" }, { "value": "trending_down", "label": "Trending down" }, { "value": "zap", "label": "Zap" }, { "value": "message_square", "label": "Message" }, { "value": "trending_up", "label": "Trending up" } ] },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "metric", "label": "Metric (Challenge style)" },
        { "type": "textarea", "id": "description", "label": "Description (Challenge style)" },
        { "type": "text", "id": "phrase", "label": "Phrase (Solution style – gradient line)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon Boxes (Challenge)",
      "settings": {
        "variant": "challenge",
        "badge": "(The Challenge)",
        "title_before": "Problems We ",
        "title_gradient": "Solve",
        "subtitle": "These common pain points are holding businesses back. We fix them."
      },
      "blocks": [
        { "type": "box", "settings": { "icon": "clock", "title": "Time Drain", "metric": "40hrs/week", "description": "Average time spent on repetitive customer inquiries" } },
        { "type": "box", "settings": { "icon": "users", "title": "Inconsistent Voice", "metric": "67%", "description": "Of customers notice brand voice inconsistencies" } },
        { "type": "box", "settings": { "icon": "trending_down", "title": "Missed Opportunities", "metric": "$50K+", "description": "Lost annually from slow response times" } }
      ]
    },
    {
      "name": "Icon Boxes (Solution)",
      "settings": {
        "variant": "solution",
        "badge": "(The Solution)",
        "title_before": "How We ",
        "title_gradient": "Deliver",
        "subtitle": "Proven strategies that get real results for your business."
      },
      "blocks": [
        { "type": "box", "settings": { "icon": "zap", "title": "24/7 Availability", "phrase": "Never miss a customer" } },
        { "type": "box", "settings": { "icon": "message_square", "title": "Consistent Messaging", "phrase": "Perfect brand voice every time" } },
        { "type": "box", "settings": { "icon": "trending_up", "title": "Scale Instantly", "phrase": "Handle 1000s of conversations" } }
      ]
    }
  ]
}
{% endschema %}
