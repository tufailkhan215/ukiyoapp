{% comment %} Source structure and Tailwind classes from reference (ServicesSection) {% endcomment %}
<section class="relative py-28 lg:py-40 bg-black overflow-hidden">
  <div class="absolute inset-0" aria-hidden="true">
    <div class="absolute top-1/4 left-0 w-[700px] h-[700px] rounded-full bg-white/[0.015] blur-[180px]"></div>
    <div class="absolute bottom-1/4 right-0 w-[500px] h-[500px] rounded-full bg-white/[0.015] blur-[140px]"></div>
  </div>
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>

  <div class="relative z-10 max-w-[1600px] mx-auto px-6 lg:px-12">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-20 mb-20">
      <div>
        {% if section.settings.strap != blank %}
          <span class="text-[10px] font-medium text-white/40 tracking-[0.3em] uppercase block mb-5">{{ section.settings.strap }}</span>
        {% endif %}
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-[1.05]">
          {{ section.settings.title_line1 | default: 'Services that' }}<br>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-gray-400 to-gray-600">{{ section.settings.title_line2 | default: 'drive growth' }}</span>
        </h2>
      </div>
      <div class="lg:pt-12">
        {% if section.settings.description != blank %}
          <p class="text-base text-white/40 leading-relaxed mb-6">{{ section.settings.description }}</p>
        {% endif %}
        {% if section.settings.explore_url != blank %}
          <a class="group inline-flex items-center gap-2 text-white font-medium hover:text-white/70 transition-colors" href="{{ section.settings.explore_url }}">
            {{ section.settings.explore_text | default: 'Explore all services' }}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-arrow-up-right w-5 h-5 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
          </a>
        {% endif %}
      </div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-3">
      {% for block in section.blocks %}
        {% if block.type == 'service' %}
          {% assign num = forloop.index | prepend: '0' | slice: -2, 2 %}
          <div class="group" {{ block.shopify_attributes }}>
            <a class="block h-full" href="{{ block.settings.link | default: section.settings.explore_url }}">
              <div class="relative h-full bg-white/[0.02] border border-white/[0.05] p-7 lg:p-9 overflow-hidden hover:bg-white/[0.04] hover:border-white/10 transition-all duration-500">
                <span class="absolute -right-3 -top-6 text-[100px] font-bold text-white/[0.02] group-hover:text-white/[0.04] transition-colors duration-500 leading-none select-none">{{ num }}</span>
                <div class="absolute inset-0 bg-gradient-to-br from-white/[0.02] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" aria-hidden="true"></div>
                <div class="relative z-10">
                  <div class="w-11 h-11 mb-6 rounded-full bg-white/[0.03] border border-white/10 flex items-center justify-center group-hover:bg-white/[0.08] group-hover:border-white/20 transition-all duration-500">
                    {% case block.settings.icon %}
                      {% when 'sparkles' %}
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-white/40 group-hover:text-white/70 transition-colors" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/></svg>
                      {% when 'zap' %}
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-white/40 group-hover:text-white/70 transition-colors" aria-hidden="true"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>
                      {% when 'target' %}
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-white/40 group-hover:text-white/70 transition-colors" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                      {% when 'palette' %}
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-white/40 group-hover:text-white/70 transition-colors" aria-hidden="true"><path d="M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z"/><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/></svg>
                      {% when 'camera' %}
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-white/40 group-hover:text-white/70 transition-colors" aria-hidden="true"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
                      {% when 'trending-up' %}
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-white/40 group-hover:text-white/70 transition-colors" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
                      {% else %}
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-white/40 group-hover:text-white/70 transition-colors" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                    {% endcase %}
                  </div>
                  <h3 class="text-xl lg:text-2xl font-bold text-white mb-2">{{ block.settings.title | default: 'Service' }}</h3>
                  {% if block.settings.subtitle != blank %}
                    <p class="text-white/40 text-sm mb-3">{{ block.settings.subtitle }}</p>
                  {% endif %}
                  {% if block.settings.description != blank %}
                    <p class="text-white/30 text-sm leading-relaxed mb-6">{{ block.settings.description }}</p>
                  {% endif %}
                  <span class="inline-flex items-center gap-2 text-white/40 group-hover:text-white/70 text-sm transition-colors">
                    {{ block.settings.link_text | default: 'Explore' }}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-arrow-up-right w-4 h-4 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
                  </span>
                </div>
              </div>
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Services",
  "tag": "section",
  "class": "section-services",
  "settings": [
    { "type": "text", "id": "strap", "label": "Strap line", "default": "(What We Do)" },
    { "type": "text", "id": "title_line1", "label": "Title line 1", "default": "Services that" },
    { "type": "text", "id": "title_line2", "label": "Title line 2 (gradient)", "default": "drive growth" },
    { "type": "textarea", "id": "description", "label": "Intro description", "default": "We work with founders, CEOs, and leadership teams to shape defining ideas and build the strategy and systems that carry them through growth." },
    { "type": "text", "id": "explore_text", "label": "Explore link text", "default": "Explore all services" },
    { "type": "url", "id": "explore_url", "label": "Explore all services link" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service card",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "sparkles", "options": [
          { "value": "sparkles", "label": "Sparkles" },
          { "value": "zap", "label": "Zap" },
          { "value": "target", "label": "Target" },
          { "value": "palette", "label": "Palette" },
          { "value": "camera", "label": "Camera" },
          { "value": "trending-up", "label": "Trending up" }
        ]},
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "link_text", "label": "Link text", "default": "Explore" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services",
      "settings": {
        "strap": "(What We Do)",
        "title_line1": "Services that",
        "title_line2": "drive growth",
        "description": "We work with founders, CEOs, and leadership teams to shape defining ideas and build the strategy and systems that carry them through growth.",
        "explore_text": "Explore all services"
      },
      "blocks": [
        { "type": "service", "settings": { "icon": "sparkles", "title": "Brand Strategy", "subtitle": "Define your edge", "description": "Position your brand for category leadership with strategic foundations." } },
        { "type": "service", "settings": { "icon": "zap", "title": "AI Automations", "subtitle": "Scale intelligently", "description": "Streamline operations with cutting-edge AI-powered solutions." } },
        { "type": "service", "settings": { "icon": "target", "title": "Lead Generation", "subtitle": "Grow consistently", "description": "Data-driven strategies that convert prospects into customers." } },
        { "type": "service", "settings": { "icon": "palette", "title": "Brand Identity", "subtitle": "Stand out visually", "description": "Distinctive visual systems that capture your brand essence." } },
        { "type": "service", "settings": { "icon": "camera", "title": "Content Production", "subtitle": "Tell your story", "description": "High-quality content that resonates with modern audiences." } },
        { "type": "service", "settings": { "icon": "trending-up", "title": "Growth Marketing", "subtitle": "Accelerate results", "description": "Performance marketing that drives measurable business growth." } }
      ]
    }
  ]
}
{% endschema %}
