<script>
(function () {

  var root =
    document.getElementById(
      'UkiyoServices-{{ uid }}'
    );


  if (!root) {
    return;
  }


  if (
    root.__usvCleanup &&
    typeof root.__usvCleanup === 'function'
  ) {
    root.__usvCleanup();
  }


  var cards =
    Array.prototype.slice.call(
      root.querySelectorAll(
        '[data-usv-card]'
      )
    );


  var revealItems =
    Array.prototype.slice.call(
      root.querySelectorAll(
        '[data-usv-reveal]'
      )
    );


  var track =
    root.querySelector(
      '[data-usv-track]'
    );


  var previousButton =
    root.querySelector(
      '[data-usv-prev]'
    );


  var nextButton =
    root.querySelector(
      '[data-usv-next]'
    );


  var currentLabel =
    root.querySelector(
      '[data-usv-current]'
    );


  var progress =
    root.querySelector(
      '[data-usv-progress]'
    );


  var reduceMotion =
    window.matchMedia &&
    window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;


  var revealObserver = null;

  var cardListeners = [];

  var scrollTimer = 0;

  var activeIndex = 0;


  /* ============================================================
     REVEAL
     ============================================================ */

  function revealAll() {

    revealItems.forEach(
      function(item) {

        item.classList.add(
          'is-visible'
        );

      }
    );

  }


  function initReveal() {

    if (
      reduceMotion ||
      !(
        'IntersectionObserver'
        in window
      )
    ) {
      revealAll();

      return;
    }


    revealObserver =
      new IntersectionObserver(
        function(entries) {

          entries.forEach(
            function(entry) {

              if (
                !entry.isIntersecting
              ) {
                return;
              }


              entry.target.classList.add(
                'is-visible'
              );


              revealObserver.unobserve(
                entry.target
              );

            }
          );

        },
        {
          threshold: .12,

          rootMargin:
            '0px 0px -7% 0px'
        }
      );


    revealItems.forEach(
      function(item) {

        revealObserver.observe(
          item
        );

      }
    );

  }


  /* ============================================================
     DESKTOP CARD REACTION
     ============================================================ */

  function initCardInteraction() {

    if (
      reduceMotion ||
      !window.matchMedia ||
      !window.matchMedia(
        '(hover: hover) and (pointer: fine)'
      ).matches
    ) {
      return;
    }


    cards.forEach(
      function(card) {

        function onMove(event) {

          var rect =
            card.getBoundingClientRect();


          var x =
            event.clientX -
            rect.left;


          var y =
            event.clientY -
            rect.top;


          var xp =
            (
              x /
              rect.width
            ) *
            100;


          var yp =
            (
              y /
              rect.height
            ) *
            100;


          var ry =
            (
              (
                x /
                rect.width
              ) -
              .5
            ) *
            2.2;


          var rx =
            (
              .5 -
              (
                y /
                rect.height
              )
            ) *
            2.2;


          card.style.setProperty(
            '--usv-x',
            xp.toFixed(2) +
            '%'
          );


          card.style.setProperty(
            '--usv-y',
            yp.toFixed(2) +
            '%'
          );


          card.style.setProperty(
            '--usv-rx',
            rx.toFixed(2) +
            'deg'
          );


          card.style.setProperty(
            '--usv-ry',
            ry.toFixed(2) +
            'deg'
          );

        }


        function onLeave() {

          card.style.setProperty(
            '--usv-rx',
            '0deg'
          );


          card.style.setProperty(
            '--usv-ry',
            '0deg'
          );

        }


        card.addEventListener(
          'pointermove',
          onMove
        );


        card.addEventListener(
          'pointerleave',
          onLeave
        );


        cardListeners.push({
          card: card,
          move: onMove,
          leave: onLeave
        });

      }
    );

  }


  /* ============================================================
     MOBILE CAROUSEL
     ============================================================ */

  function isMobile() {

    return (
      window.matchMedia &&
      window.matchMedia(
        '(max-width: 749px)'
      ).matches
    );

  }


  function getNearestCardIndex() {

    if (
      !track ||
      !cards.length
    ) {
      return 0;
    }


    var trackRect =
      track.getBoundingClientRect();


    var targetLeft =
      trackRect.left;


    var closestIndex = 0;

    var closestDistance =
      Infinity;


    cards.forEach(
      function(card, index) {

        var rect =
          card.getBoundingClientRect();


        var distance =
          Math.abs(
            rect.left -
            targetLeft
          );


        if (
          distance <
          closestDistance
        ) {
          closestDistance =
            distance;

          closestIndex =
            index;
        }

      }
    );


    return closestIndex;

  }


  function updateControls(index) {

    activeIndex =
      Math.max(
        0,
        Math.min(
          cards.length - 1,
          index
        )
      );


    if (currentLabel) {

      currentLabel.textContent =
        String(
          activeIndex + 1
        ).padStart(
          2,
          '0'
        );

    }


    if (progress) {

      var percentage =
        (
          (
            activeIndex + 1
          ) /
          cards.length
        ) *
        100;


      progress.style.width =
        percentage +
        '%';

    }

  }


  function scrollToCard(index) {

    if (
      !track ||
      !cards[index]
    ) {
      return;
    }


    var card =
      cards[index];


    var target =
      card.offsetLeft -
      track.offsetLeft;


    track.scrollTo({
      left: target,
      behavior:
        reduceMotion
          ? 'auto'
          : 'smooth'
    });


    updateControls(
      index
    );

  }


  function handleTrackScroll() {

    if (!isMobile()) {
      return;
    }


    window.clearTimeout(
      scrollTimer
    );


    scrollTimer =
      window.setTimeout(
        function() {

          updateControls(
            getNearestCardIndex()
          );

        },
        80
      );

  }


  function handlePrevious() {

    scrollToCard(
      Math.max(
        0,
        activeIndex - 1
      )
    );

  }


  function handleNext() {

    scrollToCard(
      Math.min(
        cards.length - 1,
        activeIndex + 1
      )
    );

  }


  if (track) {

    track.addEventListener(
      'scroll',
      handleTrackScroll,
      {
        passive: true
      }
    );

  }


  if (previousButton) {

    previousButton.addEventListener(
      'click',
      handlePrevious
    );

  }


  if (nextButton) {

    nextButton.addEventListener(
      'click',
      handleNext
    );

  }


  /* ============================================================
     CLEANUP
     ============================================================ */

  function cleanup() {

    if (revealObserver) {

      revealObserver.disconnect();

    }


    cardListeners.forEach(
      function(entry) {

        entry.card.removeEventListener(
          'pointermove',
          entry.move
        );


        entry.card.removeEventListener(
          'pointerleave',
          entry.leave
        );

      }
    );


    if (track) {

      track.removeEventListener(
        'scroll',
        handleTrackScroll
      );

    }


    if (previousButton) {

      previousButton.removeEventListener(
        'click',
        handlePrevious
      );

    }


    if (nextButton) {

      nextButton.removeEventListener(
        'click',
        handleNext
      );

    }


    window.clearTimeout(
      scrollTimer
    );

  }


  root.__usvCleanup =
    cleanup;


  initReveal();

  initCardInteraction();

  updateControls(0);


  document.addEventListener(
    'shopify:section:unload',
    function onUnload(event) {

      if (
        !event.target ||
        !event.target.contains(root)
      ) {
        return;
      }


      cleanup();


      document.removeEventListener(
        'shopify:section:unload',
        onUnload
      );

    }
  );

})();
</script>



