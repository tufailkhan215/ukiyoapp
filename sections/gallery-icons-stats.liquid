{%- comment -%}
  ============================================================
  UKIYO — WHY BRANDS CHOOSE US
  Premium services / proof section

  Desktop:
  - 4-column premium cards
  - reactive glow
  - animated gradients
  - staggered scroll reveal
  - subtle 3D hover

  Mobile:
  - horizontal swipe carousel
  - one focused service at a time
  - compact card height
  - previous / next controls
  - pagination indicators
  - much less vertical scrolling

  All existing information preserved.
  ============================================================
{%- endcomment -%}


{%- liquid
  assign uid = section.id | replace: '_', '' | replace: '-', '' | downcase
  assign card_blocks = section.blocks | where: 'type', 'card'
  assign card_count = card_blocks.size
-%}


<section
  id="UkiyoServices-{{ uid }}"
  class="usv usv--{{ uid }}"
  data-usv-root
>

  {%- comment -%}
    ============================================================
    AMBIENT BACKGROUND
    ============================================================
  {%- endcomment -%}

  <div
    class="usv__grid-bg"
    aria-hidden="true"
  ></div>

  <div
    class="usv__orb usv__orb--one"
    aria-hidden="true"
  ></div>

  <div
    class="usv__orb usv__orb--two"
    aria-hidden="true"
  ></div>

  <div
    class="usv__top-line"
    aria-hidden="true"
  ></div>



  <div class="usv__shell">

    {%- comment -%}
      ============================================================
      HEADER
      ============================================================
    {%- endcomment -%}

    <header
      class="usv__header"
      data-usv-reveal
    >

      <div class="usv__header-top">

        {%- if section.settings.badge != blank -%}

          <p class="usv__eyebrow">

            <span
              class="usv__eyebrow-dot"
              aria-hidden="true"
            ></span>

            {{ section.settings.badge }}

          </p>

        {%- endif -%}


        <div class="usv__service-count">

          <strong>
            {{ card_count | prepend: '0' | slice: -2, 2 }}
          </strong>

          <span>
            Core<br>Capabilities
          </span>

        </div>

      </div>


      <div class="usv__header-grid">

        <h2 class="usv__title">

          {%- if section.settings.title_before != blank -%}

            <span>
              {{ section.settings.title_before }}
            </span>

          {%- endif -%}


          {%- if section.settings.title_gradient != blank -%}

            <em>
              {{ section.settings.title_gradient }}
            </em>

          {%- endif -%}

        </h2>


        <div class="usv__header-copy">

          {%- if section.settings.subtitle != blank -%}

            <p>
              {{ section.settings.subtitle }}
            </p>

          {%- endif -%}


          <div class="usv__header-key">

            <span>
              Visual
            </span>

            <span>
              Strategy
            </span>

            <span>
              Experience
            </span>

            <span>
              Growth
            </span>

          </div>

        </div>

      </div>

    </header>



    {%- comment -%}
      ============================================================
      SERVICE CARDS
      ============================================================
    {%- endcomment -%}

    <div
      class="usv__viewport"
      data-usv-viewport
    >

      <div
        class="usv__cards"
        data-usv-track
      >

        {%- for block in card_blocks -%}

          {%- assign g = block.settings.gradient -%}
          {%- assign number = forloop.index | prepend: '0' | slice: -2, 2 -%}


          <article
            class="
              usv__card
              usv__card--{{ g }}
            "
            data-usv-card
            data-usv-reveal
            data-index="{{ forloop.index0 }}"
            style="--usv-delay: {{ forloop.index0 | times: 80 }}ms;"
            {{ block.shopify_attributes }}
          >

            <div
              class="usv__card-glow"
              aria-hidden="true"
            ></div>


            <div
              class="usv__card-grid"
              aria-hidden="true"
            ></div>


            <div class="usv__card-top">

              <div class="usv__icon-wrap">

                <div class="usv__icon">

                  {% case block.settings.icon %}

                    {% when 'camera' %}

                      <svg
                        viewBox="0 0 24 24"
                        width="26"
                        height="26"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/>
                        <circle cx="12" cy="13" r="3"/>
                      </svg>


                    {% when 'video' %}

                      <svg
                        viewBox="0 0 24 24"
                        width="26"
                        height="26"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"/>
                        <rect x="2" y="6" width="14" height="12" rx="2"/>
                      </svg>


                    {% when 'palette' %}

                      <svg
                        viewBox="0 0 24 24"
                        width="26"
                        height="26"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z"/>
                        <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/>
                        <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/>
                        <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/>
                        <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/>
                      </svg>


                    {% when 'target' %}

                      <svg
                        viewBox="0 0 24 24"
                        width="26"
                        height="26"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <circle cx="12" cy="12" r="9"/>
                        <circle cx="12" cy="12" r="5"/>
                        <circle cx="12" cy="12" r="1.5"/>
                      </svg>


                    {% else %}

                      <svg
                        viewBox="0 0 24 24"
                        width="26"
                        height="26"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        aria-hidden="true"
                      >
                        <circle cx="12" cy="12" r="9"/>
                      </svg>

                  {% endcase %}

                </div>


                <span
                  class="usv__icon-orbit"
                  aria-hidden="true"
                ></span>

              </div>


              <span class="usv__number">
                {{ number }}
              </span>

            </div>



            <div class="usv__card-body">

              {%- if block.settings.title != blank -%}

                <h3>
                  {{ block.settings.title }}
                </h3>

              {%- endif -%}


              {%- if block.settings.description != blank -%}

                <p>
                  {{ block.settings.description }}
                </p>

              {%- endif -%}

            </div>



            <div class="usv__stats">

              {%- if block.settings.stat1_number != blank or block.settings.stat1_label != blank -%}

                <div class="usv__stat">

                  {%- if block.settings.stat1_number != blank -%}

                    <strong>
                      {{ block.settings.stat1_number }}
                    </strong>

                  {%- endif -%}


                  {%- if block.settings.stat1_label != blank -%}

                    <span>
                      {{ block.settings.stat1_label }}
                    </span>

                  {%- endif -%}

                </div>

              {%- endif -%}


              {%- if block.settings.stat2_number != blank or block.settings.stat2_label != blank -%}

                <div class="usv__stat">

                  {%- if block.settings.stat2_number != blank -%}

                    <strong>
                      {{ block.settings.stat2_number }}
                    </strong>

                  {%- endif -%}


                  {%- if block.settings.stat2_label != blank -%}

                    <span>
                      {{ block.settings.stat2_label }}
                    </span>

                  {%- endif -%}

                </div>

              {%- endif -%}

            </div>


            <div class="usv__card-footer">

              <span>
                Capability
              </span>

              <span class="usv__status">

                <i aria-hidden="true"></i>

                Active

              </span>

            </div>

          </article>

        {%- endfor -%}

      </div>

    </div>



    {%- comment -%}
      ============================================================
      MOBILE CAROUSEL CONTROLS
      ============================================================
    {%- endcomment -%}

    {%- if card_count > 1 -%}

      <div
        class="usv__mobile-controls"
        data-usv-controls
      >

        <div class="usv__mobile-progress">

          <span data-usv-current>
            01
          </span>

          <div class="usv__progress-line">

            <span
              class="usv__progress-fill"
              data-usv-progress
            ></span>

          </div>

          <span>
            {{ card_count | prepend: '0' | slice: -2, 2 }}
          </span>

        </div>


        <div class="usv__mobile-buttons">

          <button
            type="button"
            class="usv__nav-button"
            data-usv-prev
            aria-label="Previous service"
          >

            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M19 12H5"/>
              <path d="m11 18-6-6 6-6"/>
            </svg>

          </button>


          <button
            type="button"
            class="usv__nav-button"
            data-usv-next
            aria-label="Next service"
          >

            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14"/>
              <path d="m13 6 6 6-6 6"/>
            </svg>

          </button>

        </div>

      </div>

    {%- endif -%}

  </div>

</section>



{% style %}

/* ============================================================
   SHOPIFY WRAPPER
   ============================================================ */

#shopify-section-{{ section.id }} {
  width: 100%;
  max-width: none;

  margin: 0;
  padding: 0;
}


/* ============================================================
   ROOT
   ============================================================ */

.usv--{{ uid }} {
  position: relative;
  isolation: isolate;

  width: 100%;

  padding:
    110px
    0
    120px;

  overflow: hidden;

  color: #f5f5f2;
  background: #050505;

  font-family:
    'Inter Tight',
    -apple-system,
    BlinkMacSystemFont,
    'Helvetica Neue',
    Arial,
    sans-serif;

  -webkit-font-smoothing:
    antialiased;
}


.usv--{{ uid }} *,
.usv--{{ uid }} *::before,
.usv--{{ uid }} *::after {
  box-sizing: border-box;
}


/* ============================================================
   BACKGROUND
   ============================================================ */

.usv--{{ uid }} .usv__grid-bg {
  position: absolute;
  inset: 0;
  z-index: 0;

  pointer-events: none;

  opacity: .35;

  background-image:
    linear-gradient(
      rgba(255,255,255,.023)
      1px,
      transparent
      1px
    ),

    linear-gradient(
      90deg,
      rgba(255,255,255,.023)
      1px,
      transparent
      1px
    );

  background-size:
    84px
    84px;

  mask-image:
    linear-gradient(
      to bottom,
      black,
      transparent 82%
    );

  -webkit-mask-image:
    linear-gradient(
      to bottom,
      black,
      transparent 82%
    );
}


.usv--{{ uid }} .usv__orb {
  position: absolute;
  z-index: 0;

  width: 550px;
  height: 550px;

  border-radius: 50%;

  filter:
    blur(130px);

  opacity: .09;

  pointer-events: none;
}


.usv--{{ uid }} .usv__orb--one {
  top: -230px;
  right: -100px;

  background:
    #f59e0b;
}


.usv--{{ uid }} .usv__orb--two {
  bottom: -260px;
  left: -120px;

  background:
    #7c3aed;
}


.usv--{{ uid }} .usv__top-line {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;

  height: 1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255,255,255,.12),
      transparent
    );
}


/* ============================================================
   SHELL
   ============================================================ */

.usv--{{ uid }} .usv__shell {
  position: relative;
  z-index: 2;

  width:
    min(
      calc(
        100% -
        64px
      ),
      1400px
    );

  margin:
    0
    auto;
}


/* ============================================================
   HEADER
   ============================================================ */

.usv--{{ uid }} .usv__header {
  margin-bottom: 70px;

  opacity: 0;

  filter:
    blur(12px);

  transform:
    translateY(40px);

  transition:
    opacity
    .9s
    cubic-bezier(.16,1,.3,1),

    filter
    .9s
    cubic-bezier(.16,1,.3,1),

    transform
    .9s
    cubic-bezier(.16,1,.3,1);
}


.usv--{{ uid }} .usv__header.is-visible {
  opacity: 1;

  filter: none;

  transform:
    translateY(0);
}


.usv--{{ uid }} .usv__header-top {
  margin-bottom: 34px;

  display: flex;
  justify-content: space-between;
  align-items: flex-start;

  gap: 30px;
}


.usv--{{ uid }} .usv__eyebrow {
  margin: 0;

  display: flex;
  align-items: center;

  gap: 11px;

  color:
    rgba(
      245,
      158,
      11,
      .84
    );

  font-size: 10px;
  font-weight: 600;
  letter-spacing: .22em;

  text-transform: uppercase;
}


.usv--{{ uid }} .usv__eyebrow-dot {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background:
    #f59e0b;

  box-shadow:
    0
    0
    0
    5px
    rgba(245,158,11,.07);

  animation:
    usv-dot-pulse-{{ uid }}
    2.2s
    ease-in-out
    infinite;
}


@keyframes usv-dot-pulse-{{ uid }} {

  0%,
  100% {
    opacity: .4;
    transform: scale(.8);
  }

  50% {
    opacity: 1;
    transform: scale(1);
  }

}


.usv--{{ uid }} .usv__service-count {
  display: flex;
  align-items: flex-start;

  gap: 10px;
}


.usv--{{ uid }} .usv__service-count strong {
  font-size: 34px;
  font-weight: 500;
  line-height: .82;
  letter-spacing: -.055em;
}


.usv--{{ uid }} .usv__service-count span {
  color:
    rgba(
      255,
      255,
      255,
      .35
    );

  font-size: 8px;
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: .12em;

  text-transform: uppercase;
}


.usv--{{ uid }} .usv__header-grid {
  display: grid;

  grid-template-columns:
    minmax(0, 1.3fr)
    minmax(290px, .7fr);

  align-items: end;

  gap:
    clamp(
      50px,
      7vw,
      110px
    );
}


.usv--{{ uid }} .usv__title {
  margin: 0;

  color: #ffffff;

  font-size:
    clamp(
      56px,
      7.6vw,
      118px
    );

  font-weight: 650;
  line-height: .85;
  letter-spacing: -.06em;

  text-transform: uppercase;
}


.usv--{{ uid }} .usv__title span,
.usv--{{ uid }} .usv__title em {
  display: block;
}


.usv--{{ uid }} .usv__title em {
  color: transparent;

  background:
    linear-gradient(
      95deg,
      #fbbf24,
      #f97316,
      #fbbf24
    );

  background-size:
    200%
    100%;

  -webkit-background-clip:
    text;

  background-clip:
    text;

  font-weight: 400;
  font-style: normal;

  animation:
    usv-title-shift-{{ uid }}
    7s
    linear
    infinite;
}


@keyframes usv-title-shift-{{ uid }} {

  from {
    background-position:
      100%
      0;
  }

  to {
    background-position:
      -100%
      0;
  }

}


.usv--{{ uid }} .usv__header-copy > p {
  max-width: 37ch;

  margin:
    0
    0
    26px;

  color:
    rgba(
      255,
      255,
      255,
      .46
    );

  font-size: 15px;
  line-height: 1.6;
}


.usv--{{ uid }} .usv__header-key {
  padding:
    13px
    0;

  display: grid;

  grid-template-columns:
    1fr
    1fr;

  gap:
    8px
    18px;

  border-top:
    1px
    solid
    rgba(255,255,255,.09);

  border-bottom:
    1px
    solid
    rgba(255,255,255,.09);

  color:
    rgba(
      255,
      255,
      255,
      .30
    );

  font-size: 8px;
  font-weight: 600;
  letter-spacing: .12em;

  text-transform: uppercase;
}


/* ============================================================
   VIEWPORT
   ============================================================ */

.usv--{{ uid }} .usv__viewport {
  position: relative;
}


/* ============================================================
   DESKTOP CARDS
   ============================================================ */

.usv--{{ uid }} .usv__cards {
  display: grid;

  grid-template-columns:
    repeat(
      4,
      minmax(0, 1fr)
    );

  gap: 14px;
}


.usv--{{ uid }} .usv__card {
  --usv-x: 50%;
  --usv-y: 50%;
  --usv-rx: 0deg;
  --usv-ry: 0deg;

  position: relative;
  isolation: isolate;

  min-height: 430px;

  padding:
    28px
    26px
    22px;

  display: flex;
  flex-direction: column;

  overflow: hidden;

  border:
    1px
    solid
    rgba(255,255,255,.09);

  border-radius: 18px;

  background:
    rgba(
      255,
      255,
      255,
      .018
    );

  opacity: 0;

  filter:
    blur(10px);

  transform:
    perspective(900px)
    rotateX(var(--usv-rx))
    rotateY(var(--usv-ry))
    translateY(36px);

  transform-style:
    preserve-3d;

  transition:
    opacity
    .75s
    cubic-bezier(.16,1,.3,1)
    var(--usv-delay),

    filter
    .75s
    cubic-bezier(.16,1,.3,1)
    var(--usv-delay),

    transform
    .5s
    cubic-bezier(.16,1,.3,1),

    border-color
    .35s
    ease,

    background
    .35s
    ease;
}


.usv--{{ uid }} .usv__card.is-visible {
  opacity: 1;

  filter: none;

  transform:
    perspective(900px)
    rotateX(var(--usv-rx))
    rotateY(var(--usv-ry))
    translateY(0);
}


.usv--{{ uid }} .usv__card:hover {
  border-color:
    rgba(
      255,
      255,
      255,
      .20
    );

  background:
    rgba(
      255,
      255,
      255,
      .035
    );
}


/* ============================================================
   CARD GRADIENTS
   ============================================================ */

.usv--{{ uid }} .usv__card--amber_orange {
  --usv-color-one: #f59e0b;
  --usv-color-two: #f97316;
}


.usv--{{ uid }} .usv__card--purple_pink {
  --usv-color-one: #a855f7;
  --usv-color-two: #ec4899;
}


.usv--{{ uid }} .usv__card--blue_cyan {
  --usv-color-one: #3b82f6;
  --usv-color-two: #06b6d4;
}


.usv--{{ uid }} .usv__card--emerald_teal {
  --usv-color-one: #10b981;
  --usv-color-two: #14b8a6;
}


/* ============================================================
   CARD BACKGROUND EFFECTS
   ============================================================ */

.usv--{{ uid }} .usv__card-glow {
  position: absolute;
  inset: 0;
  z-index: -1;

  opacity: 0;

  background:
    radial-gradient(
      360px
      circle
      at
      var(--usv-x)
      var(--usv-y),

      color-mix(
        in srgb,
        var(--usv-color-one) 17%,
        transparent
      ),

      transparent 56%
    );

  transition:
    opacity
    .3s
    ease;
}


.usv--{{ uid }} .usv__card:hover .usv__card-glow {
  opacity: 1;
}


.usv--{{ uid }} .usv__card-grid {
  position: absolute;
  inset: 0;
  z-index: -2;

  opacity: .18;

  background-image:
    linear-gradient(
      rgba(255,255,255,.03)
      1px,
      transparent
      1px
    ),

    linear-gradient(
      90deg,
      rgba(255,255,255,.03)
      1px,
      transparent
      1px
    );

  background-size:
    40px
    40px;

  mask-image:
    linear-gradient(
      135deg,
      black,
      transparent 72%
    );

  -webkit-mask-image:
    linear-gradient(
      135deg,
      black,
      transparent 72%
    );
}


/* ============================================================
   CARD TOP
   ============================================================ */

.usv--{{ uid }} .usv__card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 20px;
}


.usv--{{ uid }} .usv__icon-wrap {
  position: relative;

  width: 58px;
  height: 58px;

  display: grid;
  place-items: center;
}


.usv--{{ uid }} .usv__icon {
  position: relative;
  z-index: 2;

  width: 48px;
  height: 48px;

  display: grid;
  place-items: center;

  border-radius: 14px;

  color: #ffffff;

  background:
    linear-gradient(
      135deg,
      var(--usv-color-one),
      var(--usv-color-two)
    );

  box-shadow:
    0
    16px
    40px
    -20px
    var(--usv-color-one);

  transition:
    transform
    .5s
    cubic-bezier(.16,1,.3,1);
}


.usv--{{ uid }} .usv__icon-orbit {
  position: absolute;
  inset: 0;

  border:
    1px
    solid
    color-mix(
      in srgb,
      var(--usv-color-one) 30%,
      transparent
    );

  border-radius: 18px;

  opacity: .55;

  transform:
    rotate(8deg);

  transition:
    transform
    .65s
    cubic-bezier(.16,1,.3,1);
}


.usv--{{ uid }} .usv__card:hover .usv__icon {
  transform:
    scale(1.07)
    rotate(-4deg);
}


