{% comment %} Gallery Icons Stats: header (badge + gradient title), grid of service cards with icon, description, two stats each. {% endcomment %}
{% assign card_blocks = section.blocks | where: 'type', 'card' %}
<section class="relative py-16 lg:py-24 bg-black">
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12 relative z-10">
    <div class="text-center mb-16">
      {% if section.settings.badge != blank %}
        <span class="text-[10px] font-medium text-amber-400 tracking-[0.3em] uppercase block mb-4">{{ section.settings.badge }}</span>
      {% endif %}
      {% if section.settings.title_before != blank or section.settings.title_gradient != blank %}
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
          {{ section.settings.title_before }}
          {% if section.settings.title_gradient != blank %}
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-orange-400">{{ section.settings.title_gradient }}</span>
          {% endif %}
        </h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <p class="text-white/50 max-w-2xl mx-auto">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {% for block in card_blocks %}
        {% assign g = block.settings.gradient %}
        <div class="group relative" {{ block.shopify_attributes }}>
          {% if g == 'amber_orange' %}
            <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-amber-500 to-orange-500 opacity-0 group-hover:opacity-10 blur-xl transition-all duration-500" aria-hidden="true"></div>
          {% elsif g == 'purple_pink' %}
            <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-purple-500 to-pink-500 opacity-0 group-hover:opacity-10 blur-xl transition-all duration-500" aria-hidden="true"></div>
          {% elsif g == 'blue_cyan' %}
            <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-blue-500 to-cyan-500 opacity-0 group-hover:opacity-10 blur-xl transition-all duration-500" aria-hidden="true"></div>
          {% elsif g == 'emerald_teal' %}
            <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-500 opacity-0 group-hover:opacity-10 blur-xl transition-all duration-500" aria-hidden="true"></div>
          {% else %}
            <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-amber-500 to-orange-500 opacity-0 group-hover:opacity-10 blur-xl transition-all duration-500" aria-hidden="true"></div>
          {% endif %}
          <div class="relative p-8 rounded-2xl bg-white/[0.02] border border-white/10 group-hover:border-white/20 transition-all duration-300 h-full">
            {% if g == 'amber_orange' %}
              <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-amber-500 to-orange-500 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            {% elsif g == 'purple_pink' %}
              <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            {% elsif g == 'blue_cyan' %}
              <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-blue-500 to-cyan-500 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            {% elsif g == 'emerald_teal' %}
              <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-500 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            {% else %}
              <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-amber-500 to-orange-500 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            {% endif %}
              {% case block.settings.icon %}
                {% when 'camera' %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7 text-white" aria-hidden="true"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"></path><circle cx="12" cy="13" r="3"></circle></svg>
                {% when 'video' %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7 text-white" aria-hidden="true"><path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"></path><rect x="2" y="6" width="14" height="12" rx="2"></rect></svg>
                {% when 'palette' %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7 text-white" aria-hidden="true"><path d="M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z"></path><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle></svg>
                {% when 'target' %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7 text-white" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
                {% else %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-7 h-7 text-white"><circle cx="12" cy="12" r="10"></circle></svg>
              {% endcase %}
            </div>
            {% if block.settings.title != blank %}
              <h3 class="text-xl font-bold text-white mb-3">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <p class="text-white/50 text-sm leading-relaxed mb-6">{{ block.settings.description }}</p>
            {% endif %}
            <div class="flex gap-6 pt-4 border-t border-white/10">
              {% if block.settings.stat1_number != blank or block.settings.stat1_label != blank %}
                <div>
                  {% if block.settings.stat1_number != blank %}
                    <div class="text-2xl font-bold text-white">{{ block.settings.stat1_number }}</div>
                  {% endif %}
                  {% if block.settings.stat1_label != blank %}
                    <div class="text-white/40 text-xs">{{ block.settings.stat1_label }}</div>
                  {% endif %}
                </div>
              {% endif %}
              {% if block.settings.stat2_number != blank or block.settings.stat2_label != blank %}
                <div>
                  {% if block.settings.stat2_number != blank %}
                    <div class="text-2xl font-bold text-white">{{ block.settings.stat2_number }}</div>
                  {% endif %}
                  {% if block.settings.stat2_label != blank %}
                    <div class="text-white/40 text-xs">{{ block.settings.stat2_label }}</div>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gallery Icons Stats",
  "tag": "section",
  "class": "section-gallery-icons-stats",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge (small label above title)",
      "default": "(What We Do)"
    },
    {
      "type": "text",
      "id": "title_before",
      "label": "Title (before gradient part)",
      "default": "Why Brands "
    },
    {
      "type": "text",
      "id": "title_gradient",
      "label": "Title (gradient part)",
      "default": "Choose Us"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "We transform brand visions into visual experiences that captivate, engage, and convert."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Service card",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "gradient",
          "label": "Card & icon gradient",
          "options": [
            { "value": "amber_orange", "label": "Amber / Orange" },
            { "value": "purple_pink", "label": "Purple / Pink" },
            { "value": "blue_cyan", "label": "Blue / Cyan" },
            { "value": "emerald_teal", "label": "Emerald / Teal" }
          ],
          "default": "amber_orange"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "camera", "label": "Camera" },
            { "value": "video", "label": "Video" },
            { "value": "palette", "label": "Palette" },
            { "value": "target", "label": "Target" }
          ],
          "default": "camera"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card title",
          "default": "Brand Photography"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Capturing the essence of your brand through stunning visual storytelling that resonates with your audience."
        },
        {
          "type": "text",
          "id": "stat1_number",
          "label": "Stat 1 number",
          "default": "500+"
        },
        {
          "type": "text",
          "id": "stat1_label",
          "label": "Stat 1 label",
          "default": "Shoots"
        },
        {
          "type": "text",
          "id": "stat2_number",
          "label": "Stat 2 number",
          "default": "50+"
        },
        {
          "type": "text",
          "id": "stat2_label",
          "label": "Stat 2 label",
          "default": "Brands"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gallery Icons Stats",
      "settings": {
        "badge": "(What We Do)",
        "title_before": "Why Brands ",
        "title_gradient": "Choose Us",
        "subtitle": "We transform brand visions into visual experiences that captivate, engage, and convert."
      },
      "blocks": [
        { "type": "card", "settings": { "gradient": "amber_orange", "icon": "camera", "title": "Brand Photography", "description": "Capturing the essence of your brand through stunning visual storytelling that resonates with your audience.", "stat1_number": "500+", "stat1_label": "Shoots", "stat2_number": "50+", "stat2_label": "Brands" } },
        { "type": "card", "settings": { "gradient": "purple_pink", "icon": "video", "title": "Video Production", "description": "From concept to delivery, we create cinematic content that elevates your brand and drives engagement.", "stat1_number": "200+", "stat1_label": "Videos", "stat2_number": "10M+", "stat2_label": "Views" } },
        { "type": "card", "settings": { "gradient": "blue_cyan", "icon": "palette", "title": "Creative Direction", "description": "Strategic creative vision that aligns every visual element with your brand story and business goals.", "stat1_number": "100+", "stat1_label": "Campaigns", "stat2_number": "30%", "stat2_label": "Avg ROI Lift" } },
        { "type": "card", "settings": { "gradient": "emerald_teal", "icon": "target", "title": "Event Coverage", "description": "Immersive event documentation that captures the energy, emotion, and impact of your activations.", "stat1_number": "75+", "stat1_label": "Events", "stat2_number": "25+", "stat2_label": "Countries" } }
      ]
    }
  ]
}
{% endschema %}
