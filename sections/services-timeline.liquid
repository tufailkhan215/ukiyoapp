{% comment %} Two-column: left sticky heading (strap + gradient title + subtitle), right vertical timeline of steps. {% endcomment %}
<section class="relative py-20 lg:py-28 bg-black" data-testid="services-timeline">
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  <div class="relative z-10 max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24">
      <div class="lg:sticky lg:top-32 lg:self-start">
        {% if section.settings.strap != blank %}
          <span class="text-[10px] font-medium text-white/40 tracking-[0.3em] uppercase block mb-6">{{ section.settings.strap }}</span>
        {% endif %}
        {% if section.settings.title_before != blank or section.settings.title_gradient != blank %}
          <h2 class="text-3xl md:text-4xl font-bold text-white leading-[1.1] mb-8">
            {{ section.settings.title_before }}
            {% if section.settings.title_gradient != blank %}
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-gray-400 to-gray-600">{{ section.settings.title_gradient }}</span>
            {% endif %}
          </h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="text-base text-white/40 leading-relaxed">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>

      <div>
        {% for block in section.blocks %}
          {% if block.type == 'step' %}
            {% assign num = forloop.index | prepend: '00' | slice: -2, 2 %}
            {% assign is_last = false %}
            {% if forloop.last %}
              {% assign is_last = true %}
            {% endif %}
            <div class="relative" {{ block.shopify_attributes }}>
              <div class="flex gap-8">
                <div class="flex flex-col items-center">
                  <div class="w-14 h-14 rounded-full bg-white/[0.03] border border-white/10 flex items-center justify-center text-white font-bold text-lg flex-shrink-0" aria-hidden="true">{{ num }}</div>
                  {% unless is_last %}
                    <div class="w-px h-full bg-white/10 my-4" aria-hidden="true"></div>
                  {% endunless %}
                </div>
                <div class="pb-12">
                  {% if block.settings.title != blank %}
                    <h4 class="text-xl font-bold text-white mb-2">{{ block.settings.title }}</h4>
                  {% endif %}
                  {% if block.settings.description != blank %}
                    <p class="text-white/40 leading-relaxed max-w-md">{{ block.settings.description }}</p>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Services Timeline",
  "tag": "section",
  "class": "section-services-timeline",
  "settings": [
    {
      "type": "text",
      "id": "strap",
      "label": "Strap (small label above title)",
      "default": "(Our Process)"
    },
    {
      "type": "text",
      "id": "title_before",
      "label": "Title (before gradient part)",
      "default": "How We "
    },
    {
      "type": "text",
      "id": "title_gradient",
      "label": "Title (gradient part)",
      "default": "Deliver"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle below heading",
      "default": "Our proven process ensures exceptional results every time."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services Timeline",
      "settings": {
        "strap": "(Our Process)",
        "title_before": "How We ",
        "title_gradient": "Deliver",
        "subtitle": "Our proven process ensures exceptional results every time."
      },
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Discovery Workshop",
            "description": "Deep dive into your brand voice, values, customer journey, and business objectives"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Knowledge Mapping",
            "description": "Document all products, services, FAQs, policies, and brand guidelines comprehensively"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Agent Development",
            "description": "Build and train your custom AI agent with your unique brand DNA and personality"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Testing & Refinement",
            "description": "Rigorous testing across scenarios, edge cases, and real customer interactions"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Deployment & Integration",
            "description": "Launch across your chosen channels with full monitoring and support"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Continuous Optimization",
