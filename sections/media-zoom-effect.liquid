{% comment %}
  ┌─────────────────────────────────────────────────────────────────┐
  │  MEDIA ZOOM EFFECT v2 — UkiyoProd                              │
  │  Sticky header + asymmetric media grid with zoom-on-hover      │
  │  Version: 2.0.0                                                 │
  └─────────────────────────────────────────────────────────────────┘
{% endcomment %}

{%- liquid
  assign section_id  = 'mze-' | append: section.id
  assign layout_mode = section.settings.layout_mode
-%}

<style>
  #{{ section_id }} {
    --mz-bg:      {{ section.settings.bg_color }};
    --mz-surface: rgba(255,255,255,0.06);
    --mz-border:  rgba(255,255,255,0.12);
    --mz-text:    {{ section.settings.text_color }};
    --mz-muted:   rgba(255,255,255,0.68);
    --mz-radius:  18px;
    --mz-gap:     clamp(14px,2vw,22px);
    --mz-pad-y:   clamp(44px,6vw,96px);
    --mz-max:     {{ section.settings.max_width }}px;
    --mz-zoom:    {{ section.settings.zoom_scale | divided_by: 100.0 }};
    --mz-shadow:  0 18px 40px rgba(0,0,0,0.38);
    --mz-dur:     {{ section.settings.zoom_duration }}ms;
    --mz-ease:    cubic-bezier(.2,.7,.1,1);
  }

  #{{ section_id }} *, #{{ section_id }} *::before, #{{ section_id }} *::after {
    box-sizing: border-box; margin: 0; padding: 0;
  }

  #{{ section_id }} {
    padding: var(--mz-pad-y) 0;
    background:
      radial-gradient(1200px 500px at 30% 10%, rgba(70,120,255,0.12), transparent 55%),
      radial-gradient(900px 400px at 80% 40%, rgba(0,255,200,0.07), transparent 55%),
      var(--mz-bg);
    color: var(--mz-text);
    font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    overflow: hidden;
  }

  /* ── CONTAINER: sticky header left + grid right ──────────── */
  #{{ section_id }} .mz-container {
    width: min(var(--mz-max), calc(100% - 40px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.95fr 1.25fr;
    gap: clamp(22px,4vw,60px);
    align-items: start;
  }

  /* ── STICKY HEADER ───────────────────────────────────────── */
  #{{ section_id }} .mz-header {
    position: sticky;
    top: 24px;
  }

  #{{ section_id }} .mz-eyebrow {
    letter-spacing: .12em;
    text-transform: uppercase;
    font-size: 12px;
    color: var(--mz-muted);
    margin-bottom: 10px;
  }

  #{{ section_id }} .mz-title {
    font-size: clamp(26px, 3.2vw, 40px);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -.02em;
    margin-bottom: 12px;
  }
  #{{ section_id }} .mz-title em {
    font-style: normal;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255,255,255,.7);
  }

  #{{ section_id }} .mz-subtitle {
    color: var(--mz-muted);
    line-height: 1.65;
    max-width: 46ch;
    margin-bottom: 18px;
    font-size: .95rem;
  }

  #{{ section_id }} .mz-bullets {
    padding-left: 18px;
    color: var(--mz-muted);
    display: grid;
    gap: 8px;
    font-size: .9rem;
    margin-bottom: 20px;
  }

  /* layout switcher note box */
  #{{ section_id }} .mz-note {
    padding: 14px;
    background: var(--mz-surface);
    border: 1px solid var(--mz-border);
    border-radius: 14px;
    color: var(--mz-muted);
    display: grid;
    gap: 10px;
    font-size: .8rem;
  }

  #{{ section_id }} .mz-pill-sm {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid var(--mz-border);
    background: rgba(255,255,255,.04);
    color: rgba(255,255,255,.8);
    font-size: 11px;
  }

  /* layout pill buttons */
  #{{ section_id }} .mz-layout-pills {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
    margin-top: 1.2rem;
  }
  #{{ section_id }} .mz-layout-btn {
    padding: .4rem .9rem;
    border-radius: 999px;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    border: 1px solid var(--mz-border);
    background: transparent;
    color: var(--mz-muted);
    cursor: pointer;
    transition: all .25s ease;
  }
  #{{ section_id }} .mz-layout-btn.is-active,
  #{{ section_id }} .mz-layout-btn:hover {
    background: rgba(255,255,255,.12);
    border-color: rgba(255,255,255,.3);
    color: rgba(255,255,255,.9);
  }

  /* ── GRID ────────────────────────────────────────────────── */
  #{{ section_id }} .mz-grid {
    display: grid;
    gap: var(--mz-gap);
  }

  /* Layout 1: Asymmetric (hero left tall + 3 right) */
  #{{ section_id }} .mz-grid.mz-layout-1 {
    grid-template-columns: 1.2fr 0.8fr;
    grid-template-areas:
      "a b"
      "a c"
      "d c";
  }
  #{{ section_id }} .mz-layout-1 .mz-a { grid-area: a; }
  #{{ section_id }} .mz-layout-1 .mz-b { grid-area: b; }
  #{{ section_id }} .mz-layout-1 .mz-c { grid-area: c; }
  #{{ section_id }} .mz-layout-1 .mz-d { grid-area: d; }
  #{{ section_id }} .mz-layout-1 .mz-a .mz-media { aspect-ratio: 4/5; }
  #{{ section_id }} .mz-layout-1 .mz-b .mz-media { aspect-ratio: 16/10; }
  #{{ section_id }} .mz-layout-1 .mz-c .mz-media { aspect-ratio: 3/4; }
  #{{ section_id }} .mz-layout-1 .mz-d .mz-media { aspect-ratio: 16/10; }

  /* Layout 2: Editorial strip + two cards */
  #{{ section_id }} .mz-grid.mz-layout-2 {
    grid-template-columns: 1fr 1fr;
    grid-template-areas:
      "a a"
      "b c"
      "d c";
  }
  #{{ section_id }} .mz-layout-2 .mz-a { grid-area: a; }
  #{{ section_id }} .mz-layout-2 .mz-b { grid-area: b; }
  #{{ section_id }} .mz-layout-2 .mz-c { grid-area: c; }
  #{{ section_id }} .mz-layout-2 .mz-d { grid-area: d; }
  #{{ section_id }} .mz-layout-2 .mz-a .mz-media { aspect-ratio: 21/9; }
  #{{ section_id }} .mz-layout-2 .mz-c .mz-media { aspect-ratio: 4/5; }

  /* Layout 3: Masonry tall right */
  #{{ section_id }} .mz-grid.mz-layout-3 {
    grid-template-columns: 1fr 1fr;
    grid-template-areas:
      "a b"
      "c b"
      "c d";
  }
  #{{ section_id }} .mz-layout-3 .mz-a { grid-area: a; }
  #{{ section_id }} .mz-layout-3 .mz-b { grid-area: b; }
  #{{ section_id }} .mz-layout-3 .mz-c { grid-area: c; }
  #{{ section_id }} .mz-layout-3 .mz-d { grid-area: d; }
  #{{ section_id }} .mz-layout-3 .mz-b .mz-media { aspect-ratio: 4/6; }
  #{{ section_id }} .mz-layout-3 .mz-c .mz-media { aspect-ratio: 16/10; }

  /* ── CARD ────────────────────────────────────────────────── */
  #{{ section_id }} .mz-card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--mz-radius);
    border: 1px solid var(--mz-border);
    background: rgba(255,255,255,.03);
    box-shadow: 0 0 0 rgba(0,0,0,0);
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
    text-decoration: none;
    color: inherit;
    isolation: isolate;
  }

  #{{ section_id }} .mz-card::before {
    content: '';
    position: absolute; inset: 0;
    background:
      radial-gradient(900px 380px at 20% 20%, rgba(255,255,255,.10), transparent 55%),
      linear-gradient(to bottom, rgba(0,0,0,.15), rgba(0,0,0,.55));
    opacity: .85;
    z-index: 1;
    pointer-events: none;
  }

  #{{ section_id }} .mz-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--mz-shadow);
    border-color: rgba(255,255,255,.22);
  }

  #{{ section_id }} .mz-card:focus-visible {
    outline: 3px solid rgba(70,120,255,.55);
    outline-offset: 3px;
  }

  /* ── MEDIA + ZOOM ────────────────────────────────────────── */
  #{{ section_id }} .mz-media {
    aspect-ratio: 4/3;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  #{{ section_id }} .mz-media img,
  #{{ section_id }} .mz-media .mz-placeholder {
    width: 100%; height: 100%;
    object-fit: cover;
    transform: scale(1);
    transition: transform var(--mz-dur) var(--mz-ease);
    will-change: transform;
    display: block;
  }

  #{{ section_id }} .mz-placeholder {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  }

  #{{ section_id }} .mz-card:hover .mz-media img,
  #{{ section_id }} .mz-card:hover .mz-media .mz-placeholder {
    transform: scale(var(--mz-zoom));
  }

  /* ── OVERLAY TEXT ────────────────────────────────────────── */
  #{{ section_id }} .mz-overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: 16px;
    z-index: 2;
    display: grid;
    gap: 6px;
  }

  #{{ section_id }} .mz-tag {
    width: fit-content;
    padding: 5px 10px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,.18);
    background: rgba(0,0,0,.25);
    backdrop-filter: blur(8px);
    color: rgba(255,255,255,.85);
    font-size: 12px;
    letter-spacing: .02em;
    transition: background .25s;
  }
  #{{ section_id }} .mz-card:hover .mz-tag {
    background: rgba(0,0,0,.45);
  }

  #{{ section_id }} .mz-card-title {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
    color: rgba(255,255,255,.92);
  }

  /* ── RESPONSIVE ──────────────────────────────────────────── */
  @media (max-width: 960px) {
    #{{ section_id }} .mz-container { grid-template-columns: 1fr; }
    #{{ section_id }} .mz-header { position: static; }
  }

  @media (max-width: 640px) {
    #{{ section_id }} .mz-grid.mz-layout-1,
    #{{ section_id }} .mz-grid.mz-layout-2,
    #{{ section_id }} .mz-grid.mz-layout-3 {
      grid-template-columns: 1fr;
      grid-template-areas: "a" "b" "c" "d";
    }
    #{{ section_id }} .mz-media { aspect-ratio: 4/3 !important; }
  }

  /* ── REVEAL ──────────────────────────────────────────────── */
  @media (prefers-reduced-motion: no-preference) {
    #{{ section_id }} .mz-reveal { opacity: 0; transform: translateY(20px); }
    #{{ section_id }} .mz-reveal.is-in { animation: mze-up .75s cubic-bezier(.16,1,.3,1) forwards; }
    #{{ section_id }} .mz-reveal.d1 { animation-delay: .1s; }
    #{{ section_id }} .mz-reveal.d2 { animation-delay: .2s; }
    #{{ section_id }} .mz-card { opacity: 0; transform: translateY(16px); transition: opacity .6s ease, transform .6s ease, box-shadow 220ms ease, border-color 220ms ease; }
    #{{ section_id }} .mz-card.is-in { opacity: 1; transform: translateY(0); }
    #{{ section_id }} .mz-card.is-in:hover { transform: translateY(-2px); }
    #{{ section_id }} .mz-card:nth-child(1) { transition-delay: .05s; }
    #{{ section_id }} .mz-card:nth-child(2) { transition-delay: .12s; }
    #{{ section_id }} .mz-card:nth-child(3) { transition-delay: .19s; }
    #{{ section_id }} .mz-card:nth-child(4) { transition-delay: .26s; }
    @keyframes mze-up { to { opacity: 1; transform: none; } }
  }
</style>

<section id="{{ section_id }}" class="media-zoom-effect" data-section-id="{{ section.id }}">
  <div class="mz-container">

    <!-- STICKY HEADER -->
    <header class="mz-header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="mz-eyebrow mz-reveal">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="mz-title mz-reveal d1">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="mz-subtitle mz-reveal d2">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.show_bullets -%}
        <ul class="mz-bullets mz-reveal d2">
          {%- if section.settings.bullet_1 != blank -%}<li>{{ section.settings.bullet_1 }}</li>{%- endif -%}
          {%- if section.settings.bullet_2 != blank -%}<li>{{ section.settings.bullet_2 }}</li>{%- endif -%}
          {%- if section.settings.bullet_3 != blank -%}<li>{{ section.settings.bullet_3 }}</li>{%- endif -%}
          {%- if section.settings.bullet_4 != blank -%}<li>{{ section.settings.bullet_4 }}</li>{%- endif -%}
        </ul>
      {%- endif -%}

      <div class="mz-layout-pills mz-reveal d2" data-mze-pills>
        <button class="mz-layout-btn {% if layout_mode == '1' %}is-active{% endif %}" data-mode="1">Asymmetric</button>
        <button class="mz-layout-btn {% if layout_mode == '2' %}is-active{% endif %}" data-mode="2">Editorial</button>
        <button class="mz-layout-btn {% if layout_mode == '3' %}is-active{% endif %}" data-mode="3">Masonry</button>
      </div>
    </header>

    <!-- MEDIA GRID -->
    <div class="mz-grid mz-layout-{{ layout_mode }}" data-mze-grid>

      {%- assign slots = 'a,b,c,d' | split: ',' -%}
      {%- for slot in slots -%}
        {%- assign block = section.blocks[forloop.index0] -%}
        <a
          class="mz-card mz-{{ slot }}"
          href="{{ block.settings.link | default: '#' }}"
          aria-label="{{ block.settings.title | default: 'View media' | escape }}"
          {% if block.settings.link == blank %}tabindex="0"{% endif %}
          {{ block.shopify_attributes }}
        >
          <div class="mz-media">
            {%- if block.settings.image -%}
              <img
                src="{{ block.settings.image | image_url: width: 1200 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
              >
            {%- else -%}
              <div class="mz-placeholder"></div>
            {%- endif -%}
          </div>
          <div class="mz-overlay">
            {%- if block.settings.tag != blank -%}
              <span class="mz-tag">{{ block.settings.tag }}</span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="mz-card-title">{{ block.settings.title }}</h3>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}

    </div>
  </div>
</section>

<script>
(function() {
  var sec  = document.getElementById('{{ section_id }}');
  if (!sec) return;

  var grid  = sec.querySelector('[data-mze-grid]');
  var pills = sec.querySelectorAll('[data-mze-pills] .mz-layout-btn');

  /* ── Layout switcher ───────────────────────────────────── */
  pills.forEach(function(btn) {
    btn.addEventListener('click', function() {
      pills.forEach(function(b) { b.classList.remove('is-active'); });
      btn.classList.add('is-active');
      var base = grid.className.replace(/mz-layout-\d/g, '').trim();
      grid.className = base + ' mz-layout-' + btn.dataset.mode;
      sec.querySelectorAll('.mz-card').forEach(function(c) {
        c.classList.remove('is-in');
        requestAnimationFrame(function() { c.classList.add('is-in'); });
      });
    });
  });

  /* ── Scroll reveal ─────────────────────────────────────── */
  var obs = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) { e.target.classList.add('is-in'); obs.unobserve(e.target); }
    });
  }, { threshold: .08 });

  sec.querySelectorAll('.mz-reveal, .mz-card').forEach(function(el) { obs.observe(el); });
})();
</script>

{% schema %}
{
  "name": "Media Zoom Effect",
  "tag": "section",
  "class": "media-zoom-effect-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Default layout",
      "options": [
        { "value": "1", "label": "Asymmetric (hero left)" },
        { "value": "2", "label": "Editorial (strip top)" },
        { "value": "3", "label": "Masonry (tall right)" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width (px)",
"min": 800, "max": 1400, "step": 40, "default": 1200    },
    {
      "type": "header",
      "content": "Zoom"
    },
    {
      "type": "range",
      "id": "zoom_scale",
      "label": "Zoom scale (%)",
      "min": 105, "max": 140, "step": 5, "default": 110
    },
    {
      "type": "range",
      "id": "zoom_duration",
      "label": "Zoom duration (ms)",
"min": 200, "max": 1000, "step": 100, "default": 500    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Visual Stories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every detail matters"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Create an interactive, premium feel by showcasing details with an asymmetrical media grid."
    },
    {
      "type": "checkbox",
      "id": "show_bullets",
      "label": "Show bullet points",
      "default": true
    },
    {
      "type": "text",
      "id": "bullet_1",
      "label": "Bullet 1",
      "default": "Zoom on hover effect"
    },
    {
      "type": "text",
      "id": "bullet_2",
      "label": "Bullet 2",
      "default": "Strong visual hierarchy"
    },
    {
      "type": "text",
      "id": "bullet_3",
      "label": "Bullet 3",
      "default": "Multiple layout modes"
    },
    {
      "type": "text",
      "id": "bullet_4",
      "label": "Bullet 4",
      "default": "Editorial spacing"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#0b0d10"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#f0f0f0"
    }
  ],
  "blocks": [
    {
      "type": "media_item",
      "name": "Media item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Feature"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Media Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media Zoom Effect",
      "blocks": [
        { "type": "media_item", "settings": { "tag": "Feature", "title": "Hero visual" } },
        { "type": "media_item", "settings": { "tag": "Detail", "title": "Close-up" } },
        { "type": "media_item", "settings": { "tag": "Texture", "title": "Materials" } },
        { "type": "media_item", "settings": { "tag": "Use", "title": "In action" } }
      ]
    }
  ]
}
{% endschema %}
