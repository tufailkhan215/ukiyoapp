{% comment %}
  ┌─────────────────────────────────────────────────────────────────┐
  │  MEDIA ZOOM EFFECT — UkiyoProd                                  │
  │  Asymmetric media grid with zoom-on-hover effects              │
  │  Version: 1.0.0                                                 │
  └─────────────────────────────────────────────────────────────────┘
{% endcomment %}

{%- liquid
  assign section_id  = 'mze-' | append: section.id
  assign layout_mode = section.settings.layout_mode
  assign kicker      = section.settings.kicker
  assign heading     = section.settings.heading
  assign subheading  = section.settings.subheading
  assign items       = section.blocks
-%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;700;900&display=swap');

  #{{ section_id }} {
    --bg:       {{ section.settings.bg_color }};
    --accent:   {{ section.settings.accent_color }};
    --card-bg:  {{ section.settings.card_bg_color }};
    --text:     {{ section.settings.text_color }};
    --muted:    {{ section.settings.text_color | color_mix: section.settings.bg_color, 38 }};
    --border:   {{ section.settings.text_color | color_mix: section.settings.bg_color, 10 }};
    --zoom:     {{ section.settings.zoom_scale | divided_by: 100.0 }};
    --radius:   {{ section.settings.border_radius }}px;
    --gap:      {{ section.settings.grid_gap }}px;
    --ease:     cubic-bezier(.25,1,.5,1);
    --dur:      {{ section.settings.zoom_duration }}ms;
  }

  #{{ section_id }} *, #{{ section_id }} *::before, #{{ section_id }} *::after {
    box-sizing: border-box; margin: 0; padding: 0;
  }

  #{{ section_id }} {
    background: var(--bg);
    color: var(--text);
    font-family: 'Outfit', sans-serif;
    padding: clamp(3.5rem, 8vw, 6rem) clamp(1.5rem, 5vw, 5rem);
    overflow: hidden;
  }

  #{{ section_id }} .mze-inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  /* ── HEADER ──────────────────────────────────────────────────── */
  #{{ section_id }} .mze-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    flex-wrap: wrap;
  }

  #{{ section_id }} .mze-kicker {
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--accent);
    display: flex;
    align-items: center;
    gap: .6rem;
    margin-bottom: .9rem;
  }
  #{{ section_id }} .mze-kicker::before {
    content: '';
    display: inline-block;
    width: 2rem; height: 1.5px;
    background: var(--accent);
  }

  #{{ section_id }} .mze-heading {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: -.04em;
  }
  #{{ section_id }} .mze-heading em {
    font-style: normal;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--accent);
  }

  #{{ section_id }} .mze-subheading {
    font-size: clamp(.85rem, 1.3vw, 1rem);
    color: var(--muted);
    line-height: 1.65;
    max-width: 38ch;
    font-weight: 300;
  }

  /* layout pills */
  #{{ section_id }} .mze-pills {
    display: flex;
    gap: .4rem;
    flex-shrink: 0;
  }
  #{{ section_id }} .mze-pill {
    padding: .45rem 1rem;
    border-radius: 999px;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: all .25s var(--ease);
  }
  #{{ section_id }} .mze-pill.is-active,
  #{{ section_id }} .mze-pill:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #000;
  }

  /* ── GRID ────────────────────────────────────────────────────── */
  #{{ section_id }} .mze-grid {
    display: grid;
    gap: var(--gap);
  }

  /* ASYMMETRIC — hero left + 2 right */
  #{{ section_id }} .mze-grid.mode--asymmetric {
    grid-template-columns: 1.6fr 1fr;
    grid-template-rows: auto;
  }
  #{{ section_id }} .mze-grid.mode--asymmetric .mze-cell:nth-child(1) {
    grid-row: span 2;
  }

  /* MAGAZINE — large top, 3 below */
  #{{ section_id }} .mze-grid.mode--magazine {
    grid-template-columns: repeat(3, 1fr);
  }
  #{{ section_id }} .mze-grid.mode--magazine .mze-cell:nth-child(1) {
    grid-column: span 3;
  }

  /* MOSAIC — 2 tall + 1 wide bottom */
  #{{ section_id }} .mze-grid.mode--mosaic {
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 240px;
  }
  #{{ section_id }} .mze-grid.mode--mosaic .mze-cell:nth-child(1) { grid-column: span 2; grid-row: span 2; }
  #{{ section_id }} .mze-grid.mode--mosaic .mze-cell:nth-child(2) { grid-column: span 2; }
  #{{ section_id }} .mze-grid.mode--mosaic .mze-cell:nth-child(3) { grid-column: span 2; }
  #{{ section_id }} .mze-grid.mode--mosaic .mze-cell:nth-child(4) { grid-column: span 2; grid-row: span 2; }
  #{{ section_id }} .mze-grid.mode--mosaic .mze-cell:nth-child(5) { grid-column: span 2; }
  #{{ section_id }} .mze-grid.mode--mosaic .mze-cell:nth-child(n+6) { grid-column: span 2; }

  /* GRID — even columns */
  #{{ section_id }} .mze-grid.mode--grid {
    grid-template-columns: repeat({{ section.settings.grid_cols }}, 1fr);
  }

  /* Responsive */
  @media (max-width: 900px) {
    #{{ section_id }} .mze-grid.mode--asymmetric { grid-template-columns: 1fr 1fr; }
    #{{ section_id }} .mze-grid.mode--asymmetric .mze-cell:nth-child(1) { grid-row: span 1; }
    #{{ section_id }} .mze-grid.mode--magazine { grid-template-columns: 1fr 1fr; }
    #{{ section_id }} .mze-grid.mode--magazine .mze-cell:nth-child(1) { grid-column: span 2; }
    #{{ section_id }} .mze-grid.mode--mosaic { grid-template-columns: 1fr 1fr; }
    #{{ section_id }} .mze-grid.mode--mosaic .mze-cell { grid-column: span 1 !important; grid-row: span 1 !important; }
    #{{ section_id }} .mze-grid.mode--grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    #{{ section_id }} .mze-grid { grid-template-columns: 1fr !important; }
    #{{ section_id }} .mze-grid .mze-cell { grid-column: span 1 !important; grid-row: span 1 !important; }
  }

  /* ── CELL ────────────────────────────────────────────────────── */
  #{{ section_id }} .mze-cell {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--card-bg);
    cursor: {% if section.settings.cursor_zoom %}zoom-in{% else %}pointer{% endif %};
    min-height: 240px;
    isolation: isolate;
  }

  /* ── ZOOM IMAGE ──────────────────────────────────────────────── */
  #{{ section_id }} .mze-img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transform-origin: center center;
    transform: scale(1);
    transition: transform var(--dur) var(--ease),
                filter var(--dur) var(--ease);
    will-change: transform;
  }

  /* ZOOM STYLES */
  {% if section.settings.zoom_style == 'standard' %}
    #{{ section_id }} .mze-cell:hover .mze-img {
      transform: scale(var(--zoom));
    }
  {% elsif section.settings.zoom_style == 'tilt' %}
    #{{ section_id }} .mze-cell:hover .mze-img {
      transform: scale(var(--zoom)) rotate(2deg);
    }
  {% elsif section.settings.zoom_style == 'kenburns' %}
    #{{ section_id }} .mze-cell:hover .mze-img {
      transform: scale(var(--zoom)) translate(2%, -2%);
    }
  {% elsif section.settings.zoom_style == 'reveal' %}
    #{{ section_id }} .mze-cell .mze-img {
      transform: scale(var(--zoom));
      filter: blur(4px);
    }
    #{{ section_id }} .mze-cell:hover .mze-img {
      transform: scale(1);
      filter: blur(0px);
    }
  {% endif %}

  /* Brightness dim on hover (unless reveal mode) */
  {% unless section.settings.zoom_style == 'reveal' %}
    #{{ section_id }} .mze-cell:hover .mze-img {
      filter: brightness({{ section.settings.hover_brightness | divided_by: 100.0 }});
    }
  {% endunless %}

  /* placeholder */
  #{{ section_id }} .mze-placeholder {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, var(--card-bg) 0%, #1c1c28 100%);
  }

  /* overlay */
  #{{ section_id }} .mze-overlay {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(to top, rgba(0,0,0,.85) 0%, transparent 55%);
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    transition: opacity .5s var(--ease);
  }
  #{{ section_id }} .mze-cell:hover .mze-overlay {
    opacity: {{ section.settings.overlay_opacity_hover | divided_by: 100.0 }};
  }

  /* content */
  #{{ section_id }} .mze-content {
    position: absolute; inset: 0; z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.6rem;
    transform: translateY(4px);
    transition: transform .5s var(--ease);
  }
  #{{ section_id }} .mze-cell:hover .mze-content {
    transform: translateY(0);
  }

  #{{ section_id }} .mze-tag {
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: .45rem;
    display: flex;
    align-items: center;
    gap: .4rem;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity .4s var(--ease) .05s, transform .4s var(--ease) .05s;
  }
  #{{ section_id }} .mze-cell:hover .mze-tag {
    opacity: 1; transform: translateY(0);
  }
  #{{ section_id }} .mze-tag-dot {
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  #{{ section_id }} .mze-title {
    font-size: clamp(.95rem, 1.8vw, 1.3rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -.02em;
    color: #fff;
    margin-bottom: .35rem;
  }

  #{{ section_id }} .mze-desc {
    font-size: .8rem;
    color: rgba(255,255,255,.5);
    line-height: 1.55;
    max-width: 34ch;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity .4s var(--ease) .1s, transform .4s var(--ease) .1s;
  }
  #{{ section_id }} .mze-cell:hover .mze-desc {
    opacity: 1; transform: translateY(0);
  }

  /* zoom indicator badge */
  #{{ section_id }} .mze-zoom-badge {
    position: absolute;
    top: 1rem; right: 1rem;
    z-index: 3;
    width: 32px; height: 32px;
    border-radius: 50%;
    background: rgba(255,255,255,.1);
    border: 1px solid rgba(255,255,255,.2);
    display: flex; align-items: center; justify-content: center;
    backdrop-filter: blur(6px);
    opacity: 0;
    transform: scale(.7);
    transition: opacity .3s var(--ease), transform .3s var(--ease);
  }
  #{{ section_id }} .mze-cell:hover .mze-zoom-badge {
    opacity: 1; transform: scale(1);
  }
  #{{ section_id }} .mze-zoom-badge svg {
    width: 14px; height: 14px;
    fill: none; stroke: #fff; stroke-width: 1.8;
  }

  /* ── SCROLL REVEAL ───────────────────────────────────────────── */
  @media (prefers-reduced-motion: no-preference) {
    .mze-reveal { opacity: 0; transform: translateY(22px); }
    .mze-reveal.is-in { animation: mze-up .8s cubic-bezier(.16,1,.3,1) forwards; }
    .mze-reveal.d1 { animation-delay: .1s; }
    .mze-reveal.d2 { animation-delay: .2s; }
    .mze-reveal.d3 { animation-delay: .3s; }
    @keyframes mze-up { to { opacity: 1; transform: none; } }

    #{{ section_id }} .mze-cell {
      opacity: 0; transform: translateY(18px) scale(.97);
      transition: opacity .65s cubic-bezier(.16,1,.3,1),
                  transform .65s cubic-bezier(.16,1,.3,1);
    }
    #{{ section_id }} .mze-cell.is-in { opacity: 1; transform: translateY(0) scale(1); }
    {% for i in (1..12) %}
    #{{ section_id }} .mze-cell:nth-child({{ i }}) { transition-delay: {{ i | times: 0.07 }}s; }
    {% endfor %}
  }
</style>

<section id="{{ section_id }}" class="media-zoom-effect" data-section-id="{{ section.id }}">
  <div class="mze-inner">

    <!-- HEADER -->
    <div class="mze-header">
      <div>
        {%- if kicker != blank -%}
          <p class="mze-kicker mze-reveal">{{ kicker }}</p>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 class="mze-heading mze-reveal d1">{{ heading }}</h2>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="mze-subheading mze-reveal d2" style="margin-top:.75rem">{{ subheading }}</p>
        {%- endif -%}
      </div>

      <div class="mze-pills mze-reveal d3" data-mze-pills>
        <button class="mze-pill {% if layout_mode == 'asymmetric' %}is-active{% endif %}" data-mode="asymmetric">Asymmetric</button>
        <button class="mze-pill {% if layout_mode == 'magazine' %}is-active{% endif %}" data-mode="magazine">Magazine</button>
        <button class="mze-pill {% if layout_mode == 'mosaic' %}is-active{% endif %}" data-mode="mosaic">Mosaic</button>
        <button class="mze-pill {% if layout_mode == 'grid' %}is-active{% endif %}" data-mode="grid">Grid</button>
      </div>
    </div>

    <!-- GRID -->
    <div class="mze-grid mode--{{ layout_mode }}" data-mze-grid>

      {%- for block in items -%}
        <div
          class="mze-cell"
          {{ block.shopify_attributes }}
          {% if block.settings.link != blank %}
            onclick="window.location='{{ block.settings.link }}'"
            role="link" tabindex="0"
          {% endif %}
          {% if section.settings.zoom_style == 'cursor' %}
            data-mze-cursor
          {% endif %}
        >
          {%- if block.settings.image -%}
            <img
              class="mze-img"
              src="{{ block.settings.image | image_url: width: 1200 }}"
              alt="{{ block.settings.title | escape }}"
              loading="lazy"
            >
          {%- else -%}
            <div class="mze-placeholder"></div>
          {%- endif -%}

          <div class="mze-overlay"></div>

          {%- if section.settings.show_zoom_icon -%}
            <div class="mze-zoom-badge">
              <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
                <circle cx="7" cy="7" r="5"/>
                <path d="M11 11l3 3" stroke-linecap="round"/>
                <path d="M5 7h4M7 5v4" stroke-linecap="round"/>
              </svg>
            </div>
          {%- endif -%}

          <div class="mze-content">
            {%- if block.settings.tag != blank -%}
              <span class="mze-tag">
                <span class="mze-tag-dot"></span>
                {{ block.settings.tag }}
              </span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="mze-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="mze-desc">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        </div>

      {%- else -%}
        {%- assign demo_t = 'Coastal Collection,Urban Portraits,Architecture,Still Life,Aerial Views' | split: ',' -%}
        {%- assign demo_k = 'Photography,Portrait,Design,Editorial,Aerial' | split: ',' -%}
        {%- for i in (1..5) -%}
          {%- assign idx = forloop.index0 -%}
          <div class="mze-cell">
            <div class="mze-placeholder"></div>
            <div class="mze-overlay"></div>
            {%- if section.settings.show_zoom_icon -%}
              <div class="mze-zoom-badge">
                <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="7" cy="7" r="5" stroke="white" stroke-width="1.8" fill="none"/>
                  <path d="M11 11l3 3" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
                  <path d="M5 7h4M7 5v4" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </div>
            {%- endif -%}
            <div class="mze-content">
              <span class="mze-tag"><span class="mze-tag-dot"></span>{{ demo_k[idx] }}</span>
              <h3 class="mze-title">{{ demo_t[idx] }}</h3>
            </div>
          </div>
        {%- endfor -%}
      {%- endfor -%}

    </div>
  </div>
</section>

<script>
(function() {
  var sec = document.getElementById('{{ section_id }}');
  if (!sec) return;

  var grid  = sec.querySelector('[data-mze-grid]');
  var pills = sec.querySelectorAll('[data-mze-pills] .mze-pill');

  /* ── Layout switcher ───────────────────────────────────────── */
  pills.forEach(function(pill) {
    pill.addEventListener('click', function() {
      pills.forEach(function(p) { p.classList.remove('is-active'); });
      pill.classList.add('is-active');
      grid.className = 'mze-grid mode--' + pill.dataset.mode;
      sec.querySelectorAll('.mze-cell').forEach(function(c) {
        c.classList.remove('is-in');
        requestAnimationFrame(function() { c.classList.add('is-in'); });
      });
    });
  });

  /* ── Cursor-origin zoom (tracks mouse position) ────────────── */
  {% if section.settings.zoom_style == 'cursor' %}
  sec.querySelectorAll('.mze-cell').forEach(function(cell) {
    cell.addEventListener('mousemove', function(e) {
      var r  = cell.getBoundingClientRect();
      var x  = ((e.clientX - r.left) / r.width  * 100).toFixed(1);
      var y  = ((e.clientY - r.top)  / r.height * 100).toFixed(1);
      var img = cell.querySelector('.mze-img');
      if (img) img.style.transformOrigin = x + '% ' + y + '%';
    });
    cell.addEventListener('mouseleave', function() {
      var img = cell.querySelector('.mze-img');
      if (img) img.style.transformOrigin = 'center center';
    });
  });
  {% endif %}

  /* ── Scroll reveal ─────────────────────────────────────────── */
  var obs = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) { e.target.classList.add('is-in'); obs.unobserve(e.target); }
    });
  }, { threshold: .1 });

  sec.querySelectorAll('.mze-reveal, .mze-cell').forEach(function(el) { obs.observe(el); });

  /* Shopify editor */
  if (window.Shopify && Shopify.designMode) {
    document.addEventListener('shopify:section:load', function(e) {
      if (e.target.contains(sec)) sec.querySelectorAll('.mze-cell').forEach(function(c) { obs.observe(c); });
    });
  }
})();
</script>

{% schema %}
{
  "name": "Media Zoom Effect",
  "tag": "section",
  "class": "media-zoom-effect-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Default layout",
      "options": [
        { "value": "asymmetric", "label": "Asymmetric" },
        { "value": "magazine",   "label": "Magazine" },
        { "value": "mosaic",     "label": "Mosaic" },
        { "value": "grid",       "label": "Grid" }
      ],
      "default": "asymmetric"
    },
    {
      "type": "range",
      "id": "grid_cols",
      "label": "Grid columns (Grid mode)",
      "min": 2, "max": 4, "step": 1, "default": 3
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap (px)",
      "min": 0, "max": 32, "step": 2, "default": 8
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width (px)",
      "min": 800, "max": 1800, "step": 40, "default": 1400
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius (px)",
      "min": 0, "max": 32, "step": 2, "default": 8
    },
    {
      "type": "header",
      "content": "Zoom settings"
    },
    {
      "type": "select",
      "id": "zoom_style",
      "label": "Zoom style",
      "options": [
        { "value": "standard", "label": "Standard (scale up)" },
        { "value": "tilt",     "label": "Tilt zoom" },
        { "value": "kenburns", "label": "Ken Burns (pan + zoom)" },
        { "value": "reveal",   "label": "Reveal (blur to sharp)" },
        { "value": "cursor",   "label": "Cursor origin zoom" }
      ],
      "default": "standard"
    },
    {
      "type": "range",
      "id": "zoom_scale",
      "label": "Zoom scale (%)",
      "min": 105, "max": 150, "step": 5, "default": 115
    },
    {
      "type": "range",
      "id": "zoom_duration",
      "label": "Zoom duration (ms)",
      "min": 200, "max": 1200, "step": 100, "default": 600
    },
    {
      "type": "range",
      "id": "hover_brightness",
      "label": "Image brightness on hover (%)",
      "min": 60, "max": 100, "step": 5, "default": 80
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity (%)",
      "min": 0, "max": 100, "step": 5, "default": 60
    },
    {
      "type": "range",
      "id": "overlay_opacity_hover",
      "label": "Overlay opacity on hover (%)",
      "min": 0, "max": 100, "step": 5, "default": 80
    },
    {
      "type": "checkbox",
      "id": "cursor_zoom",
      "label": "Show zoom cursor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_zoom_icon",
      "label": "Show zoom icon badge",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Visual Stories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every detail <em>matters</em>"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Hover to explore. Crafted for those who notice the difference."
    },
    {
      "type": "header",
