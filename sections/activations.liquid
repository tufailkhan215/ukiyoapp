{% comment %}
  Section: Activations
  File: sections/activations.liquid

  Original content and setting IDs preserved.
  Scroll animation, video, styles, and controls are section-scoped.
{% endcomment %}

{% liquid
  assign marquee_items = section.settings.marquee_items | default: 'Strategy · Branding · Digital Experience · Creative Direction' | split: '·'

  assign has_stats = false
  for i in (1..3)
    assign value_key = 'stat_value_' | append: i
    if section.settings[value_key] != blank
      assign has_stats = true
    endif
  endfor

  assign background_image = section.settings.video_poster
  if background_image == blank
    assign background_image = section.settings.card1_image
  endif

  assign screens = section.settings.scroll_length | divided_by: 100.0
%}

{% capture arrow_icon %}
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M7 17 17 7M7 7h10v10"/>
  </svg>
{% endcapture %}

<section
  id="ws-{{ section.id }}"
  class="ws-cinematic"
  aria-labelledby="WS-Heading-{{ section.id }}"
  style="--ws-screens: {{ screens }};"
>
  <div class="ws-runway" data-ws-runway>
    <div class="ws-stage" data-ws-stage>

      <div class="ws-background" aria-hidden="true">
        <div class="ws-background-inner" data-ws-background>
          {% if background_image != blank %}
            {{
              background_image
              | image_url: width: 2400
              | image_tag:
                class: 'ws-poster',
                widths: '750, 1100, 1600, 2000, 2400',
                sizes: '100vw',
                loading: 'eager',
                fetchpriority: 'high',
                alt: ''
            }}
          {% endif %}

          {% if section.settings.video_url != blank %}
            <video
              class="ws-video"
              data-ws-video
              data-src="{{ section.settings.video_url | escape }}"
              muted
              playsinline
              preload="none"
              tabindex="-1"
              {% if background_image != blank %}
                poster="{{ background_image | image_url: width: 2400 }}"
              {% endif %}
            ></video>
          {% endif %}

          <div class="ws-video-shade"></div>
        </div>
      </div>

      <nav class="ws-pill-nav" aria-label="Activations navigation">
        <a
          class="ws-start"
          href="#WS-Heading-{{ section.id }}"
          data-ws-start
          aria-label="Back to section heading"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 19V5m-6 6 6-6 6 6"/>
          </svg>
        </a>

        <div class="ws-desktop-pills">
          {% if section.settings.card1_btn_label != blank %}
            <a
              class="ws-pill"
              href="#WS-Card-1-{{ section.id }}"
              data-ws-jump="1"
            >
              <span>{{ section.settings.card1_btn_label | escape }}</span>
            </a>
          {% endif %}

          {% if section.settings.card2_btn_label != blank %}
            <a
              class="ws-pill"
              href="#WS-Card-2-{{ section.id }}"
              data-ws-jump="2"
            >
              <span>{{ section.settings.card2_btn_label | escape }}</span>
            </a>
          {% endif %}
        </div>

        <details class="ws-mobile-menu">
          <summary aria-label="Section navigation">
            <span class="ws-menu-lines" aria-hidden="true">
              <span></span>
              <span></span>
            </span>
          </summary>

          <div class="ws-mobile-popover">
            {% if section.settings.card1_btn_label != blank %}
              <a
                href="#WS-Card-1-{{ section.id }}"
                data-ws-jump="1"
              >
                {{ section.settings.card1_btn_label | escape }}
              </a>
            {% endif %}

            {% if section.settings.card2_btn_label != blank %}
              <a
                href="#WS-Card-2-{{ section.id }}"
                data-ws-jump="2"
              >
                {{ section.settings.card2_btn_label | escape }}
              </a>
            {% endif %}
          </div>
        </details>
      </nav>

      <div class="ws-header" data-ws-heading-wrap>
        {% if section.settings.badge_label != blank %}
          <div class="ws-badge">
            <span class="ws-badge-dot" aria-hidden="true"></span>
            {{ section.settings.badge_label | escape }}
          </div>
        {% endif %}

        <h2 id="WS-Heading-{{ section.id }}" class="ws-heading">
          <span class="ws-sr-only">
            {{ section.settings.heading | escape | newline_to_br }}
          </span>
          <span data-ws-title aria-hidden="true">
            {{ section.settings.heading | escape | newline_to_br }}
          </span>
        </h2>
      </div>

      <div class="ws-panel-position" data-ws-panel-position>
        <div class="ws-glass-panel" data-ws-panel>

          {% if section.settings.subheading != blank %}
            <div class="ws-panel-intro">
              <div class="ws-subheading">
                {{ section.settings.subheading }}
              </div>
            </div>
          {% endif %}

          <div class="ws-project-grid">
            {% for i in (1..2) %}
              {% liquid
                assign image_key = 'card' | append: i | append: '_image'
                assign eyebrow_key = 'card' | append: i | append: '_eyebrow'
                assign title_key = 'card' | append: i | append: '_title'
                assign desc_key = 'card' | append: i | append: '_desc'
                assign button_key = 'card' | append: i | append: '_btn_label'
                assign link_key = 'card' | append: i | append: '_btn_url'
              %}

              <article
                id="WS-Card-{{ i }}-{{ section.id }}"
                class="ws-card"
                data-ws-card="{{ i }}"
                tabindex="-1"
              >
                {% if section.settings[image_key] != blank %}
                  <div class="ws-card-media">
                    {{
                      section.settings[image_key]
                      | image_url: width: 1400
                      | image_tag:
                        class: 'ws-card-image',
                        widths: '400, 600, 900, 1400',
                        sizes: '(min-width: 769px) 45vw, 90vw',
                        loading: 'lazy'
                    }}
                  </div>
                {% endif %}

                <div class="ws-card-body">
                  {% if section.settings[eyebrow_key] != blank %}
                    <p class="ws-card-eyebrow">
                      {{ section.settings[eyebrow_key] | escape }}
                    </p>
                  {% endif %}

                  <h3 class="ws-card-title">
                    {{ section.settings[title_key] | escape | newline_to_br }}
                  </h3>

                  {% if section.settings[desc_key] != blank %}
                    <div class="ws-card-desc">
                      {{ section.settings[desc_key] }}
                    </div>
                  {% endif %}

                  {% if section.settings[button_key] != blank %}
                    <div class="ws-card-action">
                      <a
                        class="ws-button"
                        href="{{ section.settings[link_key] | default: '#' | escape }}"
                      >
                        <span>{{ section.settings[button_key] | escape }}</span>
                        {{ arrow_icon }}
                      </a>
                    </div>
                  {% endif %}
                </div>
              </article>
            {% endfor %}
          </div>

          {% if has_stats %}
            <div class="ws-stats">
              {% for i in (1..3) %}
                {% liquid
                  assign value_key = 'stat_value_' | append: i
                  assign label_key = 'stat_label_' | append: i
                  assign desc_key = 'stat_desc_' | append: i
                %}

                {% if section.settings[value_key] != blank %}
                  <div class="ws-stat">
                    {% if section.settings[label_key] != blank %}
                      <p class="ws-stat-label">
                        {{ section.settings[label_key] | escape }}
                      </p>
                    {% endif %}

                    <div class="ws-stat-value">
                      {{ section.settings[value_key] | escape }}
                    </div>

                    {% if section.settings[desc_key] != blank %}
                      <p class="ws-stat-desc">
                        {{ section.settings[desc_key] | escape }}
                      </p>
                    {% endif %}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}

          {% if section.settings.show_marquee %}
            <div class="ws-marquee-wrap">
              <p class="ws-sr-only">
                {{ section.settings.marquee_items | escape }}
              </p>

              <div class="ws-marquee-track" aria-hidden="true">
                {% for repeat in (1..2) %}
                  <div class="ws-marquee-group">
                    {% for copy in (1..2) %}
                      {% for item in marquee_items %}
                        <span class="ws-marquee-item">
                          <span aria-hidden="true">✦</span>
                          {{ item | strip | escape }}
                        </span>
                      {% endfor %}
                    {% endfor %}
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ws-controls">
        <span class="ws-scroll-cue" aria-hidden="true">
          <span></span>
          ↓
        </span>

        <button
          class="ws-mode"
          type="button"
          data-ws-mode
          aria-pressed="false"
          hidden
        >
          View all content
        </button>
      </div>

      <div class="ws-progress" aria-hidden="true">
        <span data-ws-progress></span>
      </div>
    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap');

  {% if section.settings.heading_font_url != blank %}
    @font-face {
      font-family: "WSDisplay-{{ section.id }}";
      src: url({{ section.settings.heading_font_url | json }}) format("woff2");
      font-style: normal;
      font-weight: 400;
      font-display: swap;
    }
  {% endif %}

  #ws-{{ section.id }} {
    --ws-white: #f5f4ef;
    --ws-pad: clamp(20px, 3.5vw, 56px);
    --ws-sans: "Manrope", Arial, sans-serif;
    --ws-serif: "Instrument Serif", Georgia, serif;
    --ws-display: "WSDisplay-{{ section.id }}", "Instrument Serif", Georgia, serif;
    position: relative;
    isolation: isolate;
    width: 100%;
    background: #050505;
    color: var(--ws-white);
    font-family: var(--ws-sans);
    -webkit-font-smoothing: antialiased;
  }

  #ws-{{ section.id }} *,
  #ws-{{ section.id }} *::before,
  #ws-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #ws-{{ section.id }} :is(h2,h3,p) {
    margin: 0;
    color: inherit;
  }

  #ws-{{ section.id }} a {
    color: inherit;
    text-decoration: none;
  }

  #ws-{{ section.id }} button {
    font: inherit;
    cursor: pointer;
  }

  #ws-{{ section.id }} [hidden] {
    display: none !important;
  }

  #ws-{{ section.id }} :is(a,button,summary):focus-visible {
    outline: 2px solid #fff;
    outline-offset: 5px;
  }

  #ws-{{ section.id }} .ws-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  #ws-{{ section.id }} svg {
    display: block;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }

  #ws-{{ section.id }} .ws-runway {
    position: relative;
  }

  #ws-{{ section.id }} .ws-stage {
    position: relative;
    isolation: isolate;
    padding-bottom: 40px;
  }

  #ws-{{ section.id }} .ws-background {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 65% 20%, #303c35, #101712 55%, #050505);
  }

  #ws-{{ section.id }} .ws-background-inner {
    position: absolute;
    inset: -5%;
    transform: translate3d(var(--ws-mx, 0px), var(--ws-my, 0px), 0);
    transition: transform 1s cubic-bezier(.16,1,.3,1);
  }

  #ws-{{ section.id }} .ws-poster,
  #ws-{{ section.id }} .ws-video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #ws-{{ section.id }} .ws-video {
    opacity: 0;
    transform: scale(1.2);
    transition: opacity .4s;
  }

  #ws-{{ section.id }} .ws-video[data-ready="true"] {
    opacity: 1;
  }

  #ws-{{ section.id }} .ws-video-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, #0004, #0001 30%, #0008 100%);
  }

  #ws-{{ section.id }} .ws-pill-nav {
    position: relative;
    z-index: 20;
    display: flex;
    justify-content: center;
    align-items: center;
    width: fit-content;
    max-width: calc(100% - 32px);
    margin: 0 auto;
    padding-top: 24px;
    gap: 6px;
  }

  #ws-{{ section.id }} .ws-start {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid #ffffff25;
    border-radius: 50%;
    background: #050505;
    color: #fff;
    flex-shrink: 0;
  }

  #ws-{{ section.id }} .ws-start svg {
    transition: transform .35s;
  }

  #ws-{{ section.id }} .ws-start:hover svg {
    transform: translateY(-3px);
  }

  #ws-{{ section.id }} .ws-desktop-pills {
    display: flex;
    gap: 4px;
    padding: 4px;
    border: 2px solid #050505;
    border-radius: 50px;
    background: #050505;
  }

  #ws-{{ section.id }} .ws-pill {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 10px 24px;
    border-radius: 50px;
    background: #f0f0ee;
    color: #080808;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: .05em;
    text-transform: uppercase;
    text-align: center;
  }

  #ws-{{ section.id }} .ws-pill::before {
    content: "";
    position: absolute;
    inset: -50%;
    z-index: -1;
    border-radius: 50%;
    background: #050505;
    transform: translateY(100%) scale(.2);
    transition: transform .4s cubic-bezier(.16,1,.3,1);
  }

  #ws-{{ section.id }} .ws-pill span {
    position: relative;
    transition: color .25s, transform .25s;
  }

  #ws-{{ section.id }} .ws-pill:hover::before {
    transform: translateY(0) scale(1.1);
  }

  #ws-{{ section.id }} .ws-pill:hover span {
    color: #fff;
    transform: translateY(-1px);
  }

  #ws-{{ section.id }} .ws-mobile-menu {
    display: none;
    position: relative;
  }

  #ws-{{ section.id }} .ws-mobile-menu summary {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid #ffffff25;
    border-radius: 50%;
    background: #050505;
    cursor: pointer;
    list-style: none;
  }

  #ws-{{ section.id }} .ws-mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  #ws-{{ section.id }} .ws-menu-lines {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  #ws-{{ section.id }} .ws-menu-lines > span {
    width: 20px;
    height: 1px;
    background: #fff;
    transition: transform .25s;
  }

  #ws-{{ section.id }} .ws-mobile-menu[open] .ws-menu-lines > span:first-child {
    transform: translateY(3px) rotate(45deg);
  }

  #ws-{{ section.id }} .ws-mobile-menu[open] .ws-menu-lines > span:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  #ws-{{ section.id }} .ws-mobile-popover {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: min(260px, calc(100vw - 40px));
    padding: 12px;
    border: 1px solid #ffffff25;
    border-radius: 16px;
    background: #080808;
    box-shadow: 0 16px 40px #0005;
  }

  #ws-{{ section.id }} .ws-mobile-popover a {
    display: block;
    padding: 15px 12px;
    font-size: 12px;
    line-height: 1.5;
    text-align: center;
  }

  #ws-{{ section.id }} .ws-header {
    padding: clamp(100px, 14vw, 210px) var(--ws-pad) 70px;
  }

  #ws-{{ section.id }} .ws-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  #ws-{{ section.id }} .ws-badge-dot {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  #ws-{{ section.id }} .ws-heading {
    font-family: var(--ws-display);
    font-size: clamp(48px, 10.4vw, 190px);
    font-weight: 400;
    line-height: .94;
    letter-spacing: -.035em;
    overflow-wrap: anywhere;
  }

  #ws-{{ section.id }} .ws-word {
    display: inline-block;
    white-space: nowrap;
  }

  #ws-{{ section.id }} .ws-char {
    display: inline-block;
    transform-origin: 50% 0;
  }

  #ws-{{ section.id }} .ws-panel-position {
    position: relative;
    width: min(1250px, calc(100% - 2 * var(--ws-pad)));
    margin: 0 auto;
    perspective: 1200px;
  }

  #ws-{{ section.id }} .ws-glass-panel {
    position: relative;
    overflow: hidden;
    width: 100%;
    border: 1px solid #ffffff24;
    border-radius: 28px;
    background: rgba(0,0,0,.24);
    backdrop-filter: blur(70px);
    -webkit-backdrop-filter: blur(70px);
    box-shadow: 0 30px 100px #0003;
    transform:
      rotateX(var(--ws-rx, 0deg))
      rotateY(var(--ws-ry, 0deg));
    transition: transform .7s cubic-bezier(.16,1,.3,1);
  }

  #ws-{{ section.id }} .ws-panel-intro {
    padding: clamp(32px, 5vw, 70px) clamp(24px, 5vw, 70px);
    text-align: center;
  }

  #ws-{{ section.id }} .ws-subheading {
    max-width: 1000px;
    margin: 0 auto;
    font-family: var(--ws-serif);
    font-size: clamp(29px, 4.3vw, 66px);
    line-height: 1.12;
    letter-spacing: -.025em;
    text-wrap: balance;
  }

  #ws-{{ section.id }} .ws-subheading em {
    font-style: italic;
  }

  #ws-{{ section.id }} .ws-project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid #ffffff20;
  }

  #ws-{{ section.id }} .ws-card {
    min-width: 0;
    position: relative;
    display: flex;
    flex-direction: column;
    scroll-margin-top: 100px;
  }

  #ws-{{ section.id }} .ws-card + .ws-card {
    border-left: 1px solid #ffffff20;
  }

  #ws-{{ section.id }} .ws-card-media {
    overflow: hidden;
    aspect-ratio: 2 / 1;
    border-bottom: 1px solid #ffffff15;
    background: #ffffff05;
  }

  #ws-{{ section.id }} .ws-card-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(.7);
    transition: transform .7s, filter .7s;
  }

  #ws-{{ section.id }} .ws-card-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1;
    padding: clamp(26px, 3.5vw, 48px);
  }

  #ws-{{ section.id }} .ws-card-eyebrow {
    margin-bottom: 18px;
    color: #ffffffa6;
    font-size: 10px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  #ws-{{ section.id }} .ws-card-title {
    font-family: var(--ws-serif);
    font-size: clamp(34px, 4vw, 58px);
    font-weight: 400;
    line-height: 1.03;
    letter-spacing: -.02em;
    overflow-wrap: anywhere;
  }

  #ws-{{ section.id }} .ws-card-desc {
    margin-top: 20px;
    max-width: 38ch;
    color: #ffffffc2;
    font-size: 14px;
    line-height: 1.75;
  }

  #ws-{{ section.id }} .ws-card-action {
    margin-top: auto;
    padding-top: 28px;
  }

  #ws-{{ section.id }} .ws-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    min-height: 48px;
    padding: 13px 22px;
    border: 1px solid #ffffff45;
    border-radius: 999px;
    background: #ffffff09;
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: .06em;
    text-transform: uppercase;
    transition: color .25s, background .25s, border-color .25s;
  }

  #ws-{{ section.id }} .ws-button:hover {
    color: #050505;
    background: #fff;
    border-color: #fff;
  }

  #ws-{{ section.id }} .ws-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid #ffffff20;
  }

  #ws-{{ section.id }} .ws-stat {
    padding: 30px 20px;
    text-align: center;
  }

  #ws-{{ section.id }} .ws-stat + .ws-stat {
    border-left: 1px solid #ffffff20;
  }

  #ws-{{ section.id }} .ws-stat-label {
    margin-bottom: 12px;
    color: #ffffffa6;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  #ws-{{ section.id }} .ws-stat-value {
    font-family: var(--ws-serif);
    font-size: clamp(38px, 5vw, 66px);
    line-height: 1;
    letter-spacing: -.025em;
    overflow-wrap: anywhere;
  }

  #ws-{{ section.id }} .ws-stat-desc {
    margin-top: 12px;
    color: #ffffffb3;
    font-size: 10px;
    line-height: 1.6;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  #ws-{{ section.id }} .ws-marquee-wrap {
    overflow: hidden;
    padding: 25px 0;
    border-top: 1px solid #ffffff20;
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
  }

  #ws-{{ section.id }} .ws-marquee-track {
    display: flex;
    width: max-content;
  }

  #ws-{{ section.id }}.ws-enhanced:not(.ws-static) .ws-marquee-track {
    animation: ws-marquee-{{ section.id }} 22s linear infinite;
  }

  #ws-{{ section.id }} .ws-marquee-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  #ws-{{ section.id }} .ws-marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 20px;
    padding: 0 28px;
    white-space: nowrap;
    color: #ffffff99;
    font-size: 11px;
