    }

    #ws-{{ section.id }} .ws-panel-intro {
      padding: 34px 24px;
    }

    #ws-{{ section.id }} .ws-subheading {
      font-size: clamp(27px, 7vw, 40px);
      line-height: 1.15;
    }

    #ws-{{ section.id }} .ws-card-body {
      padding: 28px 24px;
    }

    #ws-{{ section.id }} .ws-card-title {
      font-size: 38px;
    }

    #ws-{{ section.id }} .ws-card-desc {
      font-size: 14px;
