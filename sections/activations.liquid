</style>

<script>
(function () {
  const rootId = 'ws-{{ section.id }}';
  const wrapperId = 'shopify-section-{{ section.id }}';

  window.__wsActivationControllers = window.__wsActivationControllers || {};
  window.__wsActivationControllers[rootId]?.();

  const lifecycle = new AbortController();
  let cleanup = () => {};

  function initialize() {
    cleanup();

    const root = document.getElementById(rootId);
    if (!root) return;

    const events = new AbortController();
    const signal = events.signal;

    const runway = root.querySelector('[data-ws-runway]');
    const stage = root.querySelector('[data-ws-stage]');
    const title = root.querySelector('[data-ws-title]');
    const headingWrap = root.querySelector('[data-ws-heading-wrap]');
    const badge = root.querySelector('.ws-badge');
    const panelPosition = root.querySelector('[data-ws-panel-position]');
    const panel = root.querySelector('[data-ws-panel]');
    const video = root.querySelector('[data-ws-video]');
    const modeButton = root.querySelector('[data-ws-mode]');
    const progressBar = root.querySelector('[data-ws-progress]');
    const menu = root.querySelector('.ws-mobile-menu');

    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const shortViewport = matchMedia('(max-height: 480px)');
    const finePointer = matchMedia('(hover: hover) and (pointer: fine)');

    const originalTitle = title.innerHTML;

    let destroyed = false;
    let animated = false;
    let staticRequested = false;
    let frame = null;
    let currentProgress = null;
    let lastTime = 0;
    let height = 1;
    let panelHeight = 1;
    let videoLoaded = false;
    let videoFailed = false;
    let targetTime = 0;
    let sectionVisible = true;

    const clamp = value => Math.max(0, Math.min(1, value));
    const range = (value, start, end) => clamp((value - start) / (end - start));
    const smooth = value => value * value * (3 - 2 * value);

    function listen(target, type, handler, options = {}) {
      target?.addEventListener(type, handler, { ...options, signal });
    }

    /*
      Preserve the exact heading text and line breaks.
      Character spans are visual only; the original heading remains
      available to screen readers in the adjacent hidden span.
    */
    function splitTitle() {
      title.innerHTML = originalTitle;

      const walker = document.createTreeWalker(
        title,
        NodeFilter.SHOW_TEXT
      );

      const textNodes = [];
      while (walker.nextNode()) textNodes.push(walker.currentNode);

      textNodes.forEach(node => {
        const fragment = document.createDocumentFragment();
        const parts = node.textContent.split(/(\s+)/);

        parts.forEach(part => {
          if (!part) return;

          if (/^\s+$/.test(part)) {
            fragment.append(document.createTextNode(part));
            return;
          }

          const word = document.createElement('span');
          word.className = 'ws-word';

          Array.from(part).forEach(character => {
            const span = document.createElement('span');
            span.className = 'ws-char';
            span.textContent = character;
            word.append(span);
          });

          fragment.append(word);
        });

        node.replaceWith(fragment);
      });
    }

    splitTitle();
    const characters = [...title.querySelectorAll('.ws-char')];

    function setPanelVisible(visible) {
      panelPosition.style.visibility = visible ? 'visible' : 'hidden';
      panelPosition.inert = !visible;

      if (visible) {
        panelPosition.removeAttribute('aria-hidden');
      } else {
        panelPosition.setAttribute('aria-hidden', 'true');
      }
    }

    function loadVideo() {
      if (!video || videoLoaded || videoFailed || !animated) return;

      videoLoaded = true;
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;
      video.src = video.dataset.src;
      video.load();
    }

    /*
      Keep only the newest scroll target.
      A second seek starts after the previous seek finishes.
    */
    function seekVideo() {
      if (
        !video ||
        destroyed ||
        !animated ||
        !sectionVisible ||
        document.hidden ||
        videoFailed ||
        video.seeking ||
        video.readyState < 1 ||
        !Number.isFinite(video.duration) ||
        video.duration <= 0
      ) return;

      const nextTime = Math.min(
        Math.max(0, video.duration - .05),
        Math.max(.001, targetTime)
      );

      if (Math.abs(video.currentTime - nextTime) < .035) return;

      try {
        video.currentTime = nextTime;
      } catch (_) {
        /* Retry after the next media or scroll event. */
      }
    }

    function panelGeometry() {
      const start = height * .98;
      const end = Math.min(height * .08, height - panelHeight - 76);
      return { start, end };
    }

    function paint(progress) {
      if (!animated) return;

      progressBar.style.transform = `scaleX(${progress})`;

      const titleProgress = range(progress, 0, .33);

      characters.forEach((character, index) => {
        const delay = characters.length > 1
          ? index / (characters.length - 1) * .35
          : 0;

        const amount = smooth(clamp((titleProgress - delay) / .65));

        character.style.opacity = String(1 - amount);
        character.style.transform =
          `translateY(${amount * 250}%) scale(${1 - amount * .1},${1 + amount * .2})`;
      });

      if (badge) {
        const badgeOut = range(progress, .01, .13);
        badge.style.opacity = String(1 - badgeOut);
        badge.style.transform = `translateY(${badgeOut * 20}px)`;
      }

      headingWrap.style.visibility = progress >= .34 ? 'hidden' : 'visible';

      const motion = range(progress, .30, .96);
      const geometry = panelGeometry();
      const panelY = geometry.start + (geometry.end - geometry.start) * motion;

      panelPosition.style.transform =
        `translate3d(-50%, ${panelY}px, 0)`;

      panelPosition.style.opacity = String(range(progress, .29, .35));
      setPanelVisible(progress > .295);

      if (Number.isFinite(video?.duration)) {
        targetTime = progress * Math.max(0, video.duration - .05);
        seekVideo();
      }
    }

    function tick(time) {
      frame = null;
      if (destroyed || !animated || document.hidden) return;

      const rect = runway.getBoundingClientRect();

      sectionVisible =
        rect.bottom > 0 &&
        rect.top < window.innerHeight;

      if (!sectionVisible) return;

      loadVideo();

      const travel = Math.max(1, runway.offsetHeight - height);
      const target = clamp(-rect.top / travel);
      const delta = Math.min((time - lastTime) / 1000 || .016, .064);

      lastTime = time;

      if (currentProgress === null) currentProgress = target;

      currentProgress +=
        (target - currentProgress) * (1 - Math.exp(-delta * 10));

      if (Math.abs(target - currentProgress) < .00015) {
        currentProgress = target;
      }

      paint(currentProgress);

      if (Math.abs(target - currentProgress) >= .00015) {
        schedule();
      }
    }

    function schedule() {
      if (frame === null && animated && !destroyed) {
        frame = requestAnimationFrame(tick);
      }
    }

    function measure() {
      if (destroyed) return;

      height = stage.clientHeight || window.innerHeight;
      panelHeight = panelPosition.offsetHeight;

      schedule();
    }

    function resetPresentation() {
      characters.forEach(character => {
        character.style.removeProperty('opacity');
        character.style.removeProperty('transform');
      });

      if (badge) {
        badge.style.removeProperty('opacity');
        badge.style.removeProperty('transform');
      }

      headingWrap.style.removeProperty('visibility');
      panelPosition.style.removeProperty('transform');
      panelPosition.style.removeProperty('opacity');
      panelPosition.style.removeProperty('visibility');
      panelPosition.inert = false;
      panelPosition.removeAttribute('aria-hidden');

      root.style.setProperty('--ws-mx', '0px');
      root.style.setProperty('--ws-my', '0px');
      root.style.setProperty('--ws-rx', '0deg');
      root.style.setProperty('--ws-ry', '0deg');

      if (video) {
        video.pause();
        video.removeAttribute('data-ready');
      }
    }

    function setMode(restorePosition = false) {
      const sectionTop = root.getBoundingClientRect().top + window.scrollY;

      animated =
        !staticRequested &&
        !reduced.matches &&
        !shortViewport.matches;

      if (frame !== null) cancelAnimationFrame(frame);
      frame = null;
      currentProgress = null;

      root.classList.add('ws-enhanced');
      root.classList.toggle('ws-animated', animated);
      root.classList.toggle('ws-static', !animated);

      modeButton.hidden = reduced.matches || shortViewport.matches;
      modeButton.textContent = animated ? 'View all content' : 'Enable animation';
      modeButton.setAttribute('aria-pressed', String(!animated));

      if (!animated) {
        resetPresentation();
      } else {
        if (video && video.readyState >= 2 && !videoFailed) {
          video.dataset.ready = 'true';
        }

        measure();

        const travel = Math.max(1, runway.offsetHeight - height);
        const progress = clamp(-runway.getBoundingClientRect().top / travel);

        currentProgress = progress;
        paint(progress);
      }

      if (restorePosition) {
        window.scrollTo({
          top: Math.max(0, sectionTop),
          behavior: 'instant'
        });
        currentProgress = null;
      }

      schedule();
    }

    function scrollToProgress(progress) {
      const top = runway.getBoundingClientRect().top + window.scrollY;
      const travel = Math.max(1, runway.offsetHeight - height);

      window.scrollTo({
        top: top + travel * clamp(progress),
        behavior: reduced.matches ? 'auto' : 'smooth'
      });
    }

    root.querySelectorAll('[data-ws-jump]').forEach(link => {
      listen(link, 'click', event => {
        const card = root.querySelector(
          `[data-ws-card="${link.dataset.wsJump}"]`
        );

        if (!card) return;
        if (menu) menu.open = false;

        if (!animated) return;

        event.preventDefault();

        const cardOffset =
          card.getBoundingClientRect().top -
          panelPosition.getBoundingClientRect().top;

        const geometry = panelGeometry();
        const desiredPanelY = height * .22 - cardOffset;
        const motion = clamp(
          (geometry.start - desiredPanelY) /
          Math.max(1, geometry.start - geometry.end)
        );

        scrollToProgress(.30 + motion * .66);
      });
    });

    listen(root.querySelector('[data-ws-start]'), 'click', event => {
      if (!animated) return;
      event.preventDefault();
      scrollToProgress(0);
      if (menu) menu.open = false;
    });

    listen(modeButton, 'click', () => {
      staticRequested = !staticRequested;
      setMode(true);
    });

    listen(root, 'keydown', event => {
      if (event.key === 'Escape' && menu?.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });

    listen(document, 'pointerdown', event => {
      if (menu?.open && !menu.contains(event.target)) {
        menu.open = false;
      }
    });

    listen(stage, 'pointermove', event => {
      if (!animated || reduced.matches || !finePointer.matches) return;

      const bounds = stage.getBoundingClientRect();
      const x = (event.clientX - bounds.left) / bounds.width * 2 - 1;
      const y = (event.clientY - bounds.top) / bounds.height * 2 - 1;

      root.style.setProperty('--ws-mx', `${x * -18}px`);
      root.style.setProperty('--ws-my', `${y * -18}px`);
    }, { passive: true });

    listen(panel, 'pointermove', event => {
      if (!animated || reduced.matches || !finePointer.matches) return;

      const bounds = panel.getBoundingClientRect();
      const x = (event.clientX - bounds.left) / bounds.width * 2 - 1;
      const y = (event.clientY - bounds.top) / bounds.height * 2 - 1;

      root.style.setProperty('--ws-rx', `${y * -1.5}deg`);
      root.style.setProperty('--ws-ry', `${x * 1.5}deg`);
    }, { passive: true });

    listen(stage, 'pointerleave', () => {
      root.style.setProperty('--ws-mx', '0px');
      root.style.setProperty('--ws-my', '0px');
    });

    listen(panel, 'pointerleave', () => {
      root.style.setProperty('--ws-rx', '0deg');
      root.style.setProperty('--ws-ry', '0deg');
    });

    if (video) {
      listen(video, 'loadedmetadata', () => {
        video.pause();
        seekVideo();
        schedule();
      });

      listen(video, 'loadeddata', () => {
        if (animated) video.dataset.ready = 'true';
        seekVideo();
        schedule();
      });

      listen(video, 'canplay', () => {
        if (animated) video.dataset.ready = 'true';
        seekVideo();
      });

      listen(video, 'seeked', seekVideo);

      listen(video, 'error', () => {
        videoFailed = true;
        video.removeAttribute('data-ready');
      });
    }

    listen(window, 'scroll', schedule, { passive: true });
    listen(window, 'resize', measure, { passive: true });
    listen(window, 'pageshow', measure);
    listen(document, 'visibilitychange', schedule);

    listen(reduced, 'change', () => setMode(true));
    listen(shortViewport, 'change', () => setMode(true));

    const observer = typeof ResizeObserver !== 'undefined'
      ? new ResizeObserver(measure)
      : null;

    observer?.observe(stage);
    observer?.observe(panelPosition);

    root.querySelectorAll('img').forEach(image => {
      listen(image, 'load', measure);
    });

    document.fonts?.ready.then(() => {
      if (!destroyed) measure();
    });

    setMode();

    cleanup = () => {
      destroyed = true;
      events.abort();
      observer?.disconnect();

      if (frame !== null) cancelAnimationFrame(frame);

      resetPresentation();
      title.innerHTML = originalTitle;

      root.classList.remove(
        'ws-enhanced',
        'ws-animated',
        'ws-static'
      );

      if (video) {
        video.pause();
        video.removeAttribute('src');
        video.load();
      }
    };
  }

  document.addEventListener('shopify:section:load', event => {
    if (event.target.id === wrapperId) initialize();
  }, { signal: lifecycle.signal });

  document.addEventListener('shopify:section:unload', event => {
    if (event.target.id === wrapperId) cleanup();
  }, { signal: lifecycle.signal });

  window.__wsActivationControllers[rootId] = () => {
    cleanup();
    lifecycle.abort();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize, {
      once: true,
      signal: lifecycle.signal
    });
  } else {
    initialize();
  }
})();
</script>

