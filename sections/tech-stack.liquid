{% comment %} Tech Stack: badge, title, row of tech buttons with hover glow; click opens popup modal. {% endcomment %}
{% assign tech_blocks = section.blocks | where: 'type', 'tech' %}
{% assign section_id = 'tech-stack-' | append: section.id %}

<section class="relative py-24 lg:py-32 bg-black overflow-hidden" data-testid="tech-stack" id="{{ section_id }}">
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(255,255,255,0.03),transparent_50%)]" aria-hidden="true"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] border border-white/[0.03] rounded-full rotate-[32deg]" aria-hidden="true"></div>
  <div class="relative z-10 max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="text-center mb-16">
      {% if section.settings.badge != blank %}
        <span class="text-[10px] font-medium text-white/40 tracking-[0.3em] uppercase block mb-4">{{ section.settings.badge }}</span>
      {% endif %}
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4">
        {{ section.settings.title_before }}
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-gray-400 to-gray-600">{{ section.settings.title_gradient }}</span>
      </h2>
      {% if section.settings.subtitle != blank %}
        <p class="text-white/40 max-w-md mx-auto mb-12">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="flex justify-center">
      <div class="max-w-3xl">
        <div class="space-y-6">
          <div class="flex flex-wrap gap-3 justify-center">
            {% for block in tech_blocks %}
              {% case block.settings.gradient %}
                {% when 'orange_amber' %}   {% assign glow_class = 'from-orange-500 to-amber-500' %}
                {% when 'green_emerald' %} {% assign glow_class = 'from-green-500 to-emerald-500' %}
                {% when 'orange_red' %}    {% assign glow_class = 'from-orange-500 to-red-500' %}
                {% when 'purple_violet' %} {% assign glow_class = 'from-purple-500 to-violet-500' %}
                {% else %}                {% assign glow_class = 'from-emerald-500 to-teal-500' %}
              {% endcase %}
              <button type="button" class="tech-stack-trigger group relative inline-flex" data-index="{{ forloop.index0 }}" data-gradient="{{ block.settings.gradient }}" data-icon="{{ block.settings.icon }}" data-label="{{ block.settings.label | escape }}" data-tagline="{{ block.settings.popup_tagline | escape }}" data-description="{{ block.settings.popup_description | escape }}" data-bullet1="{{ block.settings.popup_bullet_1 | escape }}" data-bullet2="{{ block.settings.popup_bullet_2 | escape }}" data-bullet3="{{ block.settings.popup_bullet_3 | escape }}" data-url="{{ block.settings.url }}" {{ block.shopify_attributes }}>
                <div class="absolute -inset-1 rounded-xl bg-gradient-to-r {{ glow_class }} opacity-0 group-hover:opacity-30 blur-lg transition-all duration-300"></div>
                <div class="relative flex items-center gap-2 px-4 py-3 rounded-xl bg-white/[0.03] border border-white/10 group-hover:border-white/20 group-hover:bg-white/[0.06] transition-all duration-300">
                  {% case block.settings.icon %}
                    {% when 'bot' %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-bot w-5 h-5 text-white/60 group-hover:text-white transition-colors shrink-0"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path></svg>
                    {% when 'code' %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-code w-5 h-5 text-white/60 group-hover:text-white transition-colors shrink-0"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                    {% when 'zap' %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-zap w-5 h-5 text-white/60 group-hover:text-white transition-colors shrink-0"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path></svg>
                    {% else %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lucide lucide-cpu w-5 h-5 text-white/60 group-hover:text-white transition-colors shrink-0"><rect width="16" height="16" x="4" y="4" rx="2" ry="2"></rect><rect width="6" height="6" x="9" y="9"></rect><path d="M15 2v2"></path><path d="M15 20v2"></path><path d="M2 15h2"></path><path d="M2 9h2"></path><path d="M20 15h2"></path><path d="M20 9h2"></path><path d="M9 2v2"></path><path d="M9 20v2"></path></svg>
                  {% endcase %}
                  <span class="text-white/80 group-hover:text-white font-medium transition-colors">{{ block.settings.label }}</span>
                  <span class="text-white/40 text-xs ml-1" aria-hidden="true">→</span>
                </div>
              </button>
            {% endfor %}
          </div>
          {% if section.settings.footer_text != blank %}
            <p class="text-white/40 text-sm text-center">{{ section.settings.footer_text }}</p>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="absolute left-1/2 bottom-0 -translate-x-1/2 w-px h-20 bg-gradient-to-b from-white/10 to-transparent" aria-hidden="true"></div>
  </div>
</section>

{% comment %} Single modal: content filled by JS from trigger data. {% endcomment %}
<div id="{{ section_id }}-modal-backdrop" class="tech-stack-modal-backdrop fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden" aria-hidden="true"></div>
<div id="{{ section_id }}-modal" class="tech-stack-modal fixed inset-x-4 top-1/2 -translate-y-1/2 mx-auto max-w-md z-50 sm:left-1/2 sm:right-auto sm:-translate-x-1/2 sm:inset-x-auto sm:w-full sm:px-4 hidden" role="dialog" aria-modal="true" aria-labelledby="{{ section_id }}-modal-title" aria-hidden="true">
  <div class="tech-stack-modal-border relative rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-500 p-[1px]">
    <div class="bg-black rounded-2xl p-5 sm:p-6">
      <button type="button" class="tech-stack-modal-close absolute top-3 right-3 sm:top-4 sm:right-4 w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-white hover:bg-white/20 z-10" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
      </button>
      <div class="flex items-center gap-3 sm:gap-4 mb-4 pr-8">
        <div class="tech-stack-modal-icon-wrap w-12 h-12 sm:w-14 sm:h-14 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-500 flex items-center justify-center flex-shrink-0">
          <svg data-icon="bot" class="tech-stack-modal-icon w-6 h-6 sm:w-7 sm:h-7 text-white hidden" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path></svg>
          <svg data-icon="code" class="tech-stack-modal-icon w-6 h-6 sm:w-7 sm:h-7 text-white hidden" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
          <svg data-icon="zap" class="tech-stack-modal-icon w-6 h-6 sm:w-7 sm:h-7 text-white hidden" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path></svg>
          <svg data-icon="cpu" class="tech-stack-modal-icon w-6 h-6 sm:w-7 sm:h-7 text-white hidden" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="16" height="16" x="4" y="4" rx="2" ry="2"></rect><rect width="6" height="6" x="9" y="9"></rect><path d="M15 2v2"></path><path d="M15 20v2"></path><path d="M2 15h2"></path><path d="M2 9h2"></path><path d="M20 15h2"></path><path d="M20 9h2"></path><path d="M9 2v2"></path><path d="M9 20v2"></path></svg>
        </div>
        <div class="min-w-0">
          <h3 id="{{ section_id }}-modal-title" class="tech-stack-modal-title text-lg sm:text-xl font-bold text-white truncate"></h3>
          <p class="tech-stack-modal-tagline text-white/50 text-sm"></p>
        </div>
      </div>
      <p class="tech-stack-modal-description text-white/70 mb-4 text-sm sm:text-base"></p>
      <div class="tech-stack-modal-bullets space-y-2"></div>
      <div class="tech-stack-modal-footer mt-4"></div>
    </div>
  </div>
</div>

<script>
(function() {
  var section = document.getElementById('{{ section_id }}');
  if (!section) return;
  var backdrop = document.getElementById('{{ section_id }}-modal-backdrop');
  var modal = document.getElementById('{{ section_id }}-modal');
  if (!modal) return;
  var gradientClasses = {
    'emerald_teal': 'bg-gradient-to-br from-emerald-500 to-teal-500',
    'orange_amber': 'bg-gradient-to-br from-orange-500 to-amber-500',
    'green_emerald': 'bg-gradient-to-br from-green-500 to-emerald-500',
    'orange_red': 'bg-gradient-to-br from-orange-500 to-red-500',
    'purple_violet': 'bg-gradient-to-br from-purple-500 to-violet-500'
  };
  var iconWrap = section.querySelector('.tech-stack-modal-icon-wrap');
  var iconClasses = {
    'emerald_teal': 'from-emerald-500 to-teal-500',
    'orange_amber': 'from-orange-500 to-amber-500',
    'green_emerald': 'from-green-500 to-emerald-500',
    'orange_red': 'from-orange-500 to-red-500',
    'purple_violet': 'from-purple-500 to-violet-500'
  };

  function openModal(trigger) {
    var label = trigger.getAttribute('data-label') || '';
    var tagline = trigger.getAttribute('data-tagline') || '';
    var description = trigger.getAttribute('data-description') || '';
    var bullet1 = trigger.getAttribute('data-bullet1') || '';
    var bullet2 = trigger.getAttribute('data-bullet2') || '';
    var bullet3 = trigger.getAttribute('data-bullet3') || '';
    var url = trigger.getAttribute('data-url') || '';
    var gradient = trigger.getAttribute('data-gradient') || 'emerald_teal';
    var icon = trigger.getAttribute('data-icon') || 'bot';

    modal.querySelector('.tech-stack-modal-title').textContent = label;
    modal.querySelector('.tech-stack-modal-tagline').textContent = tagline;
    modal.querySelector('.tech-stack-modal-description').textContent = description;

    var bulletsEl = modal.querySelector('.tech-stack-modal-bullets');
    bulletsEl.innerHTML = '';
    [bullet1, bullet2, bullet3].forEach(function(text) {
      if (!text) return;
      var div = document.createElement('div');
      div.className = 'flex items-center gap-2 text-white/60 text-sm';
      div.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-white flex-shrink-0" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span>' + text + '</span>';
      bulletsEl.appendChild(div);
    });

    var footerEl = modal.querySelector('.tech-stack-modal-footer');
    footerEl.innerHTML = '';
    if (url) {
      var a = document.createElement('a');
      a.href = url;
      a.className = 'inline-flex items-center gap-2 text-sm text-white/70 hover:text-white transition-colors';
      a.textContent = 'Learn more';
      a.setAttribute('target', '_blank');
      a.setAttribute('rel', 'noopener noreferrer');
      footerEl.appendChild(a);
    }

    var borderEl = modal.querySelector('.tech-stack-modal-border');
    if (borderEl) {
      borderEl.className = 'tech-stack-modal-border relative rounded-2xl p-[1px] ' + (gradientClasses[gradient] || gradientClasses.emerald_teal);
    }
    var iconWrapEl = modal.querySelector('.tech-stack-modal-icon-wrap');
    if (iconWrapEl) {
      iconWrapEl.className = 'tech-stack-modal-icon-wrap w-12 h-12 sm:w-14 sm:h-14 rounded-xl flex items-center justify-center flex-shrink-0 bg-gradient-to-br ' + (iconClasses[gradient] || iconClasses.emerald_teal);
    }
    modal.querySelectorAll('.tech-stack-modal-icon').forEach(function(el) { el.classList.add('hidden'); });
    var showIcon = modal.querySelector('.tech-stack-modal-icon[data-icon="' + icon + '"]');
    if (showIcon) showIcon.classList.remove('hidden');

    backdrop.classList.remove('hidden');
    backdrop.setAttribute('aria-hidden', 'false');
    modal.classList.remove('hidden');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    var closeBtn = modal.querySelector('.tech-stack-modal-close');
    if (closeBtn) closeBtn.focus();
  }

  function closeModal() {
    backdrop.classList.add('hidden');
    backdrop.setAttribute('aria-hidden', 'true');
    modal.classList.add('hidden');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    var trigger = section.querySelector('.tech-stack-trigger[data-index="' + (modal.getAttribute('data-last-index') || '0') + '"]');
    if (trigger) trigger.focus();
  }

  section.querySelectorAll('.tech-stack-trigger').forEach(function(btn) {
    btn.addEventListener('click', function() {
      modal.setAttribute('data-last-index', btn.getAttribute('data-index'));
      openModal(btn);
    });
  });

  if (backdrop) backdrop.addEventListener('click', closeModal);
  var closeBtn = modal && modal.querySelector('.tech-stack-modal-close');
  if (closeBtn) closeBtn.addEventListener('click', closeModal);

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) closeModal();
  });
})();
</script>

{% schema %}
{
  "name": "Tech Stack",
  "tag": "section",
  "class": "section-tech-stack",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "(Powered By)" },
    { "type": "text", "id": "title_before", "label": "Title (before gradient)", "default": "Tech " },
    { "type": "text", "id": "title_gradient", "label": "Title (gradient part)", "default": "Stack" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Industry-leading tools that power your success. Click to learn more." },
    { "type": "text", "id": "footer_text", "label": "Footer text", "default": "Click on any tool to learn more" }
  ],
  "blocks": [
    {
      "type": "tech",
      "name": "Tech item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "bot", "options": [ { "value": "bot", "label": "Bot" }, { "value": "code", "label": "Code" }, { "value": "zap", "label": "Zap" } ] },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "select", "id": "gradient", "label": "Hover glow gradient", "default": "emerald_teal", "options": [ { "value": "emerald_teal", "label": "Emerald → Teal" }, { "value": "orange_amber", "label": "Orange → Amber" }, { "value": "green_emerald", "label": "Green → Emerald" }, { "value": "orange_red", "label": "Orange → Red" }, { "value": "purple_violet", "label": "Purple → Violet" } ] },
        { "type": "url", "id": "url", "label": "Link (optional, shown as Learn more in popup)" },
        { "type": "header", "content": "Popup content" },
        { "type": "text", "id": "popup_tagline", "label": "Popup tagline", "default": "Professional Tool", "info": "e.g. Professional Tool" },
        { "type": "textarea", "id": "popup_description", "label": "Popup description", "default": "Industry-leading tool used in our workflow to deliver exceptional results for your project." },
        { "type": "text", "id": "popup_bullet_1", "label": "Popup bullet 1", "default": "Industry Standard" },
        { "type": "text", "id": "popup_bullet_2", "label": "Popup bullet 2", "default": "Enterprise Ready" },
        { "type": "text", "id": "popup_bullet_3", "label": "Popup bullet 3", "default": "Fully Supported" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tech Stack",
      "settings": {
        "badge": "(Powered By)",
        "title_before": "Tech ",
        "title_gradient": "Stack",
        "subtitle": "Industry-leading tools that power your success. Click to learn more.",
        "footer_text": "Click on any tool to learn more"
      },
      "blocks": [
        { "type": "tech", "settings": { "icon": "bot", "label": "OpenAI", "gradient": "emerald_teal", "popup_tagline": "Professional Tool", "popup_description": "Industry-leading tool used in our workflow to deliver exceptional results for your project.", "popup_bullet_1": "Industry Standard", "popup_bullet_2": "Enterprise Ready", "popup_bullet_3": "Fully Supported" } },
        { "type": "tech", "settings": { "icon": "bot", "label": "Claude", "gradient": "orange_amber", "popup_tagline": "Professional Tool", "popup_description": "Industry-leading tool used in our workflow to deliver exceptional results for your project.", "popup_bullet_1": "Industry Standard", "popup_bullet_2": "Enterprise Ready", "popup_bullet_3": "Fully Supported" } },
        { "type": "tech", "settings": { "icon": "code", "label": "Langchain", "gradient": "green_emerald", "popup_tagline": "Professional Tool", "popup_description": "Industry-leading tool used in our workflow to deliver exceptional results for your project.", "popup_bullet_1": "Industry Standard", "popup_bullet_2": "Enterprise Ready", "popup_bullet_3": "Fully Supported" } },
        { "type": "tech", "settings": { "icon": "zap", "label": "Zapier", "gradient": "orange_red", "popup_tagline": "Professional Tool", "popup_description": "Industry-leading tool used in our workflow to deliver exceptional results for your project.", "popup_bullet_1": "Industry Standard", "popup_bullet_2": "Enterprise Ready", "popup_bullet_3": "Fully Supported" } },
        { "type": "tech", "settings": { "icon": "zap", "label": "Make", "gradient": "purple_violet", "popup_tagline": "Professional Tool", "popup_description": "Industry-leading tool used in our workflow to deliver exceptional results for your project.", "popup_bullet_1": "Industry Standard", "popup_bullet_2": "Enterprise Ready", "popup_bullet_3": "Fully Supported" } }
      ]
    }
  ]
}
{% endschema %}
