{%- comment -%}
  Section: Case Study — Showcase (browser frame)
  Shows the main image setting plus any "Image" blocks, stacked top to bottom
  inside a browser frame. When the stack is taller than the frame it scrolls
  through on hover (desktop); when it is shorter, the images fill the frame.
  Use a full-page website screenshot, or a set of project photos.
{%- endcomment -%}
{%- render 'case-study-landing-assets' -%}
{%- liquid
  assign count = 0
  if section.settings.image != blank
    assign count = 1
  endif
  for block in section.blocks
    if block.settings.image != blank
      assign count = count | plus: 1
    endif
  endfor
-%}
{%- if count > 0 -%}
<section class="csl csl-showcase" id="csl-showcase-{{ section.id }}">
  <div class="csl-wrap">
    <figure class="csl-frame csl-rv">
      <div class="csl-frame__bar">
        <span class="csl-frame__dots" aria-hidden="true"><i></i><i></i><i></i></span>
        {%- if section.settings.url_label != blank -%}
          <span class="csl-frame__url">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
            {{ section.settings.url_label | escape }}
          </span>
        {%- else -%}
          <span></span>
        {%- endif -%}
        {%- if section.settings.link != blank and section.settings.link_label != blank -%}
          <a class="csl-frame__visit" href="{{ section.settings.link }}" target="_blank" rel="noopener">{{ section.settings.link_label | escape }} ↗</a>
        {%- endif -%}
      </div>
      <div class="csl-frame__screen">
        <div class="csl-frame__stack">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 2880
              | image_tag:
                loading: 'lazy',
                widths: '750, 1100, 1500, 1920, 2400, 2880',
                sizes: '(min-width: 1400px) 1304px, 94vw',
                alt: section.settings.image.alt
            }}
          {%- endif -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.image != blank -%}
              <span class="csl-frame__item" {{ block.shopify_attributes }}>
                {{
                  block.settings.image
                  | image_url: width: 2400
                  | image_tag:
                    loading: 'lazy',
                    widths: '750, 1100, 1500, 1920, 2400',
                    sizes: '(min-width: 1400px) 1304px, 94vw',
                    alt: block.settings.image.alt
                }}
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </figure>
    {%- if section.settings.caption != blank or section.settings.hint != blank -%}
      <div class="csl-showcase__foot csl-rv">
        {%- if section.settings.caption != blank -%}<p class="csl-showcase__caption">{{ section.settings.caption | escape }}</p>{%- else -%}<span></span>{%- endif -%}
        {%- if section.settings.hint != blank -%}<span class="csl-showcase__hint">{{ section.settings.hint | escape }}</span>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>
{%- elsif request.design_mode -%}
  <div class="csl csl-wrap"><p class="csl-empty">Case study: showcase. Pick a screenshot, or add Image blocks.</p></div>
{%- endif -%}

{% schema %}
{
  "name": "Case study: showcase",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Main image", "info": "A full-page website screenshot (about 1440px wide) or a photo. Image blocks are stacked under it." },
    { "type": "text", "id": "url_label", "label": "Address bar text", "default": "clientsite.com" },
    { "type": "url", "id": "link", "label": "Site link" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Visit site" },
    { "type": "text", "id": "caption", "label": "Caption" },
    { "type": "text", "id": "hint", "label": "Hover hint (desktop only)", "default": "Hover to scroll" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Case study: showcase" }],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
