{% comment %} Login + recover password. Matches theme: dark bg, white text, rounded-xl inputs, same as contact-form. {% endcomment %}
<section class="relative z-10 py-16 lg:py-24" {{ section.shopify_attributes }}>
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="max-w-md mx-auto">
      {% if section.settings.heading != blank %}
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-2">{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="text-white/50 mb-8">{{ section.settings.subheading }}</p>
      {% endif %}

      {% assign show_recover = false %}
      {% if request.path contains '/recover' %}
        {% assign show_recover = true %}
      {% endif %}

      {% if show_recover %}
        {% comment %} Recover password form (at /account/recover or after successful submit) {% endcomment %}
        {% form 'recover_customer_password', class: 'customer-recover space-y-6' %}
          <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/10">
            <h2 class="text-xl font-semibold text-white mb-4">{{ section.settings.recover_heading | default: 'Reset your password' }}</h2>
            {% if form.posted_successfully? %}
              <p class="p-4 rounded-xl bg-white/10 border border-white/20 text-white text-sm mb-4" role="status">
                {{ section.settings.recover_success | default: "We've sent you an email with a link to reset your password." }}
              </p>
            {% endif %}
            {% if form.errors %}
              <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-200 text-sm mb-4" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}
            <label for="RecoverEmail-{{ section.id }}" class="block text-white/60 text-sm mb-2">{{ section.settings.recover_email_label | default: 'Email' }}</label>
            <input
              type="email"
              id="RecoverEmail-{{ section.id }}"
              name="email"
              class="w-full px-4 py-4 rounded-xl bg-white/[0.02] border border-white/10 text-white placeholder-white/30 focus:border-white/30 focus:outline-none transition-colors"
              placeholder="{{ section.settings.recover_placeholder | default: 'your@email.com' }}"
              autocomplete="email"
            >
            <div class="mt-4 flex flex-wrap items-center gap-4">
              <button type="submit" class="px-6 py-3 rounded-xl bg-white text-black font-semibold hover:bg-gray-100 transition-colors">
                {{ section.settings.recover_button | default: 'Submit' }}
              </button>
              <a href="{{ routes.account_login_url }}" class="text-white/60 hover:text-white text-sm">{{ section.settings.back_to_login | default: 'Back to login' }}</a>
            </div>
          </div>
        {% endform %}
      {% else %}
        {% comment %} Login form {% endcomment %}
        <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/10">
          {% form 'customer_login', class: 'customer-login space-y-6' %}
            {% if form.errors %}
              <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-200 text-sm" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}
            <div>
              <label for="CustomerEmail-{{ section.id }}" class="block text-white/60 text-sm mb-2">{{ section.settings.email_label | default: 'Email' }}</label>
              <input
                type="email"
                id="CustomerEmail-{{ section.id }}"
                name="customer[email]"
                class="w-full px-4 py-4 rounded-xl bg-white/[0.02] border border-white/10 text-white placeholder-white/30 focus:border-white/30 focus:outline-none transition-colors"
                placeholder="{{ section.settings.email_placeholder | default: 'your@email.com' }}"
                autocomplete="email"
                required
                aria-required="true"
                value="{% if form.email %}{{ form.email }}{% endif %}"
              >
            </div>
            <div>
              <label for="CustomerPassword-{{ section.id }}" class="block text-white/60 text-sm mb-2">{{ section.settings.password_label | default: 'Password' }}</label>
              <input
                type="password"
                id="CustomerPassword-{{ section.id }}"
                name="customer[password]"
                class="w-full px-4 py-4 rounded-xl bg-white/[0.02] border border-white/10 text-white placeholder-white/30 focus:border-white/30 focus:outline-none transition-colors"
                placeholder="••••••••"
                autocomplete="current-password"
                required
                aria-required="true"
              >
            </div>
            <div class="flex flex-wrap items-center justify-between gap-4">
              <a href="{{ routes.account_recover_url }}" class="text-white/60 hover:text-white text-sm">{{ section.settings.forgot_label | default: 'Forgot your password?' }}</a>
            </div>
            <button type="submit" class="w-full py-4 rounded-xl bg-white text-black font-semibold hover:bg-gray-100 transition-colors disabled:opacity-50">
              {{ section.settings.submit_label | default: 'Sign in' }}
            </button>
          {% endform %}
        </div>

        {% if section.settings.show_guest_checkout %}
          {% form 'guest_login', class: 'mt-4' %}
            <button type="submit" class="w-full py-3 rounded-xl border border-white/20 text-white hover:bg-white/10 transition-colors font-medium text-sm">
              {{ section.settings.guest_label | default: 'Continue as guest' }}
            </button>
          {% endform %}
        {% endif %}

        <p class="mt-8 text-center text-white/50 text-sm">
          {{ section.settings.register_prompt | default: "Don't have an account?" }}
          <a href="{{ routes.account_register_url }}" class="text-white hover:underline">{{ section.settings.register_link | default: 'Create account' }}</a>
        </p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer login",
  "tag": "section",
  "class": "section-main-customer-login",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Log in" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Sign in to your account to access your orders and downloads." },
    { "type": "header", "content": "Login form" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "your@email.com" },
    { "type": "text", "id": "password_label", "label": "Password label", "default": "Password" },
    { "type": "text", "id": "submit_label", "label": "Submit button", "default": "Sign in" },
    { "type": "text", "id": "forgot_label", "label": "Forgot password link", "default": "Forgot your password?" },
    { "type": "header", "content": "Recover password" },
    { "type": "text", "id": "recover_heading", "label": "Recover heading", "default": "Reset your password" },
    { "type": "text", "id": "recover_email_label", "label": "Recover email label", "default": "Email" },
    { "type": "text", "id": "recover_placeholder", "label": "Recover email placeholder", "default": "your@email.com" },
    { "type": "text", "id": "recover_button", "label": "Recover submit button", "default": "Submit" },
    { "type": "text", "id": "recover_success", "label": "Recover success message", "default": "We've sent you an email with a link to reset your password." },
    { "type": "text", "id": "back_to_login", "label": "Back to login link", "default": "Back to login" },
    { "type": "header", "content": "Register & guest" },
    { "type": "text", "id": "register_prompt", "label": "Register prompt", "default": "Don't have an account?" },
    { "type": "text", "id": "register_link", "label": "Register link text", "default": "Create account" },
    { "type": "checkbox", "id": "show_guest_checkout", "label": "Show guest checkout option", "default": false },
    { "type": "text", "id": "guest_label", "label": "Guest button text", "default": "Continue as guest" }
  ],
  "presets": [{ "name": "Customer login" }]
}
{% endschema %}
