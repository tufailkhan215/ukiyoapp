{% comment %}
  Section: CS - Dynamic Autoworks
  File: sections/cs-dynamic-autoworks.liquid
  Template: templates/page.dynamic-autoworks.json
{% endcomment %}

<style>
  #da-{{ section.id }} {
    --accent:  #a78bfa;
    --bg:      #000;
    --surface: #0a0a0a;
    --border:  rgba(255,255,255,0.07);
    --muted:   rgba(255,255,255,0.48);
    --faint:   rgba(255,255,255,0.28);
    --r:       16px;
    background: var(--bg); color: #f1f5f9; font-family: inherit; min-height: 100vh;
  }
  #da-{{ section.id }} * { box-sizing: border-box; }
  #da-{{ section.id }} img { display: block; width: 100%; height: 100%; object-fit: cover; }
  #da-{{ section.id }} .rv { opacity: 0; transform: translateY(28px); transition: opacity .7s cubic-bezier(.4,0,.2,1), transform .7s cubic-bezier(.4,0,.2,1); }
  #da-{{ section.id }} .rv.in { opacity: 1; transform: none; }

  /* Back */
  #da-{{ section.id }} .da-back { max-width: 1400px; margin: 0 auto; padding: 2rem 1.5rem 0; }
  #da-{{ section.id }} .da-back a { display: inline-flex; align-items: center; gap: .5rem; font-size: .88rem; font-weight: 500; color: var(--muted); text-decoration: none; transition: color .25s; }
  #da-{{ section.id }} .da-back a:hover { color: #fff; }

  /* Top Gallery — 4 images */
  #da-{{ section.id }} .da-gtop { max-width: 1400px; margin: 0 auto; padding: 2rem 1.5rem; }
  #da-{{ section.id }} .da-gtop__grid { display: grid; gap: .9rem; grid-template-columns: repeat(2,1fr); }
  @media (min-width: 768px) { #da-{{ section.id }} .da-gtop__grid { grid-template-columns: repeat(4,1fr); height: 360px; } }
  #da-{{ section.id }} .da-gtop__item { border-radius: var(--r); overflow: hidden; cursor: pointer; border: 1px solid var(--border); min-height: 180px; }
  #da-{{ section.id }} .da-gtop__item img { height: 100%; transition: transform .55s cubic-bezier(.165,.84,.44,1); }
  #da-{{ section.id }} .da-gtop__item:hover img { transform: scale(1.05); }

  /* Header */
  #da-{{ section.id }} .da-hdr { max-width: 1000px; margin: 0 auto; padding: 4rem 1.5rem 2rem; }
  #da-{{ section.id }} .da-badge { display: inline-block; padding: .28rem .9rem; border-radius: 999px; font-size: .65rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; background: rgba(167,139,250,.12); border: 1px solid rgba(167,139,250,.3); color: var(--accent); margin-bottom: 1.25rem; }
  #da-{{ section.id }} .da-title { font-size: clamp(2rem,5vw,3.5rem); font-weight: 900; line-height: 1.08; letter-spacing: -.028em; color: #fff; margin: 0 0 1rem; }
  #da-{{ section.id }} .da-sub { font-size: 1rem; color: var(--muted); line-height: 1.75; max-width: 42rem; margin: 0; border-left: 2px solid rgba(167,139,250,.35); padding-left: 1rem; }

  /* What We Did */
  #da-{{ section.id }} .da-what { max-width: 1000px; margin: 0 auto; padding: 5rem 1.5rem; }
  #da-{{ section.id }} .da-what h2 { font-size: clamp(1.8rem,4vw,2.8rem); font-weight: 900; color: #fff; margin: 0 0 3rem; letter-spacing: -.022em; }
  #da-{{ section.id }} .da-what__grid { display: grid; gap: 3rem; }
  @media (min-width: 768px) { #da-{{ section.id }} .da-what__grid { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  #da-{{ section.id }} .da-what__col h3 { font-size: 1rem; font-weight: 700; color: #fff; margin: 0 0 .85rem; }
  #da-{{ section.id }} .da-what__col p  { font-size: .92rem; color: var(--muted); line-height: 1.78; margin: 0 0 2rem; }
  #da-{{ section.id }} .da-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .65rem; }
  #da-{{ section.id }} .da-list li { display: flex; gap: .65rem; align-items: flex-start; font-size: .88rem; color: var(--muted); line-height: 1.55; }
  #da-{{ section.id }} .da-list li::before { content: '◦'; color: var(--faint); flex-shrink: 0; margin-top: 1px; }

  /* Services */
  #da-{{ section.id }} .da-svc { border-top: 1px solid var(--border); padding: 5rem 0; }
  #da-{{ section.id }} .da-svc__inner { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; display: flex; flex-direction: column; gap: 3rem; align-items: center; }
  @media (min-width: 1024px) {
    #da-{{ section.id }} .da-svc__inner { flex-direction: row; gap: 5rem; }
    #da-{{ section.id }} .da-svc--alt .da-svc__inner { flex-direction: row-reverse; }
  }
  #da-{{ section.id }} .da-svc__img { width: 100%; border-radius: var(--r); overflow: hidden; aspect-ratio: 4/3; cursor: pointer; flex-shrink: 0; border: 1px solid var(--border); }
  @media (min-width: 1024px) { #da-{{ section.id }} .da-svc__img { width: 40%; } }
  #da-{{ section.id }} .da-svc__img img { transition: transform .55s cubic-bezier(.165,.84,.44,1); }
  #da-{{ section.id }} .da-svc__img:hover img { transform: scale(1.04); }
  #da-{{ section.id }} .da-svc__copy { flex: 1; }
  #da-{{ section.id }} .da-svc__copy h3 { font-size: 1.2rem; font-weight: 900; text-transform: uppercase; letter-spacing: .06em; color: #fff; margin: 0 0 .85rem; }
  #da-{{ section.id }} .da-svc__copy > p { font-size: .92rem; color: var(--muted); line-height: 1.75; margin: 0 0 1.5rem; }
  #da-{{ section.id }} .da-feats { display: flex; flex-direction: column; gap: .4rem; }
  #da-{{ section.id }} .da-feat  { font-size: .82rem; color: var(--faint); line-height: 1.55; }
  #da-{{ section.id }} .da-feat strong { color: rgba(255,255,255,.62); font-weight: 600; }

  /* Bottom Gallery */
  #da-{{ section.id }} .da-gbot { max-width: 1200px; margin: 0 auto; padding: 4rem 1.5rem; }
  #da-{{ section.id }} .da-gbot__grid { display: grid; gap: .9rem; grid-template-columns: 1fr; }
  @media (min-width: 768px) { #da-{{ section.id }} .da-gbot__grid { grid-template-columns: repeat(3,1fr); } }
  #da-{{ section.id }} .da-gbot__item { aspect-ratio: 1; border-radius: var(--r); overflow: hidden; cursor: pointer; border: 1px solid var(--border); }
  #da-{{ section.id }} .da-gbot__item img { transition: transform .55s cubic-bezier(.165,.84,.44,1); }
  #da-{{ section.id }} .da-gbot__item:hover img { transform: scale(1.05); }

  /* Stats */
  #da-{{ section.id }} .da-stats { border-top: 1px solid var(--border); padding: 4.5rem 0; }
  #da-{{ section.id }} .da-stats__g { max-width: 1000px; margin: 0 auto; padding: 0 1.5rem; display: grid; gap: 2rem; grid-template-columns: repeat(2,1fr); }
  @media (min-width: 1024px) { #da-{{ section.id }} .da-stats__g { grid-template-columns: repeat(4,1fr); } }
  #da-{{ section.id }} .da-stat { text-align: center; }
  #da-{{ section.id }} .da-stat__v { display: block; font-size: clamp(2.2rem,5vw,3.2rem); font-weight: 900; color: #fff; letter-spacing: -.03em; line-height: 1; margin-bottom: .35rem; }
  #da-{{ section.id }} .da-stat__l { display: block; font-size: .85rem; font-weight: 700; color: rgba(255,255,255,.6); margin-bottom: .2rem; }
  #da-{{ section.id }} .da-stat__d { display: block; font-size: .72rem; color: var(--faint); }

  /* Testimonial */
  #da-{{ section.id }} .da-testi { background: var(--surface); padding: 5rem 1.5rem; border-top: 1px solid var(--border); }
  #da-{{ section.id }} .da-testi__inner { max-width: 800px; margin: 0 auto; text-align: center; }
  #da-{{ section.id }} .da-testi__marks { font-size: 3rem; line-height: 1; color: rgba(167,139,250,.3); margin-bottom: 1rem; display: block; }
  #da-{{ section.id }} .da-testi__q { font-size: clamp(1.1rem,2.8vw,1.55rem); font-weight: 300; color: #fff; line-height: 1.65; margin: 0 0 2.5rem; font-style: italic; }
  #da-{{ section.id }} .da-testi__who { display: flex; align-items: center; justify-content: center; gap: 1rem; }
  #da-{{ section.id }} .da-testi__photo { width: 48px; height: 48px; border-radius: 50%; overflow: hidden; flex-shrink: 0; border: 1px solid var(--border); }
  #da-{{ section.id }} .da-testi__name { display: block; font-size: .92rem; font-weight: 700; color: #fff; }
  #da-{{ section.id }} .da-testi__role { display: block; font-size: .78rem; color: var(--muted); }

  /* CTA */
  #da-{{ section.id }} .da-cta { border-top: 1px solid var(--border); padding: 5.5rem 1.5rem; }
  #da-{{ section.id }} .da-cta__inner { max-width: 1000px; margin: 0 auto; text-align: center; }
  #da-{{ section.id }} .da-cta__h2 { font-size: clamp(1.8rem,4vw,2.8rem); font-weight: 900; color: #fff; margin: 0 0 1rem; letter-spacing: -.022em; }
  #da-{{ section.id }} .da-cta__sub { font-size: 1rem; color: var(--muted); line-height: 1.75; max-width: 36rem; margin: 0 auto 2.5rem; }
  #da-{{ section.id }} .da-cta__btns { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; }
  #da-{{ section.id }} .da-btn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; font-size: .88rem; font-weight: 700; padding: .85rem 1.6rem; border-radius: 999px; text-decoration: none; border: none; cursor: pointer; transition: background .25s, color .25s, transform .2s, box-shadow .25s; }
  #da-{{ section.id }} .da-btn--p { background: #fff; color: #000; }
  #da-{{ section.id }} .da-btn--p:hover { background: #e5e7eb; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,.35); }
  #da-{{ section.id }} .da-btn--s { background: rgba(255,255,255,.05); color: rgba(255,255,255,.8); border: 1px solid rgba(255,255,255,.12); }
  #da-{{ section.id }} .da-btn--s:hover { background: rgba(255,255,255,.1); color: #fff; border-color: rgba(255,255,255,.25); }

  /* Lightbox */
  #da-lb-{{ section.id }} { display: none; position: fixed; inset: 0; z-index: 9999; background: rgba(0,0,0,0.96); align-items: center; justify-content: center; }
  #da-lb-{{ section.id }}.open { display: flex; }
  #da-lb-{{ section.id }} .lb-img { max-width: 90vw; max-height: 88vh; object-fit: contain; width: auto; height: auto; border-radius: 12px; transition: opacity .22s; }
  #da-lb-{{ section.id }} .lb-btn { position: absolute; width: 44px; height: 44px; border-radius: 50%; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.15); color: #fff; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 1.1rem; transition: background .25s; }
  #da-lb-{{ section.id }} .lb-btn:hover { background: rgba(255,255,255,.2); }
  #da-lb-{{ section.id }} .lb-close { top: 1.25rem; right: 1.25rem; }
  #da-lb-{{ section.id }} .lb-prev  { left: 1.25rem; top: 50%; transform: translateY(-50%); }
  #da-lb-{{ section.id }} .lb-next  { right: 1.25rem; top: 50%; transform: translateY(-50%); }
  #da-lb-{{ section.id }} .lb-dots  { position: absolute; bottom: 1.25rem; left: 50%; transform: translateX(-50%); display: flex; gap: .4rem; }
  #da-lb-{{ section.id }} .lb-dot   { height: 3px; width: 16px; border-radius: 999px; background: rgba(255,255,255,.3); cursor: pointer; border: none; transition: background .25s, width .25s; }
  #da-lb-{{ section.id }} .lb-dot.on{ background: #fff; width: 28px; }

  @media (prefers-reduced-motion: reduce) {
    #da-{{ section.id }} .rv { opacity: 1 !important; transform: none !important; transition: none !important; }
    #da-{{ section.id }} img { transition: none !important; }
  }
</style>

<div id="da-{{ section.id }}">

  <div class="da-back">
    <a href="{{ section.settings.back_url | default: '/pages/work' }}">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" width="15" height="15"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      {{ section.settings.back_label | default: 'Back' }}
    </a>
  </div>

  <!-- Top Gallery (4 images) -->
  <div class="da-gtop rv">
    <div class="da-gtop__grid">
      {%- for i in (1..4) -%}
        {%- assign gk = 'gallery_image_' | append: i -%}
        {%- if section.settings[gk] -%}
          <div class="da-gtop__item" data-lbidx="{{ i | minus: 1 }}" tabindex="0" role="button" aria-label="Open image {{ i }}">
            <img src="{{ section.settings[gk] | img_url: '800x' }}" alt="{{ section.settings.client }} {{ i }}" loading="{% if i <= 2 %}eager{% else %}lazy{% endif %}">
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <!-- Header -->
  <div class="da-hdr rv">
    {%- if section.settings.category != blank -%}<span class="da-badge">{{ section.settings.category }}</span>{%- endif -%}
    <h1 class="da-title">{{ section.settings.title }}</h1>
    {%- if section.settings.subtitle != blank -%}<p class="da-sub">{{ section.settings.subtitle }}</p>{%- endif -%}
  </div>

  <!-- What We Did -->
  <section class="da-what">
    <h2 class="rv">What we did</h2>
    <div class="da-what__grid">
      <div class="da-what__col rv">
        <h3>Client expectations</h3>
        <p>{{ section.settings.challenge }}</p>
        {%- assign has_exp = false -%}
        {%- for i in (1..6) -%}{%- assign ek = 'expectation_' | append: i -%}{%- if section.settings[ek] != blank -%}{%- assign has_exp = true -%}{%- endif -%}{%- endfor -%}
        {%- if has_exp -%}
          <h3>Expected outcomes</h3>
          <ul class="da-list">{%- for i in (1..6) -%}{%- assign ek = 'expectation_' | append: i -%}{%- if section.settings[ek] != blank -%}<li>{{ section.settings[ek] }}</li>{%- endif -%}{%- endfor -%}</ul>
        {%- endif -%}
      </div>
      <div class="da-what__col rv">
        <h3>How we did it</h3>
        <p>{{ section.settings.solution }}</p>
        {%- assign has_out = false -%}
        {%- for i in (1..6) -%}{%- assign ok = 'outcome_' | append: i -%}{%- if section.settings[ok] != blank -%}{%- assign has_out = true -%}{%- endif -%}{%- endfor -%}
        {%- if has_out -%}
          <h3>Delivered results</h3>
          <ul class="da-list">{%- for i in (1..6) -%}{%- assign ok = 'outcome_' | append: i -%}{%- if section.settings[ok] != blank -%}<li>{{ section.settings[ok] }}</li>{%- endif -%}{%- endfor -%}</ul>
        {%- endif -%}
      </div>
    </div>
  </section>

  <!-- Services -->
  {%- for block in section.blocks -%}
    {%- if block.type == 'service' -%}
      {%- assign alt = forloop.index0 | modulo: 2 -%}
      <div class="da-svc{% if alt == 1 %} da-svc--alt{% endif %}" {{ block.shopify_attributes }}>
        <div class="da-svc__inner">
          {%- if block.settings.image -%}
            <div class="da-svc__img rv" data-lbsrc="{{ block.settings.image | img_url: '1400x' }}">
              <img src="{{ block.settings.image | img_url: '800x' }}" alt="{{ block.settings.title }}" loading="lazy">
            </div>
          {%- endif -%}
          <div class="da-svc__copy rv">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
            {%- if block.settings.features != blank -%}
              <div class="da-feats">
                {%- assign feats = block.settings.features | split: '|' -%}
                {%- for feat in feats -%}
                  {%- if feat != blank -%}
                    {%- assign pts = feat | strip | split: ':' -%}
                    <p class="da-feat">{%- if pts.size > 1 -%}<strong>{{ pts[0] }}:</strong>{{ pts | shift | join: ':' }}{%- else -%}{{ feat }}{%- endif -%}</p>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}

  <!-- Bottom Gallery -->
  {%- assign has_bot = false -%}
  {%- for i in (1..3) -%}{%- assign bk = 'gallery_bot_' | append: i -%}{%- if section.settings[bk] != blank -%}{%- assign has_bot = true -%}{%- endif -%}{%- endfor -%}
  {%- if has_bot -%}
    <div class="da-gbot rv">
      <div class="da-gbot__grid">
        {%- for i in (1..3) -%}
          {%- assign bk = 'gallery_bot_' | append: i -%}
          {%- if section.settings[bk] != blank -%}
            <div class="da-gbot__item" data-lbset="bot" data-lbidx="{{ i | minus: 1 }}" tabindex="0" role="button" aria-label="Open gallery image {{ i }}">
              <img src="{{ section.settings[bk] | img_url: '800x' }}" alt="{{ section.settings.client }} gallery {{ i }}" loading="lazy">
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <!-- Stats -->
  <div class="da-stats">
    <div class="da-stats__g">
      {%- for i in (1..4) -%}
        {%- assign vk = 'stat_value_' | append: i -%}
        {%- assign lk = 'stat_label_' | append: i -%}
        {%- assign dk = 'stat_desc_'  | append: i -%}
        {%- if section.settings[vk] != blank -%}
          <div class="da-stat rv">
            <span class="da-stat__v">{{ section.settings[vk] }}</span>
            <span class="da-stat__l">{{ section.settings[lk] }}</span>
            {%- if section.settings[dk] != blank -%}<span class="da-stat__d">{{ section.settings[dk] }}</span>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <!-- Testimonial -->
  {%- if section.settings.testimonial_quote != blank -%}
    <div class="da-testi">
      <div class="da-testi__inner rv">
        <span class="da-testi__marks">&ldquo;</span>
        <p class="da-testi__q">{{ section.settings.testimonial_quote }}</p>
        <div class="da-testi__who">
          {%- if section.settings.testimonial_photo -%}
            <div class="da-testi__photo"><img src="{{ section.settings.testimonial_photo | img_url: '200x200' }}" alt="{{ section.settings.testimonial_author }}" loading="lazy"></div>
          {%- endif -%}
          <div>
            <span class="da-testi__name">{{ section.settings.testimonial_author }}</span>
            <span class="da-testi__role">{{ section.settings.testimonial_role }}{%- if section.settings.testimonial_company != blank -%}, {{ section.settings.testimonial_company }}{%- endif -%}</span>
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  <!-- CTA -->
  <div class="da-cta">
    <div class="da-cta__inner rv">
      <h2 class="da-cta__h2">{{ section.settings.cta_heading }}</h2>
      <p class="da-cta__sub">{{ section.settings.cta_subtext }}</p>
      <div class="da-cta__btns">
        {%- if section.settings.cta_primary_label != blank -%}
          <a href="{{ section.settings.cta_primary_url | default: '#' }}" class="da-btn da-btn--p">
            {{ section.settings.cta_primary_label }}
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7v10"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.cta_secondary_label != blank -%}
          <a href="{{ section.settings.cta_secondary_url | default: '#' }}" class="da-btn da-btn--s">{{ section.settings.cta_secondary_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>

</div>

<div id="da-lb-{{ section.id }}" role="dialog" aria-modal="true" aria-label="Image viewer">
  <button class="lb-btn lb-close" aria-label="Close">✕</button>
  <button class="lb-btn lb-prev"  aria-label="Previous">‹</button>
  <button class="lb-btn lb-next"  aria-label="Next">›</button>
  <img class="lb-img" src="" alt="">
  <div class="lb-dots"></div>
</div>

<script>
(function(){
  var sid  = '{{ section.id }}';
  var root = document.getElementById('da-' + sid);
  var lb   = document.getElementById('da-lb-' + sid);
  if (!root || !lb) return;
  var lbImg = lb.querySelector('.lb-img'), lbDots = lb.querySelector('.lb-dots');
  var rvEls = root.querySelectorAll('.rv');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } }); }, {threshold:0.1});
    rvEls.forEach(function(el,i){ el.style.transitionDelay=Math.min(i*0.05,0.35)+'s'; io.observe(el); });
  } else { rvEls.forEach(function(el){ el.classList.add('in'); }); }

  var lbSrcs=[], lbIdx=0;
  function openLb(srcs,idx){ lbSrcs=srcs.filter(Boolean); lbIdx=Math.min(idx,lbSrcs.length-1); renderLb(); buildDots(); lb.classList.add('open'); document.body.style.overflow='hidden'; }
  function renderLb(){ lbImg.style.opacity='0'; setTimeout(function(){ lbImg.src=lbSrcs[lbIdx]||''; lbImg.style.opacity='1'; },180); lb.querySelectorAll('.lb-dot').forEach(function(d,i){ d.classList.toggle('on',i===lbIdx); }); }
  function buildDots(){ lbDots.innerHTML=''; lbSrcs.forEach(function(_,i){ var d=document.createElement('button'); d.className='lb-dot'+(i===lbIdx?' on':''); d.setAttribute('aria-label','Image '+(i+1)); d.addEventListener('click',function(){ lbIdx=i; renderLb(); }); lbDots.appendChild(d); }); }
  function closeLb(){ lb.classList.remove('open'); document.body.style.overflow=''; }

  var topSrcs=[].slice.call(root.querySelectorAll('.da-gtop__item')).map(function(el){ var img=el.querySelector('img'); return img?img.src:''; });
  var botSrcs=[].slice.call(root.querySelectorAll('.da-gbot__item')).map(function(el){ var img=el.querySelector('img'); return img?img.src:''; });

  root.querySelectorAll('.da-gtop__item').forEach(function(el){ el.addEventListener('click',function(){ openLb(topSrcs,parseInt(el.dataset.lbidx)||0); }); el.addEventListener('keydown',function(e){ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); el.click(); } }); });
  root.querySelectorAll('.da-svc__img[data-lbsrc]').forEach(function(el){ el.addEventListener('click',function(){ openLb([el.dataset.lbsrc],0); }); });
  root.querySelectorAll('.da-gbot__item').forEach(function(el){ el.addEventListener('click',function(){ openLb(botSrcs,parseInt(el.dataset.lbidx)||0); }); el.addEventListener('keydown',function(e){ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); el.click(); } }); });

  lb.querySelector('.lb-close').addEventListener('click',closeLb);
  lb.querySelector('.lb-prev').addEventListener('click',function(){ lbIdx=(lbIdx-1+lbSrcs.length)%lbSrcs.length; renderLb(); });
  lb.querySelector('.lb-next').addEventListener('click',function(){ lbIdx=(lbIdx+1)%lbSrcs.length; renderLb(); });
  lb.addEventListener('click',function(e){ if(e.target===lb) closeLb(); });
  document.addEventListener('keydown',function(e){ if(!lb.classList.contains('open')) return; if(e.key==='Escape') closeLb(); if(e.key==='ArrowLeft'){ lbIdx=(lbIdx-1+lbSrcs.length)%lbSrcs.length; renderLb(); } if(e.key==='ArrowRight'){ lbIdx=(lbIdx+1)%lbSrcs.length; renderLb(); } });
})();
</script>

