{%- comment -%}
  Section: Case Study — Story chapters
  "Chapter" blocks are numbered and listed in the sticky side index.
  "Pull quote" blocks sit between chapters and are not numbered.
{%- endcomment -%}
{%- render 'case-study-landing-assets' -%}
<section class="csl csl-section csl-chapters" id="csl-chapters-{{ section.id }}" data-csl-chapters>
  <div class="csl-wrap">
    <header class="csl-chapters__header csl-rv">
      {%- if section.settings.strap != blank -%}
        <span class="csl-strap">({{ section.settings.strap | escape }})</span>
      {%- endif -%}
      <h2 class="csl-h2">{{ section.settings.heading | escape }}{% if section.settings.heading_accent != blank %} <span class="csl-grad">{{ section.settings.heading_accent | escape }}</span>{% endif %}</h2>
    </header>

    <div class="csl-chapters__grid">
      <nav class="csl-toc" aria-label="{{ section.settings.toc_label | default: 'In this case study' | escape }}">
        <span class="csl-strap">{{ section.settings.toc_label | default: 'In this case study' | escape }}</span>
        <ol role="list">
          {%- assign c = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'chapter' -%}
              {%- assign c = c | plus: 1 -%}
              <li><a href="#csl-ch-{{ block.id }}"><span>{% if c < 10 %}0{% endif %}{{ c }}</span>{{ block.settings.title | escape }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      </nav>

      <div class="csl-chapters__body">
        {%- assign c = 0 -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'chapter' -%}
              {%- assign c = c | plus: 1 -%}
              <article class="csl-chapter csl-rv" id="csl-ch-{{ block.id }}" {{ block.shopify_attributes }}>
                <div class="csl-chapter__head">
                  <span class="csl-chapter__num" aria-hidden="true">{% if c < 10 %}0{% endif %}{{ c }}</span>
                  <h3 class="csl-chapter__title">{{ block.settings.title | escape }}</h3>
                </div>
                <div class="csl-chapter__text">{{ block.settings.text }}</div>
              </article>
            {%- when 'quote' -%}
              <figure class="csl-pull csl-rv" {{ block.shopify_attributes }}>
                <span class="csl-pull__mark" aria-hidden="true">&ldquo;</span>
                <p>{{ block.settings.text | escape }}</p>
              </figure>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Case study: chapters",
  "settings": [
    { "type": "text", "id": "strap", "label": "Label", "default": "The Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How we" },
    { "type": "text", "id": "heading_accent", "label": "Heading (grey part)", "default": "approached it" },
    { "type": "text", "id": "toc_label", "label": "Side index label", "default": "In this case study" }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Chapter",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Our approach" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell this part of the story.</p>" }
      ]
    },
    {
      "type": "quote",
      "name": "Pull quote",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Quote", "default": "A line from the story worth pulling out." }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Case study: chapters",
      "blocks": [{ "type": "chapter" }, { "type": "chapter", "settings": { "title": "The strategy" } }]
    }
  ],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
