{% comment %}
  UKIYO — cinematic scroll-driven Work Hero.
  Self-contained Shopify section. No React or Tailwind required.
{% endcomment %}

{% liquid
  assign stats = section.blocks | where: 'type', 'stat'
  assign projects = section.blocks | where: 'type', 'project'
  assign buttons = section.blocks | where: 'type', 'button'
  assign screen_count = section.settings.scroll_length | divided_by: 100.0
%}

<section
  id="UkiyoCinema-{{ section.id }}"
  class="uc"
  data-testid="work-hero"
  style="--uc-screens: {{ screen_count }};"
>
  <div class="uc__frame">

    <div class="uc__backdrop" aria-hidden="true">
      {% if section.settings.poster != blank %}
        {{
          section.settings.poster
          | image_url: width: 2400
          | image_tag:
            class: 'uc__poster',
            loading: 'eager',
            fetchpriority: 'high',
            alt: ''
        }}
      {% endif %}
    </div>

    {% for layer in (0..2) %}
      <div
        class="uc__media-layer {% if layer == 0 %}uc__base{% else %}uc__wipe uc__wipe--{{ layer }}{% endif %}"
        data-layer="{{ layer }}"
        aria-hidden="true"
      >
        <div class="uc__media-inner">
          {% if section.settings.video_url != blank %}
            <video
              class="uc__video"
              data-video="{{ layer }}"
              data-src="{{ section.settings.video_url | escape }}"
              muted
              playsinline
              preload="metadata"
              disablepictureinpicture
              tabindex="-1"
              {% if section.settings.poster != blank %}
                poster="{{ section.settings.poster | image_url: width: 2000 }}"
              {% endif %}
            ></video>
          {% endif %}
          <div class="uc__shade"></div>
        </div>
      </div>
    {% endfor %}

    <header class="uc__header">
      <a class="uc__brand" href="{{ routes.root_url }}">
        {{ section.settings.brand_name | escape }}
      </a>

      <div class="uc__header-actions">
        {% if section.settings.contact_label != blank and section.settings.contact_link != blank %}
          <a class="uc__contact" href="{{ section.settings.contact_link | escape }}">
            {{ section.settings.contact_label | escape }}
            <span aria-hidden="true">↗</span>
          </a>
        {% endif %}

        <button
          class="uc__mode"
          type="button"
          data-mode
          aria-pressed="false"
          hidden
        >
          View all content
        </button>
      </div>
    </header>

    <div class="uc__intro" data-scene="intro">
      {% if section.settings.strap != blank %}
        <p class="uc__eyebrow">{{ section.settings.strap | escape }}</p>
      {% endif %}

      <h1 class="uc__wordmark">
        <span class="uc__sr-only">
          {{ section.settings.brand_name | escape }}
        </span>

        <svg
          viewBox="0 0 1000 240"
          role="presentation"
          aria-hidden="true"
          focusable="false"
        >
          <text
            x="500"
            y="200"
            text-anchor="middle"
            textLength="960"
            lengthAdjust="spacingAndGlyphs"
          >{{ section.settings.brand_name | escape }}</text>
        </svg>
      </h1>

      <button class="uc__scroll" type="button" data-explore hidden>
        <span>{{ section.settings.scroll_label | escape }}</span>
        <span class="uc__scroll-track" aria-hidden="true">
          <span></span>
        </span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 4v15m-6-6 6 6 6-6"/>
        </svg>
      </button>
    </div>

    <div class="uc__about" data-scene="about">
      <p class="uc__eyebrow">Strategy. Creativity. Connection.</p>

      {% if section.settings.description != blank %}
        <p class="uc__about-copy">
          {{ section.settings.description | escape | newline_to_br }}
        </p>
      {% endif %}
    </div>

    <div class="uc__works" data-scene="works">
      <div class="uc__works-inner" data-works-inner>
        <div class="uc__works-heading">
          <p class="uc__eyebrow">{{ section.settings.work_label | escape }}</p>

          <h2 class="uc__work-title">
            {% if section.settings.title_line_1 != blank %}
              <span>{{ section.settings.title_line_1 | escape }}</span>
            {% endif %}

            {% if section.settings.title_line_2 != blank %}
              <span class="uc__work-title-secondary">
                {{ section.settings.title_line_2 | escape }}
              </span>
            {% endif %}
          </h2>
        </div>

        {% if section.settings.work_intro != blank %}
          <p class="uc__work-intro">
            {{ section.settings.work_intro | escape | newline_to_br }}
          </p>
        {% endif %}

        {% if projects.size > 0 %}
          <div class="uc__project-list">
            {% for block in projects %}
              <article
                class="uc__project"
                data-project
                {{ block.shopify_attributes }}
              >
                <span class="uc__project-index">
                  {% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}
                </span>

                <div class="uc__project-copy">
                  <h3>
                    {% if block.settings.link != blank %}
                      <a href="{{ block.settings.link | escape }}">
                        {{ block.settings.title | escape }}
                        <span aria-hidden="true">↗</span>
                      </a>
                    {% else %}
                      {{ block.settings.title | escape }}
                    {% endif %}
                  </h3>

                  {% if block.settings.category != blank %}
                    <p>{{ block.settings.category | escape }}</p>
                  {% endif %}
                </div>

                {% if block.settings.year != blank %}
                  <span class="uc__project-year">
                    {{ block.settings.year | escape }}
                  </span>
                {% endif %}
              </article>
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.work_note != blank %}
          <p class="uc__work-note">
            {{ section.settings.work_note | escape }}
          </p>
        {% endif %}
      </div>
    </div>

    {% if stats.size > 0 %}
      <div class="uc__stats">
        {% for block in stats %}
          <dl
            class="uc__stat"
            data-stat
            {{ block.shopify_attributes }}
          >
            {% if block.settings.label != blank %}
              <dt>{{ block.settings.label | escape }}</dt>
            {% endif %}

            {% if block.settings.value != blank %}
              <dd>{{ block.settings.value | escape }}</dd>
            {% endif %}
          </dl>
        {% endfor %}
      </div>
    {% endif %}

    <div class="uc__outro" data-scene="outro">
      <p class="uc__eyebrow">{{ section.settings.end_label | escape }}</p>

      <h2>{{ section.settings.end_title | escape | newline_to_br }}</h2>

      {% if buttons.size > 0 %}
        <div class="uc__buttons">
          {% for block in buttons %}
            <div class="uc__button-block" {{ block.shopify_attributes }}>
              {% if block.settings.label != blank and block.settings.link != blank %}
                <a class="uc__button" href="{{ block.settings.link | escape }}">
                  {{ block.settings.label | escape }}
                  <span aria-hidden="true">↗</span>
                </a>
              {% elsif request.design_mode %}
                <span class="uc__button-placeholder">
                  Add a button label and link
                </span>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}

      <button class="uc__continue" type="button" data-next hidden>
        {{ section.settings.continue_label | escape }}
        <span aria-hidden="true">↓</span>
      </button>
    </div>

    <div class="uc__progress" aria-hidden="true">
      <span data-progress></span>
    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=BBH+Bartle&family=Alex+Brush&family=Inter+Tight:wght@400;500;600&display=swap');

  #UkiyoCinema-{{ section.id }} {
    --uc-pad: clamp(20px, 4vw, 72px);
    position: relative;
    isolation: isolate;
    color: #fff;
    background: #000;
    font-family: "Inter Tight", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  #UkiyoCinema-{{ section.id }} *,
  #UkiyoCinema-{{ section.id }} *::before,
  #UkiyoCinema-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #UkiyoCinema-{{ section.id }} :is(h1, h2, h3, p, dl, dd) {
    margin: 0;
    color: inherit;
  }

  #UkiyoCinema-{{ section.id }} a {
    color: inherit;
    text-decoration: none;
  }

  #UkiyoCinema-{{ section.id }} button {
    font: inherit;
    color: inherit;
    cursor: pointer;
  }

  #UkiyoCinema-{{ section.id }} [hidden] {
    display: none !important;
  }

  #UkiyoCinema-{{ section.id }} :is(a, button):focus-visible {
    outline: 2px solid #eb0004;
    outline-offset: 6px;
    box-shadow: 0 0 0 8px #000;
  }

  #UkiyoCinema-{{ section.id }} .uc__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  #UkiyoCinema-{{ section.id }} .uc__frame {
    position: relative;
    isolation: isolate;
    background: #000;
  }

  #UkiyoCinema-{{ section.id }} .uc__backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    opacity: .45;
  }

  #UkiyoCinema-{{ section.id }} .uc__poster,
  #UkiyoCinema-{{ section.id }} .uc__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #UkiyoCinema-{{ section.id }} .uc__media-layer {
    display: none;
    pointer-events: none;
  }

  #UkiyoCinema-{{ section.id }} .uc__header {
    position: relative;
    z-index: 12;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 24px var(--uc-pad);
  }

  #UkiyoCinema-{{ section.id }} .uc__brand {
    font-size: clamp(17px, 1.7vw, 26px);
    font-weight: 600;
    letter-spacing: -.06em;
    overflow-wrap: anywhere;
  }

  #UkiyoCinema-{{ section.id }} .uc__header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 24px;
  }

  #UkiyoCinema-{{ section.id }} .uc__contact,
  #UkiyoCinema-{{ section.id }} .uc__mode {
    font-size: 11px;
    line-height: 1.3;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  #UkiyoCinema-{{ section.id }} .uc__contact {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
  }

  #UkiyoCinema-{{ section.id }} .uc__mode {
    min-height: 44px;
    padding: 10px 15px;
    border: 1px solid #ffffff40;
    border-radius: 999px;
    background: #0007;
  }

  #UkiyoCinema-{{ section.id }} .uc__eyebrow {
    font-size: clamp(11px, 1.05vw, 15px);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  #UkiyoCinema-{{ section.id }} .uc__intro {
    padding: 120px var(--uc-pad) 70px;
    text-align: center;
  }

  #UkiyoCinema-{{ section.id }} .uc__wordmark {
    width: 100%;
    line-height: 1;
  }

  #UkiyoCinema-{{ section.id }} .uc__wordmark svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  #UkiyoCinema-{{ section.id }} .uc__wordmark text {
    fill: #fff;
    font-family: "BBH Bartle", Arial, sans-serif;
    font-size: 200px;
    font-weight: 400;
  }

  #UkiyoCinema-{{ section.id }} .uc__scroll {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    min-width: 100px;
    min-height: 44px;
    margin-top: 24px;
    padding: 8px;
    border: 0;
    background: none;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .16em;
  }

  #UkiyoCinema-{{ section.id }} .uc__scroll-track {
    position: relative;
    display: block;
    width: 1px;
    height: 42px;
    overflow: hidden;
    background: #ffffff30;
  }

  #UkiyoCinema-{{ section.id }} .uc__scroll-track span {
    position: absolute;
    inset: -45% 0 auto;
    height: 45%;
    background: #fff;
    animation: uc-scroll-line 1.6s ease-in-out 3;
  }

  #UkiyoCinema-{{ section.id }} .uc__scroll svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  @keyframes uc-scroll-line {
    from { transform: translateY(0); }
    to { transform: translateY(140px); }
  }

  #UkiyoCinema-{{ section.id }} .uc__about {
    padding: 80px var(--uc-pad);
  }

  #UkiyoCinema-{{ section.id }} .uc__about-copy {
    max-width: 880px;
    margin-top: 24px;
    font-size: clamp(23px, 3.3vw, 52px);
    font-weight: 500;
    line-height: 1.14;
    letter-spacing: -.035em;
    text-wrap: pretty;
  }

  #UkiyoCinema-{{ section.id }} .uc__works {
    position: relative;
    background: #000;
  }

  #UkiyoCinema-{{ section.id }} .uc__works-inner {
    width: 100%;
    max-width: 1500px;
    margin: 0 auto;
    padding: 100px var(--uc-pad);
  }

  #UkiyoCinema-{{ section.id }} .uc__work-title {
    max-width: 1150px;
    margin-top: 24px;
    font-family: "BBH Bartle", Arial, sans-serif;
    font-size: clamp(25px, 5vw, 78px);
    font-weight: 400;
    line-height: 1.22;
    overflow-wrap: anywhere;
  }

  #UkiyoCinema-{{ section.id }} .uc__work-title span {
    display: block;
  }

  #UkiyoCinema-{{ section.id }} .uc__work-title-secondary {
    color: #ffffffa6;
  }

  #UkiyoCinema-{{ section.id }} .uc__work-intro {
    max-width: 560px;
    margin: 48px 0 60px auto;
    font-size: clamp(18px, 2.1vw, 30px);
    line-height: 1.35;
    text-wrap: pretty;
  }

  #UkiyoCinema-{{ section.id }} .uc__project-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 6vw;
    margin-top: 56px;
  }

  #UkiyoCinema-{{ section.id }} .uc__project {
    display: flex;
    align-items: baseline;
    gap: 18px;
    min-width: 0;
    padding: 26px 0;
    border-top: 1px solid #ffffff30;
  }

  #UkiyoCinema-{{ section.id }} .uc__project-index,
  #UkiyoCinema-{{ section.id }} .uc__project-year {
    font-size: 11px;
    color: #ffffffa6;
  }

  #UkiyoCinema-{{ section.id }} .uc__project-copy {
    flex: 1;
    min-width: 0;
  }

  #UkiyoCinema-{{ section.id }} .uc__project h3 {
    font: 500 clamp(21px, 2.3vw, 34px)/1.2 "Inter Tight", Arial, sans-serif;
    letter-spacing: -.03em;
    overflow-wrap: anywhere;
  }

  #UkiyoCinema-{{ section.id }} .uc__project h3 a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  #UkiyoCinema-{{ section.id }} .uc__project-copy p {
    margin-top: 10px;
    font-size: 13px;
    line-height: 1.5;
    color: #ffffffa6;
  }

  #UkiyoCinema-{{ section.id }} .uc__work-note {
    max-width: 600px;
    margin: 64px auto 0;
    text-align: center;
    font-size: 14px;
    line-height: 1.6;
    color: #ffffffb3;
  }

  #UkiyoCinema-{{ section.id }} .uc__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
    padding: 90px var(--uc-pad);
  }

  #UkiyoCinema-{{ section.id }} .uc__stat {
    min-width: 0;
    text-align: center;
  }

  #UkiyoCinema-{{ section.id }} .uc__stat dt {
    font-size: clamp(12px, 1.7vw, 24px);
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  #UkiyoCinema-{{ section.id }} .uc__stat dd {
    margin-top: 15px;
    font-family: "Alex Brush", Georgia, serif;
    font-size: clamp(60px, 12vw, 180px);
    line-height: 1;
    overflow-wrap: anywhere;
  }

  #UkiyoCinema-{{ section.id }} .uc__outro {
    padding: 110px var(--uc-pad);
    text-align: center;
  }

  #UkiyoCinema-{{ section.id }} .uc__outro h2 {
    max-width: 1100px;
    margin: 24px auto 0;
    font-size: clamp(40px, 8vw, 120px);
    font-weight: 500;
    line-height: .98;
    letter-spacing: -.065em;
    text-wrap: balance;
  }

  #UkiyoCinema-{{ section.id }} .uc__buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 36px;
  }

  #UkiyoCinema-{{ section.id }} .uc__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 26px;
    min-height: 52px;
    padding: 15px 26px;
    border: 1px solid #ffffff80;
    border-radius: 999px;
    font-size: 14px;
    background: #0005;
    transition: background .2s, color .2s;
  }

  #UkiyoCinema-{{ section.id }} .uc__button:hover {
    color: #000;
    background: #fff;
  }

  #UkiyoCinema-{{ section.id }} .uc__button-placeholder {
    display: block;
    padding: 16px;
    border: 1px dashed #ffffff60;
    font-size: 13px;
  }

  #UkiyoCinema-{{ section.id }} .uc__continue {
    display: inline-flex;
    align-items: center;
    gap: 20px;
    min-height: 44px;
    margin-top: 32px;
    padding: 10px 0;
    border: 0;
    border-bottom: 1px solid #ffffff60;
    background: none;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  #UkiyoCinema-{{ section.id }} .uc__progress {
    display: none;
  }

  /* Scroll mode is enabled only after JavaScript initializes. */

  #UkiyoCinema-{{ section.id }}.uc--animated {
    height: calc(100vh * var(--uc-screens));
    height: calc(100svh * var(--uc-screens));
  }

  #UkiyoCinema-{{ section.id }}.uc--animated .uc__frame {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    perspective: 1200px;
  }

  #UkiyoCinema-{{ section.id }}.uc--animated .uc__header {
    position: absolute;
    inset: 0 0 auto;
    padding-top: max(20px, env(safe-area-inset-top));
    background: linear-gradient(#0006, transparent);
  }

  #UkiyoCinema-{{ section.id }}.uc--animated .uc__media-layer {
    display: block;
    position: absolute;
    overflow: hidden;
    background: #000;
  }

  #UkiyoCinema-{{ section.id }}.uc--animated .uc__base {
    inset: 0;
    z-index: 0;
  }

  #UkiyoCinema-{{ section.id }} .uc__media-inner {
    position: absolute;
    inset: 0;
  }

  #UkiyoCinema-{{ section.id }} .uc__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      #0004 0%,
      #0001 30%,
      #0006 65%,
      #000c 100%
    );
  }

  #UkiyoCinema-{{ section.id }}.uc--animated .uc__wipe {
    top: 50%;
    left: 50%;
    width: 0;
    visibility: hidden;
  }

  #UkiyoCinema-{{ section.id }} .uc__wipe--1 {
    z-index: 5;
  }

  #UkiyoCinema-{{ section.id }} .uc__wipe--2 {
    z-index: 7;
  }

  #UkiyoCinema-{{ section.id }}.uc--animated .uc__wipe .uc__media-inner {
    inset: auto;
    top: 50%;
    left: 50%;
    width: var(--uc-width);
    height: var(--uc-height);
  }

  #UkiyoCinema-{{ section.id }}.uc--animated .uc__intro {
    position: absolute;
    inset: auto 0 5%;
    z-index: 8;
    padding: 0 var(--uc-pad);
    transform-origin: 50% 100%;
    will-change: transform, opacity;
  }

  #UkiyoCinema-{{ section.id }}.uc--animated .uc__about {
    position: absolute;
    inset: auto 0 13%;
    z-index: 4;
    padding: 0 var(--uc-pad);
  }

  #UkiyoCinema-{{ section.id }}.uc--animated .uc__works {
    position: absolute;
    inset: 0;
    z-index: 6;
    overflow: hidden;
    background: transparent;
  }

  #UkiyoCinema-{{ section.id }}.uc--animated .uc__works-inner {
    position: absolute;
    top: 0;
    left: 50%;
    margin: 0;
    will-change: transform;
  }

  #UkiyoCinema-{{ section.id }}.uc--animated .uc__stats {
    display: contents;
  }

  #UkiyoCinema-{{ section.id }}.uc--animated .uc__stat {
    position: absolute;
    inset: auto var(--uc-pad) 10%;
    z-index: 8;
    transform-origin: 50% 100%;
    will-change: transform, opacity;
  }

  #UkiyoCinema-{{ section.id }}.uc--animated .uc__outro {
    position: absolute;
    inset: 0;
    z-index: 8;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 100px var(--uc-pad) 50px;
  }

  #UkiyoCinema-{{ section.id }}.uc--animated .uc__progress {
    display: block;
    position: absolute;
    inset: auto 0 0;
    z-index: 15;
    height: 2px;
    background: #ffffff20;
  }

  #UkiyoCinema-{{ section.id }} .uc__progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
  }

  @media (max-width: 749px) {
    #UkiyoCinema-{{ section.id }} .uc__header {
      gap: 12px;
    }

    #UkiyoCinema-{{ section.id }} .uc__header-actions {
      gap: 12px;
    }

    #UkiyoCinema-{{ section.id }} .uc__mode {
      max-width: 110px;
      font-size: 9px;
      padding: 8px 12px;
    }

    #UkiyoCinema-{{ section.id }} .uc__contact {
      font-size: 10px;
      gap: 6px;
    }

    #UkiyoCinema-{{ section.id }} .uc__project-list {
      grid-template-columns: 1fr;
      margin-top: 36px;
    }

    #UkiyoCinema-{{ section.id }} .uc__project {
      padding: 22px 0;
      gap: 12px;
    }

    #UkiyoCinema-{{ section.id }} .uc__works-inner {
      padding-top: 95px;
      padding-bottom: 60px;
    }

    #UkiyoCinema-{{ section.id }} .uc__work-intro {
      margin: 30px 0;
    }

    #UkiyoCinema-{{ section.id }} .uc__stats {
      gap: 40px 20px;
    }

    #UkiyoCinema-{{ section.id }}.uc--animated .uc__intro {
      bottom: 9%;
    }

    #UkiyoCinema-{{ section.id }}.uc--animated .uc__intro .uc__eyebrow {
      max-width: 260px;
      margin: 0 auto 22px;
    }

    #UkiyoCinema-{{ section.id }}.uc--animated .uc__about {
      bottom: 16%;
    }

    #UkiyoCinema-{{ section.id }}.uc--animated .uc__stat {
      bottom: 20%;
    }

    #UkiyoCinema-{{ section.id }} .uc__buttons {
      width: 100%;
    }

    #UkiyoCinema-{{ section.id }} .uc__button-block,
    #UkiyoCinema-{{ section.id }} .uc__button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #UkiyoCinema-{{ section.id }} *,
    #UkiyoCinema-{{ section.id }} *::before,
    #UkiyoCinema-{{ section.id }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>

<script>
(() => {
  const id = 'UkiyoCinema-{{ section.id }}';
  const wrapperId = 'shopify-section-{{ section.id }}';

  window.__ukiyoCinema = window.__ukiyoCinema || {};
  window.__ukiyoCinema[id]?.destroy();

  const lifecycle = new AbortController();
  let cleanup = () => {};

  function init() {
    cleanup();

    const root = document.getElementById(id);
    if (!root) return;

    const events = new AbortController();
    const signal = events.signal;
    const frame = root.querySelector('.uc__frame');
    const intro = root.querySelector('[data-scene="intro"]');
    const about = root.querySelector('[data-scene="about"]');
    const works = root.querySelector('[data-scene="works"]');
    const outro = root.querySelector('[data-scene="outro"]');
    const strip = root.querySelector('[data-works-inner]');
    const stats = [...root.querySelectorAll('[data-stat]')];
    const projects = [...root.querySelectorAll('[data-project]')];
    const layers = [...root.querySelectorAll('[data-layer]')];
    const videos = [...root.querySelectorAll('[data-video]')];
    const scenes = [intro, about, works, ...stats, outro];
    const progressBar = root.querySelector('[data-progress]');
    const modeButton = root.querySelector('[data-mode]');
    const exploreButton = root.querySelector('[data-explore]');
    const nextButton = root.querySelector('[data-next]');

    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const shortScreen = matchMedia('(max-height: 480px)');

    let enabled = false;
    let manualStatic = false;
    let destroyed = false;
    let raf = 0;
    let width = 1;
    let height = 1;
    let stripHeight = 1;
    let active = true;

    const clamp = value => Math.min(1, Math.max(0, value));
    const range = (value, start, end) =>
      clamp((value - start) / Math.max(.0001, end - start));

    const ease = value => value * value * (3 - 2 * value);

    function listen(target, name, handler, options = {}) {
      target.addEventListener(name, handler, { ...options, signal });
    }

    function visible(element, show) {
      if (!element) return;

      element.style.visibility = show ? 'visible' : 'hidden';
      element.inert = !show;

      if (show) {
        element.removeAttribute('aria-hidden');
      } else {
        element.setAttribute('aria-hidden', 'true');
      }
    }

    function scene(element, opacity, transform = 'none', blur = 0) {
      const show = opacity > .015;
      visible(element, show);
      element.style.opacity = opacity.toFixed(3);
      element.style.transform = transform;
      element.style.filter = blur > .1 ? `blur(${blur.toFixed(2)}px)` : 'none';
    }

    function nextSection() {
      let next = document.getElementById(wrapperId)?.nextElementSibling;

      while (next && (!next.getClientRects().length ||
        /^(SCRIPT|STYLE|LINK)$/.test(next.tagName))) {
        next = next.nextElementSibling;
      }

      return next;
    }

    function scrollToProgress(p) {
      const top = root.getBoundingClientRect().top + window.scrollY;
      const travel = Math.max(1, root.offsetHeight - frame.offsetHeight);

      window.scrollTo({
        top: top + travel * clamp(p),
        behavior: reduced.matches ? 'auto' : 'smooth'
      });
    }

    /*
      Seek only after the previous seek completes.
      Each video receives the newest scroll target.
    */
    const clips = videos.map(video => {
      const state = {
        video,
        index: Number(video.dataset.video),
        target: 0,
        loaded: false,
        failed: false,
        needed: false
      };

      video.muted = true;
      video.defaultMuted = true;

      function seek() {
        if (
          destroyed || !enabled || !active || !state.needed ||
          state.failed || video.seeking ||
          video.readyState < 1 ||
          !Number.isFinite(video.duration) ||
          video.duration <= 0
        ) return;

        const target = Math.min(
          Math.max(0, video.duration - .05),
          Math.max(.001, state.target)
        );

        if (Math.abs(video.currentTime - target) < .04) return;

        try {
          video.currentTime = target;
        } catch (_) {
          /* A later media event can retry when seeking is available. */
        }
      }

      state.seek = seek;

      listen(video, 'loadedmetadata', () => {
        video.pause();
        schedule();
      });

      listen(video, 'loadeddata', () => {
        seek();
        schedule();
      });

      listen(video, 'seeked', seek);
      listen(video, 'canplay', seek);
      listen(video, 'error', () => {
        state.failed = true;
        video.style.opacity = '0';
      });

      return state;
    });

    function loadClip(clip) {
      if (clip.loaded || clip.failed || !clip.video.dataset.src) return;

      clip.loaded = true;
      clip.video.src = clip.video.dataset.src;
      clip.video.load();
    }

    function measure() {
      if (destroyed) return;

      width = frame.clientWidth || window.innerWidth;
      height = frame.clientHeight || window.innerHeight;
      stripHeight = strip.offsetHeight;

      root.style.setProperty('--uc-width', `${width}px`);
      root.style.setProperty('--uc-height', `${height}px`);

      nextButton.hidden = !nextSection();
      schedule();
    }

    function wipe(layer, amount, angle, spanWidth, spanHeight) {
      const rotation = amount * angle;

      layer.style.visibility = amount > 0 ? 'visible' : 'hidden';
      layer.style.width = `${amount * spanWidth}px`;
      layer.style.height = `${spanHeight}px`;
      layer.style.transform =
        `translate(-50%, -50%) rotate(${rotation}deg)`;

      layer.querySelector('.uc__media-inner').style.transform =
        `translate(-50%, -50%) rotate(${-rotation}deg)`;
    }

    function render() {
      raf = 0;
      if (!enabled || destroyed || document.hidden) return;

      const rect = root.getBoundingClientRect();
      active = rect.bottom > 0 && rect.top < window.innerHeight;

      if (!active) return;

      const travel = Math.max(1, root.offsetHeight - height);
      const p = clamp(-rect.top / travel);

      progressBar.style.transform = `scaleX(${p})`;

      /* Opening title: projects toward the viewer as you scroll. */
      const titleExit = range(p, .01, .13);

      scene(
        intro,
        1 - titleExit * titleExit,
        `translate3d(0, ${titleExit * 55}px, ${titleExit * 680}px)`,
        titleExit * titleExit * 8
      );

      /* Studio introduction rises into view and then leaves. */
      const aboutIn = ease(range(p, .13, .20));
      const aboutOut = ease(range(p, .29, .35));
      const aboutOpacity = aboutIn * (1 - aboutOut);

      scene(
        about,
        aboutOpacity,
        `translateY(${(1 - aboutIn) * 65 - aboutOut * 25}px)`,
        (1 - aboutOpacity) * 4
      );

      /* Wipe A rotates while its video counter-rotates. */
      const a = range(p, .333, .433);
      const b = range(p, .69, .77);
      const diagonal = Math.hypot(width, height) * 1.03;

      wipe(layers[1], a, -45, diagonal, diagonal);
      wipe(layers[2], b, 0, width * 1.02, height * 1.02);

      layers[0].style.opacity = 1 - range(a, .90, 1);
      layers[0].style.visibility = a >= 1 ? 'hidden' : 'visible';

      if (b >= 1) layers[1].style.visibility = 'hidden';

      /*
        Work content travels through the viewport.
        Its measured height determines travel on mobile and desktop.
      */
      const worksIn = ease(range(p, .435, .475));
      const worksOut = ease(range(p, .70, .765));
      const workOpacity = worksIn * (1 - worksOut);

      scene(works, workOpacity);

      const stripStart = height * .36;
      const stripEnd = Math.min(0, height * .78 - stripHeight);
      const stripMove = range(p, .47, .665);
      const stripY = stripStart + (stripEnd - stripStart) * stripMove;

      strip.style.transform = `translate(-50%, ${stripY}px)`;

      projects.forEach((project, index) => {
        const rowPair = Math.floor(index / 2);
        const leave = ease(range(
          p,
          .668 + rowPair * .009,
          .715 + rowPair * .009
        ));

        const direction = index % 2 === 0 ? -1 : 1;

        project.style.transform =
          `translateX(${direction * leave * width * .65}px)`;

        project.style.opacity = 1 - leave;
      });

      /* Saved stat values appear one after another. */
      const statsStart = .775;
      const statsEnd = .935;
      const slot = (statsEnd - statsStart) / Math.max(1, stats.length);

      stats.forEach((stat, index) => {
        const local = (p - statsStart - index * slot) / slot;

        if (local <= 0 || local >= 1) {
          scene(stat, 0);
          return;
        }

        const arrival = ease(range(local, 0, .30));
        const departure = range(local, .72, 1);
        const opacity = arrival * (1 - departure * departure);

        scene(
          stat,
          opacity,
          `translate3d(0, ${(1 - arrival) * 70}px, ${departure * 464}px)`,
          (1 - arrival) * 4 + departure * departure * 6
        );
      });

      /* Final heading and editable CTA blocks. */
      const endIn = ease(range(p, stats.length ? .94 : .80, .985));

      scene(
        outro,
        endIn,
        `translateY(${(1 - endIn) * 55}px)`,
        (1 - endIn) * 5
      );

      /*
        One continuous source, with a small reserved lead per layer.
        No autoplay loop: scroll position controls the video timeline.
      */
      clips.forEach(clip => {
        const i = clip.index;

        clip.needed =
          i === 0 ? a < 1 :
          i === 1 ? a > 0 && b < 1 :
          b > 0;

        const preload =
          i === 0 ||
          (i === 1 && p > .27) ||
          (i === 2 && p > .63);

        if (preload) loadClip(clip);

        const duration = clip.video.duration;

        if (Number.isFinite(duration) && duration > 0) {
          const lead = Math.min(1, duration / 12);
          const usable = Math.max(0, duration - lead * 2 - .05);
          clip.target = p * usable + i * lead;
          clip.seek();
        }
      });
    }

    function schedule() {
      if (!raf && enabled && !destroyed) {
        raf = requestAnimationFrame(render);
      }
    }

    function resetContent() {
      scenes.forEach(element => {
        element.style.removeProperty('visibility');
        element.style.removeProperty('opacity');
        element.style.removeProperty('transform');
        element.style.removeProperty('filter');
        element.removeAttribute('aria-hidden');
        element.inert = false;
      });

      strip.style.removeProperty('transform');

      projects.forEach(project => {
        project.style.removeProperty('transform');
        project.style.removeProperty('opacity');
      });

      videos.forEach(video => video.pause());
    }

    function setMode(preservePosition = false) {
      const previous = enabled;
      const top = root.getBoundingClientRect().top + window.scrollY;

      enabled = !manualStatic && !reduced.matches && !shortScreen.matches;

      if (raf) cancelAnimationFrame(raf);
      raf = 0;

      root.classList.toggle('uc--animated', enabled);

      if (!enabled) resetContent();

      exploreButton.hidden = !enabled;
      modeButton.hidden = reduced.matches || shortScreen.matches;
      modeButton.textContent = enabled ? 'View all content' : 'Enable animation';
      modeButton.setAttribute('aria-pressed', String(!enabled));

      if (preservePosition && previous !== enabled) {
        window.scrollTo({ top, behavior: 'instant' });
      }

      measure();

      /* Avoid a flash of overlapping scenes before the next frame. */
      if (enabled) render();
    }

    listen(modeButton, 'click', () => {
      manualStatic = !manualStatic;
      setMode(true);
    });

    listen(exploreButton, 'click', () => {
      scrollToProgress(.20);
    });

    listen(nextButton, 'click', () => {
      nextSection()?.scrollIntoView({
        behavior: reduced.matches ? 'auto' : 'smooth',
        block: 'start'
      });
    });

    listen(window, 'scroll', schedule, { passive: true });
    listen(window, 'resize', measure, { passive: true });
    listen(window, 'orientationchange', measure);
    listen(window, 'pageshow', measure);
    listen(reduced, 'change', () => setMode(true));
    listen(shortScreen, 'change', () => setMode(true));

    listen(document, 'visibilitychange', () => {
      if (!document.hidden) schedule();
    });

    /*
      When a merchant selects a block in the theme editor,
      show all content so that block is immediately editable.
    */
    listen(document, 'shopify:block:select', event => {
      if (!root.contains(event.target)) return;

      manualStatic = true;
      setMode(false);

      requestAnimationFrame(() => {
        if (!destroyed) {
          event.target.scrollIntoView({
            behavior: 'auto',
            block: 'center'
          });
        }
      });
    });

    const observer = typeof ResizeObserver !== 'undefined'
      ? new ResizeObserver(measure)
      : null;

    observer?.observe(frame);
    observer?.observe(strip);

    document.fonts?.ready.then(() => {
      if (!destroyed) measure();
    });

    setMode();

    cleanup = () => {
      destroyed = true;
      events.abort();
      observer?.disconnect();

      if (raf) cancelAnimationFrame(raf);

      root.classList.remove('uc--animated');
      resetContent();

      videos.forEach(video => {
        video.pause();
        video.removeAttribute('src');
        video.load();
      });
    };
  }

  document.addEventListener('shopify:section:load', event => {
    if (event.target.id === wrapperId) init();
  }, { signal: lifecycle.signal });

  document.addEventListener('shopify:section:unload', event => {
    if (event.target.id === wrapperId) cleanup();
  }, { signal: lifecycle.signal });

  window.__ukiyoCinema[id] = {
    destroy() {
      cleanup();
      lifecycle.abort();
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, {
      once: true,
      signal: lifecycle.signal
    });
  } else {
    init();
  }
})();
</script>

