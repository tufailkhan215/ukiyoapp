{% comment %} Work page hero: canvas starfield background, strap, two-line gradient title, description, stats grid. {% endcomment %}
{% assign canvas_id = 'work-hero-canvas-' | append: section.id %}
<section class="relative min-h-screen flex items-center overflow-hidden bg-black" data-testid="work-hero">
  <canvas id="{{ canvas_id }}" class="absolute inset-0 w-full h-full" width="1920" height="1080" aria-hidden="true"></canvas>
  <div class="relative z-10 max-w-[1400px] mx-auto px-6 lg:px-12 pt-32 pb-20 w-full">
    <div class="text-center">
      {% if section.settings.strap != blank %}
        <span class="text-[10px] font-medium text-white/40 tracking-[0.3em] uppercase block mb-6">{{ section.settings.strap }}</span>
      {% endif %}
      {% if section.settings.title_line_1 != blank or section.settings.title_line_2 != blank %}
        <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black text-white leading-[0.9] tracking-tight mb-8">
          {% if section.settings.title_line_1 != blank %}
            <span class="block text-transparent bg-clip-text bg-gradient-to-b from-white via-gray-300 to-gray-600">{{ section.settings.title_line_1 }}</span>
          {% endif %}
          {% if section.settings.title_line_2 != blank %}
            <span class="block text-transparent bg-clip-text bg-gradient-to-b from-gray-200 via-gray-500 to-gray-800">{{ section.settings.title_line_2 }}</span>
          {% endif %}
        </h1>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="text-lg md:text-xl text-white/40 max-w-2xl mx-auto mb-12">{{ section.settings.description }}</p>
      {% endif %}

      {% assign stat_blocks = section.blocks | where: 'type', 'stat' %}
      {% if stat_blocks.size > 0 %}
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 max-w-3xl mx-auto">
          {% for block in stat_blocks %}
            <div class="text-center" {{ block.shopify_attributes }}>
              {% if block.settings.value != blank %}
                <div class="text-4xl md:text-5xl lg:text-6xl font-black text-white mb-2">{{ block.settings.value }}</div>
              {% endif %}
              {% if block.settings.label != blank %}
                <p class="text-white/40 text-sm uppercase tracking-wider">{{ block.settings.label }}</p>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<script>
(function() {
  var canvas = document.getElementById('{{ canvas_id }}');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var dots = [];
  var dotCount = 180;
  var frame = 0;

  function resize() {
    var w = canvas.offsetWidth;
    var h = canvas.offsetHeight;
    canvas.width = w;
    canvas.height = h;
    if (dots.length === 0) {
      for (var i = 0; i < dotCount; i++) {
        dots.push({
          x: Math.random() * w,
          y: Math.random() * h,
          r: 0.5 + Math.random() * 1.2,
          baseOpacity: 0.2 + Math.random() * 0.5,
          phase: Math.random() * Math.PI * 2
        });
      }
    } else {
      for (var i = 0; i < dots.length; i++) {
        if (dots[i].x > w || dots[i].y > h) {
          dots[i].x = Math.random() * w;
          dots[i].y = Math.random() * h;
        }
      }
    }
    draw();
  }

  function draw() {
    var w = canvas.width;
    var h = canvas.height;
    if (!w || !h) return;
    ctx.fillStyle = '#000000';
    ctx.fillRect(0, 0, w, h);
    frame++;
    for (var i = 0; i < dots.length; i++) {
      var d = dots[i];
      var twinkle = 0.7 + 0.3 * Math.sin(frame * 0.02 + d.phase);
      var opacity = d.baseOpacity * twinkle;
      ctx.beginPath();
      ctx.arc(d.x, d.y, d.r, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(255,255,255,' + opacity + ')';
      ctx.fill();
    }
  }

  function loop() {
    draw();
    requestAnimationFrame(loop);
  }

  if (typeof ResizeObserver !== 'undefined') {
    var ro = new ResizeObserver(function() { resize(); });
    ro.observe(canvas.parentElement);
  }
  resize();
  loop();
})();
</script>

{% schema %}
{
  "name": "Work Hero",
  "tag": "section",
  "class": "section-work-hero",
  "settings": [
    {
      "type": "text",
      "id": "strap",
      "label": "Strap (small label above title)",
      "default": "(Our Work)"
    },
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Title line 1",
      "default": "ACTIVATIONS &"
    },
    {
      "type": "text",
      "id": "title_line_2",
      "label": "Title line 2",
      "default": "CASE STUDIES"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover our diverse projects and activations tailored to meet your needs. We're committed to delivering innovative solutions that drive success."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value (e.g. 150+)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label (e.g. Projects Delivered)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Work Hero",
      "settings": {
        "strap": "(Our Work)",
        "title_line_1": "ACTIVATIONS &",
        "title_line_2": "CASE STUDIES",
        "description": "Discover our diverse projects and activations tailored to meet your needs. We're committed to delivering innovative solutions that drive success."
      },
      "blocks": [
        { "type": "stat", "settings": { "value": "150+", "label": "Projects Delivered" } },
        { "type": "stat", "settings": { "value": "$50M+", "label": "Revenue Generated" } },
        { "type": "stat", "settings": { "value": "98%", "label": "Client Satisfaction" } },
        { "type": "stat", "settings": { "value": "40+", "label": "Brand Partners" } }
      ]
    }
  ]
}
{% endschema %}
