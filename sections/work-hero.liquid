<script>
(function () {
  const rootId = 'UkiyoWork-{{ section.id }}';
  const wrapperId = 'shopify-section-{{ section.id }}';

  window.__ukiyoWorkControllers = window.__ukiyoWorkControllers || {};

  if (window.__ukiyoWorkControllers[rootId]) {
    window.__ukiyoWorkControllers[rootId]();
  }

  const lifecycle = new AbortController();
  let cleanup = null;

  function loadHls() {
    if (window.Hls) return Promise.resolve(window.Hls);

    if (!window.__ukiyoHlsPromise) {
      window.__ukiyoHlsPromise = new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/hls.js@1/dist/hls.min.js';
        script.async = true;

        script.onload = () => {
          if (window.Hls) resolve(window.Hls);
          else reject(new Error('HLS player unavailable'));
        };

        script.onerror = () => reject(new Error('HLS player failed to load'));
        document.head.appendChild(script);
      }).catch(error => {
        window.__ukiyoHlsPromise = null;
        throw error;
      });
    }

    return window.__ukiyoHlsPromise;
  }

  function init() {
    const root = document.getElementById(rootId);
    if (!root) return;
    if (cleanup) cleanup();

    const events = new AbortController();
    const signal = events.signal;

    const video = root.querySelector('[data-uw-video]');
    const left = root.querySelector('.uw__left');
    const cutout = root.querySelector('[data-uw-cutout]');
    const glass = root.querySelector('.uw__glass');
    const motionButton = root.querySelector('[data-uw-motion]');
    const dialog = root.querySelector('[data-uw-dialog]');
    const menuButton = root.querySelector('[data-uw-open]');

    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const animations = new Set();
    const revealed = new Set();

    let hls = null;
    let destroyed = false;
    let paused = false;
    let blocked = false;
    let failed = false;
    let visible = true;
    let loading = false;
    let attached = false;
    let playingRequest = false;
    let resizeFrame = null;
    let menuAnimation = null;

    function animate(element, delay) {
      if (
        paused ||
        reduced.matches ||
        !element.animate ||
        revealed.has(element)
      ) return;

      revealed.add(element);

      const animation = element.animate(
        [
          { opacity: 0, translate: '0 20px' },
          { opacity: 1, translate: '0 0' }
        ],
        {
          duration: 850,
          delay,
          fill: 'backwards',
          easing: 'cubic-bezier(.16,1,.3,1)'
        }
      );

      animations.add(animation);
      animation.finished
        .then(() => animations.delete(animation))
        .catch(() => animations.delete(animation));
    }

    /*
      Build a transparent-letter mask from the actual
      wordmark position. White keeps the blur; black
      removes it to reveal the sharp video underneath.
    */
    function updateMask() {
      resizeFrame = null;
      if (destroyed || !left || !cutout || !glass) return;

      const supportsMask =
        CSS.supports('mask-image', 'linear-gradient(white, white)') ||
        CSS.supports('-webkit-mask-image', 'linear-gradient(white, white)');

      const supportsBlur =
        CSS.supports('backdrop-filter', 'blur(20px)') ||
        CSS.supports('-webkit-backdrop-filter', 'blur(20px)');

      if (!supportsMask || !supportsBlur) return;

      const panelBounds = left.getBoundingClientRect();
      const wordBounds = cutout.getBoundingClientRect();

      if (!panelBounds.width || !panelBounds.height) return;

      const namespace = 'http://www.w3.org/2000/svg';
      const svg = document.createElementNS(namespace, 'svg');

      svg.setAttribute('xmlns', namespace);
      svg.setAttribute('width', panelBounds.width);
      svg.setAttribute('height', panelBounds.height);
      svg.setAttribute(
        'viewBox',
        `0 0 ${panelBounds.width} ${panelBounds.height}`
      );

      const defs = document.createElementNS(namespace, 'defs');
      const mask = document.createElementNS(namespace, 'mask');

      mask.setAttribute('id', 'cut');
      mask.setAttribute('maskUnits', 'userSpaceOnUse');
      mask.setAttribute('x', '0');
      mask.setAttribute('y', '0');
      mask.setAttribute('width', panelBounds.width);
      mask.setAttribute('height', panelBounds.height);
      mask.setAttribute('style', 'mask-type:luminance');

      const base = document.createElementNS(namespace, 'rect');
      base.setAttribute('width', '100%');
      base.setAttribute('height', '100%');
      base.setAttribute('fill', 'white');

      const wordSvg = cutout.querySelector('svg').cloneNode(true);
      wordSvg.removeAttribute('class');
      wordSvg.setAttribute('x', wordBounds.left - panelBounds.left);
      wordSvg.setAttribute('y', wordBounds.top - panelBounds.top);
      wordSvg.setAttribute('width', wordBounds.width);
      wordSvg.setAttribute('height', wordBounds.height);
      wordSvg.querySelector('text').setAttribute('fill', 'black');

      mask.append(base, wordSvg);
      defs.appendChild(mask);

      const surface = document.createElementNS(namespace, 'rect');
      surface.setAttribute('width', '100%');
      surface.setAttribute('height', '100%');
      surface.setAttribute('fill', 'white');
      surface.setAttribute('mask', 'url(#cut)');

      svg.append(defs, surface);

      const markup = new XMLSerializer().serializeToString(svg);
      const image = `url("data:image/svg+xml,${encodeURIComponent(markup)}")`;

      glass.style.maskImage = image;
      glass.style.webkitMaskImage = image;
      root.setAttribute('data-mask-ready', '');
    }

    function scheduleMask() {
      if (resizeFrame !== null || destroyed) return;
      resizeFrame = requestAnimationFrame(updateMask);
    }

    function updateMotionButton() {
      if (!motionButton) return;

      motionButton.hidden = !video || reduced.matches;
      motionButton.setAttribute('aria-pressed', String(paused));
      motionButton.textContent = failed
        ? 'Retry video'
        : blocked || paused
          ? 'Play motion'
          : 'Pause motion';
    }

    function shouldPlay() {
      return (
        !destroyed &&
        !paused &&
        !reduced.matches &&
        visible &&
        !document.hidden &&
        !(dialog && dialog.open)
      );
    }

    function playVideo() {
      if (!video || !attached) return;

      if (!shouldPlay()) {
        video.pause();
        return;
      }

      if (!video.paused || playingRequest || blocked || failed) return;

      video.muted = true;
      video.defaultMuted = true;
      video.playbackRate = .7;
      playingRequest = true;

      const promise = video.play();

      if (promise && promise.then) {
        promise.then(() => {
          playingRequest = false;
          if (destroyed) return;
          blocked = false;
          if (!shouldPlay()) video.pause();
          updateMotionButton();
        }).catch(error => {
          playingRequest = false;
          if (destroyed || !shouldPlay()) return;

          if (error.name === 'NotAllowedError') blocked = true;
          if (error.name === 'NotSupportedError') failed = true;
          updateMotionButton();
        });
      } else {
        playingRequest = false;
      }
    }

    async function attachVideo() {
      if (
        !video ||
        loading ||
        attached ||
        destroyed ||
        reduced.matches
      ) return;

      const source = video.dataset.source;
      if (!source) return;

      loading = true;

      try {
        video.muted = true;
        video.defaultMuted = true;
        video.playsInline = true;
        video.loop = true;

        const isHls = /\.m3u8(?:$|\?)/i.test(source);

        if (!isHls || video.canPlayType('application/vnd.apple.mpegurl')) {
          video.src = source;
          attached = true;
          video.load();
        } else {
          const Hls = await loadHls();
          if (destroyed) return;
          if (!Hls.isSupported()) throw new Error('HLS unsupported');

          hls = new Hls({
            capLevelToPlayerSize: true,
            maxBufferLength: 20
          });

          hls.on(Hls.Events.MANIFEST_PARSED, () => {
            if (!destroyed) playVideo();
          });

          hls.on(Hls.Events.ERROR, (event, data) => {
            if (data.fatal && !destroyed) {
              failed = true;
              video.pause();
              updateMotionButton();
            }
          });

          attached = true;
          hls.loadSource(source);
          hls.attachMedia(video);
        }

        failed = false;
      } catch (error) {
        failed = true;
      } finally {
        loading = false;
        if (!destroyed) updateMotionButton();
      }
    }

    function syncVideo() {
      if (!video) return;

      if (shouldPlay() && !attached && !failed) {
        attachVideo();
      } else {
        playVideo();
      }
    }

    motionButton?.addEventListener('click', () => {
      if (failed) {
        hls?.destroy();
        hls = null;
        attached = false;
        failed = false;
        blocked = false;
        paused = false;
        video?.removeAttribute('src');
      } else if (blocked) {
        blocked = false;
        paused = false;
      } else {
        paused = !paused;
      }

      if (paused) {
        animations.forEach(animation => animation.cancel());
        animations.clear();
      }

      updateMotionButton();
      syncVideo();
    }, { signal });

    video?.addEventListener('loadedmetadata', playVideo, { signal });
    video?.addEventListener('canplay', playVideo, { signal });
    video?.addEventListener('error', () => {
      if (destroyed) return;
      failed = true;
      updateMotionButton();
    }, { signal });

    reduced.addEventListener('change', () => {
      if (reduced.matches) {
        animations.forEach(animation => animation.cancel());
        animations.clear();
      }
      updateMotionButton();
      syncVideo();
    }, { signal });

    document.addEventListener('visibilitychange', syncVideo, { signal });

    let viewObserver = null;
    let revealObserver = null;

    if ('IntersectionObserver' in window) {
      viewObserver = new IntersectionObserver(entries => {
        visible = entries[0].isIntersecting;
        syncVideo();
      });
      viewObserver.observe(root);

      revealObserver = new IntersectionObserver(entries => {
        let index = 0;

        entries.forEach(entry => {
          if (entry.isIntersecting) {
            animate(entry.target, index++ * 80);
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: .1 });

      root.querySelectorAll('[data-uw-reveal]').forEach(element => {
        revealObserver.observe(element);
      });
    }

    /*
      Native dialog supplies focus containment and Escape
      handling without replacing Shopify's main navigation.
    */
    if (dialog && typeof dialog.showModal === 'function') {
      if (menuButton) menuButton.hidden = false;

      menuButton?.addEventListener('click', () => {
        dialog.showModal();
        syncVideo();

        if (!reduced.matches && dialog.animate) {
          menuAnimation = dialog.animate(
            [
              { opacity: 0, transform: 'translateX(30px)' },
              { opacity: 1, transform: 'translateX(0)' }
            ],
            {
              duration: 350,
              easing: 'cubic-bezier(.16,1,.3,1)'
            }
          );
        }
      }, { signal });

      root.querySelector('[data-uw-close]')?.addEventListener(
        'click',
        () => dialog.close(),
        { signal }
      );

      dialog.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => dialog.close(), { signal });
      });

      dialog.addEventListener('close', syncVideo, { signal });
    }

    function nextSection() {
      const wrapper = document.getElementById(wrapperId);
      let next = wrapper?.nextElementSibling;

      while (next && (
        ['SCRIPT', 'STYLE'].includes(next.tagName) ||
        next.getClientRects().length === 0
      )) {
        next = next.nextElementSibling;
      }

      return next;
    }

    const explore = root.querySelector('[data-uw-explore]');

    if (explore && nextSection()) {
      explore.hidden = false;

      explore.addEventListener('click', () => {
        nextSection()?.scrollIntoView({
          behavior: reduced.matches ? 'auto' : 'smooth',
          block: 'start'
        });
      }, { signal });
    }

    let resizeObserver = null;

    if ('ResizeObserver' in window) {
      resizeObserver = new ResizeObserver(scheduleMask);
      resizeObserver.observe(left);
      resizeObserver.observe(cutout);
    }

    window.addEventListener('resize', () => {
      scheduleMask();
      if (innerWidth >= 1024 && dialog?.open) dialog.close();
    }, { signal });

    document.fonts?.ready.then(() => {
      if (!destroyed) scheduleMask();
    });

    scheduleMask();
    updateMotionButton();
    syncVideo();

    cleanup = function () {
      destroyed = true;
      events.abort();
      viewObserver?.disconnect();
      revealObserver?.disconnect();
      resizeObserver?.disconnect();

      if (resizeFrame !== null) cancelAnimationFrame(resizeFrame);

      animations.forEach(animation => animation.cancel());
      menuAnimation?.cancel();
      if (dialog?.open) dialog.close();

      video?.pause();
      hls?.destroy();

      if (video) {
        video.removeAttribute('src');
        video.load();
      }
    };
  }

  document.addEventListener('shopify:section:load', event => {
    if (event.target.id === wrapperId) init();
  }, { signal: lifecycle.signal });

  document.addEventListener('shopify:section:unload', event => {
    if (event.target.id === wrapperId) {
      cleanup?.();
      cleanup = null;
    }
  }, { signal: lifecycle.signal });

  window.__ukiyoWorkControllers[rootId] = function () {
    lifecycle.abort();
    cleanup?.();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, {
      once: true,
      signal: lifecycle.signal
    });
  } else {
    init();
  }
})();
</script>

