{% comment %}
  UKIYO — Split Work Hero
  Frosted glass cutout, mirrored HLS/MP4 video, responsive panels.
  Preserves existing headings, description, and stat blocks.
{% endcomment %}

{% assign stats = section.blocks | where: 'type', 'stat' %}
{% assign buttons = section.blocks | where: 'type', 'button' %}

{% capture arrow %}
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M7 17 17 7M7 7h10v10"/>
  </svg>
{% endcapture %}

<div
  id="UkiyoWork-{{ section.id }}"
  class="uw"
  data-testid="work-hero"
  style="
    --uw-accent: {{ section.settings.accent | default: '#ff5c35' }};
    --uw-mirror: {% if section.settings.mirror_video %}-1{% else %}1{% endif %};
  "
>
  <div class="uw__background" aria-hidden="true">
    {% if section.settings.poster != blank %}
      {{
        section.settings.poster
        | image_url: width: 2400
        | image_tag:
          class: 'uw__poster',
          widths: '750, 1100, 1600, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: ''
      }}
    {% endif %}

    {% if section.settings.video_url != blank %}
      <video
        class="uw__video"
        data-uw-video
        data-source="{{ section.settings.video_url | escape }}"
        muted
        loop
        playsinline
        preload="metadata"
        tabindex="-1"
        {% if section.settings.poster != blank %}
          poster="{{ section.settings.poster | image_url: width: 2400 }}"
        {% endif %}
      ></video>
    {% endif %}

    <div class="uw__video-shade"></div>
  </div>

  <header class="uw__header">
    <a class="uw__logo" href="{{ routes.root_url }}">
      <span class="uw__logo-icon" aria-hidden="true">
        <i></i><i></i><i></i><i></i>
      </span>
      <span>UKIYO<span class="uw__logo-small">.studio</span></span>
    </a>

    {% if section.settings.menu != blank %}
      <nav class="uw__desktop-nav" aria-label="Work page navigation">
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url | escape }}">
            <span aria-hidden="true"></span>
            {{ link.title | escape }}
          </a>
        {% endfor %}
      </nav>
    {% endif %}

    <div class="uw__header-actions">
      {% if section.settings.contact_label != blank and section.settings.contact_link != blank %}
        <a
          class="uw__contact"
          href="{{ section.settings.contact_link | escape }}"
        >
          {{ section.settings.contact_label | escape }}
          {{ arrow }}
        </a>
      {% endif %}

      {% if section.settings.menu != blank %}
        <button
          class="uw__menu-toggle"
          type="button"
          aria-label="Open navigation"
          aria-haspopup="dialog"
          aria-controls="UW-Menu-{{ section.id }}"
          data-uw-open
          hidden
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 8h16M4 16h16"/>
          </svg>
        </button>
      {% endif %}
    </div>
  </header>

  <div class="uw__panels">
    <section
      class="uw__left"
      aria-labelledby="UW-Title-{{ section.id }}"
    >
      <div class="uw__glass" aria-hidden="true"></div>
      <div class="uw__left-shade" aria-hidden="true"></div>

      <div class="uw__left-inner">
        <div class="uw__cutout" data-uw-cutout aria-hidden="true">
          <svg
            viewBox="0 0 1000 240"
            preserveAspectRatio="none"
            class="uw__cutout-fallback"
          >
            <text
              x="0"
              y="200"
              textLength="1000"
              lengthAdjust="spacingAndGlyphs"
              font-family="Arial, Helvetica, sans-serif"
              font-weight="900"
              font-size="240"
              fill="white"
            >{{ section.settings.left_word | default: 'UKIYO' | escape }}</text>
          </svg>
        </div>

        <div class="uw__rule" aria-hidden="true">
          <span></span>
        </div>

        <div class="uw__copy" data-uw-reveal>
          {% if section.settings.strap != blank %}
            <span class="uw__eyebrow">
              {{ section.settings.strap | escape }}
            </span>
          {% endif %}

          <h1 id="UW-Title-{{ section.id }}" class="uw__title">
            {% if section.settings.title_line_1 != blank %}
              <span>{{ section.settings.title_line_1 | escape }}</span>
            {% endif %}
            {% if section.settings.title_line_2 != blank %}
              <span>{{ section.settings.title_line_2 | escape }}</span>
            {% endif %}
          </h1>

          {% if section.settings.description != blank %}
            <p class="uw__description">
              {{ section.settings.description | escape }}
            </p>
          {% endif %}
        </div>

        {% if stats.size > 0 %}
          <div class="uw__stats">
            {% for block in stats %}
              <div
                class="uw__stat"
                data-uw-reveal
                {{ block.shopify_attributes }}
              >
                {% if block.settings.value != blank %}
                  <strong>{{ block.settings.value | escape }}</strong>
                {% endif %}
                {% if block.settings.label != blank %}
                  <span>{{ block.settings.label | escape }}</span>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}

        <div class="uw__footer">
          <div class="uw__buttons">
            {% for block in buttons %}
              {% if block.settings.label != blank and block.settings.link != blank %}
                <a
                  class="uw__button"
                  href="{{ block.settings.link | escape }}"
                  {{ block.shopify_attributes }}
                >
                  <span>{{ block.settings.label | escape }}</span>
                  {{ arrow }}
                </a>
              {% endif %}
            {% endfor %}

            {% if section.settings.show_explore %}
              <button
                class="uw__button"
                type="button"
                data-uw-explore
                hidden
              >
                <span>
                  {{ section.settings.explore_label | default: 'Explore our work' | escape }}
                </span>
                {{ arrow }}
              </button>
            {% endif %}
          </div>

          <div class="uw__socials">
            {% if section.settings.instagram_url != blank %}
              <a href="{{ section.settings.instagram_url | escape }}">
                <span aria-hidden="true"></span>Instagram
              </a>
            {% endif %}
            {% if section.settings.linkedin_url != blank %}
              <a href="{{ section.settings.linkedin_url | escape }}">
                <span aria-hidden="true"></span>LinkedIn
              </a>
            {% endif %}
          </div>

          {% if section.settings.footer_note != blank %}
            <p class="uw__footer-note">
              {{ section.settings.footer_note | escape | newline_to_br }}
            </p>
          {% endif %}
        </div>
      </div>
    </section>

    <div class="uw__right">
      <div class="uw__circles" aria-hidden="true">
        <span></span>
        <span></span>
      </div>

      <div class="uw__right-top">
        {% if section.settings.right_caption != blank %}
          <span>{{ section.settings.right_caption | escape }}</span>
        {% endif %}

        <button
          class="uw__motion"
          type="button"
          aria-pressed="false"
          data-uw-motion
          hidden
        >
          Pause motion
        </button>
      </div>

      <div class="uw__right-word" aria-hidden="true" data-uw-reveal>
        <svg viewBox="0 0 1000 250" preserveAspectRatio="none">
          <text
            x="0"
            y="220"
            textLength="1000"
            lengthAdjust="spacingAndGlyphs"
            font-family="Arial, Helvetica, sans-serif"
            font-weight="900"
            font-size="250"
            fill="white"
          >{{ section.settings.right_word | default: 'WORK' | escape }}</text>
        </svg>
      </div>
    </div>
  </div>

  {% if section.settings.menu != blank %}
    <dialog
      id="UW-Menu-{{ section.id }}"
      class="uw__menu"
      aria-label="Navigation"
      data-uw-dialog
    >
      <div class="uw__menu-head">
        <span class="uw__menu-brand">UKIYO.studio</span>
        <button
          class="uw__menu-close"
          type="button"
          aria-label="Close navigation"
          data-uw-close
          autofocus
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m6 6 12 12M18 6 6 18"/>
          </svg>
        </button>
      </div>

      <nav class="uw__menu-links" aria-label="Mobile navigation">
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url | escape }}">
            {{ link.title | escape }}
          </a>
        {% endfor %}

        {% if section.settings.contact_label != blank and section.settings.contact_link != blank %}
          <a href="{{ section.settings.contact_link | escape }}">
            {{ section.settings.contact_label | escape }}
          </a>
        {% endif %}
      </nav>

      <p class="uw__menu-note">
        {{ section.settings.footer_note | escape }}
      </p>
    </dialog>
  {% endif %}
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

  .uw {
    --uw-pad: clamp(24px, 3vw, 48px);
    position: relative;
    isolation: isolate;
    background: #080808;
    color: #fff;
    font-family: "Inter", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .uw *,
  .uw *::before,
  .uw *::after {
    box-sizing: border-box;
  }

  .uw .uw__background {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 70% 20%, #784b35, #24201e 45%, #080808);
  }

  .uw .uw__poster,
  .uw .uw__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scaleX(var(--uw-mirror));
  }

  .uw .uw__video-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #0003, transparent 40%, #0005);
  }

  .uw .uw__header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px 30px;
    padding: 24px var(--uw-pad);
  }

  .uw .uw__logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #fff;
    text-decoration: none;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -.055em;
    white-space: nowrap;
  }

  .uw .uw__logo-small {
    font-size: 17px;
    font-weight: 500;
  }

  .uw .uw__logo-icon {
    display: grid;
    grid-template-columns: repeat(2, 8px);
    gap: 3px;
  }

  .uw .uw__logo-icon i {
    width: 8px;
    height: 8px;
    background: var(--uw-accent);
  }

  .uw .uw__desktop-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 24px;
    max-width: 48%;
  }

  .uw .uw__desktop-nav a,
  .uw .uw__socials a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 36px;
    color: #ffffffc7;
    font-size: 10px;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: .1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color .25s;
  }

  .uw .uw__desktop-nav a > span,
  .uw .uw__socials a > span {
    width: 4px;
    height: 4px;
    flex-shrink: 0;
    border-radius: 50%;
    background: currentColor;
    opacity: .6;
  }

  .uw .uw__header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .uw .uw__contact {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 44px;
    padding: 11px 20px;
    border: 1px solid #ffffff50;
    border-radius: 999px;
    background: #ffffff0d;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #fff;
    font-size: 10px;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: .08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background .25s, color .25s;
  }

  .uw svg:not(.uw__cutout-fallback) {
    display: block;
  }

  .uw .uw__contact svg,
  .uw .uw__button svg,
  .uw .uw__menu-toggle svg,
  .uw .uw__menu-close svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .uw .uw__menu-toggle,
  .uw .uw__menu-close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 10px;
    border: 0;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }

  .uw .uw__menu-toggle,
  .uw .uw__menu-toggle[hidden] {
    display: none;
  }

  .uw .uw__panels {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    min-height: 840px;
    min-height: max(840px, 100svh);
  }

  .uw .uw__left {
    position: relative;
    min-width: 0;
    border-right: 1px solid #ffffff20;
    isolation: isolate;
  }

  .uw .uw__glass {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: rgba(131, 131, 131, .3);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }

  .uw .uw__left-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 22%, #0003 45%, #0008);
  }

  .uw .uw__left-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 120px var(--uw-pad) 34px;
  }

  .uw .uw__cutout {
    position: relative;
    width: 100%;
    aspect-ratio: 1000 / 240;
    flex-shrink: 0;
    pointer-events: none;
  }

  .uw .uw__cutout-fallback {
    display: block;
    width: 100%;
    height: 100%;
  }

  .uw[data-mask-ready] .uw__cutout-fallback {
    opacity: 0;
  }

  .uw .uw__rule {
    display: flex;
    flex: 1;
    min-height: 75px;
    padding-block: 18px;
  }

  .uw .uw__rule > span {
    display: block;
    width: 1px;
    min-height: 50px;
    background: #ffffff40;
  }

  .uw .uw__eyebrow {
    display: block;
    margin-bottom: 18px;
    color: #e1dfdc;
    font-size: 9px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: .22em;
    text-transform: uppercase;
  }

  .uw .uw__title {
    margin: 0 0 18px;
    color: #fff;
    font-family: inherit;
    font-size: clamp(25px, 2.8vw, 42px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -.045em;
    text-transform: none;
    overflow-wrap: break-word;
  }

  .uw .uw__title > span {
    display: block;
  }

  .uw .uw__description {
    max-width: 580px;
    margin: 0;
    color: #f2efeb;
    font-size: clamp(14px, 1.25vw, 18px);
    font-weight: 400;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .uw .uw__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
    margin-top: 30px;
    padding-top: 24px;
    border-top: 1px solid #ffffff30;
  }

  .uw .uw__stat {
    min-width: 0;
  }

  .uw .uw__stat strong {
    display: block;
    color: #fff;
    font-size: clamp(24px, 2.4vw, 34px);
    font-weight: 600;
    letter-spacing: -.04em;
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .uw .uw__stat > span {
    display: block;
    margin-top: 7px;
    color: #e0ddd8;
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .uw .uw__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 22px;
    margin-top: 30px;
    padding-top: 22px;
    border-top: 1px solid #ffffff30;
  }

  .uw .uw__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
  }

  .uw .uw__button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    min-height: 44px;
    max-width: 100%;
    padding: 9px 0;
    border: 0;
    border-bottom: 1px solid #ffffff60;
    background: transparent;
    color: #fff;
    font-family: inherit;
    font-size: 10px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: .06em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
  }

  .uw .uw__button[hidden] {
    display: none;
  }

  .uw .uw__button svg {
    transition: transform .3s;
  }

  .uw .uw__socials {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .uw .uw__footer-note {
    max-width: 170px;
    margin: 0;
    color: #d9d4ce;
    font-size: 9px;
    line-height: 1.7;
    letter-spacing: .03em;
  }

  .uw .uw__right {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
    min-height: 100%;
    padding: 122px var(--uw-pad) 12px;
    overflow: hidden;
  }

  .uw .uw__circles {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .uw .uw__circles > span {
    position: absolute;
    left: 50%;
    width: min(60vh, 95%);
    aspect-ratio: 1;
    border: 1px solid #ffffff50;
    border-radius: 50%;
    transform: translateX(-50%);
  }

  .uw .uw__circles > span:first-child {
    top: -15vh;
  }

  .uw .uw__circles > span:last-child {
    top: 28vh;
  }

  .uw .uw__right-top {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    color: #ffffffdf;
    font-size: 9px;
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .uw .uw__motion {
    min-height: 44px;
    margin-left: auto;
    padding: 10px 0;
    border: 0;
    background: transparent;
    color: #fff;
    font: inherit;
    cursor: pointer;
  }

  .uw .uw__motion[hidden] {
    display: none;
  }

  .uw .uw__right-word {
    position: relative;
    z-index: 1;
    width: 100%;
    margin-top: 100px;
    aspect-ratio: 1000 / 250;
  }

  .uw .uw__right-word svg {
    width: 100%;
    height: 100%;
  }

  .uw .uw__menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 24px;
    border: 0;
    background: #080808;
    color: #fff;
    overflow-y: auto;
  }

  .uw .uw__menu[open] {
    display: flex;
    flex-direction: column;
  }

  .uw .uw__menu::backdrop {
    background: #000b;
  }

  .uw .uw__menu-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .uw .uw__menu-brand {
    font-size: 23px;
    font-weight: 800;
    letter-spacing: -.05em;
  }

  .uw .uw__menu-links {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 24px;
    padding: 54px 0;
  }

  .uw .uw__menu-links a {
    color: #fff;
    font-size: clamp(28px, 8vw, 46px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -.045em;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .uw .uw__menu-note {
    margin: 0;
    padding-top: 24px;
    border-top: 1px solid #ffffff25;
    color: #c9c9c9;
    font-size: 11px;
    line-height: 1.6;
  }

  .uw a:focus-visible,
  .uw button:focus-visible {
    outline: 2px solid var(--uw-accent);
    outline-offset: 5px;
  }

  @media (hover: hover) and (pointer: fine) {
    .uw .uw__desktop-nav a:hover,
    .uw .uw__socials a:hover {
      color: #fff;
    }

    .uw .uw__contact:hover {
      background: #fff;
      color: #111;
    }

    .uw .uw__button:hover svg {
      transform: translate(3px, -3px);
    }

    .uw .uw__menu-links a:hover {
      color: var(--uw-accent);
    }
  }

  @media (max-width: 1023px) {
    .uw .uw__desktop-nav {
      display: none;
    }

    .uw .uw__menu-toggle:not([hidden]) {
      display: grid;
    }

    .uw .uw__panels {
      grid-template-columns: minmax(0, 1fr);
      min-height: auto;
    }

    .uw .uw__left {
      border-right: 0;
      border-bottom: 1px solid #ffffff30;
    }

    .uw .uw__left-inner {
      min-height: 90svh;
      padding-top: 110px;
    }

    .uw .uw__cutout {
      max-width: 760px;
    }

    .uw .uw__title {
      font-size: clamp(30px, 5.5vw, 48px);
    }

    .uw .uw__description {
      max-width: 650px;
      font-size: 16px;
    }

    .uw .uw__stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .uw .uw__right {
      min-height: 50svh;
      padding-top: 24px;
      padding-bottom: 20px;
    }

    .uw .uw__circles > span {
      width: min(48vh, 85%);
    }

    .uw .uw__circles > span:first-child {
      top: -20vh;
    }

    .uw .uw__circles > span:last-child {
      top: 12vh;
    }
  }

  @media (max-width: 600px) {
    .uw {
      --uw-pad: 22px;
    }

    .uw .uw__header {
      padding-block: 20px;
      gap: 12px;
    }

    .uw .uw__logo {
      font-size: 20px;
    }

