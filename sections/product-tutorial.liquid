{% comment %}
  Section: About This Product — Tutorial Video + Chapters
  File: sections/product-tutorial.liquid
{% endcomment %}

{%- assign accent = section.settings.accent_color | default: '#4DEBFF' -%}
{%- assign layout = section.settings.layout | default: 'video-left' -%}

<style>
  #pt-{{ section.id }} {
    --pt-accent:    {{ accent }};
    --pt-bg:        #070707;
    --pt-surface:   #0e0e0e;
    --pt-surface2:  #141414;
    --pt-border:    rgba(255,255,255,0.08);
    --pt-text:      #F5F5F5;
    --pt-muted:     rgba(245,245,245,0.55);
    --pt-radius:    18px;
    background: var(--pt-bg);
    color: var(--pt-text);
    font-family: inherit;
    position: relative;
    overflow: hidden;
  }

  /* Grid BG */
  #pt-{{ section.id }} .pt-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 44px 44px;
    pointer-events: none;
    z-index: 0;
  }

  /* Glow orb */
  #pt-{{ section.id }} .pt-glow {
    position: absolute;
    width: 600px; height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(77,235,255,0.05) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
    top: -100px; left: -100px;
  }

  #pt-{{ section.id }} .pt-wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
    position: relative;
    z-index: 1;
  }

  /* ── Section Header ──────────────────────── */
  #pt-{{ section.id }} .pt-section-header {
    margin-bottom: 3.5rem;
    max-width: 52rem;
  }

  #pt-{{ section.id }} .pt-eyebrow {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--pt-accent);
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  #pt-{{ section.id }} .pt-eyebrow::before {
    content: '';
    display: inline-block;
    width: 24px; height: 1px;
    background: var(--pt-accent);
  }

  #pt-{{ section.id }} .pt-heading {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.08;
    margin: 0 0 1rem;
  }

  #pt-{{ section.id }} .pt-subheading {
    font-size: 1.05rem;
    color: var(--pt-muted);
    line-height: 1.7;
    max-width: 44rem;
    margin: 0;
  }

  /* ── Main Layout ─────────────────────────── */
  #pt-{{ section.id }} .pt-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    #pt-{{ section.id }} .pt-layout.layout--video-left {
      grid-template-columns: 1fr 380px;
    }
    #pt-{{ section.id }} .pt-layout.layout--video-right {
      grid-template-columns: 380px 1fr;
    }
    #pt-{{ section.id }} .pt-layout.layout--video-right .pt-video-col {
      order: 2;
    }
    #pt-{{ section.id }} .pt-layout.layout--video-right .pt-sidebar {
      order: 1;
    }
    #pt-{{ section.id }} .pt-layout.layout--stacked {
      grid-template-columns: 1fr;
      max-width: 860px;
      margin: 0 auto;
    }
    #pt-{{ section.id }} .pt-layout.layout--wide {
      grid-template-columns: 1fr 320px;
    }
  }

  /* ── Video Column ────────────────────────── */
  #pt-{{ section.id }} .pt-video-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* ── Video Player ────────────────────────── */
  #pt-{{ section.id }} .pt-player-wrap {
    position: relative;
    border-radius: var(--pt-radius);
    overflow: hidden;
    background: #000;
    border: 1px solid var(--pt-border);
    aspect-ratio: 16/9;
  }

  #pt-{{ section.id }} .pt-player-wrap iframe,
  #pt-{{ section.id }} .pt-player-wrap video {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    border: none;
    display: block;
  }

  /* Poster overlay (shown before play) */
  #pt-{{ section.id }} .pt-poster-layer {
    position: absolute;
    inset: 0;
    z-index: 2;
    cursor: pointer;
    transition: opacity 0.4s;
  }

  #pt-{{ section.id }} .pt-poster-layer.is-hidden { opacity: 0; pointer-events: none; }

  #pt-{{ section.id }} .pt-poster-img {
    width: 100%; height: 100%;
    object-fit: cover;
  }

  #pt-{{ section.id }} .pt-poster-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.1) 60%);
  }

  #pt-{{ section.id }} .pt-big-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #pt-{{ section.id }} .pt-big-play-ring {
    width: 76px; height: 76px;
    border-radius: 50%;
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(8px);
    border: 2px solid var(--pt-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 30px rgba(77,235,255,0.35);
    transition: transform 0.3s, box-shadow 0.3s;
  }

  #pt-{{ section.id }} .pt-poster-layer:hover .pt-big-play-ring {
    transform: scale(1.1);
    box-shadow: 0 0 50px rgba(77,235,255,0.55);
  }

  #pt-{{ section.id }} .pt-big-play-ring svg {
    width: 30px; height: 30px;
    fill: var(--pt-accent);
    margin-left: 4px;
  }

  /* Playing chapter badge */
  #pt-{{ section.id }} .pt-now-playing {
    position: absolute;
    top: 1rem; left: 1rem;
    z-index: 3;
    background: rgba(0,0,0,0.65);
    backdrop-filter: blur(6px);
    border: 1px solid var(--pt-border);
    border-radius: 999px;
    padding: 4px 12px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pt-accent);
    display: none;
  }

  #pt-{{ section.id }} .pt-now-playing.is-visible { display: block; }

  /* ── Video Info Bar ──────────────────────── */
  #pt-{{ section.id }} .pt-video-info {
    background: var(--pt-surface);
    border: 1px solid var(--pt-border);
    border-radius: var(--pt-radius);
    padding: 1.5rem;
  }

  #pt-{{ section.id }} .pt-video-info h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 0.35rem;
    line-height: 1.3;
  }

  #pt-{{ section.id }} .pt-video-info p {
    font-size: 0.85rem;
    color: var(--pt-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Progress bar */
  #pt-{{ section.id }} .pt-progress-wrap {
    margin-top: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  #pt-{{ section.id }} .pt-progress-bar {
    flex: 1;
    height: 3px;
    background: rgba(255,255,255,0.1);
    border-radius: 99px;
    overflow: hidden;
  }

  #pt-{{ section.id }} .pt-progress-fill {
    height: 100%;
    background: var(--pt-accent);
    border-radius: 99px;
    width: 0%;
    transition: width 0.4s;
  }

  #pt-{{ section.id }} .pt-progress-label {
    font-size: 0.7rem;
    color: var(--pt-muted);
    white-space: nowrap;
  }

  /* ── Product Details ─────────────────────── */
  #pt-{{ section.id }} .pt-details {
    background: var(--pt-surface);
    border: 1px solid var(--pt-border);
    border-radius: var(--pt-radius);
    padding: 1.5rem;
    margin-top: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    #pt-{{ section.id }} .pt-details { grid-template-columns: repeat(4, 1fr); }
  }

  #pt-{{ section.id }} .pt-stat { }

  #pt-{{ section.id }} .pt-stat-value {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--pt-accent);
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  #pt-{{ section.id }} .pt-stat-label {
    font-size: 0.72rem;
    color: var(--pt-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  /* ── Sidebar / Chapters ──────────────────── */
  #pt-{{ section.id }} .pt-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: sticky;
    top: 2rem;
  }

  #pt-{{ section.id }} .pt-chapter-box {
    background: var(--pt-surface);
    border: 1px solid var(--pt-border);
    border-radius: var(--pt-radius);
    overflow: hidden;
  }

  #pt-{{ section.id }} .pt-chapter-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--pt-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  #pt-{{ section.id }} .pt-chapter-header h4 {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--pt-muted);
    margin: 0;
  }

  #pt-{{ section.id }} .pt-chapter-count {
    font-size: 0.7rem;
    color: var(--pt-accent);
    font-weight: 700;
  }

  #pt-{{ section.id }} .pt-chapter-list {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0;
    max-height: 400px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.1) transparent;
  }

  #pt-{{ section.id }} .pt-chapter-list::-webkit-scrollbar { width: 4px; }
  #pt-{{ section.id }} .pt-chapter-list::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.1);
    border-radius: 2px;
  }

  #pt-{{ section.id }} .pt-chapter-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1.5rem;
    cursor: pointer;
    transition: background 0.2s;
    position: relative;
  }

  #pt-{{ section.id }} .pt-chapter-item:hover {
    background: rgba(255,255,255,0.04);
  }

  #pt-{{ section.id }} .pt-chapter-item.is-active {
    background: rgba(77,235,255,0.06);
  }

  #pt-{{ section.id }} .pt-chapter-item.is-active::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 2px;
    background: var(--pt-accent);
    border-radius: 0 2px 2px 0;
  }

  #pt-{{ section.id }} .pt-chapter-num {
    width: 28px; height: 28px;
    border-radius: 50%;
    border: 1px solid var(--pt-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--pt-muted);
    flex-shrink: 0;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }

  #pt-{{ section.id }} .pt-chapter-item.is-active .pt-chapter-num,
  #pt-{{ section.id }} .pt-chapter-item:hover .pt-chapter-num {
    background: var(--pt-accent);
    border-color: var(--pt-accent);
    color: #000;
  }

  #pt-{{ section.id }} .pt-chapter-item.is-done .pt-chapter-num {
    background: rgba(77,235,255,0.15);
    border-color: rgba(77,235,255,0.3);
    color: var(--pt-accent);
  }

  #pt-{{ section.id }} .pt-chapter-body { flex: 1; min-width: 0; }

  #pt-{{ section.id }} .pt-chapter-title {
    font-size: 0.87rem;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 0.2rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.2s;
  }

  #pt-{{ section.id }} .pt-chapter-item.is-active .pt-chapter-title {
    color: var(--pt-accent);
  }

  #pt-{{ section.id }} .pt-chapter-meta {
    font-size: 0.7rem;
    color: var(--pt-muted);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  #pt-{{ section.id }} .pt-chapter-duration {
    flex-shrink: 0;
    font-size: 0.68rem;
    color: var(--pt-muted);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* ── Highlights / CTA Card ───────────────── */
  #pt-{{ section.id }} .pt-highlights {
    background: var(--pt-surface2);
    border: 1px solid var(--pt-border);
    border-radius: var(--pt-radius);
    padding: 1.5rem;
  }

  #pt-{{ section.id }} .pt-highlights h4 {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--pt-muted);
    margin: 0 0 1rem;
  }

  #pt-{{ section.id }} .pt-highlight-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
  }

  #pt-{{ section.id }} .pt-highlight-item:last-child { margin-bottom: 0; }

  #pt-{{ section.id }} .pt-highlight-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--pt-accent);
    flex-shrink: 0;
    margin-top: 0.45rem;
  }

  #pt-{{ section.id }} .pt-highlight-text {
    font-size: 0.85rem;
    color: var(--pt-muted);
    line-height: 1.5;
  }

  /* ── CTA Button ──────────────────────────── */
  #pt-{{ section.id }} .pt-cta-area {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  #pt-{{ section.id }} .pt-btn-primary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: var(--pt-accent);
    color: #000;
    font-weight: 800;
    font-size: 0.9rem;
    padding: 1rem 1.5rem;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.3s, box-shadow 0.3s, transform 0.2s;
    box-shadow: 0 0 20px rgba(77,235,255,0.3);
    letter-spacing: 0.01em;
  }

  #pt-{{ section.id }} .pt-btn-primary:hover {
    background: #fff;
    box-shadow: 0 0 35px rgba(77,235,255,0.5);
    transform: translateY(-1px);
  }

  #pt-{{ section.id }} .pt-btn-primary svg {
    width: 18px; height: 18px;
    fill: currentColor;
  }

  #pt-{{ section.id }} .pt-btn-secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: transparent;
    color: var(--pt-text);
    font-weight: 700;
    font-size: 0.87rem;
    padding: 0.9rem 1.5rem;
    border-radius: 999px;
    border: 1px solid var(--pt-border);
    cursor: pointer;
    text-decoration: none;
    transition: border-color 0.3s, background 0.3s;
  }

  #pt-{{ section.id }} .pt-btn-secondary:hover {
    border-color: rgba(255,255,255,0.3);
    background: rgba(255,255,255,0.04);
  }

  /* ── Reduced motion ──────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    #pt-{{ section.id }} * { transition: none !important; }
  }
</style>

<div id="pt-{{ section.id }}">
  {% if section.settings.show_grid_bg %}<div class="pt-grid-bg"></div>{% endif %}
  <div class="pt-glow"></div>

  <div class="pt-wrap">

    <!-- ── Section Header ── -->
    <div class="pt-section-header">
      {% if section.settings.eyebrow != blank %}
        <p class="pt-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="pt-heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="pt-subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <!-- ── Main Layout ── -->
    <div class="pt-layout layout--{{ layout }}">

      <!-- VIDEO COLUMN -->
      <div class="pt-video-col">

        <!-- Player -->
        <div class="pt-player-wrap" id="pt-player-{{ section.id }}">

          <!-- Poster / Thumbnail -->
          <div class="pt-poster-layer" id="pt-poster-{{ section.id }}">
            {% if section.settings.main_poster %}
              <img
                class="pt-poster-img"
                src="{{ section.settings.main_poster | img_url: '1600x' }}"
                alt="{{ section.settings.heading | escape }}"
                loading="lazy">
            {% endif %}
            <div class="pt-poster-overlay"></div>
            <div class="pt-big-play">
              <div class="pt-big-play-ring">
                <svg viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              </div>
            </div>
          </div>

          <!-- Video container (populated by JS) -->
          <div id="pt-video-container-{{ section.id }}"></div>

          <!-- Now Playing badge -->
          <div class="pt-now-playing" id="pt-now-playing-{{ section.id }}">
            ▶ Playing
          </div>
        </div>

        <!-- Video info bar -->
        <div class="pt-video-info" id="pt-info-{{ section.id }}">
          <h3 id="pt-info-title-{{ section.id }}">
            {% assign first_block = section.blocks | first %}
            {{ first_block.settings.chapter_title | default: section.settings.heading }}
          </h3>
          <p id="pt-info-desc-{{ section.id }}">
            {{ first_block.settings.chapter_description | default: section.settings.subheading }}
          </p>
          <div class="pt-progress-wrap">
            <div class="pt-progress-bar">
              <div class="pt-progress-fill" id="pt-progress-{{ section.id }}"></div>
            </div>
            <span class="pt-progress-label" id="pt-progress-label-{{ section.id }}">
              1 / {{ section.blocks.size }}
            </span>
          </div>
        </div>

        <!-- Stats row -->
        {% assign stats_count = 0 %}
        {% for i in (1..4) %}
          {% assign val_key = 'stat_' | append: i | append: '_value' %}
          {% assign lbl_key = 'stat_' | append: i | append: '_label' %}
          {% if section.settings[val_key] != blank %}
            {% assign stats_count = stats_count | plus: 1 %}
          {% endif %}
        {% endfor %}

        {% if stats_count > 0 %}
          <div class="pt-details">
            {% for i in (1..4) %}
              {% assign val_key = 'stat_' | append: i | append: '_value' %}
              {% assign lbl_key = 'stat_' | append: i | append: '_label' %}
              {% if section.settings[val_key] != blank %}
                <div class="pt-stat">
                  <div class="pt-stat-value">{{ section.settings[val_key] }}</div>
                  <div class="pt-stat-label">{{ section.settings[lbl_key] }}</div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

      </div>

      <!-- SIDEBAR -->
      <div class="pt-sidebar">

        <!-- Chapter List -->
        {% if section.blocks.size > 0 %}
          <div class="pt-chapter-box">
            <div class="pt-chapter-header">
              <h4>Chapters</h4>
              <span class="pt-chapter-count">{{ section.blocks.size }} lessons</span>
            </div>
            <ul class="pt-chapter-list" id="pt-chapters-{{ section.id }}">
              {% for block in section.blocks %}
                {%- assign yt_id = '' -%}
                {%- assign yt_raw = block.settings.youtube_url -%}
                {%- if yt_raw contains 'youtu.be/' -%}
                  {%- assign yt_id = yt_raw | split: 'youtu.be/' | last | split: '?' | first -%}
                {%- elsif yt_raw contains 'v=' -%}
                  {%- assign yt_id = yt_raw | split: 'v=' | last | split: '&' | first -%}
                {%- endif -%}

                <li
                  class="pt-chapter-item{% if forloop.first %} is-active{% endif %}"
                  data-index="{{ forloop.index0 }}"
                  data-type="{{ block.settings.video_type }}"
                  data-yt-id="{{ yt_id }}"
                  data-video-src="{{ block.settings.hosted_video_url }}"
                  data-title="{{ block.settings.chapter_title | escape }}"
                  data-desc="{{ block.settings.chapter_description | escape }}"
                  tabindex="0"
                  role="button"
                  aria-label="Play chapter: {{ block.settings.chapter_title | escape }}"
                  {{ block.shopify_attributes }}>
                  <div class="pt-chapter-num">{{ forloop.index }}</div>
                  <div class="pt-chapter-body">
                    <div class="pt-chapter-title">{{ block.settings.chapter_title | default: 'Chapter ' | append: forloop.index }}</div>
                    <div class="pt-chapter-meta">
                      {% if block.settings.chapter_tag != blank %}
                        <span>{{ block.settings.chapter_tag }}</span>
                      {% endif %}
                    </div>
                  </div>
                  {% if block.settings.chapter_duration != blank %}
                    <span class="pt-chapter-duration">{{ block.settings.chapter_duration }}</span>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}

        <!-- Highlights -->
        {% assign has_highlights = false %}
        {% for i in (1..5) %}
          {% assign hl_key = 'highlight_' | append: i %}
          {% if section.settings[hl_key] != blank %}
            {% assign has_highlights = true %}
          {% endif %}
        {% endfor %}

        {% if has_highlights %}
          <div class="pt-highlights">
            <h4>What you'll learn</h4>
            {% for i in (1..5) %}
              {% assign hl_key = 'highlight_' | append: i %}
              {% if section.settings[hl_key] != blank %}
                <div class="pt-highlight-item">
                  <div class="pt-highlight-dot"></div>
                  <p class="pt-highlight-text">{{ section.settings[hl_key] }}</p>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        <!-- CTA -->
        {% if section.settings.cta_primary_label != blank %}
          <div class="pt-cta-area">
            <a
              href="{{ section.settings.cta_primary_link | default: '#' }}"
              class="pt-btn-primary">
              <svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
              {{ section.settings.cta_primary_label }}
            </a>
            {% if section.settings.cta_secondary_label != blank %}
              <a
                href="{{ section.settings.cta_secondary_link | default: '#' }}"
                class="pt-btn-secondary">
                {{ section.settings.cta_secondary_label }}
              </a>
            {% endif %}
          </div>
        {% endif %}

      </div>
      <!-- /SIDEBAR -->

    </div>
    <!-- /LAYOUT -->

  </div>
</div>

<script>
(function() {
  var sid         = '{{ section.id }}';
  var poster      = document.getElementById('pt-poster-' + sid);
  var container   = document.getElementById('pt-video-container-' + sid);
  var nowPlaying  = document.getElementById('pt-now-playing-' + sid);
  var infoTitle   = document.getElementById('pt-info-title-' + sid);
  var infoDesc    = document.getElementById('pt-info-desc-' + sid);
  var progressFill = document.getElementById('pt-progress-' + sid);
  var progressLabel = document.getElementById('pt-progress-label-' + sid);
  var chapterItems  = document.querySelectorAll('#pt-chapters-' + sid + ' .pt-chapter-item');
  var totalChapters = chapterItems.length;
  var currentIndex  = 0;

  function loadVideo(data, index) {
    container.innerHTML = '';
    poster.classList.add('is-hidden');
    nowPlaying.classList.add('is-visible');

    if (data.type === 'youtube' && data.ytId) {
      var iframe = document.createElement('iframe');
      iframe.src = 'https://www.youtube.com/embed/' + data.ytId + '?autoplay=1&rel=0&modestbranding=1';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      container.appendChild(iframe);
    } else if (data.videoSrc) {
      var video = document.createElement('video');
      video.src = data.videoSrc;
      video.controls = true;
      video.autoplay = true;
      video.style.cssText = 'width:100%;height:100%;object-fit:contain;background:#000;';
      container.appendChild(video);
    }

    // Update info bar
    if (infoTitle) infoTitle.textContent = data.title || '';
    if (infoDesc)  infoDesc.textContent  = data.desc  || '';

    // Update progress
    currentIndex = index;
    var pct = totalChapters > 1 ? (index / (totalChapters - 1)) * 100 : 100;
    if (progressFill)  progressFill.style.width = pct + '%';
    if (progressLabel) progressLabel.textContent = (index + 1) + ' / ' + totalChapters;

    // Update chapter active states
    chapterItems.forEach(function(item, i) {
      item.classList.remove('is-active');
      if (i < index) item.classList.add('is-done');
      if (i === index) item.classList.add('is-active');
    });
  }

  // Poster click — play first chapter
  if (poster) {
    poster.addEventListener('click', function() {
      var first = chapterItems[0];
      if (first) {
        loadVideo({
          type:     first.dataset.type,
          ytId:     first.dataset.ytId,
          videoSrc: first.dataset.videoSrc,
          title:    first.dataset.title,
          desc:     first.dataset.desc
        }, 0);
      }
    });
  }

  // Chapter click
  chapterItems.forEach(function(item, index) {
    function activate() {
      loadVideo({
        type:     item.dataset.type,
        ytId:     item.dataset.ytId,
        videoSrc: item.dataset.videoSrc,
        title:    item.dataset.title,
        desc:     item.dataset.desc
      }, index);
    }
    item.addEventListener('click', activate);
    item.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(); }
    });
  });
})();
</script>

