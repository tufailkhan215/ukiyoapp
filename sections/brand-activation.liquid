{% comment %} Brand activations: two-col intro (strap, title, description, CTA) + 2x4 image grid (grayscale, hover color + overlay title). {% endcomment %}
<section class="relative py-32 lg:py-40 bg-black" data-testid="brand-activation">
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="grid lg:grid-cols-2 gap-16 items-center mb-16">
      <div>
        {% if section.settings.strap != blank %}
          <span class="text-[10px] font-medium text-white/40 tracking-[0.3em] uppercase block mb-4">{{ section.settings.strap }}</span>
        {% endif %}
        {% if section.settings.title_before != blank or section.settings.title_gradient != blank %}
          <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
            {{ section.settings.title_before }}
            {% if section.settings.title_gradient != blank %}
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-gray-400 to-gray-600">{{ section.settings.title_gradient }}</span>
            {% endif %}
          </h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <p class="text-white/40 leading-relaxed">{{ section.settings.description }}</p>
        {% endif %}
      </div>
      <div class="flex justify-end">
        {% if section.settings.cta_text != blank and section.settings.cta_url != blank %}
          <a class="group inline-flex items-center gap-3 px-8 py-4 bg-white text-black rounded-full font-semibold hover:bg-gray-200 transition-colors" href="{{ section.settings.cta_url }}"{% if section.settings.cta_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
            {{ section.settings.cta_text }}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 flex-shrink-0 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
          </a>
        {% endif %}
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {% for block in section.blocks %}
        {% if block.type == 'image' %}
          <div class="group relative aspect-square overflow-hidden bg-white/[0.02] border border-white/[0.05] hover:border-white/10 transition-all" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <img
                alt="{{ block.settings.title | default: 'Brand activation' | escape }}"
                class="absolute inset-0 w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 group-hover:scale-105"
                src="{{ block.settings.image | image_url: width: 600 }}"
                width="600"
                height="600"
                loading="lazy"
              >
            {% else %}
              <div class="absolute inset-0 bg-white/[0.05] flex items-center justify-center">
                <span class="text-white/30 text-sm">Image</span>
              </div>
            {% endif %}
            {% if block.settings.title != blank %}
              <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                <span class="text-white text-sm font-medium">{{ block.settings.title }}</span>
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Activation",
  "tag": "section",
  "class": "section-brand-activation",
  "settings": [
    {
      "type": "text",
      "id": "strap",
      "label": "Strap (small label above title)",
      "default": "(Branding)"
    },
    {
      "type": "text",
      "id": "title_before",
      "label": "Title (before gradient part)",
      "default": "Brand "
    },
    {
      "type": "text",
      "id": "title_gradient",
      "label": "Title (gradient part)",
      "default": "Activations"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Branding is key to a standout identity and success. We activate your brand with powerful social media content, strategic partnerships, and engaging articles. With experience in the U.S. and Asia, we boost brand awareness, attract customers, and create new marketing opportunities."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Start Your Project"
    },
    {
      "type": "text",
      "id": "cta_url",
      "label": "Button URL",
      "default": "/contact"
    },
    {
      "type": "checkbox",
      "id": "cta_new_tab",
      "label": "Open link in new tab",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Caption (shown on hover)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Activation",
      "settings": {
        "strap": "(Branding)",
        "title_before": "Brand ",
        "title_gradient": "Activations",
        "description": "Branding is key to a standout identity and success. We activate your brand with powerful social media content, strategic partnerships, and engaging articles. With experience in the U.S. and Asia, we boost brand awareness, attract customers, and create new marketing opportunities.",
        "cta_text": "Start Your Project",
        "cta_url": "/contact"
      },
      "blocks": [
        { "type": "image", "settings": { "title": "Brand Identity" } },
        { "type": "image", "settings": { "title": "Logo Design" } },
        { "type": "image", "settings": { "title": "Packaging" } },
        { "type": "image", "settings": { "title": "Print Materials" } },
        { "type": "image", "settings": { "title": "Social Media" } },
        { "type": "image", "settings": { "title": "Brand Strategy" } },
        { "type": "image", "settings": { "title": "Creative Direction" } },
        { "type": "image", "settings": { "title": "Digital Assets" } }
      ]
    }
  ]
}
{% endschema %}
