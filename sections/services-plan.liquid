{% comment %} Pricing/plans: header + 3-column grid of plan cards (optional badge, featured styling), footer line. {% endcomment %}
<section class="relative py-20 lg:py-28 bg-black" id="pricing" data-testid="services-plan">
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  <div class="relative z-10 max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="text-center mb-16">
      {% if section.settings.strap != blank %}
        <span class="text-[10px] font-medium text-white/40 tracking-[0.3em] uppercase block mb-4">{{ section.settings.strap }}</span>
      {% endif %}
      {% if section.settings.title_before != blank or section.settings.title_gradient != blank %}
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
          {{ section.settings.title_before }}
          {% if section.settings.title_gradient != blank %}
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-gray-400 to-gray-600">{{ section.settings.title_gradient }}</span>
          {% endif %}
        </h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="text-white/40 max-w-xl mx-auto">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <div class="grid lg:grid-cols-3 gap-6">
      {% for block in section.blocks %}
        {% if block.type == 'plan' %}
          {% assign has_badge = false %}
          {% if block.settings.badge != blank %}
            {% assign has_badge = true %}
          {% endif %}
          <div class="relative {% if has_badge %}lg:-mt-4 lg:mb-4{% endif %}" {{ block.shopify_attributes }}>
            {% if has_badge %}
              <div class="absolute -top-4 left-1/2 -translate-x-1/2 px-4 py-1 bg-white text-black text-xs font-bold rounded-full">
                {{ block.settings.badge }}
              </div>
            {% endif %}
            <div class="h-full p-8 {% if has_badge %}border border-white/20 bg-white/[0.03]{% else %}border border-white/[0.05] bg-white/[0.01]{% endif %}">
              {% if block.settings.name != blank %}
                <h3 class="text-xl font-bold text-white mb-2">{{ block.settings.name }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="text-sm text-white/40 mb-6">{{ block.settings.description }}</p>
              {% endif %}
              <div class="flex items-baseline gap-2 mb-6">
                {% if block.settings.price != blank %}
                  <span class="text-4xl font-bold text-white">{{ block.settings.price }}</span>
                {% endif %}
                {% if block.settings.period != blank %}
                  <span class="text-white/40 text-sm">{{ block.settings.period }}</span>
                {% endif %}
              </div>
              {% if block.settings.features_text != blank %}
                <div class="space-y-3 mb-8">
                  {% assign lines = block.settings.features_text | newline_to_br | split: '<br />' %}
                  {% for line in lines %}
                    {% assign line_stripped = line | strip %}
                    {% if line_stripped != '' %}
                      <div class="flex items-start gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check w-4 h-4 text-white/50 mt-0.5 flex-shrink-0" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                        <span class="text-sm text-white/60">{{ line_stripped }}</span>
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}
              {% if block.settings.cta_text != blank and block.settings.cta_url != blank %}
                <a href="{{ block.settings.cta_url }}" class="block {% if has_badge %}w-full py-3 rounded-full font-semibold transition-all bg-white text-black hover:bg-gray-200 text-center{% else %}w-full py-3 rounded-full font-semibold transition-all border border-white/20 text-white hover:bg-white/5 text-center{% endif %}" {% if block.settings.cta_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
                  {{ block.settings.cta_text }}
                </a>
              {% elsif block.settings.cta_text != blank %}
                <span class="block w-full py-3 rounded-full font-semibold border border-white/20 text-white text-center cursor-default">{{ block.settings.cta_text }}</span>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.footer_before != blank or section.settings.footer_highlight != blank or section.settings.footer_after != blank %}
      <div class="text-center mt-8">
        <p class="text-white/40 text-sm">
          {{ section.settings.footer_before }}
          {% if section.settings.footer_highlight != blank %}
            <span class="text-white font-semibold">{{ section.settings.footer_highlight }}</span>
          {% endif %}
          {{ section.settings.footer_after }}
        </p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Services Plan",
  "tag": "section",
  "class": "section-services-plan",
  "settings": [
    {
      "type": "text",
      "id": "strap",
      "label": "Strap (small label above title)",
      "default": "(Investment)"
    },
    {
      "type": "text",
      "id": "title_before",
      "label": "Title (before gradient part)",
      "default": "Choose Your "
    },
    {
      "type": "text",
      "id": "title_gradient",
      "label": "Title (gradient part)",
      "default": "Plan"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Subtitle below title",
      "default": "Select the package that best fits your needs. All plans include our signature quality and support."
    },
    {
      "type": "header",
      "content": "Footer line"
    },
    {
      "type": "text",
      "id": "footer_before",
      "label": "Footer text (before highlight)",
      "default": "Need ongoing support? Add "
    },
    {
      "type": "text",
      "id": "footer_highlight",
      "label": "Footer highlight (e.g. price)",
      "default": "$500/mo"
    },
    {
      "type": "text",
      "id": "footer_after",
      "label": "Footer text (after highlight)",
      "default": " for Ongoing optimization, updates, and support"
    }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Plan name"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Short description"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price (e.g. $2,500)"
        },
        {
          "type": "text",
          "id": "period",
          "label": "Price period (e.g. / one-time setup)",
          "default": "/ one-time setup"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (e.g. Most Popular)",
          "info": "When set, this plan is styled as featured and the CTA uses a primary button."
        },
        {
          "type": "textarea",
          "id": "features_text",
          "label": "Features (one per line)"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Button text",
          "default": "Get Started"
        },
        {
          "type": "text",
          "id": "cta_url",
          "label": "Button URL"
        },
        {
          "type": "checkbox",
          "id": "cta_new_tab",
          "label": "Open link in new tab",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services Plan",
      "settings": {
        "strap": "(Investment)",
        "title_before": "Choose Your ",
        "title_gradient": "Plan",
        "description": "Select the package that best fits your needs. All plans include our signature quality and support.",
        "footer_before": "Need ongoing support? Add ",
        "footer_highlight": "$500/mo",
        "footer_after": " for Ongoing optimization, updates, and support"
      },
      "blocks": [
        {
          "type": "plan",
          "settings": {
            "name": "Starter",
            "description": "Perfect for small businesses getting started with AI automation",
            "price": "$2,500",
            "period": "/ one-time setup",
            "features_text": "Single AI agent\nWebsite deployment\nBasic knowledge base (up to 50 FAQs)\nStandard response templates\nEmail support\n30-day optimization period",
            "cta_text": "Get Started",
            "cta_new_tab": true
          }
        },
        {
          "type": "plan",
          "settings": {
            "name": "Professional",
            "description": "Ideal for growing businesses ready to scale their customer experience",
            "price": "$5,000",
            "period": "/ one-time setup",
            "badge": "Most Popular",
            "features_text": "Advanced AI agent with personality\nWebsite + Instagram DM deployment\nComprehensive knowledge base (unlimited)\nCustom conversation flows\nCRM integration\nAnalytics dashboard\nPriority support\n90-day optimization period",
            "cta_text": "Get Started",
            "cta_new_tab": true
          }
        },
        {
          "type": "plan",
          "settings": {
            "name": "Enterprise",
            "description": "For established brands requiring complete AI ecosystem",
            "price": "$12,000",
            "period": "/ one-time setup",
            "features_text": "Multiple AI agents\nAll channels (Web, IG, FB, Email, SMS)\nAdvanced integrations (Shopify, HubSpot, etc.)\nCustom training & fine-tuning\nDedicated account manager\nWhite-glove onboarding\n24/7 priority support\nQuarterly strategy reviews",
            "cta_text": "Get Started",
            "cta_new_tab": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
