<script>
(function () {
  const rootId = 'UkiyoCinematic-{{ section.id }}';
  const registryKey = '__ukiyoCinematicControllers';

  window[registryKey] = window[registryKey] || {};

  /*
    Remove the previous controller when Shopify reloads
    this section without refreshing the page.
  */
  if (window[registryKey][rootId]) {
    window[registryKey][rootId]();
  }

  const lifecycle = new AbortController();
  let cleanup = null;

  function initialize() {
    const root = document.getElementById(rootId);
    if (!root) return;

    if (cleanup) cleanup();

    /*
      Stop the old custom-element implementation if it is
      still registered in the current Shopify preview.
    */
    cancelAnimationFrame(root.initFrame);
    cancelAnimationFrame(root.scrollFrame);

    root.abort?.abort();
    root.videoObserver?.disconnect();
    root.viewObserver?.disconnect();
    root.revealObserver?.disconnect();
    root.animations?.forEach(animation => animation.cancel());

    const events = new AbortController();
    const signal = events.signal;

    const hero = root.querySelector('.uc__hero');
    const statement = root.querySelector('.uc__statement');
    const button = root.querySelector('[data-uc-motion]');
    const scrollLink = root.querySelector('[data-uc-scroll]');
    const videos = [...root.querySelectorAll('[data-uc-video]')];
    const revealElements = [
      ...root.querySelectorAll('[data-uc-reveal]')
    ];

    if (!hero) return;

    const reduced = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

    let paused = false;
    let frame = null;
    let destroyed = false;

    const animations = new Set();
    const revealed = new Set();
    const videoStates = new Map();

    function canAnimate() {
      return !paused && !reduced.matches;
    }

    function updateButton() {
      if (!button) return;

      button.hidden = reduced.matches;
      button.setAttribute('aria-pressed', String(paused));
      button.textContent = paused
        ? 'Play motion'
        : 'Pause motion';
    }

    function animateElement(element, index) {
      if (
        revealed.has(element) ||
        !canAnimate() ||
        !element.animate
      ) return;

      revealed.add(element);

      const animation = element.animate(
        [
          {
            opacity: 0,
            transform: 'translateY(30px)'
          },
          {
            opacity: 1,
            transform: 'translateY(0)'
          }
        ],
        {
          duration: 1100,
          delay: Math.min(index, 5) * 100,
          easing: 'cubic-bezier(.16,1,.3,1)',
          fill: 'backwards'
        }
      );

      animations.add(animation);

      animation.finished
        .then(() => animations.delete(animation))
        .catch(() => animations.delete(animation));
    }

    function revealVisibleElements() {
      if (!canAnimate()) return;

      let index = 0;

      revealElements.forEach(element => {
        if (revealed.has(element)) return;

        const bounds = element.getBoundingClientRect();

        if (
          bounds.top < window.innerHeight * 0.98 &&
          bounds.bottom > 0
        ) {
          animateElement(element, index);
          index += 1;
        }
      });
    }

    function updateVideos(force) {
      videos.forEach(video => {
        const bounds = video.getBoundingClientRect();

        const visible =
          bounds.bottom > -100 &&
          bounds.top < window.innerHeight + 100;

        const shouldPlay =
          canAnimate() &&
          visible &&
          !document.hidden;

        if (
          !force &&
          videoStates.get(video) === shouldPlay
        ) return;

        videoStates.set(video, shouldPlay);

        if (!shouldPlay) {
          video.pause();
          return;
        }

        /*
          Set both attributes and properties for Safari,
          mobile browsers, and Shopify's preview.
        */
        video.muted = true;
        video.defaultMuted = true;
        video.loop = true;
        video.playsInline = true;
        video.autoplay = true;

        video.setAttribute('muted', '');
        video.setAttribute('playsinline', '');
        video.setAttribute('webkit-playsinline', '');

        const promise = video.play();

        if (promise && typeof promise.catch === 'function') {
          promise.catch(() => {
            /*
              A browser may still block autoplay.
              Clicking Play motion retries from a user gesture.
            */
            video.dataset.ucPlayback = 'blocked';
          });
        }
      });
    }

    function updateParallax() {
      if (!canAnimate()) {
        root.style.setProperty('--uc-video-y', '0px');
        root.style.setProperty('--uc-cloud-y', '0px');
        return;
      }

      const bounds = hero.getBoundingClientRect();
      const distance = Math.max(0, -bounds.top);
      const progress = Math.min(distance / 300, 1);
      const mobile = window.innerWidth <= 650;

      root.style.setProperty(
        '--uc-video-y',
        `${Math.min(distance * 0.12, 60)}px`
      );

      root.style.setProperty(
        '--uc-cloud-y',
        `${-progress * (mobile ? 24 : 100)}px`
      );
    }

    function update() {
      frame = null;

      if (destroyed || !root.isConnected) return;

      updateParallax();
      revealVisibleElements();
      updateVideos(false);
    }

    function requestUpdate() {
      if (frame !== null || destroyed) return;
      frame = requestAnimationFrame(update);
    }

    function stopAnimations() {
      animations.forEach(animation => animation.cancel());
      animations.clear();
    }

    function syncMotion(forceVideo) {
      updateButton();

      if (!canAnimate()) {
        stopAnimations();
      }

      updateParallax();
      updateVideos(Boolean(forceVideo));
      requestUpdate();
    }

    if (button) {
      button.addEventListener(
        'click',
        () => {
          const blockedVideo = videos.some(video =>
            video.dataset.ucPlayback === 'blocked'
          );

          /*
            If autoplay was blocked, the first click
            retries playback instead of pausing.
          */
          paused = blockedVideo ? false : !paused;

          videos.forEach(video => {
            delete video.dataset.ucPlayback;
          });

          if (!paused) {
            revealed.clear();
          }

          syncMotion(true);
        },
        { signal }
      );
    }

    if (scrollLink && statement) {
      scrollLink.addEventListener(
        'click',
        event => {
          event.preventDefault();

          statement.scrollIntoView({
            behavior: reduced.matches ? 'auto' : 'smooth',
            block: 'start'
          });
        },
        { signal }
      );
    }

    reduced.addEventListener(
      'change',
      () => syncMotion(true),
      { signal }
    );

    document.addEventListener(
      'visibilitychange',
      () => syncMotion(true),
      { signal }
    );

    /*
      Capture scroll events from the page and nested
      preview containers.
    */
    document.addEventListener(
      'scroll',
      requestUpdate,
      {
        passive: true,
        capture: true,
        signal
      }
    );

    window.addEventListener(
      'resize',
      requestUpdate,
      { passive: true, signal }
    );

    videos.forEach(video => {
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;

      video.addEventListener(
        'loadeddata',
        () => updateVideos(true),
        { signal }
      );

      video.addEventListener(
        'playing',
        () => {
          delete video.dataset.ucPlayback;
        },
        { signal }
      );
    });

    /*
      Initialize immediately, including in Shopify's editor.
      No editor-only pause and no observer required.
    */
    syncMotion(true);

    cleanup = function () {
      destroyed = true;
      events.abort();

      if (frame !== null) {
        cancelAnimationFrame(frame);
      }

      stopAnimations();
      videos.forEach(video => video.pause());
    };
  }

  document.addEventListener(
    'shopify:section:load',
    event => {
      if (
        event.target.id === 'shopify-section-{{ section.id }}' ||
        event.target.querySelector('[id="' + rootId + '"]')
      ) {
        initialize();
      }
    },
    { signal: lifecycle.signal }
  );

  document.addEventListener(
    'shopify:section:unload',
    event => {
      if (event.target.id === 'shopify-section-{{ section.id }}') {
        if (cleanup) cleanup();
        cleanup = null;
      }
    },
    { signal: lifecycle.signal }
  );

  window[registryKey][rootId] = function () {
    lifecycle.abort();
    if (cleanup) cleanup();
  };

  if (document.readyState === 'loading') {
    document.addEventListener(
      'DOMContentLoaded',
      initialize,
      {
        once: true,
        signal: lifecycle.signal
      }
    );
  } else {
    initialize();
  }
})();
</script>