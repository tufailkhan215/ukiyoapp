{% comment %}
  UKIYO — Responsive Cinematic Hero
  Mobile autoplay and playback-state correction.
  Optional upper-left logo.
  Existing content, layout, buttons, and settings preserved.
{% endcomment %}

{% assign custom_buttons = section.blocks | where: 'type', 'button' %}

{% capture arrow_icon %}
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M7 17 17 7M7 7h10v10"/>
  </svg>
{% endcapture %}

{% capture top_buttons %}
  {% if section.settings.show_primary %}
    {% if section.settings.cta_primary_text != blank and section.settings.cta_primary_link != blank %}
      <a
        class="uc__button uc__button--outline"
        href="{{ section.settings.cta_primary_link | escape }}"
      >
        <span>{{ section.settings.cta_primary_text | escape }}</span>
        {{ arrow_icon }}
      </a>
    {% endif %}
  {% endif %}

  {% for block in custom_buttons %}
    {% if block.settings.placement == 'top' %}
      {% if block.settings.label != blank and block.settings.link != blank %}
        <a
          class="uc__button uc__button--{{ block.settings.style }}"
          href="{{ block.settings.link | escape }}"
          {{ block.shopify_attributes }}
        >
          <span>{{ block.settings.label | escape }}</span>
          {{ arrow_icon }}
        </a>
      {% endif %}
    {% endif %}
  {% endfor %}
{% endcapture %}

{% capture content_buttons %}
  {% if section.settings.show_secondary %}
    {% if section.settings.cta_secondary_text != blank and section.settings.cta_secondary_link != blank %}
      <a
        class="uc__button uc__button--text"
        href="{{ section.settings.cta_secondary_link | escape }}"
      >
        <span>{{ section.settings.cta_secondary_text | escape }}</span>
        {{ arrow_icon }}
      </a>
    {% endif %}
  {% endif %}

  {% for block in custom_buttons %}
    {% if block.settings.placement == 'content' %}
      {% if block.settings.label != blank and block.settings.link != blank %}
        <a
          class="uc__button uc__button--{{ block.settings.style }}"
          href="{{ block.settings.link | escape }}"
          {{ block.shopify_attributes }}
        >
          <span>{{ block.settings.label | escape }}</span>
          {{ arrow_icon }}
        </a>
      {% endif %}
    {% endif %}
  {% endfor %}
{% endcapture %}

{% capture statement_buttons %}
  {% if section.settings.show_statement_primary %}
    {% if section.settings.cta_primary_text != blank and section.settings.cta_primary_link != blank %}
      <a
        class="uc__button uc__button--text"
        href="{{ section.settings.cta_primary_link | escape }}"
      >
        <span>{{ section.settings.cta_primary_text | escape }}</span>
        {{ arrow_icon }}
      </a>
    {% endif %}
  {% endif %}

  {% for block in custom_buttons %}
    {% if block.settings.placement == 'statement' %}
      {% if block.settings.label != blank and block.settings.link != blank %}
        <a
          class="uc__button uc__button--{{ block.settings.style }}"
          href="{{ block.settings.link | escape }}"
          {{ block.shopify_attributes }}
        >
          <span>{{ block.settings.label | escape }}</span>
          {{ arrow_icon }}
        </a>
      {% endif %}
    {% endif %}
  {% endfor %}
{% endcapture %}

{% assign top_buttons = top_buttons | strip %}
{% assign content_buttons = content_buttons | strip %}
{% assign statement_buttons = statement_buttons | strip %}

<div
  id="UkiyoCinematic-{{ section.id }}"
  class="uc"
  style="
    --uc-red: {{ section.settings.statement_color | default: '#d92323' }};
    --uc-mobile-type: {{ section.settings.mobile_heading_size | default: 40 }}px;
    --uc-mobile-focus: {{ section.settings.mobile_video_position | default: 50 }}%;
  "
>
  <section
    class="uc__hero"
    aria-labelledby="UC-Title-{{ section.id }}"
  >
    <div class="uc__media" aria-hidden="true">
      {% if section.settings.hero_poster != blank %}
        {{
          section.settings.hero_poster
          | image_url: width: 2400
          | image_tag:
            class: 'uc__poster',
            widths: '750, 1100, 1600, 2000, 2400',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: ''
        }}
      {% endif %}

      {% if section.settings.hero_video_url != blank %}
        <video
          class="uc__hero-video"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          tabindex="-1"
          {% if section.settings.hero_poster != blank %}
            poster="{{ section.settings.hero_poster | image_url: width: 2400 }}"
          {% endif %}
          data-uc-video
        >
          <source
            src="{{ section.settings.hero_video_url | escape }}"
            type="video/mp4"
          >
        </video>
      {% endif %}
    </div>

    <div class="uc__shade" aria-hidden="true"></div>

    <div class="uc__hero-inner">
      <div
        class="uc__identity{% if section.settings.show_logo == false %} uc__identity--no-logo{% endif %}"
        data-uc-reveal
      >
        {% if section.settings.show_logo != false %}
          {% if section.settings.logo != blank %}
            {{
              section.settings.logo
              | image_url: width: 400
              | image_tag:
                class: 'uc__logo',
                widths: '160, 240, 400',
                sizes: '(max-width: 760px) 115px, 150px',
                loading: 'eager',
                alt: 'UKIYO'
            }}
          {% else %}
            <span class="uc__wordmark">UKIYO</span>
          {% endif %}
        {% endif %}

        {% if section.settings.subtitle != blank %}
          <p class="uc__tagline">
            {{ section.settings.subtitle | escape }}
          </p>
        {% endif %}
      </div>

      {% if top_buttons != blank %}
        <div class="uc__actions uc__actions--top">
          {{ top_buttons }}
        </div>
      {% endif %}

      <div class="uc__title-wrap">
        <h1 id="UC-Title-{{ section.id }}" class="uc__title">
          {% if section.settings.headline_line1 != blank %}
            <span class="uc__line" data-uc-reveal>
              {{ section.settings.headline_line1 | escape }}
            </span>
          {% endif %}

          {% if section.settings.headline_line2 != blank %}
            <span class="uc__line uc__line--accent" data-uc-reveal>
              {{ section.settings.headline_line2 | escape }}
            </span>
          {% endif %}

          {% if section.settings.headline_line3 != blank %}
            <span class="uc__line" data-uc-reveal>
              {{ section.settings.headline_line3 | escape }}
            </span>
          {% endif %}
        </h1>
      </div>

      <div class="uc__aside" data-uc-reveal>
        {% if section.settings.eyebrow != blank %}
          <span class="uc__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </span>
        {% endif %}

        {% if section.settings.description != blank %}
          <p class="uc__description">
            {{ section.settings.description | escape }}
          </p>
        {% endif %}
      </div>

      {% if content_buttons != blank %}
        <div class="uc__actions uc__actions--content">
          {{ content_buttons }}
        </div>
      {% endif %}

      <div class="uc__bottom">
        {% if section.settings.show_scroll %}
          <a
            class="uc__scroll"
            href="#UC-Statement-{{ section.id }}"
            data-uc-scroll
          >
            <span>
              {{ section.settings.scroll_label | default: 'Explore' | escape }}
            </span>
            <span class="uc__scroll-icon" aria-hidden="true">↓</span>
          </a>
        {% endif %}

        {% if section.settings.bottom_note != blank %}
          <span class="uc__bottom-note">
            {{ section.settings.bottom_note | escape }}
          </span>
        {% endif %}

        <button
          class="uc__motion"
          type="button"
          aria-pressed="false"
          data-uc-motion
          hidden
        >
          Play motion
        </button>
      </div>
    </div>
  </section>

  <section
    id="UC-Statement-{{ section.id }}"
    class="uc__statement"
    aria-labelledby="UC-StatementTitle-{{ section.id }}"
  >
    {% if section.settings.cloud_image != blank or section.settings.cloud_image_url != blank %}
      <div class="uc__cloud" aria-hidden="true">
        {% if section.settings.cloud_image != blank %}
          {{
            section.settings.cloud_image
            | image_url: width: 2400
            | image_tag:
              widths: '750, 1100, 1600, 2000, 2400',
              sizes: '100vw',
              loading: 'lazy',
              alt: ''
          }}
        {% else %}
          <img
            src="{{ section.settings.cloud_image_url | escape }}"
            alt=""
            loading="lazy"
            decoding="async"
          >
        {% endif %}
      </div>
    {% endif %}

    <div class="uc__statement-inner">
      <div class="uc__statement-label" data-uc-reveal>
        <span aria-hidden="true"></span>
        UKIYO / OUR APPROACH
      </div>

      <h2
        id="UC-StatementTitle-{{ section.id }}"
        class="uc__statement-title"
        data-uc-reveal
      >
        {{ section.settings.statement_heading | default: 'Built to move your brand forward.' | escape }}
      </h2>

      {% if section.settings.statement_intro != blank %}
        <p class="uc__statement-intro" data-uc-reveal>
          {{ section.settings.statement_intro | escape }}
        </p>
      {% endif %}

      <div class="uc__signature" aria-hidden="true" data-uc-reveal>
        Ukiyo.
      </div>

      <div class="uc__statement-copy">
        {% if section.settings.statement_body != blank %}
          <p data-uc-reveal>
            {{ section.settings.statement_body | escape | newline_to_br }}
          </p>
        {% endif %}

        {% if section.settings.statement_body_2 != blank %}
          <p data-uc-reveal>
            {{ section.settings.statement_body_2 | escape | newline_to_br }}
          </p>
        {% endif %}
      </div>

      {% if statement_buttons != blank %}
        <div class="uc__actions uc__actions--statement">
          {{ statement_buttons }}
        </div>
      {% endif %}
    </div>

    {% if section.settings.statement_video_url != blank %}
      <div class="uc__closing-media" aria-hidden="true">
        <div class="uc__closing-fade"></div>

        <video
          class="uc__closing-video"
          muted
          loop
          playsinline
          preload="none"
          tabindex="-1"
          {% if section.settings.statement_poster != blank %}
            poster="{{ section.settings.statement_poster | image_url: width: 2000 }}"
          {% endif %}
          data-uc-video
        >
          <source
            src="{{ section.settings.statement_video_url | escape }}"
            type="video/mp4"
          >
        </video>
      </div>
    {% endif %}
  </section>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Italiana&family=Manrope:wght@400;500;600&family=Marck+Script&display=swap');

  .uc {
    --uc-white: #f7f5ef;
    --uc-gutter: clamp(24px, 4.5vw, 72px);
    display: block;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #080909;
    color: var(--uc-white);
    font-family: "Manrope", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .uc *,
  .uc *::before,
  .uc *::after {
    box-sizing: border-box;
  }

  .uc svg {
    display: block;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }

  .uc .uc__hero {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: 760px;
    min-height: max(720px, 100svh);
    background: #182321;
    overflow: hidden;
  }

  .uc .uc__media {
    position: absolute;
    inset: -8% 0;
    z-index: 0;
    transform: translate3d(0, var(--uc-video-y, 0px), 0);
    pointer-events: none;
    background: radial-gradient(
      ellipse at 65% 20%,
      #6c7d76,
      #253d36 40%,
      #111c19 80%
    );
  }

  .uc .uc__poster,
  .uc .uc__hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .uc .uc__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        rgba(0,0,0,.32),
        rgba(0,0,0,.08) 25%,
        rgba(0,0,0,.34) 60%,
        rgba(0,0,0,.78)
      ),
      linear-gradient(
        90deg,
        rgba(0,0,0,.25),
        transparent 75%
      );
  }

  .uc .uc__hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(220px, .8fr) minmax(0, 2.4fr);
    grid-template-rows: auto minmax(100px, 1fr) auto auto auto;
    grid-template-areas:
      "brand top"
      ". ."
      "aside title"
      "buttons title"
      "bottom bottom";
    column-gap: clamp(32px, 5vw, 80px);
    row-gap: 24px;
    width: 100%;
    max-width: 1800px;
    min-width: 0;
    margin-inline: auto;
    padding: clamp(30px, 4vw, 64px) var(--uc-gutter) 24px;
  }

  .uc .uc__identity {
    grid-area: brand;
    display: flex;
    align-items: center;
    align-self: start;
    gap: 24px;
    min-width: 0;
  }

  .uc .uc__wordmark {
    display: block;
    color: #fff;
    font-size: clamp(28px, 2.6vw, 42px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -.055em;
    white-space: nowrap;
  }

  .uc .uc__logo {
    display: block;
    width: 150px;
    max-width: 40%;
    height: auto;
    max-height: 70px;
    object-fit: contain;
  }

  .uc .uc__tagline {
    max-width: 170px;
    margin: 0;
    padding-left: 22px;
    border-left: 1px solid #ffffff60;
    color: #fff;
    font-size: 10px;
    font-weight: 500;
    line-height: 1.65;
    letter-spacing: .025em;
    text-wrap: pretty;
  }

  .uc .uc__title-wrap {
    grid-area: title;
    align-self: end;
    min-width: 0;
  }

  .uc .uc__title {
    margin: 0;
    color: #fff;
    font-family: "Italiana", Georgia, serif;
    font-size: clamp(48px, 5.6vw, 94px);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -.04em;
    text-align: right;
    text-transform: none;
    overflow-wrap: break-word;
  }

  .uc .uc__line {
    display: block;
    padding-block: .025em;
    text-wrap: balance;
  }

  .uc .uc__line--accent {
    color: #e7ece3;
  }

  .uc .uc__aside {
    grid-area: aside;
    align-self: end;
    max-width: 330px;
    min-width: 0;
  }

  .uc .uc__eyebrow {
    display: block;
    margin-bottom: 18px;
    color: #ffffffd6;
    font-size: 9px;
    line-height: 1.6;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .uc .uc__description {
    margin: 0;
    color: #f3f2ee;
    font-size: 14px;
    line-height: 1.85;
    text-wrap: pretty;
  }

  .uc .uc__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .uc .uc__actions--top {
    grid-area: top;
    align-self: start;
    justify-content: flex-end;
  }

  .uc .uc__actions--content {
    grid-area: buttons;
    align-self: start;
  }

  .uc .uc__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    min-height: 50px;
    max-width: 100%;
    padding: 14px 24px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-family: "Manrope", Arial, sans-serif;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.5;
    text-align: center;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition:
      background .25s,
      color .25s,
      border-color .25s,
      transform .25s;
  }

  .uc .uc__button > span {
    min-width: 0;
  }

  .uc .uc__button svg {
    width: 18px;
    height: 18px;
    transition: transform .25s;
  }

  .uc .uc__button--outline {
    background: #00000015;
    border-color: #ffffff90;
    color: #fff;
  }

  .uc .uc__button--solid {
    background: #f7f5ef;
    border-color: #f7f5ef;
    color: #161916;
  }

  .uc .uc__button--text {
    justify-content: space-between;
    padding: 10px 0;
    border-radius: 0;
    border-bottom-color: #ffffff80;
    background: transparent;
    color: #fff;
  }

  .uc .uc__actions--top .uc__button--outline {
    padding: 18px 32px;
    border-radius: 50%;
    font-family: "Italiana", Georgia, serif;
    font-size: 19px;
  }

  .uc .uc__bottom {
    grid-area: bottom;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 20px;
    padding-top: 14px;
    border-top: 1px solid #ffffff38;
  }

  .uc .uc__scroll {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 44px;
    color: #fff;
    text-decoration: none;
    font-size: 9px;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .uc .uc__scroll-icon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 34px;
    border: 1px solid #ffffff55;
    border-radius: 30px;
    font-size: 16px;
  }

  .uc .uc__bottom-note {
    color: #ffffffbd;
    font-size: 9px;
    line-height: 1.6;
    letter-spacing: .12em;
    text-transform: uppercase;
    text-align: center;
  }

  .uc .uc__motion {
    min-height: 44px;
    margin-left: auto;
    padding: 8px 0 8px 10px;
    border: 0;
    background: none;
    color: #ffffffde;
    font-family: inherit;
    font-size: 10px;
    cursor: pointer;
  }

  .uc .uc__motion[hidden] {
    display: none;
  }

  .uc .uc__statement {
    position: relative;
    background: var(--uc-red);
    color: #fff;
    scroll-margin-top: 60px;
  }

  .uc .uc__cloud {
    position: absolute;
    top: 0;
    left: -2%;
    width: 104%;
    z-index: 2;
    pointer-events: none;
    transform: translateY(calc(-50% + var(--uc-cloud-y, 0px)));
  }

  .uc .uc__cloud img {
    display: block;
    width: 100%;
    height: auto;
  }

  .uc .uc__statement-inner {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(100%, 1040px);
    margin-inline: auto;
    padding: clamp(170px, 23vw, 380px) 28px clamp(60px, 8vw, 130px);
    text-align: center;
  }

  .uc .uc__statement-label {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 30px;
    color: #ffffffe6;
    font-size: 9px;
    line-height: 1.6;
    letter-spacing: .2em;
  }

  .uc .uc__statement-label > span {
    width: 5px;
    height: 5px;
    background: #fff;
    border-radius: 50%;
  }

  .uc .uc__statement-title {
    max-width: 850px;
    margin: 0 0 30px;
    color: #fff;
    font-family: "Italiana", Georgia, serif;
    font-size: clamp(42px, 6.6vw, 90px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -.035em;
    text-transform: none;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .uc .uc__statement-intro {
    max-width: 540px;
    margin: 0;
    color: #fffffff0;
    font-size: 13px;
    line-height: 1.9;
    letter-spacing: .06em;
    text-transform: uppercase;
    text-wrap: pretty;
  }

  .uc .uc__signature {
    margin: 34px 0 28px;
    color: #fff;
    font-family: "Marck Script", cursive;
    font-size: clamp(80px, 12vw, 140px);
    line-height: 1;
    rotate: -7deg;
  }

  .uc .uc__statement-copy {
    display: grid;
    gap: 22px;
    max-width: 470px;
  }

  .uc .uc__statement-copy p {
    margin: 0;
    color: #ffffffe8;
    font-size: 14px;
    line-height: 1.9;
    text-wrap: pretty;
  }

  .uc .uc__actions--statement {
    justify-content: center;
    margin-top: 32px;
  }

  .uc .uc__closing-media {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--uc-red);
  }

  .uc .uc__closing-fade {
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: clamp(70px, 10vw, 160px);
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(to bottom, var(--uc-red), transparent);
  }

  .uc .uc__closing-video {
    display: block;
    width: 100%;
    height: auto;
    min-height: 180px;
    object-fit: contain;
  }

  .uc a:focus-visible,
  .uc button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 5px;
  }

  @media (hover: hover) and (pointer: fine) {
    .uc .uc__button:hover {
      transform: translateY(-2px);
    }

    .uc .uc__button--outline:hover {
      background: #ffffff20;
      border-color: #fff;
    }

    .uc .uc__button--solid:hover {
      background: #fff;
      border-color: #fff;
    }

    .uc .uc__button:hover svg {
      transform: translate(2px, -2px);
    }
  }

  @media (min-width: 761px) and (max-width: 1100px) {
    .uc .uc__hero-inner {
      grid-template-columns: minmax(180px, .8fr) minmax(0, 1.8fr);
      column-gap: 32px;
    }

    .uc .uc__identity {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }

    .uc .uc__tagline {
      padding-left: 0;
      border: 0;
    }

    .uc .uc__title {
      font-size: clamp(46px, 6vw, 66px);
    }

    .uc .uc__description {
      font-size: 13px;
    }
  }

  @media (max-width: 760px) {
    .uc {
      --uc-gutter: clamp(20px, 5vw, 30px);
    }

    .uc .uc__hero {
      min-height: 100svh;
    }

    .uc .uc__hero-inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(40px, 1fr) auto auto auto auto auto;
      grid-template-areas:
        "brand"
        "."
        "title"
        "aside"
        "top"
        "buttons"
        "bottom";
      column-gap: 0;
      row-gap: 18px;
      padding: 24px var(--uc-gutter) 20px;
    }

    .uc .uc__identity {
      gap: 20px;
      align-items: center;
    }

    .uc .uc__wordmark {
      font-size: 31px;
