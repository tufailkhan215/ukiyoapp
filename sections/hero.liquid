<script>
(function () {
  const rootId = 'UkiyoCinematic-{{ section.id }}';
  const wrapperId = 'shopify-section-{{ section.id }}';
  const registryKey = '__ukiyoCinematicControllers';

  window[registryKey] = window[registryKey] || {};

  if (window[registryKey][rootId]) {
    window[registryKey][rootId]();
  }

  const lifecycle = new AbortController();
  let cleanup = null;

  function initialize() {
    const root = document.getElementById(rootId);
    if (!root) return;
    if (cleanup) cleanup();

    const events = new AbortController();
    const signal = events.signal;

    const hero = root.querySelector('.uc__hero');
    const statement = root.querySelector('.uc__statement');
    const button = root.querySelector('[data-uc-motion]');
    const scrollLink = root.querySelector('[data-uc-scroll]');
    const videos = [...root.querySelectorAll('[data-uc-video]')];
    const revealElements = [...root.querySelectorAll('[data-uc-reveal]')];

    if (!hero) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    let paused = false;
    let frame = null;
    let destroyed = false;

    const animations = new Set();
    const revealed = new Set();
    const videoStates = new Map();
    const playbackAttempts = new Map();

    function canAnimate() {
      return !paused && !reduced.matches;
    }

    function isVisible(video) {
      const bounds = video.getBoundingClientRect();

      return bounds.width > 0 &&
        bounds.height > 0 &&
        bounds.bottom > 0 &&
        bounds.top < window.innerHeight;
    }

    function shouldPlay(video) {
      return !destroyed &&
        canAnimate() &&
        isVisible(video) &&
        !document.hidden;
    }

    function isPlaying(video) {
      return !video.paused &&
        !video.ended &&
        video.dataset.ucPlayback === 'playing';
    }

    function updateButton() {
      if (!button || destroyed) return;

      const visibleVideos = videos.filter(isVisible);
      const playing = visibleVideos.some(isPlaying);

      const blocked = visibleVideos.some(
        video => video.dataset.ucPlayback === 'blocked'
      );

      const failed = visibleVideos.some(
        video => video.dataset.ucPlayback === 'failed'
      );

      const waiting = visibleVideos.some(
        video => playbackAttempts.has(video) ||
          video.dataset.ucPlayback === 'waiting'
      );

      button.hidden = reduced.matches;
      button.setAttribute('aria-pressed', String(paused));

      button.textContent = paused
        ? 'Play motion'
        : playing
          ? 'Pause motion'
          : failed
            ? 'Retry video'
            : blocked
              ? 'Play video'
              : waiting
                ? 'Loading video…'
                : visibleVideos.length
                  ? 'Play video'
                  : 'Pause motion';

      button.setAttribute(
        'aria-label',
        playing && !paused
          ? 'Video playing. Pause motion'
          : button.textContent
      );
    }

    function animateElement(element, index) {
      if (
        revealed.has(element) ||
        !canAnimate() ||
        !element.animate
      ) return;

      revealed.add(element);

      const animation = element.animate(
        [
          { opacity: 0, transform: 'translateY(22px)' },
          { opacity: 1, transform: 'translateY(0)' }
        ],
        {
          duration: 900,
          delay: Math.min(index, 4) * 80,
          easing: 'cubic-bezier(.16,1,.3,1)',
          fill: 'backwards'
        }
      );

      animations.add(animation);

      animation.finished
        .then(() => animations.delete(animation))
        .catch(() => animations.delete(animation));
    }

    function revealVisibleElements() {
      if (!canAnimate()) return;

      let index = 0;

      revealElements.forEach(element => {
        if (revealed.has(element)) return;

        const bounds = element.getBoundingClientRect();

        if (
          bounds.top < window.innerHeight * .98 &&
          bounds.bottom > 0
        ) {
          animateElement(element, index++);
        }
      });
    }

    function updateVideos(force, retryBlocked = false) {
      if (destroyed) return;

      videos.forEach(video => {
        const wanted = shouldPlay(video);
        const previous = videoStates.get(video);

        videoStates.set(video, wanted);

        video.autoplay =
          video.classList.contains('uc__hero-video') && wanted;

        if (!wanted) {
          video.pause();
          return;
        }

        if (!force && previous === wanted) return;
        if (playbackAttempts.has(video)) return;

        if (
          !retryBlocked &&
          /^(blocked|failed)$/.test(video.dataset.ucPlayback || '')
        ) return;

        video.muted = true;
        video.defaultMuted = true;
        video.loop = true;
        video.playsInline = true;

        video.setAttribute('muted', '');
        video.setAttribute('playsinline', '');
        video.setAttribute('webkit-playsinline', '');

        if (isPlaying(video)) return;

        if (
          retryBlocked &&
          video.dataset.ucPlayback === 'failed'
        ) {
          delete video.dataset.ucPlayback;
          video.load();
        }

        const attempt = {};

        playbackAttempts.set(video, attempt);
        video.dataset.ucPlayback = 'waiting';

        function failed(error) {
          if (
            destroyed ||
            playbackAttempts.get(video) !== attempt
          ) return;

          if (!shouldPlay(video)) return;

          video.dataset.ucPlayback =
            error.name === 'NotAllowedError'
              ? 'blocked'
              : error.name === 'AbortError'
                ? 'paused'
                : 'failed';

          if (error.name === 'AbortError') {
            videoStates.delete(video);
          }
        }

        function finished() {
          if (playbackAttempts.get(video) === attempt) {
            playbackAttempts.delete(video);
          }

          if (destroyed) return;

          updateButton();
          requestUpdate();
        }

        try {
          const result = video.play();

          Promise.resolve(result)
            .then(() => {
              if (
                destroyed ||
                playbackAttempts.get(video) !== attempt
              ) return;

              if (!shouldPlay(video)) {
                video.pause();
              } else if (!video.paused) {
                video.dataset.ucPlayback = 'playing';
              }
            })
            .catch(failed)
            .finally(finished);
        } catch (error) {
          failed(error);
          finished();
        }
      });

      updateButton();
    }

    function updateParallax() {
      if (!canAnimate()) {
        root.style.setProperty('--uc-video-y', '0px');
        root.style.setProperty('--uc-cloud-y', '0px');
        return;
      }

      const bounds = hero.getBoundingClientRect();
      const distance = Math.max(0, -bounds.top);
      const progress = Math.min(distance / 300, 1);
      const mobile = window.innerWidth <= 760;

      root.style.setProperty(
        '--uc-video-y',
        `${mobile ? 0 : Math.min(distance * .12, 60)}px`
      );

      root.style.setProperty(
        '--uc-cloud-y',
        `${-progress * (mobile ? 24 : 100)}px`
      );
    }

    function update() {
      frame = null;

      if (destroyed || !root.isConnected) return;

      updateParallax();
      revealVisibleElements();
      updateVideos(false);
    }

    function requestUpdate() {
      if (frame !== null || destroyed) return;
      frame = requestAnimationFrame(update);
    }

    function stopAnimations() {
      animations.forEach(animation => animation.cancel());
      animations.clear();
    }

    function syncMotion(forceVideo) {
      updateButton();

      if (!canAnimate()) stopAnimations();

      updateParallax();
      updateVideos(Boolean(forceVideo));
      requestUpdate();
    }

    button?.addEventListener('click', () => {
      const visibleVideos = videos.filter(isVisible);
      const playing = visibleVideos.some(isPlaying);

      if (paused || (visibleVideos.length && !playing)) {
        paused = false;
        revealed.clear();
        updateVideos(true, true);
      } else {
        paused = true;
      }

      syncMotion(true);
    }, { signal });

    function retryOnGesture(event) {
      if (
        !event.isTrusted ||
        !canAnimate() ||
        destroyed
      ) return;

      if (button?.contains(event.target)) return;

      if (
        event.type === 'keydown' &&
        !['Enter', ' '].includes(event.key)
      ) return;

      updateVideos(true, true);
    }

    root.addEventListener('pointerup', retryOnGesture, {
      passive: true,
      signal
    });

    root.addEventListener('keydown', retryOnGesture, { signal });

    window.addEventListener(
      'pageshow',
      () => syncMotion(true),
      { signal }
    );

    if (scrollLink && statement) {
      scrollLink.addEventListener('click', event => {
        event.preventDefault();

        statement.scrollIntoView({
          behavior: reduced.matches ? 'auto' : 'smooth',
          block: 'start'
        });
      }, { signal });
    }

    reduced.addEventListener(
      'change',
      () => syncMotion(true),
      { signal }
    );

    document.addEventListener(
      'visibilitychange',
      () => syncMotion(true),
      { signal }
    );

    document.addEventListener('scroll', requestUpdate, {
      passive: true,
      capture: true,
      signal
    });

    window.addEventListener('resize', requestUpdate, {
      passive: true,
      signal
    });

    videos.forEach(video => {
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;

      delete video.dataset.ucPlayback;

      ['loadedmetadata', 'loadeddata', 'canplay'].forEach(name => {
        video.addEventListener(
          name,
          () => updateVideos(true),
          { signal }
        );
      });

      video.addEventListener('playing', () => {
        if (!shouldPlay(video)) {
          video.pause();
          return;
        }

        video.dataset.ucPlayback = 'playing';
        updateButton();
      }, { signal });

      video.addEventListener('pause', () => {
        if (
          !/^(blocked|failed)$/.test(video.dataset.ucPlayback || '')
        ) {
          video.dataset.ucPlayback = 'paused';
        }

        updateButton();
      }, { signal });

      video.addEventListener('waiting', () => {
        if (
          !/^(blocked|failed)$/.test(video.dataset.ucPlayback || '')
        ) {
          video.dataset.ucPlayback = 'waiting';
        }

        updateButton();
      }, { signal });

      function mediaError() {
        video.dataset.ucPlayback = 'failed';
        updateButton();
      }

      video.addEventListener('error', mediaError, { signal });

      video.querySelectorAll('source').forEach(source => {
        source.addEventListener('error', mediaError, { signal });
      });
    });

    root.querySelectorAll('img').forEach(image => {
      image.addEventListener('load', requestUpdate, { signal });
    });

    let resizeObserver = null;

    if ('ResizeObserver' in window) {
      resizeObserver = new ResizeObserver(requestUpdate);
      resizeObserver.observe(root);
    }

    syncMotion(true);

    cleanup = function () {
      destroyed = true;
      events.abort();
      resizeObserver?.disconnect();

      if (frame !== null) cancelAnimationFrame(frame);

      stopAnimations();

      videos.forEach(video => {
        video.autoplay = false;
        video.pause();
      });
    };
  }

  document.addEventListener('shopify:section:load', event => {
    if (
      event.target.id === wrapperId ||
      event.target.querySelector('[id="' + rootId + '"]')
    ) {
      initialize();
    }
  }, { signal: lifecycle.signal });

  document.addEventListener('shopify:section:unload', event => {
    if (event.target.id === wrapperId) {
      if (cleanup) cleanup();
      cleanup = null;
    }
  }, { signal: lifecycle.signal });

  window[registryKey][rootId] = function () {
    lifecycle.abort();
    if (cleanup) cleanup();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize, {
      once: true,
      signal: lifecycle.signal
    });
  } else {
    initialize();
  }
})();
</script>

