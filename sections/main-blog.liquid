{% comment %} Blog index: uses global blog object, paginated article grid. {% endcomment %}
<section class="relative py-16 lg:py-24 overflow-hidden bg-black" {{ section.shopify_attributes }}>
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    {% if blog.title != blank %}
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-10">{{ blog.title }}</h1>
    {% endif %}

    {% paginate blog.articles by section.settings.articles_per_page %}
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-12">
        {% for article in blog.articles %}
          <article class="group">
            <a href="{{ article.url }}" class="block">
              <div class="relative aspect-[4/3] overflow-hidden mb-5">
                {% if article.image %}
                  <img
                    alt="{{ article.image.alt | default: article.title | escape }}"
                    class="absolute inset-0 w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-105"
                    src="{{ article.image | image_url: width: 800 }}"
                    width="800"
                    height="600"
                    loading="lazy"
                  >
                {% else %}
                  <div class="absolute inset-0 bg-white/5" aria-hidden="true"></div>
                {% endif %}
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity" aria-hidden="true"></div>
                {% if article.tags.first != blank %}
                  <div class="absolute top-4 left-4 px-3 py-1 bg-white/10 backdrop-blur-sm rounded-full">
                    <span class="text-xs text-white uppercase tracking-wider">{{ article.tags.first }}</span>
                  </div>
                {% endif %}
              </div>
              <span class="text-white/40 text-xs mb-2 block">
                {{ article.published_at | date: '%B %d, %Y' }}{% if article.content != blank %} • {{ article.content | strip_html | split: ' ' | size | divided_by: 200 | at_least: 1 }} min read{% endif %}
              </span>
              <h2 class="text-xl font-bold text-white mb-2 group-hover:text-white/90 transition-colors leading-tight">{{ article.title }}</h2>
              {% if article.excerpt != blank %}
                <p class="text-white/40 text-sm leading-relaxed main-blog-excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
              {% elsif article.content != blank %}
                <p class="text-white/40 text-sm leading-relaxed main-blog-excerpt">{{ article.content | strip_html | truncate: 120 }}</p>
              {% endif %}
            </a>
          </article>
        {% else %}
          <p class="md:col-span-2 lg:col-span-3 text-white/50 text-center py-12">No posts yet.</p>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <nav class="mt-12 flex justify-center gap-2" aria-label="Blog pagination">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-white/70 hover:bg-white/10">Previous</a>
          {% endif %}
          <span class="px-4 py-2 text-white/50 text-sm">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-white/70 hover:bg-white/10">Next</a>
          {% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

<style>
  .main-blog-excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "class": "section-main-blog",
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 9
    }
  ],
  "presets": [
    { "name": "Blog posts" }
  ]
}
{% endschema %}
