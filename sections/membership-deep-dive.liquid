{% comment %} Deep Dive: badge + heading + subtitle, stacked category cards with gradient tint, icon+title+subtitle, description, features grid, link, and 3 stat boxes. {% endcomment %}
{% assign dive_blocks = section.blocks | where: 'type', 'category' %}
<section class="relative py-24 lg:py-32 bg-black" {{ section.shopify_attributes }}>
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="text-center mb-16">
      {% if section.settings.badge != blank %}
        <span class="text-[10px] font-medium text-white/40 tracking-[0.3em] uppercase block mb-4">{{ section.settings.badge }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <p class="text-white/50 max-w-2xl mx-auto">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    {% for block in dive_blocks %}
      {% case block.settings.icon %}
        {% when 'workflow' %}
          {% assign card_bg = 'bg-gradient-to-br from-blue-500/5 to-cyan-500/5' %}
          {% assign card_border = 'border-blue-500/20' %}
          {% assign accent = 'text-blue-400' %}
          {% assign accent_hover = 'hover:text-blue-300' %}
          {% assign check_class = 'text-blue-400' %}
        {% when 'graduation_cap' %}
          {% assign card_bg = 'bg-gradient-to-br from-purple-500/5 to-pink-500/5' %}
          {% assign card_border = 'border-purple-500/20' %}
          {% assign accent = 'text-purple-400' %}
          {% assign accent_hover = 'hover:text-purple-300' %}
          {% assign check_class = 'text-purple-400' %}
        {% when 'bot' %}
          {% assign card_bg = 'bg-gradient-to-br from-emerald-500/5 to-teal-500/5' %}
          {% assign card_border = 'border-emerald-500/20' %}
          {% assign accent = 'text-emerald-400' %}
          {% assign accent_hover = 'hover:text-emerald-300' %}
          {% assign check_class = 'text-emerald-400' %}
        {% when 'panels_top_left' %}
          {% assign card_bg = 'bg-gradient-to-br from-amber-500/5 to-orange-500/5' %}
          {% assign card_border = 'border-amber-500/20' %}
          {% assign accent = 'text-amber-400' %}
          {% assign accent_hover = 'hover:text-amber-300' %}
          {% assign check_class = 'text-amber-400' %}
        {% else %}
          {% assign card_bg = 'bg-gradient-to-br from-blue-500/5 to-cyan-500/5' %}
          {% assign card_border = 'border-blue-500/20' %}
          {% assign accent = 'text-blue-400' %}
          {% assign accent_hover = 'hover:text-blue-300' %}
          {% assign check_class = 'text-blue-400' %}
      {% endcase %}

      <div class="p-8 rounded-3xl {{ card_bg }} border {{ card_border }} {% unless forloop.last %}mb-8{% endunless %}" {{ block.shopify_attributes }}>
        <div class="grid lg:grid-cols-2 gap-8">
          <div>
            <div class="flex items-center gap-3 mb-4">
              {% case block.settings.icon %}
                {% when 'workflow' %}
                  <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500 to-cyan-500 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white" aria-hidden="true"><rect width="8" height="8" x="3" y="3" rx="2"></rect><path d="M7 11v4a2 2 0 0 0 2 2h4"></path><rect width="8" height="8" x="13" y="13" rx="2"></rect></svg>
                  </div>
                {% when 'graduation_cap' %}
                  <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white" aria-hidden="true"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"></path><path d="M22 10v6"></path><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"></path></svg>
                  </div>
                {% when 'bot' %}
                  <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-500 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white" aria-hidden="true"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path></svg>
                  </div>
                {% when 'panels_top_left' %}
                  <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-500 to-orange-500 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M3 9h18"></path><path d="M9 21V9"></path></svg>
                  </div>
                {% else %}
                  <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500 to-cyan-500 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white" aria-hidden="true"><rect width="8" height="8" x="3" y="3" rx="2"></rect><path d="M7 11v4a2 2 0 0 0 2 2h4"></path><rect width="8" height="8" x="13" y="13" rx="2"></rect></svg>
                  </div>
              {% endcase %}
              <div>
                {% if block.settings.title != blank %}
                  <h3 class="text-2xl font-bold text-white">{{ block.settings.title }}</h3>
                {% endif %}
                {% if block.settings.subtitle != blank %}
                  <span class="{{ accent }} text-sm">{{ block.settings.subtitle }}</span>
                {% endif %}
              </div>
            </div>
            {% if block.settings.description != blank %}
              <p class="text-white/50 mb-6">{{ block.settings.description }}</p>
            {% endif %}
            {% if block.settings.features != blank %}
              {% assign feature_lines = block.settings.features | newline_to_br | split: '<br />' %}
              <div class="grid grid-cols-2 gap-4 mb-6">
                {% for line in feature_lines %}
                  {% assign line_stripped = line | strip %}
                  {% if line_stripped != '' %}
                    <div class="flex items-center gap-2 text-white/60 text-sm">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 {{ check_class }}" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
                      <span>{{ line_stripped }}</span>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
            {% assign link_url = block.settings.link_url | default: '#' %}
            {% assign link_text = block.settings.link_text | default: 'View all' %}
            <a href="{{ link_url }}" class="inline-flex items-center gap-2 {{ accent }} {{ accent_hover }} font-medium">
              {{ link_text }}
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </a>
          </div>
          <div class="grid grid-cols-3 gap-3">
            {% assign s1_color = 'text-white' %}
            {% if block.settings.stat1_color == 'accent' %}{% assign s1_color = accent %}{% endif %}
            {% if block.settings.stat1_color == 'emerald' %}{% assign s1_color = 'text-emerald-400' %}{% endif %}
            <div class="p-4 rounded-xl bg-white/5 text-center">
              <div class="text-3xl font-black {{ s1_color }}">{{ block.settings.stat1_value | default: '—' }}</div>
              <div class="text-white/40 text-xs">{{ block.settings.stat1_label | default: '' }}</div>
            </div>
            {% assign s2_color = 'text-white' %}
            {% if block.settings.stat2_color == 'accent' %}{% assign s2_color = accent %}{% endif %}
            {% if block.settings.stat2_color == 'emerald' %}{% assign s2_color = 'text-emerald-400' %}{% endif %}
            <div class="p-4 rounded-xl bg-white/5 text-center">
              <div class="text-3xl font-black {{ s2_color }}">{{ block.settings.stat2_value | default: '—' }}</div>
              <div class="text-white/40 text-xs">{{ block.settings.stat2_label | default: '' }}</div>
            </div>
            {% assign s3_color = 'text-white' %}
            {% if block.settings.stat3_color == 'accent' %}{% assign s3_color = accent %}{% endif %}
            {% if block.settings.stat3_color == 'emerald' %}{% assign s3_color = 'text-emerald-400' %}{% endif %}
            <div class="p-4 rounded-xl bg-white/5 text-center">
              <div class="text-3xl font-black {{ s3_color }}">{{ block.settings.stat3_value | default: '—' }}</div>
              <div class="text-white/40 text-xs">{{ block.settings.stat3_label | default: '' }}</div>
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Deep Dive",
  "tag": "section",
  "class": "section-membership-deep-dive",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "(Deep Dive)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything in Detail"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Each category is packed with premium assets designed to help you ship faster."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category block",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon & color theme",
          "options": [
            { "value": "workflow", "label": "Workflow (blue–cyan)" },
            { "value": "graduation_cap", "label": "Courses (purple–pink)" },
            { "value": "bot", "label": "AI / Bot (emerald–teal)" },
            { "value": "panels_top_left", "label": "Sections (amber–orange)" }
          ],
          "default": "workflow"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Automation Templates"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle (accent color)",
          "default": "8 templates • $99 each value"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "textarea",
          "id": "features",
          "label": "Features (one per line, 2-column grid)",
          "default": "Lead Generation\nSocial Media\nEmail Marketing\nContent Pipeline"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link text",
          "default": "View All Templates"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        },
        {
          "type": "header",
          "content": "Statistics (right column)"
        },
        {
          "type": "text",
          "id": "stat1_value",
          "label": "Stat 1 value",
          "default": "50+"
        },
        {
          "type": "text",
          "id": "stat1_label",
          "label": "Stat 1 label",
          "default": "Scenarios"
        },
        {
          "type": "select",
          "id": "stat1_color",
          "label": "Stat 1 value color",
          "options": [
            { "value": "accent", "label": "Accent (theme color)" },
            { "value": "white", "label": "White" },
            { "value": "emerald", "label": "Emerald" }
          ],
          "default": "accent"
        },
        {
          "type": "text",
          "id": "stat2_value",
          "label": "Stat 2 value",
          "default": "100"
        },
        {
          "type": "text",
          "id": "stat2_label",
          "label": "Stat 2 label",
          "default": "Hours Saved"
        },
        {
          "type": "select",
          "id": "stat2_color",
          "label": "Stat 2 value color",
          "options": [
            { "value": "accent", "label": "Accent" },
            { "value": "white", "label": "White" },
            { "value": "emerald", "label": "Emerald" }
          ],
          "default": "white"
        },
        {
          "type": "text",
          "id": "stat3_value",
          "label": "Stat 3 value",
          "default": "5m"
        },
        {
          "type": "text",
          "id": "stat3_label",
          "label": "Stat 3 label",
          "default": "Setup Time"
        },
        {
          "type": "select",
          "id": "stat3_color",
          "label": "Stat 3 value color",
          "options": [
            { "value": "accent", "label": "Accent" },
            { "value": "white", "label": "White" },
            { "value": "emerald", "label": "Emerald" }
          ],
          "default": "white"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Deep Dive",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "icon": "workflow",
            "title": "Automation Templates",
            "subtitle": "8 templates • $99 each value",
            "description": "Pre-built Make.com blueprints for common business workflows. Import, connect your apps, and start automating in minutes.",
            "features": "Lead Generation\nSocial Media\nEmail Marketing\nContent Pipeline",
            "link_text": "View All Templates",
            "link_url": "/shop/automation-templates",
            "stat1_value": "50+",
            "stat1_label": "Scenarios",
            "stat1_color": "accent",
            "stat2_value": "100",
            "stat2_label": "Hours Saved",
            "stat2_color": "white",
            "stat3_value": "5m",
            "stat3_label": "Setup Time",
            "stat3_color": "white"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "graduation_cap",
            "title": "Courses",
            "subtitle": "11 courses • Free & Premium",
            "description": "Practical, project-based courses teaching AI tools, content creation, and brand building. Learn skills you can apply immediately.",
            "features": "AI Image Generation\nPrompt Engineering\nVideo Production\nBrand Systems",
            "link_text": "View All Courses",
            "link_url": "/shop/courses",
            "stat1_value": "50+",
            "stat1_label": "Lessons",
            "stat1_color": "accent",
            "stat2_value": "15",
            "stat2_label": "Hours",
            "stat2_color": "white",
            "stat3_value": "FREE",
            "stat3_label": "Courses Avail.",
            "stat3_color": "emerald"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "bot",
            "title": "AI Agents",
            "subtitle": "10 agents • GPT-4 powered",
            "description": "Purpose-built AI assistants for specific tasks. Pre-trained with domain knowledge and optimized prompts for immediate deployment.",
            "features": "Customer Support\nSales Outreach\nSEO Strategy\nCourse Creation",
            "link_text": "View All Agents",
            "link_url": "/shop/ai-agents",
            "stat1_value": "10",
            "stat1_label": "Specialists",
            "stat1_color": "accent",
            "stat2_value": "24/7",
            "stat2_label": "Available",
            "stat2_color": "white",
            "stat3_value": "∞",
            "stat3_label": "Conversations",
            "stat3_color": "white"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "panels_top_left",
            "title": "Shopify Sections",
            "subtitle": "86 sections • No code required",
            "description": "Premium Shopify 2.0 sections for every store need. Drag, drop, and customize in the theme editor—zero coding required.",
            "features": "Hero Sections (25)\nCTA Sections (19)\nMedia Galleries (23)\nCollections (9)",
            "link_text": "View All Sections",
            "link_url": "/shop/shopify-sections",
            "stat1_value": "86",
            "stat1_label": "Sections",
            "stat1_color": "accent",
            "stat2_value": "5",
            "stat2_label": "Categories",
            "stat2_color": "white",
            "stat3_value": "100%",
            "stat3_label": "Customizable",
            "stat3_color": "white"
          }
        }
      ]
    }
  ]
}
{% endschema %}
