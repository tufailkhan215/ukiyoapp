{% comment %} Single order detail: line items, fulfillments, download links. Theme styling matches cart/account. {% endcomment %}
<section class="relative z-10 py-16 lg:py-24" {{ section.shopify_attributes }}>
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="mb-8">
      <a href="{{ routes.account_url }}" class="inline-flex items-center gap-2 text-white/60 hover:text-white text-sm font-medium mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        {{ section.settings.back_label | default: 'Back to account' }}
      </a>
      <h1 class="text-3xl md:text-4xl font-bold text-white">{{ section.settings.order_label | default: 'Order' }} {{ order.name }}</h1>
      <p class="text-white/50 mt-1">{{ order.created_at | date: format: 'date' }} · {{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</p>
    </div>

    <div class="grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-6">
        <h2 class="text-xl font-semibold text-white">{{ section.settings.items_heading | default: 'Items' }}</h2>
        <ul class="space-y-4">
          {% for line_item in order.line_items %}
            <li class="flex gap-4 p-4 rounded-2xl bg-white/[0.02] border border-white/10 items-center">
              {% if line_item.image %}
                <a href="{{ line_item.product.url }}" class="flex-shrink-0 w-20 h-20 rounded-lg overflow-hidden bg-white/5">
                  <img src="{{ line_item.image | image_url: width: 160 }}" alt="{{ line_item.title | escape }}" width="80" height="80" class="w-full h-full object-cover" loading="lazy">
                </a>
              {% endif %}
              <div class="flex-1 min-w-0">
                <a href="{{ line_item.product.url }}" class="text-white font-medium hover:underline">{{ line_item.product.title }}</a>
                {% if line_item.variant.title != blank and line_item.variant.title != 'Default Title' %}
                  <p class="text-white/40 text-sm mt-0.5">{{ line_item.variant.title }}</p>
                {% endif %}
                <p class="text-white/50 text-sm mt-1">{{ line_item.final_line_price | money }} × {{ line_item.quantity }}</p>
                {% if line_item.fulfillment %}
                  {% if line_item.fulfillment.tracking_url != blank %}
                    <a href="{{ line_item.fulfillment.tracking_url }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 mt-2 text-sm font-medium text-white/80 hover:text-white">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                      {{ section.settings.download_label | default: 'Download' }}
                    </a>
                  {% endif %}
                {% endif %}
              </div>
            </li>
          {% endfor %}
        </ul>
      </div>

      <div class="space-y-6">
        <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/10">
          <h2 class="text-lg font-semibold text-white mb-4">{{ section.settings.summary_heading | default: 'Summary' }}</h2>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between text-white/70"><span>Subtotal</span><span>{{ order.line_items_subtotal_price | money }}</span></div>
            {% for discount in order.discounts %}
              <div class="flex justify-between text-white/70"><span>{{ discount.code }}</span><span>-{{ discount.savings | money }}</span></div>
            {% endfor %}
            {% for shipping_method in order.shipping_methods %}
              <div class="flex justify-between text-white/70"><span>Shipping</span><span>{{ shipping_method.price | money }}</span></div>
            {% endfor %}
            {% if order.tax_price > 0 %}
              <div class="flex justify-between text-white/70"><span>Tax</span><span>{{ order.tax_price | money }}</span></div>
            {% endif %}
            <div class="flex justify-between text-white font-semibold pt-2 border-t border-white/10">
              <span>Total</span><span>{{ order.total_price | money }}</span>
            </div>
          </div>
        </div>
        {% if order.shipping_address %}
          <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/10">
            <h2 class="text-lg font-semibold text-white mb-4">{{ section.settings.shipping_heading | default: 'Shipping address' }}</h2>
            <address class="text-white/70 text-sm not-italic">
              {{ order.shipping_address | format_address }}
            </address>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer order",
  "tag": "section",
  "class": "section-main-customer-order",
  "settings": [
    { "type": "text", "id": "back_label", "label": "Back link", "default": "Back to account" },
    { "type": "text", "id": "order_label", "label": "Order heading prefix", "default": "Order" },
    { "type": "text", "id": "items_heading", "label": "Items heading", "default": "Items" },
    { "type": "text", "id": "download_label", "label": "Download link text", "default": "Download" },
    { "type": "text", "id": "summary_heading", "label": "Summary heading", "default": "Summary" },
    { "type": "text", "id": "shipping_heading", "label": "Shipping heading", "default": "Shipping address" }
  ],
  "presets": [{ "name": "Customer order" }]
}
{% endschema %}
