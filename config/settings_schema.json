[
  {
    "name": "theme_info",
    "theme_name": "Ukiyo",
    "theme_version": "1.0.0",
    "theme_author": "Ukiyo Productions",
    "theme_documentation_url": "https://github.com/tufailkhan215/ukiyoapp-emergent",
    "theme_support_url": "https://ukiyo-prod.com/"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "color_foreground",
        "label": "Text",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text",
        "default": "#999999"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "checkbox",
        "id": "use_google_fonts",
        "label": "Use Google Fonts (Inter, Space Grotesk, Playfair Display)",
        "default": true
      }
    ]
  },
  {
    "name": "Header",
    "settings": [
      {
        "type": "text",
        "id": "logo_text",
        "label": "Logo text",
        "default": "UKIYO"
      },
      {
        "type": "text",
        "id": "header_cta_text",
        "label": "Header CTA text",
        "default": "Start Your Project"
      },
      {
        "type": "url",
        "id": "header_cta_link",
        "label": "Header CTA link"
      }
    ]
  },
  {
    "name": "Product (Color & badge)",
    "settings": [
      {
        "type": "select",
        "id": "product_default_color_theme",
        "label": "Default color theme",
        "options": [
          { "value": "blue", "label": "Blue / Cyan" },
          { "value": "purple", "label": "Purple / Pink" },
          { "value": "emerald", "label": "Emerald / Teal" },
          { "value": "amber", "label": "Amber / Orange" }
        ],
        "default": "blue",
        "info": "Applied to all collection products. Overridden by collection or product metafield custom.color_theme."
      },
      {
        "type": "text",
        "id": "product_default_badge_label",
        "label": "Default badge label",
        "default": "Product",
        "info": "Shown on product image. Overridden by product type or product metafield custom.badge_label."
      },
      {
        "type": "select",
        "id": "product_badge_icon",
        "label": "Badge icon",
        "options": [
          { "value": "none", "label": "None" },
          { "value": "graduation_cap", "label": "Course" },
          { "value": "bot", "label": "AI Agent" },
          { "value": "layout", "label": "Section" },
          { "value": "workflow", "label": "Template" }
        ],
        "default": "none",
        "info": "Icon on product image badge."
      }
    ]
  }
]
