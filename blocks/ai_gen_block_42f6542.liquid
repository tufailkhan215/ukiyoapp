{% capture row_two_urls %}https://motionsites.ai/assets/hero-stellar-ai-preview-D3HL6bw1.gif|https://motionsites.ai/assets/hero-xportfolio-preview-D4A8maiC.gif|https://motionsites.ai/assets/hero-orbit-web3-preview-BXt4OttD.gif|https://motionsites.ai/assets/hero-nexora-preview-cx5HmUgo.gif|https://motionsites.ai/assets/hero-evr-ventures-preview-DZxeVFEX.gif|https://motionsites.ai/assets/hero-planet-orbit-preview-DWAP8Z1P.gif|https://motionsites.ai/assets/hero-new-era-preview-CocuDUm9.gif|https://motionsites.ai/assets/hero-wealth-preview-B70idl_u.gif|https://motionsites.ai/assets/hero-luminex-preview-CxOP7ce6.gif|https://motionsites.ai/assets/hero-celestia-preview-0yO3jXO8.gif{% endcapture %}
{% assign row_one = row_one_urls | strip | split: '|' %}
{% assign row_two = row_two_urls | strip | split: '|' %}

{% style %}
  .ai-image-marquee-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    background: {{ block.settings.background_color }};
    padding: 6rem 0 2.5rem;
    font-family: 'Kanit', sans-serif;
  }

  .ai-image-marquee-{{ ai_gen_id }} .ai-image-marquee__row-window {
    width: 100%;
    overflow: hidden;
  }

  .ai-image-marquee-{{ ai_gen_id }} .ai-image-marquee__row {
    display: flex;
    width: max-content;
    gap: 12px;
    will-change: transform;
  }

  .ai-image-marquee-{{ ai_gen_id }} .ai-image-marquee__row-window + .ai-image-marquee__row-window {
    margin-top: 12px;
  }

  .ai-image-marquee-{{ ai_gen_id }} .ai-image-marquee__card {
    display: block;
    flex: 0 0 420px;
    width: 420px;
    height: 270px;
    overflow: hidden;
    border-radius: 16px;
    background: #1c1c1c;
  }

  .ai-image-marquee-{{ ai_gen_id }} .ai-image-marquee__card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 749px) {
    .ai-image-marquee-{{ ai_gen_id }} {
      padding-top: 6rem;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .ai-image-marquee-{{ ai_gen_id }} {
      padding-top: 8rem;
    }
  }

  @media screen and (min-width: 990px) {
    .ai-image-marquee-{{ ai_gen_id }} {
      padding-top: 10rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-image-marquee-{{ ai_gen_id }} .ai-image-marquee__row {
      will-change: auto;
    }
  }
{% endstyle %}

<scroll-image-marquee-{{ ai_gen_id }} class="ai-image-marquee-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-marquee__row-window">
    <div class="ai-image-marquee__row" data-marquee-row="right">
      {% for copy in (1..3) %}
        {% for image_url in row_one %}
          <div class="ai-image-marquee__card"><img src="{{ image_url }}" alt="" loading="lazy" width="420" height="270"></div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
  <div class="ai-image-marquee__row-window">
    <div class="ai-image-marquee__row" data-marquee-row="left">
      {% for copy in (1..3) %}
        {% for image_url in row_two %}
          <div class="ai-image-marquee__card"><img src="{{ image_url }}" alt="" loading="lazy" width="420" height="270"></div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</scroll-image-marquee-{{ ai_gen_id }}>

<script>
  (function() {
    const tagName = 'scroll-image-marquee-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;

    class ScrollImageMarquee extends HTMLElement {
      connectedCallback() {
        this.rightRow = this.querySelector('[data-marquee-row="right"]');
        this.leftRow = this.querySelector('[data-marquee-row="left"]');
        this.handleScroll = this.handleScroll.bind(this);
        window.addEventListener('scroll', this.handleScroll, { passive: true });
        window.addEventListener('resize', this.handleScroll, { passive: true });
        this.handleScroll();
      }

      disconnectedCallback() {
        window.removeEventListener('scroll', this.handleScroll);
        window.removeEventListener('resize', this.handleScroll);
      }

      handleScroll() {
        const sectionTop = this.getBoundingClientRect().top + window.scrollY;
        const scrolled = window.scrollY - sectionTop + window.innerHeight;
        const offset = scrolled * 0.3 - 200;
        if (this.rightRow) this.rightRow.style.transform = `translateX(${offset}px)`;
        if (this.leftRow) this.leftRow.style.transform = `translateX(${-offset}px)`;
      }
    }

    customElements.define(tagName, ScrollImageMarquee);
  })();
</script>

