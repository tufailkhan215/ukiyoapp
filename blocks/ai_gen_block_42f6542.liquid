      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0C0C0C"
    }
  ],
  "presets": [
    {
      "name": "Scroll image marquee"
    }
  ],
  "tag": null,
  "class": "scroll-image-marquee-block"
}
{% endschema %}