<script>
(function() {
  'use strict';

  const root =
    document.getElementById(
      '{{ root_id }}'
    );


  if (
    !root ||
    root.dataset.marqueeReady === 'true'
  ) {
    return;
  }


  root.dataset.marqueeReady =
    'true';


  const rowOne =
    root.querySelector(
      '[data-track="row1"]'
    );


  const rowTwo =
    root.querySelector(
      '[data-track="row2"]'
    );


  const groupOne =
    root.querySelector(
      '[data-group="row1"]'
    );


  const groupTwo =
    root.querySelector(
      '[data-group="row2"]'
    );


  const reducedMotion =
    window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );


  const mobile =
    window.matchMedia(
      '(max-width: 749px)'
    );


  let sectionTop = 0;

  let widthOne = 1;
  let widthTwo = 1;

  let updateFrame = 0;
  let resizeFrame = 0;

  let visible = true;
  let destroyed = false;



  function readNumber(
    name,
    fallback
  ) {

    const value =
      Number(
        root.dataset[name]
      );


    return Number.isFinite(value)
      ? value
      : fallback;

  }



  function getGap(track) {

    if (!track) {
      return 0;
    }


    const styles =
      window.getComputedStyle(
        track
      );


    const value =
      parseFloat(
        styles.columnGap ||
        styles.gap ||
        '0'
      );


    return Number.isFinite(value)
      ? value
      : 0;

  }



  function positiveModulo(
    value,
    size
  ) {

    if (
      !size ||
      size <= 0
    ) {
      return 0;
    }


    return (
      (
        value %
        size
      ) +
      size
    ) % size;

  }



  function measure() {

    resizeFrame = 0;


    if (destroyed) {
      return;
    }


    const rect =
      root.getBoundingClientRect();


    sectionTop =
      rect.top +
      window.scrollY;


    if (
      rowOne &&
      groupOne
    ) {

      widthOne =
        groupOne
          .getBoundingClientRect()
          .width +
        getGap(rowOne);


      widthOne =
        Math.max(
          widthOne,
          1
        );

    }


    if (
      rowTwo &&
      groupTwo
    ) {

      widthTwo =
        groupTwo
          .getBoundingClientRect()
          .width +
        getGap(rowTwo);


      widthTwo =
        Math.max(
          widthTwo,
          1
        );

    }


    update();

  }



  function update() {

    updateFrame = 0;


    if (
      destroyed ||
      !visible
    ) {
      return;
    }


    const stagger =
      readNumber(
        'stagger',
        150
      );


    if (
      reducedMotion.matches ||
      root.dataset.motion === 'false'
    ) {

      if (rowOne) {

        rowOne.style.transform =
          'translate3d(' +
          (-widthOne - 70) +
          'px,0,0)';

      }


      if (rowTwo) {

        rowTwo.style.transform =
          'translate3d(-70px,0,0)';

      }


      return;

    }


    const speedOne =
      mobile.matches
        ? readNumber(
            'mobileSpeedOne',
            .13
          )
        : readNumber(
            'desktopSpeedOne',
            .28
          );


    const speedTwo =
      mobile.matches
        ? readNumber(
            'mobileSpeedTwo',
            .11
          )
        : readNumber(
            'desktopSpeedTwo',
            .22
          );


    const scrolled =
      Math.max(
        0,
        window.scrollY -
        sectionTop +
        window.innerHeight
      );


    if (rowOne) {

      const travelOne =
        positiveModulo(
          scrolled *
          speedOne,
          widthOne
        );


      const xOne =
        -widthOne -
        stagger +
        travelOne;


      rowOne.style.transform =
        'translate3d(' +
        xOne +
        'px,0,0)';

    }


    if (rowTwo) {

      const travelTwo =
        positiveModulo(
          scrolled *
          speedTwo,
          widthTwo
        );


      const xTwo =
        -stagger -
        travelTwo;


      rowTwo.style.transform =
        'translate3d(' +
        xTwo +
        'px,0,0)';

    }

  }



  function requestUpdate() {

    if (
      updateFrame ||
      destroyed
    ) {
      return;
    }


    updateFrame =
      window.requestAnimationFrame(
        update
      );

  }



  function requestMeasure() {

    if (
      resizeFrame ||
      destroyed
    ) {
      return;
    }


    resizeFrame =
      window.requestAnimationFrame(
        measure
      );

  }



  window.addEventListener(
    'scroll',
    requestUpdate,
    {
      passive:true
    }
  );


  window.addEventListener(
    'resize',
    requestMeasure,
    {
      passive:true
    }
  );



  let intersectionObserver =
    null;


  if (
    'IntersectionObserver' in window
  ) {

    intersectionObserver =
      new IntersectionObserver(
        function(entries) {

          entries.forEach(
            function(entry) {

              visible =
                entry.isIntersecting;


              if (visible) {
                requestUpdate();
              }

            }
          );

        },
        {
          root:null,

          rootMargin:
            '450px 0px',

          threshold:0
        }
      );


    intersectionObserver
      .observe(root);

  }



  let resizeObserver =
    null;


  if (
    'ResizeObserver' in window
  ) {

    resizeObserver =
      new ResizeObserver(
        requestMeasure
      );


    resizeObserver
      .observe(root);

  }



  function handleMediaChange() {

    requestMeasure();

  }



  if (
    reducedMotion.addEventListener
  ) {

    reducedMotion
      .addEventListener(
        'change',
        handleMediaChange
      );


    mobile
      .addEventListener(
        'change',
        handleMediaChange
      );

  } else {

    reducedMotion
      .addListener(
        handleMediaChange
      );


    mobile
      .addListener(
        handleMediaChange
      );

  }



  function destroy() {

    if (destroyed) {
      return;
    }


    destroyed = true;


    window.removeEventListener(
      'scroll',
      requestUpdate
    );


    window.removeEventListener(
      'resize',
      requestMeasure
    );


    if (
      reducedMotion.removeEventListener
    ) {

      reducedMotion
        .removeEventListener(
          'change',
          handleMediaChange
        );


      mobile
        .removeEventListener(
          'change',
          handleMediaChange
        );

    } else {

      reducedMotion
        .removeListener(
          handleMediaChange
        );


      mobile
        .removeListener(
          handleMediaChange
        );

    }


    if (intersectionObserver) {
      intersectionObserver.disconnect();
    }


    if (resizeObserver) {
      resizeObserver.disconnect();
    }


    if (updateFrame) {

      window.cancelAnimationFrame(
        updateFrame
      );

    }


    if (resizeFrame) {

      window.cancelAnimationFrame(
        resizeFrame
      );

    }

  }



  document.addEventListener(
    'shopify:block:unload',
    function unloadHandler(event) {

      if (
        event.target === root ||
        root.contains(event.target) ||
        event.target.contains(root)
      ) {

        destroy();


        document.removeEventListener(
          'shopify:block:unload',
          unloadHandler
        );

      }

    }
  );



  measure();


  window.requestAnimationFrame(
    requestMeasure
  );

})();
</script>



