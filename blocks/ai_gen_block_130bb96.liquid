{% doc %}
  @prompt
    Premium scroll-driven case study marquee.

    Theme-block-compatible version.
    Direct settings only.
    No local schema blocks.

    Two rows of editable case studies.
    Approximately five projects visible across desktop.
    Mobile uses large cards and slower movement.
{% enddoc %}

{%- liquid
  assign ai_gen_id = block.id | replace: '_', '' | replace: '-', '' | downcase
  assign root_id = 'CaseStudyMarquee-' | append: ai_gen_id
  assign cfg = block.settings

  assign row_numbers = '1,2,3,4,5,6,7,8' | split: ','

  assign row_1_count = 0
  assign row_2_count = 0

  for item_number in row_numbers
    assign show_key = 'r1_' | append: item_number | append: '_show'

    if cfg[show_key]
      assign row_1_count = row_1_count | plus: 1
    endif
  endfor

  for item_number in row_numbers
    assign show_key = 'r2_' | append: item_number | append: '_show'

    if cfg[show_key]
      assign row_2_count = row_2_count | plus: 1
    endif
  endfor

  assign total_projects = row_1_count | plus: row_2_count
-%}


<case-study-marquee-{{ ai_gen_id }}
  id="{{ root_id }}"
  class="csm-{{ ai_gen_id }}"
  data-motion="{{ cfg.enable_motion }}"
  data-desktop-speed-one="{{ cfg.desktop_speed_one | divided_by: 100.0 }}"
  data-desktop-speed-two="{{ cfg.desktop_speed_two | divided_by: 100.0 }}"
  data-mobile-speed-one="{{ cfg.mobile_speed_one | divided_by: 100.0 }}"
  data-mobile-speed-two="{{ cfg.mobile_speed_two | divided_by: 100.0 }}"
  data-stagger="{{ cfg.initial_offset }}"
  style="
    --csm-bg:{{ cfg.background_color }};
    --csm-card-bg:{{ cfg.card_background }};
    --csm-text:{{ cfg.text_color }};
    --csm-muted:{{ cfg.muted_color }};
    --csm-accent:{{ cfg.accent_color }};
    --csm-line:{{ cfg.line_color }};

    --csm-max:{{ cfg.max_width }}px;

    --csm-gap:{{ cfg.card_gap }}px;

    --csm-card-radius:{{ cfg.card_radius }}px;

    --csm-desktop-card-max:{{ cfg.desktop_card_width }}px;
    --csm-mobile-card-width:{{ cfg.mobile_card_width }}px;

    --csm-top:{{ cfg.padding_top }}px;
    --csm-bottom:{{ cfg.padding_bottom }}px;

    --csm-mobile-top:{{ cfg.mobile_padding_top }}px;
    --csm-mobile-bottom:{{ cfg.mobile_padding_bottom }}px;
  "
  {{ block.shopify_attributes }}
>


  {% comment %}
    ============================================================
    INTRO
    ============================================================
  {% endcomment %}

  {% if cfg.show_intro %}

    <header class="csm-{{ ai_gen_id }}__intro">

      <div class="csm-{{ ai_gen_id }}__intro-grid">

        <div>

          {% if cfg.eyebrow != blank %}

            <p class="csm-{{ ai_gen_id }}__eyebrow">

              <span aria-hidden="true"></span>

              {{ cfg.eyebrow | escape }}

            </p>

          {% endif %}


          {% if cfg.heading != blank %}

            <h2 class="csm-{{ ai_gen_id }}__heading">
              {{ cfg.heading | escape }}
            </h2>

          {% endif %}

        </div>


        <div class="csm-{{ ai_gen_id }}__intro-side">

          {% if cfg.description != blank %}

            <div class="csm-{{ ai_gen_id }}__description">
              {{ cfg.description }}
            </div>

          {% endif %}


          {% if cfg.show_project_count %}

            <div class="csm-{{ ai_gen_id }}__project-count">

              <strong>
                {{ total_projects }}
              </strong>

              <span>

                {% if total_projects == 1 %}
                  Case study
                {% else %}
                  Case studies
                {% endif %}

              </span>

            </div>

          {% endif %}

        </div>

      </div>


      <div class="csm-{{ ai_gen_id }}__intro-line">
        <span></span>
      </div>

    </header>

  {% endif %}



  {% comment %}
    ============================================================
    MARQUEE
    ============================================================
  {% endcomment %}

  <div class="csm-{{ ai_gen_id }}__stage">


    <div
      class="csm-{{ ai_gen_id }}__fade csm-{{ ai_gen_id }}__fade--left"
      aria-hidden="true"
    ></div>


    <div
      class="csm-{{ ai_gen_id }}__fade csm-{{ ai_gen_id }}__fade--right"
      aria-hidden="true"
    ></div>



    {% comment %}
      ==========================================================
      ROW ONE
      ==========================================================
    {% endcomment %}

    {% if row_1_count > 0 %}

      <div class="csm-{{ ai_gen_id }}__viewport">

        <div
          class="csm-{{ ai_gen_id }}__track"
          data-track="row1"
        >

          {% for duplicate in (1..2) %}

            <div
              class="csm-{{ ai_gen_id }}__group"
              data-group="row1"
              {% if duplicate == 2 %}
                aria-hidden="true"
              {% endif %}
            >

              {% for item_number in row_numbers %}

                {%- liquid
                  assign show_key = 'r1_' | append: item_number | append: '_show'
                  assign image_key = 'r1_' | append: item_number | append: '_image'
                  assign title_key = 'r1_' | append: item_number | append: '_title'
                  assign url_key = 'r1_' | append: item_number | append: '_url'

                  assign item_show = cfg[show_key]
                  assign item_image = cfg[image_key]
                  assign item_title = cfg[title_key]
                  assign item_url = cfg[url_key]
                -%}


                {% if item_show %}

                  {% if item_url != blank %}

                    <a
                      class="csm-{{ ai_gen_id }}__card"
                      href="{{ item_url }}"
                      aria-label="View {{ item_title | escape }}"
                      {% if duplicate == 2 %}
                        tabindex="-1"
                      {% endif %}
                    >

                  {% else %}

                    <div class="csm-{{ ai_gen_id }}__card">

                  {% endif %}


                    <div class="csm-{{ ai_gen_id }}__media">

                      {% if item_image != blank %}

                        {{
                          item_image
                          | image_url: width: 1200
                          | image_tag:
                            widths: '320,480,640,800,1000,1200',
                            sizes: '(max-width: 749px) 82vw, 20vw',
                            loading: 'lazy',
                            alt: item_title
                        }}

                      {% else %}

                        <div class="csm-{{ ai_gen_id }}__placeholder">
                          {{ 'image' | placeholder_svg_tag }}
                        </div>

                      {% endif %}


                      <span
                        class="csm-{{ ai_gen_id }}__shade"
                        aria-hidden="true"
                      ></span>


                      <span
                        class="csm-{{ ai_gen_id }}__frame"
                        aria-hidden="true"
                      ></span>


                      {% if cfg.show_card_copy %}

                        <div class="csm-{{ ai_gen_id }}__card-copy">

                          <div>

                            {% if cfg.card_label != blank %}

                              <span class="csm-{{ ai_gen_id }}__label">
                                {{ cfg.card_label | escape }}
                              </span>

                            {% endif %}


                            {% if item_title != blank %}

                              <h3>
                                {{ item_title | escape }}
                              </h3>

                            {% endif %}

                          </div>


                          {% if item_url != blank %}

                            <span class="csm-{{ ai_gen_id }}__view">

                              View case study

                              <svg
                                viewBox="0 0 24 24"
                                width="16"
                                height="16"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.7"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                              >
                                <path d="M5 12h14"/>
                                <path d="m13 6 6 6-6 6"/>
                              </svg>

                            </span>

                          {% endif %}

                        </div>

                      {% endif %}

                    </div>


                  {% if item_url != blank %}
                    </a>
                  {% else %}
                    </div>
                  {% endif %}

                {% endif %}

              {% endfor %}

            </div>

          {% endfor %}

        </div>

      </div>

    {% endif %}



    {% comment %}
      ==========================================================
      ROW TWO
      ==========================================================
    {% endcomment %}

    {% if row_2_count > 0 %}

      <div class="csm-{{ ai_gen_id }}__viewport">

        <div
          class="csm-{{ ai_gen_id }}__track"
          data-track="row2"
        >

          {% for duplicate in (1..2) %}

            <div
              class="csm-{{ ai_gen_id }}__group"
              data-group="row2"
              {% if duplicate == 2 %}
                aria-hidden="true"
              {% endif %}
            >

              {% for item_number in row_numbers %}

                {%- liquid
                  assign show_key = 'r2_' | append: item_number | append: '_show'
                  assign image_key = 'r2_' | append: item_number | append: '_image'
                  assign title_key = 'r2_' | append: item_number | append: '_title'
                  assign url_key = 'r2_' | append: item_number | append: '_url'

                  assign item_show = cfg[show_key]
                  assign item_image = cfg[image_key]
                  assign item_title = cfg[title_key]
                  assign item_url = cfg[url_key]
                -%}


                {% if item_show %}

                  {% if item_url != blank %}

                    <a
                      class="csm-{{ ai_gen_id }}__card"
                      href="{{ item_url }}"
                      aria-label="View {{ item_title | escape }}"
                      {% if duplicate == 2 %}
                        tabindex="-1"
                      {% endif %}
                    >

                  {% else %}

                    <div class="csm-{{ ai_gen_id }}__card">

                  {% endif %}


                    <div class="csm-{{ ai_gen_id }}__media">

                      {% if item_image != blank %}

                        {{
                          item_image
                          | image_url: width: 1200
                          | image_tag:
                            widths: '320,480,640,800,1000,1200',
                            sizes: '(max-width: 749px) 82vw, 20vw',
                            loading: 'lazy',
                            alt: item_title
                        }}

                      {% else %}

                        <div class="csm-{{ ai_gen_id }}__placeholder">
                          {{ 'image' | placeholder_svg_tag }}
                        </div>

                      {% endif %}


                      <span
                        class="csm-{{ ai_gen_id }}__shade"
                        aria-hidden="true"
                      ></span>


                      <span
                        class="csm-{{ ai_gen_id }}__frame"
                        aria-hidden="true"
                      ></span>


                      {% if cfg.show_card_copy %}

                        <div class="csm-{{ ai_gen_id }}__card-copy">

                          <div>

                            {% if cfg.card_label != blank %}

                              <span class="csm-{{ ai_gen_id }}__label">
                                {{ cfg.card_label | escape }}
                              </span>

                            {% endif %}


                            {% if item_title != blank %}

                              <h3>
                                {{ item_title | escape }}
                              </h3>

                            {% endif %}

                          </div>


                          {% if item_url != blank %}

                            <span class="csm-{{ ai_gen_id }}__view">

                              View case study

                              <svg
                                viewBox="0 0 24 24"
                                width="16"
                                height="16"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.7"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                              >
                                <path d="M5 12h14"/>
                                <path d="m13 6 6 6-6 6"/>
                              </svg>

                            </span>

                          {% endif %}

                        </div>

                      {% endif %}

                    </div>


                  {% if item_url != blank %}
                    </a>
                  {% else %}
                    </div>
                  {% endif %}

                {% endif %}

              {% endfor %}

            </div>

          {% endfor %}

        </div>

      </div>

    {% endif %}

  </div>



  {% comment %}
    ============================================================
    FOOTER
    ============================================================
  {% endcomment %}

  {% if cfg.show_footer %}

    <footer class="csm-{{ ai_gen_id }}__footer">

      <div class="csm-{{ ai_gen_id }}__footer-meta">

        <span>
          Selected work
        </span>

        <span>
          {{ total_projects }}
          {% if total_projects == 1 %}
            project
          {% else %}
            projects
          {% endif %}
        </span>

      </div>


      {% if cfg.archive_url != blank %}

        <a
          class="csm-{{ ai_gen_id }}__archive"
          href="{{ cfg.archive_url }}"
        >

          {{ cfg.archive_label | escape }}

          <svg
            viewBox="0 0 24 24"
            width="17"
            height="17"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"/>
            <path d="m13 6 6 6-6 6"/>
          </svg>

        </a>

      {% endif %}

    </footer>

  {% endif %}

</case-study-marquee-{{ ai_gen_id }}>



{% style %}

/* ============================================================
   ROOT
   ============================================================ */

#{{ root_id }} {
  display:block;

  position:relative;

  width:100%;
  max-width:100%;

  padding-top:var(--csm-top);
  padding-bottom:var(--csm-bottom);

  overflow:hidden;

  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(255,255,255,.045),
      transparent 34%
    ),
    var(--csm-bg);

  color:var(--csm-text);

  font-family:
    'Kanit',
    var(--font-body-family,Arial,sans-serif);

  isolation:isolate;
}


#{{ root_id }} *,
#{{ root_id }} *::before,
#{{ root_id }} *::after {
  box-sizing:border-box;

  min-width:0;
}


#{{ root_id }} a {
  color:inherit;

  text-decoration:none;
}


#{{ root_id }} img {
  display:block;

  max-width:100%;
}


#{{ root_id }} :where(h2,h3,p) {
  margin:0;
}


#{{ root_id }} a:focus-visible {
  outline:
    2px solid
    var(--csm-accent);

  outline-offset:4px;
}



/* ============================================================
   INTRO
   ============================================================ */

#{{ root_id }} .csm-{{ ai_gen_id }}__intro {
  width:100%;
  max-width:var(--csm-max);

  margin:
    0 auto
    clamp(
      42px,
      5vw,
      72px
    );

  padding-inline:
    clamp(
      22px,
      4vw,
      56px
    );
}


#{{ root_id }} .csm-{{ ai_gen_id }}__intro-grid {
  display:grid;

  grid-template-columns:
    minmax(0,1fr)
    minmax(320px,.8fr);

  align-items:end;

  gap:
    clamp(
      34px,
      6vw,
      90px
    );
}


#{{ root_id }} .csm-{{ ai_gen_id }}__eyebrow {
  display:flex;

  align-items:center;

  gap:10px;

  margin-bottom:17px;

  color:var(--csm-muted);

  font-size:10px;

  font-weight:500;

  letter-spacing:.18em;

  text-transform:uppercase;
}


#{{ root_id }} .csm-{{ ai_gen_id }}__eyebrow > span {
  width:6px;
  height:6px;

  border-radius:50%;

  background:
    var(--csm-accent);
}


#{{ root_id }} .csm-{{ ai_gen_id }}__heading {
  max-width:12ch;

  color:var(--csm-text);

  font-size:
    clamp(
      45px,
      6.4vw,
      94px
    );

  font-weight:400;

  line-height:.92;

  letter-spacing:-.045em;

  text-wrap:balance;
}


#{{ root_id }} .csm-{{ ai_gen_id }}__intro-side {
  display:grid;

  grid-template-columns:
    minmax(0,1fr)
    auto;

  align-items:end;

  gap:32px;
}


#{{ root_id }} .csm-{{ ai_gen_id }}__description {
  max-width:520px;

  color:var(--csm-muted);

  font-size:14px;

  font-weight:300;

  line-height:1.75;
}


#{{ root_id }} .csm-{{ ai_gen_id }}__description p+p {
  margin-top:12px;
}


#{{ root_id }} .csm-{{ ai_gen_id }}__project-count {
  display:flex;

  flex-direction:column;

  align-items:flex-end;

  flex:none;
}


#{{ root_id }} .csm-{{ ai_gen_id }}__project-count strong {
  color:var(--csm-text);

  font-size:36px;

  font-weight:400;

  line-height:1;

  font-variant-numeric:
    tabular-nums;
}


#{{ root_id }} .csm-{{ ai_gen_id }}__project-count span {
  margin-top:8px;

  color:var(--csm-muted);

  font-size:9px;

  letter-spacing:.12em;

  text-transform:uppercase;
}


#{{ root_id }} .csm-{{ ai_gen_id }}__intro-line {
  height:1px;

  margin-top:30px;

  background:
    var(--csm-line);
}


#{{ root_id }} .csm-{{ ai_gen_id }}__intro-line span {
  display:block;

  width:60px;
  height:1px;

  background:
    var(--csm-accent);
}



/* ============================================================
   MARQUEE STAGE
   ============================================================ */

#{{ root_id }} .csm-{{ ai_gen_id }}__stage {
  position:relative;

  width:100%;

  overflow:hidden;
}


#{{ root_id }} .csm-{{ ai_gen_id }}__viewport {
  width:100%;

  overflow:hidden;
}


#{{ root_id }} .csm-{{ ai_gen_id }}__viewport + .csm-{{ ai_gen_id }}__viewport {
  margin-top:
    var(--csm-gap);
}


#{{ root_id }} .csm-{{ ai_gen_id }}__track {
  display:flex;

  width:max-content;

  gap:var(--csm-gap);

  will-change:transform;

  transform:
    translate3d(0,0,0);

  backface-visibility:hidden;
}


#{{ root_id }} .csm-{{ ai_gen_id }}__group {
  display:flex;

  flex:none;

  width:max-content;

  gap:var(--csm-gap);
}



/* ============================================================
   CASE STUDY CARDS
   ============================================================ */

#{{ root_id }} .csm-{{ ai_gen_id }}__card {
  display:block;

  flex:
    0 0
    var(--csm-card-width);

  width:
    var(--csm-card-width);

  aspect-ratio:
    14 / 9;

  overflow:hidden;

  border-radius:
    var(--csm-card-radius);

  background:
    var(--csm-card-bg);

  box-shadow:
    0 20px 65px
    rgba(0,0,0,.28);

  transform:
    translateZ(0);
}


#{{ root_id }} .csm-{{ ai_gen_id }}__media {
  position:relative;

  display:block;

  width:100%;
  height:100%;

  overflow:hidden;

  border-radius:inherit;

  background:#141414;
}


#{{ root_id }} .csm-{{ ai_gen_id }}__media > img {
  position:absolute;

  inset:0;

  width:100%;
  height:100%;

  object-fit:cover;

  transform:
    scale(1.012);

  transition:
    transform .8s
      cubic-bezier(.2,.7,.2,1),
    filter .5s ease;
}


#{{ root_id }} .csm-{{ ai_gen_id }}__placeholder,
#{{ root_id }} .csm-{{ ai_gen_id }}__placeholder svg {
  width:100%;
  height:100%;
}


#{{ root_id }} .csm-{{ ai_gen_id }}__placeholder {
  color:#555;
}


#{{ root_id }} .csm-{{ ai_gen_id }}__shade {
  position:absolute;

  inset:0;

  z-index:2;

  background:
    linear-gradient(
      to top,
      rgba(0,0,0,.74),
      rgba(0,0,0,.04) 58%
    );

  opacity:.45;

  transition:
    opacity .4s ease;

  pointer-events:none;
}


#{{ root_id }} .csm-{{ ai_gen_id }}__frame {
  position:absolute;

  inset:9px;

  z-index:3;

  border:
    1px solid
    rgba(255,255,255,.12);

  border-radius:
    max(
      4px,
      calc(
        var(--csm-card-radius)
        - 7px
      )
    );

  pointer-events:none;

  transition:
    inset .35s ease,
    border-color .35s ease;
}



/* ============================================================
   CARD COPY
   ============================================================ */

#{{ root_id }} .csm-{{ ai_gen_id }}__card-copy {
  position:absolute;

  left:22px;
  right:22px;
  bottom:19px;

  z-index:4;

  display:grid;

  grid-template-columns:
    minmax(0,1fr)
    auto;

  align-items:end;

  gap:18px;

  pointer-events:none;
}


#{{ root_id }} .csm-{{ ai_gen_id }}__label {
  display:block;

  margin-bottom:6px;

  color:
    rgba(255,255,255,.6);

  font-size:8px;

  font-weight:500;

  letter-spacing:.15em;

  text-transform:uppercase;
}


#{{ root_id }} .csm-{{ ai_gen_id }}__card-copy h3 {
  max-width:20ch;

  color:#fff;

  font-size:17px;

  font-weight:500;

  line-height:1.15;

  letter-spacing:-.015em;
}


#{{ root_id }} .csm-{{ ai_gen_id }}__view {
  display:flex;

  align-items:center;

  gap:8px;

  color:
    rgba(255,255,255,.8);

  font-size:9px;

  font-weight:500;

  letter-spacing:.08em;

  text-transform:uppercase;

  opacity:0;

  transform:
    translateY(6px);

  transition:
    opacity .3s ease,
    transform .3s ease;
}



/* ============================================================
   HOVER
   ============================================================ */

@media (hover:hover) and (pointer:fine) {

  #{{ root_id }} .csm-{{ ai_gen_id }}__card:hover .csm-{{ ai_gen_id }}__media > img {
    transform:
      scale(1.05);
  }


  #{{ root_id }} .csm-{{ ai_gen_id }}__card:hover .csm-{{ ai_gen_id }}__shade {
    opacity:.8;
  }


  #{{ root_id }} .csm-{{ ai_gen_id }}__card:hover .csm-{{ ai_gen_id }}__frame {
    inset:6px;

    border-color:
      rgba(255,255,255,.25);
  }


  #{{ root_id }} .csm-{{ ai_gen_id }}__card:hover .csm-{{ ai_gen_id }}__view {
    opacity:1;

    transform:
      translateY(0);
  }

}



/* ============================================================
   EDGE FADES
   ============================================================ */

#{{ root_id }} .csm-{{ ai_gen_id }}__fade {
  position:absolute;

  top:0;
  bottom:0;

  z-index:10;

  width:
    clamp(
      28px,
      5vw,
      100px
    );

  pointer-events:none;
}


#{{ root_id }} .csm-{{ ai_gen_id }}__fade--left {
  left:0;

  background:
    linear-gradient(
      to right,
      var(--csm-bg),
      transparent
    );
}


#{{ root_id }} .csm-{{ ai_gen_id }}__fade--right {
  right:0;

  background:
    linear-gradient(
      to left,
      var(--csm-bg),
      transparent
    );
}



/* ============================================================
   FOOTER
   ============================================================ */

#{{ root_id }} .csm-{{ ai_gen_id }}__footer {
  display:flex;

  align-items:center;
  justify-content:space-between;

  gap:24px;

  width:100%;
  max-width:var(--csm-max);

  margin:
    clamp(
      38px,
      5vw,
      68px
    )
    auto
    0;

  padding:
    20px
    clamp(
      22px,
      4vw,
      56px
    )
    0;

  border-top:
    1px solid
    var(--csm-line);
}


#{{ root_id }} .csm-{{ ai_gen_id }}__footer-meta {
  display:flex;

  gap:18px;

  color:var(--csm-muted);

  font-size:9px;

  letter-spacing:.1em;

  text-transform:uppercase;
}


