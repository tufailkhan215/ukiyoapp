{%- comment -%}
  CASE STUDY GRID
  Single-file theme block. No local child blocks.
  Desktop: 5 columns, automatic rows, no duplicated projects.
  Mobile: readable cards, search and optional progressive reveal.

  The original r1_* and r2_* setting IDs are retained.
  Their old row assignment is no longer used.
  Entries flow into one grid in setting order.
{%- endcomment -%}

{%- liquid
  assign owner = section

  if block != blank and block.id != blank
    assign owner = block
  endif

  assign cfg = owner.settings
  assign uid = section.id | append: '-' | append: owner.id | handleize
  assign root_id = 'CaseStudyGrid-' | append: uid

  assign project_keys = 'r1_1,r1_2,r1_3,r1_4,r1_5,r1_6,r1_7,r1_8,r2_1,r2_2,r2_3,r2_4,r2_5,r2_6,r2_7,r2_8,cs_17,cs_18,cs_19,cs_20,cs_21,cs_22,cs_23,cs_24,cs_25,cs_26,cs_27,cs_28,cs_29,cs_30,cs_31,cs_32,cs_33,cs_34,cs_35,cs_36,cs_37,cs_38,cs_39,cs_40' | split: ','

  assign project_count = 0

  for key in project_keys
    assign show_key = key | append: '_show'
    assign image_key = key | append: '_image'

    if cfg[show_key] != false and cfg[image_key] != blank
      assign project_count = project_count | plus: 1
    endif
  endfor

  assign gallery_heading = cfg.heading | default: 'Selected work.'
  assign mobile_columns = cfg.mobile_columns | default: '2'
-%}

{%- capture image_sizes -%}
  (min-width: {{ cfg.max_width }}px) {{ cfg.max_width | divided_by: 5 }}px,
  (min-width: 1024px) 20vw,
  (min-width: 768px) 33vw,
  {% if mobile_columns == '1' %}
    100vw
  {% else %}
    (max-width: 359px) 100vw, 50vw
  {% endif %}
{%- endcapture -%}

{%- capture arrow -%}
<svg
  viewBox="0 0 24 24"
  width="18"
  height="18"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d="M7 17 17 7M7 7h10v10"/>
</svg>
{%- endcapture -%}

<case-study-grid-v1
  id="{{ root_id }}"
  class="pg"
  data-page-size="{{ cfg.mobile_batch | default: 6 }}"
  data-mobile-paging="{{ cfg.mobile_load_more }}"
  data-hover-motion="{{ cfg.enable_motion }}"
  style="
    --pg-bg:{{ cfg.background_color | default: '#0C0C0C' }};
    --pg-card:{{ cfg.card_background | default: '#141414' }};
    --pg-text:{{ cfg.text_color | default: '#F5F5F2' }};
    --pg-muted:{{ cfg.muted_color | default: '#AAA9A3' }};
    --pg-accent:{{ cfg.accent_color | default: '#E8DDCA' }};
    --pg-line:{{ cfg.line_color | default: '#30302E' }};
    --pg-max:{{ cfg.max_width | default: 1440 }}px;
    --pg-gutter:{{ cfg.desktop_gutter | default: 32 }}px;
    --pg-mobile-gutter:{{ cfg.mobile_gutter | default: 16 }}px;
    --pg-gap:{{ cfg.card_gap | default: 18 }}px;
    --pg-radius:{{ cfg.card_radius | default: 12 }}px;
    --pg-top:{{ cfg.padding_top | default: 60 }}px;
    --pg-bottom:{{ cfg.padding_bottom | default: 60 }}px;
    --pg-mobile-top:{{ cfg.mobile_padding_top | default: 40 }}px;
    --pg-mobile-bottom:{{ cfg.mobile_padding_bottom | default: 40 }}px;
    --pg-mobile-cols:{{ mobile_columns }};
    --pg-fit:{{ cfg.image_fit | default: 'cover' }};
    --pg-ratio:{{ cfg.image_ratio | default: '4 / 3' }};
  "
  {{ block.shopify_attributes }}
>
  <div class="pg-shell">

    {% comment %}
      ============================================================
      INTRODUCTION
      ============================================================
    {% endcomment %}

    {% if cfg.show_intro != false %}
      <header class="pg-header">

        <div class="pg-heading-group">
          {% if cfg.eyebrow != blank %}
            <p class="pg-eyebrow">
              <span aria-hidden="true"></span>
              {{ cfg.eyebrow | escape }}
            </p>
          {% endif %}

          <h2>{{ gallery_heading | escape }}</h2>
        </div>

        <div class="pg-header-aside">

          {% if cfg.description != blank %}
            <div class="pg-description">
              {{ cfg.description }}
            </div>
          {% endif %}

          {% if cfg.show_project_count != false %}
            <div class="pg-total">
              <strong>{{ project_count }}</strong>

              <span>
                {% if project_count == 1 %}
                  Case study
                {% else %}
                  Case studies
                {% endif %}
              </span>
            </div>
          {% endif %}

        </div>
      </header>
    {% endif %}

    {% if request.design_mode %}
      <p class="pg-editor-note">
        Each enabled entry with an image appears once. Desktop rows fill
        automatically with five cards. Edit Case study 01–40 below.
        The first 16 entries retain your previous image, title and link settings.
      </p>
    {% endif %}

    {% if project_count > 0 %}

      {% comment %}
        ==========================================================
        SEARCH AND RESULT COUNT
        ==========================================================
      {% endcomment %}

      <div class="pg-toolbar">

        <p
          class="pg-results"
          data-results
          role="status"
          aria-live="polite"
          aria-atomic="true"
        >
          {{ project_count }}
          {% if project_count == 1 %}
            project
          {% else %}
            projects
          {% endif %}
        </p>

        {% if cfg.show_search != false %}
          <div class="pg-search" data-search-ui hidden>

            <label
              class="pg-sr"
              for="{{ root_id }}-search"
            >
              Search case studies
            </label>

            <svg
              viewBox="0 0 24 24"
              width="19"
              height="19"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
            >
              <circle cx="10.5" cy="10.5" r="6.5"/>
              <path d="m16 16 5 5"/>
            </svg>

            <input
              id="{{ root_id }}-search"
              type="search"
              placeholder="Search projects"
              autocomplete="off"
              aria-controls="{{ root_id }}-grid"
              data-search
            >

            <button
              type="button"
              class="pg-clear"
              data-clear
              aria-label="Clear search"
              hidden
            >
              Clear
            </button>

          </div>
        {% endif %}

      </div>

      {% comment %}
        ==========================================================
        ONE GRID — AUTOMATIC ROWS OF FIVE ON DESKTOP
        ==========================================================
      {% endcomment %}

      <ul
        id="{{ root_id }}-grid"
        class="pg-grid"
        role="list"
        aria-label="Case studies"
      >
        {% assign display_number = 0 %}

        {% for key in project_keys %}
          {%- liquid
            assign show_key = key | append: '_show'
            assign image_key = key | append: '_image'
            assign title_key = key | append: '_title'
            assign url_key = key | append: '_url'

            assign project_image = cfg[image_key]

            if cfg[show_key] == false or project_image == blank
              continue
            endif

            assign display_number = display_number | plus: 1
            assign project_title = cfg[title_key]

            if project_title == blank
              assign project_title = 'Case study ' | append: display_number
            endif

            assign project_url = cfg[url_key]
            assign project_alt = project_image.alt | default: project_title
          -%}

          {%- capture card_content -%}

            <div class="pg-media">

              {{
                project_image
                | image_url: width: 1200
                | image_tag:
                  widths: '240,360,480,640,800,1000,1200',
                  sizes: image_sizes,
                  loading: 'lazy',
                  decoding: 'async',
                  alt: project_alt,
                  class: 'pg-image'
              }}

              <span
                class="pg-media-frame"
                aria-hidden="true"
              ></span>

              {% if cfg.show_numbers %}
                <span class="pg-number" aria-hidden="true">
                  {% if display_number < 10 %}0{% endif %}{{ display_number }}
                </span>
              {% endif %}

              {% if project_url != blank %}
                <span class="pg-image-arrow" aria-hidden="true">
                  {{ arrow }}
                </span>
              {% endif %}

            </div>

            {% if cfg.show_card_copy != false %}
              <div class="pg-card-body">

                {% if cfg.card_label != blank %}
                  <p class="pg-card-label">
                    {{ cfg.card_label | escape }}
                  </p>
                {% endif %}

                <h3>{{ project_title | escape }}</h3>

                {% if project_url != blank %}
                  <span class="pg-card-cta" aria-hidden="true">
                    {{ cfg.card_cta | default: 'View case study' | escape }}
                    {{ arrow }}
                  </span>
                {% endif %}

              </div>
            {% endif %}

          {%- endcapture -%}

          <li
            class="pg-item"
            data-case
            data-search-text="{{ project_title | escape }}"
            tabindex="-1"
          >

            {% if project_url != blank %}

              <a
                class="pg-card"
                href="{{ project_url | escape }}"
                aria-label="View case study: {{ project_title | escape }}"
              >
                {{ card_content }}
              </a>

            {% else %}

              <article class="pg-card">
                {{ card_content }}
              </article>

            {% endif %}

          </li>

        {% endfor %}
      </ul>

      <div class="pg-no-results" data-no-results hidden>
        <h3>No matching projects.</h3>
        <p>Try a different name, or clear the search.</p>
      </div>

      {% comment %}
        ==========================================================
        MOBILE SHOW MORE
        Desktop always shows the complete grid.
        ==========================================================
      {% endcomment %}

      <div class="pg-load" data-load-ui hidden>

        <p data-load-status></p>

        <div class="pg-load-actions">

          <button
            type="button"
            class="pg-button"
            data-load-more
            aria-controls="{{ root_id }}-grid"
          >
            Show more case studies
          </button>

          <button
            type="button"
            class="pg-text-button"
            data-show-all
            aria-controls="{{ root_id }}-grid"
          >
            Show all
          </button>

        </div>
      </div>

    {% elsif request.design_mode %}

      <div class="pg-empty">

        <span class="pg-eyebrow">
          Your work goes here
        </span>

        <h3>Add your first case study.</h3>

        <p>
          Upload its image, enter a title, add its page link and leave
          “Show this case study” enabled. Empty entries do not appear
          on the storefront.
        </p>

      </div>

    {% endif %}

    {% comment %}
      ============================================================
      FOOTER
      ============================================================
    {% endcomment %}

    {% if cfg.show_footer != false %}
      <footer class="pg-footer">

        <p>
          {{ cfg.footer_text | default: 'Explore the work. See the details.' | escape }}
        </p>

        {% if cfg.archive_url != blank %}
          <a
            class="pg-archive"
            href="{{ cfg.archive_url | escape }}"
          >
            {{ cfg.archive_label | default: 'View all case studies' | escape }}
            {{ arrow }}
          </a>
        {% endif %}

      </footer>
    {% endif %}

  </div>
</case-study-grid-v1>

{% style %}

/* ============================================================
   FOUNDATION
   Scoped to this gallery.
   No marquee tracks or page scroll handlers.
   ============================================================ */

#{{ root_id }} {
  display:block;
  position:relative;
  isolation:isolate;
  width:100%;
  max-width:100%;
  min-width:0;

  padding-block:var(--pg-top) var(--pg-bottom);

  background:var(--pg-bg);
  color:var(--pg-text);

  font-family:
    'Kanit',
    var(--font-body-family,Arial,sans-serif);

  -webkit-font-smoothing:antialiased;
}

#{{ root_id }} *,
#{{ root_id }} *::before,
#{{ root_id }} *::after {
  box-sizing:border-box;
  min-width:0;
}

#{{ root_id }} [hidden] {
  display:none!important;
}

#{{ root_id }} :where(h2,h3,p,figure) {
  margin:0;
}

#{{ root_id }} :where(h2,h3,p,a,label) {
  overflow-wrap:anywhere;
}

#{{ root_id }} :where(h2,h3) {
  color:var(--pg-text);
  text-transform:none;
}

#{{ root_id }} a {
  color:inherit;
  text-decoration:none;
}

#{{ root_id }} :where(button,input) {
  font:inherit;
}

#{{ root_id }} button {
  cursor:pointer;
}

#{{ root_id }} svg {
  display:block;
  flex:none;
}

#{{ root_id }} :where(a,button,input,[tabindex]):focus-visible {
  outline:2px solid var(--pg-accent);
  outline-offset:4px;
}

#{{ root_id }} .pg-sr {
  position:absolute;
  width:1px;
  height:1px;
  padding:0;
  overflow:hidden;
  clip-path:inset(50%);
  white-space:nowrap;
}

#{{ root_id }} .pg-shell {
  width:100%;
  max-width:var(--pg-max);
  margin-inline:auto;
  padding-inline:var(--pg-gutter);
}


/* ============================================================
   EDITORIAL HEADING
   ============================================================ */

#{{ root_id }} .pg-header {
  display:grid;

  grid-template-columns:
    minmax(0,1fr)
    minmax(0,.8fr);

  align-items:end;
  gap:40px;

  padding-bottom:32px;
  border-bottom:1px solid var(--pg-line);
}

#{{ root_id }} .pg-eyebrow {
  display:flex;
  align-items:center;
  gap:10px;

  color:var(--pg-muted);

  font-size:11px;
  font-weight:500;
  letter-spacing:.14em;
  text-transform:uppercase;
  line-height:1.5;
}

#{{ root_id }} .pg-eyebrow > span {
  width:6px;
  height:6px;
  flex:none;

  border-radius:50%;
  background:var(--pg-accent);
}

#{{ root_id }} .pg-heading-group h2 {
  max-width:15ch;
  margin-top:14px;

  font-family:inherit;
  font-size:clamp(36px,4.9vw,76px);
  font-weight:400;
  line-height:1.02;
  letter-spacing:-.045em;

  text-wrap:balance;
}

#{{ root_id }} .pg-header-aside {
  display:flex;
  align-items:end;
  justify-content:space-between;
  gap:28px;
}

#{{ root_id }} .pg-description {
  max-width:46ch;

  font-size:15px;
  line-height:1.7;

  color:var(--pg-muted);
}

#{{ root_id }} .pg-description p+p {
  margin-top:12px;
}

#{{ root_id }} .pg-description a {
  text-decoration:underline;
  text-underline-offset:4px;
}

#{{ root_id }} .pg-total {
  flex:none;
  text-align:right;
}

#{{ root_id }} .pg-total strong {
  display:block;

  font-size:42px;
  font-weight:400;
  line-height:1;
  font-variant-numeric:tabular-nums;
}

#{{ root_id }} .pg-total span {
  display:block;
  margin-top:8px;

  font-size:11px;
  color:var(--pg-muted);
}

#{{ root_id }} .pg-editor-note {
  padding:14px 16px;
  margin-block:16px;

  border:1px dashed var(--pg-line);

  font-size:12px;
  line-height:1.6;
  color:var(--pg-muted);
}


/* ============================================================
   SEARCH AND RESULT COUNT
   ============================================================ */

#{{ root_id }} .pg-toolbar {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;

  padding-block:24px;
}

#{{ root_id }} .pg-results {
  color:var(--pg-muted);
  font-size:13px;
}

#{{ root_id }} .pg-search {
  display:flex;
  align-items:center;
  gap:10px;

  width:min(100%,340px);
  min-height:48px;

  padding:0 8px 0 14px;

  border:1px solid var(--pg-line);
  border-radius:8px;

  background:var(--pg-card);
  color:var(--pg-muted);
}

#{{ root_id }} .pg-search input {
  display:block;
  width:100%;
  min-height:46px;

  padding:10px 0;

  border:0;
  border-radius:0;

  background:transparent;
  color:var(--pg-text);

  font-size:16px;
}

#{{ root_id }} .pg-search input::placeholder {
  color:var(--pg-muted);
  opacity:1;
}

#{{ root_id }} .pg-clear {
  flex:none;
  min-height:44px;

  padding:8px;

  border:0;
  background:transparent;

  color:var(--pg-text);
  font-size:12px;
}


/* ============================================================
   EXACTLY FIVE COLUMNS ON DESKTOP
   Rows are created automatically.
   ============================================================ */

#{{ root_id }} .pg-grid {
  display:grid;

  grid-template-columns:
    repeat(5,minmax(0,1fr));

  gap:
    calc(var(--pg-gap) + 8px)
    var(--pg-gap);

  align-items:stretch;

  list-style:none;
  padding:0;
  margin:0;
}

#{{ root_id }} .pg-item {
  padding:0;
  margin:0;
}

#{{ root_id }} .pg-card {
  display:flex;
  flex-direction:column;
  height:100%;

  border:1px solid var(--pg-line);
  border-radius:var(--pg-radius);

  background:var(--pg-card);
  overflow:hidden;

  transition:
    border-color .2s ease,
    box-shadow .2s ease;
}

#{{ root_id }} .pg-media {
  position:relative;
  width:100%;

  aspect-ratio:var(--pg-ratio);

  overflow:hidden;
  background:var(--pg-card);
  isolation:isolate;
}

#{{ root_id }} .pg-image {
  position:absolute;
  inset:0;

  display:block;
  width:100%;
  height:100%;
  max-width:100%;

  object-fit:var(--pg-fit);

  transition:
    transform .65s cubic-bezier(.2,.7,.2,1);
}

#{{ root_id }} .pg-media-frame {
  position:absolute;
  inset:0;

  border-bottom:1px solid var(--pg-line);
  pointer-events:none;
}

#{{ root_id }} .pg-number {
  position:absolute;
  top:10px;
  left:10px;

  padding:5px 8px;

  border:1px solid rgba(255,255,255,.18);
  border-radius:5px;

  background:rgba(0,0,0,.78);
  color:#fff;

  font-size:10px;
  font-variant-numeric:tabular-nums;
  line-height:1.3;

  pointer-events:none;
}

#{{ root_id }} .pg-image-arrow {
  position:absolute;
  right:10px;
  bottom:10px;

  display:grid;
  place-items:center;

  width:34px;
  height:34px;

  border:1px solid rgba(255,255,255,.2);
  border-radius:50%;

  background:rgba(0,0,0,.78);
  color:#fff;

  opacity:0;
  transition:opacity .2s;

  pointer-events:none;
}


/* ============================================================
   TITLES BELOW THE IMAGES
   No hidden names or tiny hover-only information.
   ============================================================ */

#{{ root_id }} .pg-card-body {
  display:flex;
  flex-direction:column;
  flex:1;

  padding:17px 15px 14px;
}

#{{ root_id }} .pg-card-label {
  color:var(--pg-muted);

  font-size:10px;
  letter-spacing:.09em;
  line-height:1.5;
  text-transform:uppercase;

  margin-bottom:8px;
}

#{{ root_id }} .pg-card h3 {
  font-family:inherit;
  font-size:clamp(15px,1.3vw,19px);
  font-weight:500;
  letter-spacing:-.015em;
  line-height:1.35;

  margin:0 0 18px;
}

#{{ root_id }} .pg-card-cta {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;

  margin-top:auto;
  padding-top:12px;

  border-top:1px solid var(--pg-line);

  color:var(--pg-accent);

  font-size:11px;
  line-height:1.4;
}

#{{ root_id }} .pg-card-cta svg {
  width:15px;
  height:15px;
}


/* ============================================================
   MOBILE SHOW MORE
   ============================================================ */

#{{ root_id }} .pg-load {
  margin-top:30px;
  padding-top:24px;

  border-top:1px solid var(--pg-line);

  text-align:center;
}

#{{ root_id }} .pg-load > p {
  color:var(--pg-muted);
  font-size:13px;
  margin-bottom:15px;
}

#{{ root_id }} .pg-load-actions {
  display:flex;
  align-items:center;
  justify-content:center;
  flex-wrap:wrap;
  gap:12px;
}

#{{ root_id }} .pg-button {
  min-height:50px;
  padding:13px 24px;

  border:1px solid var(--pg-accent);
  border-radius:7px;

  background:var(--pg-accent);
  color:#131313;

  font-size:14px;
  font-weight:600;
}

#{{ root_id }} .pg-text-button {
  min-height:48px;
  padding:12px 16px;

  border:0;
  background:transparent;

  color:var(--pg-text);
  font-size:13px;

  text-decoration:underline;
  text-underline-offset:4px;
}


/* ============================================================
   EMPTY STATES
   ============================================================ */

#{{ root_id }} :is(.pg-no-results,.pg-empty) {
  padding:50px 24px;

  border:1px solid var(--pg-line);
  border-radius:var(--pg-radius);

  text-align:center;
}

#{{ root_id }} :is(.pg-no-results,.pg-empty) h3 {
  font-size:25px;
  font-weight:500;
  line-height:1.2;

  margin-bottom:12px;
}

#{{ root_id }} :is(.pg-no-results,.pg-empty) p {
  max-width:58ch;
  margin-inline:auto;

  color:var(--pg-muted);
  font-size:14px;
  line-height:1.7;
}

#{{ root_id }} .pg-empty .pg-eyebrow {
  justify-content:center;
  margin-bottom:18px;
}


/* ============================================================
   FOOTER
   ============================================================ */

#{{ root_id }} .pg-footer {
  display:flex;
  align-items:center;
  justify-content:space-between;
  flex-wrap:wrap;
  gap:16px;

  margin-top:34px;
  padding-top:20px;

  border-top:1px solid var(--pg-line);
}

#{{ root_id }} .pg-footer p {
  font-size:12px;
  color:var(--pg-muted);
}

#{{ root_id }} .pg-archive {
  display:inline-flex;
  align-items:center;
  gap:14px;

  min-height:48px;

  font-size:13px;
}


/* ============================================================
   HOVER — NO MOVING ROWS
   ============================================================ */

@media (hover:hover) and (pointer:fine) {

  #{{ root_id }} a.pg-card:hover {
    border-color:var(--pg-accent);
    box-shadow:0 14px 34px rgba(0,0,0,.17);
  }

  #{{ root_id }}[data-hover-motion="true"] a.pg-card:hover .pg-image {
    transform:scale(1.035);
  }

  #{{ root_id }} a.pg-card:hover .pg-image-arrow {
    opacity:1;
  }

}

#{{ root_id }} a.pg-card:focus-visible .pg-image-arrow {
  opacity:1;
}


/* ============================================================
   TABLET
   ============================================================ */

@media (min-width:768px) and (max-width:1023px) {

  #{{ root_id }} .pg-grid {
    grid-template-columns:repeat(3,minmax(0,1fr));
  }

  #{{ root_id }} .pg-header {
    gap:24px;
  }

  #{{ root_id }} .pg-header-aside {
