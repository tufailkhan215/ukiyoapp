{% javascript %}
(() => {
  'use strict';

  const tag = 'case-study-grid-v1';

  if (
    !window.customElements ||
    customElements.get(tag)
  ) {
    return;
  }

  class CaseStudyGrid extends HTMLElement {

    connectedCallback() {
      cancelAnimationFrame(this._boot);

      this._boot = requestAnimationFrame(() => {
        this.initialize();
      });
    }

    disconnectedCallback() {
      cancelAnimationFrame(this._boot);

      if (this._cleanup) {
        this._cleanup();
      }
    }

    initialize() {
      if (!this.isConnected) return;

      if (this._cleanup) {
        this._cleanup();
      }

      const root = this;
      const controller = new AbortController();

      const q = selector => {
        return root.querySelector(selector);
      };

      const cards = Array.from(
        root.querySelectorAll('[data-case]')
      );

      const mobile = window.matchMedia(
        '(max-width: 767px)'
      );

      const search = q('[data-search]');
      const searchUI = q('[data-search-ui]');
      const clear = q('[data-clear]');
      const results = q('[data-results]');
      const loadUI = q('[data-load-ui]');
      const loadMore = q('[data-load-more]');
      const showAll = q('[data-show-all]');
      const noResults = q('[data-no-results]');

      const batch = Math.max(
        1,
        Math.min(
          40,
          Number(root.dataset.pageSize) || 6
        )
      );

      const pagingEnabled =
        root.dataset.mobilePaging !== 'false';

      let limit = batch;
      let matches = cards;
      let oldMediaListener = false;

      const normalize = value => {
        return String(value || '')
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase()
          .trim();
      };

      const records = cards.map(card => ({
        card,
        text: normalize(card.dataset.searchText)
      }));

      const on = (
        element,
        event,
        listener
      ) => {
        if (element) {
          element.addEventListener(
            event,
            listener,
            { signal: controller.signal }
          );
        }
      };

      const restore = () => {
        cards.forEach(card => {
          card.hidden = false;
        });

        if (searchUI) searchUI.hidden = true;
        if (loadUI) loadUI.hidden = true;
        if (noResults) noResults.hidden = true;

        if (results) {
          results.textContent =
            `${cards.length} projects`;
        }
      };

      const apply = () => {
        const query = normalize(
          search ? search.value : ''
        );

        const terms = query
          .split(/\s+/)
          .filter(Boolean);

        matches = records
          .filter(record => {
            return terms.every(term => {
              return record.text.includes(term);
            });
          })
          .map(record => record.card);

        const mobilePaging =
          mobile.matches &&
          pagingEnabled;

        /*
          Do not hide a keyboard-focused card
          when the viewport changes.
        */
        const focusedIndex = matches.findIndex(card => {
          return card.contains(document.activeElement);
        });

        if (
          mobilePaging &&
          focusedIndex >= limit
        ) {
          limit =
            Math.ceil(
              (focusedIndex + 1) / batch
            ) * batch;
        }

        const visible = mobilePaging
          ? matches.slice(0, limit)
          : matches;

        const visibleSet = new Set(visible);

        cards.forEach(card => {
          card.hidden = !visibleSet.has(card);
        });

        if (results) {
          results.textContent = query
            ? `${visible.length} of ${matches.length} matching projects`
            : `Showing ${visible.length} of ${cards.length} projects`;
        }

        if (clear) {
          clear.hidden = !query;
        }

        if (noResults) {
          noResults.hidden =
            matches.length !== 0;
        }

        const remaining =
          matches.length - visible.length;

        if (loadUI) {
          loadUI.hidden =
            !mobilePaging ||
            remaining <= 0;
        }

        if (loadMore) {
          loadMore.textContent =
            `Show ${Math.min(batch, remaining)} more case studies`;
        }

        if (showAll) {
          showAll.textContent =
            `Show all ${matches.length}`;
        }

        const loadStatus =
          q('[data-load-status]');

        if (loadStatus) {
          loadStatus.textContent =
            `${remaining} more ${remaining === 1 ? 'project' : 'projects'} to explore`;
        }
      };

      const reveal = all => {
        const nextCard = matches.find(card => {
          return card.hidden;
        });

        limit = all
          ? cards.length
          : limit + batch;

        apply();

        /*
          Move keyboard focus to the first
          newly revealed project without
          forcing the page to jump.
        */
        if (
          nextCard &&
          !nextCard.hidden
        ) {
          const focusTarget =
            nextCard.querySelector('a[href]') ||
            nextCard;

          focusTarget.focus({
            preventScroll: true
          });
        }
      };

      this._cleanup = () => {
        controller.abort();

        if (oldMediaListener) {
          mobile.removeListener(apply);
        }

        restore();

        this._cleanup = null;
      };

      try {
        if (searchUI) {
          searchUI.hidden = false;
        }

        on(search, 'input', () => {
          limit = batch;
          apply();
        });

        on(search, 'search', () => {
          limit = batch;
          apply();
        });

        on(clear, 'click', () => {
          search.value = '';
          limit = batch;

          search.focus({
            preventScroll: true
          });

          apply();
        });

        on(loadMore, 'click', () => {
          reveal(false);
        });

        on(showAll, 'click', () => {
          reveal(true);
        });

        if (mobile.addEventListener) {
          mobile.addEventListener(
            'change',
            apply,
            { signal: controller.signal }
          );
        } else {
          mobile.addListener(apply);
          oldMediaListener = true;
        }

        apply();

      } catch (error) {
        this._cleanup();

        console.warn(
          'Case Study Grid: optional search or reveal controls could not initialize.',
          error
        );
      }
    }
  }

  customElements.define(
    tag,
    CaseStudyGrid
  );
})();
{% endjavascript %}


