{% javascript %}
(() => {
  'use strict';

  const tag = 'featured-cases-v1';

  if (
    !window.customElements ||
    customElements.get(tag)
  ) {
    return;
  }

  class FeaturedCases extends HTMLElement {
    connectedCallback() {
      cancelAnimationFrame(this._boot);
      this._boot = requestAnimationFrame(() => this.initialize());
    }

    disconnectedCallback() {
      cancelAnimationFrame(this._boot);

      if (this._cleanup) {
        this._cleanup();
      }
    }

    initialize() {
      if (!this.isConnected) return;

      if (this._cleanup) {
        this._cleanup();
      }

      const root = this;
      const controller = new AbortController();

      const q = (selector, base = root) => {
        return base.querySelector(selector);
      };

      const qa = (selector, base = root) => {
        return Array.from(base.querySelectorAll(selector));
      };

      const on = (element, type, fn, options = {}) => {
        if (element) {
          element.addEventListener(type, fn, {
            ...options,
            signal: controller.signal
          });
        }
      };

      const normalize = value => {
        return String(value || '')
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase()
          .trim();
      };

      const safeURL = raw => {
        if (!raw || !String(raw).trim()) return '';

        try {
          const url = new URL(raw, location.href);

          return ['http:', 'https:'].includes(url.protocol)
            ? url.href
            : '';
        } catch (_) {
          return '';
        }
      };

      const projects = qa('[data-project]').map(node => {
        let images = [];

        try {
          images = JSON.parse(node.dataset.images || '[]')
            .filter(item => item && safeURL(item.src))
            .slice(0, 6);
        } catch (_) {}

        return {
          node,
          link: q('[data-open]', node),
          key: node.dataset.key,
          title: node.dataset.title || 'Case study',
          category: node.dataset.category || '',
          description: node.dataset.description || '',
          url: safeURL(node.dataset.url),
          images,
          search: normalize([
            node.dataset.title,
            node.dataset.category,
            node.dataset.description
          ].join(' '))
        };
      });

      const search = q('[data-search]');
      const searchUI = q('[data-search-ui]');
      const clear = q('[data-clear]');
      const filterUI = q('[data-filter-ui]');
      const results = q('[data-results]');
      const loadUI = q('[data-load-ui]');
      const more = q('[data-more]');
      const all = q('[data-all]');
      const empty = q('[data-empty]');

      const mobile = matchMedia('(max-width: 767px)');

      const batch = Math.max(
        1,
        Math.min(40, Number(root.dataset.batch) || 6)
      );

      const dialog = q('[data-dialog]');
      const stage = q('[data-stage]');
      const modalImage = q('[data-dialog-image]');
      const imageMessage = q('[data-image-message]');
      const readMore = q('[data-read-more]');
      const saveButton = q('[data-save]');
      const shareButton = q('[data-share]');
      const status = q('[data-dialog-status]');

      const nativeDialog =
        dialog &&
        typeof dialog.showModal === 'function';

      const storageKey = 'featured-case-studies:saved:v1';
      const loaders = new Set();

      let category = '';
      let limit = batch;
      let matches = projects;
      let active = null;
      let index = 0;
      let loadVersion = 0;
      let opener = null;
      let scrollStyles = null;
      let legacyMedia = false;
      let disposed = false;
      let gesture = null;

      const readSaved = () => {
        try {
          const data = JSON.parse(
            localStorage.getItem(storageKey) || '[]'
          );

          return new Set(
            Array.isArray(data)
              ? data.filter(value => typeof value === 'string')
              : []
          );
        } catch (_) {
          return new Set();
        }
      };

      const savedID = project => {
        return project.url ||
          `${location.pathname}#${root.id}-${project.key}`;
      };

      const updateSave = () => {
        if (!saveButton || !active) return;

        const saved = readSaved().has(savedID(active));

        saveButton.setAttribute('aria-pressed', String(saved));
        saveButton.textContent = saved ? 'Saved' : 'Save';
        saveButton.title = 'Saved in this browser only';
      };

      const lockScroll = () => {
        if (scrollStyles) return;

        scrollStyles = [
          document.documentElement,
          document.body
        ].map(element => ({
          element,
          value: element.style.getPropertyValue('overflow'),
          priority: element.style.getPropertyPriority('overflow')
        }));

        scrollStyles.forEach(item => {
          item.element.style.setProperty('overflow', 'hidden');
        });
      };

      const unlockScroll = () => {
        if (!scrollStyles) return;

        scrollStyles.forEach(item => {
          if (item.value) {
            item.element.style.setProperty(
              'overflow',
              item.value,
              item.priority
            );
          } else {
            item.element.style.removeProperty('overflow');
          }
        });

        scrollStyles = null;
      };

      function apply() {
        const terms = normalize(search ? search.value : '')
          .split(/\s+/)
          .filter(Boolean);

        matches = projects.filter(project => {
          const categoryMatches =
            !category ||
            normalize(project.category) === category;

          const searchMatches = terms.every(term => {
            return project.search.includes(term);
          });

          return categoryMatches && searchMatches;
        });

        const paging =
          mobile.matches &&
          root.dataset.mobilePaging !== 'false';

        const focused = matches.findIndex(project => {
          return project.node.contains(document.activeElement);
        });

        if (paging && focused >= limit) {
          limit = Math.ceil((focused + 1) / batch) * batch;
        }

        const visible = paging
          ? matches.slice(0, limit)
          : matches;

        const visibleSet = new Set(visible);

        projects.forEach(project => {
          project.node.hidden = !visibleSet.has(project);
        });

        if (results) {
          results.textContent =
            `Showing ${visible.length} of ${matches.length} ` +
            `${category || terms.length ? 'matching ' : ''}projects`;
        }

        if (clear) {
          clear.hidden = !terms.length;
        }

        if (empty) {
          empty.hidden = matches.length !== 0;
        }

        const remaining = matches.length - visible.length;

        if (loadUI) {
          loadUI.hidden = !paging || remaining <= 0;
        }

        if (more) {
          more.textContent =
            `Show ${Math.min(batch, remaining)} more case studies`;
        }

        if (all) {
          all.textContent = `Show all ${matches.length}`;
        }

        const remainingLabel = q('[data-remaining]');

        if (remainingLabel) {
          remainingLabel.textContent =
            `${remaining} more ` +
            `${remaining === 1 ? 'project' : 'projects'} to explore`;
        }
      }

      function reveal(showAll) {
        const next = matches.find(project => {
          return project.node.hidden;
        });

        limit = showAll
          ? projects.length
          : limit + batch;

        apply();

        if (next && !next.node.hidden) {
          next.link.focus({ preventScroll: true });
        }
      }

      function buildFilters() {
        if (
          !filterUI ||
          root.dataset.filters === 'false'
        ) {
          return;
        }

        const categories = new Map();

        projects.forEach(project => {
          const normalized = normalize(project.category);

          if (
            normalized &&
            !categories.has(normalized)
          ) {
            categories.set(
              normalized,
              project.category.trim()
            );
          }
        });

        if (!categories.size) return;

        const order = [];

        String(root.dataset.filterOrder || '')
          .split(/\r?\n/)
          .forEach(line => {
            const key = normalize(line);

            if (
              categories.has(key) &&
              !order.includes(key)
            ) {
              order.push(key);
            }
          });

        categories.forEach((_, key) => {
          if (!order.includes(key)) {
            order.push(key);
          }
        });

        filterUI.replaceChildren();

        ['', ...order].forEach(key => {
          const button = document.createElement('button');

          button.type = 'button';
          button.className = 'fg-filter';
          button.textContent = key
            ? categories.get(key)
            : 'All';

          button.dataset.categoryFilter = key;

          button.setAttribute(
            'aria-controls',
            `${root.id}-grid`
          );

          button.setAttribute(
            'aria-pressed',
            String(key === '')
          );

          on(button, 'click', () => {
            category = key;
            limit = batch;

            qa('button', filterUI).forEach(item => {
              item.setAttribute(
                'aria-pressed',
                String(item === button)
              );
            });

            apply();
          });

          filterUI.appendChild(button);
        });

        filterUI.hidden = false;
      }

      function renderImage(nextIndex) {
        if (!active || !active.images.length) return;

        index =
          (nextIndex + active.images.length) %
          active.images.length;

        const item = active.images[index];
        const version = ++loadVersion;

        const previous = q('[data-prev]');
        const next = q('[data-next]');

        previous.hidden =
          next.hidden =
          active.images.length < 2;

        q('[data-image-position]').textContent =
          `${index + 1} / ${active.images.length}`;

        qa('[data-image-choice]').forEach(button => {
          button.setAttribute(
            'aria-pressed',
            String(Number(button.dataset.imageChoice) === index)
          );
        });

        stage.setAttribute('aria-busy', 'true');

        imageMessage.textContent = 'Loading preview…';
        imageMessage.hidden = false;

        const loader = new Image();
        loaders.add(loader);

        const finish = success => {
          loader.onload = loader.onerror = null;
          loaders.delete(loader);

          if (
            disposed ||
            version !== loadVersion ||
            !dialog.open
          ) {
            return;
          }

          stage.setAttribute('aria-busy', 'false');

          if (!success) {
            modalImage.hidden = true;
            imageMessage.textContent =
              'This image could not load. Try another preview.';
            return;
          }

          modalImage.src = loader.src;
          modalImage.alt = item.alt || active.title;

          modalImage.width =
            Number(item.width) ||
            loader.naturalWidth ||
            1600;

          modalImage.height =
            Number(item.height) ||
            loader.naturalHeight ||
            1000;

          modalImage.hidden = false;
          imageMessage.hidden = true;
        };

        loader.onload = () => finish(true);
        loader.onerror = () => finish(false);
        loader.decoding = 'async';
        loader.src = safeURL(item.src);
      }

      function openProject(project, trigger) {
        if (
          !nativeDialog ||
          !project.images.length
        ) {
          return false;
        }

        active = project;
        opener = trigger;
        index = 0;

        q('[data-dialog-title]').textContent =
          project.title;

        q('[data-dialog-description]').textContent =
          project.description;

        q('[data-dialog-description]').hidden =
          !project.description;

        q('[data-dialog-category]').textContent =
          project.category;

        q('[data-dialog-category]').hidden =
          !project.category;

        readMore.hidden = !project.url;

        if (project.url) {
          readMore.href = project.url;
        } else {
          readMore.removeAttribute('href');
        }

        status.textContent = '';

        q('[data-copy-fallback]').hidden = true;

        modalImage.hidden = true;
        modalImage.removeAttribute('src');

        updateSave();

        const thumbs = q('[data-thumbnails]');
        thumbs.replaceChildren();
        thumbs.hidden = project.images.length < 2;

        if (project.images.length > 1) {
          project.images.forEach((image, imageIndex) => {
            const button = document.createElement('button');

            button.type = 'button';
            button.className = 'fg-thumb';
            button.dataset.imageChoice = String(imageIndex);

            button.setAttribute(
              'aria-label',
              `View project image ${imageIndex + 1}`
            );

            button.setAttribute(
              'aria-pressed',
              String(imageIndex === 0)
            );

            const img = document.createElement('img');

            img.src = safeURL(image.thumb || image.src);
            img.alt = '';
            img.width = 90;
            img.height = 60;
            img.loading = 'lazy';
            img.decoding = 'async';

            button.appendChild(img);
            thumbs.appendChild(button);
          });
        }

        try {
          dialog.showModal();
        } catch (_) {
          active = null;
          return false;
        }

        lockScroll();

        q('[data-dialog-body]').scrollTop = 0;

        q('[data-close]').focus({
          preventScroll: true
        });

        renderImage(0);

        return true;
      }

      function afterClose() {
        ++loadVersion;
        unlockScroll();

        modalImage.hidden = true;
        modalImage.removeAttribute('src');

        q('[data-thumbnails]').replaceChildren();

        active = null;

        if (
          opener &&
          opener.isConnected &&
          opener.getClientRects().length
        ) {
          opener.focus({ preventScroll: true });
        }

        opener = null;
      }

      function manualCopy(url) {
        const field = q('[data-copy-url]');

        q('[data-copy-fallback]').hidden = false;

        field.value = url;
        field.focus({ preventScroll: true });
        field.select();

        status.textContent = 'Copy the link shown below.';
      }

      this._cleanup = () => {
        disposed = true;
        ++loadVersion;

        if (dialog && dialog.open) {
          dialog.close();
        }

        unlockScroll();
        controller.abort();

        if (legacyMedia) {
          mobile.removeListener(apply);
        }

        loaders.forEach(loader => {
          loader.onload = loader.onerror = null;
        });

        loaders.clear();

        projects.forEach(project => {
          project.node.hidden = false;
          project.link.removeAttribute('aria-haspopup');
        });

        if (searchUI) {
          searchUI.hidden = true;
        }

        if (filterUI) {
          filterUI.hidden = true;
          filterUI.replaceChildren();
        }

        if (loadUI) {
          loadUI.hidden = true;
        }

        if (empty) {
          empty.hidden = true;
        }

        if (modalImage) {
          modalImage.removeAttribute('src');
        }

        this._cleanup = null;
      };

      try {
        if (searchUI) {
          searchUI.hidden = false;
        }

        buildFilters();

        on(search, 'input', () => {
          limit = batch;
          apply();
        });

        on(search, 'search', () => {
          limit = batch;
          apply();
        });

        on(clear, 'click', () => {
          search.value = '';
          limit = batch;
          search.focus();
          apply();
        });

        on(more, 'click', () => reveal(false));
        on(all, 'click', () => reveal(true));

        if (mobile.addEventListener) {
          on(mobile, 'change', apply);
        } else {
          mobile.addListener(apply);
          legacyMedia = true;
        }

        if (nativeDialog) {
          projects.forEach(project => {
            project.link.setAttribute(
              'aria-haspopup',
              'dialog'
            );

            on(project.link, 'click', event => {
              if (
                event.button !== 0 ||
                event.metaKey ||
                event.ctrlKey ||
                event.shiftKey ||
                event.altKey
              ) {
                return;
              }

              if (openProject(project, project.link)) {
                event.preventDefault();
              }
            });
          });

          on(q('[data-close]'), 'click', () => {
            dialog.close();
          });

          on(dialog, 'close', afterClose);

          on(dialog, 'click', event => {
            if (event.target !== dialog) return;

            const rect = dialog.getBoundingClientRect();

            if (
              event.clientX < rect.left ||
              event.clientX > rect.right ||
              event.clientY < rect.top ||
              event.clientY > rect.bottom
            ) {
              dialog.close();
            }
          });

          on(q('[data-prev]'), 'click', () => {
            renderImage(index - 1);
          });

          on(q('[data-next]'), 'click', () => {
            renderImage(index + 1);
          });

          on(q('[data-thumbnails]'), 'click', event => {
            const button = event.target.closest(
              '[data-image-choice]'
            );

            if (button) {
              renderImage(
                Number(button.dataset.imageChoice)
              );
            }
          });

          on(dialog, 'keydown', event => {
            if (!dialog.open || !active) return;

            if (event.key === 'Tab') {
              const focusable = qa(
                'a[href],button:not(:disabled),input:not(:disabled)',
                dialog
              ).filter(element => {
                return element.getClientRects().length;
              });

              const first = focusable[0];
              const last = focusable[focusable.length - 1];

              if (
                event.shiftKey &&
                document.activeElement === first
              ) {
                event.preventDefault();
                last.focus();
              } else if (
                !event.shiftKey &&
                document.activeElement === last
              ) {
                event.preventDefault();
                first.focus();
              }
            }

            if (
              event.target.closest(
                'input,textarea,select,[contenteditable="true"]'
              )
            ) {
              return;
            }

            if (
              active.images.length > 1 &&
              ['ArrowLeft', 'ArrowRight'].includes(event.key)
            ) {
              event.preventDefault();

              renderImage(
                index +
                (event.key === 'ArrowRight' ? 1 : -1)
              );
            }
          });

          on(stage, 'pointerdown', event => {
            gesture =
              event.isPrimary &&
              event.pointerType !== 'mouse' &&
              !event.target.closest('button')
                ? {
                    x: event.clientX,
                    y: event.clientY,
                    id: event.pointerId
                  }
                : null;
          }, { passive: true });

          on(stage, 'pointercancel', () => {
            gesture = null;
          });

          on(stage, 'pointerup', event => {
            if (
              !gesture ||
              gesture.id !== event.pointerId
            ) {
              return;
            }

            const dx = event.clientX - gesture.x;
            const dy = event.clientY - gesture.y;

            gesture = null;

            if (
              Math.abs(dx) > 45 &&
              Math.abs(dy) < 35 &&
              active &&
              active.images.length > 1
            ) {
              renderImage(index + (dx < 0 ? 1 : -1));
            }
          }, { passive: true });

          on(saveButton, 'click', () => {
            if (!active) return;

            const saved = readSaved();
            const key = savedID(active);
            const wasSaved = saved.has(key);

            if (wasSaved) {
              saved.delete(key);
            } else {
              saved.add(key);
            }

            try {
              localStorage.setItem(
                storageKey,
                JSON.stringify(Array.from(saved))
              );

              updateSave();

              status.textContent = wasSaved
                ? 'Removed from this browser’s saved projects.'
                : 'Saved in this browser on this device.';
            } catch (_) {
              status.textContent =
                'Saving is unavailable in this browser.';
            }
          });

          on(shareButton, 'click', async () => {
            if (!active) return;

            const project = active;
            const url = project.url || location.href;

            status.textContent = '';
            q('[data-copy-fallback]').hidden = true;

            try {
              if (navigator.share) {
                await navigator.share({
                  title: project.title,
                  url
                });
                return;
              }

              if (
                navigator.clipboard &&
                window.isSecureContext
              ) {
                await navigator.clipboard.writeText(url);

                if (
                  active === project &&
                  dialog.open
                ) {
                  status.textContent = 'Link copied.';
                }

                return;
              }

              if (
                active === project &&
                dialog.open
              ) {
                manualCopy(url);
              }
            } catch (error) {
              if (
                error.name !== 'AbortError' &&
                active === project &&
                dialog.open
              ) {
                manualCopy(url);
              }
            }
          });

          on(window, 'storage', event => {
            if (event.key === storageKey) {
              updateSave();
            }
          });
        }

        apply();

      } catch (error) {
        this._cleanup();

        console.warn(
          'Featured Case Studies: preview enhancements could not initialize.',
          error
        );
      }
    }
  }

  customElements.define(tag, FeaturedCases);
})();
