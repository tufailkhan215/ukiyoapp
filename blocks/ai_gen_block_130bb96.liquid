{%- comment -%}
  FEATURED CASE STUDIES
  Single-file theme block. No local child-block definitions.
  Existing 40 image/title/link setting IDs are retained.
  Five desktop columns, mobile reveal, category filters and preview dialog.
{%- endcomment -%}

{%- liquid
  assign owner = section
  if block != blank and block.id != blank
    assign owner = block
  endif

  assign cfg = owner.settings
  assign uid = section.id | append: '-' | append: owner.id | handleize
  assign root_id = 'FeaturedCases-' | append: uid

  assign project_keys = 'r1_1,r1_2,r1_3,r1_4,r1_5,r1_6,r1_7,r1_8,r2_1,r2_2,r2_3,r2_4,r2_5,r2_6,r2_7,r2_8,cs_17,cs_18,cs_19,cs_20,cs_21,cs_22,cs_23,cs_24,cs_25,cs_26,cs_27,cs_28,cs_29,cs_30,cs_31,cs_32,cs_33,cs_34,cs_35,cs_36,cs_37,cs_38,cs_39,cs_40' | split: ','

  assign project_count = 0

  for key in project_keys
    assign show_key = key | append: '_show'
    assign image_key = key | append: '_image'

    if cfg[show_key] != false and cfg[image_key] != blank
      assign project_count = project_count | plus: 1
    endif
  endfor

  assign mobile_columns = cfg.mobile_columns | default: '2'
-%}

{%- capture image_sizes -%}
(min-width: {{ cfg.max_width }}px) {{ cfg.max_width | divided_by: 5 }}px,
(min-width: 1024px) 20vw,
(min-width: 768px) 33vw,
{% if mobile_columns == '1' %}100vw{% else %}(max-width: 359px) 100vw, 50vw{% endif %}
{%- endcapture -%}

{%- capture arrow -%}
<svg
  viewBox="0 0 24 24"
  width="18"
  height="18"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d="M7 17 17 7M7 7h10v10"/>
</svg>
{%- endcapture -%}

<featured-cases-v1
  id="{{ root_id }}"
  class="fg"
  data-batch="{{ cfg.mobile_batch | default: 6 }}"
  data-mobile-paging="{{ cfg.mobile_load_more }}"
  data-motion="{{ cfg.enable_motion }}"
  data-filters="{{ cfg.show_filters }}"
  data-filter-order="{{ cfg.filters_text | escape }}"
  style="
    --fg-bg:{{ cfg.background_color | default: '#0C0C0C' }};
    --fg-card:{{ cfg.card_background | default: '#161616' }};
    --fg-text:{{ cfg.text_color | default: '#F6F5F1' }};
    --fg-muted:{{ cfg.muted_color | default: '#ADADA6' }};
    --fg-accent:{{ cfg.gallery_accent | default: '#F5B63C' }};
    --fg-line:{{ cfg.line_color | default: '#30302E' }};
    --fg-max:{{ cfg.max_width | default: 1440 }}px;
    --fg-gap:{{ cfg.card_gap | default: 18 }}px;
    --fg-radius:{{ cfg.card_radius | default: 16 }}px;
    --fg-gutter:{{ cfg.desktop_gutter | default: 32 }}px;
    --fg-mobile-gutter:{{ cfg.mobile_gutter | default: 16 }}px;
    --fg-top:{{ cfg.padding_top | default: 60 }}px;
    --fg-bottom:{{ cfg.padding_bottom | default: 60 }}px;
    --fg-mobile-top:{{ cfg.mobile_padding_top | default: 40 }}px;
    --fg-mobile-bottom:{{ cfg.mobile_padding_bottom | default: 40 }}px;
    --fg-mobile-cols:{{ mobile_columns }};
    --fg-fit:{{ cfg.image_fit | default: 'cover' }};
  "
  {{ block.shopify_attributes }}
>
  <div class="fg-shell">

    <header class="fg-header">
      {% if cfg.show_intro != false %}
        <div class="fg-intro">
          {% if cfg.eyebrow != blank %}
            <p class="fg-eyebrow">{{ cfg.eyebrow | escape }}</p>
          {% endif %}

          <h2>{{ cfg.heading | default: 'Featured Projects' | escape }}</h2>

          {% if cfg.description != blank %}
            <div class="fg-intro-description">
              {{ cfg.description }}
            </div>
          {% endif %}
        </div>
      {% endif %}

      <div
        class="fg-filters"
        data-filter-ui
        role="group"
        aria-label="Filter case studies by category"
        hidden
      ></div>
    </header>

    {% if project_count > 0 %}

      <div class="fg-toolbar">
        <p
          class="fg-results{% if cfg.show_project_count == false %} fg-sr{% endif %}"
          data-results
          role="status"
          aria-live="polite"
          aria-atomic="true"
        >
          {% if cfg.show_project_count != false %}
            {{ project_count }} projects
          {% endif %}
        </p>

        {% if cfg.show_search != false %}
          <div class="fg-search" data-search-ui hidden>
            <label class="fg-sr" for="{{ root_id }}-search">
              Search case studies
            </label>

            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              aria-hidden="true"
            >
              <circle cx="10.5" cy="10.5" r="6.5"/>
              <path d="m16 16 5 5"/>
            </svg>

            <input
              id="{{ root_id }}-search"
              type="search"
              placeholder="Search projects"
              autocomplete="off"
              data-search
              aria-controls="{{ root_id }}-grid"
            >

            <button type="button" data-clear hidden>
              Clear
            </button>
          </div>
        {% endif %}
      </div>

      <ul
        id="{{ root_id }}-grid"
        class="fg-grid"
        role="list"
        aria-label="Case studies"
      >
        {% assign project_number = 0 %}

        {% for key in project_keys %}
          {%- liquid
            assign show_key = key | append: '_show'
            assign image_key = key | append: '_image'
            assign title_key = key | append: '_title'
            assign url_key = key | append: '_url'
            assign category_key = key | append: '_category'
            assign description_key = key | append: '_description'

            assign project_image = cfg[image_key]

            if cfg[show_key] == false or project_image == blank
              continue
            endif

            assign project_number = project_number | plus: 1
            assign project_title = cfg[title_key]

            if project_title == blank
              assign project_title = 'Case study ' | append: project_number
            endif

            assign project_category = cfg[category_key] | strip
            assign project_description = cfg[description_key]
            assign project_url = cfg[url_key]
            assign fallback_url = project_image | image_url: width: 2000
            assign card_url = project_url | default: fallback_url
            assign image_count = 0
          -%}

          {%- capture gallery_json -%}
            [
              {%- for image_number in (1..6) -%}
                {%- liquid
                  assign gallery_image = project_image

                  if image_number > 1
                    assign gallery_key = key | append: '_gallery_' | append: image_number
                    assign gallery_image = cfg[gallery_key]
                  endif
                -%}

                {%- if gallery_image != blank -%}
                  {%- if image_count > 0 -%},{%- endif -%}

                  {
                    "src":{{ gallery_image | image_url: width: 1800 | json }},
                    "thumb":{{ gallery_image | image_url: width: 180 | json }},
                    "alt":{{ gallery_image.alt | default: project_title | json }},
                    "width":{{ gallery_image.width | json }},
                    "height":{{ gallery_image.height | json }}
                  }

                  {%- assign image_count = image_count | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            ]
          {%- endcapture -%}

          <li
            class="fg-item"
            data-project
            data-key="{{ key }}"
            data-title="{{ project_title | escape }}"
            data-category="{{ project_category | escape }}"
            data-description="{{ project_description | escape }}"
            data-url="{{ project_url | escape }}"
            data-images="{{ gallery_json | escape }}"
          >
            <a
              class="fg-card"
              href="{{ card_url | escape }}"
              data-open
              aria-label="View {{ project_title | escape }}"
            >
              <div class="fg-media">

                {{
                  project_image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '240,360,480,640,800,1000,1200',
                    sizes: image_sizes,
                    loading: 'lazy',
                    decoding: 'async',
                    alt: '',
                    class: 'fg-cover'
                }}

                <span class="fg-shade" aria-hidden="true"></span>

                {% if project_category != blank %}
                  <span class="fg-category">
                    {{ project_category | escape }}
                  </span>
                {% endif %}

                {% if image_count > 1 %}
                  <span
                    class="fg-photo-count"
                    aria-label="{{ image_count }} preview images"
                  >
                    {{ image_count }} photos
                  </span>
                {% endif %}

                <span class="fg-eye" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    width="23"
                    height="23"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                </span>
              </div>

              <div class="fg-card-copy">
                <h3>{{ project_title | escape }}</h3>

                {% if project_description != blank %}
                  <p>{{ project_description | escape }}</p>
                {% endif %}

                <span class="fg-preview-label" aria-hidden="true">
                  Preview project
                  {{ arrow }}
                </span>
              </div>
            </a>
          </li>

        {% endfor %}
      </ul>

      <div class="fg-empty" data-empty hidden>
        <h3>No matching projects.</h3>
        <p>Try another category or search term.</p>
      </div>

      <div class="fg-load" data-load-ui hidden>
        <p data-remaining></p>

        <div>
          <button
            type="button"
            class="fg-primary"
            data-more
            aria-controls="{{ root_id }}-grid"
          >
            Show more
          </button>

          <button
            type="button"
            class="fg-text-button"
            data-all
            aria-controls="{{ root_id }}-grid"
          >
            Show all
          </button>
        </div>
      </div>

    {% endif %}

    {% if cfg.show_footer != false %}
      <footer class="fg-footer">
        <p>
          {{ cfg.footer_text | default: 'Explore the work. See the details.' | escape }}
        </p>

        {% if cfg.archive_url != blank %}
          <a href="{{ cfg.archive_url | escape }}">
            {{ cfg.archive_label | default: 'View all case studies' | escape }}
            {{ arrow }}
          </a>
        {% endif %}
      </footer>
    {% endif %}

  </div>

  {% comment %}
    One reusable dialog. Additional gallery images load on demand.
  {% endcomment %}

  <dialog
    class="fg-dialog"
    data-dialog
    aria-labelledby="{{ root_id }}-dialog-title"
  >
    <div class="fg-dialog-shell">

      <header class="fg-dialog-header">
        <span>Project preview</span>

        <button
          type="button"
          class="fg-icon-button"
          data-close
          aria-label="Close project preview"
          autofocus
        >
          <svg
            viewBox="0 0 24 24"
            width="21"
            height="21"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path d="m6 6 12 12M6 18 18 6"/>
          </svg>
        </button>
      </header>

      <div class="fg-dialog-body" data-dialog-body>

        <div class="fg-stage" data-stage>
          <img
            data-dialog-image
            alt=""
            width="1600"
            height="1000"
            hidden
          >

          <p
            class="fg-image-message"
            data-image-message
            role="status"
          >
            Loading preview…
          </p>

          <button
            type="button"
            class="fg-icon-button fg-image-prev"
            data-prev
            aria-label="Previous project image"
            hidden
          >
            <svg
              viewBox="0 0 24 24"
              width="21"
              height="21"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path d="m15 6-6 6 6 6"/>
            </svg>
          </button>

          <button
            type="button"
            class="fg-icon-button fg-image-next"
            data-next
            aria-label="Next project image"
            hidden
          >
            <svg
              viewBox="0 0 24 24"
              width="21"
              height="21"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path d="m9 6 6 6-6 6"/>
            </svg>
          </button>

          <span
            class="fg-image-position"
            data-image-position
            aria-live="polite"
          ></span>
        </div>

        <div
          class="fg-thumbnails"
          data-thumbnails
          role="group"
          aria-label="Project images"
          hidden
        ></div>

        <div class="fg-dialog-copy">
          <p class="fg-eyebrow" data-dialog-category></p>

          <h3
            id="{{ root_id }}-dialog-title"
            data-dialog-title
          ></h3>

          <p
            class="fg-dialog-description"
            data-dialog-description
          ></p>
        </div>

      </div>

      <footer class="fg-dialog-footer">

        <a
          class="fg-primary fg-read-more"
          data-read-more
          {% if cfg.open_new_tab %}
            target="_blank"
            rel="noopener noreferrer"
          {% endif %}
          hidden
        >
          {{ cfg.read_more_label | default: 'Read the full case study' | escape }}
          {{ arrow }}

          {% if cfg.open_new_tab %}
            <span class="fg-sr">(opens in a new tab)</span>
          {% endif %}
        </a>

        <div class="fg-secondary-actions">
          {% if cfg.enable_save %}
            <button
              type="button"
              data-save
              aria-pressed="false"
            >
              Save
            </button>
          {% endif %}

          {% if cfg.enable_share %}
            <button type="button" data-share>
              Share
            </button>
          {% endif %}
        </div>

        <p
          class="fg-dialog-status"
          data-dialog-status
          role="status"
          aria-live="polite"
        ></p>

        <div class="fg-copy-fallback" data-copy-fallback hidden>
          <label for="{{ root_id }}-share-url">
            Copy this link
          </label>

          <input
            id="{{ root_id }}-share-url"
            type="url"
            readonly
            data-copy-url
          >
        </div>

      </footer>
    </div>
  </dialog>
</featured-cases-v1>


{% style %}

/* FOUNDATION */

#{{ root_id }} {
  display:block;
  position:relative;
  isolation:isolate;
  width:100%;
  max-width:100%;
  min-width:0;
  padding-block:var(--fg-top) var(--fg-bottom);
  background:var(--fg-bg);
  color:var(--fg-text);
  font:400 15px/1.65 'Kanit',var(--font-body-family,Arial,sans-serif);
  -webkit-font-smoothing:antialiased;
}

#{{ root_id }} *,
#{{ root_id }} *::before,
#{{ root_id }} *::after {
  box-sizing:border-box;
  min-width:0;
}

#{{ root_id }} [hidden] {
  display:none!important;
}

#{{ root_id }} :where(h2,h3,p,ul) {
  margin:0;
}

#{{ root_id }} :where(h2,h3,p,a,label) {
  overflow-wrap:anywhere;
}

#{{ root_id }} :where(h2,h3) {
  color:var(--fg-text);
  text-transform:none;
}

#{{ root_id }} a {
  color:inherit;
  text-decoration:none;
}

#{{ root_id }} button,
#{{ root_id }} input {
  font:inherit;
}

#{{ root_id }} button {
  cursor:pointer;
}

#{{ root_id }} button:disabled {
  opacity:.45;
  cursor:default;
}

#{{ root_id }} svg {
  display:block;
  flex:none;
}

#{{ root_id }} :where(a,button,input,[tabindex]):focus-visible {
  outline:2px solid var(--fg-accent);
  outline-offset:4px;
}

#{{ root_id }} .fg-sr {
  position:absolute;
  width:1px;
  height:1px;
  padding:0;
  overflow:hidden;
  clip-path:inset(50%);
  white-space:nowrap;
}

#{{ root_id }} .fg-shell {
  width:100%;
  max-width:var(--fg-max);
  margin-inline:auto;
  padding-inline:var(--fg-gutter);
}


/* INTRODUCTION AND FILTERS */

#{{ root_id }} .fg-header {
  display:flex;
  align-items:center;
  justify-content:space-between;
  flex-wrap:wrap;
  gap:26px 40px;
}

#{{ root_id }} .fg-intro {
  flex:1 1 320px;
}

#{{ root_id }} .fg-eyebrow {
  color:var(--fg-accent);
  font-size:10px;
  font-weight:600;
  letter-spacing:.2em;
  text-transform:uppercase;
}

#{{ root_id }} .fg-intro h2 {
  margin-top:8px;
  font-family:inherit;
  font-size:clamp(30px,3.4vw,50px);
  font-weight:600;
  letter-spacing:-.035em;
  line-height:1.1;
}

#{{ root_id }} .fg-intro-description {
  max-width:58ch;
  color:var(--fg-muted);
  margin-top:14px;
  font-size:14px;
}

#{{ root_id }} .fg-intro-description p+p {
  margin-top:10px;
}

#{{ root_id }} .fg-intro-description a {
  text-decoration:underline;
  text-underline-offset:4px;
}

#{{ root_id }} .fg-filters {
  display:flex;
  flex:1 1 420px;
  flex-wrap:wrap;
  justify-content:flex-end;
  gap:8px;
}

#{{ root_id }} .fg-filter {
  min-height:44px;
  max-width:100%;
  padding:10px 17px;
  border:1px solid var(--fg-line);
  border-radius:999px;
  color:var(--fg-muted);
  background:var(--fg-card);
  font-size:12px;
  line-height:1.4;
  transition:background .2s,color .2s,border-color .2s;
}

#{{ root_id }} .fg-filter[aria-pressed="true"] {
  background:var(--fg-accent);
  border-color:var(--fg-accent);
  color:#16120A;
  font-weight:600;
}

#{{ root_id }} .fg-toolbar {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:18px;
  margin-block:26px 24px;
  padding-top:22px;
  border-top:1px solid var(--fg-line);
}

#{{ root_id }} .fg-results {
  color:var(--fg-muted);
  font-size:12px;
}

#{{ root_id }} .fg-search {
  display:flex;
  align-items:center;
  gap:10px;
  width:min(100%,310px);
  min-height:46px;
  padding:0 8px 0 14px;
  border:1px solid var(--fg-line);
  border-radius:999px;
  background:var(--fg-card);
  color:var(--fg-muted);
}

#{{ root_id }} .fg-search input {
  width:100%;
  min-height:44px;
  padding:8px 0;
  border:0;
  background:transparent;
  color:var(--fg-text);
  font-size:16px;
}

#{{ root_id }} .fg-search input::placeholder {
  color:var(--fg-muted);
  opacity:1;
}

#{{ root_id }} .fg-search button {
  flex:none;
  min-height:44px;
  padding:8px;
  border:0;
  background:transparent;
  color:var(--fg-text);
  font-size:12px;
}


/* FIVE-COLUMN DESKTOP GRID */

#{{ root_id }} .fg-grid {
  display:grid;
  grid-template-columns:repeat(5,minmax(0,1fr));
  gap:var(--fg-gap);
  align-items:stretch;
  padding:0;
  list-style:none;
}

#{{ root_id }} .fg-item {
  margin:0;
  padding:0;
}

#{{ root_id }} .fg-card {
  display:block;
  position:relative;
  height:100%;
  border:1px solid var(--fg-line);
  border-radius:var(--fg-radius);
  background:var(--fg-card);
  overflow:hidden;
  transition:border-color .2s,box-shadow .2s;
}

#{{ root_id }} .fg-media {
  position:relative;
  width:100%;
  aspect-ratio:1;
  overflow:hidden;
}

#{{ root_id }} .fg-cover {
  display:block;
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  max-width:100%;
  object-fit:var(--fg-fit);
  transition:transform .7s cubic-bezier(.2,.7,.2,1);
}

#{{ root_id }} .fg-shade {
  position:absolute;
  inset:0;
  background:linear-gradient(
    180deg,
    rgba(0,0,0,.2),
    transparent 35%,
    rgba(0,0,0,.65) 72%,
    rgba(0,0,0,.94)
  );
  pointer-events:none;
}

#{{ root_id }} .fg-category {
  position:absolute;
  top:12px;
  left:12px;
  max-width:calc(100% - 24px);
  padding:5px 10px;
  border:1px solid rgba(255,255,255,.16);
  border-radius:999px;
  background:rgba(0,0,0,.64);
  color:#F3F3ED;
  font-size:10px;
  line-height:1.4;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

#{{ root_id }} .fg-photo-count {
  position:absolute;
  right:12px;
  top:48px;
  padding:3px 7px;
  border-radius:4px;
  background:rgba(0,0,0,.65);
  color:#DFDFD9;
  font-size:9px;
}

#{{ root_id }} .fg-eye {
  display:grid;
  place-items:center;
  position:absolute;
  left:50%;
  top:43%;
  width:52px;
  height:52px;
  border:1px solid rgba(255,255,255,.32);
  border-radius:50%;
  background:rgba(25,25,25,.65);
  color:#fff;
  transform:translate(-50%,-50%) scale(.88);
  opacity:0;
  transition:opacity .25s,transform .25s;
  pointer-events:none;
}

#{{ root_id }} .fg-card-copy {
  position:absolute;
  left:0;
  right:0;
  bottom:0;
  padding:18px;
  color:#fff;
}

#{{ root_id }} .fg-card-copy h3 {
  color:#fff;
  font-family:inherit;
  font-size:clamp(15px,1.3vw,20px);
  font-weight:600;
  letter-spacing:-.015em;
  line-height:1.25;
  display:-webkit-box;
  -webkit-box-orient:vertical;
  -webkit-line-clamp:2;
  overflow:hidden;
}

#{{ root_id }} .fg-card-copy p {
  display:-webkit-box;
  -webkit-box-orient:vertical;
  -webkit-line-clamp:2;
  overflow:hidden;
  margin-top:7px;
  color:#C8C8C2;
  font-size:11px;
  line-height:1.5;
}

#{{ root_id }} .fg-preview-label {
  display:flex;
  align-items:center;
  gap:7px;
  margin-top:10px;
  color:var(--fg-accent);
  font-size:10px;
  font-weight:500;
}

#{{ root_id }} .fg-preview-label svg {
  width:13px;
  height:13px;
}

#{{ root_id }} .fg-card:focus-visible .fg-eye {
  opacity:1;
  transform:translate(-50%,-50%) scale(1);
}


/* RESULTS, LOAD MORE AND FOOTER */

#{{ root_id }} .fg-empty {
  padding:44px 20px;
  border:1px solid var(--fg-line);
  border-radius:var(--fg-radius);
  text-align:center;
