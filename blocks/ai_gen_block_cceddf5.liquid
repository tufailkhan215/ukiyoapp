{% doc %}
  @prompt
    Generate a section with below content. 
    
    Create a section titled “WHY CLIENTS TRUST US”.
    
    Intro text:
    “Clear expectations. Thoughtful execution. No inflated promises.
    
    We believe strong client relationships are built on transparency, responsiveness, and work that is delivered with care.”
    
    Remove these existing items:
    - Performance Promise
    - Unlimited Revisions
    - On-Time Delivery
    - 90-Day Success Commitment
    
    Add these 4 new items as feature/value cards:
    1. Tailored Strategy — Every recommendation is shaped around your business, not pulled from a template.
    2. Refined with You — We value collaboration and thoughtful revision so the final work feels aligned and effective.
    3. Dependable Process — Clear timelines, organized execution, and consistent communication at every stage.
    4. Built for Momentum — Our work is designed to support stronger positioning, better execution, and more sustainable growth over time.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-trust-section__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-trust-section__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-trust-section__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_margin }}px 0;
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
    text-transform: {{ block.settings.title_transform }};
  }

  .ai-trust-section__intro-{{ ai_gen_id }} {
    font-size: {{ block.settings.intro_size }}px;
    line-height: {{ block.settings.intro_line_height }};
    color: {{ block.settings.intro_color }};
    max-width: {{ block.settings.intro_max_width }}px;
    margin: 0 auto;
  }

  .ai-trust-section__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.grid_margin_top }}px;
  }

  .ai-trust-section__card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    transition: all 0.3s ease;
  }

  .ai-trust-section__card-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.card_hover_background }};
    border-color: {{ block.settings.card_hover_border_color }};
    transform: translateY({{ block.settings.card_hover_lift }}px);
  }

  .ai-trust-section__card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: {{ block.settings.card_title_weight }};
    color: {{ block.settings.card_title_color }};
    margin: 0 0 {{ block.settings.card_title_margin }}px 0;
  }

  .ai-trust-section__card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_description_size }}px;
    line-height: {{ block.settings.card_description_line_height }};
    color: {{ block.settings.card_description_color }};
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-trust-section__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-trust-section__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-trust-section__intro-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.intro_size }}px * 0.9);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-trust-section__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-trust-section__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }

    .ai-trust-section__intro-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.intro_size }}px * 0.85);
    }

    .ai-trust-section-{{ ai_gen_id }} {
      padding: calc({{ block.settings.section_padding }}px * 0.6) 16px;
    }
  }
{% endstyle %}

<trust-section-{{ ai_gen_id }} class="ai-trust-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-trust-section__container-{{ ai_gen_id }}">
    <div class="ai-trust-section__header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-trust-section__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      
      {% if block.settings.intro_text != blank %}
        <div class="ai-trust-section__intro-{{ ai_gen_id }}">
          {{ block.settings.intro_text }}
        </div>
      {% endif %}
    </div>

    <div class="ai-trust-section__grid-{{ ai_gen_id }}">
      {% if block.settings.feature_1_title != blank %}
        <div class="ai-trust-section__card-{{ ai_gen_id }}">
          <h3 class="ai-trust-section__card-title-{{ ai_gen_id }}">{{ block.settings.feature_1_title }}</h3>
          {% if block.settings.feature_1_description != blank %}
            <p class="ai-trust-section__card-description-{{ ai_gen_id }}">{{ block.settings.feature_1_description }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.feature_2_title != blank %}
        <div class="ai-trust-section__card-{{ ai_gen_id }}">
          <h3 class="ai-trust-section__card-title-{{ ai_gen_id }}">{{ block.settings.feature_2_title }}</h3>
          {% if block.settings.feature_2_description != blank %}
            <p class="ai-trust-section__card-description-{{ ai_gen_id }}">{{ block.settings.feature_2_description }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.feature_3_title != blank %}
        <div class="ai-trust-section__card-{{ ai_gen_id }}">
          <h3 class="ai-trust-section__card-title-{{ ai_gen_id }}">{{ block.settings.feature_3_title }}</h3>
          {% if block.settings.feature_3_description != blank %}
            <p class="ai-trust-section__card-description-{{ ai_gen_id }}">{{ block.settings.feature_3_description }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.feature_4_title != blank %}
        <div class="ai-trust-section__card-{{ ai_gen_id }}">
          <h3 class="ai-trust-section__card-title-{{ ai_gen_id }}">{{ block.settings.feature_4_title }}</h3>
          {% if block.settings.feature_4_description != blank %}
            <p class="ai-trust-section__card-description-{{ ai_gen_id }}">{{ block.settings.feature_4_description }}</p>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</trust-section-{{ ai_gen_id }}>

<script>
  (function() {
    class TrustSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const cards = this.querySelectorAll('.ai-trust-section__card-{{ ai_gen_id }}');
        cards.forEach((card) => {
          card.setAttribute('role', 'article');
        });
      }
    }

    customElements.define('trust-section-{{ ai_gen_id }}', TrustSection{{ ai_gen_id }});
  })();
</script>

