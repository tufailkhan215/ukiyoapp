{% comment %}
  Product page hero: media, badge, thumbnails, title, short description, feature tags, price, CTAs, guarantees, downloads.
  Pass: product, section, gradient_class, gradient_class_opacity, type_badge, short_description, feature_tags, rating, review_count, downloads_count
{% endcomment %}
<div class="relative">
  <div class="absolute -inset-4 bg-gradient-to-r {{ gradient_class_opacity }} blur-3xl rounded-3xl" aria-hidden="true"></div>
  <div class="relative aspect-[4/3] rounded-2xl overflow-hidden bg-white/[0.02] border border-white/10">
    {% if product.featured_image %}
      <img
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        class="w-full h-full object-cover"
        src="{{ product.featured_image | image_url: width: 800 }}"
        width="800"
        height="600"
        loading="eager"
        id="ProductMainImage"
      >
    {% else %}
      <div class="w-full h-full flex items-center justify-center text-white/20">No image</div>
    {% endif %}
    <div class="absolute top-4 left-4">
      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-gradient-to-r {{ gradient_class }} text-white text-xs font-medium">
        {% if type_badge == 'Course' or product.collections.first.title == 'Courses' %}
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5" aria-hidden="true"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"></path><path d="M22 10v6"></path><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"></path></svg>
        {% endif %}
        {{ type_badge }}
      </span>
    </div>
  </div>
  {% if product.images.size > 1 %}
    <div class="flex gap-3 mt-4">
      {% for image in product.images limit: 4 %}
        <button type="button" class="w-20 h-20 rounded-lg bg-white/[0.02] border-2 border-white/10 hover:border-white/20 transition-colors overflow-hidden focus:outline-none focus:ring-2 focus:ring-white/30 {% if forloop.first %}border-white/20{% endif %}" data-product-thumbnail="{{ image | image_url: width: 800 }}" aria-label="View image {{ forloop.index }}">
          <img src="{{ image | image_url: width: 160 }}" alt="{{ image.alt | default: product.title | escape }}" width="80" height="80" class="w-full h-full object-cover" loading="lazy">
        </button>
      {% endfor %}
    </div>
  {% else %}
    <div class="flex gap-3 mt-4">
      <div class="w-20 h-20 rounded-lg bg-white/[0.02] border-2 border-white/20"></div>
      <div class="w-20 h-20 rounded-lg bg-white/[0.02] border border-white/10"></div>
      <div class="w-20 h-20 rounded-lg bg-white/[0.02] border border-white/10"></div>
    </div>
  {% endif %}
</div>

<div>
  {% if rating != blank or review_count != blank or section.settings.show_static_rating %}
    <div class="flex items-center gap-3 mb-4">
      <div class="flex items-center gap-1" aria-label="Rating {{ rating | default: 5 }} out of 5">
        {% assign stars = rating | default: 5 | round %}
        {% for i in (1..5) %}
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 {% if i <= stars %}fill-yellow-400 text-yellow-400{% else %}text-white/20{% endif %}" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path></svg>
        {% endfor %}
      </div>
      <span class="text-white/40 text-sm">{{ rating | default: 5.0 }} ({{ review_count | default: 24 }} reviews)</span>
    </div>
  {% endif %}

  <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">{{ product.title }}</h1>
  {% if short_description != blank %}
    <p class="text-lg text-white/60 mb-6 leading-relaxed">{{ short_description }}</p>
  {% endif %}

  {% if feature_tags != blank and feature_tags.size > 0 %}
    <div class="mb-8">
      <div class="grid grid-cols-2 gap-3">
        {% for tag in feature_tags limit: 6 %}
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-emerald-400 flex-shrink-0" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
            <span class="text-white/70 text-sm">{{ tag }}</span>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <div class="flex items-baseline gap-3 mb-6">
    <span class="text-4xl font-black text-white">{{ product.price | money }}</span>
    {% if product.compare_at_price > product.price %}
      <span class="text-white/40 line-through">{{ product.compare_at_price | money }}</span>
    {% endif %}
  </div>

  <div class="flex flex-col sm:flex-row gap-4 mb-8">
    <form action="{{ routes.cart_add_url }}" method="post" class="flex-1">
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button type="submit" name="add" class="w-full flex items-center justify-center gap-2 px-8 py-4 rounded-full font-semibold text-lg bg-gradient-to-r {{ gradient_class }} text-white hover:opacity-90 transition-opacity">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5" aria-hidden="true"><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path></svg>
        {{ section.settings.buy_button_text | default: 'Buy Now' }}
      </button>
    </form>
    {% if section.settings.show_save_button %}
      <button type="button" class="flex items-center justify-center gap-2 px-6 py-4 rounded-full font-semibold border border-white/20 text-white hover:bg-white/10 transition-colors" aria-label="Save"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg></button>
    {% endif %}
    <button type="button" class="flex items-center justify-center w-14 h-14 rounded-full border border-white/20 text-white/60 hover:bg-white/10 transition-colors share-product" aria-label="Share" data-url="{{ shop.url }}{{ product.url }}" data-title="{{ product.title | escape }}"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line></svg></button>
  </div>

  <div class="flex flex-wrap gap-4 p-4 rounded-xl bg-white/[0.02] border border-white/10">
    <div class="flex items-center gap-2 text-sm text-white/50"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg><span>{{ section.settings.guarantee_instant | default: 'Instant Download' }}</span></div>
    <div class="flex items-center gap-2 text-sm text-white/50"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg><span>{{ section.settings.guarantee_days | default: '14-Day Guarantee' }}</span></div>
    <div class="flex items-center gap-2 text-sm text-white/50"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path></svg><span>{{ section.settings.guarantee_access | default: 'Lifetime Access' }}</span></div>
  </div>

  {% if downloads_count != blank or section.settings.show_downloads %}
    <div class="mt-6">
      <div class="flex items-center gap-4 p-4 rounded-2xl bg-white/[0.02] border border-white/10">
        <div class="w-12 h-12 rounded-xl bg-emerald-500/20 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6 text-emerald-400" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg>
        </div>
        <div>
          <div class="text-2xl font-bold text-white">{{ downloads_count | default: section.settings.default_downloads | default: '800+' }}</div>
          <div class="text-white/50 text-sm">Downloads</div>
        </div>
      </div>
    </div>
  {% endif %}
</div>
