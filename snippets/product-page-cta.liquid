{% comment %}
  Product page bottom CTA (Get Unlimited Access). Pass: product, section, gradient_class_opacity
{% endcomment %}
{% if section.settings.cta_heading != blank %}
  <section class="py-16 lg:py-24 border-t border-white/10 relative z-10">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
      <div class="relative rounded-3xl overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-r {{ gradient_class_opacity }}"></div>
        <div class="relative p-8 md:p-12 lg:p-16">
          <div class="max-w-2xl">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{{ section.settings.cta_heading }}</h2>
            {% if section.settings.cta_text != blank %}<p class="text-lg text-white/60 mb-8">{{ section.settings.cta_text }}</p>{% endif %}
            <div class="flex flex-col sm:flex-row gap-4">
              {% if section.settings.cta_primary_url != blank %}
                <a class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white text-black rounded-full font-semibold hover:bg-gray-200 transition-colors" href="{{ section.settings.cta_primary_url }}">{{ section.settings.cta_primary_label | default: 'View Membership Plans' }}<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a>
              {% endif %}
              {% if product.collections.first and section.settings.cta_secondary_use_collection %}
                <a class="inline-flex items-center justify-center gap-2 px-8 py-4 border border-white/20 text-white rounded-full font-semibold hover:bg-white/10 transition-colors" href="{{ product.collections.first.url }}">Browse More {{ product.collections.first.title }}</a>
              {% elsif section.settings.cta_secondary_url != blank %}
                <a class="inline-flex items-center justify-center gap-2 px-8 py-4 border border-white/20 text-white rounded-full font-semibold hover:bg-white/10 transition-colors" href="{{ section.settings.cta_secondary_url }}">{{ section.settings.cta_secondary_label | default: 'Browse More' }}</a>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
{% endif %}
