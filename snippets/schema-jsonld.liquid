{%- comment -%}
  ============================================================================
  UkiyoProd — structured data
  File: snippets/schema-jsonld.liquid   (CREATE THIS FILE — it does not exist)
  Created: 2026-08-07

  Render it from layout/theme.liquid, immediately AFTER the SEO head block:
      {% render 'schema-jsonld' %}

  Site currently has ZERO structured data on all 1,830 URLs (Semrush
  schemaOrgJsonld: 0, confirmed live 2026-08-07: 0 ld+json blocks on the
  homepage).

  DESIGN NOTE — why separate <script> blocks instead of one @graph:
  each block is independently valid JSON. A conditional that misfires can
  only cost you that one block; it cannot produce a single malformed
  document that invalidates everything. Google accepts multiple blocks.
  This is deliberate: the Liquid here is untested against this theme.

  All string interpolation uses the `| json` filter, which emits its own
  quotes and escaping. Do NOT wrap those outputs in additional quote marks.

  VALIDATION RUN 2026-08-07 — this Liquid was actually rendered, not just
  written. Rendered with liquidjs 10.28.0 across 8 template scenarios
  (index, product with collection, product without collection, article with
  author, article without author, collection, page, 404). Result: correct
  block count in all 8, and every emitted block parsed as valid JSON.
  Hostile inputs were used deliberately - titles containing double quotes,
  an apostrophe, an em dash, a U+2502 box-drawing bar, an ampersand, inline
  HTML and a newline - and round-tripped byte-exact through `| json`.

  WHAT THAT TEST CANNOT COVER: liquidjs is not Shopify. It cannot verify
  that `shop.brand.logo`, `article.excerpt_or_content`, `cart.currency` or
  the `template` object behave identically on this theme. Those are the
  remaining risk. After pasting, confirm with Shopify's theme preview and
  then Google's Rich Results Test on one URL per template.
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign org_id  = shop.url | append: '/#organization'
  assign site_id = shop.url | append: '/#website'
  assign pub_email = 'hello.ukiyoprod@gmail.com'
-%}

{%- comment -%} ---------- 1. Organization + WebSite (every page) ---------- {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": {{ org_id | json }},
      "name": {{ shop.name | json }},
      "url": {{ shop.url | append: '/' | json }},
      "email": {{ pub_email | json }},
      {%- if shop.description != blank %}
      "description": {{ shop.description | strip_html | truncate: 300 | json }},
      {%- endif %}
      {%- if shop.brand.logo %}
      "logo": {
        "@type": "ImageObject",
        "url": {{ shop.brand.logo | image_url: width: 600 | prepend: 'https:' | json }}
      },
      {%- endif %}
      "sameAs": [
        "https://www.instagram.com/ukiyoproductions_",
        "https://www.linkedin.com/company/ukiyoprod"
      ]
    },
    {
      "@type": "WebSite",
      "@id": {{ site_id | json }},
      "url": {{ shop.url | append: '/' | json }},
      "name": {{ shop.name | json }},
      "publisher": { "@id": {{ org_id | json }} },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          {%- comment -%}
            The braces in {search_term_string} are literal text, deliberately OUTSIDE any
            Liquid tag. Shopify's parser rejects a single `{` inside a `{{ }}` output tag
            (422: "was not properly terminated"), even though liquidjs accepts it.
            Do not "tidy" this into a single append filter.
          {%- endcomment -%}
          "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
  ]
}
</script>

{%- comment -%} ---------- 2. Product ---------- {%- endcomment -%}
{%- if template contains 'product' and product -%}
  {%- assign v = product.selected_or_first_available_variant -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": {{ product.url | prepend: shop.url | append: '#product' | json }},
  "name": {{ product.title | json }},
  "url": {{ product.url | prepend: shop.url | json }},
  {%- if product.description != blank %}
  "description": {{ product.description | strip_html | truncate: 400 | json }},
  {%- endif %}
  {%- if product.featured_image %}
  "image": [{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],
  {%- endif %}
  {%- if product.vendor != blank %}
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  {%- endif %}
  {%- if v.sku != blank %}
  "sku": {{ v.sku | json }},
  {%- endif %}
  "offers": {
    "@type": "Offer",
    "url": {{ product.url | prepend: shop.url | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ product.price | divided_by: 100.0 | json }},
    "availability": {% if product.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
    "seller": { "@id": {{ org_id | json }} }
  }
}
</script>
{%- endif -%}

{%- comment -%} ---------- 3. BlogPosting ---------- {%- endcomment -%}
{%- if template contains 'article' and article -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": {{ article.url | prepend: shop.url | append: '#article' | json }},
  "mainEntityOfPage": { "@type": "WebPage", "@id": {{ article.url | prepend: shop.url | json }} },
  "headline": {{ article.title | truncate: 110 | json }},
  "url": {{ article.url | prepend: shop.url | json }},
  {%- if article.excerpt_or_content != blank %}
  "description": {{ article.excerpt_or_content | strip_html | truncate: 300 | json }},
  {%- endif %}
  {%- if article.image %}
  "image": [{{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}],
  {%- endif %}
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "dateModified": {{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  {%- if article.author != blank %}
  "author": { "@type": "Person", "name": {{ article.author | json }} },
  {%- else %}
  "author": { "@id": {{ org_id | json }} },
  {%- endif %}
  "publisher": { "@id": {{ org_id | json }} }
}
</script>
{%- endif -%}

{%- comment -%} ---------- 4. CollectionPage ---------- {%- endcomment -%}
{%- if template contains 'collection' and collection -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": {{ collection.url | prepend: shop.url | append: '#collection' | json }},
  "name": {{ collection.title | json }},
  "url": {{ collection.url | prepend: shop.url | json }},
  {%- if collection.description != blank %}
  "description": {{ collection.description | strip_html | truncate: 300 | json }},
  {%- endif %}
  "isPartOf": { "@id": {{ site_id | json }} }
}
</script>
{%- endif -%}

{%- comment -%} ---------- 5. BreadcrumbList ---------- {%- endcomment -%}
{%- unless template == 'index' or template == '404' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | append: '/' | json }} }
    {%- if template contains 'product' and product -%}
      {%- if collection %}
      ,{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ collection.url | prepend: shop.url | json }} }
      ,{ "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ product.url | prepend: shop.url | json }} }
      {%- else %}
      ,{ "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ product.url | prepend: shop.url | json }} }
      {%- endif -%}
    {%- elsif template contains 'collection' and collection -%}
      ,{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ collection.url | prepend: shop.url | json }} }
    {%- elsif template contains 'article' and article -%}
      ,{ "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ blog.url | prepend: shop.url | json }} }
      ,{ "@type": "ListItem", "position": 3, "name": {{ article.title | truncate: 80 | json }}, "item": {{ article.url | prepend: shop.url | json }} }
    {%- elsif template contains 'blog' and blog -%}
      ,{ "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ blog.url | prepend: shop.url | json }} }
    {%- elsif template contains 'page' and page -%}
      ,{ "@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": {{ page.url | prepend: shop.url | json }} }
    {%- endif -%}
  ]
}
</script>
{%- endunless -%}
