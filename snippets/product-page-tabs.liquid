{% comment %}
  Product page tabs (Overview, Benefits, Features, FAQs) + Product details sidebar.
  Pass: product, section, has_overview, has_benefits, has_features, has_faqs, whats_included, features_content, benefits_content, faqs_value, product_category, product_version, last_updated, license
{% endcomment %}
{% if has_overview or has_benefits or has_features or has_faqs %}
  <section class="border-t border-white/10 relative z-10">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
      <div class="flex gap-8 overflow-x-auto product-tabs" role="tablist" aria-label="Product details">
        {% if has_overview %}
          <button type="button" class="py-5 text-sm font-medium border-b-2 transition-colors whitespace-nowrap border-white text-white product-tab active" role="tab" aria-selected="true" data-tab="overview">Overview</button>
        {% endif %}
        {% if has_benefits %}
          <button type="button" class="py-5 text-sm font-medium border-b-2 transition-colors whitespace-nowrap border-transparent text-white/40 hover:text-white product-tab" role="tab" aria-selected="false" data-tab="benefits">Benefits</button>
        {% endif %}
        {% if has_features %}
          <button type="button" class="py-5 text-sm font-medium border-b-2 transition-colors whitespace-nowrap border-transparent text-white/40 hover:text-white product-tab" role="tab" aria-selected="false" data-tab="features">Features</button>
        {% endif %}
        {% if has_faqs %}
          <button type="button" class="py-5 text-sm font-medium border-b-2 transition-colors whitespace-nowrap border-transparent text-white/40 hover:text-white product-tab" role="tab" aria-selected="false" data-tab="faqs">FAQs</button>
        {% endif %}
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-24 relative z-10">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
      <div class="grid lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2">
          {% if has_overview %}
            <div class="product-tab-panel" id="panel-overview" role="tabpanel">
              <h2 class="text-2xl font-bold text-white mb-6">About This Product</h2>
              <div class="prose prose-invert max-w-none">
                {% if product.description != blank %}
                  <div class="text-white/60 leading-relaxed mb-6">{{ product.description }}</div>
                {% endif %}
                {% if whats_included != blank and whats_included.size > 0 %}
                  <h3 class="text-xl font-bold text-white mt-8 mb-4">What's Included</h3>
                  <ul class="space-y-3">
                    {% for item in whats_included %}
                      <li class="flex items-start gap-3 text-white/60">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
                        <span>{{ item }}</span>
                      </li>
                    {% endfor %}
                  </ul>
                {% elsif features_content != blank %}
                  <h3 class="text-xl font-bold text-white mt-8 mb-4">What's Included</h3>
                  <ul class="space-y-3">
                    {% assign features_is_list_wi = false %}
                    {% for item in features_content %}{% if item.size > 2 %}{% assign features_is_list_wi = true %}{% break %}{% endif %}{% endfor %}
                    {% if features_is_list_wi %}
                      {% for item in features_content %}{% if item.size > 2 %}
                        <li class="flex items-start gap-3 text-white/60">
                          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
                          <span>{{ item }}</span>
                        </li>
                      {% endif %}{% endfor %}
                    {% else %}
                      {% assign lines = features_content | newline_to_br | split: '<br />' %}
                      {% for line in lines %}{% if line != blank %}
                        <li class="flex items-start gap-3 text-white/60">
                          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
                          <span>{{ line | strip }}</span>
                        </li>
                      {% endif %}{% endfor %}
                    {% endif %}
                  </ul>
                {% endif %}
              </div>
            </div>
          {% endif %}

          {% if has_benefits %}
            <div class="product-tab-panel hidden" id="panel-benefits" role="tabpanel">
              <h2 class="text-2xl font-bold text-white mb-6">Benefits</h2>
              <div class="prose prose-invert max-w-none text-white/60">
                {% assign benefits_is_list = false %}
                {% for item in benefits_content %}{% if item.size > 2 %}{% assign benefits_is_list = true %}{% break %}{% endif %}{% endfor %}
                {% if benefits_is_list %}
                  <ul class="space-y-3">
                    {% for item in benefits_content %}{% if item.size > 2 %}
                      <li class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-emerald-400 flex-shrink-0 mt-0.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span>{{ item }}</span></li>
                    {% endif %}{% endfor %}
                  </ul>
                {% else %}
                  <div class="leading-relaxed">{{ benefits_content }}</div>
                {% endif %}
              </div>
            </div>
          {% endif %}

          {% if has_features %}
            <div class="product-tab-panel hidden" id="panel-features" role="tabpanel">
              <h2 class="text-2xl font-bold text-white mb-6">Features</h2>
              <div class="prose prose-invert max-w-none text-white/60">
                {% assign features_is_list = false %}
                {% for item in features_content %}{% if item.size > 2 %}{% assign features_is_list = true %}{% break %}{% endif %}{% endfor %}
                {% if features_is_list %}
                  <ul class="space-y-3">
                    {% for item in features_content %}{% if item.size > 2 %}
                      <li class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-emerald-400 flex-shrink-0 mt-0.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span>{{ item }}</span></li>
                    {% endif %}{% endfor %}
                  </ul>
                {% else %}
                  <div class="leading-relaxed">{{ features_content }}</div>
                {% endif %}
              </div>
            </div>
          {% endif %}

          {% if has_faqs %}
            <div class="product-tab-panel hidden" id="panel-faqs" role="tabpanel">
              <h2 class="text-2xl font-bold text-white mb-6">FAQs</h2>
              <div class="space-y-4">
                {% for faq in faqs_value %}
                  <div class="border-b border-white/10 pb-4">
                    <h4 class="text-white font-semibold mb-2">{{ faq.q | default: faq.question }}</h4>
                    <p class="text-white/60 text-sm">{{ faq.a | default: faq.answer }}</p>
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        </div>

        <div>
          <h3 class="text-lg font-bold text-white mb-4">Product Details</h3>
          <div class="space-y-4">
            <div class="flex justify-between py-3 border-b border-white/10"><span class="text-white/40">Category</span><span class="text-white">{{ product_category }}</span></div>
            <div class="flex justify-between py-3 border-b border-white/10"><span class="text-white/40">Version</span><span class="text-white">{{ product_version }}</span></div>
            <div class="flex justify-between py-3 border-b border-white/10"><span class="text-white/40">Last Updated</span><span class="text-white">{{ last_updated }}</span></div>
            <div class="flex justify-between py-3 border-b border-white/10"><span class="text-white/40">License</span><span class="text-white">{{ license }}</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>
{% else %}
  <section class="py-16 lg:py-24 border-t border-white/10 relative z-10">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
      <div class="grid lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2">
          <h2 class="text-2xl font-bold text-white mb-6">About This Product</h2>
          <div class="prose prose-invert max-w-none text-white/60">{{ product.description | default: 'No description.' }}</div>
        </div>
        <div>
          <h3 class="text-lg font-bold text-white mb-4">Product Details</h3>
          <div class="space-y-4">
            <div class="flex justify-between py-3 border-b border-white/10"><span class="text-white/40">Category</span><span class="text-white">{{ product_category }}</span></div>
            <div class="flex justify-between py-3 border-b border-white/10"><span class="text-white/40">Version</span><span class="text-white">{{ product_version }}</span></div>
            <div class="flex justify-between py-3 border-b border-white/10"><span class="text-white/40">Last Updated</span><span class="text-white">{{ last_updated }}</span></div>
            <div class="flex justify-between py-3 border-b border-white/10"><span class="text-white/40">License</span><span class="text-white">{{ license }}</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>
{% endif %}
