{%- comment -%}
  Shared assets for the csl-* case study sections. Every section renders this;
  repeat includes are harmless (the browser reuses the files and the script
  guards itself). The scroll reveal is skipped inside the theme editor so
  everything is always visible while editing.
{%- endcomment -%}
{%- unless request.design_mode -%}
  <script>document.documentElement.classList.add('csl-js');</script>
{%- endunless -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=BBH+Bartle&display=swap">
{{ 'case-study-landing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'case-study-landing.js' | asset_url }}" defer></script>
