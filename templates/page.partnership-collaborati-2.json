    "faq_RzHXCd": {
      "type": "faq",
      "blocks": {
        "faq_7d93ic": {
          "type": "faq",
          "settings": {
            "question": "What types of partnerships do you help facilitate?",
            "answer": "We help with co-marketing campaigns, affiliate programs, influencer partnerships, brand collaborations, event sponsorships, product integrations, white-label arrangements, and strategic joint ventures."
          }
        },
        "faq_Lh88e7": {
          "type": "faq",
          "settings": {
            "question": "How do you find the right partners for our brand?",
            "answer": "We use a combination of AI-powered research, industry databases, and our network to identify partners that align with your brand values, target audience, and business objectives."
          }
        },
        "faq_imN7DG": {
          "type": "faq",
          "settings": {
            "question": "Do you handle partnership negotiations?",
            "answer": "Yes! Our Growth and Scale tiers include negotiation support. We help structure terms, review contracts, and ensure agreements are mutually beneficial."
          }
        },
        "faq_RHcRGW": {
          "type": "faq",
          "settings": {
            "question": "How long does it take to secure a partnership?",
            "answer": "Timeline varies by partnership complexity. Simple collaborations can be secured in 2-4 weeks, while larger strategic partnerships may take 2-3 months to finalize."
          }
        },
        "faq_MgjXXd": {
          "type": "faq",
          "settings": {
            "question": "Can you help with influencer partnerships specifically?",
            "answer": "Absolutely! Influencer partnerships are a key specialty. We handle discovery, vetting, outreach, negotiation, and campaign management."
          }
        },
        "faq_cXrfCF": {
          "type": "faq",
          "settings": {
            "question": "What industries do you work with?",
            "answer": "We work across industries including tech, fashion, lifestyle, food & beverage, health & wellness, entertainment, and B2B services."
          }
        }
      },
