    "faq_RzHXCd": {
      "type": "faq",
      "blocks": {
        "faq_7d93ic": {
          "type": "faq",
          "settings": {
            "question": "How is this different from a regular chatbot?",
            "answer": "Our AI Concierge Chatbot uses advanced natural language processing to understand context, intent, and sentiment. It doesn't just answer questions, it actively guides visitors toward conversion with personalized recommendations and strategic follow-ups."
          }
        },
        "faq_Lh88e7": {
          "type": "faq",
          "settings": {
            "question": "Will the chatbot sound robotic?",
            "answer": "No! We train the AI on your brand voice and customize responses to sound natural and on-brand. Most visitors can't tell they're talking to AI."
          }
        },
        "faq_imN7DG": {
          "type": "faq",
          "settings": {
            "question": "Can it integrate with my existing tools?",
            "answer": "Yes! We integrate with popular CRMs (HubSpot, Salesforce), e-commerce platforms (Shopify, WooCommerce), and scheduling tools (Calendly, TidyCal)."
          }
        },
        "faq_RHcRGW": {
          "type": "faq",
          "settings": {
            "question": "What happens when the AI can't answer a question?",
            "answer": "The system gracefully escalates to a human agent, collecting context so your team can pick up seamlessly. You can set escalation rules based on topic, sentiment, or customer value."
          }
        },
        "faq_MgjXXd": {
          "type": "faq",
          "settings": {
            "question": "How quickly can we see results?",
            "answer": "Most clients see measurable improvements within the first 30 days. Full optimization typically takes 60-90 days as the AI learns from real interactions."
          }
        },
        "faq_cXrfCF": {
          "type": "faq",
          "settings": {
            "question": "Do you offer Instagram DM automation specifically?",
            "answer": "Absolutely! Instagram DM automation is a core feature. We can automate responses to story replies, DM inquiries, and comment responses."
          }
        }
      },
      "block_order": [
        "faq_7d93ic",
        "faq_Lh88e7",
        "faq_imN7DG",
        "faq_RHcRGW",
        "faq_MgjXXd",
        "faq_cXrfCF"
