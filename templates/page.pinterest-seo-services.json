    "faq_RzHXCd": {
      "type": "faq",
      "blocks": {
        "faq_7d93ic": {
          "type": "faq",
          "settings": {
            "question": "How long before I see results?",
            "answer": "Pinterest is usually a slower-build channel than paid media, but the upside is that strong pins can keep working long after they are published. Most brands begin seeing clearer traction over the first few months."
          }
        },
        "faq_Lh88e7": {
          "type": "faq",
          "settings": {
            "question": "Do I need a business account?",
            "answer": "Yes. A Pinterest Business account is required, and we can help make sure it is set up correctly."
          }
        },
        "faq_imN7DG": {
          "type": "faq",
          "settings": {
            "question": "What makes Pinterest different from other platforms?",
            "answer": "Pinterest works more like a search engine than a traditional social feed, which gives content a longer lifespan and stronger discovery potential over time."
          }
        },
        "faq_RHcRGW": {
          "type": "faq",
          "settings": {
            "question": "Do you create the pin images?",
            "answer": "Yes! Our design team creates scroll-stopping pin graphics optimized for Pinterest's visual algorithm and user behavior."
          }
        },
        "faq_MgjXXd": {
          "type": "faq",
          "settings": {
            "question": "Can Pinterest work for service businesses or B2B brands?",
            "answer": "Yes. It can be valuable when the content is educational, strategic, or visually useful."
          }
        },
        "faq_cXrfCF": {
          "type": "faq",
          "settings": {
            "question": "Do you manage Pinterest ads too?",
            "answer": "Yes. Pinterest ads support is included in the highest-tier package."
          }
        }
      },
