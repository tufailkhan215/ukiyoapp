    "two_column_text_C8d8mg": {
      "type": "two-column-text",
      "name": "Two Column Text",
      "settings": {
        "layout": "overview",
        "strap": "(Overview)",
        "title_before": "What is",
        "title_gradient": "Company Agent Builder?",
        "paragraph_1": "<p>Create custom AI agents that understand your company inside and out. From customer service to sales, your brand voice stays consistent across every interaction.</p>",
        "paragraph_2": "<p>In an era where customer expectations are at an all-time high, having a consistent brand voice across every touchpoint is crucial. Our Company Agent Builder service creates bespoke AI agents trained on your brand guidelines, tone of voice, product knowledge, and company values. These agents become extensions of your team, handling everything from customer inquiries to lead qualification with the precision and personality your brand deserves.</p>",
        "title_included": "Everything You Need to Launch Your AI Agent"
      }
    },
