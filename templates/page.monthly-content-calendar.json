    "faq_RzHXCd": {
      "type": "faq",
      "blocks": {
        "faq_7d93ic": {
          "type": "faq",
          "settings": {
            "question": "How long does a complete brand identity project take?",
            "answer": "Essentials packages take 2-3 weeks, Professional packages 4-6 weeks, and Enterprise projects 8-12 weeks depending on complexity and feedback cycles."
          }
        },
        "faq_Lh88e7": {
          "type": "faq",
          "settings": {
            "question": "What if I don't like the initial concepts?",
            "answer": "We offer multiple concepts and revision rounds. If the initial direction doesn't resonate, we'll explore new approaches until we find the perfect fit for your brand."
          }
        },
        "faq_imN7DG": {
          "type": "faq",
          "settings": {
            "question": "Do I own the final designs?",
            "answer": "Yes! Upon final payment, you receive full ownership of all designs, source files, and assets. We retain the right to showcase the work in our portfolio."
          }
        },
        "faq_RHcRGW": {
          "type": "faq",
          "settings": {
            "question": "Can you work with our existing brand elements?",
            "answer": "Absolutely! We can refresh and build upon existing elements or start completely fresh—whatever serves your brand best."
          }
        },
        "faq_MgjXXd": {
          "type": "faq",
          "settings": {
            "question": "What file formats do you deliver?",
            "answer": "We provide all standard formats including AI, EPS, PDF, PNG, JPG, and SVG. We also include web-optimized versions and favicon files."
          }
        },
        "faq_cXrfCF": {
          "type": "faq",
          "settings": {
            "question": "Do you offer ongoing design support?",
            "answer": "Yes! We offer monthly retainer packages for ongoing design needs including social graphics, marketing materials, and asset creation."
          }
        }
      },
